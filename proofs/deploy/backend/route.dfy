// Generated by lsc from route.ts

datatype PublicRoute = healthz | metrics | draining | api | service | mcp | not_found

function publicRoute(path: string, draining: bool, internal: bool, mcp: bool): PublicRoute
{
  if (path == "/healthz") then
    PublicRoute.healthz
  else
    if (path == "/ops/metrics") then
      PublicRoute.metrics
    else
      if draining then
        PublicRoute.draining
      else
        if ((path == "/api") || (|path| >= |"/api/"| && path[..|"/api/"|] == "/api/")) then
          PublicRoute.api
        else
          if (((path == "/webhooks/blooio") || (|path| >= |"/webhooks/blooio/"| && path[..|"/webhooks/blooio/"|] == "/webhooks/blooio/")) || internal) then
            PublicRoute.service
          else
            if mcp then
              PublicRoute.mcp
            else
              PublicRoute.not_found
}

lemma publicRoute_ensures(path: string, draining: bool, internal: bool, mcp: bool)
  ensures (publicRoute(path, draining, internal, mcp).service? ==> ((internal || (path == "/webhooks/blooio")) || (|path| >= |"/webhooks/blooio/"| && path[..|"/webhooks/blooio/"|] == "/webhooks/blooio/")))
  ensures (draining ==> (path != "/healthz") ==> (path != "/ops/metrics") ==> publicRoute(path, draining, internal, mcp).draining?)
  ensures (!(internal) ==> !((|path| >= |"/webhooks/"| && path[..|"/webhooks/"|] == "/webhooks/")) ==> (!publicRoute(path, draining, internal, mcp).service?))
  ensures (publicRoute(path, draining, internal, mcp).mcp? ==> mcp)
{
}
