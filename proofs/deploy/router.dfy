// Generated by lsc from router.ts

function isBackendPath(pathname: string): bool
{
  ((((((pathname == "/api") || (|pathname| >= |"/api/"| && pathname[..|"/api/"|] == "/api/")) || (pathname == "/mcp")) || (|pathname| >= |"/mcp/"| && pathname[..|"/mcp/"|] == "/mcp/")) || (|pathname| >= |"/oauth/"| && pathname[..|"/oauth/"|] == "/oauth/")) || (|pathname| >= |"/.well-known/oauth-"| && pathname[..|"/.well-known/oauth-"|] == "/.well-known/oauth-"))
}

lemma DiffPrefix(s: string, p: string, q: string, i: nat)
  requires |s| >= |p| && s[..|p|] == p && i < |p| && i < |q| && p[i] != q[i]
  ensures !(|s| >= |q| && s[..|q|] == q)
{
  if |s| >= |q| && s[..|q|] == q {
    assert s[..|p|][i] == s[i];
    assert s[..|q|][i] == s[i];
  }
}

lemma Excl(s: string, p: string)
  requires |s| >= |p| && s[..|p|] == p
  requires p == "/api/" || p == "/mcp/" || p == "/oauth/" || p == "/.well-known/oauth-"
  ensures !(|s| >= |"//"| && s[..|"//"|] == "//")
  ensures !(|s| >= |"/internal/"| && s[..|"/internal/"|] == "/internal/")
  ensures !(|s| >= |"/review"| && s[..|"/review"|] == "/review")
  ensures !(|s| >= |"/webhooks/"| && s[..|"/webhooks/"|] == "/webhooks/")
  ensures !(|s| >= |"/ops/"| && s[..|"/ops/"|] == "/ops/")
{
  DiffPrefix(s, p, "//", 1);
  DiffPrefix(s, p, "/internal/", 1);
  DiffPrefix(s, p, "/review", 1);
  DiffPrefix(s, p, "/webhooks/", 1);
  if p == "/oauth/" { DiffPrefix(s, p, "/ops/", 2); } else { DiffPrefix(s, p, "/ops/", 1); }
}

lemma isBackendPath_ensures(pathname: string)
  ensures (isBackendPath(pathname) ==> ((|pathname| >= |"/"| && pathname[..|"/"|] == "/") && !((|pathname| >= |"//"| && pathname[..|"//"|] == "//"))))
  ensures (isBackendPath(pathname) ==> (((!((|pathname| >= |"/internal/"| && pathname[..|"/internal/"|] == "/internal/")) && !((|pathname| >= |"/review"| && pathname[..|"/review"|] == "/review"))) && !((|pathname| >= |"/webhooks/"| && pathname[..|"/webhooks/"|] == "/webhooks/"))) && !((|pathname| >= |"/ops/"| && pathname[..|"/ops/"|] == "/ops/"))))
{
  if pathname == "/api" { assert pathname[..1] == "/"; assert pathname[..2] == "/a"; }
  if pathname == "/mcp" { assert pathname[..1] == "/"; assert pathname[..2] == "/m"; }
  if |pathname| >= 5 && pathname[..5] == "/api/" { Excl(pathname, "/api/"); }
  if |pathname| >= 5 && pathname[..5] == "/mcp/" { Excl(pathname, "/mcp/"); }
  if |pathname| >= 7 && pathname[..7] == "/oauth/" { Excl(pathname, "/oauth/"); }
  if |pathname| >= 19 && pathname[..19] == "/.well-known/oauth-" { Excl(pathname, "/.well-known/oauth-"); }
}
