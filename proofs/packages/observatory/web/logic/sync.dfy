// Generated by lsc from sync.ts

datatype SyncState = SyncState(app: string, gen: int, buffering: bool, dataApp: string, version: int, synced: bool)

datatype SyncEvent = switch(app: string) | begin | land(gen: int, app: string, version: int) | fail(gen: int) | delta(version: int, reset: bool)

datatype DeltaMove = buffer | reload | drop | meta | data

datatype Delta = Delta(version: int, reset: bool)

datatype Sequenced = Sequenced(seq_: int)

datatype RevealState = RevealState(server: bool, badge: bool)

datatype Grant = Grant(role: string, app: string)

function initialSync(app: string): SyncState
{
  SyncState(app, 0, false, "", 0, false)
}

lemma initialSync_ensures(app: string)
  ensures good(initialSync(app))
{
}

function good(s: SyncState): bool
{
  (((s.dataApp == "") || (s.dataApp == s.app)) && (!(s.synced) || (s.dataApp == s.app)))
}

function owns(s: SyncState, gen: int): bool
{
  (gen == s.gen)
}

function admits(s: SyncState, gen: int, app: string): bool
{
  ((owns(s, gen) && (app == s.app)) && s.buffering)
}

function deltaMove(s: SyncState, version: int, reset: bool): DeltaMove
  requires good(s)
{
  if reset then
    DeltaMove.reload
  else
    if s.buffering then
      DeltaMove.buffer
    else
      if !(s.synced) then
        DeltaMove.reload
      else
        if (version < s.version) then
          DeltaMove.drop
        else
          if (version == s.version) then
            DeltaMove.meta
          else
            if (version > (s.version + 1)) then
              DeltaMove.reload
            else
              DeltaMove.data
}

lemma deltaMove_ensures(s: SyncState, version: int, reset: bool)
  requires good(s)
  ensures (reset ==> deltaMove(s, version, reset).reload?)
  ensures (!(reset) ==> s.buffering ==> deltaMove(s, version, reset).buffer?)
  ensures (!(reset) ==> !(s.buffering) ==> !(s.synced) ==> deltaMove(s, version, reset).reload?)
  ensures ((deltaMove(s, version, reset).meta? || deltaMove(s, version, reset).data?) ==> (((s.synced && !(s.buffering)) && !(reset)) && (s.dataApp == s.app)))
  ensures (deltaMove(s, version, reset).data? ==> (version == (s.version + 1)))
  ensures (deltaMove(s, version, reset).meta? ==> (version == s.version))
  ensures (s.synced ==> !(s.buffering) ==> !(reset) ==> (version == s.version) ==> deltaMove(s, version, reset).meta?)
  ensures (s.synced ==> !(s.buffering) ==> !(reset) ==> (version == (s.version + 1)) ==> deltaMove(s, version, reset).data?)
  ensures (s.synced ==> !(s.buffering) ==> !(reset) ==> (version < s.version) ==> deltaMove(s, version, reset).drop?)
  ensures (s.synced ==> !(s.buffering) ==> !(reset) ==> (version > (s.version + 1)) ==> deltaMove(s, version, reset).reload?)
{
}

function step(s: SyncState, e: SyncEvent): SyncState
  requires good(s)
{
  match e {
    case switch(i_e_app) =>
      if (i_e_app == s.app) then
        s
      else
        SyncState(i_e_app, (s.gen + 1), false, "", 0, false)
    case begin =>
      s.(gen := (s.gen + 1), buffering := true)
    case land(i_e_gen, i_e_app, i_e_version) =>
      if admits(s, i_e_gen, i_e_app) then
        s.(buffering := false, dataApp := i_e_app, version := i_e_version, synced := true)
      else
        s
    case fail(i_e_gen) =>
      if owns(s, i_e_gen) then
        s.(buffering := false, synced := false)
      else
        s
    case delta(i_e_version, i_e_reset) =>
      if deltaMove(s, i_e_version, i_e_reset).data? then
        s.(version := i_e_version)
      else
        s
  }
}

lemma step_ensures(s: SyncState, e: SyncEvent)
  requires good(s)
  ensures good(step(s, e))
  ensures (step(s, e).gen >= s.gen)
  ensures (e.land? ==> !(admits(s, e.gen, e.app)) ==> (step(s, e) == s))
  ensures (e.fail? ==> !(owns(s, e.gen)) ==> (step(s, e) == s))
  ensures (e.fail? ==> owns(s, e.gen) ==> (!(step(s, e).buffering) && !(step(s, e).synced)))
  ensures (e.switch? ==> (e.app != s.app) ==> (((((step(s, e).app == e.app) && (step(s, e).gen > s.gen)) && (step(s, e).dataApp == "")) && !(step(s, e).synced)) && !(step(s, e).buffering)))
  ensures (e.switch? ==> (e.app == s.app) ==> (step(s, e) == s))
  ensures (e.begin? ==> (((step(s, e).gen > s.gen) && step(s, e).buffering) && (step(s, e).app == s.app)))
  ensures (e.land? ==> admits(s, e.gen, e.app) ==> (((step(s, e).synced && !(step(s, e).buffering)) && (step(s, e).dataApp == e.app)) && (step(s, e).version == e.version)))
  ensures (e.delta? ==> (((step(s, e).gen == s.gen) && (step(s, e).version >= s.version)) && (step(s, e).dataApp == s.dataApp)))
  ensures (e.delta? ==> deltaMove(s, e.version, e.reset).data? ==> (step(s, e).version == e.version))
  ensures (e.delta? ==> (!deltaMove(s, e.version, e.reset).data?) ==> (step(s, e) == s))
  ensures ((step(s, e).version < s.version) ==> (e.switch? || (e.land? && (e.gen == s.gen))))
  ensures ((step(s, e).dataApp != s.dataApp) ==> (e.switch? || (e.land? && (e.gen == s.gen))))
{
}

function loadLands(s: SyncState, version: int): SyncState
  requires good(s)
{
  var b := step(s, SyncEvent.begin);
  step(b, land(b.gen, b.app, version))
}

lemma loadLands_ensures(s: SyncState, version: int)
  requires good(s)
  ensures loadLands(s, version).synced
  ensures !(loadLands(s, version).buffering)
  ensures (loadLands(s, version).dataApp == s.app)
  ensures (loadLands(s, version).version == version)
  ensures deltaMove(loadLands(s, version), (version + 1), false).data?
{
}

function newerLoadWins(s: SyncState, older: int, newer: int): SyncState
  requires good(s)
{
  var a := step(s, SyncEvent.begin);
  var b := step(a, SyncEvent.begin);
  var c := step(b, land(a.gen, a.app, older));
  step(c, land(b.gen, b.app, newer))
}

lemma newerLoadWins_ensures(s: SyncState, older: int, newer: int)
  requires good(s)
  ensures newerLoadWins(s, older, newer).synced
  ensures !(newerLoadWins(s, older, newer).buffering)
  ensures (newerLoadWins(s, older, newer).version == newer)
{
}

function serverEnded(status: int): bool
{
  ((status == 200) || (status == 404))
}

function badgeEnds(status: int): bool
{
  ((status == 200) || (status == 404))
}

lemma badgeEnds_ensures(status: int)
  ensures (badgeEnds(status) ==> serverEnded(status))
  ensures (serverEnded(status) ==> badgeEnds(status))
{
}

function unrevealStep(s: RevealState, status: int): RevealState
  requires (s.server ==> s.badge)
{
  RevealState((if serverEnded(status) then false else s.server), (if badgeEnds(status) then false else s.badge))
}

lemma unrevealStep_ensures(s: RevealState, status: int)
  requires (s.server ==> s.badge)
  ensures (unrevealStep(s, status).server ==> unrevealStep(s, status).badge)
  ensures (unrevealStep(s, status).badge ==> s.badge)
  ensures ((status == 200) ==> (!(unrevealStep(s, status).badge) && !(unrevealStep(s, status).server)))
{
}

function counts(g: Grant, app: string, real_: bool): bool
{
  ((((g.app == "*") || (g.app == app)) && (g.role != "cross_app_safety")) && !(((g.role == "engineer") && real_)))
}

function serverSkips(g: Grant, app: string, real_: bool): bool
{
  ((((g.app != "*") && (g.app != app)) || (g.role == "cross_app_safety")) || ((g.role == "engineer") && real_))
}

function serverHolds(grants: seq<Grant>, app: string, real_: bool, role: string): bool
{
  (exists g :: g in grants && (!(serverSkips(g, app, real_)) && (g.role == role)))
}

method run(s: SyncState, es: seq<SyncEvent>) returns (res: SyncState)
  requires good(s)
  ensures good(res)
  ensures (res.gen >= s.gen)
{
  var c := s;
  var i := 0;
  while (i < |es|)
    invariant (0 <= i)
    invariant (i <= |es|)
    invariant good(c)
    invariant (c.gen >= s.gen)
    decreases (|es| - i)
  {
    c := step(c, es[i]);
    i := (i + 1);
  }
  return c;
}

method appliedVersions(s: SyncState, ds: seq<Delta>) returns (res: seq<int>)
  requires good(s)
  ensures forall i: nat :: ((i < |res|) ==> (res[i] == ((s.version + 1) + i)))
{
  var c := s;
  var out: seq<int> := [];
  var i := 0;
  while (i < |ds|)
    invariant (0 <= i)
    invariant (i <= |ds|)
    invariant good(c)
    invariant (c.version == (s.version + |out|))
    invariant forall j: nat :: ((j < |out|) ==> (out[j] == ((s.version + 1) + j)))
    decreases (|ds| - i)
  {
    var i_t0 := deltaMove(c, ds[i].version, ds[i].reset);
    if i_t0.data? {
      out := (out + [ds[i].version]);
    }
    c := step(c, delta(ds[i].version, ds[i].reset));
    i := (i + 1);
  }
  return out;
}

method appendNew(feed: seq<Sequenced>, items: seq<Sequenced>) returns (res: seq<Sequenced>)
  requires forall i: nat, j: nat :: ((i < j) ==> (j < |feed|) ==> (feed[i].seq_ < feed[j].seq_))
  requires forall i: nat, j: nat :: ((i < j) ==> (j < |items|) ==> (items[i].seq_ < items[j].seq_))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res|) ==> (res[i].seq_ < res[j].seq_))
  ensures (|feed| <= |res|)
  ensures forall j: nat :: ((j < |feed|) ==> (res[j] == feed[j]))
  ensures forall k: nat :: ((k < |items|) ==> ((|feed| == 0) || (items[k].seq_ > feed[(|feed| - 1)].seq_)) ==> (items[k] in res))
{
  var out := feed;
  var k := 0;
  while (k < |items|)
    invariant (0 <= k)
    invariant (k <= |items|)
    invariant (|feed| <= |out|)
    invariant forall i: nat, j: nat :: ((i < j) ==> (j < |out|) ==> (out[i].seq_ < out[j].seq_))
    invariant forall j: nat :: ((j < |feed|) ==> (out[j] == feed[j]))
    invariant forall q: nat :: ((q < k) ==> ((|feed| == 0) || (items[q].seq_ > feed[(|feed| - 1)].seq_)) ==> (items[q] in out))
    invariant ((|out| > |feed|) ==> ((k > 0) && (out[(|out| - 1)].seq_ <= items[(k - 1)].seq_)))
    decreases (|items| - k)
  {
    if ((|out| == 0) || (items[k].seq_ > out[(|out| - 1)].seq_)) {
      out := (out + [items[k]]);
    }
    k := (k + 1);
  }
  return out;
}

method markersAfter(have: seq<string>, shown: seq<string>, isShown: set<string>, had: set<string>) returns (res: seq<string>)
  requires forall k :: ((k in isShown) == (k in shown))
  requires forall k :: ((k in had) == (k in have))
  ensures forall i: nat :: ((i < |res|) ==> (res[i] in shown))
  ensures forall i: nat :: ((i < |shown|) ==> (shown[i] in res))
{
  var out: seq<string> := [];
  var i := 0;
  while (i < |have|)
    invariant (0 <= i)
    invariant (i <= |have|)
    invariant forall j: nat :: ((j < |out|) ==> (out[j] in shown))
    invariant forall j: nat :: ((j < i) ==> (have[j] in isShown) ==> (have[j] in out))
    decreases (|have| - i)
  {
    if (have[i] in isShown) {
      out := (out + [have[i]]);
    }
    i := (i + 1);
  }
  var i_2 := 0;
  while (i_2 < |shown|)
    invariant (0 <= i_2)
    invariant (i_2 <= |shown|)
    invariant forall j: nat :: ((j < |out|) ==> (out[j] in shown))
    invariant forall j: nat :: ((j < |have|) ==> (have[j] in isShown) ==> (have[j] in out))
    invariant forall j: nat :: ((j < i_2) ==> (shown[j] in out))
    decreases (|shown| - i_2)
  {
    if !((shown[i_2] in had)) {
      out := (out + [shown[i_2]]);
    }
    i_2 := (i_2 + 1);
  }
  return out;
}

method unrevealRun(s: RevealState, statuses: seq<int>) returns (res: RevealState)
  requires (s.server ==> s.badge)
  ensures (res.server ==> res.badge)
{
  var c := s;
  var i := 0;
  while (i < |statuses|)
    invariant (0 <= i)
    invariant (i <= |statuses|)
    invariant (c.server ==> c.badge)
    decreases (|statuses| - i)
  {
    c := unrevealStep(c, statuses[i]);
    i := (i + 1);
  }
  return c;
}

method clientRoles(grants: seq<Grant>, app: string, real_: bool) returns (res: seq<string>)
  ensures forall r :: ((r in res) == serverHolds(grants, app, real_, r))
{
  var out: seq<string> := [];
  var i := 0;
  while (i < |grants|)
    invariant (0 <= i)
    invariant (i <= |grants|)
    invariant forall r :: ((r in out) == serverHolds(grants[0..i], app, real_, r))
    decreases (|grants| - i)
  {
    var i_t1 := counts(grants[i], app, real_);
    if i_t1 {
      out := (out + [grants[i].role]);
    }
    i := (i + 1);
  }
  return out;
}
