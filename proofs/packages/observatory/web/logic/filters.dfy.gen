// Generated by lsc from filters.ts

datatype Option<T> = None | Some(value: T)

datatype FilterKey = range | borough | members | origin | stateGroup

datatype FilterTab = review | feed | pipeline | requests | engine | safety | metrics | lab | config | game

datatype FilterView = FilterView(allTime: bool, since: int, borough: string, members: string, origin: string, stateGroup: string)

datatype FilterRow = FilterRow(t: int, timeless: bool, boroughs: seq<string>, tags: seq<string>, origin: Option<string>, group: string)

function tabKeys(tab: FilterTab): seq<FilterKey>
{
  match tab {
    case review =>
      [FilterKey.borough, FilterKey.members, FilterKey.origin]
    case feed =>
      [FilterKey.range, FilterKey.borough, FilterKey.members, FilterKey.origin]
    case pipeline =>
      [FilterKey.range, FilterKey.borough, FilterKey.members, FilterKey.origin, FilterKey.stateGroup]
    case engine =>
      [FilterKey.range]
    case safety =>
      [FilterKey.range, FilterKey.borough, FilterKey.members]
    case metrics =>
      [FilterKey.range, FilterKey.borough, FilterKey.origin]
    case requests =>
      [FilterKey.range, FilterKey.borough, FilterKey.members]
    case lab =>
      []
    case config =>
      []
    case game =>
      []
  }
}

