function toggleMode(ctl: Ctl, id: string, m: Mode): Ctl
  requires (id != "")
  requires (!m.idle?)
  requires ctlOk(ctl)
{
  var c := choose(ctl, id);
  if (c.mode == m) then
    leaveMode(c)
  else
    Ctl(m, id, (if m.edit? then id else c.draftsId), true)
}

lemma toggleMode_ensures(ctl: Ctl, id: string, m: Mode)
  requires (id != "")
  requires (!m.idle?)
  requires ctlOk(ctl)
  ensures (toggleMode(ctl, id, m).boundId == id)
  ensures toggleMode(ctl, id, m).chosen
  ensures ((ctl.boundId == id) ==> (ctl.mode == m) ==> toggleMode(ctl, id, m).mode.idle?)
  ensures (!(((ctl.boundId == id) && (ctl.mode == m))) ==> (toggleMode(ctl, id, m).mode == m))
  ensures ((toggleMode(ctl, id, m).draftsId == id) ==> (!m.edit?) ==> ((ctl.boundId == id) && (ctl.draftsId == id)))
  ensures ctlOk(toggleMode(ctl, id, m))
{
}

function settle(ctl: Ctl, id: string): Ctl
{
  if (ctl.boundId != id) then
    ctl
  else
    Ctl(Mode.idle, id, "", ctl.chosen)
}

lemma settle_ensures(ctl: Ctl, id: string)
  ensures ((ctl.boundId != id) ==> (settle(ctl, id) == ctl))
  ensures ((ctl.boundId == id) ==> (((settle(ctl, id).mode.idle? && (settle(ctl, id).draftsId == "")) && (settle(ctl, id).boundId == id)) && (settle(ctl, id).chosen == ctl.chosen)))
  ensures (ctlOk(ctl) ==> ctlOk(settle(ctl, id)))
{
}

function moveOnAfter(mounted: bool, ctl: Ctl, id: string): bool
{
  (mounted && (!(ctl.chosen) || (ctl.boundId == id)))
}

lemma moveOnAfter_ensures(mounted: bool, ctl: Ctl, id: string)
  ensures (!(mounted) ==> !(moveOnAfter(mounted, ctl, id)))
