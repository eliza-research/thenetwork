// Generated by lsc from review.ts

datatype Option<T> = None | Some(value: T)

datatype Mode = idle | reject | edit | reroll

datatype Ctl = Ctl(mode: Mode, boundId: string, draftsId: string, chosen: bool)

datatype Key = a | r | e | s | digit | esc

datatype Press = Press(key: Key, digit: int, repeat: bool, blocked: bool, canAct: bool, reasons: int, swaps: int)

datatype Cmd = nothing | approve(id: string, withEdits: bool) | reject(id: string, digit: int) | reroll(id: string, digit: int)

datatype Step = Step(ctl: Ctl, cmd: Cmd)

datatype Block = idle | read_only | minor | declined | matching_off | expired

datatype ReportStatus = open | held | banned | dismissed

datatype Offer = Offer(hold: bool, ban: bool, dismiss: bool, clear: bool)

datatype Pending = Pending(active: bool, target: bool)

datatype Flip = Flip(pending: Pending, send: bool, on: bool)

datatype Decision = reject | expired | pending | approve

datatype Line = waiting | closed_unsent | expired_unsent | stopped | approved | rejected

datatype ReviewFacts = ReviewFacts(decision: Decision, invalidated: bool, inReview: bool)

datatype Person = Person(minor: bool, declined: Option<bool>)

function ctlOk(c: Ctl): bool
{
  ((((c.draftsId == "") || (c.draftsId == c.boundId)) && ((!c.mode.edit?) || (c.draftsId == c.boundId))) && (c.chosen || (c.mode.idle? && (c.draftsId == ""))))
}

function rebind(ctl: Ctl, selId: string): Ctl
  requires (selId != "")
{
  if (ctl.boundId == selId) then
    ctl
  else
    Ctl(Mode.idle, selId, "", false)
}

lemma rebind_ensures(ctl: Ctl, selId: string)
  requires (selId != "")
  ensures (rebind(ctl, selId).boundId == selId)
  ensures ((ctl.boundId == selId) ==> (rebind(ctl, selId) == ctl))
  ensures ((ctl.boundId != selId) ==> ((rebind(ctl, selId).mode.idle? && (rebind(ctl, selId).draftsId == "")) && !(rebind(ctl, selId).chosen)))
  ensures (ctlOk(ctl) ==> ctlOk(rebind(ctl, selId)))
{
}

function choose(ctl: Ctl, id: string): Ctl
  requires (id != "")
{
  var c := rebind(ctl, id);
  Ctl(c.mode, c.boundId, c.draftsId, true)
}

lemma choose_ensures(ctl: Ctl, id: string)
  requires (id != "")
  ensures (choose(ctl, id).boundId == id)
  ensures choose(ctl, id).chosen
  ensures ((!choose(ctl, id).mode.idle?) ==> (ctl.boundId == id))
  ensures ((choose(ctl, id).draftsId == id) ==> ((ctl.boundId == id) && (ctl.draftsId == id)))
  ensures (ctlOk(ctl) ==> ctlOk(choose(ctl, id)))
{
}

function leaveMode(c: Ctl): Ctl
{
  Ctl(Mode.idle, c.boundId, (if c.mode.edit? then "" else c.draftsId), c.chosen)
}

lemma leaveMode_ensures(c: Ctl)
  ensures leaveMode(c).mode.idle?
  ensures (leaveMode(c).boundId == c.boundId)
  ensures (leaveMode(c).chosen == c.chosen)
  ensures (c.mode.edit? ==> (leaveMode(c).draftsId == ""))
  ensures ((!c.mode.edit?) ==> (leaveMode(c).draftsId == c.draftsId))
  ensures (ctlOk(c) ==> ctlOk(leaveMode(c)))
{
}

function keyStep(ctl0: Ctl, selId: string, p: Press): Step
  requires (selId != "")
  requires ctlOk(ctl0)
{
  var ctl := rebind(ctl0, selId);
  if p.key.esc? then
    Step(leaveMode(ctl), Cmd.nothing)
  else
    if (p.repeat || !(p.canAct)) then
      Step(ctl, Cmd.nothing)
    else
      if ((ctl0.boundId != selId) || !(ctl0.chosen)) then
        Step(choose(ctl0, selId), Cmd.nothing)
      else
        if p.key.a? then
          if p.blocked then
            Step(ctl, Cmd.nothing)
          else
            Step(ctl, Cmd.approve(selId, (ctl.draftsId == selId)))
        else
          if p.key.digit? then
            if ((ctl.mode.reject? && (p.digit >= 1)) && (p.digit <= p.reasons)) then
              Step(ctl, Cmd.reject(selId, p.digit))
            else
              if ((ctl.mode.reroll? && (p.digit >= 1)) && (p.digit <= p.swaps)) then
                Step(ctl, Cmd.reroll(selId, p.digit))
              else
                Step(ctl, Cmd.nothing)
          else
            if p.key.r? then
              Step(Ctl(Mode.reject, selId, ctl.draftsId, true), Cmd.nothing)
            else
              if p.key.s? then
                if (p.swaps < 1) then
                  Step(ctl, Cmd.nothing)
                else
                  Step(Ctl(Mode.reroll, selId, ctl.draftsId, true), Cmd.nothing)
              else
                Step(Ctl(Mode.edit, selId, selId, true), Cmd.nothing)
}

