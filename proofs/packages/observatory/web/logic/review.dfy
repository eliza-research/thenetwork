function backendHold(s: ReportStatus): bool
{
  s.open?
}

function backendBan(s: ReportStatus): bool
{
  (s.open? || s.held?)
}

function backendDismiss(s: ReportStatus): bool
{
  s.open?
}

function reportOffer(status: ReportStatus, canBan: bool, safety: bool, everywhere: bool, minorKind: bool, canAct: bool): Offer
{
  var live := (status.open? || status.held?);
  var clear := (((minorKind && canAct) && safety) && live);
  if ((!(canBan) || !(safety)) || !(live)) then
    Offer(false, false, false, clear)
  else
    var open := status.open?;
    Offer(open, everywhere, open, clear)
}

lemma reportOffer_ensures(status: ReportStatus, canBan: bool, safety: bool, everywhere: bool, minorKind: bool, canAct: bool)
  ensures (canBan ==> safety ==> (((reportOffer(status, canBan, safety, everywhere, minorKind, canAct).ban == (everywhere && backendBan(status))) && (reportOffer(status, canBan, safety, everywhere, minorKind, canAct).hold == backendHold(status))) && (reportOffer(status, canBan, safety, everywhere, minorKind, canAct).dismiss == backendDismiss(status))))
  ensures (!((canBan && safety)) ==> ((!(reportOffer(status, canBan, safety, everywhere, minorKind, canAct).ban) && !(reportOffer(status, canBan, safety, everywhere, minorKind, canAct).hold)) && !(reportOffer(status, canBan, safety, everywhere, minorKind, canAct).dismiss)))
  ensures (reportOffer(status, canBan, safety, everywhere, minorKind, canAct).ban ==> everywhere)
  ensures (reportOffer(status, canBan, safety, everywhere, minorKind, canAct).clear <==> (((minorKind && canAct) && safety) && backendBan(status)))
{
}

function flip(p: Pending, current: bool): Flip
{
  if !(p.active) then
    Flip(Pending(true, !(current)), false, current)
  else
    if (p.target == current) then
      Flip(Pending(false, current), false, current)
    else
      Flip(Pending(false, current), true, p.target)
}

lemma flip_ensures(p: Pending, current: bool)
  ensures (flip(p, current).send ==> ((p.active && (flip(p, current).on == p.target)) && (flip(p, current).on != current)))
  ensures (p.active ==> (p.target != current) ==> flip(p, current).send)
  ensures (!(p.active) ==> ((!(flip(p, current).send) && flip(p, current).pending.active) && (flip(p, current).pending.target == !(current))))
  ensures (p.active ==> !(flip(p, current).pending.active))
{
}

function reviewStatus(r: ReviewFacts): Line
{
  if r.decision.pending? then
    if r.inReview then
      Line.waiting
    else
      Line.closed_unsent
  else
    if r.decision.expired? then
      Line.expired_unsent
    else
      if r.invalidated then
        Line.stopped
      else
        if r.decision.approve? then
          Line.approved
        else
          Line.rejected
}

lemma reviewStatus_ensures(r: ReviewFacts)
  ensures (reviewStatus(r).waiting? <==> (r.inReview && r.decision.pending?))
  ensures (reviewStatus(r).approved? <==> (r.decision.approve? && !(r.invalidated)))
  ensures (reviewStatus(r).rejected? <==> (r.decision.reject? && !(r.invalidated)))
  ensures (reviewStatus(r).expired_unsent? <==> r.decision.expired?)
  ensures (r.decision.pending? ==> !(r.inReview) ==> reviewStatus(r).closed_unsent?)
{
}

method approveBlock(canAct: bool, ids: seq<string>, people: map<string, Person>, matchingOff: bool, now: int, deadline: int) returns (res: Block)
  ensures (res.idle? <==> (((canAct && !(matchingOff)) && (now < deadline)) && forall k: nat :: ((k < |ids|) ==> (((ids[k] in people) && !(people[ids[k]].minor)) && (match people[ids[k]].declined { case Some(i_value) => (i_value != true) case None => true })))))
{
  if !(canAct) {
    return Block.read_only;
  }
  var i := 0;
  while (i < |ids|)
    invariant (0 <= i)
    invariant (i <= |ids|)
    invariant forall k: nat :: ((k < i) ==> ((ids[k] in people) && !(people[ids[k]].minor)))
    decreases (|ids| - i)
  {
    if (ids[i] in people) {
      var i_p_val := people[ids[i]];
      if i_p_val.minor {
        return Block.minor;
      }
      i := (i + 1);
    } else {
      return Block.minor;
    }
  }
  var i_2 := 0;
  while (i_2 < |ids|)
    invariant (0 <= i_2)
    invariant (i_2 <= |ids|)
    invariant forall k: nat :: ((k < |ids|) ==> ((ids[k] in people) && !(people[ids[k]].minor)))
    invariant forall k: nat :: ((k < i_2) ==> (match people[ids[k]].declined { case Some(i_value) => (i_value != true) case None => true }))
    decreases (|ids| - i_2)
  {
    if (ids[i_2] in people) {
      var i_p_val := people[ids[i_2]];
      if (match i_p_val.declined { case Some(i_value) => (i_value == true) case None => false }) {
        return Block.declined;
      }
    }
    i_2 := (i_2 + 1);
  }
  if matchingOff {
    return Block.matching_off;
  }
  if (now < deadline) {
    return Block.idle;
  }
  return Block.expired;
}
