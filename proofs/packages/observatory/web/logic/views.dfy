datatype TabCaps = TabCaps(showReview: bool, game: bool, hasRequests: bool, analyst: bool, realOnly: bool)

datatype DurParts = DurParts(d: int, h: int, m: int)

function photoAllowed(g: PhotoGate): bool
{
  ((g.rule.reason_required? && g.canSafety) && !(g.minor))
}

