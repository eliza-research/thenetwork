    invariant ((forall k: nat :: ((k < i) ==> forall j: nat :: ((j < |opps[k]|) ==> saidYes(opps[k][j])))) ==> ((yes == i) && (revealed == i)))
    invariant yes > 0 ==> yesWitness < i && (forall j: nat :: j < |opps[yesWitness]| ==> saidYes(opps[yesWitness][j]))
    invariant (0 <= yes)
