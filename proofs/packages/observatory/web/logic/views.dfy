function planView(off: bool, told: Option<int>, hours: int, at: int, now: int): PlanView
  requires (hours >= 0)
{
  if off then
    PlanView.called_off
  else
    match told {
      case Some(i_told_val) =>
        if (planCloses(i_told_val, hours, at) > now) then
          PlanView.open
        else
          PlanView.confirmed
      case None =>
        PlanView.not_told
    }
}

