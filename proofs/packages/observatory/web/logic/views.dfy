method rate(a: int, b: int) returns (res: Option<int>)
  requires (a >= 0)
  requires (b >= 0)
  ensures ((b == 0) ==> (match res { case Some(i_) => false case None => true }))
  ensures ((b > 0) ==> (match res { case Some(i_) => true case None => false }))
  ensures (match res { case Some(i_result_val) => ((0 <= i_result_val) && (i_result_val <= 100)) case None => true })
  ensures (match res { case Some(i_result_val) => ((a < b) ==> ((((2 * i_result_val) * b) <= ((200 * a) + b)) && (((200 * a) + b) < (((2 * i_result_val) * b) + (2 * b))))) case None => true })
  ensures (match res { case Some(i_result_val) => ((a >= b) ==> (i_result_val == 100)) case None => true })
{
  if (b == 0) {
    return None;
  }
  if (a >= b) {
    return Some(100);
  }
  var p := JSFloorDiv(((200 * a) + b), (2 * b));
  assert (((p * (2 * b)) <= ((200 * a) + b)) && (((200 * a) + b) < ((p + 1) * (2 * b))));
  assert (((200 * a) + b) < (201 * b));
  return Some(p);
}

method canPropose(picks: seq<string>, minor: map<string, bool>, hasGame: bool, sparks: int, over: bool) returns (res: bool)
  ensures (res ==> ((hasGame && (sparks > 0)) && !(over)))
  ensures (res ==> forall i: nat :: ((i < |picks|) ==> ((picks[i] in minor) && !(minor[picks[i]]))))
  ensures (hasGame ==> (sparks > 0) ==> !(over) ==> (forall i: nat :: ((i < |picks|) ==> ((picks[i] in minor) && !(minor[picks[i]])))) ==> res)
{
  if ((!(hasGame) || (sparks <= 0)) || over) {
    return false;
  }
  var i := 0;
  while (i < |picks|)
    invariant (0 <= i)
    invariant (i <= |picks|)
    invariant forall j: nat :: ((j < i) ==> ((picks[j] in minor) && !(minor[picks[j]])))
    decreases (|picks| - i)
  {
    if !((picks[i] in minor)) {
      return false;
    }
    if ((picks[i] in minor) && (var i_value := minor[picks[i]]; (i_value == true))) {
      return false;
    }
    i := (i + 1);
  }
  return true;
}
