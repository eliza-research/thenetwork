method photoTrail(gates: seq<PhotoGate>, loaded: bool) returns (res: bool)
  ensures (res ==> forall i: nat :: ((i < |gates|) ==> photoAllowed(gates[i])))
{
  var held := loaded;
  var i := 0;
  while (i < |gates|)
    invariant (0 <= i)
    invariant (i <= |gates|)
    invariant (held ==> forall j: nat :: ((j < i) ==> photoAllowed(gates[j])))
    decreases (|gates| - i)
  {
    held := photoHeld(gates[i], held);
    i := (i + 1);
  }
  return held;
}

method shownRise(events: seq<ReadEvent>) returns (res: bool)
  ensures res
{
  var i_t0 := readNew();
  var g := i_t0;
  var top := 0;
  var i := 0;
  while (i < |events|)
    invariant (0 <= i)
    invariant (i <= |events|)
    invariant readOk(g)
    invariant (top <= g.closed)
    decreases (|events| - i)
  {
    var e := events[i];
    match e {
      case start =>
        g := readStart(g);
      case cancel =>
        g := readCancel(g);
      case land(i_e_ticket) =>
        var i_t1 := readLand(g, i_e_ticket);
        var r := i_t1;
        if r.show {
          if (i_e_ticket <= top) {
            return false;
          }
          top := i_e_ticket;
        }
        g := r.gate;
    }
    i := (i + 1);
  }
  return true;
}

