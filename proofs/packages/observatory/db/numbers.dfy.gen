// Generated by lsc from numbers.ts

method dupAt(ids: seq<string>) returns (res: int)
  requires forall k: int :: ((0 <= k) ==> (k < |ids|) ==> (|ids[k]| >= 4))
  ensures ((res == -1) ==> forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |ids|) ==> (ids[a][0..4] != ids[b][0..4])))
  ensures ((res != -1) ==> ((0 <= res) && (res < |ids|)))
{
  var seen: map<string, string> := map[];
  var i := 0;
  while (i < |ids|)
    invariant (0 <= i)
    invariant (i <= |ids|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (ids[k][0..4] in seen))
    invariant forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < i) ==> (ids[a][0..4] != ids[b][0..4]))
    decreases (|ids| - i)
  {
    var n := ids[i][0..4];
    if (n in seen) {
      return i;
    }
    seen := seen[n := ids[i]];
    i := (i + 1);
  }
  return -1;
}
