// Generated by lsc from staff-roles.ts

datatype GrantRole = admin | reviewer | safety | analyst | engineer | cross_app_safety

datatype GrantMode = game | real_

datatype Grant = Grant(role: GrantRole, app: string)

function roleCounts(g: Grant, app: string, mode: GrantMode): bool
{
  if ((g.app != "*") && (g.app != app)) then
    false
  else
    !((g.role.cross_app_safety? || (g.role.engineer? && mode.real_?)))
}

lemma roleCounts_ensures(g: Grant, app: string, mode: GrantMode)
  ensures (roleCounts(g, app, mode) ==> (!g.role.cross_app_safety?))
  ensures (roleCounts(g, app, mode) ==> mode.real_? ==> (!g.role.engineer?))
  ensures (roleCounts(g, app, mode) ==> ((g.app == "*") || (g.app == app)))
{
}

function allowedFor(grants: seq<Grant>, need: seq<GrantRole>, app: string, mode: GrantMode): bool
{
  (exists g :: g in grants && (roleCounts(g, app, mode) && (g.role.admin? || (g.role in need))))
}

lemma allowedFor_ensures(grants: seq<Grant>, need: seq<GrantRole>, app: string, mode: GrantMode)
  ensures (allowedFor(grants, need, app, mode) ==> exists i: int :: ((((0 <= i) && (i < |grants|)) && roleCounts(grants[i], app, mode)) && (grants[i].role.admin? || (grants[i].role in need))))
{
}

function holdsEverywhere(grants: seq<Grant>, role: GrantRole): bool
{
  (exists g :: g in grants && ((g.role == role) && (g.app == "*")))
}

function crossAppAllowed(grants: seq<Grant>): bool
{
  (holdsEverywhere(grants, GrantRole.admin) || holdsEverywhere(grants, GrantRole.cross_app_safety))
}

lemma crossAppAllowed_ensures(grants: seq<Grant>)
  ensures (crossAppAllowed(grants) ==> exists i: int :: ((((0 <= i) && (i < |grants|)) && (grants[i].app == "*")) && (grants[i].role.admin? || grants[i].role.cross_app_safety?)))
{
}
