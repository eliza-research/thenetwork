const ANY_APP: string := "*"

const PERSON_REASON_MIN: int := 5

method holdLines(rows: seq<MembershipRow>) returns (res: seq<HoldLine>)
  ensures forall i: nat :: ((i < |res|) ==> lineOk(rows, res[i]))
  ensures forall i: nat, j: nat :: ((i < |res|) ==> (j < |res|) ==> (res[i].row == -1) ==> (res[j].row == -1) ==> (i == j))
  ensures ((exists i: nat :: ((i < |res|) && (res[i].row == -1))) <==> exists k: nat :: ((k < |rows|) && hiddenHeld(rows[k])))
{
  var out: seq<HoldLine> := [];
  var star := false;
  var i := 0;
  while (i < |rows|)
    invariant (0 <= i)
    invariant (i <= |rows|)
    invariant forall j: nat :: ((j < |out|) ==> lineOk(rows, out[j]))
    invariant forall a: nat, b: nat :: ((a < |out|) ==> (b < |out|) ==> (out[a].row == -1) ==> (out[b].row == -1) ==> (a == b))
    invariant (star <==> exists j: nat :: ((j < |out|) && (out[j].row == -1)))
    invariant (star <==> exists k: nat :: ((k < i) && hiddenHeld(rows[k])))
    decreases (|rows| - i)
  {
    var r := rows[i];
    ghost var out0 := out;
    if r.hidden {
      if ((r.hold || r.restricted) && !(star)) {
        out := (out + [HoldLine(-1, ANY_APP, HoldLevel.restricted)]);
        star := true;
        assert out[|out| - 1].row == -1;
      }
    } else {
      if r.hold {
        out := (out + [HoldLine(i, r.app, HoldLevel.hold)]);
      }
      if r.restricted {
        out := (out + [HoldLine(i, r.app, HoldLevel.restricted)]);
      }
      if r.recycled {
        out := (out + [HoldLine(i, r.app, HoldLevel.recycled_number)]);
      }
      assert out[..|out0|] == out0;
      assert forall j: nat :: |out0| <= j < |out| ==> out[j].row == i;
    }
    i := (i + 1);
  }
  return out;
}
