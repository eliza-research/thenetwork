  ensures (match code { case Some(i_code_val) => ((i_code_val in NUMBER_BLOCK_CODES) ==> !((i_code_val in CONVERSATION_WAIT_CODES)) ==> classifyFailure(status, code, retryAfterMs).blocked?) case None => true })
  ensures (!classifyFailure(status, code, retryAfterMs).unknown?)
  ensures ((status == 401) ==> (match code { case Some(i_) => false case None => true }) ==> classifyFailure(status, code, retryAfterMs).auth?)
  ensures ((status >= 500) ==> (match code { case Some(i_) => false case None => true }) ==> classifyFailure(status, code, retryAfterMs).retryable?)
{
