const CONVERSATION_WAIT_CODES: set<string> := {"conversation_awaiting_reply", "conversation_streak_limit", "conversation_inactive_paused", "conversation_content_restricted"}

const NUMBER_BLOCK_CODES: set<string> := {"safety_new_conversations_paused", "safety_reply_only", "safety_account_review", "inbound_only_no_prior_inbound"}
