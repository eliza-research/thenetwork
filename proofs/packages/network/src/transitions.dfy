function probeRoute(c: Reading, why: ReadingWhy, p: TimePicks): ProbeRoute
{
  if why.refusal? then
    if p.firmPick then
      ProbeRoute.mixed
    else
      ProbeRoute.no
  else
    if ((why.mixed? || why.conditional?) || why.hedged?) then
      ProbeRoute.unclear
    else
      if c.no? then
        ProbeRoute.unclear
      else
        if (c.counter? || why.counter?) then
          if p.hasOptions then
            ProbeRoute.ask_times
          else
            ProbeRoute.unclear
        else
          if (p.picked && (c.yes? || p.firmPick)) then
            ProbeRoute.picked
          else
            if p.neither then
              if c.yes? then
                ProbeRoute.none_fit
              else
                if p.hasOptions then
                  ProbeRoute.ask_times
                else
                  ProbeRoute.unclear
            else
              if p.anyOf then
                if p.openLeft then
                  ProbeRoute.open
                else
                  ProbeRoute.unclear
              else
                if c.yes? then
                  ProbeRoute.open
                else
                  ProbeRoute.unclear
}

