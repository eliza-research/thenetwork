}

lemma relayPartyVerdict_ensures(p: RelayPartyFacts)
  ensures ((relayPartyVerdict(p) == "ok") ==> ((((p.known && !(p.declined)) && p.adultSure) && !(p.optedOut)) && !(p.held)))
{
}

function relayDispatchVerdict(f: RelayDispatchFacts): string
{
  if (f.samePerson || !(f.pairOk)) then
    "relay:pair"
  else
    if ((!f.status.mutual?) || !(f.bothAccepted)) then
      "state:closed"
    else
      var first := relayPartyVerdict(f.from);
      if (first != "ok") then
        first
      else
        var second := relayPartyVerdict(f.to);
        if (second != "ok") then
          second
        else
          if f.blocked then
            "party:blocked"
          else
            "ok"
}

lemma relayDispatchVerdict_ensures(f: RelayDispatchFacts)
  ensures ((relayDispatchVerdict(f) == "ok") ==> ((((!(f.samePerson) && f.pairOk) && f.status.mutual?) && f.bothAccepted) && !(f.blocked)))
  ensures ((relayDispatchVerdict(f) == "ok") ==> ((((f.from.known && !(f.from.declined)) && f.from.adultSure) && !(f.from.optedOut)) && !(f.from.held)))
  ensures ((relayDispatchVerdict(f) == "ok") ==> ((((f.to.known && !(f.to.declined)) && f.to.adultSure) && !(f.to.optedOut)) && !(f.to.held)))
{
}

function swapPlan(theirPass: bool, myPass: bool, canFirst: bool, canSecond: bool): int
{
  if (((!(theirPass) || !(myPass)) || !(canFirst)) || !(canSecond)) then
    0
  else
    2
}

lemma swapPlan_ensures(theirPass: bool, myPass: bool, canFirst: bool, canSecond: bool)
  ensures ((swapPlan(theirPass, myPass, canFirst, canSecond) == 0) || (swapPlan(theirPass, myPass, canFirst, canSecond) == 2))
  ensures ((swapPlan(theirPass, myPass, canFirst, canSecond) == 2) <==> (((theirPass && myPass) && canFirst) && canSecond))
{
}

function heldAfter(status: HeldStatus, a: HeldAction): HeldStatus
{
  if (!status.held?) then
    status
  else
    if a.reject? then
      HeldStatus.rejected
    else
      HeldStatus.released
}

lemma heldAfter_ensures(status: HeldStatus, a: HeldAction)
  ensures ((!status.held?) ==> (heldAfter(status, a) == status))
  ensures (status.held? ==> (!heldAfter(status, a).held?))
  ensures (status.held? ==> a.reject? ==> heldAfter(status, a).rejected?)
{
}

function keepsHeldText(status: HeldStatus): bool
{
  status.held?
}

lemma keepsHeldText_ensures(status: HeldStatus)
  ensures (keepsHeldText(status) <==> status.held?)
{
}

function postingAction(hasId: bool, close: bool, hasPrev: bool, prevActive: bool, hasTitle: bool, hasPay: bool): PostingAction
{
  if !(hasId) then
    PostingAction.skip
  else
    if (hasPrev && !(prevActive)) then
      PostingAction.skip
    else
      if close then
        if hasPrev then
          PostingAction.close
        else
          PostingAction.skip
      else
        if (hasTitle && hasPay) then
          PostingAction.save
        else
          PostingAction.skip
}

lemma postingAction_ensures(hasId: bool, close: bool, hasPrev: bool, prevActive: bool, hasTitle: bool, hasPay: bool)
  ensures (postingAction(hasId, close, hasPrev, prevActive, hasTitle, hasPay).save? ==> (((hasId && !(close)) && hasTitle) && hasPay))
  ensures (postingAction(hasId, close, hasPrev, prevActive, hasTitle, hasPay).close? ==> ((hasId && close) && hasPrev))
  ensures ((!postingAction(hasId, close, hasPrev, prevActive, hasTitle, hasPay).skip?) ==> hasPrev ==> prevActive)
  ensures (close ==> (!postingAction(hasId, close, hasPrev, prevActive, hasTitle, hasPay).save?))
{
}

function payRangeOk(payMin: real, payMax: real): bool
{
  (((payMin >= (10 as real)) && (payMax >= payMin)) && (payMax <= (999 as real)))
}

lemma payRangeOk_ensures(payMin: real, payMax: real)
  ensures (payRangeOk(payMin, payMax) ==> (((payMin >= (10 as real)) && (payMin <= payMax)) && (payMax <= (999 as real))))
{
}

const WATCH: int := 3

const HOLD: int := 6

const REPORT_POINTS: int := 3

method recipientVerdict(r: RecipientFacts, s: SendClass, about: seq<OtherFacts>) returns (res: string)
  ensures ((res == "ok") ==> ((!(r.declined) && r.known) && !(r.optedOut)))
  ensures ((res == "ok") ==> !(s.safety) ==> !(r.cannotJoin))
  ensures ((res == "ok") ==> !(s.reply) ==> !(s.safety) ==> (!(r.account) && !(r.held)))
  ensures ((res == "ok") ==> s.proactive ==> !(s.reengage) ==> !(r.onlyWhenAsked))
  ensures ((res == "ok") ==> s.askKind ==> !(s.reply) ==> !(s.reengage) ==> !(r.onlyWhenAsked))
  ensures ((res == "ok") ==> s.aboutOthers ==> (!(r.minor) && r.trustOk))
  ensures ((res == "ok") ==> s.aboutOthers ==> forall i: int :: ((0 <= i) ==> (i < |about|) ==> (((((!(about[i].blocked) && about[i].known) && !(about[i].minor)) && !(about[i].account)) && !(about[i].declined)) && about[i].trustOk)))
{
  if r.declined {
    return "declined";
  }
  if !(r.known) {
    return "unknown_member";
  }
  if r.optedOut {
    return "opted_out";
  }
  if (r.cannotJoin && !(s.safety)) {
    return "cannot_join";
  }
  if ((r.account && !(s.reply)) && !(s.safety)) {
    return "account_";
  }
  if ((!(s.reply) && !(s.safety)) && r.held) {
    return "held";
  }
  if ((r.onlyWhenAsked && !(s.reengage)) && (s.proactive || (s.askKind && !(s.reply)))) {
    return "only_when_asked";
  }
  if !(s.aboutOthers) {
    return "ok";
  }
  if r.minor {
    return "minor";
  }
  if !(r.trustOk) {
    return "on_watch";
  }
  var i := 0;
  while (i < |about|)
    invariant (i <= |about|)
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> (((((!(about[j].blocked) && about[j].known) && !(about[j].minor)) && !(about[j].account)) && !(about[j].declined)) && about[j].trustOk))
    decreases (|about| - i)
  {
    var i_t0 := otherVerdict(about[i]);
    var v := i_t0;
    if (v != "ok") {
      return v;
    }
    i := (i + 1);
  }
  return "ok";
}

// One send appended at the end (the shipped order): the window count rises by exactly one.
lemma windowCount_append(ts: seq<int>, now: int, windowMs: int)
  requires windowMs > 0
  ensures windowCount(ts + [now], now, windowMs) == windowCount(ts, now, windowMs) + 1
{
  if |ts| == 0 {
    assert windowCount([now][1..], now, windowMs) == 0;
  } else {
    assert (ts + [now])[1..] == ts[1..] + [now];
    windowCount_append(ts[1..], now, windowMs);
  }
}

// The budget invariant: a send that mayPush allowed keeps the rolling window at or under the cap.
lemma cap_holds_after_send(ts: seq<int>, now: int, windowMs: int, cap: int)
  requires windowMs > 0
  requires mayPush(ts, now, windowMs, cap)
  ensures windowCount(withSend(ts, now), now, windowMs) <= cap
{
  windowCount_append(ts, now, windowMs);
  assert withSend(ts, now) == ts + [now];
}
