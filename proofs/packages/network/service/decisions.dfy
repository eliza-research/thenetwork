function classifyDeliver(v: DeliverView, receiptOnly: bool): DeliverClass
{
  if (((v.status == 200) && v.ok.yes?) && v.wellFormedAccept) then
    DeliverClass.accepted
  else
    if (((receiptOnly && v.ok.no?) && v.error.rejected?) && v.retryable) then
      DeliverClass.not_admitted
    else
      if ((!(receiptOnly) && v.ok.no?) && (!v.error.unknown?)) then
        if v.error.opted_out? then
          DeliverClass.blocked
        else
          if (v.error.rejected? && v.retryable) then
            DeliverClass.retryable
          else
            if refusalStatus(v.status) then
              DeliverClass.invalid
            else
              DeliverClass.unknown
      else
        DeliverClass.unknown
}

