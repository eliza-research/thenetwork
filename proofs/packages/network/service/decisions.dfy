  ensures (classifyDeliver(v, receiptOnly).not_admitted? ==> (((receiptOnly && v.ok.no?) && v.error.rejected?) && v.retryable))
{
}

function liveAllowed(allowSend: bool, networkApproved: bool, appApproved: bool): bool
{
  ((allowSend && networkApproved) && appApproved)
}

lemma liveAllowed_ensures(allowSend: bool, networkApproved: bool, appApproved: bool)
  ensures (liveAllowed(allowSend, networkApproved, appApproved) <==> ((allowSend && networkApproved) && appApproved))
{
}

function relayWire(d: DeskDecision): WireDecision
{
  if d.sent? then
    WireDecision.pass
  else
    if d.held? then
      WireDecision.hold
    else
      WireDecision.block
}

lemma relayWire_ensures(d: DeskDecision)
  ensures (relayWire(d).pass? <==> d.sent?)
  ensures (!relayWire(d).none?)
{
}

function rowAccepted(status: string): bool
{
  ((((status == "accepted") || (status == "sent")) || (status == "delivered")) || (status == "read"))
}

function relayDelivered(decision: WireDecision, hasRow: bool, status: string, history: bool, providerIds: int): bool
  requires (providerIds >= 0)
{
  if (!decision.pass?) then
    false
  else
    (((hasRow && rowAccepted(status)) && history) && (providerIds > 0))
}

lemma relayDelivered_ensures(decision: WireDecision, hasRow: bool, status: string, history: bool, providerIds: int)
  requires (providerIds >= 0)
  ensures (relayDelivered(decision, hasRow, status, history, providerIds) ==> ((((decision.pass? && hasRow) && history) && (providerIds > 0)) && rowAccepted(status)))
{
}

function relayCanonical(hasRow: bool, rowOptedOut: bool, accountActive: bool, bound: bool, adult: bool): RelayParty
{
  RelayParty(adult, ((!(hasRow) || rowOptedOut) || !(bound)), (!(hasRow) || !(accountActive)))
}

lemma relayCanonical_ensures(hasRow: bool, rowOptedOut: bool, accountActive: bool, bound: bool, adult: bool)
  ensures (!(hasRow) ==> (relayCanonical(hasRow, rowOptedOut, accountActive, bound, adult).optedOut && relayCanonical(hasRow, rowOptedOut, accountActive, bound, adult).held))
  ensures (!(bound) ==> relayCanonical(hasRow, rowOptedOut, accountActive, bound, adult).optedOut)
  ensures (!(relayCanonical(hasRow, rowOptedOut, accountActive, bound, adult).optedOut) ==> !(relayCanonical(hasRow, rowOptedOut, accountActive, bound, adult).held) ==> (((hasRow && bound) && !(rowOptedOut)) && accountActive))
{
}

function windowActive(w: WindowTimes): bool
{
  (((!(w.optedOut) && w.hasWindow) && (!(w.hasFrom) || (w.fromMs <= w.now))) && (!(w.hasUntil) || (w.untilMs > w.now)))
}

lemma windowActive_ensures(w: WindowTimes)
  ensures (windowActive(w) ==> (!(w.optedOut) && w.hasWindow))
  ensures (windowActive(w) ==> w.hasFrom ==> (w.fromMs <= w.now))
  ensures (windowActive(w) ==> w.hasUntil ==> (w.untilMs > w.now))
{
}

function effectiveState(optedOut: bool, active: bool, w: WindowState, base: Participation): Participation
{
  if optedOut then
    Participation.paused
  else
    if !(active) then
      base
    else
      if w.open? then
        Participation.normal
      else
        if w.paused? then
          Participation.paused
        else
          Participation.quiet
}

lemma effectiveState_ensures(optedOut: bool, active: bool, w: WindowState, base: Participation)
  ensures (optedOut ==> effectiveState(optedOut, active, w, base).paused?)
  ensures (active ==> !(optedOut) ==> w.paused? ==> effectiveState(optedOut, active, w, base).paused?)
  ensures (!(optedOut) ==> !(active) ==> (effectiveState(optedOut, active, w, base) == base))
{
}

function isScheduled(state: WindowState, hasFrom: bool, hasUntil: bool, hasNote: bool): bool
{
  (((state.traveling? || hasFrom) || hasUntil) || hasNote)
}

lemma isScheduled_ensures(state: WindowState, hasFrom: bool, hasUntil: bool, hasNote: bool)
  ensures (state.traveling? ==> isScheduled(state, hasFrom, hasUntil, hasNote))
  ensures (!(isScheduled(state, hasFrom, hasUntil, hasNote)) ==> ((!(hasFrom) && !(hasUntil)) && !(hasNote)))
{
}

function stateUnchanged(sameBase: bool, scheduled: bool, hadWindow: bool, sameWindow: bool): bool
{
  (sameBase && (if scheduled then (hadWindow && sameWindow) else !(hadWindow)))
}

lemma stateUnchanged_ensures(sameBase: bool, scheduled: bool, hadWindow: bool, sameWindow: bool)
  ensures (stateUnchanged(sameBase, scheduled, hadWindow, sameWindow) ==> sameBase)
  ensures (stateUnchanged(sameBase, scheduled, hadWindow, sameWindow) ==> scheduled ==> (hadWindow && sameWindow))
  ensures (stateUnchanged(sameBase, scheduled, hadWindow, sameWindow) ==> !(scheduled) ==> !(hadWindow))
{
}

function cleanupAction(op: CleanupOp, status: string, retain: bool): RowAction
{
  if op.readback? then
    RowAction.keep
  else
    if op.delete? then
      RowAction.delete
    else
      if op.withdraw? then
        if (status == "proposed") then
          RowAction.withdraw
        else
          RowAction.keep
      else
        if ((status == "accepted") && retain) then
          RowAction.keep
        else
          RowAction.withdraw
}

lemma cleanupAction_ensures(op: CleanupOp, status: string, retain: bool)
  ensures (op.readback? ==> cleanupAction(op, status, retain).keep?)
  ensures (op.delete? ==> cleanupAction(op, status, retain).delete?)
  ensures (op.withdraw? ==> (status != "proposed") ==> cleanupAction(op, status, retain).keep?)
  ensures (op.disconnect? ==> (status == "accepted") ==> retain ==> cleanupAction(op, status, retain).keep?)
  ensures (op.disconnect? ==> !(retain) ==> cleanupAction(op, status, retain).withdraw?)
{
}

function reviewPath(anyEdit: bool, anyScopeChange: bool): ReviewPath
{
  if (anyEdit || anyScopeChange) then
    ReviewPath.preview
  else
    ReviewPath.saved
}

lemma reviewPath_ensures(anyEdit: bool, anyScopeChange: bool)
  ensures ((anyEdit || anyScopeChange) ==> reviewPath(anyEdit, anyScopeChange).preview?)
  ensures (!(anyEdit) ==> !(anyScopeChange) ==> reviewPath(anyEdit, anyScopeChange).saved?)
{
}

function photoIntakeStep(member: bool, refused: bool, consented: bool): PhotoStep
{
  if !(member) then
    PhotoStep.drop
  else
    if refused then
      PhotoStep.refuse
    else
      if consented then
        PhotoStep.fetch
      else
        PhotoStep.ask
}

lemma photoIntakeStep_ensures(member: bool, refused: bool, consented: bool)
  ensures (photoIntakeStep(member, refused, consented).fetch? <==> ((member && !(refused)) && consented))
  ensures (!(member) ==> photoIntakeStep(member, refused, consented).drop?)
{
}

function biasEligible(adult: bool, hasJoined: bool, joinedAt: int, now: int, windowFrom: int, day: int): bool
  requires (day > 0)
{
  if (!(adult) || !(hasJoined)) then
    false
  else
    ((now - MathMax(joinedAt, windowFrom)) >= day)
}

lemma biasEligible_ensures(adult: bool, hasJoined: bool, joinedAt: int, now: int, windowFrom: int, day: int)
  requires (day > 0)
  ensures (biasEligible(adult, hasJoined, joinedAt, now, windowFrom, day) ==> (((adult && hasJoined) && ((now - joinedAt) >= day)) && ((now - windowFrom) >= day)))
{
}

method pairReason(ps: seq<RelayParty>) returns (res: PairReason)
  ensures (res.ok? ==> forall i: nat :: ((i < |ps|) ==> ((ps[i].adult && !(ps[i].optedOut)) && !(ps[i].held))))
{
  var i := 0;
  while (i < |ps|)
    invariant (0 <= i)
    invariant (i <= |ps|)
    invariant forall j: nat :: ((j < i) ==> ((ps[j].adult && !(ps[j].optedOut)) && !(ps[j].held)))
    decreases (|ps| - i)
  {
    if !(ps[i].adult) {
      return PairReason.party_age;
    }
    if ps[i].optedOut {
      return PairReason.party_opted_out;
    }
    if ps[i].held {
      return PairReason.party_held;
    }
    i := (i + 1);
  }
  return PairReason.ok;
}
