    invariant (scanned ==> sos < |segs| && segs[sos].marker == 218 && segs[sos].whole)
    invariant (i >= 2)
    invariant forall k: nat :: ((k < |segs|) ==> ((((segs[k].at >= 2) && ((segs[k].at + 2) <= segs[k].end)) && (segs[k].end <= i)) && (segs[k].end <= |b|)))
    invariant forall k: nat :: ((k < |segs|) ==> (segs[k].whole || ((segs[k].at + 4) <= segs[k].end)))
    invariant forall k: nat :: (((k + 1) < |segs|) ==> (segs[k].end <= segs[(k + 1)].at))
    invariant forall k: nat :: ((k < |segs|) ==> !(((segs[k].marker == 217) && segs[k].whole)))
    invariant (scanned ==> exists k: nat :: (((k < |segs|) && (segs[k].marker == 218)) && segs[k].whole))
    decreases (|b| - i)
  {
    if (b[i] != 255) {
      return JpegWalk(segs, JPEG_NO_MARKER, false);
    }
    var i_t1 := byteAt(b, (i + 1));
    var m := i_t1;
    if (m == 217) {
      segs := (segs + [JpegSeg(i, (i + 2), m, true)]);
      return JpegWalk(segs, WALK_OK, true);
    }
    if ((m == 1) || ((m >= 208) && (m <= 215))) {
      segs := (segs + [JpegSeg(i, (i + 2), m, true)]);
      i := (i + 2);
    } else if (m == 255) {
      i := (i + 1);
    } else {
      if ((i + 4) > |b|) {
        return JpegWalk(segs, JPEG_TRUNCATED, false);
      }
      var i_t2 := be16(b[(i + 2)], b[(i + 3)]);
      var len := i_t2;
      if ((len < 2) || (((i + 2) + len) > |b|)) {
        return JpegWalk(segs, JPEG_BAD_SEGMENT, false);
      }
      if (m == 218) {
        var i_t3 := scanEnd(b, ((i + 2) + len));
        var j := i_t3;
        sos := |segs|;
        segs := (segs + [JpegSeg(i, j, m, true)]);
