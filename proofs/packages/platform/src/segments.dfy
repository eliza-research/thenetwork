method scanEnd(b: seq<int>, j: int) returns (res: int)
  requires (j >= 0)
  requires (j <= |b|)
  requires forall k: nat :: ((k < |b|) ==> ((b[k] >= 0) && (b[k] < 256)))
  ensures (res >= j)
  ensures (res <= |b|)
{
  var i := j;
  while (i < |b|)
    invariant (i >= j)
    invariant (i <= |b|)
    decreases (|b| - i)
  {
    if (b[i] != 255) {
      i := (i + 1);
    } else {
      var i_t0 := byteAt(b, (i + 1));
      var n := i_t0;
      if (n == -1) {
        i := (i + 1);
        break;
      }
      if ((n == 0) || ((n >= 208) && (n <= 215))) {
        i := (i + 2);
      } else if (n == 255) {
        i := (i + 1);
      } else {
        break;
      }
    }
  }
  return i;
}

method jpegSegments(b: seq<int>) returns (res: JpegWalk)
  requires forall k: nat :: ((k < |b|) ==> ((b[k] >= 0) && (b[k] < 256)))
