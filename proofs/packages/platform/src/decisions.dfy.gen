method lowestOf(stated: seq<int>) returns (res: int)
  requires (|stated| > 0)
  ensures forall k: nat :: ((k < |stated|) ==> (res <= stated[k]))
{
  var low := stated[0];
  var i := 1;
  while (i < |stated|)
    invariant (1 <= i)
    invariant (i <= |stated|)
    invariant forall k: nat :: ((k < i) ==> (low <= stated[k]))
    decreases (|stated| - i)
  {
    low := MathMin(low, stated[i]);
    i := (i + 1);
  }
  return low;
}

