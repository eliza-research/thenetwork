              case Some(i_prevAt_val) =>
                ((at - i_prevAt_val) >= i_minGapMs_val)
              case None =>
                true
            }
          case None =>
            true
        }
    case None =>
      match minGapMs {
        case Some(i_minGapMs_val) =>
          match prevAt {
            case Some(i_prevAt_val) =>
              ((at - i_prevAt_val) >= i_minGapMs_val)
            case None =>
              true
          }
        case None =>
          true
      }
  }
}

