// Generated by lsc from pairKey.ts

predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

function pairKey(a: string, b: string): string
{
  if JSStringLt(a, b) then
    ((("" + a) + "|") + b)
  else
    ((("" + b) + "|") + a)
}

lemma pairKey_ensures(a: string, b: string)
  ensures (pairKey(a, b) == pairKey(b, a))
{
  Tri(a, b); Asym(a, b);
}

lemma Tri(s: string, t: string)
  ensures s == t || JSStringLt(s, t) || JSStringLt(t, s)
  decreases |s|
{
  if |s| > 0 && |t| > 0 && s[0] == t[0] {
    Tri(s[1..], t[1..]);
    if s[1..] == t[1..] { assert s == [s[0]] + s[1..]; assert t == [t[0]] + t[1..]; }
  }
}

lemma Asym(s: string, t: string)
  ensures !(JSStringLt(s, t) && JSStringLt(t, s))
  decreases |s|
{
  if |s| > 0 && |t| > 0 && s[0] == t[0] { Asym(s[1..], t[1..]); }
}
