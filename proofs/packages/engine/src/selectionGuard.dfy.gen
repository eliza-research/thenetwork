// Generated by lsc from selectionGuard.ts

datatype Option<T> = None | Some(value: T)

datatype SelectionPick = SelectionPick(index: int, participants: seq<string>, alternates: seq<string>, via: Option<string>, city: string)

datatype GuardDrop = GuardDrop(index: int, reason: string)

datatype GuardResult = GuardResult(kept: seq<SelectionPick>, dropped: seq<GuardDrop>)

function touchesMinor(p: SelectionPick, minor: (string) -> bool): bool
{
  (((exists id :: id in p.participants && minor(id)) || (exists id :: id in p.alternates && minor(id))) || (match p.via { case Some(i_p_via_val) => minor(i_p_via_val) case None => false }))
}

lemma touchesMinor_ensures(p: SelectionPick, minor: (string) -> bool)
  ensures (!(touchesMinor(p, minor)) ==> forall i: nat :: ((i < |p.participants|) ==> !(minor(p.participants[i]))))
  ensures (!(touchesMinor(p, minor)) ==> forall i: nat :: ((i < |p.alternates|) ==> !(minor(p.alternates[i]))))
  ensures (match p.via { case Some(i_p_via_val) => (!(touchesMinor(p, minor)) ==> !(minor(i_p_via_val))) case None => true })
{
}

function countIn(out: seq<SelectionPick>, id: string, n: nat): int
  requires (n <= |out|)
  decreases n
{
  if (n == 0) then
    0
  else
    ((if (id in out[(n - 1)].participants) then 1 else 0) + countIn(out, id, (n - 1)))
}

function cityCount(out: seq<SelectionPick>, city: string, n: nat): int
  requires (n <= |out|)
  decreases n
{
  if (n == 0) then
    0
  else
    ((if (out[(n - 1)].city == city) then 1 else 0) + cityCount(out, city, (n - 1)))
}

function repeatsPair(a: SelectionPick, b: SelectionPick): bool
{
  (exists x :: x in a.participants && (exists y :: y in a.participants && (((x != y) && (x in b.participants)) && (y in b.participants))))
}

lemma repeatsPair_ensures(a: SelectionPick, b: SelectionPick)
  ensures (!(repeatsPair(a, b)) ==> forall x, y :: ((x != y) ==> (x in a.participants) ==> (y in a.participants) ==> !(((x in b.participants) && (y in b.participants)))))
{
}

function dropReason(out: seq<SelectionPick>, p: SelectionPick, allow: (string) -> int, cityCap: int, minor: (string) -> bool): Option<string>
{
  if touchesMinor(p, minor) then
    Some("underage")
  else
    if ((cityCount(out, p.city, |out|) + 1) > cityCap) then
      Some("city_cap")
    else
      if (exists id :: id in p.participants && ((countIn(out, id, |out|) + 1) > allow(id))) then
        Some("member_budget")
      else
        if (exists q :: q in out && repeatsPair(p, q)) then
          Some("repeated_pair")
        else
          None
}

lemma dropReason_ensures(out: seq<SelectionPick>, p: SelectionPick, allow: (string) -> int, cityCap: int, minor: (string) -> bool)
  ensures ((match dropReason(out, p, allow, cityCap, minor) { case Some(i_) => false case None => true }) ==> !(touchesMinor(p, minor)))
  ensures ((match dropReason(out, p, allow, cityCap, minor) { case Some(i_) => false case None => true }) ==> ((cityCount(out, p.city, |out|) + 1) <= cityCap))
  ensures ((match dropReason(out, p, allow, cityCap, minor) { case Some(i_) => false case None => true }) ==> forall id :: ((id in p.participants) ==> ((countIn(out, id, |out|) + 1) <= allow(id))))
  ensures ((match dropReason(out, p, allow, cityCap, minor) { case Some(i_) => false case None => true }) ==> forall i: nat :: ((i < |out|) ==> !(repeatsPair(p, out[i]))))
{
}

method enforceSelection(picks: seq<SelectionPick>, allow: (string) -> int, cityCap: int, minor: (string) -> bool) returns (res: GuardResult)
  ensures forall i: nat :: ((i < |res.kept|) ==> (res.kept[i] in picks))
  ensures forall i: nat :: ((i < |res.kept|) ==> !(touchesMinor(res.kept[i], minor)))
  ensures forall i: nat, id :: ((i < |res.kept|) ==> (id in res.kept[i].participants) ==> (countIn(res.kept, id, |res.kept|) <= allow(id)))
  ensures forall i: nat :: ((i < |res.kept|) ==> (cityCount(res.kept, res.kept[i].city, |res.kept|) <= cityCap))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res.kept|) ==> !(repeatsPair(res.kept[j], res.kept[i])))
{
  var kept: seq<SelectionPick> := [];
  var dropped: seq<GuardDrop> := [];
  var k := 0;
  while (k < |picks|)
    invariant (k <= |picks|)
    invariant forall i: nat :: ((i < |kept|) ==> (kept[i] in picks))
    invariant forall i: nat :: ((i < |kept|) ==> !(touchesMinor(kept[i], minor)))
    invariant forall i: nat, id :: ((i < |kept|) ==> (id in kept[i].participants) ==> (countIn(kept, id, |kept|) <= allow(id)))
    invariant forall i: nat :: ((i < |kept|) ==> (cityCount(kept, kept[i].city, |kept|) <= cityCap))
    invariant forall i: nat, j: nat :: ((i < j) ==> (j < |kept|) ==> !(repeatsPair(kept[j], kept[i])))
    decreases (|picks| - k)
  {
    var p := picks[k];
    k := (k + 1);
    var i_t0 := dropReason(kept, p, allow, cityCap, minor);
    var why := i_t0;
    match why {
      case Some(i_why_val) =>
        dropped := (dropped + [GuardDrop(p.index, i_why_val)]);
      case None =>
        kept := (kept + [p]);
    }
  }
  return GuardResult(kept, dropped);
}
