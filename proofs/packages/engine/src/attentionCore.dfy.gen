function itemHardGate(memberId: string, minor: bool, kindAllowedForMinor: bool, it: GateItem, now: int): Option<string>
{
  if (it.memberId != memberId) then
    Some("wrong_member")
  else
    if (it.expiresAt <= now) then
      Some("expired")
    else
      if it.reviewState.rejected? then
        Some("review_rejected")
      else
        if (it.involvesMember && (!it.reviewState.approved?)) then
          Some("awaiting_review")
        else
          if minor then
            if !(((kindAllowedForMinor && (|it.others| == 0)) && !(it.involvesMember))) then
              Some("minor_restricted")
            else
              None
          else
            None
}

