// Generated by lsc from intervalCore.ts

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Span = Span(s: int, e: int)

function insideOne(a: seq<Span>, x: Span): bool
{
  (exists y :: y in a && ((y.s <= x.s) && (x.e <= y.e)))
}

method subtractSpan(a: seq<Span>, s: int, e: int) returns (res: seq<Span>)
  requires (s < e)
  requires forall i: nat :: ((i < |a|) ==> (a[i].s < a[i].e))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].s < res[i].e))
  ensures forall i: nat :: ((i < |res|) ==> ((res[i].e <= s) || (res[i].s >= e)))
  ensures forall i: nat :: ((i < |res|) ==> insideOne(a, res[i]))
{
  var out: seq<Span> := [];
  var k := 0;
  while (k < |a|)
    invariant (k <= |a|)
    invariant forall i: nat :: ((i < |out|) ==> (out[i].s < out[i].e))
    invariant forall i: nat :: ((i < |out|) ==> ((out[i].e <= s) || (out[i].s >= e)))
    invariant forall i: nat :: ((i < |out|) ==> insideOne(a, out[i]))
    decreases (|a| - k)
  {
    var iv := a[k];
    k := (k + 1);
    if ((e <= iv.s) || (s >= iv.e)) {
      out := (out + [iv]);
    } else {
      if (s > iv.s) {
        out := (out + [Span(iv.s, s)]);
      }
      if (e < iv.e) {
        out := (out + [Span(e, iv.e)]);
      }
    }
  }
  return out;
}

method mergeSorted(ivs: seq<Span>) returns (res: seq<Span>)
  requires forall i: nat :: ((i < |ivs|) ==> (ivs[i].s <= ivs[i].e))
  requires forall i: nat, j: nat :: ((i < j) ==> (j < |ivs|) ==> (ivs[i].s <= ivs[j].s))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].s <= res[i].e))
  ensures forall i: nat, j: nat :: ((i < j) ==> (j < |res|) ==> (res[i].e < res[j].s))
  ensures ((forall i: nat :: ((i < |ivs|) ==> (ivs[i].s < ivs[i].e))) ==> forall i: nat :: ((i < |res|) ==> (res[i].s < res[i].e)))
{
  var out: seq<Span> := [];
  var k := 0;
  while (k < |ivs|)
    invariant (k <= |ivs|)
    invariant forall i: nat :: ((i < |out|) ==> (out[i].s <= out[i].e))
    invariant forall i: nat, j: nat :: ((i < j) ==> (j < |out|) ==> (out[i].e < out[j].s))
    invariant forall i: nat :: ((i < |out|) ==> forall j: nat :: ((k <= j) ==> (j < |ivs|) ==> (out[i].s <= ivs[j].s)))
    invariant ((forall i: nat :: ((i < |ivs|) ==> (ivs[i].s < ivs[i].e))) ==> forall i: nat :: ((i < |out|) ==> (out[i].s < out[i].e)))
    decreases (|ivs| - k)
  {
    var iv := ivs[k];
    k := (k + 1);
    var n := |out|;
    if ((n > 0) && (iv.s <= out[(n - 1)].e)) {
      var last := out[(n - 1)];
      out := (out[0..(n - 1)] + [Span(last.s, MathMax(last.e, iv.e))]);
    } else {
      out := (out + [Span(iv.s, iv.e)]);
    }
  }
  return out;
}
