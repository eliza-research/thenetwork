// Generated by lsc from planCore.ts

function CeilReal(x: real): int
{
  if x == (x.Floor as real) then x.Floor
  else x.Floor + 1
}

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype PlanPick = PlanPick(index: int, invited: seq<string>, alternates: seq<string>)

datatype PlanStage = probing | booked | closed

datatype PlanFacts = PlanFacts(stage: PlanStage, isPending: bool, yes: bool, yesAfter: int, quorum: int, partner: bool, isFirst: bool, beforeDeadline: bool, lateJoinOpen: bool)

datatype PlanStep = ignore | join | late | book | next_partner | no_change | close | next_alternate

datatype SmallerKind = smaller_group | partner_plan | other

function inPlan(p: PlanPick, id: string): bool
{
  ((id in p.invited) || (id in p.alternates))
}

function invitedIn(out: seq<PlanPick>, id: string): bool
{
  (exists p :: p in out && (id in p.invited))
}

function takenIn(out: seq<PlanPick>, id: string): bool
{
  (exists p :: p in out && inPlan(p, id))
}

function planStep(f: PlanFacts): PlanStep
{
  if (f.stage.closed? || !(f.isPending)) then
    PlanStep.ignore
  else
    if f.yes then
      if f.stage.booked? then
        if f.lateJoinOpen then
          PlanStep.join
        else
          PlanStep.late
      else
        if (f.yesAfter >= f.quorum) then
          PlanStep.book
        else
          if (f.partner && f.beforeDeadline) then
            PlanStep.next_partner
          else
            PlanStep.no_change
    else
      if f.stage.booked? then
        PlanStep.no_change
      else
        if (f.partner && f.isFirst) then
          PlanStep.close
        else
          if f.beforeDeadline then
            PlanStep.next_alternate
          else
            PlanStep.no_change
}

lemma planStep_ensures(f: PlanFacts)
  ensures (planStep(f).book? ==> (((f.stage.probing? && f.isPending) && f.yes) && (f.yesAfter >= f.quorum)))
  ensures (planStep(f).join? ==> (((f.stage.booked? && f.isPending) && f.yes) && f.lateJoinOpen))
  ensures ((f.stage.closed? || !(f.isPending)) ==> planStep(f).ignore?)
  ensures (f.stage.booked? ==> ((!planStep(f).close?) && (!planStep(f).book?)))
  ensures (planStep(f).close? ==> ((!(f.yes) && f.partner) && f.isFirst))
  ensures (planStep(f).next_partner? ==> (((f.yes && f.partner) && f.beforeDeadline) && (f.yesAfter < f.quorum)))
  ensures (planStep(f).next_alternate? ==> (!(f.yes) && f.beforeDeadline))
{
}

function planSettles(pendingCount: int, yesCount: int, quorum: int): bool
{
  ((pendingCount == 0) && (yesCount < quorum))
}

lemma planSettles_ensures(pendingCount: int, yesCount: int, quorum: int)
  ensures (planSettles(pendingCount, yesCount, quorum) ==> ((pendingCount == 0) && (yesCount < quorum)))
{
}

function smallerKind(yesCount: int, smallerOn: bool, minGroup: int, leadOk: bool): SmallerKind
{
  if (((smallerOn && (yesCount >= 2)) && (minGroup <= 2)) && leadOk) then
    if (yesCount == 2) then
      SmallerKind.partner_plan
    else
      SmallerKind.smaller_group
  else
    SmallerKind.other
}

lemma smallerKind_ensures(yesCount: int, smallerOn: bool, minGroup: int, leadOk: bool)
  ensures (smallerKind(yesCount, smallerOn, minGroup, leadOk).smaller_group? ==> (yesCount >= 3))
  ensures ((yesCount == 2) ==> (!smallerKind(yesCount, smallerOn, minGroup, leadOk).smaller_group?))
  ensures (smallerKind(yesCount, smallerOn, minGroup, leadOk).partner_plan? ==> (yesCount == 2))
{
}

function groupQuorum(n: int): int
  requires (n >= 3)
{
  MathMax(3, CeilReal(((n as real) * 0.66)))
}

lemma groupQuorum_ensures(n: int)
  requires (n >= 3)
  ensures (groupQuorum(n) >= 3)
  ensures (groupQuorum(n) <= n)
{
}

method pickPlans(cands: seq<PlanPick>, maxPlans: nat) returns (res: seq<PlanPick>)
  ensures (|res| <= maxPlans)
  ensures forall i: nat, j: nat, m :: ((i < j) ==> (j < |res|) ==> !((inPlan(res[i], m) && inPlan(res[j], m))))
{
  var chosen: seq<PlanPick> := [];
  var k := 0;
  while (k < |cands|)
    invariant (k <= |cands|)
    invariant (|chosen| <= maxPlans)
    invariant forall i: nat, j: nat, m :: ((i < j) ==> (j < |chosen|) ==> !(((m in chosen[i].invited) && (m in chosen[j].invited))))
    decreases (|cands| - k)
  {
    if (|chosen| >= maxPlans) {
      break;
    }
    var c := cands[k];
    k := (k + 1);
    if !((exists id :: id in c.invited && invitedIn(chosen, id))) {
      chosen := (chosen + [c]);
    }
  }
  var out: seq<PlanPick> := [];
  var n := 0;
  while (n < |chosen|)
    invariant (n <= |chosen|)
    invariant (|out| == n)
    invariant (|chosen| <= maxPlans)
    invariant forall i: nat, j: nat, m :: ((i < j) ==> (j < |chosen|) ==> !(((m in chosen[i].invited) && (m in chosen[j].invited))))
    invariant forall i: nat :: ((i < n) ==> (out[i].invited == chosen[i].invited))
    invariant forall i: nat, j: nat, m :: ((i < j) ==> (j < |out|) ==> !((inPlan(out[i], m) && inPlan(out[j], m))))
    invariant forall i: nat, m :: ((i < n) ==> (m in out[i].alternates) ==> !(invitedIn(chosen, m)))
    decreases (|chosen| - n)
  {
    var c := chosen[n];
    var alts: seq<string> := [];
    var a := 0;
    while (a < |c.alternates|)
      invariant (a <= |c.alternates|)
      invariant forall m :: ((m in alts) ==> (!(invitedIn(chosen, m)) && !(takenIn(out, m))))
      decreases (|c.alternates| - a)
    {
      var id := c.alternates[a];
      a := (a + 1);
      var i_t0 := invitedIn(chosen, id);
      var i_t1 := takenIn(out, id);
      if (!(i_t0) && !(i_t1)) {
        alts := (alts + [id]);
      }
    }
    out := (out + [PlanPick(c.index, c.invited, alts)]);
    n := (n + 1);
  }
  return out;
}
