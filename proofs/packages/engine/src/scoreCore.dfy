function netValueOf(pos: real, neg: real, norm: real, confidence: real): real
  requires (norm > (0 as real))
{
  (((pos - neg) / norm) * confidence)
}

lemma DivBetween(a: real, b: real)
  requires b > 0.0 && 0.0 <= a <= b
  ensures 0.0 <= a / b <= 1.0
{}

// The score does not fall when the positive sum rises, at confidence 0 or more.
lemma NetValueRisesWithPos(p1: real, p2: real, neg: real, norm: real, c: real)
  requires norm > 0.0 && c >= 0.0 && p1 <= p2
  ensures netValueOf(p1, neg, norm, c) <= netValueOf(p2, neg, norm, c)
{
  assert (p1 - neg) / norm <= (p2 - neg) / norm;
}
