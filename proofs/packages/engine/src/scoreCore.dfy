function acceptanceEstimate(yes: real, n: real, prior: real, strength: real): real
  requires ((0 as real) <= yes)
  requires (yes <= n)
  requires (strength > (0 as real))
  requires ((0 as real) <= prior)
  requires (prior <= (1 as real))
{
  ((yes + (prior * strength)) / (n + strength))
}

lemma acceptanceEstimate_ensures(yes: real, n: real, prior: real, strength: real)
  requires ((0 as real) <= yes)
  requires (yes <= n)
  requires (strength > (0 as real))
  requires ((0 as real) <= prior)
  requires (prior <= (1 as real))
  ensures ((0 as real) <= acceptanceEstimate(yes, n, prior, strength))
  ensures (acceptanceEstimate(yes, n, prior, strength) <= (1 as real))
{
  var num := yes + prior * strength;
  var den := n + strength;
  assert prior * strength <= strength;
  assert 0.0 <= num <= den && den > 0.0;
  DivBetween(num, den);
}

function debtStep(prior: real, rel: real, got: real, cap: real, floor: real): real
  requires (floor <= (cap * (2 as real)))
{
  fmin((cap * (2 as real)), fmax(floor, ((prior + rel) - got)))
