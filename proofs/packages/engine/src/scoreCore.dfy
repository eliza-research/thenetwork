method harmonic(xs: seq<real>) returns (res: real)
  ensures (res >= (0 as real))
  ensures ((|xs| > 0) ==> (forall i: nat :: ((i < |xs|) ==> (xs[i] > (0 as real)))) ==> (res > (0 as real)))
  ensures ((exists i: nat :: ((i < |xs|) && (xs[i] <= (0 as real)))) ==> (res == (0 as real)))
{
  if (|xs| == 0) {
    var i_t0 := realZero();
    return i_t0;
  }
  var i_t1 := realZero();
  var inv := i_t1;
  var i := 0;
  while (i < |xs|)
    invariant (i <= |xs|)
    invariant forall j: nat :: ((j < i) ==> (xs[j] > (0 as real)))
    invariant ((i > 0) ==> (inv > (0 as real)))
    invariant ((i == 0) ==> (inv == (0 as real)))
    decreases (|xs| - i)
  {
    var x := xs[i];
    if (x <= (0 as real)) {
      var i_t2 := realZero();
      return i_t2;
    }
    inv := (inv + ((1 as real) / x));
    i := (i + 1);
  }
  return ((|xs| as real) / inv);
}

method interpolate(knots: seq<seq<real>>, x: real) returns (res: real)
  requires forall i: nat :: ((i < |knots|) ==> (|knots[i]| == 2))
  ensures ((|knots| > 0) ==> (forall i: nat :: ((i < |knots|) ==> (((0 as real) <= knots[i][1]) && (knots[i][1] <= (1 as real))))) ==> (((0 as real) <= res) && (res <= (1 as real))))
{
  if (|knots| == 0) {
    return x;
  }
  if (x <= knots[0][0]) {
    return knots[0][1];
  }
  var i := 1;
  while (i < |knots|)
    invariant (1 <= i)
    invariant (i <= |knots|)
    invariant (x > knots[(i - 1)][0])
  {
    var i_destr0 := knots[i];
    var x1 := i_destr0[0];
    var y1 := i_destr0[1];
    var i_destr1 := knots[(i - 1)];
    var x0 := i_destr1[0];
    var y0 := i_destr1[1];
    if (x <= (x1 as real)) {
      if x1 != x0 { Seg(x0, y0, x1, y1, x); }
      return (if (x1 == x0) then y1 else ((y0 as real) + ((((y1 - y0) as real) * (x - (x0 as real))) / ((x1 - x0) as real))));
    }
    i := (i + 1);
  }
  return knots[(|knots| - 1)][1];
}

// One segment: between knots x0 < x <= x1 the value is a convex mix of y0 and y1, so it stays in [0, 1].
lemma Seg(x0: real, y0: real, x1: real, y1: real, x: real)
  requires x0 < x <= x1
  ensures (0.0 <= y0 <= 1.0 && 0.0 <= y1 <= 1.0) ==> 0.0 <= y0 + ((y1 - y0) * (x - x0)) / (x1 - x0) <= 1.0
{
  var d := x1 - x0;
  var t := (x - x0) / d;
  assert t * d == x - x0;
  assert 0.0 < t <= 1.0;
  assert ((y1 - y0) * (x - x0)) / d == (y1 - y0) * t;
  if 0.0 <= y0 <= 1.0 && 0.0 <= y1 <= 1.0 {
    var p := y0 * (1.0 - t);
    var q := y1 * t;
    MulNonneg(y0, 1.0 - t); MulNonneg(1.0 - y0, 1.0 - t);
    MulNonneg(y1, t); MulNonneg(1.0 - y1, t);
    assert p >= 0.0 && q >= 0.0;
    assert (1.0 - y0) * (1.0 - t) == (1.0 - t) - p;
    assert (1.0 - y1) * t == t - q;
    assert p <= 1.0 - t && q <= t;
    assert y0 + (y1 - y0) * t == p + q;
    assert y0 + ((y1 - y0) * (x - x0)) / (x1 - x0) == p + q;
  }
}

lemma MulNonneg(a: real, b: real)
  requires a >= 0.0 && b >= 0.0
  ensures a * b >= 0.0
{
}
