datatype Option<T> = None | Some(value: T)

function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

datatype RelayStatus = probing | mutual | closed | cancelled | expired

datatype CoreDecision = pass | hold | block

datatype RelayConsentKind = contact_share | photo

datatype PartyFacts = PartyFacts(id: string, matchable: bool, optedOut: bool, held: bool)

datatype OpportunityFacts = OpportunityFacts(participants: seq<string>, acceptedBy: seq<string>, status: RelayStatus)

datatype ItemFacts = ItemFacts(id: string, from: string, to: string, at: int)

datatype ConsentFacts = ConsentFacts(kind: RelayConsentKind, by_: string, itemId: string, at: int)

datatype HeadOutcome = hold | block | clear

function stateReason(status: RelayStatus): string
{
  if status.probing? then
    "state:probing"
  else
    if status.mutual? then
      "state:mutual"
    else
      if status.closed? then
        "state:closed"
      else
        if status.cancelled? then
          "state:cancelled"
        else
          "state:expired"
}

function consentReason(item: ItemFacts, c: Option<ConsentFacts>, kind: RelayConsentKind, ttl: int): Option<string>
{
  match c {
    case Some(i_c_val) =>
      if (((i_c_val.kind != kind) || (i_c_val.by_ != item.from)) || (i_c_val.itemId != item.id)) then
        Some("consent:mismatch")
      else
        if ((i_c_val.at > item.at) || ((item.at - i_c_val.at) > ttl)) then
          Some("consent:stale")
        else
          None
    case None =>
      Some("consent:missing")
  }
}

lemma consentReason_ensures(item: ItemFacts, c: Option<ConsentFacts>, kind: RelayConsentKind, ttl: int)
  ensures ((match c { case Some(i_) => false case None => true }) ==> (match consentReason(item, c, kind, ttl) { case Some(i_) => true case None => false }))
  ensures (match c { case Some(i_c_val) => ((match consentReason(item, c, kind, ttl) { case Some(i_) => false case None => true }) ==> (((((i_c_val.kind == kind) && (i_c_val.by_ == item.from)) && (i_c_val.itemId == item.id)) && (i_c_val.at <= item.at)) && ((item.at - i_c_val.at) <= ttl))) case None => true })
{
}

function reasonFamily(r: string): string
{
  var k := StringIndexOf(r, ":");
  if (k < 0) then
    r
  else
    r[0..k]
}

function decisionOf(reasons: seq<string>, blockFamilies: seq<string>): CoreDecision
{
  if (exists r :: r in reasons && (reasonFamily(r) in blockFamilies)) then
    CoreDecision.block
  else
    if (|reasons| > 0) then
      CoreDecision.hold
    else
      CoreDecision.pass
}

lemma decisionOf_ensures(reasons: seq<string>, blockFamilies: seq<string>)
  ensures (decisionOf(reasons, blockFamilies).pass? == (|reasons| == 0))
  ensures (decisionOf(reasons, blockFamilies).block? == exists i: nat :: ((i < |reasons|) && (reasonFamily(reasons[i]) in blockFamilies)))
{
}

function headOutcome(p: real, bar: real, severe: bool): HeadOutcome
{
  if (p < bar) then
    HeadOutcome.clear
  else
    if severe then
      HeadOutcome.block
    else
      HeadOutcome.hold
}

lemma headOutcome_ensures(p: real, bar: real, severe: bool)
  ensures (headOutcome(p, bar, severe).clear? == (p < bar))
  ensures (headOutcome(p, bar, severe).block? ==> severe)
{
}

function severity(d: CoreDecision): int
{
  if d.pass? then
    0
  else
    if d.hold? then
      1
    else
      2
}

function withHookReasons(first: seq<string>, extra: seq<string>, blockFamilies: seq<string>): seq<string>
{
  (first + Std.Collections.Seq.Filter((x: string) => !((x in first)), extra))
}

lemma withHookReasons_ensures(first: seq<string>, extra: seq<string>, blockFamilies: seq<string>)
  ensures forall i: nat :: ((i < |first|) ==> (first[i] in withHookReasons(first, extra, blockFamilies)))
  ensures (severity(decisionOf(withHookReasons(first, extra, blockFamilies), blockFamilies)) >= severity(decisionOf(first, blockFamilies)))
{
}

method partyReasons(item: ItemFacts, op: OpportunityFacts, s: PartyFacts, r: PartyFacts, blocked: bool) returns (res: seq<string>)
  ensures ((|res| == 0) ==> (((s.id == item.from) && (r.id == item.to)) && (item.from != item.to)))
  ensures ((|res| == 0) ==> ((item.from in op.participants) && (item.to in op.participants)))
  ensures ((|res| == 0) ==> ((s.matchable && r.matchable) && !(blocked)))
  ensures ((|res| == 0) ==> (((!(r.optedOut) && !(s.optedOut)) && !(s.held)) && !(r.held)))
  ensures ((|res| == 0) ==> op.status.mutual?)
  ensures ((|res| == 0) ==> forall i: nat :: ((i < |op.participants|) ==> (op.participants[i] in op.acceptedBy)))
{
  var out: seq<string> := [];
  if (((((s.id != item.from) || (r.id != item.to)) || (item.from == item.to)) || !((item.from in op.participants))) || !((item.to in op.participants))) {
    out := (out + ["party:not_participant"]);
  }
  if (!(s.matchable) || !(r.matchable)) {
    out := (out + ["minor:party"]);
  }
  if blocked {
    out := (out + ["party:blocked"]);
  }
  if r.optedOut {
    out := (out + ["optout:recipient"]);
  }
  if s.optedOut {
    out := (out + ["optout:sender"]);
  }
  if s.held {
    out := (out + ["safety:sender_held"]);
  }
  if r.held {
    out := (out + ["safety:recipient_held"]);
  }
  if (!op.status.mutual?) {
    var i_t0 := stateReason(op.status);
    out := (out + [i_t0]);
  } else if !(Std.Collections.Seq.All(op.participants, (p: string) => (p in op.acceptedBy))) {
    out := (out + ["state:not_mutual"]);
  }
  return out;
}
