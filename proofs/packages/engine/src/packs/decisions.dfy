function reviewReason(p: ReviewSubject, o: ReviewOptions): Option<string>
{
  if (match p.review { case Some(i_value) => (i_value == "confirmed") case None => false }) then
    Some("review_confirmed")
  else
    var cleared := (match p.review { case Some(i_value) => (i_value == "cleared") case None => false });
    if (!(cleared) && (exists t :: t in p.verification && (|t| >= |":fail"| && t[|t|-|":fail"|..] == ":fail"))) then
      Some("verification_failed")
    else
      if (o.verification.required && !((("verify:liveness:pass" in p.verification) && ("verify:age:pass" in p.verification)))) then
        Some("unverified")
      else
        if ((!(cleared) && o.safetyGate) && (exists t :: t in p.safety && (t in o.safetyCues))) then
          Some("safety_review")
        else
          var T := o.trust;
          if T.enabled then
            var h := p.history;
            if ((T.negativeFrom > 0) && (h.negativeFrom >= T.negativeFrom)) then
              Some("trust_review")
            else
              if ((T.blockedBy > 0) && (h.blockedBy >= T.blockedBy)) then
                Some("trust_review")
              else
                if (((T.noShows > 0) && (h.noShows >= T.noShows)) && (h.noShows > h.dates)) then
                  Some("trust_review")
                else
                  if ((((T.eagerYes > 0) && (h.yes >= T.eagerYes)) && (h.no == 0)) && (h.silent == 0)) then
                    Some("trust_review")
                  else
                    None
          else
            None
}

