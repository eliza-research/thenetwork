const PROBE_PHOTO_MAX: int := 1

const SLOP_PROBE_PHOTO_LINE: string := "I've attached a photo they chose to share; their name and number stay private until you both say yes."

method firstQuestion(blocked: bool, needed: seq<bool>, asked: seq<int>, maxAsks: int) returns (res: int)
  requires (|needed| == |asked|)
  ensures (blocked ==> (res == -1))
  ensures (-1 <= res)
  ensures (res < |needed|)
  ensures ((res >= 0) ==> (needed[res] && (asked[res] < maxAsks)))
  ensures forall i: int :: ((0 <= i) ==> (i < |needed|) ==> (if (res == -1) then !(blocked) else (i < res)) ==> (!(needed[i]) || (asked[i] >= maxAsks)))
{
  if blocked {
    return -1;
  }
  var i := 0;
  while (i < |needed|)
    invariant (0 <= i)
    invariant (i <= |needed|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (!(needed[k]) || (asked[k] >= maxAsks)))
    decreases (|needed| - i)
  {
    if (needed[i] && (asked[i] < maxAsks)) {
      return i;
    }
    i := (i + 1);
  }
  return -1;
}

method greedyPick(edges: seq<PairEdge>) returns (res: seq<int>)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> ((0 <= res[i]) && (res[i] < |edges|)))
  ensures forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res|) ==> ((((edges[res[i]].a != edges[res[j]].a) && (edges[res[i]].a != edges[res[j]].b)) && (edges[res[i]].b != edges[res[j]].a)) && (edges[res[i]].b != edges[res[j]].b)))
{
  var taken: set<string> := {};
  var out: seq<int> := [];
  var k := 0;
  while (k < |edges|)
    invariant (0 <= k)
    invariant (k <= |edges|)
    invariant forall i: int :: ((0 <= i) ==> (i < |out|) ==> ((0 <= out[i]) && (out[i] < k)))
    invariant forall i: int :: ((0 <= i) ==> (i < |out|) ==> ((edges[out[i]].a in taken) && (edges[out[i]].b in taken)))
    invariant forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |out|) ==> ((((edges[out[i]].a != edges[out[j]].a) && (edges[out[i]].a != edges[out[j]].b)) && (edges[out[i]].b != edges[out[j]].a)) && (edges[out[i]].b != edges[out[j]].b)))
    decreases (|edges| - k)
  {
    var e := edges[k];
    if ((e.a in taken) || (e.b in taken)) {
      k := (k + 1);
    } else {
      taken := (taken + {e.a});
      taken := (taken + {e.b});
      out := (out + [k]);
      k := (k + 1);
    }
  }
  return out;
}

method reprobeReason(records: seq<PairRecord>, now: int, cooldown: int, met: bool) returns (res: Option<string>)
  ensures (met ==> (match res { case Some(i_) => true case None => false }))
  ensures ((cooldown <= 0) ==> (|records| > 0) ==> (match res { case Some(i_) => true case None => false }))
  ensures forall i: int :: ((0 <= i) ==> (i < |records|) ==> (records[i].outcome != "declined") ==> (records[i].outcome != "expired") ==> (match res { case Some(i_) => true case None => false }))
{
  if met {
    return Some("already_introduced");
  }
  var i := 0;
  while (i < |records|)
    invariant (0 <= i)
    invariant (i <= |records|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((records[k].outcome == "declined") || (records[k].outcome == "expired")))
    invariant ((cooldown <= 0) ==> (i == 0))
    decreases (|records| - i)
  {
    var r := records[i];
    var preReveal := ((r.outcome == "declined") || (r.outcome == "expired"));
    if (!(preReveal) || (cooldown <= 0)) {
      return Some("already_introduced");
    }
    if ((now - r.at) < cooldown) {
      return Some("reprobe_cooldown");
    }
    i := (i + 1);
  }
  return None;
}

method dealbreakerHit(d: string, v: DealbreakerValues) returns (res: Option<bool>)
  ensures ((d == "smoker") ==> (match v.smoking { case Some(i_) => false case None => true }) ==> (match res { case Some(i_) => false case None => true }))
  ensures ((d == "heavy_drinker") ==> (match v.drinking { case Some(i_) => false case None => true }) ==> (match res { case Some(i_) => false case None => true }))
  ensures ((d == "has_kids") ==> (match v.hasKids { case Some(i_) => false case None => true }) ==> (match res { case Some(i_) => false case None => true }))
  ensures (((d == "wants_kids") || (d == "no_kids_ever")) ==> (match v.wantsKids { case Some(i_) => false case None => true }) ==> (match res { case Some(i_) => false case None => true }))
