// Generated by lsc from predicates.ts

datatype Streak = Streak(streak: int, reengageUsed: bool)

datatype StreakStep = StreakStep(ok: bool, next: Streak)

function inWindow(ts: seq<int>, now: int, span: int): seq<int>
{
  Std.Collections.Seq.Filter((t: int) => ((now - t) < span), ts)
}

lemma inWindow_ensures(ts: seq<int>, now: int, span: int)
  ensures forall k: int :: ((0 <= k) ==> (k < |inWindow(ts, now, span)|) ==> ((now - inWindow(ts, now, span)[k]) < span))
  ensures (|inWindow(ts, now, span)| <= |ts|)
{
}

function underBudget(ts: seq<int>, now: int, span: int, n: int): bool
{
  (|inWindow(ts, now, span)| <= n)
}

lemma underBudget_ensures(ts: seq<int>, now: int, span: int, n: int)
  ensures (underBudget(ts, now, span, n) == (|inWindow(ts, now, span)| <= n))
{
}

function stepStreak(s: Streak, reengagement: bool): StreakStep
  requires (s.streak >= 0)
{
  if (s.streak >= 2) then
    if (((s.streak == 2) && reengagement) && !(s.reengageUsed)) then
      StreakStep(true, Streak((s.streak + 1), true))
    else
      StreakStep(false, Streak((s.streak + 1), s.reengageUsed))
  else
    StreakStep(true, Streak((s.streak + 1), s.reengageUsed))
}

lemma stepStreak_ensures(s: Streak, reengagement: bool)
  requires (s.streak >= 0)
  ensures (stepStreak(s, reengagement).next.streak == (s.streak + 1))
  ensures (stepStreak(s, reengagement).ok ==> ((s.streak < 2) || (((s.streak == 2) && reengagement) && !(s.reengageUsed))))
  ensures ((s.streak > 2) ==> !(stepStreak(s, reengagement).ok))
{
}
