// Generated by lsc from time.ts

function hourInWindow(h: int, s: int, e: int): bool
{
  if (s == e) then
    false
  else
    if (s < e) then
      ((h >= s) && (h < e))
    else
      ((h >= s) || (h < e))
}

lemma hourInWindow_ensures(h: int, s: int, e: int)
  ensures ((s == e) ==> !(hourInWindow(h, s, e)))
  ensures ((s < e) ==> (hourInWindow(h, s, e) == ((s <= h) && (h < e))))
  ensures ((s > e) ==> (hourInWindow(h, s, e) == ((s <= h) || (h < e))))
{
}

// For s != e a window and its reverse are exact complements, so a wrapped window has no hole.
lemma hourInWindow_complement(h: int, s: int, e: int)
  requires s != e
  ensures hourInWindow(h, s, e) != hourInWindow(h, e, s)
{
}
