// Generated by lsc from reply-decision.ts

datatype ReplyAnswer = yes | no | unsure

datatype ReplyLeaning = yes | no | neither

datatype ReplyConstraintSet = empty | time | all

datatype ReplySignalKind = yes | no | unsure | timeNeg | counter | cond | reversal | neutral

datatype ReplySignal = ReplySignal(kind: ReplySignalKind, at: int, sentence: int, bare: bool, condTime: bool, contrast: bool, asked: bool)

datatype ReplyVerdict = ReplyVerdict(answer: ReplyAnswer, reason: string, counter: bool, leaning: ReplyLeaning, constraints: ReplyConstraintSet)

function isDecisive(k: ReplySignalKind): bool
{
  (((k.yes? || k.no?) || k.unsure?) || k.timeNeg?)
}

function verdict(answer: ReplyAnswer, reason: string, counter: bool, leaning: ReplyLeaning, constraints: ReplyConstraintSet): ReplyVerdict
{
  ReplyVerdict(answer, reason, counter, leaning, constraints)
}

function lastInSentenceIsNo(sig: seq<ReplySignal>, sentence: int, i: int): bool
  requires (i < |sig|)
  decreases (i + 1)
{
  if (i < 0) then
    false
  else
    var s := sig[i];
    if ((s.sentence == sentence) && (s.kind.yes? || s.kind.no?)) then
      s.kind.no?
    else
      lastInSentenceIsNo(sig, sentence, (i - 1))
}

function decideWithoutWords(counter: bool, conditions: bool, wordy: bool, question: bool, noEmoji: bool, unsureEmoji: bool, yesEmoji: bool): ReplyVerdict
{
  if counter then
    verdict(ReplyAnswer.unsure, "counter", true, ReplyLeaning.neither, ReplyConstraintSet.empty)
  else
    if conditions then
      verdict(ReplyAnswer.unsure, "condition_only", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
    else
      if question then
        verdict(ReplyAnswer.unsure, "question", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
      else
        if wordy then
          verdict(ReplyAnswer.unsure, "no_signal", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
        else
          if noEmoji then
            verdict(ReplyAnswer.no, "emoji_no", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
          else
            if unsureEmoji then
              verdict(ReplyAnswer.unsure, "emoji_unsure", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
            else
              if yesEmoji then
                verdict(ReplyAnswer.yes, "emoji_yes", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
              else
                verdict(ReplyAnswer.unsure, "no_signal", false, ReplyLeaning.neither, ReplyConstraintSet.empty)
}

lemma decideWithoutWords_ensures(counter: bool, conditions: bool, wordy: bool, question: bool, noEmoji: bool, unsureEmoji: bool, yesEmoji: bool)
  ensures (decideWithoutWords(counter, conditions, wordy, question, noEmoji, unsureEmoji, yesEmoji).answer.yes? ==> ((((((yesEmoji && !(noEmoji)) && !(unsureEmoji)) && !(counter)) && !(conditions)) && !(wordy)) && !(question)))
{
}

method decideReply(sig: seq<ReplySignal>) returns (res: ReplyVerdict)
  requires exists d: nat :: ((d < |sig|) && isDecisive(sig[d].kind))
  ensures (res.answer.yes? ==> exists i: nat :: ((i < |sig|) && sig[i].kind.yes?))
  ensures (res.answer.yes? ==> forall i: nat :: ((i < |sig|) ==> (!sig[i].kind.no?)))
  ensures (res.answer.yes? ==> forall i: nat :: ((i < |sig|) ==> (!sig[i].kind.unsure?)))
  ensures (res.answer.yes? ==> forall i: nat :: ((i < |sig|) ==> (!sig[i].kind.counter?)))
  ensures (res.answer.yes? ==> forall i: nat :: ((i < |sig|) ==> sig[i].kind.cond? ==> sig[i].condTime))
  ensures (res.answer.yes? ==> forall i: nat :: ((i < |sig|) ==> sig[i].kind.yes? ==> !(sig[i].asked)))
{
  var f := 0;
  while !(isDecisive(sig[f].kind))
    invariant (0 <= f)
    invariant (f < |sig|)
    invariant forall k: nat :: ((k < f) ==> !(isDecisive(sig[k].kind)))
    invariant exists d: nat :: (((d >= f) && (d < |sig|)) && isDecisive(sig[d].kind))
    decreases (|sig| - f)
  {
    f := (f + 1);
  }
  var first := sig[f];
  var rest := sig[(f + 1)..];
  var counter := (exists s :: s in sig && s.kind.counter?);
  if first.kind.no? {
    var i_t0 := verdict(ReplyAnswer.no, "refusal", counter, ReplyLeaning.neither, ReplyConstraintSet.time);
    return i_t0;
  }
  if first.kind.timeNeg? {
    if (exists s :: s in rest && s.kind.yes?) {
      var i_t1 := verdict(ReplyAnswer.unsure, "time_refused_other_offered", true, ReplyLeaning.yes, ReplyConstraintSet.time);
      return i_t1;
    }
    var i_t2 := verdict(ReplyAnswer.no, "time_refusal", counter, ReplyLeaning.neither, ReplyConstraintSet.time);
    return i_t2;
  }
  if first.kind.unsure? {
    if counter {
      var i_t3 := verdict(ReplyAnswer.unsure, "hedge_counter", true, ReplyLeaning.neither, ReplyConstraintSet.empty);
      return i_t3;
    }
    var leanYes := (exists s :: s in sig && s.kind.yes?);
    var leanNo := (exists s :: s in sig && s.kind.no?);
    var i_t4 := verdict(ReplyAnswer.unsure, "hedge", false, (if (leanYes && !(leanNo)) then ReplyLeaning.yes else (if (leanNo && !(leanYes)) then ReplyLeaning.no else ReplyLeaning.neither)), ReplyConstraintSet.empty);
    return i_t4;
  }
  if (exists s :: s in rest && s.kind.no?) {
    var sameSentence := (exists s :: s in rest && ((s.kind.no? && (s.sentence == first.sentence)) && !(s.contrast)));
    var i_t5 := lastInSentenceIsNo(sig, first.sentence, (|sig| - 1));
    if (sameSentence && i_t5) {
      var i_t6 := verdict(ReplyAnswer.no, "yes_then_no", false, ReplyLeaning.neither, ReplyConstraintSet.empty);
      return i_t6;
    }
    var taken := (exists s :: s in rest && ((((s.kind.no? && s.bare) && (s.sentence != first.sentence)) && !((exists n :: n in rest && (n.kind.no? && (n.at > s.at))))) && !((exists y :: y in rest && (y.kind.yes? && (y.at > s.at))))));
    if taken {
      var i_t7 := verdict(ReplyAnswer.no, "yes_then_bare_no", false, ReplyLeaning.neither, ReplyConstraintSet.empty);
      return i_t7;
    }
    var i_t8 := verdict(ReplyAnswer.unsure, "yes_no_conflict", false, ReplyLeaning.neither, ReplyConstraintSet.empty);
    return i_t8;
  }
  if (exists s :: s in rest && s.kind.unsure?) {
    var i_t9 := verdict(ReplyAnswer.unsure, "yes_then_hedge", counter, ReplyLeaning.yes, ReplyConstraintSet.all);
    return i_t9;
  }
  if counter {
    var i_t10 := verdict(ReplyAnswer.unsure, "yes_other_time", true, ReplyLeaning.yes, ReplyConstraintSet.all);
    return i_t10;
  }
  if (exists c :: c in sig && (c.kind.cond? && !(c.condTime))) {
    var i_t11 := verdict(ReplyAnswer.unsure, "conditional_yes", false, ReplyLeaning.yes, ReplyConstraintSet.all);
    return i_t11;
  }
  if (exists s :: s in sig && (s.kind.yes? && s.asked)) {
    var i_t12 := verdict(ReplyAnswer.unsure, "question", false, ReplyLeaning.neither, ReplyConstraintSet.all);
    return i_t12;
  }
  var i_t13 := verdict(ReplyAnswer.yes, "yes", false, ReplyLeaning.neither, ReplyConstraintSet.all);
  return i_t13;
}
