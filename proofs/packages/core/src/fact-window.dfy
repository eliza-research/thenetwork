// Generated by lsc from fact-window.ts

// Spec: `occ` counts id v in ids[lo..hi), `distinctIn` counts the ids below k that occur there.
ghost function occ(ids: seq<int>, lo: int, hi: int, v: int): int
  requires 0 <= lo <= hi <= |ids|
  decreases hi - lo
{
  if lo == hi then 0 else (if ids[hi - 1] == v then 1 else 0) + occ(ids, lo, hi - 1, v)
}

ghost function distinctIn(ids: seq<int>, lo: int, hi: int, k: int): int
  requires 0 <= lo <= hi <= |ids|
  requires k >= 0
  decreases k
{
  if k == 0 then 0 else (if occ(ids, lo, hi, k - 1) > 0 then 1 else 0) + distinctIn(ids, lo, hi, k - 1)
}

// The window start for tokens up to index hi (exclusive), at most `w` tokens long.
ghost function wlo(hi: int, w: int): int
  requires hi >= 0 && w >= 1
  ensures 0 <= wlo(hi, w) <= hi
{
  if hi >= w then hi - w else 0
}

ghost function pos(c: seq<int>, k: int): int
  requires 0 <= k <= |c|
  decreases k
{
  if k == 0 then 0 else (if c[k - 1] > 0 then 1 else 0) + pos(c, k - 1)
}

// The window that ends at token e holds `need` or more distinct wanted ids.
ghost predicate hitAt(ids: seq<int>, k: int, need: int, window: int, e: int)
  requires 0 <= e < |ids| && k >= 0 && window >= 1
{
  distinctIn(ids, wlo(e + 1, window), e + 1, k) >= need
}

lemma occ_nonneg(ids: seq<int>, lo: int, hi: int, v: int)
  requires 0 <= lo <= hi <= |ids|
  ensures occ(ids, lo, hi, v) >= 0
  decreases hi - lo
{
  if lo < hi { occ_nonneg(ids, lo, hi - 1, v); }
}

lemma occ_drop_front(ids: seq<int>, lo: int, hi: int, v: int)
  requires 0 <= lo < hi <= |ids|
  ensures occ(ids, lo, hi, v) == (if ids[lo] == v then 1 else 0) + occ(ids, lo + 1, hi, v)
  decreases hi - lo
{
  if lo + 1 < hi { occ_drop_front(ids, lo, hi - 1, v); }
}

lemma pos_is_distinct(ids: seq<int>, lo: int, hi: int, c: seq<int>, k: int)
  requires 0 <= lo <= hi <= |ids|
  requires 0 <= k <= |c|
  requires forall v :: 0 <= v < k ==> c[v] == occ(ids, lo, hi, v)
  ensures pos(c, k) == distinctIn(ids, lo, hi, k)
  decreases k
{
  if k > 0 { pos_is_distinct(ids, lo, hi, c, k - 1); }
}

// Changing one entry changes pos only by that entry's crossing of 0.
lemma pos_update(c: seq<int>, k: int, v: int, x: int)
  requires 0 <= k <= |c|
  requires 0 <= v < |c|
  ensures pos(c[v := x], k) == pos(c, k) + (if v < k then (if x > 0 then 1 else 0) - (if c[v] > 0 then 1 else 0) else 0)
  decreases k
{
  if k > 0 { pos_update(c, k - 1, v, x); }
}

lemma pos_zero(c: seq<int>, k: int)
  requires 0 <= k <= |c|
  requires forall v :: 0 <= v < k ==> c[v] == 0
  ensures pos(c, k) == 0
  decreases k
{
  if k > 0 { pos_zero(c, k - 1); }
}

method windowHit(ids: seq<int>, zeros: seq<int>, need: int, window: int) returns (res: bool)
  requires (window >= 1)
  requires forall i: nat :: ((i < |ids|) ==> ((ids[i] >= -1) && (ids[i] < |zeros|)))
  requires forall i: nat :: ((i < |zeros|) ==> (zeros[i] == 0))
  ensures res <==> exists e :: 0 <= e < |ids| && hitAt(ids, |zeros|, need, window, e)
{
  var counts := zeros;
  var distinct := 0;
  var i := 0;
  pos_zero(counts, |zeros|);
  while (i < |ids|)
    invariant (0 <= i)
    invariant (i <= |ids|)
    invariant (|counts| == |zeros|)
    invariant forall v :: 0 <= v < |zeros| ==> counts[v] == occ(ids, wlo(i, window), i, v)
    invariant distinct == pos(counts, |zeros|)
    invariant forall e :: 0 <= e < i ==> !hitAt(ids, |zeros|, need, window, e)
    decreases (|ids| - i)
  {
    ghost var k := |zeros|;
    ghost var lo0 := wlo(i, window);
    ghost var lo1 := wlo(i + 1, window);
    forall v | 0 <= v < k ensures counts[v] >= 0 { occ_nonneg(ids, lo0, i, v); }
    var add := ids[i];
    if (add >= 0) {
      if (counts[add] == 0) {
        distinct := (distinct + 1);
      }
      pos_update(counts, k, add, counts[add] + 1);
      counts := counts[add := (counts[add] + 1)];
    }
    assert forall v :: 0 <= v < k ==> counts[v] == occ(ids, lo0, i + 1, v);
    assert distinct == pos(counts, k);
    if ((i - window) >= 0) {
      var drop := ids[(i - window)];
      if (drop >= 0) {
        occ_nonneg(ids, lo0 + 1, i + 1, drop);
        occ_drop_front(ids, lo0, i + 1, drop);
        pos_update(counts, k, drop, counts[drop] - 1);
        counts := counts[drop := (counts[drop] - 1)];
        if (counts[drop] == 0) {
          distinct := (distinct - 1);
        }
      }
    }
    forall v | 0 <= v < k ensures counts[v] == occ(ids, lo1, i + 1, v)
    {
      if i - window >= 0 { occ_drop_front(ids, lo0, i + 1, v); }
    }
    pos_is_distinct(ids, lo1, i + 1, counts, k);
    assert hitAt(ids, k, need, window, i) <==> distinct >= need;
    if (distinct >= need) {
      return true;
    }
    i := (i + 1);
  }
  return false;
}
