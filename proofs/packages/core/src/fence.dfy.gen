// Generated by lsc from fence.ts

function isMarker(c: int): bool
{
  ((c == 60) || (c == 62))
}

function tripleAt(s: string, k: int): bool
  requires (0 <= k)
  requires ((k + 2) < |s|)
{
  ((isMarker((s[k] as int)) && ((s[k] as int) == (s[(k + 1)] as int))) && ((s[(k + 1)] as int) == (s[(k + 2)] as int)))
}

function splitAfter(text: string, i: int): bool
  requires (0 <= i)
  requires (i < |text|)
{
  var c := (text[i] as int);
  if ((!(isMarker(c)) || ((i + 1) >= |text|)) || ((text[(i + 1)] as int) != c)) then
    false
  else
    ((((i + 2) < |text|) && ((text[(i + 2)] as int) == c)) || ((i >= 1) && ((text[(i - 1)] as int) == c)))
}

method defang(text: string) returns (res: string)
  ensures forall k: nat :: (((k + 2) < |res|) ==> !(tripleAt(res, k)))
{
  var out := "";
  var i := 0;
  while (i < |text|)
    invariant (0 <= i)
    invariant (i <= |text|)
    invariant forall k: nat :: (((k + 2) < |out|) ==> !(tripleAt(out, k)))
    decreases (|text| - i)
  {
    out := (out + text[i..(i + 1)]);
    var i_t0 := splitAfter(text, i);
    if i_t0 {
      out := (out + " ");
    }
    i := (i + 1);
  }
  return out;
}
