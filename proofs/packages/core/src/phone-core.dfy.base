{
  ((((((isDigit(c) || isSpace(c)) || (c == 43)) || (c == 40)) || (c == 41)) || (c == 46)) || (c == 45))
}

function allDigits(s: string): bool
  decreases |s|
{
  ((|s| == 0) || (isDigit((s[0] as int)) && allDigits(s[1..])))
}

function allPhoneChars(s: string): bool
