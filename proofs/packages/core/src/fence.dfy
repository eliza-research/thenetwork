// Generated by lsc from fence.ts

function isMarker(c: int): bool
{
  ((c == 60) || (c == 62))
}

function tripleAt(s: string, k: int): bool
  requires (0 <= k)
  requires ((k + 2) < |s|)
{
  ((isMarker((s[k] as int)) && ((s[k] as int) == (s[(k + 1)] as int))) && ((s[(k + 1)] as int) == (s[(k + 2)] as int)))
}

function splitAfter(text: string, i: int): bool
  requires (0 <= i)
  requires (i < |text|)
{
  var c := (text[i] as int);
  if ((!(isMarker(c)) || ((i + 1) >= |text|)) || ((text[(i + 1)] as int) != c)) then
    false
  else
    ((((i + 2) < |text|) && ((text[(i + 2)] as int) == c)) || ((i >= 1) && ((text[(i - 1)] as int) == c)))
}

method defang(text: string) returns (res: string)
  ensures forall k: nat :: (((k + 2) < |res|) ==> !(tripleAt(res, k)))
{
  var out := "";
  var i := 0;
  while (i < |text|)
    invariant (0 <= i)
    invariant (i <= |text|)
    invariant forall k: nat :: (((k + 2) < |out|) ==> !(tripleAt(out, k)))
    invariant i == 0 ==> |out| == 0
    invariant i == 1 && !splitAfter(text, 0) ==> |out| == 1
    invariant i >= 1 && !splitAfter(text, i - 1) ==> |out| >= 1 && out[|out| - 1] == text[i - 1]
    invariant i >= 1 && splitAfter(text, i - 1) ==> |out| >= 1 && (out[|out| - 1] as int) == 32
    invariant i >= 2 && !splitAfter(text, i - 1) && !splitAfter(text, i - 2) ==> |out| >= 2 && out[|out| - 2] == text[i - 2]
    invariant i >= 2 && !splitAfter(text, i - 1) && splitAfter(text, i - 2) ==> |out| >= 2 && (out[|out| - 2] as int) == 32
    decreases (|text| - i)
  {
    ghost var prev := out;
    out := (out + text[i..(i + 1)]);
    forall k: nat | k + 2 < |out|
      ensures !tripleAt(out, k)
    {
      if k + 2 < |prev| {
        assert out[k] == prev[k] && out[k + 1] == prev[k + 1] && out[k + 2] == prev[k + 2];
        assert !tripleAt(prev, k);
        assert tripleAt(out, k) == tripleAt(prev, k);
      } else {
        assert out[k + 2] == text[i];
        assert out[k] == prev[|prev| - 2] && out[k + 1] == prev[|prev| - 1];
        if tripleAt(out, k) {
          var c := out[k] as int;
          assert isMarker(c) && (out[k + 1] as int) == c && (text[i] as int) == c;
          assert i >= 1;
          assert !splitAfter(text, i - 1);
          assert (text[i - 1] as int) == c;
          assert i >= 2;
          assert !splitAfter(text, i - 2);
          assert (text[i - 2] as int) == c;
          assert splitAfter(text, i - 2);
          assert false;
        }
      }
    }
    var i_t0 := splitAfter(text, i);
    if i_t0 {
      ghost var mid := out;
      out := (out + " ");
      forall k: nat | k + 2 < |out|
        ensures !tripleAt(out, k)
      {
        if k + 2 < |mid| {
          assert out[k] == mid[k] && out[k + 1] == mid[k + 1] && out[k + 2] == mid[k + 2];
          assert !tripleAt(mid, k);
          assert tripleAt(out, k) == tripleAt(mid, k);
        } else {
          assert (out[k + 2] as int) == 32;
        }
      }
    }
    i := (i + 1);
  }
  return out;
}
