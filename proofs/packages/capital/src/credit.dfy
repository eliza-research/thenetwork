function tierOf(balance: real, a: real, b: real, c: real): int
  requires (a < b)
  requires (b < c)
{
  if (balance >= c) then
    3
  else
    if (balance >= b) then
      2
    else
      if (balance >= a) then
        1
      else
        0
}

