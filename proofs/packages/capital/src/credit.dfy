  assert (base * pairMult) * catMult <= (base * pairMult) * 1.0;
}

function catMultOf(nCat: int, softN: real): real
  requires (nCat >= 0)
  requires (softN > (0 as real))
{
  ((1 as real) / ((1 as real) + ((nCat as real) / softN)))
}

lemma catMultOf_ensures(nCat: int, softN: real)
