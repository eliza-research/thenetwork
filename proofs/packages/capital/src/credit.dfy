function reachOf(r: ReachCfg, sessions: int): Reach
  requires (r.perSessions > 0)
  requires (r.step >= 0)
  requires (r.base >= 0)
  requires (r.max >= r.base)
  requires (sessions >= 0)
{
  var max := MathMin(r.max, (r.base + (JSFloorDiv(sessions, r.perSessions) * r.step)));
  Reach(max, MathMax(0, (max - r.base)))
}

