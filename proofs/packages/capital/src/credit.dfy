function capacity(v: VouchCfg, good: int, lost: int): int
  requires (v.base >= 0)
  requires (v.perGood >= 0)
  requires (v.maxBonus >= 0)
  requires (v.perLost >= 0)
  requires (v.max >= 0)
  requires (good >= 0)
  requires (lost >= 0)
{
  MathMax(0, MathMin(v.max, ((v.base + MathMin(v.maxBonus, (good * v.perGood))) - (lost * v.perLost))))
}

