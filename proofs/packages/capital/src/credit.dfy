function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype VouchCfg = VouchCfg(base: int, perGood: int, maxBonus: int, perLost: int, max: int)

datatype ReachCfg = ReachCfg(base: int, perSessions: int, step: int, max: int)

datatype Reach = Reach(max: int, reservedForLowExposure: int)

function creditAmount(base: real, pairMult: real, catMult: real, periodCap: real, inPeriod: real): real
  requires (base > (0 as real))
  requires ((0 as real) < pairMult)
  requires (pairMult <= (1 as real))
  requires ((0 as real) < catMult)
  requires (catMult <= (1 as real))
{
  var want := ((base * pairMult) * catMult);
  var left := (periodCap - inPeriod);
  if (left <= (0 as real)) then
    ((0 as real) * base)
  else
    if (want < left) then
      want
    else
      left
}

