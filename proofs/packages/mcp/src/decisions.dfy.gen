function codeVerdict(f: CodeFacts): CodeVerdict
{
  if !(f.sameClient) then
    CodeVerdict.invalid
  else
    if f.used then
      CodeVerdict.replay
    else
      if f.expired then
        CodeVerdict.expired
      else
        if !(f.redirectOk) then
          CodeVerdict.bad_redirect
        else
          if !(f.verifierOk) then
            CodeVerdict.bad_verifier
          else
            if !(f.resourceOk) then
              CodeVerdict.bad_target
            else
              CodeVerdict.go
}

lemma codeVerdict_ensures(f: CodeFacts)
  ensures (codeVerdict(f).go? <==> (((((f.sameClient && !(f.used)) && !(f.expired)) && f.redirectOk) && f.verifierOk) && f.resourceOk))
  ensures (codeVerdict(f).replay? <==> (f.sameClient && f.used))
{
}

function grantVerdict(f: GrantFacts): GrantVerdict
{
  if (((!(f.live) || f.banned) || !(f.eligible)) || !(f.tokenLive)) then
    GrantVerdict.invalid
  else
    if f.cloud.unavailable? then
      GrantVerdict.unavailable
    else
      if ((!f.cloud.valid?) || !(f.grantUnexpired)) then
        GrantVerdict.invalid
      else
        GrantVerdict.go
}

lemma grantVerdict_ensures(f: GrantFacts)
