datatype Option<T> = None | Some(value: T)

datatype MembershipState = invited | onboarding | active | paused | restricted | removed

datatype PublicStatus = invited | onboarding | active | not_joined | stopped | on_hold

datatype CloudStatus = valid | invalid | unavailable

datatype CodeFacts = CodeFacts(sameClient: bool, used: bool, expired: bool, redirectOk: bool, verifierOk: bool, resourceOk: bool)

datatype CodeVerdict = invalid | replay | expired | bad_redirect | bad_verifier | bad_target | go

datatype GrantFacts = GrantFacts(live: bool, banned: bool, eligible: bool, cloud: CloudStatus, tokenLive: bool, grantUnexpired: bool)

datatype GrantVerdict = invalid | unavailable | go

datatype TakenVerdict = invalid | replay | issue

function grantStillTheirs(atConsent: Option<string>, now: Option<string>): bool
{
  match atConsent {
    case Some(i_atConsent_val) =>
      match now {
        case Some(i_value) =>
          (i_value == i_atConsent_val)
        case None =>
          false
      }
    case None =>
      match now {
        case Some(i_) =>
          false
        case None =>
          true
      }
  }
}

lemma grantStillTheirs_ensures(atConsent: Option<string>, now: Option<string>)
  ensures (grantStillTheirs(atConsent, now) <==> (atConsent == now))
{
}

function publicStatus(state: Option<MembershipState>, review: Option<string>): PublicStatus
{
  match review {
    case Some(i_review_val) =>
      if (|i_review_val| > 0) then
        PublicStatus.on_hold
      else
        match state {
          case Some(i_state_val) =>
            match i_state_val {
              case removed =>
                PublicStatus.not_joined
              case invited =>
                PublicStatus.invited
              case onboarding =>
                PublicStatus.onboarding
              case active =>
                PublicStatus.active
              case paused =>
                PublicStatus.stopped
              case restricted =>
                PublicStatus.on_hold
            }
          case None =>
            PublicStatus.not_joined
        }
    case None =>
      match state {
        case Some(i_state_val) =>
          match i_state_val {
            case removed =>
              PublicStatus.not_joined
            case invited =>
              PublicStatus.invited
            case onboarding =>
              PublicStatus.onboarding
            case active =>
              PublicStatus.active
            case paused =>
              PublicStatus.stopped
            case restricted =>
              PublicStatus.on_hold
          }
        case None =>
          PublicStatus.not_joined
      }
  }
}

lemma publicStatus_ensures(state: Option<MembershipState>, review: Option<string>)
  ensures (publicStatus(state, review).active? ==> ((match state { case Some(i_value) => i_value.active? case None => false }) && (match review { case Some(i_value) => !((|i_value| > 0)) case None => true })))
  ensures ((match state { case Some(i_value) => i_value.restricted? case None => false }) ==> publicStatus(state, review).on_hold?)
  ensures (!((match review { case Some(i_value) => !((|i_value| > 0)) case None => true })) ==> publicStatus(state, review).on_hold?)
{
}

function resolveRedirect(asked: Option<string>, uris: seq<string>): Option<string>
{
  var redirectUri := (match asked { case Some(i_oc0_val) => Option.Some(i_oc0_val) case None => (if (|uris| == 1) then Option.Some(uris[0]) else Option.None) });
  match redirectUri {
    case Some(i_redirectUri_val) =>
      if (i_redirectUri_val in uris) then
        Option.Some(i_redirectUri_val)
      else
        Option.None
    case None =>
      Option.None
  }
}

lemma resolveRedirect_ensures(asked: Option<string>, uris: seq<string>)
