function takenVerdict(taken: bool, usedBefore: bool, live: bool): TakenVerdict
{
  if !(taken) then
    TakenVerdict.invalid
  else
    if usedBefore then
      TakenVerdict.replay
    else
      if live then
        TakenVerdict.issue
      else
        TakenVerdict.invalid
}

lemma takenVerdict_ensures(taken: bool, usedBefore: bool, live: bool)
  ensures (takenVerdict(taken, usedBefore, live).issue? <==> ((taken && !(usedBefore)) && live))
  ensures (takenVerdict(taken, usedBefore, live).replay? <==> (taken && usedBefore))
