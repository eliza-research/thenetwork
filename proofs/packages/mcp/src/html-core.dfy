// Generated by lsc from html-core.ts

function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

function escChar(c: string): string
{
  if (c == "&") then
    "&amp;"
  else
    if (c == "<") then
      "&lt;"
    else
      if (c == ">") then
        "&gt;"
      else
        if (c == "\"") then
          "&quot;"
        else
          if (c == "'") then
            "&#39;"
          else
            c
}

function escAll(s: string): string
  decreases |s|
{
  if (|s| == 0) then
    ""
  else
    (escChar(s[0..1]) + escAll(s[1..]))
}

function unesc(s: string): string
  decreases |s|
{
  if (|s| == 0) then
    ""
  else
    if (|s| >= |"&amp;"| && s[..|"&amp;"|] == "&amp;") then
      ("&" + unesc(s[5..]))
    else
      if (|s| >= |"&lt;"| && s[..|"&lt;"|] == "&lt;") then
        ("<" + unesc(s[4..]))
      else
        if (|s| >= |"&gt;"| && s[..|"&gt;"|] == "&gt;") then
          (">" + unesc(s[4..]))
        else
          if (|s| >= |"&quot;"| && s[..|"&quot;"|] == "&quot;") then
            ("\"" + unesc(s[6..]))
          else
            if (|s| >= |"&#39;"| && s[..|"&#39;"|] == "&#39;") then
              ("'" + unesc(s[5..]))
            else
              (s[0..1] + unesc(s[1..]))
}

function cspDelimiter(c: int): bool
{
  (((((((c == 59) || (c == 44)) || (c == 32)) || (c == 9)) || (c == 10)) || (c == 12)) || (c == 13))
}

function cleanTarget(s: string): bool
  decreases |s|
{
  ((|s| == 0) || (!(cspDelimiter((s[0] as int))) && cleanTarget(s[1..])))
}

function hostIs(host: string, name: string): bool
{
  ((host == name) || (|host| >= |(name + ":")| && host[..|(name + ":")|] == (name + ":")))
}

function loopbackAuthority(host: string): bool
{
  ((hostIs(host, "localhost") || hostIs(host, "127.0.0.1")) || hostIs(host, "[::1]"))
}

function formOrigin(host: string): string
{
  ((if loopbackAuthority(host) then "http://" else "https://") + host)
}

lemma formOrigin_ensures(host: string)
  ensures (!(loopbackAuthority(host)) ==> (formOrigin(host) == ("https://" + host)))
  ensures (loopbackAuthority(host) ==> (formOrigin(host) == ("http://" + host)))
  ensures ((|formOrigin(host)| >= |"http://"| && formOrigin(host)[..|"http://"|] == "http://") ==> ((((((host == "localhost") || (host == "127.0.0.1")) || (host == "[::1]")) || (|host| >= |"localhost:"| && host[..|"localhost:"|] == "localhost:")) || (|host| >= |"127.0.0.1:"| && host[..|"127.0.0.1:"|] == "127.0.0.1:")) || (|host| >= |"[::1]:"| && host[..|"[::1]:"|] == "[::1]:")))
{
  if !loopbackAuthority(host) {
    var r := formOrigin(host);
    assert r[..7][4] == r[4] == 's';
  }
}

function urlStripped(s: string): string
  decreases |s|
{
  if (|s| == 0) then
    ""
  else
    if ((((s[0] as int) == 9) || ((s[0] as int) == 10)) || ((s[0] as int) == 13)) then
      urlStripped(s[1..])
    else
      (s[0..1] + urlStripped(s[1..]))
}

method esc(s: string) returns (res: string)
  ensures (res == escAll(s))
  ensures (unesc(res) == s)
  ensures forall k: nat :: ((k < |res|) ==> (((((res[k] as int) != 60) && ((res[k] as int) != 62)) && ((res[k] as int) != 34)) && ((res[k] as int) != 39)))
{
  var out := "";
  var i := 0;
  while (i < |s|)
    invariant (0 <= i)
    invariant (i <= |s|)
    invariant (out == escAll(s[0..i]))
    decreases (|s| - i)
  {
    var i_t0 := escChar(s[i..(i + 1)]);
    escAllSnoc(s[0..i], s[i..(i + 1)]);
    assert s[0..i] + s[i..(i + 1)] == s[0..(i + 1)];
    out := (out + i_t0);
    i := (i + 1);
  }
  assert s[0..i] == s;
  escRoundTrip(s);
  escBars(s);
  return out;
}

method formTargets(targets: seq<string>) returns (res: seq<string>)
  ensures forall k: nat :: ((k < |res|) ==> (cleanTarget(res[k]) && (res[k] in targets)))
  ensures forall k: nat :: ((k < |targets|) ==> cleanTarget(targets[k]) ==> (targets[k] in res))
  ensures forall k: nat :: ((k < |res|) ==> forall j: nat :: ((j < |res[k]|) ==> ((((((((res[k][j] as int) != 59) && ((res[k][j] as int) != 44)) && ((res[k][j] as int) != 32)) && ((res[k][j] as int) != 9)) && ((res[k][j] as int) != 10)) && ((res[k][j] as int) != 12)) && ((res[k][j] as int) != 13))))
{
  var out: seq<string> := [];
  var i := 0;
  while (i < |targets|)
    invariant (0 <= i)
    invariant (i <= |targets|)
    invariant forall k: nat :: ((k < |out|) ==> (cleanTarget(out[k]) && (out[k] in targets)))
    invariant forall k: nat :: ((k < i) ==> cleanTarget(targets[k]) ==> (targets[k] in out))
    decreases (|targets| - i)
  {
    var i_t1 := cleanTarget(targets[i]);
    if i_t1 {
      out := (out + [targets[i]]);
    }
    i := (i + 1);
  }
  forall k: nat | k < |out| { cleanChars(out[k]); }
  return out;
}

method formAction(targets: seq<string>) returns (res: string)
  ensures (|res| >= |"form-action 'self'"| && res[..|"form-action 'self'"|] == "form-action 'self'")
  ensures forall k: nat :: ((k < |res|) ==> (((res[k] as int) != 59) && ((res[k] as int) != 44)))
{
  var i_t2 := formTargets(targets);
  var clean := i_t2;
  var out := "form-action 'self'";
  var i := 0;
  while (i < |clean|)
    invariant (0 <= i)
    invariant (i <= |clean|)
    invariant (|out| >= |"form-action 'self'"| && out[..|"form-action 'self'"|] == "form-action 'self'")
    invariant forall k: nat :: ((k < |out|) ==> (((out[k] as int) != 59) && ((out[k] as int) != 44)))
    decreases (|clean| - i)
  {
    cleanChars(clean[i]);
    ghost var old_out := out;
    assert cleanTarget(clean[i]);
    out := ((out + " ") + clean[i]);
    assert out[..|old_out|] == old_out;
    assert forall k: nat :: k < |clean[i]| ==> out[|old_out| + 1 + k] == clean[i][k];
    forall k: nat | k < |out|
      ensures (out[k] as int) != 59 && (out[k] as int) != 44
    {
      if k < |old_out| { assert out[k] == old_out[k]; }
      else if k > |old_out| { assert out[k] == clean[i][k - |old_out| - 1]; }
    }
    i := (i + 1);
  }
  return out;
}

method safeRetryPath(p: string) returns (res: bool)
  ensures (res ==> (|p| >= |"/"| && p[..|"/"|] == "/"))
  ensures (res ==> (!((|urlStripped(p)| >= |"//"| && urlStripped(p)[..|"//"|] == "//")) && !((|urlStripped(p)| >= |"/\\"| && urlStripped(p)[..|"/\\"|] == "/\\"))))
  ensures (res ==> !((StringIndexOf(p, "\\") >= 0)))
{
  if (!((|p| >= |"/"| && p[..|"/"|] == "/")) || (|p| >= |"//"| && p[..|"//"|] == "//")) {
    return false;
  }
  var i := 0;
  while (i < |p|)
    invariant (0 <= i)
    invariant (i <= |p|)
    invariant forall k: nat :: ((k < i) ==> ((((p[k] as int) >= 32) && ((p[k] as int) != 92)) && ((p[k] as int) != 127)))
    decreases (|p| - i)
  {
    var c := (p[i] as int);
    if (((c < 32) || (c == 92)) || (c == 127)) {
      return false;
    }
    i := (i + 1);
  }
  assert p[0] == '/';
  assert forall k: nat :: k < |p| ==> (p[k] as int) != 92;
  noBackslash(p);
  strippedPlain(p);
  return true;
}

lemma unescStep(c: string, rest: string)
  requires |c| == 1
  ensures unesc(escChar(c) + rest) == c + unesc(rest)
{
  var t := escChar(c) + rest;
  assert c == [c[0]];
  if c == "&" {
    assert t[..5] == "&amp;";
    assert t[5..] == rest;
  } else if c == "<" {
    assert t[..4] == "&lt;";
    assert t[1] == 'l';
    if |t| >= 5 && t[..5] == "&amp;" { assert t[..5][1] == t[1]; }
    assert t[4..] == rest;
  } else if c == ">" {
    assert t[..4] == "&gt;";
    assert t[1] == 'g';
    if |t| >= 5 && t[..5] == "&amp;" { assert t[..5][1] == t[1]; }
    if |t| >= 4 && t[..4] == "&lt;" { assert t[..4][1] == t[1]; }
    assert t[4..] == rest;
  } else if c == "\"" {
    assert t[..6] == "&quot;";
    assert t[1] == 'q';
    if |t| >= 5 && t[..5] == "&amp;" { assert t[..5][1] == t[1]; }
    if |t| >= 4 && t[..4] == "&lt;" { assert t[..4][1] == t[1]; }
    if |t| >= 4 && t[..4] == "&gt;" { assert t[..4][1] == t[1]; }
    assert t[6..] == rest;
  } else if c == "'" {
    assert t[..5] == "&#39;";
    assert t[1] == '#';
    if |t| >= 5 && t[..5] == "&amp;" { assert t[..5][1] == t[1]; }
    if |t| >= 4 && t[..4] == "&lt;" { assert t[..4][1] == t[1]; }
    if |t| >= 4 && t[..4] == "&gt;" { assert t[..4][1] == t[1]; }
    if |t| >= 6 && t[..6] == "&quot;" { assert t[..6][1] == t[1]; }
    assert t[5..] == rest;
  } else {
    assert t == c + rest;
    assert t[0] == c[0];
    assert c[0] != '&';
    if |t| >= 5 && t[..5] == "&amp;" { assert t[..5][0] == t[0]; }
    if |t| >= 4 && t[..4] == "&lt;" { assert t[..4][0] == t[0]; }
    if |t| >= 4 && t[..4] == "&gt;" { assert t[..4][0] == t[0]; }
    if |t| >= 6 && t[..6] == "&quot;" { assert t[..6][0] == t[0]; }
    if |t| >= 5 && t[..5] == "&#39;" { assert t[..5][0] == t[0]; }
    assert t[0..1] == c;
    assert t[1..] == rest;
  }
}


lemma escRoundTrip(s: string)
  ensures unesc(escAll(s)) == s
  decreases |s|
{
  if |s| > 0 {
    escRoundTrip(s[1..]);
    unescStep(s[0..1], escAll(s[1..]));
    assert s == s[0..1] + s[1..];
  }
}

lemma escAllSnoc(s: string, c: string)
  requires |c| == 1
  ensures escAll(s + c) == escAll(s) + escChar(c)
  decreases |s|
{
  if |s| == 0 {
    assert s + c == c;
    assert c[1..] == "";
    assert c[0..1] == c;
  } else {
    assert (s + c)[1..] == s[1..] + c;
    assert (s + c)[0..1] == s[0..1];
    escAllSnoc(s[1..], c);
  }
}

lemma escCharBars(c: string)
  requires |c| == 1
  ensures forall k: nat :: k < |escChar(c)| ==> (escChar(c)[k] as int) != 60 && (escChar(c)[k] as int) != 62 && (escChar(c)[k] as int) != 34 && (escChar(c)[k] as int) != 39
{
  assert c == [c[0]];
  if c != "&" && c != "<" && c != ">" && c != "\"" && c != "'" {
    assert c[0] != '<' && c[0] != '>' && c[0] != '"' && c[0] != '\'';
  }
}

lemma escBars(s: string)
  ensures forall k: nat :: k < |escAll(s)| ==> (escAll(s)[k] as int) != 60 && (escAll(s)[k] as int) != 62 && (escAll(s)[k] as int) != 34 && (escAll(s)[k] as int) != 39
  decreases |s|
{
  if |s| > 0 {
    escBars(s[1..]);
    escCharBars(s[0..1]);
    var h, t := escChar(s[0..1]), escAll(s[1..]);
    assert escAll(s) == h + t;
    forall k: nat | k < |h + t|
      ensures ((h + t)[k] as int) != 60 && ((h + t)[k] as int) != 62 && ((h + t)[k] as int) != 34 && ((h + t)[k] as int) != 39
    {
      if k < |h| { assert (h + t)[k] == h[k]; } else { assert (h + t)[k] == t[k - |h|]; }
    }
  }
}

lemma cleanChars(s: string)
  requires cleanTarget(s)
  ensures forall k: nat :: k < |s| ==> (s[k] as int) != 59 && (s[k] as int) != 44
  ensures forall k: nat :: k < |s| ==> !cspDelimiter(s[k] as int)
  decreases |s|
{
  if |s| > 0 {
    cleanChars(s[1..]);
    assert forall k: nat :: 0 < k < |s| ==> s[k] == s[1..][k - 1];
  }
}

lemma noBackslash(p: string)
  requires forall k: nat :: k < |p| ==> (p[k] as int) != 92
  ensures !(StringIndexOf(p, "\\") >= 0)
{
  var i := StringIndexOf(p, "\\");
  if i >= 0 {
    assert p[i..i + 1] == "\\";
    assert p[i] == '\\';
  }
}

lemma strippedPlain(p: string)
  requires forall k: nat :: k < |p| ==> (p[k] as int) >= 32
  ensures urlStripped(p) == p
  decreases |p|
{
  if |p| > 0 {
    assert forall k: nat :: k < |p[1..]| ==> p[1..][k] == p[k + 1];
    strippedPlain(p[1..]);
    assert p == p[0..1] + p[1..];
  }
}
