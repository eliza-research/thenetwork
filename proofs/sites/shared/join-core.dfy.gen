datatype FlowStep = loading | invite | phone | code | profile | member | blocked | done

datatype JoinFields = JoinFields(firstName: string, age: string, ticked: bool)

datatype Flow = Flow(step: FlowStep, phone: string, shown: string, account: string, fields: JoinFields, owner: string, consented: bool, notice: string)

datatype FlowEvent = loaded(signedInAs: string, canJoin: bool, member: bool, inviteOnly: bool, notice: string) | typed(fields: JoinFields) | otpStarted(number: string) | changeNumber | verified(canJoin: bool, member: bool) | rerouted(account: string, canJoin: bool, member: bool, notice: string) | sessionEnded(notice: string) | refused | joined

datatype JoinForm = JoinForm(firstName: string, age: int, wholeAge: bool, zip: string, ticked: bool)

datatype FormProblems = FormProblems(name: bool, age: bool, zip: bool, consent: bool)

function isEmpty(f: JoinFields): bool
{
  (((f.firstName == "") && (f.age == "")) && !(f.ticked))
}

function flowOk(s: Flow): bool
{
  ((((((!s.step.code?) || ((|s.phone| > 0) && (s.shown == s.phone))) && (((((!s.step.loading?) && (!s.step.invite?)) && (!s.step.phone?)) && (!s.step.code?)) || (s.account == ""))) && (((!s.step.profile?) && (!s.step.member?)) || (s.account != ""))) && ((!s.step.done?) || ((((s.account != "") && s.consented) && s.fields.ticked) && (s.notice == "")))) && (((s.account == "") || (s.owner == s.account)) || isEmpty(s.fields)))
}

function initialFlow(fields: JoinFields): Flow
{
  Flow(FlowStep.loading, "", "", "", fields, "", false, "")
}

lemma initialFlow_ensures(fields: JoinFields)
  ensures flowOk(initialFlow(fields))
{
}

function afterAuth(canJoin: bool, member: bool): FlowStep
{
  if canJoin then
    FlowStep.profile
  else
    if member then
      FlowStep.member
    else
      FlowStep.blocked
}

function fieldsFor(fields: JoinFields, owner: string, account: string): JoinFields
{
  if ((owner == "") || (owner == account)) then
    fields
  else
    NO_FIELDS
}

function signIn(s: Flow, account: string, canJoin: bool, member: bool, notice: string): Flow
{
  s.(account := account, owner := account, fields := fieldsFor(s.fields, s.owner, account), step := afterAuth(canJoin, member), consented := false, notice := notice)
}

function flowNext(s: Flow, e: FlowEvent): Flow
{
  match e {
    case loaded(i_e_signedInAs, i_e_canJoin, i_e_member, i_e_inviteOnly, i_e_notice) =>
      if (!s.step.loading?) then
        s
      else
        if (i_e_signedInAs == "") then
          s.(step := (if i_e_inviteOnly then FlowStep.invite else FlowStep.phone), notice := i_e_notice)
        else
          signIn(s, i_e_signedInAs, i_e_canJoin, i_e_member, i_e_notice)
    case typed(i_e_fields) =>
      if (!s.step.profile?) then
        s
      else
        s.(fields := i_e_fields, owner := s.account)
    case otpStarted(i_e_number) =>
      if ((!s.step.phone?) || (|i_e_number| == 0)) then
        s
      else
        s.(step := FlowStep.code, phone := i_e_number, shown := i_e_number)
    case changeNumber =>
      if (!s.step.code?) then
        s
      else
        s.(step := FlowStep.phone)
    case verified(i_e_canJoin, i_e_member) =>
      if (!s.step.code?) then
        s
      else
        signIn(s, s.phone, i_e_canJoin, i_e_member, "")
    case rerouted(i_e_account, i_e_canJoin, i_e_member, i_e_notice) =>
      if ((!s.step.profile?) || (i_e_account == "")) then
        s
      else
        signIn(s, i_e_account, i_e_canJoin, i_e_member, i_e_notice)
    case sessionEnded(i_e_notice) =>
      if s.step.done? then
        s
      else
        s.(account := "", consented := false, step := FlowStep.phone, notice := i_e_notice)
    case refused =>
      if (!s.step.profile?) then
        s
      else
        s.(step := FlowStep.blocked)
    case joined =>
      if ((!s.step.profile?) || !(s.fields.ticked)) then
        s
      else
        s.(step := FlowStep.done, consented := true, notice := "")
  }
}

lemma flowNext_ensures(s: Flow, e: FlowEvent)
  ensures (flowOk(s) ==> flowOk(flowNext(s, e)))
  ensures (s.step.done? ==> (flowNext(s, e) == s))
