{
}

function formResets(prev: Flow, next: Flow): bool
{
  ((prev.owner != next.owner) && isEmpty(next.fields))
}

function fiveDigits(z: string, i: int): bool
  requires (i >= 0)
  requires (i <= 5)
  requires (|z| == 5)
  decreases (5 - i)
{
  ((i == 5) || ((((z[i] as int) >= 48) && ((z[i] as int) <= 57)) && fiveDigits(z, (i + 1))))
}

function zipOk(zip: string): bool
{
  ((zip == "") || ((|zip| == 5) && fiveDigits(zip, 0)))
}

function parseJoinTakes(f: JoinForm): bool
{
  ((((((|f.firstName| > 0) && (|f.firstName| <= 50)) && f.wholeAge) && (f.age >= 0)) && (f.age <= 120)) && zipOk(f.zip))
}

function formProblems(f: JoinForm): FormProblems
{
  FormProblems(((|f.firstName| == 0) || (|f.firstName| > MAX_FIRST_NAME)), ((!(f.wholeAge) || (f.age < 1)) || (f.age > 120)), !(zipOk(f.zip)), !(f.ticked))
}

function formPasses(f: JoinForm): bool
{
  var p := formProblems(f);
  (((!(p.name) && !(p.age)) && !(p.zip)) && !(p.consent))
}

lemma formPasses_ensures(f: JoinForm)
  ensures (formPasses(f) ==> (parseJoinTakes(f) && f.ticked))
  ensures (parseJoinTakes(f) ==> f.ticked ==> (f.age >= 1) ==> formPasses(f))
{
}

const NO_FIELDS: JoinFields := JoinFields("", "", false)

const MAX_FIRST_NAME: int := 50
