{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../.cache/typecheck/alchemy.tsbuildinfo",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "../alchemy.run.ts",
    "alchemy-sites.ts",
    "sites.alchemy.ts",
    "worker.test.ts",
    "vitest.config.ts",
    "../tools/vibestack/vibestack/alchemy.ts"
  ]
}
