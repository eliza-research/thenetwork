function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

datatype QuietWindow = QuietWindow(startHour: int, endHour: int)

function isQuietMinute(mins: int, w: QuietWindow): bool
{
  if (w.startHour == w.endHour) then
    false
  else
    var start := (w.startHour * 60);
    var end := (w.endHour * 60);
    if (start < end) then
      ((mins >= start) && (mins < end))
    else
      ((mins >= start) || (mins < end))
}

lemma isQuietMinute_ensures(mins: int, w: QuietWindow)
