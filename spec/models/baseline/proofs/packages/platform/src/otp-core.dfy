function otpMayAttempt(c: OtpChallengeView, maxAttempts: int, at: int): bool
{
  ((!(c.consumed) && (at < c.expiresAt)) && (c.attempts < maxAttempts))
}

lemma otpMayAttempt_ensures(c: OtpChallengeView, maxAttempts: int, at: int)
