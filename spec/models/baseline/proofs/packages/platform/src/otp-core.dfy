function otpRetryAfterMs(refused: int, at: int, hasPrev: bool, prevAt: int, w: OtpWindows): int
  requires (0 <= refused)
  requires (refused <= 3)
  requires (at >= 0)
  requires (w.hourMs > 0)
  requires (w.dayMs > 0)
  requires (w.minGapMs > 0)
{
  var hourLeft := (w.hourMs - JSRem(at, w.hourMs));
  if (refused == 2) then
    (w.dayMs - JSRem(at, w.dayMs))
  else
    if (((refused == 1) && hasPrev) && ((at - prevAt) < w.minGapMs)) then
      (w.minGapMs - (at - prevAt))
    else
      hourLeft
}

