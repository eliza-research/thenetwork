function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

datatype OtpChallengeView = OtpChallengeView(attempts: int, expiresAt: int, consumed: bool)

datatype OtpWindows = OtpWindows(hourMs: int, dayMs: int, minGapMs: int)

function isDigit(c: int): bool
{
  ((c >= 48) && (c <= 57))
}

function allDigits(s: string): bool
