{
  ((|s| == 0) || (isDigit((s[0] as int)) && allDigits(s[1..])))
}

function otpCodeShape(code: string): bool
{
  (((|code| >= 4) && (|code| <= 10)) && allDigits(code))
}

lemma otpCodeShape_ensures(code: string)
  ensures (otpCodeShape(code) ==> (((|code| >= 4) && (|code| <= 10)) && allDigits(code)))
