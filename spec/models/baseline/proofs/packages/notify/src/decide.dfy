datatype Urgency = urgent | normal | requested

datatype CapItem = CapItem(urgency: Urgency)

datatype ExplicitRoute = explicit | explicit_thread | explicit_link_unused | explicit_not_connected

function countsTowardCap(items: seq<CapItem>): bool
{
  (exists i :: i in items && (!i.urgency.requested?))
}

lemma countsTowardCap_ensures(items: seq<CapItem>)
  ensures (countsTowardCap(items) == exists k: int :: (((0 <= k) && (k < |items|)) && (!items[k].urgency.requested?)))
{
}

function capFilter(items: seq<CapItem>, recent: int, cap: int): seq<CapItem>
{
  if ((recent >= cap) && (exists i :: i in items && (!i.urgency.requested?))) then
    Std.Collections.Seq.Filter((i: CapItem) => i.urgency.requested?, items)
  else
    items
}

lemma capFilter_ensures(items: seq<CapItem>, recent: int, cap: int)
  ensures forall k: int :: ((0 <= k) ==> (k < |capFilter(items, recent, cap)|) ==> (capFilter(items, recent, cap)[k].urgency.requested? || (recent < cap)))
  ensures (|capFilter(items, recent, cap)| <= |items|)
  ensures ((recent < cap) ==> (capFilter(items, recent, cap) == items))
{
}

function explicitRoute(assistant: bool, active: bool, ignoredStreak: int, maxIgnored: int): ExplicitRoute
{
  if !(assistant) then
    ExplicitRoute.explicit_thread
  else
    if !(active) then
      ExplicitRoute.explicit_not_connected
    else
      if (ignoredStreak >= maxIgnored) then
        ExplicitRoute.explicit_link_unused
      else
        ExplicitRoute.explicit
}

lemma explicitRoute_ensures(assistant: bool, active: bool, ignoredStreak: int, maxIgnored: int)
