{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"], "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "db/**/*.ts", "test/**/*.ts"]
}
