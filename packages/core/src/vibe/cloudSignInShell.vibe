import { Machine, machine } from "./generated/cloudSignIn.effect.js"
import type { HandoffFacts } from "./generated/cloudSignIn.effect.js"

interface CloudHandoff {
  verifier: string
  code: string
  returnPath: string
}

type CloudExchange = { accepted: false } | { accepted: true; claims: unknown }

interface CloudSignInEffects<Identity, Session> {
  exchange(handoff: CloudHandoff): Promise<CloudExchange>
  parseIdentity(claims: unknown): Identity | undefined
  phoneAllowed(e164: string): Promise<boolean>
  endPreviousSession(): Promise<void>
  recordPhoneSeen(e164: string): Promise<unknown>
  findPersonId(e164: string): Promise<string | null>
  createSession(identity: Identity, personId: string | null): Promise<Session>
}

type CloudSignInResult<Identity, Session> =
  | { status: 400 | 403 | 503 }
  | { status: 303; returnPath: string; identity: Identity; session: Session }

error CloudCallbackEffectFailed { cause: unknown }

function io<A>(run: () => A | Promise<A>) {
  return tryPromise({ try: async () => run(), catch: cause => new CloudCallbackEffectFailed({ cause }) })
}

/** Use one machine for each callback. The app supplies its Cloud and session operations. */
export function completeCloudSignIn<Identity extends { e164: string }, Session>(
  facts: HandoffFacts,
  handoff: CloudHandoff | undefined,
  effects: CloudSignInEffects<Identity, Session>,
): Promise<CloudSignInResult<Identity, Session>> {
  return runPromise(effect {
    provide machine() {
      const callback = try Machine
      const bound = try callback.send({ type: "checkHandoff", handoffFacts: facts })
      if (!handoff || bound.phase !== "AwaitingExchange") return { status: 400 } as const

      const exchange = try io(() => effects.exchange(handoff))
      const exchanged = try callback.send({ type: "recordExchange", exchangeAccepted: exchange.accepted })
      if (exchanged.phase !== "AwaitingIdentity" || !exchange.accepted) return { status: 403 } as const

      const identityAvailable = exchange.claims !== null && exchange.claims !== undefined
      const identity = identityAvailable ? try io(() => effects.parseIdentity(exchange.claims)) : undefined
      const checked = try callback.send({ type: "checkIdentity", identityAvailable, identityValid: identity !== undefined })
      if (checked.phase === "CloudUnavailable") return { status: 503 } as const
      if (checked.phase !== "AwaitingPhone" || !identity) return { status: 403 } as const

      const phoneAllowed = try io(() => effects.phoneAllowed(identity.e164))
      const eligible = try callback.send({ type: "checkPhone", phoneAllowed })
      if (eligible.phase !== "AwaitingSession") return { status: 403 } as const

      try io(() => effects.endPreviousSession())
      try io(() => effects.recordPhoneSeen(identity.e164))
      const personId = try io(() => effects.findPersonId(identity.e164))
      const session = try io(() => effects.createSession(identity, personId))
      const issued = try callback.send({ type: "recordSession" })
      if (issued.phase !== "SignedIn") return { status: 503 } as const
      return { status: 303, returnPath: handoff.returnPath, identity, session } as const
    }
  })
}
