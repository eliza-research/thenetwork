{
  "name": "@thenetwork/plugin-network",
  "version": "0.1.0",
  "main": "src/index.ts",
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@elizaos/core": "*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./svc-auth": {
      "eliza-source": "./src/backend/svc-auth.ts",
      "types": "./src/backend/svc-auth.ts",
      "default": "./src/backend/svc-auth.ts"
    },
    "./contract": {
      "eliza-source": "./src/backend/contract.ts",
      "types": "./src/backend/contract.ts",
      "default": "./src/backend/contract.ts"
    },
    "./client": {
      "eliza-source": "./src/backend/client.ts",
      "types": "./src/backend/client.ts",
      "default": "./src/backend/client.ts"
    }
  },
  "description": "The Network edge plugin for the Eliza shared agent: MEMBER_CONTEXT provider, SET_STATE action, NETWORK_SIGNALS evaluator, Network routing (state intent, structured action field, authz). Bound to an injected NetworkStore; Eliza Cloud supplies the Postgres store.",
  "eliza": {
    "platforms": [
      "edge"
    ],
    "platformDetails": {
      "edge": "createNetworkEdgePlugin factory with injected NetworkStore; no plugin-owned state"
    }
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "typecheck": "./node_modules/.bin/tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "src/index.ts"
}
