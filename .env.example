# Copy to .env (gitignored). Never commit real values.
#
# LLM: every use (recommender, judges, sim, evals) is Surplus Intelligence gpt-6-luna
# (founder decision 2026-10-05), with OpenAI (same model IDs) as the automatic fallback.

# Surplus Intelligence (OpenAI-compatible marketplace): the default provider
SURPLUS_API_KEY=
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
DEFAULT_LLM_PROVIDER=surplus
DEFAULT_LLM_MODEL=gpt-6-luna
RECOMMENDER_PROVIDER=surplus
RECOMMENDER_MODEL=gpt-6-luna
# Engine judge (always on in staging and production): ranks candidates; at a limit the engine uses heuristics.
# Spend per app per UTC day (cost ledger) and HTTP attempts per app per UTC day per process.
NETWORK_ENGINE_JUDGE_BUDGET_USD=2
NETWORK_ENGINE_JUDGE_MAX_REQUESTS=200
# Review judge (always on in staging and production): decides every introduction before contact; at a limit it holds items for staff.
# Spend per app per UTC day (cost ledger) and calls per app per UTC day across all replicas.
NETWORK_REVIEW_JUDGE_BUDGET_USD=5
NETWORK_REVIEW_JUDGE_MAX_REQUESTS=400
JUDGE_PROVIDER=surplus
JUDGE_MODEL=gpt-6-luna
# Provider names: surplus | openai (case-insensitive; anything else is an error).

# Request limits (optional): per-request timeout in ms (default 60000; 0 disables), max retries (default 4),
# and the limit for one call with all its retries (default 3x the timeout; 0 disables).
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=
LLM_DEADLINE_MS=

# OpenAI: used alone when SURPLUS_API_KEY is empty, and as the fallback on a Surplus 429/5xx/timeout
# (each fallback logs a warning). If neither key is set, a warning is logged at startup.
OPENAI_API_KEY=
# Optional: OpenAI base URL (default https://api.openai.com/v1).
OPENAI_BASE_URL=

# Deployed OTP defaults to the explicit Twilio Verify configuration. No automatic provider fallback.
# Cloud sign-in sites need it too: it sends the code to the new number in a phone change (spec/phoneChange.md).
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Reviewed alternative: OTP_PROVIDER=blooio, using BLOOIO_API_KEY and the exact BLOOIO_FROM below.
# Codes stay hashed in the existing OTP store. Queued is not delivered; uncertain sends do not retry.
# No managed-Verify or live delivery claim. Review COST_SMS_USD (estimated cost per accepted OTP).
# Every code start has the Turnstile check and the standard address limits (spec/otpLimits.md).

# Website session key (32+ characters, different from PLATFORM_HASH_KEY). Dev uses a built-in key. Staging and
# production refuse to start without it, with a shorter one, or with the PLATFORM_HASH_KEY value (docs/deploy.md 2.3).
# An empty value counts as unset.
# PLATFORM_SESSION_SECRET=
# Private photo storage (docs/deploy.md 2.3): staging and production refuse to start without PHOTO_STORAGE=r2 and the
# R2 values. Dev may use PHOTO_STORAGE=local or leave it unset (photos and photo relay off).
# PHOTO_STORAGE=
# Eliza Cloud sign-in in place of phone codes on the sites (docs/deploy.md 2.3). On exactly when NETWORK_CLOUD_AUTH_MODE is set.
# Modes: production-v1, own-pages-fresh-person-v1 (staging) or staging-local (dev only); each needs exact origins,
# and another NETWORK_CLOUD_AUTH_* value without a mode stops the start.
# When on, /api/auth/otp/start and /verify answer 409 cloud_auth_required. Founder decision: leave all unset.
# NETWORK_CLOUD_AUTH_MODE=
# NETWORK_CLOUD_AUTH_LOGIN_ORIGIN=
# NETWORK_CLOUD_AUTH_API_ORIGIN=
# NETWORK_CLOUD_AUTH_SITE_ORIGIN=
# NETWORK_CLOUD_AUTH_SERVER_TOKEN=

# Blooio (iMessage/SMS). The Network line is +18087881821.
# BLOOIO_FROM is the canonical name; BLOOIO_FROM_NUMBER is accepted as an alias (they must match if both are set).
BLOOIO_API_KEY=
BLOOIO_FROM=+18087881821
# Only for the legacy direct webhook. With NETWORK_CHANNEL=eliza_cloud the Eliza gateway owns the carrier
# webhook, the backend does not serve /webhooks/blooio, and this value is ignored.
BLOOIO_WEBHOOK_SECRET=
# Sends: NETWORK_CHANNEL alone decides (spec/bootPolicy.md, owner decision 2026-11-22). Unset: every send of every
# app is a dry run. blooio or eliza_cloud: real texts to real people, for every app, and the start is refused without
# that channel's credentials. Replies to signed turns are sent by the Eliza gateway. Contributors: leave it unset.
# The persisted queue's caps for the shared line (prototype P3 measures the real numbers). Defaults: 200 agent-started
# messages a day, 20 new conversations a day.
BLOOIO_LINE_DAILY_CAP=
BLOOIO_LINE_NEW_CHATS_PER_DAY=
# STOP, HELP and START are answered by the service inside the signed turn (/internal/turn). STOP_HELP_OWNER and
# STOP_HELP_GATEWAY_SECRET are retired and ignored (packages/network/service/README.md, "The Eliza seam").

# The Eliza seam and the staff API (docs/deploy.md 2.3). Staging and production refuse to start without
# SERVICE_TURN_SECRET (32+ characters, never also a staff token), NETWORK_SERVICE_TOKENS (each token 32+ characters; role@app:token),
# TURNSTILE_SITE_KEY (the MCP connector's authorize page) and NETWORK_PUBLIC_EVENTS_DATABASE_URL (the public
# event catalog's ingest login; the backend refreshes the catalog once a day as it). Dev needs none of them.
# NETWORK_CHANNEL=eliza_cloud: the gateway owns inbound (no /webhooks/blooio); NETWORK_CLOUD_DELIVERY_ORIGIN is
# the Cloud API origin for /api/internal/network/deliver, and BLOOIO_FROM is the line. Contributors: leave NETWORK_CHANNEL unset.
SERVICE_TURN_SECRET=
NETWORK_SERVICE_TOKENS=
TURNSTILE_SITE_KEY=
NETWORK_PUBLIC_EVENTS_DATABASE_URL=
NETWORK_CHANNEL=
NETWORK_CLOUD_DELIVERY_ORIGIN=

# Cloudflare: the ntwrk.party account id (required by scripts/wrangler.sh; CI reads the CLOUDFLARE_ACCOUNT_ID variable).
# Deploys are refused unless NTWRK_ALLOW_DEPLOY=1 (founder approval required first).
CLOUDFLARE_ACCOUNT_ID=

# slop.date photo ratings and the relay classifier (Clef on Workers AI; docs/deploy.md). On whenever
# CLOUDFLARE_AI_TOKEN and CLOUDFLARE_ACCOUNT_ID are set; staging and production refuse the token without the
# account, and production refuses to start without both (the relay classifier decides alone). Without CLEF_WEIGHTS_PATH the placeholder Clef weights are used; a weights file must
# carry a version and provenance or it is refused. Never set the token in pnpm run sim or CI.
CLOUDFLARE_AI_TOKEN=
CLEF_WEIGHTS_PATH=
CLEF_MODEL=
# The relay scam classifier model: clef-flash (default) or clef.
RELAY_CLEF_MODEL=
NTWRK_ALLOW_DEPLOY=

# Local tests and dev (optional). The dev Postgres port (default 54339) and data folder (default runs/pg);
# the Postgres client programs folder if they are not on PATH; REQUIRE_PG=1 fails instead of skipping
# when there is no Postgres. NETWORK_DATABASE_URL: a local database for pnpm run platform:dev and db:migrate.
OBSERVATORY_PG_PORT=
OBSERVATORY_PG_DIR=
PG_BIN_DIR=
REQUIRE_PG=
NETWORK_DATABASE_URL=

# Operations on the deployed backend (docs/deploy.md sections 7 and 8). Leave empty locally.
# Alerts: a Slack incoming webhook or any HTTPS JSON endpoint (ALERT_WEBHOOK_FORMAT=slack sends { text } only).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
# GET /ops/metrics bearer token (32+ characters); the uptime service's heartbeat URL.
OPS_METRICS_TOKEN=
OPS_HEARTBEAT_URL=
# Daily cost budgets in US dollars (all apps, and per app: _NTWRK, _SLOP, _PEON, _FRIENDS, _SHARED).
COST_BUDGET_DAILY_USD=
COST_BLOOIO_LINE_MONTHLY_USD=
# The backup job (deploy/backup): the owner login and a private R2 bucket of its own.
BACKUP_DATABASE_URL=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional: a heartbeat the job calls after each complete upload (https).
BACKUP_HEARTBEAT_URL=
# A restore (deploy/backup/restore.ts): RESTORE_DATABASE_URL, an owner login on the target server, and for a
# recovery with --replay, RESTORE_SOURCE_DATABASE_URL, a login that can read the source database, whose erasures,
# STOPs, leaves and bans after the backup are replayed (docs/runbook-privacy.md section 3).
RESTORE_DATABASE_URL=
RESTORE_SOURCE_DATABASE_URL=
