# Copy to .env (gitignored). Never commit real values.
#
# LLM: every use (recommender, judges, sim, evals) is Surplus Intelligence gpt-6-luna
# (founder decision 2026-10-05), with OpenAI (same model IDs) as the automatic fallback.

# Surplus Intelligence (OpenAI-compatible marketplace): the default provider
SURPLUS_API_KEY=
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
DEFAULT_LLM_PROVIDER=surplus
DEFAULT_LLM_MODEL=gpt-6-luna
RECOMMENDER_PROVIDER=surplus
RECOMMENDER_MODEL=gpt-6-luna
JUDGE_PROVIDER=surplus
JUDGE_MODEL=gpt-6-luna
# Provider names: surplus | openai (case-insensitive; anything else is an error).

# Request limits (optional): per-request timeout in ms (default 60000; 0 disables) and max retries (default 4).
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=

# OpenAI: used alone when SURPLUS_API_KEY is empty, and as the fallback on a Surplus 429/5xx/timeout
# (each fallback logs a warning). If neither key is set, a warning is logged at startup.
OPENAI_API_KEY=

# Blooio (iMessage/SMS). The Network line is +18087881821.
# BLOOIO_FROM is the canonical name; BLOOIO_FROM_NUMBER is accepted as an alias (they must match if both are set).
BLOOIO_API_KEY=
BLOOIO_FROM=+18087881821
BLOOIO_WEBHOOK_SECRET=
# Real sends only with BLOOIO_ALLOW_SEND=1 (otherwise dry-run). Read-only live test: BLOOIO_LIVE_TEST=1.
BLOOIO_ALLOW_SEND=
# The persisted queue's caps for the shared line (prototype P3 measures the real numbers). Defaults: 200 agent-started
# messages a day, 20 new conversations a day.
BLOOIO_LINE_DAILY_CAP=
BLOOIO_LINE_NEW_CHATS_PER_DAY=
# STOP, HELP and START are answered by the service inside the signed turn (/internal/turn). STOP_HELP_OWNER and
# STOP_HELP_GATEWAY_SECRET are retired and ignored (packages/network/service/README.md, "The Eliza seam").
NETWORK_SUPPORT_CONTACT=

# Domain
NETWORK_DOMAIN=ntwrk.party
MCP_ORIGIN=https://mcp.ntwrk.party

# Cloudflare: the ntwrk.party account id (required by scripts/wrangler.sh; CI reads the CLOUDFLARE_ACCOUNT_ID variable).
# Deploys are refused unless NTWRK_ALLOW_DEPLOY=1 (founder approval required first).
CLOUDFLARE_ACCOUNT_ID=

# slop.date photo ratings (Clef on Workers AI; docs/deploy.md). ON by default (founder, 2026-10-09);
# CLEF_RATINGS=off turns them off. They need CLOUDFLARE_AI_TOKEN and CLOUDFLARE_ACCOUNT_ID (without them
# nothing is rated). Without CLEF_WEIGHTS_PATH the placeholder Clef weights are used; a weights file must
# carry a version and provenance or it is refused. Never set the token in bun run sim or CI.
CLEF_RATINGS=
CLOUDFLARE_AI_TOKEN=
CLEF_WEIGHTS_PATH=
CLEF_MODEL=
NTWRK_ALLOW_DEPLOY=

# Operations on the deployed backend (docs/deploy.md sections 7 and 8). Leave empty locally.
# Alerts: a Slack incoming webhook or any HTTPS JSON endpoint (ALERT_WEBHOOK_FORMAT=slack sends { text } only).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=
# GET /ops/metrics bearer token (32+ characters); the uptime service's heartbeat URL.
OPS_METRICS_TOKEN=
OPS_HEARTBEAT_URL=
# Daily cost budgets in US dollars (all apps, and per app: _NTWRK, _SLOP, _PEON, _FRIENDS, _SHARED).
COST_BUDGET_DAILY_USD=
COST_BLOOIO_LINE_MONTHLY_USD=
# The backup job (deploy/backup): the owner login and a private R2 bucket of its own.
BACKUP_DATABASE_URL=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional: a heartbeat the job calls after each complete upload (https).
BACKUP_HEARTBEAT_URL=
