{
  "name": "thenetwork",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "prototypes/*"
  ],
  "scripts": {
    "test": "bun test --conditions eliza-source ./packages ./prototypes",
    "typecheck": "tsc --noEmit -p . && bun run --cwd packages/plugin-network typecheck",
    "observatory": "bun run packages/observatory/src/server.ts",
    "observatory:db": "bun run packages/observatory/db/dev-pg.ts up && bun run packages/observatory/db/seed.ts --from-sim --days 14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
