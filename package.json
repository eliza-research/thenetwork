{
  "name": "thenetwork",
  "private": true,
  "type": "module",
  "scripts": {
    "spec:setup": "cd tools/vibestack && corepack pnpm@10.24.0 install --frozen-lockfile --ignore-scripts",
    "gen": "node scripts/vibestack.ts gen",
    "check": "node scripts/vibestack.ts check",
    "accept": "node scripts/vibestack.ts accept",
    "new": "node scripts/vibestack.ts new",
    "spec:studio": "node scripts/vibestack.ts studio",
    "spec:watch": "node scripts/vibestack.ts watch",
    "spec:demo": "cd tools/vibestack && corepack pnpm@10.24.0 run demo",
    "spec:selftest": "cd tools/vibestack && corepack pnpm@10.24.0 run selftest",
    "spec:sync": "node scripts/spec-snapshots.ts",
    "spec:check-generated": "node scripts/spec-snapshots.ts --check",
    "spec:conformance": "node scripts/vibestack.ts conformance",
    "spec:explore": "node scripts/vibestack.ts explore",
    "quint:check": "node --import tsx --env-file-if-exists=.env scripts/quint-check.ts",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project e2e",
    "security": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration packages/platform/test/db.test.ts packages/platform/test/api-security.test.ts packages/platform/test/proxy.test.ts packages/platform/test/cloud-auth.pg.test.ts packages/platform/test/notify-retention.pg.test.ts packages/mcp/test/oauth.test.ts packages/mcp/test/pg.test.ts deploy/backend/backend.test.ts deploy/router.test.ts packages/network/test/shared-agent.integration.test.ts packages/observatory/test/staff.test.ts",
    "sim": "node --import tsx --env-file-if-exists=.env --conditions eliza-source scripts/sim.ts",
    "clef": "node --import tsx --env-file-if-exists=.env --conditions eliza-source scripts/clef-fit.ts",
    "relay-eval": "node --import tsx --env-file-if-exists=.env --conditions eliza-source scripts/relay-eval.ts",
    "check:mirror": "node --import tsx --env-file-if-exists=.env scripts/check-contract-mirror.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p sites/tsconfig.json && tsc --noEmit -p packages/observatory/tsconfig.json && tsc --noEmit -p deploy/cloudflare",
    "observatory": "node --import tsx --env-file-if-exists=.env packages/observatory/src/server.ts",
    "observatory:db": "node --import tsx --env-file-if-exists=.env packages/observatory/db/dev-pg.ts up && node --import tsx --env-file-if-exists=.env packages/observatory/db/seed.ts --from-sim --days 14",
    "db:migrate": "node --import tsx --env-file-if-exists=.env packages/observatory/db/migrate.ts",
    "design:members": "node --import tsx --env-file-if-exists=.env --conditions eliza-source design/member-flows/server.ts",
    "sites:dev": "node --import tsx --env-file-if-exists=.env scripts/sites-dev.ts",
    "platform:dev": "node --import tsx --env-file-if-exists=.env scripts/platform-dev.ts",
    "start:backend": "node --import tsx --env-file-if-exists=.env deploy/backend/server.ts",
    "sites:build": "node --import tsx --env-file-if-exists=.env sites/sites.ts"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "4.20260429.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.1",
    "typescript": "^5.6.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "tsx": "4.23.15"
  }
}
