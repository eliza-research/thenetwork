+    });
+    const own = await agent.message(memberId, {
+      text: "interest: PRIVATE-OUTREACH-CANARY",
+      requestId: "private",
+    });
+    const automatic = (await host.outreach.list(actor)).find(
+      (request) => request.state === "pending" && request.binding.purpose === "profiling",
+    );
+    expect(automatic).toBeDefined();
+    if (!automatic) throw new Error("Native timely profiling proposal missing");
+    expect(automatic.body).not.toContain("PRIVATE-OUTREACH-CANARY");
+    expect(await host.transport.messages()).toEqual([]);
+    await host.outreach.review(reviewer, {
+      memberId,
+      requestId: automatic.id,
+      decision: "rejected",
+      note: "Fixture now exercises a separately reviewed follow-up",
+    });
+    const foreign = await agent.message(otherId, { text: "hello", requestId: "foreign" });
+    const question = {
+      requestId: "question",
+      memberId,
+      purpose: "profiling" as const,
+      category: "music",
+      city: "SF" as const,
+      body: "Would a nearby public activity be worth a message? You can skip this.",
+      expiresAt: "2026-10-10T16:00:00.000Z",
+      timeliness: {
+        kind: "related_mention" as const,
+        sourceRef: own.messages.find((message) => message.role === "member")?.id ?? "",
+      },
+    };
+    expect(
+      await host.db.execute(
+        `SELECT agent_id,entity_id,room_id,type,created_at,content->>'source' AS source,metadata->>'networkSequence' AS sequence FROM memories WHERE id='${question.timeliness.sourceRef}'`,
+      ),
+    ).toEqual([expect.objectContaining({ source: "client_chat", sequence: expect.any(String) })]);
+    await expect(
+      host.outreach.propose(actor, {
+        ...question,
+        body: "Does PRIVATE-OUTREACH-CANARY still fit?",
+      }),
+    ).rejects.toThrow("protected");
+    await expect(
+      host.outreach.propose(actor, {
+        ...question,
+        timeliness: {
+          kind: "related_mention",
+          sourceRef: foreign.messages.find((message) => message.role === "member")?.id ?? "",
+        },
+      }),
+    ).rejects.toThrow("own related");
+    await publishLocalWorldFixture(
+      host.domain,
+      { type: "system" },
+      {
+        requestId: "fixture",
+        fixtureId: "fixture-event",
+        title: "Authored fixture public concert",
+        kind: "event",
+        city: "SF",
+        area: "Public fixture garden",
+        tags: "music",
+        category: "music",
+        startsAt: "2026-10-08T16:00:00.000Z",
+        endsAt: "2026-10-08T17:00:00.000Z",
+        freshHours: 72,
+      },
+    );
+    const recommendation = await host.outreach.propose(actor, {
+      ...question,
+      requestId: "recommendation",
+      purpose: "recommendation",
+      body: "This arbitrary draft must be replaced by retained source text.",
+      timeliness: { kind: "retained_world_source", sourceRef: "fixture-event" },
+    });
+    await host.outreach.review(reviewer, {
+      memberId,
+      requestId: recommendation.id,
+      decision: "approved",
+      note: "Reviewed retained authored source; public low-effort option",
+    });
+    await host.drainDue();
+    const tasks = await host.runner.list();
+    expect(tasks.some((task) => task.state.status === "fired")).toBe(true);
+    expect((await host.transport.messages())[0].body).toContain(
+      "Authored local fixture recommendation",
+    );
+    expect((await host.transport.messages())[0].body).toContain("network-fixtures.invalid");
+    const pending = await host.outreach.propose(actor, question);
+    await host.outreach.review(reviewer, {
+      memberId,
+      requestId: pending.id,
+      decision: "approved",
+      note: "Generic one-question profile follow-up",
+    });
+    await host.domain.command(actor, {
+      type: "channel_keyword",
+      requestId: "stop",
+      memberId,
+      channel: "sms",
+      keyword: "STOP",
+    });
+    await host.drainDue();
+    expect(await host.transport.messages()).toHaveLength(1);
+    const task = (await host.runner.list()).find(
+      (task) => (task.metadata?.network as { requestId?: string })?.requestId === pending.id,
+    );
+    expect(task?.state.status).toBe("skipped");
+    await host.domain.command(actor, {
+      type: "channel_keyword",
+      requestId: "start",
+      memberId,
+      channel: "sms",
+      keyword: "START",
+    });
+    expect(await host.outreach.resume(actor)).toBe(1);
+    await host.drainDue();
+    expect(await host.transport.messages()).toHaveLength(2);
+    expect(JSON.stringify(await host.outreach.list(reviewer))).not.toContain(
+      "PRIVATE-OUTREACH-CANARY",
+    );
+    clock.advanceTo("2026-10-09T16:00:00.000Z");
+    await host.domain.command({ type: "system" }, { type: "tick", requestId: "two-unanswered" });
+    expect((await host.domain.getMember(actor, memberId)).preferences.onlyWhenAsked).toBe(true);
+    const inbound = await agent.message(memberId, {
+      text: "hello again",
+      requestId: "after-unanswered",
+    });
+    expect(inbound.reply).toContain("only when you ask");
+    expect((await host.domain.getMember(actor, memberId)).preferences.onlyWhenAsked).toBe(true);
+    await agent.message(memberId, { text: "resume outreach", requestId: "explicit-resume" });
+    expect((await host.domain.getMember(actor, memberId)).preferences.onlyWhenAsked).toBe(false);
+  } finally {
+    await host.close();
+  }
+}, 120000);
