index 000000000000..b0f44855aea2
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/graph.ts
@@ -0,0 +1,45 @@
+import type { MatchingInput } from "./types.js";
+
+export type MatchingGraph = ReadonlyMap<string, ReadonlySet<string>>;
+
+/** Per-run read index of confirmed owner edges; never persists a second relationship state. */
+export function createMatchingGraph(input: MatchingInput): MatchingGraph {
+  const members = new Map(
+    input.members
+      .filter((member) => member.age === "adult" && member.state === "active" && !member.safetyHold)
+      .map((member) => [member.memberId, member]),
+  );
+  const graph = new Map<string, Set<string>>();
+  for (const edge of input.edges) {
+    const from = members.get(edge.from),
+      to = members.get(edge.to);
+    if (
+      !edge.confirmed ||
+      !from ||
+      !to ||
+      edge.from === edge.to ||
+      from.blockedIds.includes(edge.to) ||
+      to.blockedIds.includes(edge.from)
+    )
+      continue;
+    for (const [a, b] of [
+      [edge.from, edge.to],
+      [edge.to, edge.from],
+    ] as const) {
+      const neighbors = graph.get(a) ?? new Set<string>();
+      neighbors.add(b);
+      graph.set(a, neighbors);
+    }
+  }
+  return graph;
+}
+
+export function warmPath(graph: MatchingGraph, a: string, b: string): boolean {
+  const from = graph.get(a),
+    to = graph.get(b);
+  if (!from || !to) return false;
+  if (from.has(b)) return true;
+  const [small, large] = from.size <= to.size ? [from, to] : [to, from];
+  for (const connector of small) if (large.has(connector)) return true;
+  return false;
+}
