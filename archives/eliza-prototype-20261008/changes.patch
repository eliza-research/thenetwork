+++ b/packages/cloud/shared/src/lib/network/matching/domain-projection.ts
@@ -0,0 +1,532 @@
+import { networkDigest } from "../digest.js";
+import { networkSafetyClass } from "../domain/policy.js";
+import { activeOpportunityKey, terminalStates } from "../domain/store.js";
+import type {
+  City,
+  EngineSnapshot,
+  NetworkActor,
+  NetworkClock,
+  NetworkCommand,
+  NetworkCommandResult,
+  NetworkMatchingRun,
+  NetworkRequestProof,
+  NetworkSettings,
+  OpportunityDraft,
+} from "../domain/types.js";
+import { NetworkDomainError } from "../domain/types.js";
+import { buildMatchingRun, DEFAULT_MATCHING_CONFIG } from "./engine.js";
+import { projectSavedMatchingConstraints } from "./local-constraints.js";
+import { opportunityKind } from "./opportunity.js";
+import {
+  type CandidateRetrievalProvider,
+  readWorldAnchors,
+  retrieveCandidateIds,
+  type WorldSourceProvider,
+} from "./providers.js";
+import type {
+  JudgeCache,
+  MatchHistory,
+  MatchingConfig,
+  MatchingInput,
+  MatchingJudge,
+  MatchingRun,
+  MatchMember,
+  WorldAnchor,
+} from "./types.js";
+
+export interface MatchingDomain {
+  assertMatchingRequester?(actor: NetworkActor, requester: NetworkRequestProof): Promise<void>;
+  engineSnapshot(actor: NetworkActor, options?: { memberIds: string[] }): Promise<EngineSnapshot>;
+  command(actor: NetworkActor, command: NetworkCommand): Promise<NetworkCommandResult>;
+  getSettings(actor: NetworkActor): Promise<NetworkSettings>;
+  getMatchingRun(actor: NetworkActor, runId: string): Promise<NetworkMatchingRun | null>;
+}
+export interface NetworkMatchingRequest {
+  runId: string;
+  city: City;
+  seed: number;
+  startAt: string;
+  endAt: string;
+  requester?: NetworkRequestProof;
+  anchorId?: string;
+  eventAnchorsOnly?: boolean;
+}
+export interface NetworkMatchingPorts {
+  clock: NetworkClock;
+  events?: WorldAnchor[];
+  config?: MatchingConfig;
+  judge?: MatchingJudge;
+  cache?: JudgeCache;
+  /** Calendar free/busy and existing graph ownership project through trusted host ports. */
+  memberConstraints?: (
+    memberId: string,
+  ) => Promise<
+    Partial<
+      Pick<
+        MatchMember,
+        | "availability"
+        | "roles"
+        | "cluster"
+        | "budgets"
+        | "givingLoad"
+        | "romanceAllowedMemberIds"
+        | "explorationFraction"
+        | "travelMinutesByArea"
+      >
+    >
+  >;
+  graphEdges?: MatchingInput["edges"];
+  growthGaps?: MatchingInput["growthGaps"];
+  retrievalProvider?: CandidateRetrievalProvider;
+  eligibleMemberIds?: string[];
+  retrievalInputRevisions?: Record<string, number>;
+  expectedSettingsRevision?: number;
+  worldProvider?: WorldSourceProvider;
+}
+export function projectMatchingInput(
+  snapshot: EngineSnapshot,
+  request: NetworkMatchingRequest,
+  now: number,
+  config: MatchingConfig,
+  settings?: NetworkSettings,
+): MatchingInput {
+  const start = Date.parse(request.startAt),
+    end = Date.parse(request.endAt);
+  if (!Number.isFinite(start) || !Number.isFinite(end) || start >= end)
+    throw new Error("Invalid Network matching window");
+  const recordedAttendance = new Map<string, Set<string>>();
+  for (const evidence of snapshot.attendanceEvidence) {
+    if (evidence.observation !== "attended") continue;
+    const ids = recordedAttendance.get(evidence.opportunityId) ?? new Set<string>();
+    ids.add(evidence.memberId);
+    recordedAttendance.set(evidence.opportunityId, ids);
+  }
+  const attendedByOpportunity = new Map(
+    snapshot.opportunities.map((opportunity) => [
+      opportunity.id,
+      new Set(
+        opportunity.participants
+          .filter(
+            (participant) =>
+              participant.revision === opportunity.revision &&
+              participant.acceptedAt &&
+              ["attended", "accepted", "confirmed"].includes(participant.state) &&
+              recordedAttendance.get(opportunity.id)?.has(participant.memberId),
+          )
+          .map((participant) => participant.memberId),
+      ),
+    ]),
+  );
+  return {
+    ...(request.anchorId || request.eventAnchorsOnly || request.requester
+      ? {
+          constraints: {
+            ...(request.anchorId ? { anchorId: request.anchorId } : {}),
+            ...(request.eventAnchorsOnly ? { eventAnchorsOnly: true } : {}),
+            ...(request.requester
+              ? {
+                  requireMemberIds: [request.requester.memberId],
+                  category: snapshot.members
+                    .find((member) => member.memberId === request.requester?.memberId)
+                    ?.intents.find((intent) => intent.id === request.requester?.intentId)?.category,
+                }
+              : {}),
+          },
+        }
+      : {}),
+    ...(request.requester ? { requester: request.requester } : {}),
+    ...(settings ? { settingsRevision: settings.revision } : {}),
+    runId: request.runId,
+    city: request.city,
+    now,
+    window: { start, end },
+    seed: request.seed,
+    members: snapshot.members.map((member) => {
+      const previous = snapshot.proactiveHistory.filter(
+        (receipt) =>
+          receipt.memberId === member.memberId && Date.parse(receipt.sentAt) > now - 7 * 86_400_000,
+      );
+      return {
+        memberId: member.memberId,
+        profileRevision: member.revision,
+        age: member.age,
+        onDemand: request.requester?.memberId === member.memberId,
+        state:
+          member.accountState === "active" &&
+          (request.requester?.memberId === member.memberId ||
+            (member.outreachAvailable &&
+              member.participation !== "paused" &&
+              member.preferences.proactiveOptIn &&
+              !member.preferences.onlyWhenAsked))
+            ? "active"
+            : member.accountState === "onboarding"
+              ? "onboarding"
+              : "paused",
+        safetyHold: member.safetyHold,
+        receiving: member.participation === "receiving",
+        reliabilityHold: member.reliabilityHold
+          ? {
+              group: member.reliabilityHold.group,
+              timeSensitive: member.reliabilityHold.timeSensitive,
+            }
+          : null,
+        categoryOptOuts: member.preferences.categories.length
+          ? config.allowedCategories.filter(
+              (category) => !member.preferences.categories.includes(category),
+            )
+          : [],
+        blockedIds: member.blockedMemberIds,
+        presence: member.presence.map((presence) => ({
+          city: presence.city,
+          start: Date.parse(presence.startsAt),
+          end: presence.endsAt ? Date.parse(presence.endsAt) : Number.MAX_SAFE_INTEGER,
+        })),
+        ...projectSavedMatchingConstraints(member, { start, end }, now),
+        intents: member.intents
+          .filter(
+            (intent) =>
+              intent.status === "active" &&
+              networkSafetyClass(intent.objective, intent.category, intent.tags) !== "high",
+          )
+          .map((intent) => ({
+            id: intent.id,
+            category: intent.category,
+            tags: intent.tags,
+            needs: intent.needs,
+            offers: member.participation === "receiving" ? [] : intent.offers,
+            kind:
+              intent.category === "help"
+                ? "help"
+                : intent.category === "romance"
+                  ? "romance"
+                  : "activity",
+            safetyClass: networkSafetyClass(intent.objective, intent.category, intent.tags),
+            createdAt: Date.parse(intent.createdAt),
+            expiresAt: Date.parse(intent.expiresAt),
+          })),
+        facts: member.facts.map((fact) => ({
+          id: fact.id,
+          kind: fact.kind,
+          text: fact.value,
+          tags: fact.tags,
+          scope: fact.scope === "matching" ? "network" : fact.scope,
+          confidence: fact.confidence,
+          confirmedAt: Date.parse(fact.updatedAt),
+        })),
+        cluster: member.inviteId ?? "seed",
+        roles: member.facts
+          .filter((fact) => fact.kind === "role" && fact.confidence >= 0.7)
+          .flatMap((fact) =>
+            fact.tags.filter((tag) => ["host", "connector", "helper"].includes(tag)),
+          ),
+        joinedAt: Date.parse(member.createdAt),
+        romanceOptIn: member.preferences.romanceOptIn,
+        romanceAllowedMemberIds: [],
+        givingLoad: snapshot.opportunities.filter((opportunity) => {
+          if (
+            opportunity.kind !== "help" ||
+            (opportunity.roles?.[member.memberId] ??
+              (opportunity.participantIds[0] === member.memberId ? "requester" : "helper")) !==
+              "helper"
+          )
+            return false;
+          const participation = opportunity.participants.find(
+            (participant) =>
+              participant.memberId === member.memberId &&
+              participant.revision === opportunity.revision &&
+              participant.acceptedAt,
+          );
+          if (!participation) return false;
+          if (!terminalStates.has(opportunity.state))
+            return ["accepted", "confirmed", "attended"].includes(participation.state);
+          return (
+            ["completed", "feedback_collected"].includes(opportunity.state) &&
+            Date.parse(opportunity.updatedAt) > now - 30 * 86_400_000 &&
+            attendedByOpportunity.get(opportunity.id)?.has(member.memberId)
+          );
+        }).length,
+        recentExposure: previous.length,
+        unansweredProposals: member.consecutiveUnanswered,
+        maxTravelMinutes: member.preferences.travelMinutes,
+        explorationFraction:
+          member.preferences.explorationFraction ?? config.explorationFraction ?? 0.1,
+        budgets: [
+          {
+            windowMs: (member.participation === "quiet" ? 30 : 7) * 86_400_000,
+            max:
+              member.participation === "quiet"
+                ? (settings?.budgets.quietMonth ?? 1)
+                : member.participation === "open"
+                  ? (settings?.budgets.openWeek ?? 4)
+                  : (settings?.budgets.normalWeek ?? 2),
+          },
+        ],
+      } satisfies MatchMember;
+    }),
+    edges: [],
+    budgetHistory: snapshot.proactiveHistory.map((receipt, index) => ({
+      opportunityId: receipt.opportunityId ?? `legacy-outreach:${index}`,
+      memberIds: [receipt.memberId],
+      category: receipt.category,
+      at: Date.parse(receipt.sentAt),
+      outcome: "proposed",
+      exploration: receipt.exploration,
+    })),
+    activeOpportunityKeys: snapshot.opportunities
+      .map(activeOpportunityKey)
+      .filter((key): key is string => key !== null)
+      .sort(),
+    history: snapshot.opportunities
+      .filter((opportunity) => opportunity.kind !== "monthly_event")
+      .flatMap<MatchHistory>((opportunity) => {
+        const acceptedAt = opportunity.participants.find(
+          (participant) => participant.invitedAt,
+        )?.invitedAt;
+        if (["completed", "feedback_collected"].includes(opportunity.state)) {
+          const memberIds = [...(attendedByOpportunity.get(opportunity.id) ?? [])];
+          return memberIds.length >= 2
+            ? [
+                {
+                  opportunityId: opportunity.id,
+                  memberIds,
+                  category: opportunity.category,
+                  at: Date.parse(opportunity.updatedAt),
+                  outcome: "completed" as const,
+                },
+              ]
+            : [];
+        }
+        if (
+          [
+            "expired",
+            "cancelled",
+            "rejected_in_review",
+            "declined",
+            "quorum_failed",
+            "abandoned",
+          ].includes(opportunity.state)
+        )
+          return [];
+        return [
+          {
+            opportunityId: opportunity.id,
+            memberIds: opportunity.participantIds,
+            category: opportunity.category,
+            at: acceptedAt ? Date.parse(acceptedAt) : now,
+            outcome: "proposed" as const,
+          },
+        ];
+      })
+      .concat(
+        snapshot.feedback.flatMap<MatchHistory>((feedback) => [
+          ...feedback.wouldMeetAgainIds
+            .filter(
+              (other) =>
+                feedback.happened &&
+                attendedByOpportunity.get(feedback.opportunityId)?.has(feedback.memberId) &&
+                attendedByOpportunity.get(feedback.opportunityId)?.has(other),
+            )
+            .map((other) => ({
+              opportunityId: feedback.opportunityId,
+              memberIds: [feedback.memberId, other],
+              category: "social",
+              at: Date.parse(feedback.createdAt),
+              outcome: "positive" as const,
+            })),
+          ...feedback.negativeIds.map((other) => ({
+            opportunityId: feedback.opportunityId,
+            memberIds: [feedback.memberId, other],
+            category: "social",
+            at: Date.parse(feedback.createdAt),
+            outcome: "negative" as const,
+          })),
+        ]),
+      ),
+    events: [],
+    growthGaps: [],
+    modelVersions: { matcher: config.version, persona: "not_used", judge: "not_used" },
+  };
+}
+export function opportunityDraft(
+  proposal: MatchingRun["proposals"][number],
+  city: City,
+  members: MatchMember[],
+): OpportunityDraft {
+  const kind = opportunityKind(proposal.generator, proposal.participantIds.length);
+  return {
+    id: proposal.id,
+    kind,
+    objective: proposal.objective,
+    category: proposal.category,
+    city,
+    participantIds: proposal.participantIds,
+    roles: proposal.roles,
+    backupIds: proposal.alternates,
+    quorum: proposal.quorum,
+    expiresAt: new Date(proposal.expiresAt).toISOString(),
+    explanations: Object.fromEntries(
+      proposal.participantIds.map((id) => [
+        id,
+        {
+          text: proposal.explanation[id] ?? "An opportunity you can consider.",
+          factIds: proposal.evidenceIds.filter((factId) =>
+            members
+              .find((member) => member.memberId === id)
+              ?.facts.some((fact) => fact.id === factId && fact.scope === "shareable"),
+          ),
+        },
+      ]),
+    ),
+    safetyClass: proposal.safetyClass,
+    requiresHomeEntry: proposal.requiresHomeEntry,
+    acquaintedHelperIds: proposal.acquaintedHelperIds,
+    anchorEventId: proposal.anchorId,
+    origin: {
+      runId: proposal.runId,
+      generator: proposal.generator,
+      exploration: proposal.exploration,
+    },
+  };
+}
+
+export function matchingConfigFromSettings(settings: NetworkSettings): MatchingConfig {
+  return {
+    ...DEFAULT_MATCHING_CONFIG,
+    defaultThreshold: settings.matchingThreshold,
+    categoryThresholds: Object.fromEntries(
+      Object.entries(settings.categorySettings ?? {}).map(([category, value]) => [
+        category,
+        value.threshold,
+      ]),
+    ),
+    disabledCategories: Object.entries(settings.categorySettings ?? {})
+      .filter(([, value]) => !value.enabled)
+      .map(([category]) => category),
+    explorationFraction: settings.explorationFraction ?? 0.1,
+    weights: {
+      ...DEFAULT_MATCHING_CONFIG.weights,
+      fit: settings.weights.fit ?? DEFAULT_MATCHING_CONFIG.weights.fit,
+      timingFit: settings.weights.capacity ?? DEFAULT_MATCHING_CONFIG.weights.timingFit,
+      load: settings.weights.reliability ?? DEFAULT_MATCHING_CONFIG.weights.load,
+      novelty: settings.weights.exploration ?? DEFAULT_MATCHING_CONFIG.weights.novelty,
+    },
+  };
+}
+
+/** Executes the production matcher and atomically commits its review drafts through the domain. */
+export async function matchNetwork(
+  domain: MatchingDomain,
+  request: NetworkMatchingRequest,
+  ports: NetworkMatchingPorts,
+): Promise<MatchingRun> {
+  if (request.requester) {
+    if (!domain.assertMatchingRequester)
+      throw new Error("Owning authenticated request proof validation unavailable");
+    await domain.assertMatchingRequester({ type: "system" }, request.requester);
+  }
+  const existing = await domain.getMatchingRun({ type: "system" }, request.runId);
+  if (existing) {
+    const run = existing.log as unknown as MatchingRun;
+    if (
+      existing.fingerprintVersion !== 2 ||
+      !run.replayInput ||
+      run.replayInput.city !== request.city ||
+      run.replayInput.seed !== request.seed ||
+      run.replayInput.window.start !== Date.parse(request.startAt) ||
+      run.replayInput.window.end !== Date.parse(request.endAt) ||
+      networkDigest(run.replayInput.requester ?? null) !== networkDigest(request.requester ?? null)
+    )
+      throw new Error(
+        "Matching run identity was reused with different input or requires legacy reconciliation",
+      );
+    if (ports.config && networkDigest(run.config) !== networkDigest(ports.config))
+      throw new Error("Matching run configuration changed under a reused identity");
+    return run;
+  }
+  const settings = await domain.getSettings({ type: "system" });
+  if (
+    ports.expectedSettingsRevision !== undefined &&
+    ports.expectedSettingsRevision !== settings.revision
+  )
+    throw new NetworkDomainError("NETWORK_CONFLICT", "Prepared matching configuration changed", {
+      rule: "matching_config_changed",
+    });
+  const config = ports.config ?? matchingConfigFromSettings(settings);
+  const snapshot = await domain.engineSnapshot(
+    { type: "system" },
+    ports.eligibleMemberIds ? { memberIds: ports.eligibleMemberIds } : undefined,
+  );
+  const input = projectMatchingInput(
+    snapshot,
+    request,
+    ports.clock.now().getTime(),
+    config,
+    settings,
+  );
+  input.events = ports.events ?? [];
+  if (ports.worldProvider)
+    input.events.push(...(await readWorldAnchors(ports.worldProvider, input)));
+  input.edges = [...(ports.graphEdges ?? [])].sort(
+    (a, b) =>
+      a.from.localeCompare(b.from) ||
+      a.to.localeCompare(b.to) ||
+      Number(a.confirmed) - Number(b.confirmed),
+  );
+  input.growthGaps = ports.growthGaps ?? [];
+  input.modelVersions.judge = ports.judge?.version ?? "not_used";
+  if (ports.memberConstraints)
+    for (const member of input.members)
+      Object.assign(member, await ports.memberConstraints(member.memberId));
+  if (ports.retrievalProvider) {
+    if (ports.retrievalInputRevisions) {
+      const revisions = new Map(
+        input.members.map((member) => [member.memberId, member.profileRevision]),
+      );
+      if (
+        Object.entries(ports.retrievalInputRevisions).some(
+          ([id, revision]) => revisions.get(id) !== revision,
+        )
+      )
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Prepared native retrieval input changed",
+          { rule: "matching_retrieval_changed" },
+        );
+    }
+    input.retrievedIds = await retrieveCandidateIds(
+      ports.retrievalProvider,
+      input,
+      config.maxCandidatesPerMember,
+    );
+    input.modelVersions.retrieval = ports.retrievalProvider.version;
+  }
+  const run = await buildMatchingRun(input, { config, judge: ports.judge, cache: ports.cache });
+  await domain.command(
+    { type: "system" },
+    {
+      type: "commit_matching_run",
+      requestId: `matching:${request.runId}`,
+      runId: request.runId,
+      city: request.city,
+      inputDigest: run.inputDigest,
+      settingsRevision: settings.revision,
+      inputRevisions: Object.fromEntries(
+        snapshot.members.map((member) => [member.memberId, member.revision]),
+      ),
+      log: run as unknown as Record<string, unknown>,
+      drafts: run.proposals.map((proposal) => ({
+        ...opportunityDraft(proposal, request.city, input.members),
+        ...(request.requester
+          ? {
+              requester: request.requester,
+              participantIds: [
+                request.requester.memberId,
+                ...proposal.participantIds.filter((id) => id !== request.requester?.memberId),
+              ],
+            }
+          : {}),
+      })),
+    },
+  );
+  return run;
+}
diff --git a/packages/cloud/shared/src/lib/network/matching/eligibility.ts b/packages/cloud/shared/src/lib/network/matching/eligibility.ts
new file mode 100644
index 000000000000..427499b0cafe
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/eligibility.ts
@@ -0,0 +1,210 @@
+import type {
+  MatchHistory,
+  MatchIntent,
+  MatchingConfig,
+  MatchingInput,
+  MatchMember,
+  MatchProposal,
+  TimeWindow,
+} from "./types.js";
+
+export function unit(value: number): number {
+  return Math.min(1, Math.max(0, value));
+}
+export function overlaps(a: TimeWindow, b: TimeWindow): boolean {
+  return a.start < b.end && b.start < a.end;
+}
+export function commonOpportunityWindows(
+  input: MatchingInput,
+  members: MatchMember[],
+  window: TimeWindow,
+): TimeWindow[] {
+  let possible = [window];
+  for (const member of members) {
+    const intersect = (options: TimeWindow[]) =>
+      possible.flatMap((current) =>
+        options
+          .filter((option) => overlaps(current, option))
+          .map((option) => ({
+            start: Math.max(current.start, option.start),
+            end: Math.min(current.end, option.end),
+          })),
+      );
+    possible = intersect(member.presence.filter((presence) => presence.city === input.city));
+    if (member.availability.length) possible = intersect(member.availability);
+  }
+  return possible;
+}
+export function shared(a: readonly string[], b: readonly string[]): string[] {
+  return [...new Set(a.filter((tag) => b.includes(tag)))].sort();
+}
+export function usableIntents(member: MatchMember, now: number): MatchIntent[] {
+  return member.intents.filter((intent) => intent.expiresAt > now && intent.safetyClass !== "high");
+}
+export function tags(member: MatchMember, now: number): string[] {
+  return [
+    ...new Set([
+      ...usableIntents(member, now).flatMap((intent) => [
+        ...intent.tags,
+        ...intent.needs,
+        ...intent.offers,
+      ]),
+      ...member.facts.filter((fact) => fact.scope !== "agent_private").flatMap((fact) => fact.tags),
+    ]),
+  ].sort();
+}
+export function capabilityTags(member: MatchMember, now: number): string[] {
+  if (member.receiving) return [];
+  return [
+    ...new Set([
+      ...usableIntents(member, now).flatMap((intent) => intent.offers),
+      ...member.facts
+        .filter(
+          (fact) =>
+            fact.scope !== "agent_private" &&
+            ["skill", "offer", "capability"].includes(fact.kind ?? ""),
+        )
+        .flatMap((fact) => fact.tags),
+    ]),
+  ];
+}
+export function pairKey(ids: string[]): string {
+  return [...ids].sort().join("/");
+}
+export function explorationAllowed(
+  member: MatchMember,
+  input: MatchingInput,
+  reserved: MatchProposal[] = [],
+): boolean {
+  const history = (input.budgetHistory ?? input.history).filter(
+    (entry) =>
+      entry.outcome === "proposed" &&
+      entry.memberIds.includes(member.memberId) &&
+      entry.at <= input.now,
+  );
+  const pending = reserved.filter((proposal) => proposal.participantIds.includes(member.memberId));
+  const exploration =
+    history.filter((entry) => entry.exploration !== false).length +
+    pending.filter((proposal) => proposal.exploration).length +
+    1;
+  return (
+    exploration <= Math.floor((history.length + pending.length + 1) * member.explorationFraction)
+  );
+}
+function budgetCount(
+  member: MatchMember,
+  category: string,
+  now: number,
+  history: MatchHistory[],
+  reserved: MatchProposal[],
+): boolean {
+  if (member.onDemand) return true;
+  return member.budgets.every((budget) => {
+    if (budget.category && budget.category !== category) return true;
+    const already = history.filter(
+      (entry) =>
+        entry.outcome === "proposed" &&
+        entry.at > now - budget.windowMs &&
+        entry.at <= now &&
+        entry.memberIds.includes(member.memberId) &&
+        (!budget.category || entry.category === budget.category),
+    ).length;
+    const pending = reserved.filter(
+      (proposal) =>
+        proposal.participantIds.includes(member.memberId) &&
+        (!budget.category || proposal.category === budget.category),
+    ).length;
+    return already + pending < budget.max;
+  });
+}
+
+export function candidateEligibility(
+  input: MatchingInput,
+  members: MatchMember[],
+  category: string,
+  window: TimeWindow,
+  config: MatchingConfig,
+  reserved: MatchProposal[] = [],
+  context?: { timeSensitive: boolean },
+): string[] {
+  const reasons = new Set<string>();
+  if (config.disabledCategories?.includes(category)) reasons.add("category_disabled");
+  if (!config.allowedCategories.includes(category)) reasons.add("category_not_allowed");
+  if (
+    !Number.isFinite(window.start) ||
+    !Number.isFinite(window.end) ||
+    window.start >= window.end ||
+    window.end <= input.now
+  )
+    reasons.add("invalid_window");
+  if (new Set(members.map((member) => member.memberId)).size !== members.length)
+    reasons.add("duplicate_member");
+  for (const member of members) {
+    if (member.age !== "adult") reasons.add("adult_required");
+    if (member.state !== "active") reasons.add("inactive_member");
+    if (member.safetyHold) reasons.add("safety_hold");
+    if (members.length > 2 && member.reliabilityHold?.group) reasons.add("group_reliability_hold");
+    if (context?.timeSensitive && member.reliabilityHold?.timeSensitive)
+      reasons.add("time_sensitive_reliability_hold");
+    if (member.categoryOptOuts.includes(category)) reasons.add("category_opt_out");
+    const formats = member.preferredFormats ?? [];
+    if (
+      formats.length &&
+      ((formats.includes("one_to_one") && !formats.includes("small_group") && members.length > 2) ||
+        (formats.includes("small_group") &&
+          !formats.includes("one_to_one") &&
+          members.length === 2))
+    )
+      reasons.add("format_preference");
+    if (member.unansweredProposals >= 2 && !member.onDemand) reasons.add("two_unanswered");
+    if (
+      !member.presence.some(
+        (presence) => presence.city === input.city && overlaps(presence, window),
+      )
+    )
+      reasons.add("presence_mismatch");
+    if (
+      (member.availability.length > 0 ||
+        member.availabilityCoverage === "complete" ||
+        member.availabilityCoverage === "sampled") &&
+      !member.availability.some((available) => overlaps(available, window))
+    )
+      reasons.add(
+        member.availabilityCoverage === "sampled" ? "availability_not_qualified" : "unavailable",
+      );
+    if (!budgetCount(member, category, input.now, input.budgetHistory ?? input.history, reserved))
+      reasons.add("budget_exhausted");
+    for (const other of members) {
+      if (member.memberId === other.memberId) continue;
+      if (member.blockedIds.includes(other.memberId)) reasons.add("blocked_pair");
+      if (
+        category === "romance" &&
+        (!member.romanceOptIn || !member.romanceAllowedMemberIds.includes(other.memberId))
+      )
+        reasons.add("romance_preference");
+      for (const history of input.history) {
+        if (
+          !history.memberIds.includes(member.memberId) ||
+          !history.memberIds.includes(other.memberId)
+        )
+          continue;
+        if (history.outcome === "negative" && (history.cooldownUntil ?? Infinity) > input.now)
+          reasons.add("pair_negative");
+        if (history.outcome === "proposed" && input.now - history.at < config.pairCooldownMs)
+          reasons.add("pair_cooldown");
+      }
+    }
+    if (
+      input.history.some(
+        (history) =>
+          history.outcome === "proposed" &&
+          history.memberIds.includes(member.memberId) &&
+          history.category === category &&
+          input.now - history.at < config.categoryCooldownMs,
+      )
+    )
+      reasons.add("category_cooldown");
+  }
+  if (!commonOpportunityWindows(input, members, window).length) reasons.add("no_common_time");
+  return [...reasons].sort();
+}
