+    case "delete_fact":
+      basicMember();
+      text(value.factId, "fact id", 160);
+      break;
+    case "manage_intent":
+      basicMember();
+      record(value.intent);
+      onlyKeys(value.intent, [
+        "id",
+        "objective",
+        "category",
+        "tags",
+        "needs",
+        "offers",
+        "status",
+        "expiresAt",
+      ]);
+      if (value.intent.expiresAt !== undefined) iso(value.intent.expiresAt, "intent expiry");
+      text(value.intent.id, "intent id", 160);
+      text(value.intent.objective, "intent objective");
+      text(value.intent.category, "intent category", 160);
+      strings(value.intent.tags, "intent tags");
+      strings(value.intent.needs, "intent needs");
+      strings(value.intent.offers, "intent offers");
+      oneOf(value.intent.status, ["active", "paused", "closed", "expired"], "intent status");
+      break;
+    case "set_presence":
+      basicMember();
+      record(value.presence);
+      onlyKeys(value.presence, ["id", "city", "kind", "area", "startsAt", "endsAt"]);
+      text(value.presence.id, "presence id", 160);
+      oneOf(value.presence.city, ["SF", "NYC"], "city");
+      oneOf(value.presence.kind, ["home", "routine", "temporary"], "presence kind");
+      text(value.presence.area, "presence area", 500);
+      iso(value.presence.startsAt, "presence start");
+      if (value.presence.endsAt !== null) iso(value.presence.endsAt, "presence end");
+      break;
+    case "set_preferences":
+      basicMember();
+      record(value.preferences);
+      onlyKeys(value.preferences, [
+        "categories",
+        "quietHours",
+        "timezone",
+        "formats",
+        "travelMinutes",
+        "romanceOptIn",
+        "boundaries",
+        "proactiveOptIn",
+        "onlyWhenAsked",
+        "explorationFraction",
+      ]);
+      if (value.preferences.quietHours !== undefined) {
+        record(value.preferences.quietHours);
+        onlyKeys(value.preferences.quietHours, ["start", "end"]);
+      }
+      if (value.participation !== undefined)
+        oneOf(
+          value.participation,
+          ["normal", "open", "quiet", "receiving", "paused"],
+          "participation",
+        );
+      break;
