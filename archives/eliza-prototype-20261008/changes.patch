diff --git a/packages/cloud/shared/src/lib/network/workbench/portal-login.test.ts b/packages/cloud/shared/src/lib/network/workbench/portal-login.test.ts
new file mode 100644
index 000000000000..2237e502f46a
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/portal-login.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import { LocalNetworkPhoneLogin, NETWORK_PORTAL_DEMO_PHONE } from "./portal-login.ts";
+
+describe("closed local phone portal", () => {
+  it("uses one-time purpose-bound auth codes and rejects another app or a replay", async () => {
+    const login = new LocalNetworkPhoneLogin();
+    const challenge = await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+    expect(challenge.demoCode).toMatch(/^\d{6}$/);
+    await expect(
+      login.verify(challenge.challengeId, challenge.demoCode, "slop.love"),
+    ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+    expect(await login.verify(challenge.challengeId, challenge.demoCode, "friend.help")).toBe(true);
+    await expect(
+      login.verify(challenge.challengeId, challenge.demoCode, "friend.help"),
+    ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  });
+  it("never delivers a real-phone code or turns an unknown phone into a member", async () => {
+    const login = new LocalNetworkPhoneLogin();
+    const challenge = await login.start("+14155551234", "friend.help");
+    expect(challenge).not.toHaveProperty("demoCode");
+    await expect(
+      login.verify(challenge.challengeId, "000000", "friend.help"),
+    ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+    await expect(login.start("bad", "friend.help")).rejects.toMatchObject({
+      code: "NETWORK_INVALID",
+    });
+  });
+  it("limits wrong attempts and resends, and retires an earlier request", async () => {
+    const login = new LocalNetworkPhoneLogin();
+    const first = await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+    const second = await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+    await expect(login.verify(first.challengeId, first.demoCode, "friend.help")).rejects.toThrow();
+    for (let index = 0; index < 5; index++)
+      await expect(login.verify(second.challengeId, "not-a-code", "friend.help")).rejects.toThrow();
+    await expect(
+      login.verify(second.challengeId, second.demoCode, "friend.help"),
+    ).rejects.toThrow();
+    await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+    await expect(login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help")).rejects.toMatchObject({
+      code: "NETWORK_INELIGIBLE",
+    });
+  });
+  it("admits only one concurrent send and one concurrent verification", async () => {
+    const login = new LocalNetworkPhoneLogin();
+    const sends = await Promise.allSettled([
+      login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help"),
+      login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help"),
+    ]);
+    expect(sends.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    const success = sends.find((result) => result.status === "fulfilled");
+    if (!success || success.status !== "fulfilled") throw new Error("Expected one local challenge");
+    const challenge = success.value;
+    const checks = await Promise.allSettled([
+      login.verify(challenge.challengeId, challenge.demoCode, "friend.help"),
+      login.verify(challenge.challengeId, challenge.demoCode, "friend.help"),
+    ]);
+    expect(checks.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+  });
+});
+
+it("does not grant a session when a resend replaces a verification in flight", async () => {
+  const login = new LocalNetworkPhoneLogin();
+  const first = await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+  const verification = login.verify(first.challengeId, first.demoCode, "friend.help");
+  const second = await login.start(NETWORK_PORTAL_DEMO_PHONE, "friend.help");
+  await expect(verification).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  expect(await login.verify(second.challengeId, second.demoCode, "friend.help")).toBe(true);
+});
diff --git a/packages/cloud/shared/src/lib/network/workbench/portal-login.ts b/packages/cloud/shared/src/lib/network/workbench/portal-login.ts
new file mode 100644
index 000000000000..ff9c7b6cf8fb
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/portal-login.ts
@@ -0,0 +1,154 @@
+/** Closed preview of phone login. The auth package owns OTP generation and consumption. */
+import { randomUUID } from "node:crypto";
+import { isValidE164, PhoneAuth, TokenStore } from "@elizaos/auth/phone";
+import { NetworkDomainError } from "../domain/types.ts";
+
+export const NETWORK_PORTAL_BRANDS = [
+  {
+    id: "friend.help",
+    name: "friend.help",
+    purpose: "Find your people",
+    description: "Make room for people you would like to know.",
+  },
+  {
+    id: "slop.love",
+    name: "slop.love",
+    purpose: "Meet by mutual choice",
+    description: "A reason to meet. A connection you both choose.",
+  },
+  {
+    id: "network",
+    name: "The Network",
+    purpose: "Meet your Network agent",
+    description: "More possibilities. Less arranging.",
+  },
+] as const;
+export const NETWORK_PORTAL_DEMO_PHONE = "+12025550101";
+
+export class LocalNetworkPhoneLogin {
+  private readonly challenges = new Map<
+    string,
+    { phone: string; brand: string; expiresAt: number; attempts: number; code: string | null }
+  >();
+  private readonly sends = new Map<string, number[]>();
+  private readonly sending = new Set<string>();
+  private readonly tokens = new TokenStore();
+  private readonly auth = new PhoneAuth({
+    tokenStore: this.tokens,
+    tokenTtlMs: 10 * 60_000,
+    provider: {
+      send: async (phone, body) => {
+        const challenge = [...this.challenges.values()].find(
+          (item) => item.phone === phone && item.code === null,
+        );
+        if (!challenge || phone !== NETWORK_PORTAL_DEMO_PHONE)
+          throw new Error("Only the reserved local fixture can receive a preview code");
+        challenge.code = body.match(/\b\d{6}\b/)?.[0] ?? null;
+        if (!challenge.code) throw new Error("Local code delivery failed");
+      },
+    },
+  });
+
+  async start(phone: unknown, brand: unknown) {
+    if (!isValidE164(phone) || !NETWORK_PORTAL_BRANDS.some((item) => item.id === brand))
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "Enter a phone number with its country code and choose an app.",
+      );
+    if (this.sending.has(phone))
+      throw new NetworkDomainError("NETWORK_CONFLICT", "A code request is already in progress.");
+    const now = Date.now();
+    for (const [id, item] of this.challenges) if (item.expiresAt <= now) this.challenges.delete(id);
+    for (const [key, times] of this.sends)
+      if (times.every((time) => time <= now - 86_400_000)) this.sends.delete(key);
+    const times = (this.sends.get(phone) ?? []).filter((time) => time > now - 86_400_000);
+    const recent = times.filter((time) => time > now - 15 * 60_000);
+    if (
+      recent.length >= 3 ||
+      times.length >= 10 ||
+      this.challenges.size >= 256 ||
+      this.sends.size >= 256
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INELIGIBLE",
+        "Too many code requests. Wait before requesting another code.",
+      );
+    this.sends.set(phone, [...times, now]);
+    // Resending invalidates the earlier challenge, even in another local app.
+    for (const [id, item] of this.challenges) if (item.phone === phone) this.challenges.delete(id);
+    const challengeId = randomUUID();
+    const challenge = {
+      phone,
+      brand: String(brand),
+      expiresAt: now + 10 * 60_000,
+      attempts: 0,
+      code: null as string | null,
+    };
+    this.challenges.set(challengeId, challenge);
+    if (phone === NETWORK_PORTAL_DEMO_PHONE) {
+      this.sending.add(phone);
+      try {
+        const delivery = await this.auth.sendOtp(
+          phone,
+          `network-preview:${brand}:${challengeId}`,
+          "sms",
+        );
+        challenge.expiresAt = delivery.expiresAt.getTime();
+      } catch (error) {
+        this.challenges.delete(challengeId);
+        throw error;
+      } finally {
+        this.sending.delete(phone);
+      }
+    }
+    const response = {
+      challengeId,
+      maskedPhone: `••• ••• ${phone.slice(-4)}`,
+      expiresAt: new Date(challenge.expiresAt).toISOString(),
+      ...(challenge.code ? { demoCode: challenge.code } : {}),
+    };
+    challenge.code = null;
+    return response;
+  }
+
+  async verify(id: unknown, code: unknown, brand: unknown): Promise<boolean> {
+    const challenge = typeof id === "string" ? this.challenges.get(id) : undefined;
+    if (
+      !challenge ||
+      challenge.brand !== brand ||
+      challenge.expiresAt <= Date.now() ||
+      challenge.attempts >= 5
+    )
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "This code request expired. Request a new code.",
+      );
+    challenge.attempts++;
+    if (
+      typeof code !== "string" ||
+      !/^\d{6}$/.test(code) ||
+      challenge.phone !== NETWORK_PORTAL_DEMO_PHONE
+    )
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "The code could not be verified. Check it or request a new code.",
+      );
+    const result = await this.auth.verifyOtp(
+      challenge.phone,
+      code,
+      `network-preview:${brand}:${id}`,
+    );
+    if (this.challenges.get(String(id)) !== challenge || challenge.expiresAt <= Date.now())
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "This code request changed. Use the latest code.",
+      );
+    if (!result.valid)
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "The code could not be verified. Check it or request a new code.",
+      );
+    this.challenges.delete(String(id));
+    return true;
+  }
+}
diff --git a/packages/cloud/shared/src/lib/network/workbench/programme-groups.ts b/packages/cloud/shared/src/lib/network/workbench/programme-groups.ts
new file mode 100644
index 000000000000..c00ab8abf7e5
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/programme-groups.ts
@@ -0,0 +1,209 @@
+import { networkDigest } from "../digest.ts";
+import { staff } from "../domain/policy.ts";
+import { type NetworkActor, NetworkDomainError } from "../domain/types.ts";
+import { text } from "../domain/validation.ts";
+import {
+  matchingConfigFromSettings,
+  opportunityDraft,
+  projectMatchingInput,
+} from "../matching/domain-projection.ts";
+import { buildMatchingRun } from "../matching/engine.ts";
+import type { createLocalNetworkHost } from "./host.ts";
+
+/** Suggested seating is a new reviewed small opportunity, never an automatic audience introduction. */
+export async function planProgrammeSubgroups(
+  host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  actor: NetworkActor,
+  input: Record<string, unknown>,
+) {
+  staff(actor, ["reviewer", "engineer"]);
+  text(input.requestId, "composition request", 120);
+  text(input.opportunityId, "public programme", 160);
+  if (
+    typeof input.groupSize !== "number" ||
+    !Number.isSafeInteger(input.groupSize) ||
+    input.groupSize < 3 ||
+    input.groupSize > 6
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Choose a group size between three and six");
+  const opportunityId = input.opportunityId,
+    groupSize = input.groupSize,
+    requestId = input.requestId;
+  const digest = networkDigest([actor, input]),
+    runId = `programme-groups:${requestId}`;
+  return host.domain.withAuthority(async (domain, db) => {
+    const prior = await domain.getMatchingRun({ type: "system" }, runId);
+    if (prior) {
+      const metadata = prior.log.publicProgrammeComposition;
+      if (
+        !metadata ||
+        typeof metadata !== "object" ||
+        !("digest" in metadata) ||
+        metadata.digest !== digest
+      )
+        throw new NetworkDomainError(
+          "NETWORK_IDEMPOTENCY",
+          "Composition request identity was reused",
+        );
+      return {
+        result: prior.log,
+        replayed: true,
+        message: "Original suggested subgroups retained; no new contacts or proposals created.",
+      };
+    }
+    const programme = await domain.getOpportunity({ type: "system" }, opportunityId);
+    if (
+      !("participants" in programme) ||
+      programme.kind !== "monthly_event" ||
+      !programme.programme ||
+      programme.review?.decision !== "approved" ||
+      programme.review.revision !== programme.revision
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INELIGIBLE",
+        "Current reviewed public programme required",
+      );
+    if (input.expectedRevision !== programme.revision)
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Public programme revision changed");
+    const clock = host.domain.options.clock,
+      now = clock.now().getTime();
+    if (
+      Date.parse(programme.programme.startsAt) <= now ||
+      !["approved", "inviting", "scheduled", "quorum_met"].includes(programme.state)
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INELIGIBLE",
+        "Suggest seating before the public programme starts",
+      );
+    const accepted = programme.participants.filter(
+      (p) =>
+        p.revision === programme.revision &&
+        p.acceptedAt &&
+        ["accepted", "confirmed", "attended"].includes(p.state),
+    );
+    if (accepted.length < groupSize)
+      return {
+        result: { status: "waiting_for_rsvps", acceptedCount: accepted.length, needed: groupSize },
+        message:
+          "The public gathering remains independent. More independent RSVPs are needed for this subgroup size.",
+      };
+    const snapshot = await domain.engineSnapshot({ type: "system" }),
+      settings = await domain.getSettings({ type: "system" });
+    const attendeeIds = new Set(accepted.map((p) => p.memberId));
+    const config = matchingConfigFromSettings(settings);
+    const matching = projectMatchingInput(
+      {
+        ...snapshot,
+        members: snapshot.members.filter((member) => attendeeIds.has(member.memberId)),
+        opportunities: snapshot.opportunities.filter(
+          (opportunity) => opportunity.kind !== "monthly_event",
+        ),
+      },
+      {
+        runId,
+        city: programme.city,
+        seed: parseInt(networkDigest(requestId).slice(0, 8), 16),
+        startAt: programme.programme.startsAt,
+        endAt: programme.programme.endsAt,
+      },
+      now,
+      config,
+      settings,
+    );
+    const tag = `public-rsvp:${networkDigest(programme.id)}`;
+    for (const member of matching.members) {
+      const participation = accepted.find((p) => p.memberId === member.memberId);
+      if (!participation?.acceptedAt) throw new Error("Projected RSVP binding unavailable");
+      member.facts.push({
+        id: networkDigest([programme.id, programme.revision, member.memberId, "independent-rsvp"]),
+        kind: "public_programme_rsvp",
+        text: "I independently accepted the reviewed public programme",
+        tags: [tag],
+        scope: "network",
+        confidence: 1,
+        confirmedAt: Date.parse(participation.acceptedAt),
+      });
+      member.intents.push({
+        id: `programme-intent:${programme.id}:${member.memberId}`,
+        category: programme.category,
+        tags: [tag],
+        needs: [],
+        offers: [],
+        kind: "activity",
+        safetyClass: "low",
+        createdAt: Date.parse(participation.acceptedAt),
+        expiresAt: Date.parse(programme.programme.endsAt),
+      });
+    }
+    matching.edges = await host.native.graphEdges(db.execute, [...attendeeIds]);
+    matching.events = [
+      {
+        id: programme.id,
+        category: programme.category,
+        city: programme.city,
+        tags: [tag],
+        window: matching.window,
+        area: programme.programme.publicVenue.area,
+        sourceUrl: `https://network-fixtures.invalid/programme/${networkDigest(host.domain.options.networkId)}/${networkDigest(programme.id)}`,
+        observedAt: Date.parse(programme.review.at),
+        expiresAt: Date.parse(programme.programme.endsAt),
+        verified: true,
+      },
+    ];
+    matching.constraints = {
+      participants: groupSize,
+      category: programme.category,
+      anchorId: programme.id,
+    };
+    matching.modelVersions.rsvpProjection = "public-programme-independent-rsvp-2";
+    const run = await buildMatchingRun(matching, { config });
+    const drafts = run.proposals.map((proposal) => {
+      const draft = opportunityDraft(proposal, programme.city, matching.members);
+      draft.kind = "event";
+      draft.anchorEventId = programme.id;
+      return draft;
+    });
+    const log = {
+      ...run,
+      publicProgrammeComposition: {
+        digest,
+        programmeId: programme.id,
+        programmeRevision: programme.revision,
+        source: "independent_public_rsvp",
+        groupSize,
+        localQualification: "synthetic public programme; calendar/travel unknown",
+      },
+    };
+    await domain.command(
+      { type: "system" },
+      {
+        type: "commit_matching_run",
+        requestId: `programme-log:${requestId}`,
+        runId,
+        city: programme.city,
+        inputDigest: run.inputDigest,
+        inputRevisions: Object.fromEntries(
+          snapshot.members
+            .filter((m) => attendeeIds.has(m.memberId))
+            .map((m) => [m.memberId, m.revision]),
+        ),
+        settingsRevision: settings.revision,
+        log,
+        drafts,
+      },
+    );
+    return {
+      result: {
+        runId,
+        proposalIds: drafts.map((draft) => draft.id),
+        invited: false,
+        reviewRequired: true,
+        qualification:
+          "Explicit RSVP evidence drives the real constrained matcher; each new subgroup requires fresh review and member consent.",
+      },
+      message: drafts.length
+        ? "Small public co-attendance proposals are ready for independent human review."
+        : "No subgroup cleared all member, budget, block and fit constraints. No introduction was invented.",
+    };
+  });
+}
