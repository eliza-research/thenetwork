+    const intentId = (await host.domain.getMember(actor, memberId)).intents[0].id;
+    const outreach = host.outreach;
+    const proposal = {
+      requestId: "first",
+      memberId,
+      purpose: "profiling" as const,
+      category: "music",
+      city: "SF" as const,
+      body: "Would a public one-to-one plan be comfortable? You can skip this question.",
+      expiresAt: "2026-10-09T18:00:00Z",
+      timeliness: { kind: "underspecified_intent" as const, sourceRef: intentId },
+    };
+    const queued = await outreach.propose(actor, proposal);
+    expect(queued.state).toBe("pending");
+    expect(await host.transport.messages()).toEqual([]);
+    await expect(outreach.propose(actor, { ...proposal, requestId: "second" })).rejects.toThrow(
+      "one outstanding",
+    );
+    await expect(
+      outreach.review(actor, {
+        memberId,
+        requestId: queued.id,
+        decision: "approved",
+        note: "model reviewed:true",
+      }),
+    ).rejects.toThrow("Staff");
+    await outreach.review(
+      { type: "staff", userId: "reviewer", roles: ["reviewer"] },
+      {
+        memberId,
+        requestId: queued.id,
+        decision: "approved",
+        note: "Timely, generic one-question fixture",
+      },
+    );
+    const task = (await host.runner.list()).find(
+      (task) => (task.metadata?.network as { requestId?: string })?.requestId === queued.id,
+    );
+    if (!task) throw new Error("Native outreach task absent");
+    await host.runner.fire(task.taskId);
+    expect(await host.transport.messages()).toEqual([]);
+    clock.advanceTo("2026-10-05T19:00:00Z");
+    await host.drainDue();
+    const record = { taskId: task.taskId, metadata: task.metadata } as Parameters<
+      NetworkOutreach["dispatch"]
+    >[0];
+    expect((await outreach.dispatch(record)).ok).toBe(true);
+    expect((await outreach.dispatch(record)).ok).toBe(true);
+    expect(await host.transport.messages()).toHaveLength(1);
+    expect((await host.transport.messages())[0].sequence).toBeGreaterThan(0);
+    expect(
+      await host.db.execute(
+        "SELECT id FROM network.proactive_receipts WHERE network_id='test:single-player-outreach'",
+      ),
+    ).toHaveLength(1);
+    await expect(
+      outreach.propose(actor, { ...proposal, requestId: "still-outstanding" }),
+    ).rejects.toThrow("one outstanding");
+    clock.advanceTo("2026-10-08T19:00:00Z");
+    await host.domain.command({ type: "system" }, { type: "tick", requestId: "deadline" });
+    expect((await host.domain.getMember(actor, memberId)).consecutiveUnanswered).toBe(1);
+    await host.domain.command(actor, { type: "record_inbound", requestId: "inbound", memberId });
+    const opportunitiesBefore = (await host.domain.adminView({ type: "system" })).opportunities;
+    expect(
+      (
+        await outreach.propose(actor, {
+          ...proposal,
+          requestId: "after-answer",
+          expiresAt: "2026-10-12T19:00:00Z",
+        })
+      ).state,
+    ).toBe("pending");
+    expect((await host.domain.adminView({ type: "system" })).opportunities).toEqual(
+      opportunitiesBefore,
+    );
+    await publishLocalWorldFixture(
+      host.domain,
+      { type: "system" },
+      {
+        requestId: "same-day-fixture",
+        fixtureId: "same-day",
+        title: "Authored fixture public activity",
+        kind: "event",
+        city: "SF",
+        area: "Public fixture park",
+        tags: "music",
+        category: "music",
+        startsAt: "2026-10-08T21:00:00.000Z",
+        endsAt: "2026-10-08T22:00:00.000Z",
+        freshHours: 24,
+      },
+    );
+    const recommendationInput = {
+      ...proposal,
