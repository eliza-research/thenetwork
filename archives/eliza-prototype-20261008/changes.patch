+import { expect, it } from "vitest";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { importNetworkMemoryPaste } from "./sources.ts";
+
+it("adds complete local source proposals, preserves confirmed member facts, fences changed retry, and revokes source-derived knowledge", async () => {
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:paste",
+    clock: new SimClock(Date.parse("2026-10-06T16:00:00Z")),
+  });
+  try {
+    const memberId = (await seedSimulationMembers(host.domain, 100, 9))[0].memberId;
+    const actor = { type: "member", memberId } as const;
+    const before = await host.domain.getMember(actor, memberId);
+    const input = {
+      requestId: "paste",
+      sourceId: "local-source",
+      text: "interest: confidential climbing\noffer: public fixture gardening",
+    };
+    const imported = await importNetworkMemoryPaste(host.domain, actor, input);
+    expect(imported.proposed).toHaveLength(2);
+    expect(imported.receipts.every((receipt) => receipt.outcome === "applied")).toBe(true);
+    const enriched = await host.domain.getMember(actor, memberId);
+    expect(
+      enriched.facts.filter((fact) => before.facts.some((original) => original.id === fact.id)),
+    ).toEqual(before.facts);
+    expect(
+      enriched.facts
+        .filter((fact) => fact.source === "memory_paste")
+        .every((fact) => fact.status === "proposed" && fact.scope === "agent_private"),
+    ).toBe(true);
+    const original = enriched.facts.find((fact) => fact.source === "memory_paste");
+    if (!original) throw new Error("Retained source proposal absent");
+    const { revision: _revision, updatedAt: _updatedAt, ...fact } = original;
+    await host.domain.command(actor, {
+      type: "upsert_fact",
+      requestId: "reject-source-fact",
+      memberId,
+      fact: { ...fact, status: "rejected" },
+    });
+    await importNetworkMemoryPaste(host.domain, actor, {
+      ...input,
+      requestId: "repeat-source-after-reject",
+    });
+    expect(
+      (await host.domain.getMember(actor, memberId)).facts.find((value) => value.id === fact.id)
+        ?.status,
+    ).toBe("rejected");
+    await expect(
+      importNetworkMemoryPaste(host.domain, actor, { ...input, text: "interest: changed" }),
+    ).rejects.toThrow("Request key");
+    await expect(
+      importNetworkMemoryPaste(host.domain, actor, {
+        ...input,
+        requestId: "invalid",
+        text: "unlabelled unsupported text",
+      }),
+    ).rejects.toThrow("silently omitted");
+    await host.domain.command(actor, {
+      type: "connect_source",
+      requestId: "revoke",
+      memberId,
+      source: {
+        id: "local-source",
+        kind: "memory_paste",
+        sourceRef: `memory-paste:${memberId}:local-source`,
+        status: "revoked",
+      },
+    });
+    expect(
+      (await host.domain.getMember(actor, memberId)).facts.filter(
+        (fact) => fact.source === "memory_paste",
+      ),
+    ).toEqual([]);
+  } finally {
+    await host.close();
+  }
+}, 120000);
diff --git a/packages/cloud/shared/src/lib/network/agent/sources.ts b/packages/cloud/shared/src/lib/network/agent/sources.ts
new file mode 100644
index 000000000000..c87b2fba82fe
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/agent/sources.ts
@@ -0,0 +1,90 @@
+import { networkDigest } from "../digest.ts";
+import type { NetworkActor, NetworkDomain } from "../domain/index.ts";
+import { NetworkDomainError } from "../domain/index.ts";
+
+/** Local pasted source enrichment. The Domain owns consent, facts, provenance and revoke. */
+export async function importNetworkMemoryPaste(
+  domain: NetworkDomain,
+  actor: NetworkActor,
+  input: { requestId: string; sourceId: string; text: string },
+) {
+  if (actor.type !== "member")
+    throw new NetworkDomainError("NETWORK_FORBIDDEN", "Own member source required");
+  if (
+    !input.requestId?.trim() ||
+    input.requestId.length > 120 ||
+    !input.sourceId?.trim() ||
+    input.sourceId.length > 120 ||
+    typeof input.text !== "string" ||
+    !input.text.trim() ||
+    input.text.length > 30000
+  )
+    throw new NetworkDomainError(
+      "NETWORK_INVALID",
+      "Complete local source text and stable source/request identities required",
+    );
+  const lines = input.text.split(/\r?\n/).filter((line) => line.trim());
+  const proposals = lines.map((line) => {
+    const match = /^(interest|offer|routine|boundary|city|goal):\s*(.+)$/i.exec(line.trim());
+    if (!match)
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "Local parser accepts one labelled interest, offer, routine, boundary, city or goal per line; no input is silently omitted",
+      );
+    return { kind: match[1].toLowerCase(), value: match[2] };
+  });
+  return domain.withAuthority(async (joined) => {
+    const member = await joined.getMember(actor, actor.memberId);
+    await joined.command(
+      { type: "system" },
+      {
+        type: "record_event",
+        requestId: `source-paste:${networkDigest([actor.memberId, input.requestId])}`,
+        kind: "source_paste_imported",
+        memberIds: [actor.memberId],
+        opportunityId: null,
+        details: { sourceId: input.sourceId, digest: networkDigest(input.text) },
+      },
+    );
+    const sourceRef = `memory-paste:${actor.memberId}:${input.sourceId}`;
+    const source = await joined.commandWithReceipt(actor, {
+      type: "connect_source",
+      requestId: `source:${networkDigest([input.requestId, input.text])}`,
+      memberId: actor.memberId,
+      source: { id: input.sourceId, kind: "memory_paste", sourceRef, status: "connected" },
+    });
+    const receipts = [source.receipt];
+    const proposed = [];
+    for (const item of proposals) {
+      // Additive means preserve member facts and existing same-value source facts.
+      if (member.facts.some((fact) => fact.kind === item.kind && fact.value === item.value))
+        continue;
+      const id = `source-fact:${networkDigest([sourceRef, item])}`;
+      const committed = await joined.commandWithReceipt(actor, {
+        type: "upsert_fact",
+        requestId: `source-fact:${networkDigest([input.requestId, id])}`,
+        memberId: actor.memberId,
+        fact: {
+          id,
+          ...item,
+          tags: [],
+          scope: "agent_private",
+          source: "memory_paste",
+          sourceRef,
+          sourceRevision: 1,
+          confidence: 1,
+          status: "proposed",
+        },
+      });
+      receipts.push(committed.receipt);
+      proposed.push({ id, ...item, scope: "agent_private", status: "proposed", sourceRef });
+    }
+    return {
+      sourceId: input.sourceId,
+      proposed,
+      receipts,
+      message:
+        "These additive pasted-source facets are private proposals. Confirm, correct or reject each with your member controls. Revoking the source removes its sourced facets and derived matching knowledge.",
+    };
+  });
+}
