diff --git a/packages/cloud/shared/src/lib/network/workbench/experience.ts b/packages/cloud/shared/src/lib/network/workbench/experience.ts
new file mode 100644
index 000000000000..722020a5fa43
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/experience.ts
@@ -0,0 +1,230 @@
+import type { NetworkRow } from "@elizaos/contracts/network-workbench";
+import { PseudonymSession } from "@elizaos/core";
+import { TrajectoriesService } from "@elizaos/plugin-assistant";
+import { sqlJson, sqlQuote } from "@elizaos/plugin-sql";
+import { networkConversationIdentity, readNetworkConversationHistory } from "../agent/service.ts";
+import {
+  assertReplayLog,
+  networkProjectionTexts,
+  scrubNetworkProjection,
+  staff,
+} from "../domain/policy.ts";
+import { payload } from "../domain/store.ts";
+import { type NetworkActor, NetworkDomainError, type ProfileFact } from "../domain/types.ts";
+import { iso, text } from "../domain/validation.ts";
+import type { createLocalNetworkHost } from "./host.ts";
+import { compareTimelineRows } from "./views.ts";
+
+/** Joins existing message, trajectory and event owners; raw access is a separate audited purpose. */
+export async function readNetworkExperience(
+  host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  actor: NetworkActor,
+  input: {
+    memberId: string;
+    purpose: string | null;
+    startAt: string | null;
+    endAt: string | null;
+    keyword: string | null;
+    channel: string | null;
+  },
+) {
+  staff(actor, ["reviewer", "analyst", "safety", "engineer"]);
+  text(input.memberId, "member identity", 160);
+  if (input.startAt) iso(input.startAt, "replay start");
+  if (input.endAt) iso(input.endAt, "replay end");
+  if (input.startAt && input.endAt && input.startAt >= input.endAt)
+    throw new NetworkDomainError("NETWORK_INVALID", "Replay window must increase");
+  if (input.keyword) text(input.keyword, "conversation keyword", 500);
+  if (input.channel && !["web", "sms", "imessage"].includes(input.channel))
+    throw new NetworkDomainError("NETWORK_INVALID", "Unknown conversation channel");
+  if (input.purpose) await host.domain.revealMember(actor, input.memberId, input.purpose);
+  const member = await host.domain.getMember({ type: "system" }, input.memberId);
+  if (member.accountState === "removed")
+    throw new NetworkDomainError("NETWORK_FORBIDDEN", "Removed member history is unavailable");
+  const messages = await readNetworkConversationHistory({
+    adapter: host.adapter,
+    agentId: host.runtime.agentId,
+    networkId: host.domain.options.networkId,
+    memberId: input.memberId,
+  });
+  const snapshot = await host.domain.adminView(actor);
+  const delivered = (await host.transport.messages()).filter(
+    (message) => message.memberId === member.memberId,
+  );
+  const identity = networkConversationIdentity(host.domain.options.networkId, member.memberId);
+  const owner = new TrajectoriesService(host.runtime);
+  const trajectories = [];
+  try {
+    for (let offset = 0; ; ) {
+      const page = await owner.listTrajectories({ roomId: identity.roomId, offset, limit: 500 });
+      for (const entry of page.trajectories) {
+        if (entry.agentId !== host.runtime.agentId || entry.roomId !== identity.roomId)
+          throw new NetworkDomainError("NETWORK_SAFETY", "Trajectory escaped its private room");
+        const detail = await owner.getTrajectoryDetail(entry.id);
+        const messageId =
+          typeof entry.metadata.messageId === "string" ? entry.metadata.messageId : null;
+        const incoming = messages.find((message) => message.id === messageId);
+        trajectories.push({
+          ...entry,
+          logicalAt: incoming?.createdAt ?? null,
+          sourceMessageId: messageId,
+          detail,
+        });
+      }
+      offset += page.trajectories.length;
+      if (offset >= page.total) break;
+      if (!page.trajectories.length)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Incomplete trajectory page; retry the read",
+        );
+    }
+  } finally {
+    await owner.stop();
+  }
+  const rows: NetworkRow[] = [
+    ...messages.map((message) => ({
+      id: `native:${message.id}`,
+      title: message.text,
+      fields: {
+        at: message.createdAt,
+        sequence: message.sequence,
+        memberId: member.memberId,
+        direction: message.role === "member" ? "inbound" : "outbound",
+        channel: message.channel,
+        source: "native_shared_chat",
+        messageId: message.id,
+        sourceMessageId: message.sourceMessageId,
+      },
+    })),
+    ...delivered.map((message) => ({
+      id: `delivery:${message.idempotencyKey}`,
+      title: message.body,
+      fields: {
+        at: message.acceptedAt,
+        sequence: message.sequence,
+        memberId: member.memberId,
+        direction: message.direction,
+        channel: message.channel,
+        source: "native_mock_receipt",
+      },
+    })),
+    ...snapshot.events
+      .filter(
+        (event) =>
+          event.memberIds.includes(member.memberId) &&
+          !(
+            event.kind === "outbound_accepted" &&
+            delivered.some((message) => message.sequence === event.sequence)
+          ),
+      )
+      .map((event) => ({
+        id: event.id,
+        title: event.kind,
+        fields: {
+          at: event.at,
+          sequence: event.sequence,
+          memberId: member.memberId,
+          opportunityId: event.opportunityId,
+          source: "domain_event",
+          ...event.details,
+        },
+      })),
+  ];
+  rows.sort(compareTimelineRows);
+  const matchingRuns = snapshot.matchingRuns.filter((run) => {
+    const log = run.log;
+    if (!log || typeof log !== "object" || Array.isArray(log) || !("replayInput" in log))
+      return false;
+    const replay = log.replayInput;
+    if (!replay || typeof replay !== "object" || Array.isArray(replay) || !("members" in replay))
+      return false;
+    return (
+      Array.isArray(replay.members) &&
+      replay.members.some(
+        (profile) =>
+          profile &&
+          typeof profile === "object" &&
+          "memberId" in profile &&
+          profile.memberId === member.memberId,
+      )
+    );
+  });
+  let result = {
+    memberId: member.memberId,
+    rows,
+    trajectories,
+    matchingRuns,
+    qualification:
+      "Retained native messages, observable trajectories and domain events. Unjoined trajectory clocks remain explicitly unknown; live models/providers are unqualified.",
+  };
+  if (!input.purpose) {
+    const historicalPrivateFacts = await host.domain
+      .withAuthority(async (_joined, sql) =>
+        sql.execute(`SELECT DISTINCT fact AS payload
+        FROM network.commands receipt
+        CROSS JOIN LATERAL jsonb_array_elements(
+          CASE WHEN jsonb_typeof(receipt.result->'facts')='array'
+            THEN receipt.result->'facts' ELSE '[]'::jsonb END
+        ) fact
+        WHERE receipt.network_id=${sqlQuote(host.domain.options.networkId)}
+          AND receipt.member_ids @> ${sqlJson([member.memberId])}::jsonb
+          AND receipt.result->>'memberId'=${sqlQuote(member.memberId)}
+          AND fact->>'scope'='agent_private'
+          AND jsonb_typeof(fact->'value')='string'`),
+      )
+      .then((rows) => rows.map((row) => payload<ProfileFact>(row)));
+    const session = new PseudonymSession({
+      salt: `${host.domain.options.networkId}:staff-experience`,
+      minValueLength: 1,
+      walkBudget: { maxNodes: 2_000_000, maxBytes: 64 * 1024 * 1024 },
+    });
+    const normalized = session.substituteRecordsInValue(result);
+    for (const text of networkProjectionTexts(normalized)) session.learnSpans(text, []);
+    session.learnSpans("", [
+      { value: member.displayName, kind: "person" },
+      { value: member.cloudUserId, kind: "private" },
+      ...member.channels.map((channel) => ({ value: channel.address, kind: "private" })),
+      ...member.facts
+        .filter((fact) => fact.scope === "agent_private")
+        .map((fact) => ({ value: fact.value, kind: "private" })),
+      ...historicalPrivateFacts.map((fact) => ({ value: fact.value, kind: "private" })),
+    ]);
+    result = await scrubNetworkProjection(
+      session.substituteRecordsInValue(normalized),
+      `${host.domain.options.networkId}:staff-experience`,
+    );
+    assertReplayLog([{ ...member, facts: [...member.facts, ...historicalPrivateFacts] }], result);
+  }
+  const keyword = input.keyword?.toLowerCase();
+  result.rows = result.rows.filter((row) => {
+    const at = row.fields.at;
+    return (
+      (typeof at === "string"
+        ? (!input.startAt || at >= input.startAt) && (!input.endAt || at < input.endAt)
+        : !input.startAt && !input.endAt) &&
+      (!input.channel || row.fields.channel === input.channel) &&
+      (!keyword || JSON.stringify(row).toLowerCase().includes(keyword))
+    );
+  });
+  if ((await host.domain.getMember({ type: "system" }, member.memberId)).accountState === "removed")
+    throw new NetworkDomainError("NETWORK_FORBIDDEN", "Member was removed during the read");
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "record_event",
+      requestId: `experience-read:${crypto.randomUUID()}`,
+      kind: "staff_experience_read",
+      memberIds: [member.memberId],
+      opportunityId: null,
+      details: {
+        staffUserId: actor.type === "staff" ? actor.userId : "system",
+        raw: !!input.purpose,
+        startAt: input.startAt,
+        endAt: input.endAt,
+        channel: input.channel,
+      },
+    },
+  );
+  return result;
+}
diff --git a/packages/cloud/shared/src/lib/network/workbench/health-alerts.integration.test.ts b/packages/cloud/shared/src/lib/network/workbench/health-alerts.integration.test.ts
