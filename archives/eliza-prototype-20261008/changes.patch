+++ b/packages/ui/src/network/NetworkPipeline.tsx
@@ -0,0 +1,71 @@
+import { useId, useState } from "react";
+import type { NetworkAction, NetworkRow } from "./api";
+import { NetworkActionButtons } from "./NetworkActionButtons";
+
+/** Groups only the server's authoritative status; it grants no transition authority. */
+export function NetworkPipeline({
+  rows,
+  onChoose,
+}: {
+  rows: NetworkRow[];
+  onChoose: (action: NetworkAction) => void;
+}) {
+  const [query, setQuery] = useState("");
+  const label = useId();
+  const statuses = [...new Set(rows.map((row) => row.status ?? "Unspecified"))];
+  const filtered = rows.filter(
+    (row) =>
+      !query ||
+      `${row.title} ${row.subtitle ?? ""}`
+        .toLowerCase()
+        .includes(query.toLowerCase()),
+  );
+  return (
+    <section className="nw-pipeline" aria-labelledby={label}>
+      <h2 id={label}>Pipeline by current state</h2>
+      <div className="nw-field">
+        <label htmlFor={`${label}-search`}>Find an opportunity</label>
+        <input
+          id={`${label}-search`}
+          type="search"
+          value={query}
+          onChange={(event) => setQuery(event.target.value)}
+        />
+      </div>
+      <div className="nw-pipeline-columns">
+        {statuses.map((status) => {
+          const items = filtered.filter(
+            (row) => (row.status ?? "Unspecified") === status,
+          );
+          return (
+            <section
+              className="nw-pipeline-column"
+              key={status}
+              aria-label={status.replaceAll("_", " ")}
+            >
+              <h3>
+                {status.replaceAll("_", " ")}
+                <span>{items.length}</span>
+              </h3>
+              {items.map((row) => (
+                <article key={row.id}>
+                  <h4>{row.title}</h4>
+                  {row.subtitle && <p>{row.subtitle}</p>}
+                  <NetworkActionButtons
+                    actions={row.actions}
+                    onChoose={onChoose}
+                  />
+                </article>
+              ))}
+              {!items.length && (
+                <p className="nw-muted">
+                  No opportunities in this state match your search.
+                </p>
+              )}
+            </section>
+          );
+        })}
+      </div>
+    </section>
+  );
+}
