+import {
+  type IAgentRuntime,
+  type IDatabaseAdapter,
+  type Memory,
+  stringToUuid,
+} from "@elizaos/core";
+import {
+  type CarveOutDatabase,
+  type CarveOutSqlExecutor,
+  createDrizzleCarveOutDatabase,
+  sqlQuote,
+} from "@elizaos/plugin-sql";
+import { MemoryStore, type StoreContext } from "@elizaos/plugin-sql/memory-store";
+import { networkConversationIdentity } from "../agent/service.ts";
+import { networkDigest } from "../digest.ts";
+import { NetworkDomain } from "../domain/service.ts";
+import { NetworkDomainError, type NetworkMember } from "../domain/types.ts";
+import {
+  matchingConfigFromSettings,
+  type NetworkMatchingRequest,
+  projectMatchingInput,
+} from "./domain-projection.ts";
+import { shared, tags } from "./eligibility.ts";
+import { createMatchingGraph, warmPath } from "./graph.ts";
+import type { CandidateRetrievalProvider } from "./providers.ts";
+import type { MatchingConfig, MatchingInput, MatchMember } from "./types.ts";
+
+const facetTable = "network.matching.facets",
+  intentTable = "network.matching.intents";
+const fixtureSpace = "network-authored-fixture-384-v1";
+export interface NetworkRetrievalHost {
+  domain: NetworkDomain;
+  adapter: Pick<
+    IDatabaseAdapter,
+    "db" | "getRoomsByIds" | "ensureEmbeddingSpace" | "getMemories" | "searchMemories"
+  >;
+  db: CarveOutDatabase;
+  runtime: Pick<IAgentRuntime, "agentId">;
+  native: {
+    graphEdges(execute: CarveOutSqlExecutor, memberIds: string[]): Promise<MatchingInput["edges"]>;
+  };
+}
+function sources(member: Pick<NetworkMember, "facts" | "intents">, now: number) {
+  return [
+    ...member.facts
+      .filter(
+        (fact) =>
+          fact.status === "confirmed" &&
+          fact.scope !== "agent_private" &&
+          (!fact.validFrom || Date.parse(fact.validFrom) <= now) &&
+          (!fact.validTo || Date.parse(fact.validTo) > now),
+      )
+      .map((fact) => ({
+        id: fact.id,
+        kind: "facet" as const,
+        fingerprint: networkDigest({ ...fact, sourceRef: "" }),
+      })),
+    ...member.intents
+      .filter((intent) => intent.status === "active" && Date.parse(intent.expiresAt) > now)
+      .map((intent) => ({
+        id: intent.id,
+        kind: "intent" as const,
+        fingerprint: networkDigest(intent),
+      })),
+  ];
+}
+
+function pointerMetadata(memory: Memory) {
+  const value = memory.metadata;
+  if (
+    !value ||
+    !("networkId" in value) ||
+    typeof value.networkId !== "string" ||
+    !("memberId" in value) ||
+    typeof value.memberId !== "string" ||
+    !("sourceId" in value) ||
+    typeof value.sourceId !== "string" ||
+    !("sourceKind" in value) ||
+    (value.sourceKind !== "facet" && value.sourceKind !== "intent") ||
+    !("sourceFingerprint" in value) ||
+    typeof value.sourceFingerprint !== "string"
+  )
+    return null;
+  return {
+    networkId: value.networkId,
+    memberId: value.memberId,
+    sourceId: value.sourceId,
+    sourceKind: value.sourceKind,
+    sourceFingerprint: value.sourceFingerprint,
+  };
+}
+
+/** Authored vectors qualify the existing vector index plumbing, never semantic model quality. */
+export async function indexAuthoredMatchingVector(
+  host: NetworkRetrievalHost,
+  input: {
+    memberId: string;
+    sourceId: string;
+    kind: "facet" | "intent";
+    vector: number[];
+  },
+) {
+  const networkId = host.domain.options.networkId;
+  if (
+    !/^(test:|simulation:)/.test(networkId) ||
+    input.vector.length !== 384 ||
+    input.vector.some((value) => !Number.isFinite(value)) ||
+    !input.vector.some((value) => value !== 0)
+  )
+    throw new Error(
+      "Authored matching vectors require an isolated fixture and a finite nonzero 384-dimensional vector",
+    );
+  const identity = networkConversationIdentity(networkId, input.memberId);
+  if (!(await host.adapter.getRoomsByIds([identity.roomId]))?.length)
+    throw new Error("Authored index requires the already-owned native private conversation room");
+  if (!host.adapter.ensureEmbeddingSpace)
+    throw new Error("Canonical embedding-space owner unavailable");
+  await host.adapter.ensureEmbeddingSpace(fixtureSpace);
+  const database = host.adapter.db as ReturnType<StoreContext["getDb"]>;
+  return database.transaction(async (transaction) => {
+    const carve = await createDrizzleCarveOutDatabase(transaction);
+    const joined = new NetworkDomain({
+      ...host.domain.options,
+      db: { execute: carve.execute, transaction: (work) => work(carve.execute) },
+    });
+    return joined.withAuthority(async (domain) => {
+      const member = await domain.getMember({ type: "system" }, input.memberId);
+      if (member.accountState !== "active" || member.age !== "adult" || member.safetyHold)
+        throw new Error("Current eligible source owner required for authored indexing");
+      const source = sources(member, host.domain.options.clock.now().getTime()).find(
+        (source) => source.kind === input.kind && source.id === input.sourceId,
+      );
+      if (!source) throw new Error("Current confirmed purpose-limited matching source required");
+      const store = new MemoryStore({
+        agentId: host.runtime.agentId,
+        getDb: () => transaction,
+        getEmbeddingDimension: () => "dim384",
+        getEmbeddingSpace: () => fixtureSpace,
+        withRetry: (operation) => operation(),
+        withIsolationContext: (_entity, operation) => operation(transaction),
+      });
+      const memory: Memory = {
+        id: stringToUuid(networkDigest([networkId, input.memberId, source])),
+        agentId: host.runtime.agentId,
+        entityId: identity.entityId,
+        roomId: identity.roomId,
+        worldId: identity.worldId,
+        createdAt: host.domain.options.clock.now().getTime(),
+        unique: true,
+        embedding: input.vector,
+        content: { text: `Matching source pointer ${source.fingerprint}` },
+        metadata: {
+          type: "custom",
+          networkId,
+          memberId: input.memberId,
+          sourceId: source.id,
+          sourceKind: source.kind,
+          sourceFingerprint: source.fingerprint,
+          qualification: "authored_fixture_vector",
+        },
+      };
+      return store.create(memory, source.kind === "facet" ? facetTable : intentTable);
+    });
+  });
+}
+
+/** Revoke source pointers in the same native lifecycle transaction; the memory FK owns embedding deletion. */
+export async function invalidateMatchingPointers(
+  execute: CarveOutSqlExecutor,
+  networkId: string,
+  agentId: NetworkRetrievalHost["runtime"]["agentId"],
+  member: NetworkMember,
+  now: number,
+) {
+  const identity = networkConversationIdentity(networkId, member.memberId),
+    fingerprints = sources(member, now).map((source) => source.fingerprint);
+  await execute(`DELETE FROM memories WHERE agent_id=${sqlQuote(agentId)} AND room_id=${sqlQuote(identity.roomId)} AND entity_id=${sqlQuote(identity.entityId)}
+    AND type IN (${sqlQuote(facetTable)},${sqlQuote(intentTable)}) AND metadata->>'networkId'=${sqlQuote(networkId)}
+    AND metadata->>'memberId'=${sqlQuote(member.memberId)} ${fingerprints.length ? `AND COALESCE(metadata->>'sourceFingerprint','') NOT IN (${fingerprints.map(sqlQuote).join(",")})` : ""}`);
+}
+
+/** SQL hard selection precedes native scoped HNSW, graph, tag and known-availability channels. */
+export async function createNetworkCandidateRetrieval(
+  host: NetworkRetrievalHost,
+  request: NetworkMatchingRequest,
+): Promise<
+  CandidateRetrievalProvider & {
+    eligibleMemberIds: string[];
+    inputRevisions: Record<string, number>;
+    config: MatchingConfig;
+    settingsRevision: number;
+  }
+> {
+  const now = host.domain.options.clock.now().getTime(),
+    networkId = host.domain.options.networkId;
+  if (request.requester)
+    await host.domain.assertMatchingRequester({ type: "system" }, request.requester);
+  const requester = request.requester ? ` OR id=${sqlQuote(request.requester.memberId)}` : "";
+  const rows =
+    await host.db.execute(`SELECT id FROM network.members m WHERE network_id=${sqlQuote(networkId)}
+    AND payload->>'age'='adult' AND payload->>'accountState'='active' AND COALESCE(payload->>'safetyHold','false')='false'
+    AND ((payload->>'participation'<>'paused' AND payload#>>'{preferences,proactiveOptIn}'='true' AND payload#>>'{preferences,onlyWhenAsked}'='false'
+    AND EXISTS(SELECT 1 FROM jsonb_array_elements(payload->'channels') c WHERE c->>'channel' IN ('sms','imessage') AND c->>'stopped'='false' AND c->>'verifiedAt'<=${sqlQuote(new Date(now).toISOString())}))${requester})
+    AND EXISTS(SELECT 1 FROM jsonb_array_elements(payload->'presence') p WHERE p->>'city'=${sqlQuote(request.city)} AND p->>'startsAt'<${sqlQuote(request.endAt)} AND (p->>'endsAt' IS NULL OR p->>'endsAt'>${sqlQuote(request.startAt)})) ORDER BY id LIMIT 2001`);
+  if (rows.length > 2000)
+    throw new Error("Native local retrieval exceeds the qualified 2000-member city bound");
+  const eligibleMemberIds = rows.map((row) => String(row.id));
+  const snapshot = await host.domain.engineSnapshot(
+    { type: "system" },
+    { memberIds: eligibleMemberIds },
+  );
+  const settings = await host.domain.getSettings({ type: "system" });
+  const config = matchingConfigFromSettings(settings);
+  const input = projectMatchingInput(snapshot, request, now, config, settings);
+  input.edges = await host.native.graphEdges(host.db.execute, eligibleMemberIds);
+  const graph = createMatchingGraph(input),
+    byId = new Map(input.members.map((member) => [member.memberId, member]));
+  const currentSources = new Map(
+    snapshot.members.map((member) => [member.memberId, sources(member, now)]),
+  );
+  const pointers = new Map<string, Memory[]>();
+  const authorizedRoomIds = input.members.map(
+    (member) => networkConversationIdentity(networkId, member.memberId).roomId,
+  );
+  if (authorizedRoomIds.length) {
+    const retained = (
+      await Promise.all(
+        [facetTable, intentTable].map((tableName) =>
+          host.adapter.getMemories({
+            agentId: host.runtime.agentId,
+            tableName,
+            count: 20001,
+            includeEmbedding: true,
+            metadata: { networkId },
+            accessContext: { requesterEntityId: host.runtime.agentId, authorizedRoomIds },
+          }),
+        ),
+      )
+    ).flat();
+    if (retained.length > 20000)
+      throw new Error("Authored native index exceeds the qualified 20000-pointer batch bound");
+    for (const memory of retained) {
+      const memberId = pointerMetadata(memory)?.memberId;
+      if (typeof memberId !== "string" || !currentPointer(memory, memberId)) continue;
+      const records = pointers.get(memberId) ?? [];
+      records.push(memory);
+      pointers.set(memberId, records);
+    }
+  }
+  function currentPointer(memory: Memory, memberId: string) {
+    const metadata = pointerMetadata(memory),
+      identity = networkConversationIdentity(networkId, memberId);
+    return (
+      memory.agentId === host.runtime.agentId &&
+      memory.entityId === identity.entityId &&
+      memory.roomId === identity.roomId &&
+      metadata &&
+      metadata.networkId === networkId &&
+      metadata.memberId === memberId &&
+      currentSources
+        .get(memberId)
+        ?.some(
+          (source) =>
+            source.id === metadata.sourceId &&
+            source.kind === metadata.sourceKind &&
+            source.fingerprint === metadata.sourceFingerprint,
+        )
+    );
+  }
+  const retrievePrepared = async ({
+    member,
+    eligibleMemberIds: allowed,
+    limitPerChannel,
+    window,
+  }: Parameters<CandidateRetrievalProvider["retrieve"]>[0]) => {
+    const eligible = allowed
+      .map((id) => byId.get(id))
+      .filter(
+        (peer): peer is MatchMember =>
+          peer !== undefined &&
+          peer.memberId !== member.memberId &&
+          !member.blockedIds.includes(peer.memberId) &&
+          !peer.blockedIds.includes(member.memberId),
+      );
+    const allowedIds = new Set(eligible.map((peer) => peer.memberId));
+    const authorizedRoomIds = eligible.map(
+      (peer) => networkConversationIdentity(networkId, peer.memberId).roomId,
+    );
+    const queries = (pointers.get(member.memberId) ?? []).filter(
+      (memory) =>
+        pointerMetadata(memory)?.sourceKind === "intent" && memory.embedding?.length === 384,
+    );
+    const vector = async (tableName: string) => {
+      const ids: string[] = [];
+      if (!authorizedRoomIds.length) return ids;
+      for (const query of queries) {
+        const memories = await host.adapter.searchMemories({
+          tableName,
+          embedding: query.embedding ?? [],
+          match_threshold: 0.7,
+          count: limitPerChannel,
+          accessContext: { requesterEntityId: host.runtime.agentId, authorizedRoomIds },
+          includeEmbedding: false,
+        });
+        for (const memory of memories) {
+          const id = pointerMetadata(memory)?.memberId;
+          if (
+            typeof id === "string" &&
+            allowedIds.has(id) &&
+            currentPointer(memory, id) &&
+            !ids.includes(id)
+          )
+            ids.push(id);
+        }
+      }
+      return ids.slice(0, limitPerChannel);
+    };
+    const memberTags = tags(member, now),
+      matchingTags = eligible.filter((peer) => shared(memberTags, tags(peer, now)).length > 0);
+    matchingTags.sort(
+      (a, b) =>
+        shared(memberTags, tags(b, now)).length - shared(memberTags, tags(a, now)).length ||
+        a.recentExposure - b.recentExposure ||
+        a.memberId.localeCompare(b.memberId),
+    );
+    const reserve = Math.ceil(limitPerChannel * 0.25),
+      primary = matchingTags.slice(0, limitPerChannel - reserve),
+      exploration = matchingTags
+        .filter((peer) => !primary.includes(peer))
+        .sort((a, b) => a.recentExposure - b.recentExposure || a.memberId.localeCompare(b.memberId))
+        .slice(0, reserve);
+    return {
+      vectorIntentFacet: await vector(facetTable),
+      vectorIntentIntent: await vector(intentTable),
+      graphTwoHop: eligible
+        .filter((peer) => warmPath(graph, member.memberId, peer.memberId))
+        .slice(0, limitPerChannel)
+        .map((peer) => peer.memberId),
+      tags: [...primary, ...exploration].map((peer) => peer.memberId),
+      availability: eligible
+        .filter(
+          (peer) =>
+            peer.availabilityCoverage === "complete" &&
+            member.availabilityCoverage === "complete" &&
+            member.availability.some((a) =>
+              peer.availability.some(
+                (b) =>
+                  Math.max(a.start, b.start, window.start) < Math.min(a.end, b.end, window.end),
+              ),
+            ),
+        )
+        .sort((a, b) => a.recentExposure - b.recentExposure || a.memberId.localeCompare(b.memberId))
+        .slice(0, limitPerChannel)
+        .map((peer) => peer.memberId),
+    };
+  };
+  const inputRevisions = Object.fromEntries(
+    snapshot.members.map((member) => [member.memberId, member.revision]),
+  );
+  const prepared = new Map<string, Awaited<ReturnType<CandidateRetrievalProvider["retrieve"]>>>();
+  for (const member of input.members)
+    prepared.set(
+      member.memberId,
+      await retrievePrepared({
+        member,
+        eligibleMemberIds,
+        city: request.city,
+        window: input.window,
+        limitPerChannel: 50,
+      }),
+    );
+  return {
+    version: "native_sql_five_channel_v1_authored_vectors_only",
+    eligibleMemberIds,
+    inputRevisions,
+    config,
+    settingsRevision: settings.revision,
+    async retrieve({ member, eligibleMemberIds: allowed, limitPerChannel }) {
+      if (inputRevisions[member.memberId] !== member.profileRevision)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Prepared native retrieval member changed",
+          { rule: "matching_retrieval_changed" },
+        );
+      const channels = prepared.get(member.memberId);
+      if (!channels) throw new Error("Native SQL selection did not prepare this member");
+      const permitted = new Set(allowed);
+      return {
+        vectorIntentFacet: channels.vectorIntentFacet
+          .filter((id) => permitted.has(id))
+          .slice(0, limitPerChannel),
+        vectorIntentIntent: channels.vectorIntentIntent
+          .filter((id) => permitted.has(id))
+          .slice(0, limitPerChannel),
+        graphTwoHop: channels.graphTwoHop
+          .filter((id) => permitted.has(id))
+          .slice(0, limitPerChannel),
+        tags: channels.tags.filter((id) => permitted.has(id)).slice(0, limitPerChannel),
+        availability: channels.availability
+          .filter((id) => permitted.has(id))
+          .slice(0, limitPerChannel),
+      };
+    },
+  };
+}
