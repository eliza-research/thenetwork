+    { ...blind, id: "duplicate-label" },
+  ]);
+  expect(summary.primaryLabels).toBe(2);
+  expect(summary.blindLabels).toBe(3);
+  expect(summary.agreement).toMatchObject({
+    numerator: 1,
+    denominator: 2,
+    rate: 0.5,
+    unmatchedBlindLabels: 1,
+    selfBlindLabelsExcluded: 1,
+    duplicateBlindLabelsExcluded: 1,
