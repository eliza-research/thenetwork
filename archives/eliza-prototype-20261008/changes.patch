+      actor,
+      input.opportunityId,
+      input.revision,
+      input.requestId,
+      input,
+      async (domain, record, opportunity, _id, members) => {
+        assertKnownDisclosure(members, `${input.area} ${input.venue ?? ""}`);
+        const venueRisk = networkSafetyClass(
+          `${input.area} ${input.venue ?? ""}`,
+          opportunity.category,
+        );
+        if (
+          venueRisk === "high" ||
+          (venueRisk === "medium" &&
+            !(
+              opportunity.kind === "help" &&
+              opportunity.requiresHomeEntry &&
+              opportunity.safetyClass === "medium"
+            ))
+        )
+          denied(
+            "Home and high-risk venue logistics need the matching safety policy",
+            "NETWORK_SAFETY",
+          );
+        if (
+          input.venue &&
+          members.some(
+            (member) =>
+              !opportunity.participants.find(
+                (participant) => participant.memberId === member.memberId,
+              )?.disclosure?.preciseVenue,
+          )
+        )
+          denied("Precise venue grant required from every participant", "NETWORK_SAFETY");
+        for (const member of members)
+          if (
+            !member.presence.some(
+              (presence) =>
+                presence.city === opportunity.city &&
+                Date.parse(presence.startsAt) <= start &&
+                (!presence.endsAt || Date.parse(presence.endsAt) >= end),
+            )
+          )
