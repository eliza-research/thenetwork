+import type {
+  DispatchResult,
+  ScheduledTaskDispatchRecord,
+  ScheduledTaskRunner,
+} from "@elizaos/plugin-scheduling";
+import { sqlQuote } from "@elizaos/plugin-sql";
+import type { Clock } from "../../services/containers/compute-rate-governor.ts";
+import { networkDigest } from "../digest.ts";
+import { staff } from "../domain/policy.ts";
+import type { NetworkDomain } from "../domain/service.ts";
+import { payload } from "../domain/store.ts";
+import {
+  type NetworkActor,
+  type NetworkClock,
+  NetworkDomainError,
+  type NetworkEvent,
+  type NetworkSettings,
+} from "../domain/types.ts";
+import { SimClock, type SyntheticPersona } from "../evaluation/fixtures.ts";
+import { runNetworkSimulation, type SimulationTransport } from "../evaluation/simulator.ts";
+import { DEFAULT_MATCHING_CONFIG } from "../matching/config.ts";
+import { matchingConfigFromSettings } from "../matching/domain-projection.ts";
+import type { MatchingConfig } from "../matching/types.ts";
+import { localAdminView } from "./application-views.ts";
+import type { createLocalNetworkHost } from "./host.ts";
+
+export interface NetworkLabConfig {
+  personaCount: number;
+  days: number;
+  seed: string;
+  timeMode: "discrete_event" | "accelerated" | "real_time";
+  personaMix: Record<SyntheticPersona["kind"], number>;
+  engineVersion: string;
+}
+export const DEFAULT_PERSONA_MIX: NetworkLabConfig["personaMix"] = {
+  newcomer: 1,
+  parent: 1,
+  connector: 1,
+  introvert: 1,
+  active: 1,
+  unresponsive: 1,
+  adversarial: 1,
+};
+const SYSTEM = { type: "system" } as const;
+
+/** A retained run is an immutable event reference; Clock owns each execution attempt. */
+export class NetworkSimulationLab {
+  private shuttingDown = false;
+  private readonly active = new Map<
+    string,
+    {
+      controller: AbortController;
+      world?: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+      finished: Promise<void>;
+    }
+  >();
+  constructor(
+    readonly options: {
+      domain: NetworkDomain;
+      scheduler: ScheduledTaskRunner;
+      clock: NetworkClock;
+      wallClock: Clock;
+      createWorld: (input: {
+        runId: string;
+        attempt: number;
+        networkId: string;
+        clock: SimClock;
+      }) => Promise<Awaited<ReturnType<typeof createLocalNetworkHost>>>;
+      transport: (
+        world: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+        clock: SimClock,
+      ) => SimulationTransport | Promise<SimulationTransport>;
+    },
+  ) {}
+
+  private async events(runId?: string) {
+    return (
+      await this.options.domain.options.db.execute(
+        `SELECT payload,sequence FROM network.events WHERE network_id=${sqlQuote(this.options.domain.options.networkId)} AND payload->>'kind' LIKE 'simulation_%'${runId ? ` AND payload->'details'->>'runId'=${sqlQuote(runId)}` : ""} ORDER BY sequence`,
+      )
+    ).map((row) => ({ ...payload<NetworkEvent>(row), sequence: Number(row.sequence) }));
+  }
+
+  async enqueue(actor: NetworkActor, input: NetworkLabConfig & { requestId: string }) {
+    staff(actor, ["engineer"]);
+    if (this.shuttingDown)
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Simulation lab is shutting down");
+    if (
+      !input.requestId ||
+      input.requestId.length > 120 ||
+      !Number.isSafeInteger(input.personaCount) ||
+      input.personaCount < 1 ||
+      input.personaCount > 2000 ||
+      !Number.isSafeInteger(input.days) ||
+      input.days < 1 ||
+      input.days > 365 ||
+      typeof input.seed !== "string" ||
+      !input.seed ||
+      input.seed.length > 120 ||
+      !["discrete_event", "accelerated", "real_time"].includes(input.timeMode) ||
+      input.engineVersion !== DEFAULT_MATCHING_CONFIG.version
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "Bounded world config and the available local engine version are required",
+      );
+    if (
+      !input.personaMix ||
+      Object.keys(input.personaMix).some((kind) => !Object.hasOwn(DEFAULT_PERSONA_MIX, kind)) ||
+      Object.keys(DEFAULT_PERSONA_MIX).some((kind) => {
+        const value = input.personaMix[kind as SyntheticPersona["kind"]];
+        return typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 100;
+      }) ||
+      !Object.values(input.personaMix).some((value) => value > 0)
+    )
+      throw new NetworkDomainError("NETWORK_INVALID", "A nonempty bounded persona mix is required");
+    const { requestId, ...config } = input;
+    const runId = `lab:${networkDigest([this.options.domain.options.networkId, requestId])}`;
+    const configDigest = networkDigest(config);
+    await this.options.domain.withAuthority(async (domain) => {
+      const previous = (
+        await domain.options.db.execute(
+          `SELECT payload FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)} AND id=${sqlQuote(`lab-queued:${runId}`)}`,
+        )
+      )[0];
+      if (previous) {
+        if (payload<NetworkEvent>(previous).details.configDigest !== configDigest)
+          throw new NetworkDomainError(
+            "NETWORK_IDEMPOTENCY",
+            "A retained run identity cannot change its config",
+          );
+        return;
+      }
+      const settings = await domain.getSettings(SYSTEM);
+      // The existing runner admits fixture cities after seeding their committed adults.
+      const engineSettings: NetworkSettings = {
+        ...settings,
+        proactiveCities: { SF: false, NYC: false },
+      };
+      const engineConfig = matchingConfigFromSettings(engineSettings);
+      const startAt = this.options.clock.now().toISOString();
+      await domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `lab-queued:${runId}`,
+        kind: "simulation_queued",
+        memberIds: [],
+        opportunityId: null,
+        details: {
+          runId,
+          config,
+          configDigest,
+          engineConfig,
+          engineSettings,
+          engineSettingsDigest: networkDigest(engineSettings),
+          startAt,
+          dataDigest: networkDigest([
+            config.personaCount,
+            config.days,
+            config.seed,
+            config.personaMix,
+            startAt,
+          ]),
+          requestedBy: actor,
+        },
+      });
+    });
+    await this.scheduleAttempt(runId, 1);
+    return this.read(actor, runId);
+  }
+
+  private async scheduleAttempt(runId: string, attempt: number) {
+    return this.options.scheduler.schedule({
+      kind: "custom",
+      trigger: { kind: "once", atIso: this.options.clock.now().toISOString() },
+      priority: "low",
+      promptInstructions:
+        "Run the exact retained isolated Network world through its native owners.",
+      respectsGlobalPause: false,
+      source: "plugin",
+      createdBy: "network",
+      ownerVisible: false,
+      metadata: {
+        network: {
+          scope: "simulation_lab",
+          networkId: this.options.domain.options.networkId,
+          runId,
+          attempt,
+        },
+      },
+      output: { destination: "channel", target: "network-local-lab" },
+      idempotencyKey: `network:${networkDigest(this.options.domain.options.networkId)}:${runId}:attempt:${attempt}`,
+    });
+  }
+
+  async dispatch(record: ScheduledTaskDispatchRecord): Promise<DispatchResult> {
+    const binding = record.metadata?.network as
+      | { scope?: string; networkId?: string; runId?: string; attempt?: number }
+      | undefined;
+    if (
+      binding?.scope !== "simulation_lab" ||
+      binding.networkId !== this.options.domain.options.networkId ||
+      !binding.runId ||
+      !Number.isSafeInteger(binding.attempt) ||
+      (binding.attempt ?? 0) < 1
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Own retained simulation task required");
+    const runId = binding.runId,
+      attempt = binding.attempt as number;
+    const events = await this.events(runId);
+    if (
+      events.some(
+        (event) => event.kind === "simulation_cancelled" || event.kind === "simulation_completed",
+      )
+    )
+      return { ok: true, metadata: { runId, suppressed: "terminal_run" } };
+    const queued = events.find((event) => event.kind === "simulation_queued");
+    if (!queued)
+      throw new NetworkDomainError("NETWORK_NOT_FOUND", "Retained run config unavailable");
+    if (this.shuttingDown)
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Simulation lab is shutting down");
+    if (this.active.has(runId))
+      throw new NetworkDomainError("NETWORK_CONFLICT", "A world attempt is already active");
+    const config = queued.details.config as unknown as NetworkLabConfig;
+    const clock = new SimClock(Date.parse(String(queued.details.startAt)));
+    const networkId = `simulation:${networkDigest([this.options.domain.options.networkId, runId, attempt])}`;
+    const controller = new AbortController();
+    let finish!: () => void;
+    const finished = new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+    const active: {
+      controller: AbortController;
+      world?: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+      finished: Promise<void>;
+    } = { controller, finished };
+    this.active.set(runId, active);
+    try {
+      const savedSettings = queued.details.engineSettings as unknown as NetworkSettings | undefined;
+      if (!savedSettings)
+        throw new NetworkDomainError(
+          "NETWORK_EXPIRED",
+          "Retained native world settings are unavailable; launch a new run",
+        );
+      await this.options.domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `lab-started:${runId}:${attempt}`,
+        kind: "simulation_attempt_started",
+        memberIds: [],
+        opportunityId: null,
+        details: {
+          runId,
+          attempt,
+          networkId,
+          startedAt: this.options.clock.now().toISOString(),
+          configDigest: queued.details.configDigest,
+        },
+      });
+      const world = await this.options.createWorld({ runId, attempt, networkId, clock });
+      active.world = world;
+      if (controller.signal.aborted)
+        throw new NetworkDomainError("NETWORK_CONFLICT", "World attempt cancelled");
+      const { revision: _savedRevision, ...settings } = savedSettings;
+      const currentSettings = await world.domain.getSettings(SYSTEM);
+      await world.domain.command(SYSTEM, {
+        type: "configure",
+        requestId: `lab-world-settings:${runId}:${attempt}`,
+        expectedRevision: currentSettings.revision,
+        settings,
+      });
+      if (controller.signal.aborted)
+        throw new NetworkDomainError("NETWORK_CONFLICT", "World attempt cancelled");
+      const wallStart = this.options.wallClock.now(),
+        simulationStart = clock.now().getTime();
+      const report = await runNetworkSimulation({
+        domain: world.domain,
+        coordination: world.coordination,
+        clock,
+        seed: parseInt(networkDigest(config.seed).slice(0, 8), 16),
+        personaCount: config.personaCount,
+        days: config.days,
+        config: queued.details.engineConfig as unknown as MatchingConfig,
+        personaMix: config.personaMix,
+        transport: await this.options.transport(world, clock),
+        drainDue: world.drainDue,
+        graphEdges: (memberIds) => world.native.graphEdges(world.db.execute, memberIds),
+        advanceTo: async (instant) => {
+          const target = typeof instant === "string" ? Date.parse(instant) : instant;
+          const divisor =
+            config.timeMode === "real_time"
+              ? 1
+              : config.timeMode === "accelerated"
+                ? 1440
+                : Infinity;
+          const wallDue = wallStart + (target - simulationStart) / divisor;
+          while (wallDue > this.options.wallClock.now()) {
+            if (controller.signal.aborted)
+              throw new NetworkDomainError("NETWORK_CONFLICT", "World attempt cancelled");
+            await this.options.wallClock.sleep(
+              Math.min(1000, wallDue - this.options.wallClock.now()),
+            );
+          }
+          if (
+            controller.signal.aborted ||
+            (await this.events(runId)).some((event) => event.kind === "simulation_cancelled")
+          )
+            throw new NetworkDomainError("NETWORK_CONFLICT", "World attempt cancelled");
+          clock.advanceTo(target);
+        },
+        progress: async (progress) => {
+          await this.options.domain.command(SYSTEM, {
+            type: "record_event",
+            requestId: `lab-progress:${runId}:${attempt}:${progress.day}`,
+            kind: "simulation_progress",
+            memberIds: [],
+            opportunityId: null,
+            details: {
+              runId,
+              attempt,
+              networkId,
+              ...progress,
+              simulatedAt: clock.now().toISOString(),
+            },
+          });
+        },
+      });
+      await this.options.domain.withAuthority(async (domain) => {
+        if (
+          controller.signal.aborted ||
+          (
+            await domain.options.db.execute(
+              `SELECT id FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)} AND payload->>'kind'='simulation_cancelled' AND payload->'details'->>'runId'=${sqlQuote(runId)} LIMIT 1`,
+            )
+          ).length
+        )
+          throw new NetworkDomainError("NETWORK_CONFLICT", "World attempt cancelled");
+        await domain.command(SYSTEM, {
+          type: "record_event",
+          requestId: `lab-completed:${runId}`,
+          kind: "simulation_completed",
+          memberIds: [],
+          opportunityId: null,
+          details: {
+            runId,
+            attempt,
+            networkId,
+            dataDigest: queued.details.dataDigest,
+            configDigest: queued.details.configDigest,
+            report: {
+              seed: report.seed,
+              personaCount: report.personaCount,
+              days: report.days,
+              runDigest: report.runDigest,
+              startAt: report.startAt,
+              endAt: report.endAt,
+              counts: report.counts,
+              metrics: report.metrics,
+              scenarios: report.scenarios,
+              qualification: report.qualification,
+              matchingRunIds: report.matchingRuns.map((run) => run.runId),
+            },
+          },
+        });
+      });
+      return { ok: true, metadata: { runId, attempt, runDigest: report.runDigest } };
+    } catch (error) {
+      await this.options.domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `lab-ended:${runId}:${attempt}`,
+        kind: controller.signal.aborted
+          ? "simulation_attempt_cancelled"
+          : "simulation_attempt_failed",
+        memberIds: [],
+        opportunityId: null,
+        details: {
+          runId,
+          attempt,
+          networkId,
+          reason: controller.signal.aborted ? "cancelled" : "runner_error",
+          errorCode: error instanceof NetworkDomainError ? error.code : "local_runner_failed",
+        },
+      });
+      if (controller.signal.aborted)
+        return { ok: true, metadata: { runId, attempt, cancelled: true } };
+      throw error;
+    } finally {
+      try {
+        await active.world?.close();
+      } finally {
+        this.active.delete(runId);
+        finish();
+      }
+    }
+  }
+
+  async shutdown() {
+    this.shuttingDown = true;
+    const attempts = [...this.active.values()];
+    for (const attempt of attempts) attempt.controller.abort();
+    await Promise.all(attempts.map((attempt) => attempt.finished));
+  }
+
+  async recover() {
+    let restarted = 0;
+    for (const run of await this.list(SYSTEM)) {
+      if (["completed", "cancelled"].includes(run.status) || this.active.has(run.runId)) continue;
+      const tasks = (await this.options.scheduler.list()).filter(
+        (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === run.runId,
+      );
+      const last = tasks
+        .sort(
+          (a, b) =>
+            Number((a.metadata?.network as { attempt?: number } | undefined)?.attempt ?? 0) -
+            Number((b.metadata?.network as { attempt?: number } | undefined)?.attempt ?? 0),
+        )
+        .at(-1);
+      if (!last || last.state.status === "scheduled") continue;
+      const attempt =
+        Number((last.metadata?.network as { attempt?: number } | undefined)?.attempt ?? 0) + 1;
+      await this.options.domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `lab-restart:${run.runId}:${attempt}`,
+        kind: "simulation_restarting_from_seed",
+        memberIds: [],
+        opportunityId: null,
+        details: {
+          runId: run.runId,
+          attempt,
+          previousAttempt: attempt - 1,
+          reason: "host_restart_or_interrupted_attempt",
+          qualification: "full_replay_new_owner_namespace_partial_attempt_retained",
+        },
+      });
+      await this.options.scheduler.apply(last.taskId, "dismiss");
+      await this.scheduleAttempt(run.runId, attempt);
+      restarted++;
+    }
+    return restarted;
+  }
+
+  async cancel(actor: NetworkActor, runId: string, requestId: string) {
+    staff(actor, ["engineer"]);
+    const current = await this.read(actor, runId);
+    if (current.status === "completed")
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Completed world cannot be cancelled");
+    await this.options.domain.command(SYSTEM, {
+      type: "record_event",
+      requestId: `lab-cancel:${networkDigest(requestId)}`,
+      kind: "simulation_cancelled",
+      memberIds: [],
+      opportunityId: null,
+      details: { runId, cancelledBy: actor },
+    });
+    this.active.get(runId)?.controller.abort();
+    for (const task of await this.options.scheduler.list())
+      if (
+        (task.metadata?.network as { runId?: string } | undefined)?.runId === runId &&
+        ["scheduled", "fired"].includes(task.state.status)
+      )
+        await this.options.scheduler.apply(task.taskId, "dismiss");
+    return this.read(actor, runId);
+  }
+
+  async read(actor: NetworkActor, runId: string) {
+    staff(actor, ["engineer"]);
+    const events = await this.events(runId);
+    const queued = events.find((event) => event.kind === "simulation_queued");
+    if (!queued)
+      throw new NetworkDomainError("NETWORK_NOT_FOUND", "Retained world run unavailable");
+    const latest = events.at(-1);
+    const completed = events.find((event) => event.kind === "simulation_completed");
+    const cancelled = events.find((event) => event.kind === "simulation_cancelled");
+    const attempt = events.filter((event) => event.kind === "simulation_attempt_started").at(-1);
+    return {
+      runId,
+      config: queued.details.config as unknown as NetworkLabConfig,
+      configDigest: String(queued.details.configDigest),
+      ...(queued.details.engineSettings
+        ? {
+            engineSettings: queued.details.engineSettings as unknown as NetworkSettings,
+            engineSettingsDigest: String(queued.details.engineSettingsDigest),
+          }
+        : {}),
+      dataDigest: String(queued.details.dataDigest),
+      startAt: String(queued.details.startAt),
+      status: completed
+        ? "completed"
+        : cancelled
+          ? "cancelled"
+          : latest?.kind === "simulation_restarting_from_seed"
+            ? "restarting_from_seed"
+            : latest?.kind === "simulation_attempt_failed"
+              ? "failed"
+              : attempt
+                ? "running"
+                : "queued",
+      attempt: Number(attempt?.details.attempt ?? 0),
+      networkId: attempt?.details.networkId,
+      progress:
+        events
+          .filter(
+            (event) =>
+              event.kind === "simulation_progress" &&
+              event.details.attempt === attempt?.details.attempt,
+          )
+          .at(-1)?.details ?? null,
+      report: completed?.details.report ?? null,
+      attempts: events
+        .filter((event) =>
+          [
+            "simulation_attempt_started",
+            "simulation_attempt_failed",
+            "simulation_attempt_cancelled",
+            "simulation_restarting_from_seed",
+          ].includes(event.kind),
+        )
+        .map((event) => ({ kind: event.kind, at: event.at, ...event.details })),
+    };
+  }
+
+  async list(actor: NetworkActor) {
+    staff(actor, ["engineer"]);
+    return Promise.all(
+      (await this.events())
+        .filter((event) => event.kind === "simulation_queued")
+        .map((event) => this.read(actor, String(event.details.runId))),
+    );
+  }
+
+  async compare(actor: NetworkActor, firstRunId: string, secondRunId: string) {
+    const [first, second] = await Promise.all([
+      this.read(actor, firstRunId),
+      this.read(actor, secondRunId),
+    ]);
+    if (!first.report || !second.report)
+      throw new NetworkDomainError(
+        "NETWORK_CONFLICT",
+        "Both completed retained reports are required",
+      );
+    const firstCounts = (first.report as { counts: Record<string, number> }).counts;
+    const secondCounts = (second.report as { counts: Record<string, number> }).counts;
+    if (
+      !firstCounts ||
+      !secondCounts ||
+      Object.keys(firstCounts).some(
+        (key) => !Number.isFinite(firstCounts[key]) || !Number.isFinite(secondCounts[key]),
+      )
+    )
+      throw new NetworkDomainError("NETWORK_INVALID", "Retained simulation counts are invalid");
+    return {
+      first,
+      second,
+      countsDelta: Object.fromEntries(
+        Object.keys(firstCounts).map((key) => [key, secondCounts[key] - firstCounts[key]]),
+      ),
+      sameData: first.dataDigest === second.dataDigest,
+      qualification:
+        first.dataDigest === second.dataDigest
+          ? "same_seed_size_duration_mix_start_with_synthetic_assumptions"
+          : "different_world_inputs_no_engine_effect_claim",
+    };
+  }
+
+  async inspectMember(actor: NetworkActor, runId: string, memberId: string) {
+    staff(actor, ["engineer"]);
+    const run = await this.read(actor, runId);
+    if (!run.attempt || typeof run.networkId !== "string")
+      throw new NetworkDomainError("NETWORK_NOT_FOUND", "World has not started");
+    const activeAttempt = this.active.get(runId);
+    if (activeAttempt && !activeAttempt.world)
+      throw new NetworkDomainError("NETWORK_CONFLICT", "World initialization is still in progress");
+    const active = activeAttempt?.world;
+    const world =
+      active ??
+      (await this.options.createWorld({
+        runId,
+        attempt: run.attempt,
+        networkId: run.networkId,
+        clock: new SimClock(
+          Date.parse(
+            String(
+              (run.report as { endAt?: string } | null)?.endAt ??
+                (run.progress as { simulatedAt?: string } | null)?.simulatedAt ??
+                run.startAt,
+            ),
+          ),
+        ),
+      }));
+    try {
+      const perspective = await localAdminView(
+        world,
+        actor,
+        new URLSearchParams({ module: "perspective", memberId }),
+      );
+      return { environment: "retained_simulation", runId, attempt: run.attempt, perspective };
+    } finally {
+      if (!active) await world.close();
+    }
+  }
+}
