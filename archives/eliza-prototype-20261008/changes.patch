+        id: member.memberId,
+        title:
+          snapshot.members.find((row) => row.memberId === member.memberId)?.displayName ?? "Member",
+        fields: member,
+      }));
+      result.rows.push({
+        id: "concentration",
+        title: "Exposure and contextual contribution",
+        fields: { ...analysis.fairness, members: undefined },
+      });
+    }
+    result.metrics = [
+      { label: "Snapshot members", value: analysis.graph.nodes.length },
+      { label: "Source", value: retained ? retained.exportId : "isolated local snapshot" },
+    ];
+    const filters = [
+      commandField("city", "City", "select", city ?? "", ["", "SF", "NYC"]),
+      commandField("cohort", "Cohort", "select", cohort ?? "", [
+        "",
+        "newcomer",
+        "established",
+        "receiving",
+      ]),
+      commandField("startAt", "From (UTC ISO)", "text", startAt),
+      commandField("endAt", "Until (UTC ISO, exclusive)", "text", endAt),
+      commandField("generator", "Generator", "text", parameters.get("generator") ?? ""),
+      commandField("exploration", "Exploration", "select", exploration ?? "", [
+        "",
+        "true",
+        "false",
+      ]),
+      commandField("neighborhood", "Neighborhood", "text", parameters.get("neighborhood") ?? ""),
+      commandField(
+        "inviterCluster",
+        "Inviter cluster",
+        "text",
+        parameters.get("inviterCluster") ?? "",
+      ),
+    ].map((field) => ({ ...field, required: false }));
+    if (module === "graph")
+      filters.push({
+        ...commandField("edgeType", "Edge type", "text", parameters.get("edgeType") ?? ""),
+        required: false,
+      });
+    result.actions.unshift(commandAction("filter_admin", "Filter this view", {}, filters));
+  }
+  await composeOperationsView(host, actor, parameters, result, operations);
+  for (const row of result.rows) {
+    const id =
+      typeof row.fields.memberId === "string"
+        ? row.fields.memberId
+        : snapshot.members.some((member) => member.memberId === row.id)
+          ? row.id
+          : null;
+    if (id)
+      row.actions = [
+        ...(row.actions ?? []),
+        commandAction("navigate_admin", "Member timeline", { module: "perspective", memberId: id }),
+        commandAction("navigate_admin", "Member 360", { module: "members", memberId: id }),
+      ];
+    const opportunityId =
+      typeof row.fields.opportunityId === "string"
+        ? row.fields.opportunityId
+        : snapshot.opportunities.some((opportunity) => opportunity.id === row.id)
+          ? row.id
+          : null;
+    if (opportunityId)
+      row.actions = [
+        ...(row.actions ?? []),
+        commandAction("navigate_admin", "Plan history", { module: "pipeline", opportunityId }),
+      ];
+  }
+  if (parameters.get("opportunityId"))
+    result.rows = result.rows.filter(
+      (row) =>
+        row.id === parameters.get("opportunityId") ||
+        row.fields.opportunityId === parameters.get("opportunityId"),
+    );
+  return result;
+}
