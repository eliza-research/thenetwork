+      return 0;
+    let reopened = 0;
+    for (const task of await this.scheduler.list()) {
+      const target = task.metadata?.network as
+        | { scope?: string; networkId?: string; memberId?: string; requestId?: string }
+        | undefined;
+      if (
+        target?.scope !== "outreach" ||
+        target.networkId !== this.options.domain.options.networkId ||
+        target.memberId !== actor.memberId ||
+        !target.requestId ||
+        task.state.status !== "skipped" ||
+        !task.state.lastDecisionLog?.includes("network_outreach_current_authority")
+      )
+        continue;
+      const request = await this.queue().byId(target.requestId, member.cloudUserId);
+      if (
+        request?.state !== "approved" ||
+        request.expiresAt <= this.options.domain.options.clock.now()
+      )
+        continue;
+      await this.scheduler.apply(task.taskId, "reopen", {
+        reason: "Explicit member outreach resume; original staff-approved queue item revalidated",
+      });
+      reopened++;
+    }
+    return reopened;
+  }
+  readonly gate: TaskGateContribution = {
+    kind: "network_outreach",
+    evaluate: async (task) => {
+      const target = task.metadata?.network as
+        | { scope?: string; networkId?: string; memberId?: string; requestId?: string }
+        | undefined;
+      if (
+        target?.scope !== "outreach" ||
+        target.networkId !== this.options.domain.options.networkId ||
+        !target.memberId ||
+        !target.requestId
+      )
+        return { kind: "deny", reason: "network_outreach_scope" };
+      const member = await this.options.domain.getMember({ type: "system" }, target.memberId);
+      const request = await this.queue().byId(target.requestId, member.cloudUserId);
+      if (
+        !request ||
+        request.state !== "approved" ||
+        request.expiresAt <= this.options.domain.options.clock.now() ||
+        member.accountState !== "active" ||
+        member.safetyHold ||
+        member.participation === "paused" ||
+        member.preferences.onlyWhenAsked ||
+        !member.preferences.proactiveOptIn ||
+        !member.channels.some(
+          (channel) => !channel.stopped && channel.channel !== "web" && channel.verifiedAt,
+        )
+      )
+        return { kind: "deny", reason: "network_outreach_current_authority" };
+      if (
+        !(await this.options.domain.withAuthority(async (domain, db) =>
+          this.evidenceCurrent(
+            domain,
+            db.execute,
+            await domain.getMember({ type: "system" }, member.memberId),
+            this.binding(request),
+          ),
+        ))
+      )
+        return { kind: "deny", reason: "network_outreach_evidence_expired" };
+      return networkQuietHours(member, this.options.domain.options.clock.now());
+    },
+  };
+  async dispatch(record: ScheduledTaskDispatchRecord): Promise<DispatchResult> {
+    const target = record.metadata?.network as
+      | { scope?: string; networkId?: string; memberId?: string; requestId?: string }
+      | undefined;
+    if (
+      target?.scope !== "outreach" ||
+      target.networkId !== this.options.domain.options.networkId ||
+      !target.memberId ||
+      !target.requestId
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Exact own outreach task required");
+    const memberId = target.memberId,
+      requestId = target.requestId;
+    return this.options.domain.withAuthority(async (domain, db) => {
+      const member = await domain.getMember({ type: "system" }, memberId);
+      const queue = this.queue(runtimeInSqlTransaction(this.options.runtime, db.execute));
+      const request = await queue.byId(requestId, member.cloudUserId);
+      if (
+        !request ||
+        !["approved", "done"].includes(request.state) ||
+        request.payload.action !== "send_message" ||
+        !request.idempotencyKey
+      )
+        throw new NetworkDomainError("NETWORK_FORBIDDEN", "Approved current queue item required");
+      const binding = this.binding(request);
+      if (
+        binding.memberId !== memberId ||
+        binding.expiresAt <= domain.options.clock.now().toISOString()
+      )
+        throw new NetworkDomainError(
+          "NETWORK_EXPIRED",
+          "Current request recipient and expiry required",
+        );
+      if (!(await this.evidenceCurrent(domain, db.execute, member, binding)))
+        throw new NetworkDomainError(
+          "NETWORK_EXPIRED",
+          "Current reviewed outreach evidence required",
+        );
+      if (request.state !== "done")
+        await domain.command(
+          { type: "system" },
+          {
+            type: "record_proactive",
+            requestId: `outreach-admit:${networkDigest(request.idempotencyKey)}`,
+            memberId,
+            messageId: request.idempotencyKey,
+            category: binding.category,
+            city: binding.city,
+            expiresAt: binding.expiresAt,
+          },
+        );
+      return this.options.transport.sendMember(
+        {
+          memberId,
+          body: request.payload.body,
+          purpose: binding.purpose,
+          idempotencyKey: request.idempotencyKey.slice(
+            `network:${networkDigest(domain.options.networkId)}:`.length,
+          ),
+          approvalRequestId: request.id,
+        },
+        { domain, execute: db.execute },
+      );
+    });
+  }
+}
