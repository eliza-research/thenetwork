@@ -0,0 +1,531 @@
+import { describe, expect, it } from "vitest";
+import { activeOpportunityKey } from "../domain/store.js";
+import { opportunityDraft } from "./domain-projection.js";
+import { buildMatchingRun, candidateEligibility, DEFAULT_MATCHING_CONFIG } from "./engine.js";
+import { generateCandidates } from "./generators.js";
+import { DAY, NOW, testInput, testMember } from "./test-fixtures.js";
+import type {
+  JudgeCache,
+  MatchingConfig,
+  MatchingJudge,
+  MatchJudgment,
+  MatchMember,
+} from "./types.js";
+
+const config: MatchingConfig = { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5 };
+
+describe("Network opportunity production engine", () => {
+  it("does not regenerate a still-active semantic opportunity even after time-window cooldowns", () => {
+    const input = testInput(2);
+    const proposal = generateCandidates(input, config)[0];
+    if (!proposal) throw new Error("fixture proposal missing");
+    const key = activeOpportunityKey(opportunityDraft(proposal, "SF", input.members));
+    if (key === null) throw new Error("fixture key missing");
+    input.activeOpportunityKeys = [key];
+    expect(
+      generateCandidates(input, config).some(
+        (candidate) =>
+          activeOpportunityKey(opportunityDraft(candidate, "SF", input.members)) === key,
+      ),
+    ).toBe(false);
+    input.activeOpportunityKeys = [];
+    expect(
