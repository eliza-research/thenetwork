+import { describe, expect, it } from "vitest";
+import { createMatchingGraph, warmPath } from "./graph.js";
+import { testInput } from "./test-fixtures.js";
+
+describe("factual per-run graph retrieval", () => {
+  it("finds direct and two-hop confirmed paths and rejects longer or unconfirmed paths", () => {
+    const input = testInput(5),
+      ids = input.members.map((member) => member.memberId);
+    input.edges = [
+      { from: ids[0]!, to: ids[1]!, confirmed: true },
+      { from: ids[1]!, to: ids[2]!, confirmed: true },
+      { from: ids[2]!, to: ids[3]!, confirmed: true },
+      { from: ids[0]!, to: ids[4]!, confirmed: false },
+    ];
+    const graph = createMatchingGraph(input);
+    expect(warmPath(graph, ids[0]!, ids[1]!)).toBe(true);
+    expect(warmPath(graph, ids[0]!, ids[2]!)).toBe(true);
+    expect(warmPath(graph, ids[0]!, ids[3]!)).toBe(false);
+    expect(warmPath(graph, ids[0]!, ids[4]!)).toBe(false);
+  });
+  it("rebuilds every run and excludes blocked and ineligible intermediary members", () => {
+    const input = testInput(3),
+      a = input.members[0]!,
+      connector = input.members[1]!,
+      b = input.members[2]!;
+    input.edges = [
+      { from: a.memberId, to: connector.memberId, confirmed: true },
+      { from: connector.memberId, to: b.memberId, confirmed: true },
+    ];
+    expect(warmPath(createMatchingGraph(input), a.memberId, b.memberId)).toBe(true);
+    connector.safetyHold = true;
+    expect(warmPath(createMatchingGraph(input), a.memberId, b.memberId)).toBe(false);
+    connector.safetyHold = false;
+    connector.age = "minor";
+    expect(warmPath(createMatchingGraph(input), a.memberId, b.memberId)).toBe(false);
+    connector.age = "adult";
+    a.blockedIds = [connector.memberId];
+    expect(warmPath(createMatchingGraph(input), a.memberId, b.memberId)).toBe(false);
+  });
+});
diff --git a/packages/cloud/shared/src/lib/network/matching/graph.ts b/packages/cloud/shared/src/lib/network/matching/graph.ts
