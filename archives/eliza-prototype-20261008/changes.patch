@@ -0,0 +1,250 @@
+import { DAY, NOW, testMember } from "./test-fixtures.js";
+import type { GeneratorKind, MatchIntent, MatchMember } from "./types.js";
+
+export const SYNTHETIC_SCORING_REVIEW = {
+  labelSource: "Author-created synthetic expectations, not human gold labels",
+  humanReview: "pending",
+  productValue: "unverified",
+} as const;
+
+function helpIntent(id: string, needs: string[], offers: string[]): MatchIntent {
+  return {
+    id,
+    category: "help",
+    tags: [],
+    needs,
+    offers,
+    kind: "help",
+    safetyClass: "low",
+    createdAt: NOW - DAY,
+    expiresAt: NOW + DAY,
+  };
+}
+
+const requester = testMember(101, {
+  receiving: true,
+  intents: [helpIntent("request:guitar", ["guitar"], [])],
+  facts: [],
+});
+const willingHelper = testMember(102, {
+  intents: [helpIntent("offer:guitar", [], ["guitar"])],
+  facts: [],
+});
+const capableHelper = testMember(103, {
+  intents: [],
+  facts: [
+    {
+      id: "skill:guitar",
+      kind: "skill",
+      text: "Synthetic member can play guitar",
+      tags: ["guitar"],
+      scope: "shareable",
+      confidence: 0.95,
+      confirmedAt: NOW,
+    },
+  ],
+});
+const exchange: [MatchMember, MatchMember] = [
+  testMember(111, {
+    intents: [helpIntent("exchange:guitar-piano", ["guitar"], ["piano"])],
+    facts: [],
+  }),
+  testMember(112, {
+    intents: [helpIntent("exchange:piano-guitar", ["piano"], ["guitar"])],
+    facts: [],
+  }),
+];
+const group = [
+  exchange[0],
+  testMember(113, {
+    intents: [helpIntent("exchange:piano-drums", ["piano"], ["drums"])],
+    facts: [],
+  }),
+  testMember(114, {
+    intents: [helpIntent("exchange:drums-guitar", ["drums"], ["guitar"])],
+    facts: [],
+  }),
+];
+const weak = testMember(115, {
+  receiving: true,
+  intents: [helpIntent("mostly-unmet", ["guitar", "sailing", "rowing", "cycling", "swimming"], [])],
+  facts: [],
+});
+const factOffer = testMember(121, {
+  intents: [],
+  facts: [{ ...capableHelper.facts[0]!, id: "offer:fact", kind: "offer" }],
+});
+const solo = testMember(131, { facts: [] });
+
+/** Small reusable review set. Expected order is authored by the fixture writer; review remains separate. */
+export const SYNTHETIC_SCORING_CASES: Array<{
+  id: string;
+  scenario: string;
+  candidates: Array<{
+    id: string;
+    generator: GeneratorKind;
+    relevantTags: string[];
+    members: MatchMember[];
+  }>;
+  expectedOrder: string[];
+  constraints: string[];
+}> = [
+  {
+    id: "asymmetric-help",
+    scenario: "A requester needs guitar help; ability alone does not establish helper willingness.",
+    candidates: [
+      {
+        id: "willing",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [requester, willingHelper],
+      },
+      {
+        id: "ability-only",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [requester, capableHelper],
+      },
+      {
+        id: "ability-and-interest",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [
+          requester,
+          {
+            ...capableHelper,
+            intents: [
+              { ...helpIntent("interest:guitar", [], []), kind: "activity", tags: ["guitar"] },
+            ],
+          },
+        ],
+      },
+    ],
+    expectedOrder: ["willing", "ability-only"],
+    constraints: [
+      "Requester need can be met by ability; help utility for the helper requires an explicit matching offer.",
+    ],
+  },
+  {
+    id: "balanced-pair",
+    scenario: "Two members offer the skills the other currently needs.",
+    candidates: [
+      {
+        id: "exchange",
+        generator: "complementary",
+        relevantTags: ["guitar", "piano"],
+        members: exchange,
+      },
+      {
+        id: "one-sided",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [requester, capableHelper],
+      },
+    ],
+    expectedOrder: ["exchange", "one-sided"],
+    constraints: [
+      "Both directions must contribute; exchanging member order must preserve the score.",
+    ],
+  },
+  {
+    id: "group-lowest-member",
+    scenario:
+      "A balanced three-person skill exchange gains a fourth member whose needs are mostly unmet.",
+    candidates: [
+      {
+        id: "balanced",
+        generator: "group",
+        relevantTags: ["guitar", "piano", "drums"],
+        members: group,
+      },
+      {
+        id: "weak-fourth",
+        generator: "group",
+        relevantTags: ["guitar", "piano", "drums", "sailing", "rowing", "cycling", "swimming"],
+        members: [...group, weak],
+      },
+      {
+        id: "unserved-fourth",
+        generator: "group",
+        relevantTags: ["guitar", "piano", "drums", "sailing"],
+        members: [...group, { ...weak, intents: [helpIntent("unmet", ["sailing"], [])] }],
+      },
+    ],
+    expectedOrder: ["balanced", "weak-fourth", "unserved-fourth"],
+    constraints: [
+      "Strong peers cannot hide the lowest member's utility; an unserved member gives zero reciprocal credit.",
+    ],
+  },
+  {
+    id: "evidence-confidence-privacy",
+    scenario: "The same explicit fact offer is current, older, or restricted to matching scope.",
+    candidates: [
+      {
+        id: "current",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [requester, factOffer],
+      },
+      {
+        id: "older",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [
+          requester,
+          { ...factOffer, facts: [{ ...factOffer.facts[0]!, confirmedAt: NOW - 360 * DAY }] },
+        ],
+      },
+      {
+        id: "matching-only",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [
+          requester,
+          {
+            ...factOffer,
+            facts: [{ ...factOffer.facts[0]!, scope: "network", text: "CANARY_MATCHING_ONLY" }],
+          },
+        ],
+      },
+    ],
+    expectedOrder: ["current", "older"],
+    constraints: [
