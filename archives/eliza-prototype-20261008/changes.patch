+import { randomUUID } from "node:crypto";
+import { expect, it, vi } from "vitest";
+import { DomainStore } from "../domain/store.ts";
+import type { NetworkActor, NetworkEvent } from "../domain/types.ts";
+import { SimClock } from "../evaluation/fixtures.ts";
+import { executeWorkbenchCommand } from "./application.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import { publishLocalWorldFixture } from "./world.ts";
+
+it("reads only the owned clock/source event and preserves replay without materializing unrelated logs", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: `test:scoped-reads:${randomUUID()}`,
+    clock,
+  });
+  const engineer: NetworkActor = { type: "staff", userId: "fixture-engineer", roles: ["engineer"] };
+  const broad = vi
+    .spyOn(host.domain, "adminView")
+    .mockRejectedValue(new Error("Whole admin projection must not be used for a single event"));
+  try {
+    const input = { type: "advance_clock", requestId: "advance-owned", hours: 2 };
+    const first = await executeWorkbenchCommand(host, clock, engineer, input);
+    expect(first.result).toMatchObject({ at: "2026-10-06T18:00:00.000Z" });
+    await executeWorkbenchCommand(host, clock, engineer, input);
+    expect(clock.now().toISOString()).toBe("2026-10-06T18:00:00.000Z");
+    const store = new DomainStore(host.db.execute, host.domain.options.networkId);
+    expect(await store.list<NetworkEvent>("events", ["clock:advance-owned"])).toHaveLength(1);
+    await expect(
+      executeWorkbenchCommand(host, clock, engineer, { ...input, hours: 3 }),
+    ).rejects.toMatchObject({ code: "NETWORK_IDEMPOTENCY" });
+    const fixture = {
+      requestId: "owned-source",
+      title: "Authored local event",
+      kind: "event",
+      city: "SF",
+      area: "Public fixture park",
+      tags: "music",
+      category: "music",
+      startsAt: "2026-10-07T19:00:00.000Z",
+      endsAt: "2026-10-07T20:00:00.000Z",
+      freshHours: 24,
+    };
+    await publishLocalWorldFixture(host.domain, engineer, fixture);
+    await publishLocalWorldFixture(host.domain, engineer, fixture);
+    expect(await store.list<NetworkEvent>("events", ["owned-source"])).toHaveLength(1);
+    await expect(
+      publishLocalWorldFixture(host.domain, engineer, { ...fixture, title: "Changed event" }),
+    ).rejects.toMatchObject({ code: "NETWORK_IDEMPOTENCY" });
+    expect(broad).not.toHaveBeenCalled();
+  } finally {
+    broad.mockRestore();
+    await host.close();
+  }
+}, 120000);
