+// @vitest-environment jsdom
+/** Real chat composition; only account identity and HTTP-facing client IO are replaced. */
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+  within,
+} from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ConversationMessage } from "../../../api/client-types-chat";
+
+const io = vi.hoisted(() => ({
+  token: "account-a" as string | null,
+  send: vi.fn(),
+  stop: vi.fn(),
+  history: vi.fn(),
+}));
+vi.mock("@elizaos/plugin-elizacloud/steward-session-client", () => ({
+  STEWARD_TOKEN_KEY: "steward_session_token",
+  STEWARD_SESSION_CHANGE_EVENT: "steward-session-change",
+  readStoredStewardToken: () => io.token,
+  clearStoredStewardToken: async () => {
+    io.token = null;
+    window.dispatchEvent(new Event("steward-session-change"));
+  },
+}));
+vi.mock("../../../api/client", () => ({
+  ElizaClient: class {
+    constructor(
+      private base: string,
+      private token: string,
+    ) {}
+    getBaseUrl() {
+      return this.base;
+    }
+    getRestAuthToken() {
+      return this.token;
+    }
+    async getPersonalSharedEliza() {
+      return {
+        personalElizaId: `personal:${this.token}`,
+        activeAgentId: `personal:${this.token}`,
+        runtime: "shared",
+        agentName: "Eliza",
+        apiBase: `https://cloud.eliza.app/api/v1/eliza/agents/personal:${this.token}`,
+      };
+    }
+    async listConversations() {
+      return {
+        conversations: [
+          {
+            id: `personal:${this.token}`,
+            roomId: `server-room:${this.token}`,
+            title: "Existing conversation",
+          },
+        ],
+      };
+    }
+    getConversationMessages(id: string, options: unknown) {
+      return io.history(id, options, this.token);
+    }
+    sendConversationMessageStream(...args: unknown[]) {
+      return io.send(...args, this.token);
+    }
+    abortConversationTurn(roomId: string, reason: string) {
+      return io.stop(roomId, reason, this.token);
+    }
+  },
+}));
+
+import { CloudI18nProvider } from "../../shell/CloudI18nProvider";
+import NetworkChatPage from "./network-chat-page";
+
+// Uses the owning transcript tests' alternating, stable-id message pattern,
+// extended with real history DTO visibility/source fields and a long thread.
+function accountHistory(account: string): ConversationMessage[] {
+  return Array.from(
+    { length: 96 },
+    (_, index): ConversationMessage => ({
+      id: `${account}-${index}`,
+      role: index % 2 === 0 ? ("user" as const) : ("assistant" as const),
+      text: `${account} private history turn ${index}`,
+      source: index % 3 === 0 ? "telegram" : "imessage",
+      timestamp: 1_700_000_000_000 + index,
+    }),
+  ).concat([
+    {
+      id: `${account}-internal`,
+      role: "assistant",
+      text: `${account} private internal action output`,
+      timestamp: 1_700_000_001_000,
+      transcriptVisibility: "internal",
+    },
+  ]);
+}
+function mount() {
+  return render(
+    <MemoryRouter initialEntries={["/network/chat?brand=network"]}>
+      <CloudI18nProvider initialLang="en">
+        <NetworkChatPage />
+      </CloudI18nProvider>
+    </MemoryRouter>,
+  );
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  io.token = "account-a";
+  io.history.mockImplementation(
+    async (_id: string, _options: unknown, token: string) => ({
+      messages: accountHistory(token),
+    }),
+  );
+  io.stop.mockImplementation(async (roomId: string) => ({
+    roomId,
+    aborted: true,
+  }));
+  io.send.mockResolvedValue({
+    completed: true,
+    text: "Test-only receipt",
+    agentName: "Eliza",
+  });
+  vi.spyOn(globalThis, "fetch").mockRejectedValue(
+    new Error("Unexpected network IO in closed composition test"),
+  );
+});
+afterEach(() => {
+  cleanup();
+  expect(globalThis.fetch).not.toHaveBeenCalled();
+  vi.restoreAllMocks();
+});
+
+describe("Network real chat composition", () => {
+  it("renders the long mixed history with owned transcript/composer and removes it on Settings/logout", async () => {
+    mount();
+    await screen.findByText("account-a private history turn 95");
+    const log = screen.getByRole("log", { name: "Chat messages" });
+    expect(
+      within(log).getByText("account-a private history turn 0"),
+    ).toBeTruthy();
+    expect(
+      within(log).getAllByText(/account-a private history turn \d+/),
+    ).toHaveLength(96);
+    expect(
+      screen.queryByText("account-a private internal action output"),
+    ).toBeNull();
+    expect(screen.queryByTestId("chat-composer-mic")).toBeNull();
+    expect(
+      screen.queryByRole("button", { name: "Have Eliza call me" }),
+    ).toBeNull();
+    fireEvent.change(screen.getByTestId("chat-composer-textarea"), {
+      target: { value: "Retained private draft" },
+    });
+    expect(screen.getByRole("button", { name: "Send" })).toBeTruthy();
+    expect(screen.queryByRole("button", { name: "common.send" })).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Settings" }));
+    expect(screen.queryByRole("log", { name: "Chat messages" })).toBeNull();
+    expect(screen.queryByText("account-a private history turn 0")).toBeNull();
+    fireEvent.click(
+      screen.getByRole("button", { name: "Sign out of this browser" }),
+    );
+    await waitFor(() => expect(io.token).toBeNull());
+    fireEvent.click(screen.getByRole("button", { name: "Back to chat" }));
+    expect(
+      screen.getByRole("link", { name: "Sign in with Eliza Cloud" }),
+    ).toBeTruthy();
+    expect(screen.queryByTestId("chat-composer-textarea")).toBeNull();
+    expect(screen.queryByText("account-a private history turn 95")).toBeNull();
+  });
+
+  it("keeps translated Stop reachable with the sent draft and fences its late reply", async () => {
+    let finish!: (value: unknown) => void;
+    io.send.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          finish = resolve;
+        }),
+    );
+    mount();
+    await screen.findByText("account-a private history turn 95");
+    const textarea = screen.getByTestId(
+      "chat-composer-textarea",
+    ) as HTMLTextAreaElement;
+    fireEvent.change(textarea, {
+      target: { value: "Keep this exact request for retry" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Send" }));
+    await waitFor(() => expect(io.send).toHaveBeenCalledTimes(1));
+    const stop = screen.getByRole("button", {
+      name: /stop generation/i,
+    }) as HTMLButtonElement;
+    expect(stop.disabled).toBe(false);
+    expect(textarea.value).toBe("Keep this exact request for retry");
+    fireEvent.click(stop);
+    await waitFor(() =>
+      expect(io.stop).toHaveBeenCalledExactlyOnceWith(
+        "server-room:account-a",
+        "network-ui-stop",
+        "account-a",
+      ),
+    );
+    const readsBeforeReply = io.history.mock.calls.length;
+    await act(async () => {
+      finish({ completed: true, text: "Late assistant after Stop" });
+    });
+    expect(screen.queryByText("Late assistant after Stop")).toBeNull();
+    expect(screen.queryByText("Saved conversation refreshed.")).toBeNull();
+    expect(io.history).toHaveBeenCalledTimes(readsBeforeReply);
+    expect(
+      screen.getByRole("button", { name: "Retry same message" }),
+    ).toBeTruthy();
+  });
+
+  it("rebinds real transcript DOM to the new account without publishing the old assistant", async () => {
+    let finish!: (value: unknown) => void;
+    io.send.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          finish = resolve;
+        }),
+    );
+    mount();
+    await screen.findByText("account-a private history turn 95");
+    fireEvent.change(screen.getByTestId("chat-composer-textarea"), {
+      target: { value: "Account A pending turn" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Send" }));
+    await waitFor(() => expect(io.send).toHaveBeenCalledTimes(1));
+    await act(async () => {
+      io.token = "account-b";
+      window.dispatchEvent(new Event("steward-session-change"));
+    });
+    await screen.findByText("account-b private history turn 95");
+    await act(async () => {
+      finish({ completed: true, text: "Account A late assistant" });
+    });
+    expect(screen.queryByText("Account A late assistant")).toBeNull();
+    expect(screen.queryByText("account-a private history turn 0")).toBeNull();
+    expect(
+      (screen.getByTestId("chat-composer-textarea") as HTMLTextAreaElement)
+        .value,
+    ).toBe("");
+    expect(io.stop).toHaveBeenCalledExactlyOnceWith(
+      "server-room:account-a",
+      "network-ui-stop",
+      "account-a",
+    );
+    expect(screen.queryByText("Saved conversation refreshed.")).toBeNull();
+  });
+});
