+  } catch {
+    throw new NetworkDomainError("NETWORK_INVALID", "Malformed JSON command");
+  }
+  record(input);
+  return input;
+}
+function parseObjectField(value: string): Record<string, unknown> {
+  try {
+    const parsed: unknown = JSON.parse(value);
+    record(parsed);
+    return parsed;
+  } catch {
+    throw new NetworkDomainError("NETWORK_INVALID", "Field must contain a valid JSON object");
+  }
