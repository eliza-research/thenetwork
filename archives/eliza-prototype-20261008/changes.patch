+                typeof value.travelMinutesByArea[venue.area] === "number",
+            ),
+          );
+        return {
+          slots,
+          venues,
+          qualification: {
+            availability: qualified ? ("qualified_local" as const) : ("unknown" as const),
+            travel: travelKnown ? ("member_stated" as const) : ("unknown" as const),
+          },
+        };
+      },
+    );
+  }
+  private async assertKnownAvailability(
+    members: NetworkMember[],
+    range: CalendarAvailabilityRange,
+  ): Promise<void> {
+    const resolved = await readAvailability(
+      members,
+      range,
+      this.options.clock,
+      this.options.availability,
+    );
+    for (let index = 0; index < members.length; index++) {
+      const value = resolved[index],
+        member = members[index];
+      if (
+        !value ||
+        !member ||
+        (value.qualification.stated !== "known" &&
+          value.qualification.freeBusy !== "authored_fixture")
+      )
+        continue;
+      const result = evaluateCalendarAvailability({
+        range,
+        timeZone: member.preferences.timezone,
+        sources: value.sources,
+        proposal: { startISO: range.start, endISO: range.end },
+      });
+      if (!value.sources.length || !result.definitive || result.conflicts.length)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "A participant's current known availability does not support this slot",
+          { rule: "known_availability_conflict" },
+        );
+    }
+  }
+  async proposeSlot(
+    actor: NetworkActor,
+    input: {
+      opportunityId: string;
+      revision: number;
+      requestId: string;
+      startAt: string;
+      endAt: string;
