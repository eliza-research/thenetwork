+}, 120000);
diff --git a/packages/cloud/shared/src/lib/network/workbench/mock-transport.ts b/packages/cloud/shared/src/lib/network/workbench/mock-transport.ts
new file mode 100644
index 000000000000..e26719862319
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/mock-transport.ts
@@ -0,0 +1,437 @@
+import type { IAgentRuntime } from "@elizaos/core";
+import type { DispatchResult } from "@elizaos/plugin-scheduling";
+import { type CarveOutSqlExecutor, type RuntimeDb, sqlQuote } from "@elizaos/plugin-sql";
+import { PgApprovalQueue } from "../../../../../../../plugins/plugin-assistant/src/services/approval/store.ts";
+import { networkDigest } from "../digest.ts";
+import { type NetworkDomain, readyInvitationMemberIds } from "../domain/index.ts";
+import {
+  assertKnownDisclosure,
+  availableOpportunityMemberIds,
+  consentedOpportunityMemberIds,
+  hasRequiredOpportunityMembers,
+} from "../domain/policy.ts";
+import { payload } from "../domain/store.ts";
+import { type NetworkClock, NetworkDomainError, type NetworkOpportunity } from "../domain/types.ts";
+import { runtimeInSqlTransaction } from "../runtime-sql.ts";
+/** Closed local transport: all effects terminate in the existing approval queue and synthetic receipts. */
+export class NetworkMockTransport {
+  constructor(
+    private readonly runtime: IAgentRuntime,
+    private readonly domain: NetworkDomain,
+    private readonly clock: NetworkClock,
+  ) {}
+  async messages() {
+    const queue = new PgApprovalQueue(this.runtime, {
+      agentId: this.runtime.agentId,
+      now: this.clock.now.bind(this.clock),
+    });
+    const requests = (
+      await queue.list({ subjectUserId: null, state: "done", action: "send_message" })
+    ).filter(
+      (r) =>
+        r.execution?.provider === "network-local-mock" &&
+        (r.execution.providerReceipt?.networkId === this.domain.options.networkId ||
+          (this.domain.options.networkId === "test:local-network-review" &&
+            r.execution.providerReceipt?.networkId === undefined)),
+    );
+    const subjects = new Map<string, string>();
+    if (requests.some((r) => typeof r.execution?.providerReceipt?.memberId !== "string")) {
+      const snapshot = await this.domain.engineSnapshot({ type: "system" });
+      for (const entry of snapshot.members) {
+        const member = await this.domain.getMember({ type: "system" }, entry.memberId);
+        subjects.set(member.cloudUserId, member.memberId);
+      }
+    }
+    const result = [];
+    const members = new Map<string, Awaited<ReturnType<NetworkDomain["getMember"]>>>();
+    const events = await this.domain.options.db.execute(
+      `SELECT payload,sequence FROM network.events WHERE network_id=${sqlQuote(this.domain.options.networkId)} AND payload->>'kind'='outbound_accepted'`,
+    );
+    const sequences = new Map(
+      events.map((row) => {
+        const event = payload<{
+          memberIds: string[];
+          details: { nativeRequestId: string; idempotencyKey: string };
+        }>(row);
+        const sequence = Number(row.sequence);
+        if (!Number.isSafeInteger(sequence) || sequence < 1)
+          throw new Error("Invalid durable outbound sequence");
+        return [event.details.nativeRequestId, { sequence, event }] as const;
+      }),
+    );
+    for (const request of requests) {
+      const receipt = request.execution?.providerReceipt;
+      const memberId =
+        typeof receipt?.memberId === "string"
+          ? receipt.memberId
+          : subjects.get(request.subjectUserId);
+      if (
+        !memberId ||
+        !receipt ||
+        typeof receipt.acceptedAt !== "string" ||
+        request.payload.action !== "send_message"
+      )
+        throw new Error("Durable mock receipt is missing its original member binding");
+      let member = members.get(memberId);
+      if (!member) {
+        member = await this.domain.getMember({ type: "system" }, memberId);
+        members.set(memberId, member);
+      }
+      if (member.cloudUserId !== request.subjectUserId)
+        throw new Error("Mock receipt belongs to a different member identity");
+      const correlation = sequences.get(request.id);
+      if (
+        correlation &&
+        (!correlation.event.memberIds.includes(memberId) ||
+          correlation.event.details.idempotencyKey !== request.idempotencyKey)
+      )
+        throw new Error("Outbound event does not bind its native delivery receipt");
+      result.push({
+        direction: "outbound" as const,
+        memberId,
+        body: request.payload.body,
+        idempotencyKey: request.idempotencyKey ?? "",
+        acceptedAt: receipt.acceptedAt,
+        sequence: correlation?.sequence,
+        channel: request.channel === "internal" ? "web" : request.channel,
+      });
+    }
+    return result.sort((a, b) =>
+      a.acceptedAt < b.acceptedAt
+        ? -1
+        : a.acceptedAt > b.acceptedAt
+          ? 1
+          : a.idempotencyKey < b.idempotencyKey
+            ? -1
+            : a.idempotencyKey > b.idempotencyKey
+              ? 1
+              : 0,
+    );
+  }
+  async send(
+    input: {
+      memberId: string;
+      opportunityId: string;
+      revision: number;
+      body: string;
+      purpose: string;
+      idempotencyKey: string;
+    },
+    authority: { domain: NetworkDomain; execute: CarveOutSqlExecutor },
+  ): Promise<DispatchResult> {
+    const value = await authority.domain.getOpportunity({ type: "system" }, input.opportunityId);
+    if (!("participantIds" in value))
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Trusted opportunity required");
+    const o = value as NetworkOpportunity;
+    if (
+      o.revision !== input.revision ||
+      o.review?.decision !== "approved" ||
+      o.review.revision !== o.revision
+    )
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Current reviewed revision required");
+    if (
+      !hasRequiredOpportunityMembers(
+        o,
+        input.purpose === "feedback"
+          ? consentedOpportunityMemberIds(o)
+          : availableOpportunityMemberIds(o, this.clock.now().toISOString()),
+      )
+    )
+      throw new NetworkDomainError("NETWORK_INELIGIBLE", "Required requester is unavailable");
+    const members = [];
+    for (const id of o.participantIds)
+      members.push(await authority.domain.getMember({ type: "system" }, id));
+    const member = members.find((m) => m.memberId === input.memberId);
+    if (
+      !member ||
+      member.age !== "adult" ||
+      member.accountState !== "active" ||
+      member.safetyHold ||
+      (input.purpose === "invitation" && member.participation === "paused") ||
+      (o.kind !== "monthly_event" &&
+        members.some((m) => m.blockedMemberIds.some((id) => o.participantIds.includes(id))))
+    )
+      throw new NetworkDomainError("NETWORK_INELIGIBLE", "Current eligible recipient required");
+    const channel =
+      member.channels.find((c) => !c.stopped && c.verifiedAt && c.primary) ??
+      member.channels.find((c) => !c.stopped && c.verifiedAt);
+    if (!channel) throw new NetworkDomainError("NETWORK_INELIGIBLE", "No verified open channel");
+    assertKnownDisclosure(members, input.body);
+    return this.deliverMember(input, authority, member, channel);
+  }
+  /** Single-member proactive sends require an actual staff-approved canonical queue request. */
+  async sendMember(
+    input: {
+      memberId: string;
+      body: string;
+      purpose: "profiling" | "recommendation";
+      idempotencyKey: string;
+      approvalRequestId: string;
+    },
+    authority: { domain: NetworkDomain; execute: CarveOutSqlExecutor },
+  ): Promise<DispatchResult> {
+    const member = await authority.domain.getMember({ type: "system" }, input.memberId);
+    if (member.accountState !== "active" || member.safetyHold || member.participation === "paused")
+      throw new NetworkDomainError("NETWORK_INELIGIBLE", "Current active recipient required");
+    const channel =
+      member.channels.find((c) => !c.stopped && c.verifiedAt && c.primary) ??
+      member.channels.find((c) => !c.stopped && c.verifiedAt);
+    if (!channel) throw new NetworkDomainError("NETWORK_INELIGIBLE", "No verified open channel");
+    const queue = new PgApprovalQueue(runtimeInSqlTransaction(this.runtime, authority.execute), {
+      agentId: this.runtime.agentId,
+      now: this.clock.now.bind(this.clock),
+    });
+    const reviewed = await queue.byId(input.approvalRequestId, member.cloudUserId);
+    const key = `network:${networkDigest(this.domain.options.networkId)}:${input.idempotencyKey}`;
+    if (
+      !reviewed ||
+      !["approved", "done"].includes(reviewed.state) ||
+      reviewed.idempotencyKey !== key ||
+      reviewed.requestedBy !== "network-local-host" ||
+      reviewed.payload.action !== "send_message" ||
+      reviewed.payload.body !== input.body ||
+      reviewed.payload.recipient !== channel.address
+    )
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "Exact approved proactive queue request required",
+      );
+    const binding = JSON.parse(reviewed.reason) as {
+      networkId?: string;
+      memberId?: string;
+      purpose?: string;
+    };
+    if (
+      binding.networkId !== this.domain.options.networkId ||
+      binding.memberId !== input.memberId ||
+      binding.purpose !== input.purpose
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Exact proactive purpose binding required");
+    const snapshot = await authority.domain.engineSnapshot({ type: "system" });
+    const members = await Promise.all(
+      snapshot.members.map((entry) =>
+        authority.domain.getMember({ type: "system" }, entry.memberId),
+      ),
+    );
+    assertKnownDisclosure(members, input.body);
+    return this.deliverMember(input, authority, member, channel, reviewed.reason);
+  }
+  private async deliverMember(
+    input: {
+      memberId: string;
+      opportunityId?: string;
+      revision?: number;
+      body: string;
+      purpose: string;
+      idempotencyKey: string;
+    },
+    authority: { domain: NetworkDomain; execute: CarveOutSqlExecutor },
+    member: Awaited<ReturnType<NetworkDomain["getMember"]>>,
+    channel: Awaited<ReturnType<NetworkDomain["getMember"]>>["channels"][number],
+    approvalReason?: string,
+  ): Promise<DispatchResult> {
+    const key = `network:${networkDigest(this.domain.options.networkId)}:${input.idempotencyKey}`;
+    const joined = runtimeInSqlTransaction(this.runtime, authority.execute);
+    const queue = new PgApprovalQueue(joined, {
+      agentId: this.runtime.agentId,
+      now: this.clock.now.bind(this.clock),
+    });
+    const existing = await queue.byIdempotencyKey(key, member.cloudUserId);
+    const inserted = await queue.enqueueTransactional(
+      {
+        requestedBy: "network-local-host",
+        subjectUserId: member.cloudUserId,
+        action: "send_message",
+        channel: channel.channel === "web" ? "internal" : channel.channel,
+        payload: {
+          action: "send_message",
+          recipient: channel.address,
+          body: input.body,
+          replyToMessageId: null,
+        },
+        reason:
+          approvalReason ??
+          `Network ${networkDigest(this.domain.options.networkId)} local ${input.purpose} for ${input.opportunityId} revision ${input.revision}`,
+        idempotencyKey: key,
+        expiresAt: existing?.expiresAt ?? new Date(this.clock.now().getTime() + 86400000),
+      },
+      joined.adapter.db as RuntimeDb,
+    );
+    let request = inserted.request;
+    if (request.state === "done") {
+      const receipt = request.execution?.providerReceipt;
+      if (
+        request.execution?.provider !== "network-local-mock" ||
+        receipt?.networkId !== this.domain.options.networkId ||
+        receipt?.memberId !== member.memberId ||
+        receipt?.synthetic !== true ||
+        typeof receipt?.providerMessageId !== "string" ||
+        typeof receipt?.acceptedAt !== "string"
+      )
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Mock delivery requires its original scoped receipt",
+        );
+      return {
+        ok: true,
+        messageId: receipt.providerMessageId,
+        receipt: {
+          provider: "network-local-mock",
+          providerMessageId: receipt.providerMessageId,
+          idempotencyKey: key,
+          acceptedAt: receipt.acceptedAt,
+        },
+      };
+    }
+    if (request.state === "pending" && !approvalReason)
+      request = await queue.approve(request.id, member.cloudUserId, {
+        resolvedBy: "network-local-host",
+        resolutionReason:
+          "Current reviewed purpose and member grants revalidated under the Network lock",
+      });
+    if (request.state !== "approved")
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Execution requires reconciliation");
+    const claimed = await queue.claimExecution({
+      requestId: request.id,
+      subjectUserId: member.cloudUserId,
+      provider: "network-local-mock",
+      providerIdempotencyKey: key,
+    });
+    if (!claimed.execution) throw new Error("Approval execution claim unavailable");
+    const mutation = {
+      requestId: request.id,
+      subjectUserId: member.cloudUserId,
+      attemptId: claimed.execution.attemptId,
+    };
+    await queue.markDispatchStarted(mutation);
+    const providerMessageId = `mock:${request.id}`;
+    const acceptedAt = this.clock.now().toISOString();
+    await queue.markDone({
+      ...mutation,
+      providerReceipt: {
+        provider: "network-local-mock",
+        providerMessageId,
+        acceptedAt,
+        memberId: member.memberId,
+        networkId: this.domain.options.networkId,
+        synthetic: true,
+      },
+    });
+    await authority.domain.command(
+      { type: "system" },
+      {
+        type: "record_event",
+        requestId: `network:outbound:${networkDigest(key)}`,
+        kind: "outbound_accepted",
+        memberIds: [member.memberId],
+        opportunityId: input.opportunityId ?? null,
+        details: { nativeRequestId: request.id, idempotencyKey: key, purpose: input.purpose },
+      },
+    );
+    return {
+      ok: true,
+      messageId: providerMessageId,
+      receipt: {
+        provider: "network-local-mock",
+        providerMessageId,
+        idempotencyKey: key,
+        acceptedAt,
+      },
+    };
+  }
+  async advanceInvitations(
+    opportunityId: string,
+  ): Promise<{ processed: number; pending: boolean }> {
+    const value = await this.domain.getOpportunity({ type: "system" }, opportunityId);
+    if (!("participantIds" in value))
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Trusted opportunity required");
+    let processed = 0;
+    let pending = false;
+    const ready = readyInvitationMemberIds(value, this.clock.now());
+    const pendingRecipients =
+      value.review?.decision === "approved" &&
+      value.review.revision === value.revision &&
+      [
+        "approved",
+        "inviting",
+        "partially_accepted",
+        "quorum_met",
+        ...(value.kind === "monthly_event" ? ["scheduled"] : []),
+      ].includes(value.state) &&
+      value.expiresAt > this.clock.now().toISOString()
+        ? value.participants
+            .filter(
+              (part) =>
+                part.invitedAt &&
+                part.state === "invited" &&
+                part.revision === value.revision &&
+                part.expiresAt > this.clock.now().toISOString(),
+            )
+            .map((part) => part.memberId)
+        : [];
+    for (const memberId of [...new Set([...ready, ...pendingRecipients])]) {
+      if (ready.includes(memberId))
+        await this.domain.command(
+          { type: "system" },
+          {
+            type: "invite_participant",
+            requestId: `network:invite:${opportunityId}:${value.revision}:${memberId}`,
+            opportunityId,
+            expectedRevision: value.revision,
+            memberId,
+          },
+        );
+      try {
+        const outcome = await this.sendInvitation(opportunityId, memberId);
+        if (outcome.ok) processed++;
+        else pending = true;
+      } catch (error) {
+        if (!(error instanceof NetworkDomainError)) throw error;
+        pending = true;
+      }
+    }
+    return { processed, pending };
+  }
+  async sendInvitation(opportunityId: string, memberId: string): Promise<DispatchResult> {
+    return this.domain.withAuthority(async (domain, db) => {
+      const value = await domain.getOpportunity({ type: "system" }, opportunityId);
+      if (!("participantIds" in value))
+        throw new NetworkDomainError("NETWORK_FORBIDDEN", "Trusted opportunity required");
+      const o = value as NetworkOpportunity;
+      const own = o.participants.find((p) => p.memberId === memberId);
+      if (
+        !own ||
+        own.state !== "invited" ||
+        own.revision !== o.revision ||
+        own.expiresAt <= this.clock.now().toISOString()
+      )
+        throw new NetworkDomainError("NETWORK_EXPIRED", "Current invitation required");
+      const body = `The Network has a reviewed ${o.category} possibility for you: ${o.objective}. ${o.explanations[memberId]?.text ?? ""} Would you like to hear more? You can decline.`;
+      await domain.command(
+        { type: "system" },
+        {
+          type: "record_proactive",
+          requestId: `network:outreach:${o.id}:${o.revision}:${memberId}`,
+          memberId,
+          messageId: `network:invitation:${o.id}:${o.revision}:${memberId}`,
+          expiresAt: own.expiresAt,
+          category: o.category,
+          city: o.city,
+          opportunityId: o.id,
+        },
+      );
+      const result = await this.send(
+        {
+          memberId,
+          opportunityId,
+          revision: o.revision,
+          body,
+          purpose: "invitation",
+          idempotencyKey: `network:invitation:${o.id}:${o.revision}:${memberId}`,
+        },
+        { domain, execute: db.execute },
+      );
+      return result;
+    });
+  }
+}
diff --git a/packages/cloud/shared/src/lib/network/workbench/operations-views.test.ts b/packages/cloud/shared/src/lib/network/workbench/operations-views.test.ts
new file mode 100644
index 000000000000..0b33e59ab541
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/operations-views.test.ts
@@ -0,0 +1,264 @@
+import { randomUUID } from "node:crypto";
+import type { NetworkAdminView } from "@elizaos/contracts";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { NetworkMemberAgent } from "../agent/service.ts";
+import type { NetworkActor } from "../domain/types.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { DEFAULT_MATCHING_CONFIG } from "../matching/config.ts";
+import { executeWorkbenchCommand } from "./application.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import { composeOperationsView } from "./operations-views.ts";
+import { DEFAULT_PERSONA_MIX } from "./simulation-lab.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T19:00:00.000Z"));
+const actor: NetworkActor = { type: "staff", userId: "operator", roles: ["admin"] };
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let memberId: string;
+const view = (module: string): NetworkAdminView => ({
+  module,
+  title: module,
+  summary: "",
+  metrics: [],
+  rows: [],
+  actions: [],
+});
+beforeAll(async () => {
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:operations-views:" + randomUUID(),
+    clock,
+  });
+  const personas = await seedSimulationMembers(host.domain, 4, 73);
+  memberId = personas[0]!.memberId;
+  const agent = new NetworkMemberAgent({
+    host,
+    executeCommand: (principal, input) => executeWorkbenchCommand(host, clock, principal, input),
+  });
+  await agent.message(memberId, {
+    text: "I enjoy PRIVATE_OPERATIONS_CANARY",
+    requestId: "ops-private-message",
+  });
+}, 120000);
+afterAll(async () => {
+  await host?.close();
+});
+
+it("opens actual native experience in two steps, protects private content and respects selected channel filtering", async () => {
+  const directory = view("perspective");
+  await composeOperationsView(host, actor, new URLSearchParams(), directory);
+  expect(directory.rows).toHaveLength(4);
+  expect(directory.rows[0]?.actions?.[0]?.args).toMatchObject({ module: "perspective", memberId });
+  const selected = view("perspective");
+  await composeOperationsView(
+    host,
+    actor,
+    new URLSearchParams({ memberId, channel: "web" }),
+    selected,
+  );
+  expect(selected.rows.filter((row) => row.fields.source === "native_shared_chat")).toHaveLength(2);
