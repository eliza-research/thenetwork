+const row = (
+  id: string,
+  title: string,
+  fields: Record<string, unknown>,
+  status?: string,
+  actions?: NetworkAction[],
+): NetworkRow => ({
+  id,
+  title,
+  fields,
+  ...(status ? { status } : {}),
+  ...(actions ? { actions } : {}),
+});
+export function compareTimelineRows(first: NetworkRow, second: NetworkRow): number {
+  const firstAt = first.fields.at,
+    secondAt = second.fields.at;
+  if (typeof firstAt !== "string" || typeof secondAt !== "string")
+    throw new Error("Persisted timeline timestamp unavailable");
+  const byTime = firstAt.localeCompare(secondAt);
+  if (byTime) return byTime;
+  return typeof first.fields.sequence === "number" && typeof second.fields.sequence === "number"
+    ? first.fields.sequence - second.fields.sequence
+    : 0;
