+];
diff --git a/packages/cloud/shared/src/lib/network/matching/scoring.test.ts b/packages/cloud/shared/src/lib/network/matching/scoring.test.ts
new file mode 100644
index 000000000000..6c041ffef313
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/scoring.test.ts
@@ -0,0 +1,189 @@
+import { describe, expect, it } from "vitest";
+import { buildMatchingRun, DEFAULT_MATCHING_CONFIG } from "./engine.js";
+import { createMatchingGraph } from "./graph.js";
+import {
+  evidenceFor,
+  pairFit,
+  participantBenefits,
+  scoreCandidate,
+  totalScore,
+} from "./scoring.js";
+import { SYNTHETIC_SCORING_CASES } from "./scoring-fixtures.js";
+import { NOW, testInput } from "./test-fixtures.js";
+
+function evaluate(candidate: (typeof SYNTHETIC_SCORING_CASES)[number]["candidates"][number]) {
+  const input = { ...testInput(0), members: candidate.members };
+  const components = scoreCandidate(
+    input,
+    input.members,
+    candidate.generator,
+    candidate.relevantTags,
+    input.window,
+    createMatchingGraph(input),
+  );
+  return { components, score: totalScore(components, DEFAULT_MATCHING_CONFIG) };
+}
+
+describe("local reciprocal matching utility", () => {
+  for (const scenario of SYNTHETIC_SCORING_CASES) {
+    it(`preserves the authored synthetic ordering: ${scenario.id}`, () => {
+      const scores = new Map(
+        scenario.candidates.map((candidate) => [candidate.id, evaluate(candidate).score]),
+      );
+      for (let index = 1; index < scenario.expectedOrder.length; index++) {
+        expect(scores.get(scenario.expectedOrder[index - 1]!), scenario.scenario).toBeGreaterThan(
+          scores.get(scenario.expectedOrder[index]!) ?? Infinity,
+        );
+      }
+    });
+  }
+
+  it("recognizes requester benefit without assuming an able helper wants to give", async () => {
+    const scenario = SYNTHETIC_SCORING_CASES[0]!;
+    const willing = scenario.candidates[0]!;
+    const abilityOnly = scenario.candidates[1]!;
+    const benefits = participantBenefits(
+      abilityOnly.members,
+      abilityOnly.relevantTags,
+      NOW,
+      abilityOnly.generator,
+    );
+    expect(benefits[0]?.benefit).toBeGreaterThan(0);
+    expect(benefits[1]?.benefit).toBe(0);
+    expect(evaluate(abilityOnly).components.mutualBenefit).toBe(0);
+    expect(evaluate(scenario.candidates[2]!).components.mutualBenefit).toBe(0);
+    const willingInput = { ...testInput(0), members: willing.members };
+    const run = await buildMatchingRun(willingInput, {
+      config: { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5 },
+    });
+    expect(run.proposals.some((proposal) => proposal.generator === "help")).toBe(true);
+    const oneSided = await buildMatchingRun(
+      { ...willingInput, members: abilityOnly.members },
+      {
+        config: { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5 },
+      },
+    );
+    expect(oneSided.proposals).toEqual([]);
+  });
+
+  it("keeps balanced pairs symmetric and every participant in a balanced group served", () => {
+    const pair = SYNTHETIC_SCORING_CASES[1]!.candidates[0]!;
+    const group = SYNTHETIC_SCORING_CASES[2]!.candidates[0]!;
+    expect(
+      participantBenefits(group.members, group.relevantTags, NOW, group.generator).every(
+        (item) => item.benefit > 0,
+      ),
+    ).toBe(true);
+    expect(evaluate({ ...pair, members: [...pair.members].reverse() })).toEqual(evaluate(pair));
+    expect(pairFit(pair.members[0]!, pair.members[1]!, NOW)).toBeGreaterThan(0);
+  });
+
+  it("cannot average away a weak or entirely unserved group participant", () => {
+    const scenario = SYNTHETIC_SCORING_CASES[2]!;
+    const balanced = evaluate(scenario.candidates[0]!).components;
+    const weak = evaluate(scenario.candidates[1]!).components;
+    const unserved = evaluate(scenario.candidates[2]!).components;
+    expect(weak.mutualBenefit).toBeLessThan(balanced.mutualBenefit / 2);
+    expect(unserved.mutualBenefit).toBe(0);
+  });
+
+  it("gives no offer credit to Receiving and no benefit to expired or high-risk intents", () => {
+    const willing = SYNTHETIC_SCORING_CASES[0]!.candidates[0]!;
+    const helper = willing.members[1]!;
+    for (const patch of [
+      { receiving: true },
+      { intents: helper.intents.map((intent) => ({ ...intent, expiresAt: NOW })) },
+      { intents: helper.intents.map((intent) => ({ ...intent, safetyClass: "high" as const })) },
+    ]) {
+      expect(
+        evaluate({ ...willing, members: [willing.members[0]!, { ...helper, ...patch }] }).components
+          .mutualBenefit,
+      ).toBe(0);
+    }
+  });
+
+  it("keeps matching-only facts out of explanations and private facts out of utility and confidence", () => {
+    const matchingOnly = SYNTHETIC_SCORING_CASES[3]!.candidates[2]!;
+    expect(evidenceFor(matchingOnly.members, matchingOnly.relevantTags)).toEqual([]);
+    const unknown = {
+      ...matchingOnly,
+      members: matchingOnly.members.map((member) => ({ ...member, facts: [] })),
+    };
+    const privateOnly = {
+      ...matchingOnly,
+      members: matchingOnly.members.map((member) => ({
+        ...member,
+        facts: member.facts.map((fact) => ({
+          ...fact,
+          scope: "agent_private" as const,
+          text: "CANARY_PRIVATE",
+        })),
+      })),
+    };
+    expect(evaluate(privateOnly)).toEqual(evaluate(unknown));
+    expect(evidenceFor(privateOnly.members, privateOnly.relevantTags)).toEqual([]);
+  });
+
+  it("does not let unrelated shared preferences rescue the candidate's unmet need", () => {
+    const sailing = SYNTHETIC_SCORING_CASES[4]!.candidates[1]!;
+    const components = evaluate({
+      ...sailing,
+      members: sailing.members.map((member) => ({
+        ...member,
+        facts: [
+          {
+            id: `${member.memberId}:jazz`,
+            kind: "interest",
+            tags: ["jazz"],
+            text: "Synthetic jazz preference",
+            scope: "shareable",
+            confidence: 1,
+            confirmedAt: NOW,
+          },
+        ],
+      })),
+    }).components;
+    expect(components.mutualBenefit).toBe(0);
+    expect(components.fit).toBe(0);
+  });
+
+  it("keeps shared activities useful without inventing help willingness", () => {
+    const activity = {
+      ...SYNTHETIC_SCORING_CASES[0]!.candidates[0]!,
+      generator: "shared_intent" as const,
+      relevantTags: ["jazz"],
+      members: testInput(2).members.map((member) => ({
+        ...member,
+        intents: member.intents.map((intent) => ({ ...intent, needs: [], offers: [] })),
+        facts: [],
+      })),
+    };
+    expect(evaluate(activity).components.mutualBenefit).toBeGreaterThan(
+      DEFAULT_MATCHING_CONFIG.mutualBenefitFloor,
+    );
+    expect(evaluate({ ...activity, generator: "help" }).components.mutualBenefit).toBe(0);
+  });
+
+  it("retains a useful solo preference without fabricating peer reciprocity", async () => {
+    const solo = SYNTHETIC_SCORING_CASES[5]!.candidates[0]!;
+    expect(evaluate(solo).components.mutualBenefit).toBeGreaterThan(
+      DEFAULT_MATCHING_CONFIG.mutualBenefitFloor,
+    );
+    expect(participantBenefits(solo.members, solo.relevantTags, NOW, solo.generator)).toEqual([
+      { memberId: solo.members[0]!.memberId, benefit: 0 },
+    ]);
+    const run = await buildMatchingRun(
+      {
+        ...testInput(0),
+        members: solo.members,
+        growthGaps: [{ id: "solo-gap", category: "growth", tags: ["jazz"], requiredRole: "host" }],
+      },
+      { config: { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5 } },
+    );
+    expect(
+      run.proposals.some(
+        (proposal) => proposal.generator === "growth" && proposal.participantIds.length === 1,
+      ),
+    ).toBe(true);
+  });
+});
diff --git a/packages/cloud/shared/src/lib/network/matching/scoring.ts b/packages/cloud/shared/src/lib/network/matching/scoring.ts
new file mode 100644
index 000000000000..24825672dee3
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/scoring.ts
@@ -0,0 +1,205 @@
+import { capabilityTags, overlaps, shared, tags, unit, usableIntents } from "./eligibility.js";
+import { type MatchingGraph, warmPath } from "./graph.js";
+import type {
+  GeneratorKind,
+  MatchingConfig,
+  MatchingInput,
+  MatchMember,
+  ScoreComponents,
+  TimeWindow,
+} from "./types.js";
+
+const DAY = 86_400_000;
+
+function preferenceTags(member: MatchMember, now: number): string[] {
+  return [
+    ...new Set([
+      ...usableIntents(member, now).flatMap((intent) => intent.tags),
+      ...member.facts
+        .filter(
+          (fact) =>
+            fact.scope !== "agent_private" &&
+            !["skill", "capability", "offer"].includes(fact.kind ?? ""),
+        )
+        .flatMap((fact) => fact.tags),
+    ]),
+  ];
+}
+
+/** Inspectable local utility estimates, not probabilities or observed member value. */
+export function participantBenefits(
+  members: MatchMember[],
+  relevantTags: string[],
+  now: number,
+  generator: GeneratorKind,
+): Array<{ memberId: string; benefit: number }> {
+  return members.map((member) => {
+    const others = members.filter((other) => other.memberId !== member.memberId);
+    const intents = usableIntents(member, now);
+    const needs = shared(
+      intents.flatMap((intent) => intent.needs),
+      relevantTags,
+    );
+    // Ability can satisfy a requester. Only an explicit offer expresses a helper's willingness.
+    const offers = member.receiving
+      ? []
+      : shared(
+          [
+            ...intents.flatMap((intent) => intent.offers),
+            ...member.facts
+              .filter((fact) => fact.scope !== "agent_private" && fact.kind === "offer")
+              .flatMap((fact) => fact.tags),
+          ],
+          relevantTags,
+        );
+    const preferences = shared(preferenceTags(member, now), relevantTags);
+    return {
+      memberId: member.memberId,
+      benefit: Math.max(
+        shared(
+          needs,
+          others.flatMap((other) => capabilityTags(other, now)),
+        ).length / Math.max(1, needs.length),
+        shared(
+          offers,
+          others.flatMap((other) => usableIntents(other, now).flatMap((intent) => intent.needs)),
+        ).length / Math.max(1, offers.length),
+        generator === "help" || generator === "intent_capability"
+          ? 0
+          : shared(
+              preferences,
+              others.flatMap((other) => preferenceTags(other, now)),
+            ).length / Math.max(1, preferences.length),
+      ),
+    };
+  });
+}
+
+function reciprocalBenefit(benefits: number[]): number {
+  if (benefits.length < 2 || benefits.some((benefit) => benefit === 0)) return 0;
+  if (benefits.length === 2) {
+    const [first = 0, second = 0] = benefits;
+    return (2 * first * second) / (first + second);
+  }
+  return Math.min(
+    benefits.reduce((sum, benefit) => sum + benefit, 0) / benefits.length,
+    2 * Math.min(...benefits),
+  );
+}
+
+export function pairFit(
+  a: MatchMember,
+  b: MatchMember,
+  now: number,
+  opportunity?: { relevantTags: string[]; generator: GeneratorKind },
+): number {
+  return reciprocalBenefit(
+    participantBenefits(
+      [a, b],
+      opportunity?.relevantTags ?? shared(tags(a, now), tags(b, now)),
+      now,
+      opportunity?.generator ?? "shared_intent",
+    ).map((participant) => participant.benefit),
+  );
+}
+export function evidenceFor(
+  members: MatchMember[],
+  relevantTags: string[],
+): Array<{ id: string; text: string }> {
+  // Only explicitly shareable facts can appear in explanations, logs, judge inputs or replay.
+  return members
+    .flatMap((member) =>
+      member.facts
+        .filter(
+          (fact) =>
+            fact.scope === "shareable" &&
+            fact.confidence >= 0.5 &&
+            shared(fact.tags, relevantTags).length,
+        )
+        .map((fact) => ({ id: fact.id, text: fact.text })),
+    )
+    .sort((a, b) => a.id.localeCompare(b.id));
+}
+export function scoreCandidate(
+  input: MatchingInput,
+  members: MatchMember[],
+  generator: GeneratorKind,
+  relevantTags: string[],
+  window: TimeWindow,
+  graph: MatchingGraph,
+): ScoreComponents {
+  const pairs = members.flatMap((member, i) =>
+    members.slice(i + 1).map((other) => [member, other] as const),
+  );
+  const mean = (values: number[]) =>
+    values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
+  const fit =
+    members.length === 1
+      ? 0.6
+      : mean(pairs.map(([a, b]) => pairFit(a, b, input.now, { relevantTags, generator })));
+  const benefits = participantBenefits(members, relevantTags, input.now, generator);
+  // Solo activity/growth proposals retain their own preference value, with no reciprocal claim.
+  const solo = members.length === 1 ? members[0] : undefined;
+  const mutualBenefit = solo
+    ? (shared(preferenceTags(solo, input.now), relevantTags).length /
+        Math.max(1, new Set(relevantTags).size)) *
+      (generator === "growth" ? 0.55 : 0.6)
+    : reciprocalBenefit(benefits.map((participant) => participant.benefit));
+  const evidence = members.flatMap((member) =>
+    member.facts.filter(
+      (fact) => fact.scope !== "agent_private" && shared(fact.tags, relevantTags).length,
+    ),
+  );
+  const recentSamePairs = input.history.filter(
+    (history) =>
+      history.outcome === "completed" &&
+      history.at > input.now - 30 * DAY &&
+      members.every((member) => history.memberIds.includes(member.memberId)),
+  ).length;
+  return {
+    fit,
+    mutualBenefit,
+    warmPath: mean(pairs.map(([a, b]) => (warmPath(graph, a.memberId, b.memberId) ? 1 : 0))),
+    novelty:
+      generator === "expansion"
+        ? 1
+        : members.some((member) => member.recentExposure === 0)
+          ? 0.7
+          : 0.3,
+    timingFit: members.every(
+      (member) =>
+        !member.availability.length ||
+        member.availability.some((available) => overlaps(available, window)),
+    )
+      ? 1
+      : 0,
+    activationCost: unit((window.start - input.now) / (30 * DAY)) * 0.2,
+    interruptionCost: mean(members.map((member) => unit(member.recentExposure / 6))),
+    load: mean(members.map((member) => unit(member.givingLoad / 6))),
+    repetition: unit(recentSamePairs / 5),
+    socialRisk: members.length > 2 ? 0.15 : 0.25,
+    confidence: evidence.length
+      ? mean(
+          evidence.map(
+            (fact) =>
+              fact.confidence * Math.max(0.4, 1 - (input.now - fact.confirmedAt) / (180 * DAY)),
+          ),
+        )
+      : 0.6,
+  };
+}
+export function totalScore(components: ScoreComponents, config: MatchingConfig): number {
+  const positive = ["fit", "mutualBenefit", "warmPath", "novelty", "timingFit"] as const;
+  const negative = [
+    "activationCost",
+    "interruptionCost",
+    "load",
+    "repetition",
+    "socialRisk",
+  ] as const;
+  return (
+    (positive.reduce((sum, key) => sum + components[key] * config.weights[key], 0) -
+      negative.reduce((sum, key) => sum + components[key] * config.weights[key], 0)) *
+    components.confidence
+  );
+}
