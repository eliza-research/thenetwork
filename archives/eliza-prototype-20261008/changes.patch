@@ -0,0 +1,39 @@
+import { Button } from "../components/ui/button";
+import type { NetworkAction } from "./api";
+
+export function NetworkActionButtons({
+  actions,
+  onChoose,
+}: {
+  actions?: NetworkAction[];
+  onChoose: (action: NetworkAction) => void;
+}) {
+  if (!actions?.length) return null;
+  return (
+    <div className="nw-actions">
+      {actions.map((action) =>
+        action.type === "download_artifact" &&
+        typeof action.args?.exportId === "string" &&
+        typeof action.args?.kind === "string" ? (
+          <a
+            className="nw-button nw-button-secondary"
+            key={`${action.type}-${action.args.exportId}-${action.args.kind}`}
+            href={`/api/network/admin/artifact?${new URLSearchParams({ exportId: action.args.exportId, kind: action.args.kind }).toString()}`}
+            download
+          >
+            {action.label}
+          </a>
+        ) : (
+          <Button
+            unstyled
+            className="nw-button nw-button-secondary"
+            key={`${action.type}-${JSON.stringify(action.args ?? {})}-${action.label}`}
+            onClick={() => onChoose(action)}
+          >
+            {action.label}
+          </Button>
+        ),
+      )}
+    </div>
+  );
+}
