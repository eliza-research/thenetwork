+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from "vitest";
+
+const { mount, portal, workbench } = vi.hoisted(() => ({
+  mount: vi.fn(),
+  portal: vi.fn(),
+  workbench: vi.fn(),
+}));
+vi.mock("react-dom/client", () => ({ createRoot: () => ({ render: mount }) }));
+vi.mock("./NetworkPortal", () => ({ NetworkPortal: portal }));
+vi.mock("./NetworkWorkbench", () => ({ NetworkWorkbench: workbench }));
+
+afterEach(() => {
+  document.body.innerHTML = "";
+  history.replaceState(null, "", "/");
+  vi.clearAllMocks();
+  vi.resetModules();
+});
+
+it.each(["/", "/portal", "/friend-help", "/slop-love"])(
+  "keeps %s on the member landing",
+  async (path) => {
+    document.body.innerHTML = '<div id="network-root"></div>';
+    history.replaceState(null, "", path);
+    await import("./entry");
+    expect(mount.mock.calls[0][0].type).toBe(portal);
+  },
+);
+
+it("opens /admin on the existing graph without providing fixture authority", async () => {
+  document.body.innerHTML = '<div id="network-root"></div>';
+  history.replaceState(null, "", "/admin");
+  await import("./entry");
+  expect(mount.mock.calls[0][0].type).toBe(workbench);
+  expect(mount.mock.calls[0][0].props).toEqual({
+    initialMode: "admin",
+    initialModule: "graph",
+  });
+});
+
+it("retains the explicit internal /workbench entry", async () => {
+  document.body.innerHTML = '<div id="network-root"></div>';
+  history.replaceState(null, "", "/workbench");
+  await import("./entry");
+  expect(mount.mock.calls[0][0].type).toBe(workbench);
+  expect(mount.mock.calls[0][0].props).toEqual({});
+});
