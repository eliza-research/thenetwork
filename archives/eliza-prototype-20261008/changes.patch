+                ),
+              ]
+            : [],
+      })),
+    emptyMessage: "No fresh authored public source fits your confirmed presence.",
+  });
+  if (domainView.member.age !== "adult")
+    result.sections = result.sections.filter(
+      (section) => !["coordination", "unmatched"].includes(section.id),
+    );
+  return result;
+}
