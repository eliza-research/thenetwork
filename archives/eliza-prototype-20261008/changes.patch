+import { expect, it } from "vitest";
+import { NetworkDomain } from "../domain/service.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import { NetworkMockTransport } from "./mock-transport.ts";
+
+it("recovers a committed invitation after quiet hours, with one exposure and one durable delivery", async () => {
+  const clock = new SimClock(Date.parse("2026-10-05T18:00:00.000Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:invitation-recovery",
+    clock,
+  });
+  try {
+    const personas = await seedSimulationMembers(host.domain, 100, 42);
+    const first = personas[0].memberId;
+    const second = personas[2].memberId;
+    const settings = await host.domain.getSettings({ type: "system" });
+    const { revision, ...values } = settings;
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "configure",
+        requestId: "configure",
+        expectedRevision: revision,
+        settings: { ...values, proactiveCities: { SF: true, NYC: true } },
+      },
+    );
+    await host.domain.command(
+      { type: "member", memberId: first },
+      {
+        type: "set_preferences",
+        requestId: "quiet",
+        memberId: first,
+        preferences: { quietHours: { start: "11:00", end: "12:00" } },
+      },
+    );
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "create_opportunity",
+        requestId: "create",
+        draft: {
+          id: "recovery",
+          kind: "intro",
+          objective: "Meet another musician in a public place",
+          category: "music",
+          city: "SF",
+          participantIds: [first, second],
+          backupIds: [],
+          quorum: 2,
+          expiresAt: "2026-10-08T18:00:00.000Z",
+          explanations: Object.fromEntries(
+            [first, second].map((id) => [
+              id,
+              { text: "Would you like a low-pressure introduction?", factIds: [] },
+            ]),
+          ),
+          safetyClass: "low",
+          requiresHomeEntry: false,
+          acquaintedHelperIds: [],
+          anchorEventId: null,
+        },
+      },
+    );
+    await host.domain.command(
+      { type: "staff", userId: "reviewer", roles: ["reviewer"] },
+      {
+        type: "review_opportunity",
+        requestId: "review",
+        opportunityId: "recovery",
+        expectedRevision: 1,
+        decision: "approved",
+        reasonCode: "approved",
+        note: "Specific reviewed public introduction",
+      },
+    );
+    expect(await host.transport.advanceInvitations("recovery")).toEqual({
+      processed: 0,
+      pending: true,
+    });
+    const invitation = await host.domain.getOpportunity({ type: "system" }, "recovery");
+    if (!("participants" in invitation)) throw new Error("Trusted opportunity required");
+    expect(invitation.participants[0].invitedAt).toBe(clock.now().toISOString());
+    expect(invitation.participants[1].invitedAt).toBeNull();
+    expect(await host.transport.messages()).toHaveLength(0);
+    clock.advanceTo("2026-10-05T19:00:00.000Z");
+    expect(await host.transport.advanceInvitations("recovery")).toEqual({
