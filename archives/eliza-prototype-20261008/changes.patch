+    });
+    expect(await host.transport.messages()).toEqual(original);
+    expect(
+      await host.db.execute(
+        "SELECT sequence FROM network.events WHERE network_id='test:invitation-recovery' AND payload->>'kind'='outbound_accepted'",
+      ),
+    ).toHaveLength(1);
+    expect(
+      await host.db.execute(
+        "SELECT id FROM network.proactive_receipts WHERE network_id='test:invitation-recovery'",
+      ),
+    ).toHaveLength(1);
+    const otherDomain = new NetworkDomain({ db: host.db, clock, networkId: "test:other-network" });
+    expect(await new NetworkMockTransport(host.runtime, otherDomain, clock).messages()).toEqual([]);
+    await host.domain.command(
+      { type: "member", memberId: first },
+      {
+        type: "respond_opportunity",
+        requestId: "accept",
+        memberId: first,
+        opportunityId: "recovery",
+        expectedRevision: 1,
+        accept: true,
+        disclosure: { revision: 1, factIds: [], contact: false, preciseVenue: false },
+      },
+    );
+    expect(await host.transport.advanceInvitations("recovery")).toEqual({
+      processed: 1,
+      pending: false,
+    });
+    expect((await host.transport.messages()).map((message) => message.memberId)).toEqual([
