+import type { MatchingInput, MatchMember } from "./types.js";
+
+export const NOW = Date.parse("2026-10-05T18:00:00Z"),
+  DAY = 86_400_000;
+export function testMember(index: number, patch: Partial<MatchMember> = {}): MatchMember {
+  return {
+    memberId: `00000000-0000-4000-8000-${String(index).padStart(12, "0")}`,
+    profileRevision: 1,
+    age: "adult",
+    state: "active",
+    safetyHold: false,
+    receiving: false,
+    categoryOptOuts: [],
+    blockedIds: [],
+    presence: [{ city: "SF", start: NOW - DAY, end: NOW + 100 * DAY }],
+    availability: [],
+    intents: [
+      {
+        id: `i${index}`,
+        category: "music",
+        tags: ["jazz"],
+        needs: ["guitar"],
+        offers: ["guitar"],
+        kind: "activity",
+        safetyClass: "low",
+        createdAt: NOW - 20 * DAY,
+        expiresAt: NOW + 90 * DAY,
+      },
+    ],
+    facts: [
+      {
+        id: `f${index}`,
+        text: "I enjoy jazz",
+        tags: ["jazz", "guitar"],
+        scope: "shareable",
+        confidence: 0.95,
+        confirmedAt: NOW,
+      },
+      {
+        id: `secret${index}`,
+        text: `CANARY_PRIVATE_${index}`,
+        tags: ["jazz"],
+        scope: "agent_private",
+        confidence: 1,
+        confirmedAt: NOW,
+      },
+    ],
+    cluster: `c${index % 3}`,
+    roles: ["host", "connector"],
+    joinedAt: NOW - DAY,
+    romanceOptIn: false,
+    romanceAllowedMemberIds: [],
+    givingLoad: 0,
+    recentExposure: 0,
+    unansweredProposals: 0,
+    maxTravelMinutes: 45,
+    explorationFraction: 0.15,
+    budgets: [{ windowMs: 7 * DAY, max: 2 }],
+    ...patch,
+  };
+}
+export function testInput(count = 6): MatchingInput {
+  return {
+    runId: "test-run",
+    city: "SF",
+    now: NOW,
+    window: { start: NOW + DAY, end: NOW + 2 * DAY },
+    seed: 42,
+    members: Array.from({ length: count }, (_, index) => testMember(index + 1)),
+    edges: [],
+    history: [],
+    events: [],
+    growthGaps: [],
+    modelVersions: { matcher: "deterministic-local-1" },
+  };
+}
