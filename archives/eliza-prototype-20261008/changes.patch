+import { describe, expect, it } from "vitest";
+import { SimClock, seededRandom } from "./fixtures.js";
+import { metricRate, type NetworkMetricObservation, summarizeNetworkMetrics } from "./metrics.js";
+
+describe("Network evaluation denominators and virtual time", () => {
+  it("keeps nonresponders in the all-sent worthwhile rate and reports uncertainty", () => {
+    const base = {
+      memberId: "member",
+      city: "SF",
+      cohort: "newcomer",
+      at: "2026-10-01T18:00:00.000Z",
+    };
+    const observations: NetworkMetricObservation[] = [
+      { ...base, event: "activated" },
+      ...["one", "two", "three"].map((opportunityId) => ({
+        ...base,
+        opportunityId,
+        event: "proposal_sent" as const,
+      })),
+      { ...base, opportunityId: "one", event: "worthwhile_yes" },
+    ];
+    const result = summarizeNetworkMetrics(
+      observations,
+      "2026-10-01T00:00:00.000Z",
+      "2026-10-10T00:00:00.000Z",
+    );
+    expect(result.worthwhileRespondents.rate).toBe(1);
+    expect(result.worthwhileAllSent.rate).toBeCloseTo(1 / 3);
+    expect(result.missingWorthwhile).toBe(2);
+    expect(result.worthwhileRespondents.interval95?.[0]).toBeLessThan(0.3);
+    expect(result.firstValue14Days.rate).toBeNull();
+    expect(result.censored14DayMembers).toBe(1);
+  });
+  it("uses mature 14-day and 60-day observation cohorts, without turning early positives into retention", () => {
+    const base = { memberId: "member", city: "NYC", cohort: "parent" };
+    const observations: NetworkMetricObservation[] = [
+      { ...base, event: "activated", at: "2026-07-01T00:00:00.000Z" },
+      { ...base, event: "meaningful_value", at: "2026-07-10T00:00:00.000Z" },
+      {
+        ...base,
+        event: "positive_meeting",
+        at: "2026-07-10T00:00:00.000Z",
+        pairId: "member/partner-a",
+        opportunityId: "first",
+      },
+      {
+        ...base,
+        event: "second_interaction",
+        at: "2026-08-01T00:00:00.000Z",
+        pairId: "member/partner-a",
+        opportunityId: "second",
+      },
+    ];
+    const result = summarizeNetworkMetrics(
+      observations,
+      "2026-07-01T00:00:00.000Z",
+      "2026-10-01T00:00:00.000Z",
+    );
+    expect(result.firstValue14Days.rate).toBe(1);
+    expect(result.repeat60Days.rate).toBe(1);
+    const early = summarizeNetworkMetrics(
+      observations,
+      "2026-07-01T00:00:00.000Z",
+      "2026-08-02T00:00:00.000Z",
+    );
+    expect(early.repeat60Days.rate).toBeNull();
+    expect(early.censored60DayPositiveMeetings).toBe(1);
+    observations[3] = {
+      ...(observations[3] as NetworkMetricObservation),
+      pairId: "member/partner-b",
+    };
+    expect(
+      summarizeNetworkMetrics(observations, "2026-07-01T00:00:00.000Z", "2026-10-01T00:00:00.000Z")
+        .repeat60Days.rate,
+    ).toBe(0);
+  });
+  it("rejects impossible metrics instead of inventing denominators", () => {
+    expect(() => metricRate(2, 1)).toThrow();
+    expect(metricRate(0, 0).rate).toBeNull();
+  });
+  it("replays seeded persona outcomes and never reads or moves the real clock", () => {
+    const first = seededRandom(42),
+      second = seededRandom(42);
+    expect(Array.from({ length: 20 }, first)).toEqual(Array.from({ length: 20 }, second));
+    const clock = new SimClock(1000);
+    clock.advanceTo(2000);
+    expect(clock.now().getTime()).toBe(2000);
+    expect(() => clock.advanceTo(1000)).toThrow("backwards");
+  });
+});
diff --git a/packages/cloud/shared/src/lib/network/evaluation/metrics.ts b/packages/cloud/shared/src/lib/network/evaluation/metrics.ts
new file mode 100644
index 000000000000..2fbf7eecdab6
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/evaluation/metrics.ts
@@ -0,0 +1,132 @@
+/** Explicit denominators retain missing responses; synthetic outcomes never establish real pilot value. */
+export interface NetworkMetricObservation {
+  memberId: string;
+  city: string;
+  cohort: string;
+  at: string;
+  event:
+    | "activated"
+    | "proposal_sent"
+    | "proposal_accepted"
+    | "mutually_accepted"
+    | "completed"
+    | "worthwhile_yes"
+    | "worthwhile_no"
+    | "mute_or_complaint"
+    | "invited_member"
+    | "meaningful_value"
+    | "positive_meeting"
+    | "second_interaction";
+  opportunityId?: string;
+  /** Canonical sorted member-ID pair; member-only history cannot establish a second encounter. */
+  pairId?: string;
+}
+export interface MetricRate {
+  numerator: number;
+  denominator: number;
+  rate: number | null;
+  interval95: [number, number] | null;
+}
+export function metricRate(numerator: number, denominator: number): MetricRate {
+  if (
+    !Number.isSafeInteger(numerator) ||
+    !Number.isSafeInteger(denominator) ||
+    numerator < 0 ||
+    denominator < 0 ||
+    numerator > denominator
+  )
+    throw new Error("Invalid metric numerator or denominator");
+  if (!denominator) return { numerator, denominator, rate: null, interval95: null };
+  const z = 1.96,
+    p = numerator / denominator,
+    d = 1 + (z * z) / denominator;
+  const center = (p + (z * z) / (2 * denominator)) / d,
+    margin =
+      (z * Math.sqrt((p * (1 - p)) / denominator + (z * z) / (4 * denominator * denominator))) / d;
+  return {
+    numerator,
+    denominator,
+    rate: p,
+    interval95: [Math.max(0, center - margin), Math.min(1, center + margin)],
+  };
+}
+export function summarizeNetworkMetrics(
+  observations: NetworkMetricObservation[],
+  startAt: string,
+  endAt: string,
+): {
+  window: { startAt: string; endAt: string; interval: "start_inclusive_end_exclusive" };
+  optIn: MetricRate;
+  completion: MetricRate;
+  worthwhileRespondents: MetricRate;
+  worthwhileAllSent: MetricRate;
+  missingWorthwhile: number;
+  muteOrComplaint: MetricRate;
+  invitationParticipation: MetricRate;
+  firstValue14Days: MetricRate;
+  repeat60Days: MetricRate;
+  censored14DayMembers: number;
+  censored60DayPositiveMeetings: number;
+  unattributedPositiveMeetings: number;
+} {
+  const start = Date.parse(startAt),
+    end = Date.parse(endAt),
+    DAY = 86_400_000;
+  if (!Number.isFinite(start) || !Number.isFinite(end) || start >= end)
+    throw new Error("Invalid metric observation window");
+  const selected = observations.filter(
+    (entry) => Date.parse(entry.at) >= start && Date.parse(entry.at) < end,
+  );
+  const count = (event: NetworkMetricObservation["event"]) =>
+    selected.filter((entry) => entry.event === event).length;
+  const distinct = (event: NetworkMetricObservation["event"]) =>
+    new Set(selected.filter((entry) => entry.event === event).map((entry) => entry.memberId));
+  const sent = count("proposal_sent"),
+    answered = count("worthwhile_yes") + count("worthwhile_no");
+  const activated = selected.filter((entry) => entry.event === "activated");
+  const mature = activated.filter((entry) => Date.parse(entry.at) <= end - 14 * DAY);
+  const withFirstValue = mature.filter((entry) =>
+    selected.some(
+      (value) =>
+        value.event === "meaningful_value" &&
+        value.memberId === entry.memberId &&
+        Date.parse(value.at) >= Date.parse(entry.at) &&
+        Date.parse(value.at) <= Date.parse(entry.at) + 14 * DAY,
+    ),
+  );
+  const positiveRows = selected.filter((entry) => entry.event === "positive_meeting");
+  const firstPositiveByPair = new Map<string, NetworkMetricObservation>();
+  for (const entry of [...positiveRows].sort((a, b) => Date.parse(a.at) - Date.parse(b.at)))
+    if (entry.pairId && !firstPositiveByPair.has(entry.pairId))
+      firstPositiveByPair.set(entry.pairId, entry);
+  const positive = [...firstPositiveByPair.values()],
+    maturePositive = positive.filter((entry) => Date.parse(entry.at) <= end - 60 * DAY);
+  const repeated = maturePositive.filter((entry) =>
+    selected.some(
+      (value) =>
+        value.event === "second_interaction" &&
+        value.pairId === entry.pairId &&
+        value.opportunityId !== entry.opportunityId &&
+        Date.parse(value.at) > Date.parse(entry.at) &&
+        Date.parse(value.at) <= Date.parse(entry.at) + 60 * DAY,
+    ),
+  );
+  return {
+    window: { startAt, endAt, interval: "start_inclusive_end_exclusive" },
+    optIn: metricRate(count("proposal_accepted"), sent),
+    completion: metricRate(count("completed"), count("mutually_accepted")),
+    worthwhileRespondents: metricRate(count("worthwhile_yes"), answered),
+    worthwhileAllSent: metricRate(count("worthwhile_yes"), sent),
+    missingWorthwhile: Math.max(0, sent - answered),
+    muteOrComplaint: metricRate(distinct("mute_or_complaint").size, distinct("activated").size),
+    invitationParticipation: metricRate(
+      distinct("invited_member").size,
+      distinct("activated").size,
+    ),
+    firstValue14Days: metricRate(withFirstValue.length, mature.length),
+    repeat60Days: metricRate(repeated.length, maturePositive.length),
+    censored14DayMembers: activated.length - mature.length,
+    censored60DayPositiveMeetings: positive.length - maturePositive.length,
+    unattributedPositiveMeetings: positiveRows.filter((entry) => !entry.pairId).length,
+  };
+}
diff --git a/packages/cloud/shared/src/lib/network/evaluation/native-cadence.study.test.ts b/packages/cloud/shared/src/lib/network/evaluation/native-cadence.study.test.ts
