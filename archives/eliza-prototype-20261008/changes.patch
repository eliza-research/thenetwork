+    expect(review.metrics).toContainEqual({ label: "Measured review time (mean ms)", value: 3000 });
+    expect(JSON.stringify(review)).not.toContain("PRIVATE_REVIEW_BODY");
+    expect(JSON.stringify(review)).not.toContain("PRIVATE_BLIND_BODY");
+    const blinded = await localAdminView(
+      host,
+      { type: "staff", userId: "fresh-independent", roles: ["reviewer"] },
+      new URLSearchParams({ module: "review", blind: "1" }),
