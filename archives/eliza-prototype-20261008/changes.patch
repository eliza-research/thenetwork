+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { NetworkGraph } from "./NetworkGraph";
+import { NetworkPipeline } from "./NetworkPipeline";
+
+afterEach(cleanup);
+
+describe("Network graph and opportunity pipeline projections", () => {
+  it("inspects a real edge by SVG link and filters connection types with a readable alternative", () => {
+    render(
+      <NetworkGraph
+        graph={{
+          nodes: [
+            { id: "a", label: "Member A", x: 0, y: 0 },
+            { id: "b", label: "Member B", x: 100, y: 80 },
+            { id: "c", label: "Member C", x: 100, y: -80 },
+          ],
+          edges: [
+            { id: "ab", source: "a", target: "b", label: "met" },
+            { id: "ac", source: "a", target: "c", label: "invited" },
+          ],
+        }}
+      />,
+    );
+    fireEvent.click(screen.getByRole("link", { name: "Inspect Member A" }));
+    expect(screen.getByText("met: Member B")).toBeTruthy();
+    expect(screen.getByText("invited: Member C")).toBeTruthy();
+    fireEvent.change(screen.getByLabelText("Connection type"), {
+      target: { value: "met" },
+    });
+    expect(screen.queryByText("invited: Member C")).toBeNull();
+    expect(screen.getByRole("img").getAttribute("aria-label")).toContain(
+      "1 recorded connections",
+    );
+  });
+  it("finds a graph member without inventing new nodes or edges", () => {
+    render(
+      <NetworkGraph
+        graph={{
+          nodes: [
+            { id: "a", label: "Member A", x: 0, y: 0 },
+            { id: "b", label: "Member B", x: 100, y: 80 },
+          ],
+          edges: [],
+        }}
+      />,
+    );
+    fireEvent.change(screen.getByRole("searchbox"), {
+      target: { value: "Member B" },
+    });
+    expect(screen.queryByRole("button", { name: "Member A" })).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Member B" }));
+    expect(
+      screen.getByText("No recorded connections match this filter."),
+    ).toBeTruthy();
+  });
+  it("shows exact authoritative pipeline states and forwards only supplied commands", () => {
+    const choose = vi.fn();
+    const action = {
+      type: "review_opportunity",
+      label: "Review",
+      fields: [],
+      args: { opportunityId: "o1", expectedRevision: 3 },
+    };
+    render(
+      <NetworkPipeline
+        rows={[
+          {
+            id: "o1",
+            title: "Start a band",
+            status: "in_review",
+            fields: {},
+            actions: [action],
+          },
+          { id: "o2", title: "Park walk", status: "scheduled", fields: {} },
+        ]}
+        onChoose={choose}
+      />,
+    );
+    expect(screen.getByRole("region", { name: "in review" })).toBeTruthy();
+    expect(screen.getByRole("region", { name: "scheduled" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Review" }));
+    expect(choose).toHaveBeenCalledWith(action);
+    fireEvent.change(screen.getByRole("searchbox"), {
+      target: { value: "band" },
+    });
+    expect(screen.queryByRole("heading", { name: "Park walk" })).toBeNull();
+  });
+});
