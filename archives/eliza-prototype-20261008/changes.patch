+      "Matching-only and agent-private fact text must not appear in explanations.",
+    ],
+  },
+  {
+    id: "opportunity-scope",
+    scenario: "A guitar exchange must not claim benefit for an unrelated sailing opportunity.",
+    candidates: [
+      {
+        id: "guitar",
+        generator: "help",
+        relevantTags: ["guitar"],
+        members: [requester, willingHelper],
+      },
+      {
+        id: "sailing",
+        generator: "help",
+        relevantTags: ["sailing"],
+        members: [requester, willingHelper],
+      },
+    ],
+    expectedOrder: ["guitar", "sailing"],
+    constraints: ["Only the proposed tags can fulfill needs or offers."],
+  },
+  {
+    id: "solo-preference",
+    scenario:
+      "A solo connector proposal has own relevant preference value, with no peer reciprocity.",
+    candidates: [
+      { id: "relevant", generator: "growth", relevantTags: ["jazz"], members: [solo] },
+      { id: "unknown", generator: "growth", relevantTags: ["sailing"], members: [solo] },
