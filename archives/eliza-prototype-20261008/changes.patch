+import { createLocalNetworkHost } from "./host.ts";
+
+it("roundtrips complete32MiB Unicode history through genuine part-row Parquet, saved SQL, checksums and deletion fences", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "network-complete-large-export-"));
+  vi.stubEnv("ELIZA_STATE_DIR", directory);
+  const clock = new SimClock(Date.parse("2026-10-06T19:00:00.000Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: `test:large-export:${randomUUID()}`,
+    clock,
+  });
+  const actor = { type: "staff", userId: "large-export-analyst", roles: ["analyst"] } as const;
+  const staff = { ...actor, roles: [...actor.roles] };
+  try {
+    const members = await seedSimulationMembers(host.domain, 3, 91);
+    const text = "🐙".repeat(16 * 1024 * 1024) + " COMPLETE_LAST_RECORD private.person@example.com";
+    const run = {
+      id: "complete-large-history",
+      city: "SF",
+      inputDigest: "a".repeat(64),
+      createdAt: clock.now().toISOString(),
+      log: { text, sentinel: "COMPLETE_FINAL_FIELD", otherRecords: [{ index: 0 }, { index: 1 }] },
+    };
+    const store = new DomainStore(host.db.execute, host.domain.options.networkId);
+    await store.save("matching_runs", run.id, run, clock.now().toISOString());
+    const before = await store.get<typeof run>("matching_runs", run.id);
+    const sourceHash = createHash("sha256").update(JSON.stringify(before)).digest("hex");
+    const data = new NetworkDataExport({
+      domain: host.domain,
+      scheduler: host.runner,
+      clock,
+      writer: localNetworkExportWriter,
+      graph: host.native.adminGraph,
+    });
+    const exported = await data.export(staff, "large-complete");
+    const downloaded = await data.artifact(staff, exported.exportId, "parquet");
+    expect(Buffer.from(downloaded.bytes).subarray(0, 4).toString()).toBe("PAR1");
+    expect(Buffer.from(downloaded.bytes).subarray(-4).toString()).toBe("PAR1");
+    expect(exported.parquet.hash).toBe(createHash("sha256").update(downloaded.bytes).digest("hex"));
+    const view = await data.readSnapshot(staff);
+    const retained = view.snapshot.matchingRuns.find((value) => value.id === run.id)
+      ?.log as typeof run.log;
+    expect(retained.text.startsWith("🐙")).toBe(true);
+    expect(
+      createHash("sha256")
+        .update(retained.text.slice(0, 32 * 1024 * 1024))
+        .digest("hex"),
+    ).toBe(
+      createHash("sha256")
+        .update(text.slice(0, 32 * 1024 * 1024))
+        .digest("hex"),
+    );
+    expect(retained.text).not.toContain("private.person@example.com");
+    expect(retained.sentinel).toBe(run.log.sentinel);
+    expect(retained.otherRecords).toEqual(run.log.otherRecords);
+    expect((await data.runNotebook(staff, "exposure")).rows).toHaveLength(3);
+    expect(
+      createHash("sha256")
+        .update(JSON.stringify(await store.get<typeof run>("matching_runs", run.id)))
+        .digest("hex"),
+    ).toBe(sourceHash);
+    await host.domain.command(
+      { type: "member", memberId: members[0].memberId },
+      { type: "delete_account", requestId: "large-source-delete", memberId: members[0].memberId },
+    );
+    await expect(data.artifact(staff, exported.exportId, "parquet")).rejects.toMatchObject({
+      code: "NETWORK_EXPIRED",
+    });
+    expect(await data.invalidateDeleted()).toBe(1);
+    expect(readPrivateMediaBytes(exported.parquet.fileName)).toBeNull();
+  } finally {
+    await host.close();
+    vi.unstubAllEnvs();
+    await rm(directory, { recursive: true, force: true });
+  }
+}, 120000);
