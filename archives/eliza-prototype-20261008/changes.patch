+import { randomUUID } from "node:crypto";
+import type { CommittedEffectReceipt } from "@elizaos/core";
+import { sqlJson, sqlQuote } from "@elizaos/plugin-sql";
+import { readRelaySafetyEvidence } from "../coordination/service.ts";
+import { networkDigest } from "../digest";
+import {
+  active,
+  assertKnownDisclosure,
+  assertReplayLog,
+  availableOpportunityMemberIds,
+  bump,
+  consentedOpportunityMemberIds,
+  DAY,
+  dateAfter,
+  defaultSettings,
+  defaults,
+  denied,
+  hasRequiredOpportunityMembers,
+  localWindowStart,
+  minimumAgeConfirmed,
+  networkSafetyClass,
+  owner,
+  projectMemberOpportunity,
+  publicFact,
+  readyInvitationMemberIds,
+  reasonCodes,
+  receivingParticipantAllowed,
+  scrubNetworkProjection,
+  staff,
+  staffMemberView,
+  transitions,
+  validatePreferences,
+} from "./policy";
+import { initializeNetworkSchema } from "./schema";
+import { activeOpportunityKey, DomainStore, payload, terminalStates } from "./store";
+import {
+  type AttendanceEvidence,
+  type EngineSnapshot,
+  type Feedback,
+  type MemberOpportunityView,
+  type MemberView,
+  type NetworkActor,
+  type NetworkAdminSnapshot,
+  type NetworkCommand,
+  type NetworkCommandResult,
+  NetworkDomainError,
+  type NetworkDomainOptions,
+  type NetworkEvent,
+  type NetworkInvite,
+  type NetworkMatchingRun,
+  type NetworkMember,
+  type NetworkOpportunity,
+  type NetworkRequestProof,
+  type NetworkSettings,
+  type OpportunityDraft,
+  type SafetyCase,
+} from "./types";
+import { invalid, parseNetworkCommand, strings, text } from "./validation";
+
+/** Domain ownership only. The host composes graph learning, transport, calendar and scheduler. */
+export class NetworkDomain {
+  constructor(readonly options: NetworkDomainOptions) {
+    text(options.networkId, "networkId", 160);
+  }
+  private now(): string {
+    const now = this.options.clock.now();
+    if (!(now instanceof Date) || !Number.isFinite(now.getTime()))
+      invalid("Clock returned invalid time");
+    return now.toISOString();
+  }
+  async initializeLocalSchema(): Promise<void> {
+    await this.options.db.transaction(async (execute) => {
+      await initializeNetworkSchema(execute);
+      await execute(
+        `INSERT INTO network.domains(network_id,schema_version) VALUES (${sqlQuote(this.options.networkId)},1) ON CONFLICT(network_id) DO NOTHING`,
+      );
+    });
+  }
+  /** Trusted host only: final dispatch and revoke checks share the exact owned SQL session. */
+  async withAuthority<T>(
+    work: (domain: NetworkDomain, db: NetworkDomainOptions["db"]) => Promise<T>,
+  ): Promise<T> {
+    return this.options.db.transaction(async (execute) => {
+      const domains = await execute(
+        `SELECT schema_version FROM network.domains WHERE network_id=${sqlQuote(this.options.networkId)} FOR UPDATE`,
+      );
+      if (!domains[0]) denied("Network schema is not initialized", "NETWORK_CONFLICT");
+      const db: NetworkDomainOptions["db"] = {
+        execute,
+        transaction: (operation) => operation(execute),
+      };
+      return work(new NetworkDomain({ ...this.options, db }), db);
+    });
+  }
+  async command(actor: NetworkActor, input: NetworkCommand): Promise<NetworkCommandResult> {
+    return (await this.commandWithReceipt(actor, input)).result;
+  }
+  async commandWithReceipt(
+    actor: NetworkActor,
+    input: NetworkCommand,
+  ): Promise<{ result: NetworkCommandResult; receipt: CommittedEffectReceipt }> {
+    const command = parseNetworkCommand(input);
+    this.validateActor(actor);
+    const at = this.now();
+    const commandDigest = networkDigest([actor, command]);
+    return this.options.db.transaction(async (execute) => {
+      const domains = await execute(
+        `SELECT schema_version FROM network.domains WHERE network_id=${sqlQuote(this.options.networkId)} FOR UPDATE`,
+      );
+      if (!domains[0]) denied("Network schema is not initialized", "NETWORK_CONFLICT");
+      const receipts = await execute(
+        `SELECT digest,digest_version,result,created_at FROM network.commands WHERE network_id=${sqlQuote(this.options.networkId)} AND request_id=${sqlQuote(command.requestId)}`,
+      );
+      if (receipts[0]) {
+        if (Number(receipts[0].digest_version) !== 2)
+          denied(
+            "Legacy command receipt requires reconciliation; no action replayed",
+            "NETWORK_IDEMPOTENCY",
+          );
+        if (receipts[0].digest !== commandDigest)
+          denied("Request key was used with different authority or content", "NETWORK_IDEMPOTENCY");
+        const persisted = receipts[0].result;
+        const result = (
+          typeof persisted === "string" ? JSON.parse(persisted) : persisted
+        ) as NetworkCommandResult;
+        if (
+          "kind" in result &&
+          ["member_data_removed", "invite_data_removed"].includes(result.kind)
+        )
+          denied(
+            "Original command data was erased; no current requested effect re-observed",
+            "NETWORK_IDEMPOTENCY",
+          );
+        return {
+          result,
+          receipt: {
+            receiptId: `network.command:${this.options.networkId}:${command.requestId}`,
+            operation: `network.${command.type}`,
+            resource: { kind: "network.command", id: command.requestId, version: "2" },
+            artifacts: [],
+            idempotency: { key: command.requestId, replayed: true },
+            observedAt: at,
+            outcome: "noop",
+            reason: "Verified original committed command receipt",
+          },
+        };
+      }
+      const store = new DomainStore(execute, this.options.networkId);
+      let result = await this.apply(store, actor, command, at);
+      await this.options.afterCommand?.(execute, command, result);
+      if (actor.type === "member" && "participantIds" in result)
+        result = projectMemberOpportunity(result, actor.memberId);
+      const memberIds = this.commandMemberIds(command, result);
+      const committed = await execute(
+        `INSERT INTO network.commands(network_id,request_id,digest,digest_version,result,member_ids,created_at) VALUES (${sqlQuote(this.options.networkId)},${sqlQuote(command.requestId)},${sqlQuote(commandDigest)},2,${sqlJson(result)}::jsonb,${sqlJson(memberIds)}::jsonb,${sqlQuote(at)}) RETURNING created_at`,
+      );
+      const committedAt =
+        committed[0]?.created_at instanceof Date
+          ? committed[0].created_at.toISOString()
+          : new Date(String(committed[0]?.created_at)).toISOString();
+      const event: NetworkEvent = {
+        id: command.requestId,
+        at,
+        actor,
+        kind: command.type,
+        memberIds,
+        opportunityId:
+          "opportunityId" in command
+            ? (command.opportunityId ?? null)
+            : command.type === "create_opportunity"
+              ? command.draft.id
+              : null,
+        details: {},
+      };
+      if (command.type === "attest_age" && command.ageBand === "under13")
+        event.kind = "delete_account";
+      if (command.type === "accept_invite" && "kind" in result && result.kind === "age_declined")
+        event.kind = "invite_data_removed";
+      if (command.type === "record_event") {
+        event.kind = command.kind;
+        event.memberIds = command.memberIds;
+        event.opportunityId = command.opportunityId;
+        event.details = command.details;
+      }
+      if (command.type === "review_opportunity" || command.type === "record_blind_review")
+        event.details = {
+          decision: command.decision,
+          reasonCode: command.reasonCode,
+          opportunityRevision: command.expectedRevision,
+          ...(command.rubric ? { rubric: command.rubric } : {}),
+          ...(command.durationMs !== undefined
+            ? { durationMs: command.durationMs, durationSource: "reviewer_entered" }
+            : "review" in result && result.review?.durationMs !== undefined
+              ? {
+                  durationMs: result.review.durationMs,
+                  durationSource: result.review.durationSource,
+                }
+              : {}),
+        };
+      if (command.type === "start_review")
+        event.details = {
+          opportunityRevision: command.expectedRevision,
+          priority: command.priority,
+          assigneeId: actor.type === "staff" ? actor.userId : null,
+        };
+      if (
+        command.type === "report_member" ||
+        command.type === "resolve_safety" ||
+        command.type === "hold_safety_case" ||
+        command.type === "appeal_safety" ||
+        command.type === "resolve_safety_appeal" ||
+        command.type === "resolve_relay_case"
+      )
+        event.details = {
+          caseId: command.caseId,
+          ...("decision" in command ? { decision: command.decision } : {}),
+          ...(command.type === "report_member" && command.evidenceRef
+            ? { evidenceRef: command.evidenceRef }
+            : {}),
+        };
+      if (command.type === "transition_opportunity")
+        event.details = { to: command.to, opportunityRevision: command.expectedRevision };
+      if (command.type === "report_value") {
+        event.kind = command.meaningful ? "meaningful_value" : "value_report";
+        event.details = { meaningful: command.meaningful, evidence: "member_report" };
+      }
+      if (command.type === "manage_intent" && "intents" in result)
+        event.details = {
+          intentId: command.intent.id,
+          intentDigest: networkDigest(
+            result.intents.find((intent) => intent.id === command.intent.id),
+          ),
+        };
+      if (command.type === "configure" && "matchingThreshold" in result)
+        event.details = {
+          settingsRevision: result.revision,
+          matchingThreshold: result.matchingThreshold,
+          weights: result.weights,
+          budgets: result.budgets,
+          proactiveCities: result.proactiveCities,
+          reviewRequired: result.reviewRequired,
+        };
+      await store.save("events", event.id, event, at);
+      return {
+        result,
+        receipt: {
+          receiptId: `network.command:${this.options.networkId}:${command.requestId}`,
+          operation: `network.${command.type}`,
+          resource: { kind: "network.command", id: command.requestId, version: "2" },
+          artifacts: [],
+          idempotency: { key: command.requestId, replayed: false },
+          observedAt: at,
+          outcome: "applied",
+          commit: {
+            kind: "durable",
+            id: `${this.options.networkId}:${command.requestId}`,
+            committedAt,
+          },
+        },
+      };
+    });
+  }
+  private validateActor(actor: NetworkActor): void {
+    if (!actor || !["system", "member", "staff"].includes(actor.type))
+      denied("Invalid authenticated actor");
+    if (actor.type === "member") text(actor.memberId, "actor memberId", 160);
+    if (actor.type === "staff") {
+      text(actor.userId, "staff userId", 160);
+      if (
+        !Array.isArray(actor.roles) ||
+        !actor.roles.every((role) =>
+          ["admin", "reviewer", "safety", "analyst", "engineer"].includes(role),
+        )
+      )
+        denied("Invalid staff roles");
+    }
+  }
+  private commandMemberIds(command: NetworkCommand, result: NetworkCommandResult): string[] {
