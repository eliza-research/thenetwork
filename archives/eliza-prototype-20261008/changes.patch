+import { ApprovalDispatchControlStore } from "./dispatch-control.ts";
+import { PgApprovalQueue } from "./store.ts";
+
+const agentId = randomUUID() as UUID;
+const localDatabaseUrl = process.env.NETWORK_PROOF_DATABASE_URL;
+if (localDatabaseUrl) {
+  const url = new URL(localDatabaseUrl);
+  if (
+    url.hostname !== "127.0.0.1" ||
+    url.pathname !== "/network_proof" ||
+    url.port !== "55439"
+  )
+    throw new Error(
+      "Network proof requires its isolated local PostgreSQL cluster",
+    );
+}
+const adapter = createDatabaseAdapter(
+  localDatabaseUrl
+    ? { postgresUrl: localDatabaseUrl }
+    : { dataDir: "memory://" },
+  agentId,
+);
+const db = adapter.db as {
+  transaction<T>(work: (tx: TransactionalDb) => Promise<T>): Promise<T>;
+};
+const runtime = new AgentRuntime({
+  agentId,
+  character: { name: "Network local composition" },
+  adapter,
+});
+let graph: KnowledgeGraphService;
+let queue: PgApprovalQueue;
+
+beforeAll(async () => {
+  await adapter.initialize();
+  if (!adapter.runPluginMigrations)
+    throw new Error("Plugin migrations unavailable");
+  // Load the complete canonical core schema. A partial core fixture lacks the
+  // rooms.agent_id startup marker and can incorrectly enter legacy migration.
+  await adapter.runPluginMigrations([
+    { name: "@elizaos/plugin-sql", schema: sqlSchema },
+    { name: "network-reuse-graph", schema: knowledgeGraphSchema },
+  ]);
+  expect(
+    await adapter.createAgents([
+      { id: agentId, name: "Network local composition", bio: [] },
+    ]),
+  ).toEqual([agentId]);
+  graph = await KnowledgeGraphService.start(runtime);
+  queue = new PgApprovalQueue(runtime, { agentId });
+}, 120000);
+afterAll(async () => {
+  await adapter.close();
+});
+
+function projection(): IntroductionProjection {
+  const p: IntroductionProjection = {
+    opportunityId: randomUUID(),
+    revision: 1,
+    expiresAt: new Date(Date.now() + 3600000),
+    state: "confirmed",
+    members: [
+      {
+        memberId: randomUUID(),
+        subjectUserId: randomUUID(),
+        recipient: "synthetic-alice",
+        channel: "imessage",
+        channelVerified: true,
+        age: "adult",
+        active: true,
+        blocked: false,
+        acceptedRevision: 1,
+        disclosureRevision: 1,
+        body: "You both agreed to the public museum visit. Relay is available.",
+      },
+      {
+        memberId: randomUUID(),
+        subjectUserId: randomUUID(),
+        recipient: "synthetic-bob",
+        channel: "sms",
+        channelVerified: true,
+        age: "adult",
+        active: true,
+        blocked: false,
+        acceptedRevision: 1,
+        disclosureRevision: 1,
+        body: "You both agreed to the public museum visit. Relay is available.",
+      },
+    ],
+    review: { decision: "approved", revision: 1, briefDigest: "" },
+    leakCheck: { revision: 1, briefDigest: "", passed: true },
+  };
+  const digest = introductionBriefDigest(p);
+  p.review.briefDigest = digest;
+  p.leakCheck.briefDigest = digest;
+  return p;
+}
+
+function prepared(p: IntroductionProjection) {
+  return prepareIntroductionRequests(p, new Date());
+}
+const resolution = {
