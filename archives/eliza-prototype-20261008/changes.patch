+import { expect, it } from "vitest";
+import { nativePersonaDraw } from "./fixtures.ts";
+
+const opportunity = {
+  kind: "intro" as const,
+  category: "music",
+  objective: "A public music opportunity",
+  participantIds: ["member-a", "member-b"],
+  anchorEventId: null,
+  createdAt: "2026-10-06T16:03:00Z",
+  expiresAt: "2026-10-13T16:03:00Z",
+};
+it("uses the same native persona choices across execution IDs, replay namespaces and iteration order", () => {
+  const first = { ...opportunity, id: "namespace-a:opportunity", runId: "namespace-a:run" },
+    second = {
+      ...opportunity,
+      id: "namespace-b:opportunity",
+      runId: "namespace-b:run",
+      participantIds: [...opportunity.participantIds].reverse(),
+    };
+  const decisions = ["response", "accept", "attendance", "feedback"] as const;
+  const before = decisions.map((kind) => nativePersonaDraw(42, 0, "member-a", first, kind));
+  const after = [...decisions]
+    .reverse()
+    .map((kind) => nativePersonaDraw(42, 0, "member-a", second, kind))
+    .reverse();
+  expect(after).toEqual(before);
+  expect(new Set(before).size).toBe(4);
+  expect(nativePersonaDraw(43, 0, "member-a", first, "response")).not.toBe(before[0]);
+  expect(nativePersonaDraw(42, 1, "member-a", first, "response")).not.toBe(before[0]);
+  expect(nativePersonaDraw(42, 0, "member-b", first, "response")).not.toBe(before[0]);
+});
