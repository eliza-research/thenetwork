+});
+
+it("projects real Clock review records and role-scoped report counts through the actual host views", async () => {
+  const clock = new SimClock(Date.parse(primary.at));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:review-report-metrics",
