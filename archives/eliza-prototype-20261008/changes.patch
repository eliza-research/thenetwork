+import { useCallback, useEffect, useState } from "react";
+import { type PortalConfig, portalRequest } from "./portal-api";
+import "./network.css";
+import "./portal.css";
+
+/** Product entry never consumes the workbench's synthetic member session. */
+export function NetworkPortal({
+  brandId = window.location.pathname === "/slop-love"
+    ? "slop.love"
+    : window.location.pathname === "/friend-help"
+      ? "friend.help"
+      : "network",
+}: {
+  brandId?: string;
+}) {
+  const [config, setConfig] = useState<PortalConfig | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  // biome-ignore lint/correctness/useExhaustiveDependencies: Retry repeats this request and cancels the previous attempt.
+  useEffect(() => {
+    const controller = new AbortController();
+    setError(null);
+    portalRequest<PortalConfig>("config", { signal: controller.signal })
+      .then((next) => {
+        if (!controller.signal.aborted) setConfig(next);
+      })
+      .catch((issue) => {
+        if (!controller.signal.aborted)
+          setError(
+            issue instanceof Error
+              ? issue.message
+              : "This page could not load.",
+          );
+      });
+    return () => controller.abort();
+  }, [attempt]);
+  const brand = config?.brands.find((item) => item.id === brandId);
+  useEffect(() => {
+    if (!brand) return;
+    const previous = document.title;
+    document.title = `${brand.name} · Your Network agent`;
+    return () => {
+      document.title = previous;
+    };
+  }, [brand]);
+  const retry = useCallback(() => setAttempt((value) => value + 1), []);
+  const destination = `/network/chat?brand=${encodeURIComponent(brandId)}`;
+  return (
+    <div className="network-workbench network-portal">
+      <a className="nw-skip-link" href="#portal-main">
+        Skip to main content
+      </a>
+      <header className="np-header">
+        <a className="nw-wordmark" href={window.location.pathname}>
+          {brand?.name ?? "The Network"}
+          <span className="nw-wordmark-dot" aria-hidden="true" />
+        </a>
+        <span className="np-preview-label">Local development</span>
+      </header>
+      <main id="portal-main" className="np-main">
+        {error ? (
+          <div>
+            <p role="alert">{error}</p>
+            <button
+              className="nw-button nw-button-primary"
+              onClick={retry}
+              type="button"
+            >
+              Retry loading
+            </button>
+          </div>
+        ) : !config ? (
+          <p role="status">Loading…</p>
+        ) : !brand ? (
+          <p role="alert">This brand is unavailable.</p>
+        ) : (
+          <section className="np-entry" aria-labelledby="portal-title">
+            <h1 id="portal-title">{brand.purpose}</h1>
+            <p className="np-description">{brand.description}</p>
+            <div className="np-entry-actions">
+              <a
+                className="nw-button nw-button-primary"
+                href={`http://127.0.0.1:54733/network/login?brand=${encodeURIComponent(brandId)}&returnTo=${encodeURIComponent(destination)}`}
+              >
+                Sign in with Eliza Cloud
+              </a>
+            </div>
+            <p className="np-demo-hint">
+              Use your Eliza Cloud account. A connection error never opens
+              sample chats.
+            </p>
+          </section>
+        )}
+      </main>
+      <footer className="np-footer">Powered by Eliza</footer>
+    </div>
+  );
+}
