+import { networkDigest } from "../digest.js";
+import type { NetworkDomain } from "../domain/service.js";
+import type { City, NetworkActor, NetworkClock, NetworkOpportunity } from "../domain/types.js";
+
+export class SimClock implements NetworkClock {
+  constructor(private instant: number) {
+    if (!Number.isFinite(instant)) throw new Error("Invalid simulated clock");
+  }
+  now(): Date {
+    return new Date(this.instant);
+  }
+  advanceTo(instant: string | number): void {
+    const next = typeof instant === "string" ? Date.parse(instant) : instant;
+    if (!Number.isFinite(next) || next < this.instant)
+      throw new Error("Simulation clock cannot move backwards");
+    this.instant = next;
+  }
+}
+export function seededRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state += 0x6d2b79f5;
+    let value = Math.imul(state ^ (state >>> 15), 1 | state);
+    value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
+    return ((value ^ (value >>> 14)) >>> 0) / 4_294_967_296;
+  };
+}
+/** Common random choices are semantic; changing a replay namespace or iteration order cannot change a persona's decision. */
+export function nativePersonaDraw(
+  seed: number,
+  day: number,
+  memberId: string,
+  opportunity: Pick<
+    NetworkOpportunity,
+    | "kind"
+    | "category"
+    | "objective"
+    | "participantIds"
+    | "anchorEventId"
+    | "createdAt"
+    | "expiresAt"
+  >,
+  decision: "response" | "accept" | "attendance" | "feedback",
+): number {
+  const key = networkDigest([
+    seed,
+    day,
+    memberId,
+    opportunity.kind,
+    opportunity.category,
+    opportunity.objective,
+    [...opportunity.participantIds].sort(),
+    opportunity.anchorEventId,
+    opportunity.createdAt,
+    opportunity.expiresAt,
+    decision,
+  ]);
+  return seededRandom(Number.parseInt(key.slice(0, 8), 16))();
+}
+export interface SyntheticPersona {
+  memberId: string;
+  city: City;
+  kind:
+    | "newcomer"
+    | "parent"
+    | "connector"
+    | "introvert"
+    | "active"
+    | "unresponsive"
+    | "adversarial";
+  hiddenTag: string;
+  responseProbability: number;
+  attendanceProbability: number;
+  canary: string;
+  age: "adult" | "minor" | "unknown";
+}
+
+/** Explicit synthetic fixture authority. Never used to onboard real identities or send a live message. */
+export async function seedSimulationMembers(
+  domain: NetworkDomain,
+  count: number,
+  seed: number,
+  personaMix?: Partial<Record<SyntheticPersona["kind"], number>>,
+): Promise<SyntheticPersona[]> {
+  if (
+    !domain.options.networkId.startsWith("simulation:") &&
+    !domain.options.networkId.startsWith("test:")
+  )
+    throw new Error("Synthetic personas require an explicitly isolated simulation/test domain");
+  if (!Number.isSafeInteger(count) || count < 1 || count > 2000)
+    throw new Error("Simulation requires 1–2000 personas");
+  const admin: NetworkActor = {
+    type: "staff",
+    userId: "fixture-reviewer",
+    roles: ["admin", "reviewer"],
+  };
+  const kinds = [
+    "newcomer",
+    "parent",
+    "connector",
+    "introvert",
+    "active",
+    "unresponsive",
+    "adversarial",
+  ] as const;
+  const weights = personaMix ? kinds.map((kind) => personaMix[kind] ?? 0) : undefined;
+  if (
+    weights &&
+    (weights.some((weight) => !Number.isFinite(weight) || weight < 0) ||
+      weights.reduce((sum, weight) => sum + weight, 0) <= 0 ||
+      Object.keys(personaMix ?? {}).some(
+        (kind) => !kinds.includes(kind as SyntheticPersona["kind"]),
+      ))
+  )
+    throw new Error(
+      "Persona mix requires nonnegative finite weights over known kinds and a positive total",
+    );
+  const chooseKind = seededRandom(seed ^ 0x53a9);
+  const categories = ["music", "sport", "culture", "learning", "help", "social"];
+  const personas: SyntheticPersona[] = [];
+  const at = domain.options.clock.now().toISOString();
+  for (let index = 0; index < count; index++) {
+    const id = `00000000-0000-4000-8000-${String(index + 1).padStart(12, "0")}`;
+    const chooseKindForMember = weights
+      ? chooseKind() * weights.reduce((sum, weight) => sum + weight, 0)
+      : 0;
+    const city: City = index % 2 ? "NYC" : "SF",
+      kind = weights
+        ? (kinds[
+            weights.findIndex((_weight, position) => {
+              const boundary = weights
+                .slice(0, position + 1)
+                .reduce((sum, weight) => sum + weight, 0);
+              return boundary > chooseKindForMember;
+            })
+          ] ?? "active")
+        : (kinds[index % kinds.length] ?? "active");
+    const age =
+      index > 1 && index % 37 === 0 ? "minor" : index > 1 && index % 41 === 0 ? "unknown" : "adult";
+    const hiddenTag = `interest:${Math.floor(index / 2) % 8}`;
+    const persona: SyntheticPersona = {
+      memberId: id,
+      city,
+      kind,
+      hiddenTag,
+      responseProbability: kind === "unresponsive" ? 0 : kind === "parent" ? 0.6 : 0.9,
+      attendanceProbability: kind === "active" ? 0.95 : 0.8,
+      canary: `CANARY_PRIVATE_${seed}_${index}`,
+      age,
+    };
+    const inviteId = `simulation-invite:${index}`,
+      token = `fixture-token-${seed}-${index}`;
+    await domain.command(admin, {
+      type: "create_invite",
+      requestId: `seed:${index}:invite`,
+      id: inviteId,
+      token,
+      city,
+      inviteeName: `Synthetic member ${index + 1}`,
+      address: null,
+      vouch: {
+        relationship: "synthetic fixture",
+        knownMonths: 12,
+        strength: "strong",
+        note: "Local synthetic persona",
+        expectsMessage: false,
+      },
+      seed: true,
+    });
+    await domain.command(admin, {
+      type: "accept_invite",
+      requestId: `seed:${index}:accept`,
+      inviteId,
+      token,
+      memberId: id,
+      cloudUserId: `synthetic-cloud-${index}`,
+      displayName: `Synthetic member ${index + 1}`,
+      age: age === "unknown" ? "adult" : age,
+      ...(age === "minor" ? { ageBand: "13_17" as const } : {}),
+      channel: "sms",
+      address: `synthetic:${id}`,
+      verifiedAt: at,
+      termsVersion: "local-simulation-1",
+      messagingConsent: true,
+      seedVouch: false,
+    });
+    const actor: NetworkActor = { type: "member", memberId: id };
+    await domain.command(actor, {
+      type: "complete_onboarding",
+      requestId: `seed:${index}:onboarding`,
+      memberId: id,
+      proactiveOptIn: true,
+    });
+    // Historical ambiguous-age fixtures are created from a valid admission, then explicitly demoted.
+    if (age === "unknown")
+      await domain.command(actor, {
+        type: "attest_age",
+        requestId: `seed:${index}:unknown-age`,
+        memberId: id,
+        age: "unknown",
+        confirmed: true,
+      });
+    await domain.command(actor, {
+      type: "upsert_fact",
+      requestId: `seed:${index}:fact`,
+      memberId: id,
+      fact: {
+        id: `fact:${id}`,
+        kind: "interest",
+        value: `I enjoy ${hiddenTag}`,
+        tags: [hiddenTag],
+        scope: "shareable",
+        source: "member",
+        sourceRef: "synthetic:member-statement",
+        confidence: 0.9,
+        status: "confirmed",
+      },
+    });
+    await domain.command(actor, {
+      type: "upsert_fact",
+      requestId: `seed:${index}:canary`,
+      memberId: id,
+      fact: {
+        id: `private:${id}`,
+        kind: "private",
+        value: persona.canary,
+        tags: [hiddenTag],
+        scope: "agent_private",
+        source: "member",
+        sourceRef: "synthetic:private-statement",
+        confidence: 1,
+        status: "confirmed",
+      },
+    });
+    const category = categories[Math.floor(index / 2) % categories.length] ?? "social";
+    await domain.command(actor, {
+      type: "manage_intent",
+      requestId: `seed:${index}:intent`,
+      memberId: id,
+      intent: {
+        id: `intent:${id}`,
+        objective: `Find someone for ${hiddenTag}`,
+        category,
+        tags: [hiddenTag],
+        needs: [`skill:${Math.floor(index / 2) % 4}`],
+        offers: [`skill:${(Math.floor(index / 2) + 1) % 4}`],
+        status: "active",
+      },
+    });
+    personas.push(persona);
+  }
+  return personas;
+}
