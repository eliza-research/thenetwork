@@ -0,0 +1,64 @@
+import type { CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+
+/** Explicit local/host migration entry. Request handlers must never call this. */
+export async function initializeNetworkSchema(execute: CarveOutSqlExecutor): Promise<void> {
+  await execute("CREATE SCHEMA IF NOT EXISTS network");
+  await execute(`CREATE TABLE IF NOT EXISTS network.domains (
+    network_id TEXT PRIMARY KEY, schema_version INTEGER NOT NULL CHECK (schema_version = 1)
+  )`);
+  for (const table of [
+    "members",
+    "invites",
+    "safety_cases",
+    "feedback",
+    "matching_runs",
+    "settings",
+    "attendance_evidence",
+  ] as const) {
+    await execute(`CREATE TABLE IF NOT EXISTS network.${table} (
+      network_id TEXT NOT NULL REFERENCES network.domains(network_id), id TEXT NOT NULL,
+      payload JSONB NOT NULL, updated_at TIMESTAMPTZ NOT NULL,
+      PRIMARY KEY (network_id, id)
+    )`);
+  }
+  await execute(`CREATE UNIQUE INDEX IF NOT EXISTS network_member_cloud_user
+    ON network.members(network_id, (payload->>'cloudUserId'))
+    WHERE payload->>'accountState' <> 'removed'`);
+  await execute(`CREATE TABLE IF NOT EXISTS network.opportunities (
+    network_id TEXT NOT NULL REFERENCES network.domains(network_id), id TEXT NOT NULL,
+    payload JSONB NOT NULL, active_key TEXT, updated_at TIMESTAMPTZ NOT NULL,
+    PRIMARY KEY (network_id, id), UNIQUE (network_id, active_key)
+  )`);
+  await execute(`CREATE TABLE IF NOT EXISTS network.events (
+    network_id TEXT NOT NULL REFERENCES network.domains(network_id), id TEXT NOT NULL,
+    payload JSONB NOT NULL, occurred_at TIMESTAMPTZ NOT NULL,
+    PRIMARY KEY (network_id, id)
+  )`);
+  await execute(`CREATE TABLE IF NOT EXISTS network.commands (
+    network_id TEXT NOT NULL REFERENCES network.domains(network_id), request_id TEXT NOT NULL,
+    digest TEXT NOT NULL, result JSONB NOT NULL, member_ids JSONB NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL, PRIMARY KEY (network_id, request_id)
+  )`);
+  await execute("ALTER TABLE network.events ADD COLUMN IF NOT EXISTS sequence BIGSERIAL");
+  await execute(
+    "ALTER TABLE network.attendance_evidence ADD COLUMN IF NOT EXISTS sequence BIGSERIAL",
+  );
+  await execute(
+    "ALTER TABLE network.commands ADD COLUMN IF NOT EXISTS digest_version INTEGER NOT NULL DEFAULT 0",
+  );
+  await execute(
+    "CREATE INDEX IF NOT EXISTS network_event_chronology ON network.events(network_id,occurred_at,sequence)",
+  );
+  await execute(`CREATE TABLE IF NOT EXISTS network.proactive_receipts (
+    network_id TEXT NOT NULL REFERENCES network.domains(network_id), id TEXT NOT NULL,
+    member_id TEXT NOT NULL, category TEXT NOT NULL, sent_at TIMESTAMPTZ NOT NULL,
+    deadline TIMESTAMPTZ NOT NULL, state TEXT NOT NULL CHECK (state IN ('pending','answered','unanswered')),
+    PRIMARY KEY (network_id,id)
+  )`);
+  await execute(
+    "ALTER TABLE network.proactive_receipts ADD COLUMN IF NOT EXISTS opportunity_id TEXT",
+  );
+  await execute(
+    "ALTER TABLE network.proactive_receipts ADD COLUMN IF NOT EXISTS exploration BOOLEAN",
+  );
+}
