@@ -0,0 +1,141 @@
+/** Network consumer cases against the existing scheduler policies; no transport or model calls. */
+import { describe, expect, it } from "vitest";
+import { decideDispatchPolicy } from "./dispatch-policy.js";
+import {
+  InvalidLocalTimeError,
+  resolveLocalHHMMToIso,
+} from "./scheduled-task/local-time.js";
+
+describe("Network reuse of existing dispatch policy", () => {
+  const context = { currentStepIndex: 0, totalSteps: 2 };
+
+  it("does not fall back to SMS or retry when iMessage acceptance is unknown", () => {
+    expect(
+      decideDispatchPolicy(
+        {
+          ok: false,
+          reason: "transport_error",
+          acceptance: "unknown",
+          userActionable: false,
+        },
+        context,
+      ).kind,
+    ).toBe("fail");
+  });
+
+  it("unknown acceptance wins over retry hints and rate limits", () => {
+    expect(
+      decideDispatchPolicy(
+        {
+          ok: false,
+          reason: "rate_limited",
+          acceptance: "unknown",
+          userActionable: true,
+          retryAfterMinutes: 3,
+        },
+        context,
+      ).kind,
+    ).toBe("fail");
+  });
+
+  it("retries a definitively unaccepted rate-limited message on the same step", () => {
+    expect(
+      decideDispatchPolicy(
+        {
+          ok: false,
+          reason: "rate_limited",
+          acceptance: "not_accepted",
+          userActionable: false,
+          retryAfterMinutes: 3,
+        },
+        context,
+      ),
+    ).toEqual({ kind: "retry", retryAfterMinutes: 3, reason: "rate_limited" });
+  });
+
+  it("permits configured fallback after a definitive pre-acceptance failure", () => {
+    expect(
+      decideDispatchPolicy(
+        {
+          ok: false,
+          reason: "disconnected",
+          acceptance: "not_accepted",
+          userActionable: false,
+        },
+        context,
+      ).kind,
+    ).toBe("advance");
+  });
+
+  it("surfaces a disconnected account requiring member action", () => {
+    expect(
+      decideDispatchPolicy(
+        {
+          ok: false,
+          reason: "auth_expired",
+          acceptance: "not_accepted",
+          userActionable: true,
+        },
+        { currentStepIndex: 1, totalSteps: 2 },
+      ).kind,
+    ).toBe("surface_degraded");
+  });
+
+  it("retains the provider message ID for delivery evidence", () => {
+    expect(
+      decideDispatchPolicy(
+        { ok: true, messageId: "synthetic-provider-receipt" },
+        context,
+      ),
+    ).toEqual({ kind: "complete", messageId: "synthetic-provider-receipt" });
+  });
+});
+
+describe("Network reuse of the existing SF/NYC local-time resolver", () => {
+  it("maps 7pm separately in each member's city", () => {
+    const day = new Date("2026-10-05T18:00:00Z");
+    expect(resolveLocalHHMMToIso(day, "19:00", "America/Los_Angeles")).toBe(
+      "2026-10-06T02:00:00.000Z",
+    );
+    expect(resolveLocalHHMMToIso(day, "19:00", "America/New_York")).toBe(
+      "2026-10-05T23:00:00.000Z",
+    );
+  });
+
+  it("uses the member-local date rather than the UTC date", () => {
+    expect(
+      resolveLocalHHMMToIso(
+        new Date("2026-10-06T02:00:00Z"),
+        "21:00",
+        "America/Los_Angeles",
+      ),
+    ).toBe("2026-10-06T04:00:00.000Z");
+  });
+
+  it("preserves absence but rejects malformed member input", () => {
+    expect(
+      resolveLocalHHMMToIso(
+        new Date("2026-10-05T18:00:00Z"),
+        undefined,
+        "America/New_York",
+      ),
+    ).toBeNull();
+    expect(() =>
+      resolveLocalHHMMToIso(
+        new Date("2026-10-05T18:00:00Z"),
+        "25:00",
+        "America/New_York",
+      ),
+    ).toThrow(InvalidLocalTimeError);
+  });
+
+  it("rejects an invalid timezone instead of silently choosing a city", () => {
+    expect(() =>
+      resolveLocalHHMMToIso(
+        new Date("2026-10-05T18:00:00Z"),
+        "19:00",
+        "Not/AZone",
+      ),
+    ).toThrow(InvalidLocalTimeError);
+  });
+});
