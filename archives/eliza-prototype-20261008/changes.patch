+it("admits only the authenticated own request while leaving proactive preferences and helper gates intact", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z")),
+    host = await createLocalNetworkHost({
+      dataDir: "memory://",
+      networkId: "simulation:on-demand",
+      clock,
+    });
+  try {
+    await seedSimulationMembers(host.domain, 100, 42);
+    const candidate = (await host.domain.engineSnapshot({ type: "system" })).members.find(
+      (member) =>
+        member.age === "adult" &&
+        member.homeCities.includes("SF") &&
+        member.participation === "normal",
+    );
+    if (!candidate) throw new Error("Missing eligible requester");
+    const actor = { type: "member" as const, memberId: candidate.memberId };
+    await host.domain.command(actor, {
+      type: "set_preferences",
+      requestId: "only-asked",
+      memberId: candidate.memberId,
+      preferences: { onlyWhenAsked: true, explorationFraction: 0 },
+    });
+    const original = (await host.domain.getMember({ type: "system" }, candidate.memberId))
+      .intents[0];
+    if (!original) throw new Error("Missing own intent");
+    const requestId = "actual-own-request";
+    await host.domain.command(actor, {
+      type: "manage_intent",
+      requestId,
+      memberId: candidate.memberId,
+      intent: {
+        id: original.id,
+        objective: original.objective,
+        category: original.category,
+        tags: original.tags,
+        needs: original.needs,
+        offers: original.offers,
+        status: "active",
+      },
+    });
+    const request = {
+      runId: "own-request",
+      city: "SF" as const,
+      seed: 42,
+      startAt: clock.now().toISOString(),
+      endAt: new Date(clock.now().getTime() + 86400000).toISOString(),
+      requester: { memberId: candidate.memberId, intentId: original.id, requestId },
+    };
+    const defaultProvider = await createNetworkCandidateRetrieval(host, {
+      ...request,
+      requester: undefined,
+    });
+    expect(defaultProvider.eligibleMemberIds).not.toContain(candidate.memberId);
+    const provider = await createNetworkCandidateRetrieval(host, request);
+    expect(provider.eligibleMemberIds).toContain(candidate.memberId);
+    const settings = await host.domain.getSettings({ type: "system" }),
+      config = matchingConfigFromSettings(settings);
+    const snapshot = await host.domain.engineSnapshot(
+      { type: "system" },
+      { memberIds: provider.eligibleMemberIds },
+    );
+    const input = projectMatchingInput(snapshot, request, clock.now().getTime(), config, settings),
+      own = input.members.find((member) => member.memberId === candidate.memberId);
+    if (!own) throw new Error("Requested member not projected");
+    expect(own.state).toBe("active");
+    expect(own.onDemand).toBe(true);
+    expect(own.explorationFraction).toBe(0);
+    expect(input.constraints?.requireMemberIds).toEqual([candidate.memberId]);
+    own.unansweredProposals = 2;
+    own.budgets = [{ windowMs: 86400000, max: 0 }];
+    expect(
+      candidateEligibility(input, [own], original.category, input.window, config),
+    ).not.toContain("two_unanswered");
+    expect(
+      candidateEligibility(input, [own], original.category, input.window, config),
+    ).not.toContain("budget_exhausted");
+    const run = await matchNetwork(host.domain, request, {
+      clock,
+      retrievalProvider: provider,
+      eligibleMemberIds: provider.eligibleMemberIds,
+      retrievalInputRevisions: provider.inputRevisions,
+      config: {
+        ...DEFAULT_MATCHING_CONFIG,
+        defaultThreshold: 0,
+        weights: { ...DEFAULT_MATCHING_CONFIG.weights, novelty: 2 },
+      },
+    });
+    expect(run.proposals.length).toBeGreaterThan(0);
+    expect(
+      run.proposals.every((proposal) => proposal.participantIds.includes(candidate.memberId)),
+    ).toBe(true);
+    const draft = await host.domain.getOpportunity({ type: "system" }, run.proposals[0]?.id ?? "");
+    expect("participantIds" in draft && draft.participantIds[0]).toBe(candidate.memberId);
+    expect("requester" in draft && draft.requester).toEqual(request.requester);
+    expect(
+      (await host.domain.getMember({ type: "system" }, candidate.memberId)).preferences
+        .onlyWhenAsked,
+    ).toBe(true);
+    await host.domain.command(actor, {
+      type: "set_preferences",
+      requestId: "withdraw-request",
+      memberId: candidate.memberId,
+      preferences: { travelMinutes: 5 },
+    });
+    await expect(
+      createNetworkCandidateRetrieval(host, { ...request, runId: "withdrawn" }),
+    ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+    await expect(
+      createNetworkCandidateRetrieval(host, {
+        ...request,
+        requester: { ...request.requester, memberId: "00000000-0000-4000-8000-000000000099" },
+      }),
+    ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  } finally {
+    await host.close();
+  }
+}, 120000);
