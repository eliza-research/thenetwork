+    roomId,
+    context: async () => ({
+      ...(await domain.memberView({ type: "member", memberId: "member" })),
+    }),
+    command: async (value, requestId) => {
+      const command: Record<string, unknown> = { ...value, requestId };
+      if (command.memberId !== undefined && command.memberId !== "member")
+        throw new Error("Foreign member");
+      const committed = await domain.commandWithReceipt(
+        { type: "member", memberId: "member" },
