@@ -0,0 +1,69 @@
+import type {
+  CalendarAvailabilityRange,
+  CalendarAvailabilitySource,
+} from "@elizaos/plugin-calendar/availability";
+import { publicFact } from "../domain/policy.js";
+import type { NetworkDomain } from "../domain/service.js";
+import type { City, NetworkClock, NetworkMember, ProfileFact } from "../domain/types.js";
+
+export interface NetworkAvailability {
+  sources: readonly CalendarAvailabilitySource[];
+  qualification: {
+    stated: "known" | "unknown";
+    freeBusy: "authored_fixture" | "unknown";
+    travel: "member_stated" | "unknown";
+  };
+  travelMinutesByArea: Record<string, number>;
+}
+export type NetworkAvailabilityPort = (
+  member: { memberId: string; revision: number; facts: ProfileFact[] },
+  range: CalendarAvailabilityRange,
+) => Promise<NetworkAvailability> | NetworkAvailability;
+export interface PublicCoordinationVenue {
+  id: string;
+  title: string;
+  area: string;
+  sourceUrl: string;
+}
+export type NetworkVenuePort = (
+  city: City,
+  range: CalendarAvailabilityRange,
+  domain: NetworkDomain,
+) => Promise<readonly PublicCoordinationVenue[]> | readonly PublicCoordinationVenue[];
+
+/** Cost: at most six host ports per consented group; reuses the current member read and sends no private profile fields. */
+export async function readAvailability(
+  members: NetworkMember[],
+  range: CalendarAvailabilityRange,
+  clock: NetworkClock,
+  port?: NetworkAvailabilityPort,
+): Promise<NetworkAvailability[]> {
+  const at = clock.now().toISOString();
+  return Promise.all(
+    members.map(
+      async (member): Promise<NetworkAvailability> =>
+        port
+          ? port(
+              {
+                memberId: member.memberId,
+                revision: member.revision,
+                facts: member.facts
+                  .filter(
+                    (fact) =>
+                      publicFact(fact, at) &&
+                      ["stated_availability", "freebusy_fixture", "travel_estimate"].includes(
+                        fact.kind,
+                      ),
+                  )
+                  .map((fact) => ({ ...fact, sourceRef: "" })),
+              },
+              range,
+            )
+          : {
+              sources: [],
+              qualification: { stated: "unknown", freeBusy: "unknown", travel: "unknown" },
+              travelMinutesByArea: {},
+            },
+    ),
+  );
+}
