+import {
+  useCallback,
+  useEffect,
+  useId,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+import { Button } from "../components/ui/button";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "../components/ui/collapsible";
+import {
+  createNetworkWorkbenchTransport,
+  NETWORK_ADMIN_MODULES,
+  type NetworkAction,
+  type NetworkAdminView,
+  type NetworkCommandReceipt,
+  type NetworkFieldValue,
+  type NetworkFixture,
+  type NetworkMemberView,
+  type NetworkRow,
+  type NetworkSection,
+  NetworkTransportError,
+  type NetworkWorkbenchTransport,
+} from "./api";
+import { NetworkActionButtons } from "./NetworkActionButtons";
+import { NetworkConversation } from "./NetworkConversation";
+import { NetworkGraph } from "./NetworkGraph";
+import { NetworkPipeline } from "./NetworkPipeline";
+import "./network.css";
+
+function messageFrom(error: unknown): string {
+  return error instanceof Error
+    ? error.message
+    : "This request did not complete. Try again or check the local server.";
+}
+
+function humanLabel(value: string): string {
+  return value.replace(/([a-z])([A-Z])/g, "$1 $2").replaceAll("_", " ");
+}
+
+export function NetworkValue({ value }: { value: unknown }) {
+  const [expanded, setExpanded] = useState(false);
+  if (value === null || value === undefined)
+    return <span className="nw-muted">Not set</span>;
+  if (typeof value === "boolean") return <span>{value ? "Yes" : "No"}</span>;
+  if (typeof value === "string" || typeof value === "number")
+    return <span className="nw-value">{String(value)}</span>;
+  if (typeof value !== "object")
+    return <span className="nw-muted">Unavailable</span>;
+  if (Array.isArray(value) && !value.length)
+    return <span className="nw-muted">None</span>;
+  const simpleList =
+    Array.isArray(value) &&
+    value.length <= 12 &&
+    value.every((item) => item === null || typeof item !== "object");
+  const content =
+    expanded || simpleList ? (
+      Array.isArray(value) ? (
+        <ul className="nw-value-list">
+          {value.map((item, index) => (
+            // biome-ignore lint/suspicious/noArrayIndexKey: server arrays preserve ordered duplicate values without item IDs.
+            <li key={`${index}-${typeof item}`}>
+              <NetworkValue value={item} />
+            </li>
+          ))}
+        </ul>
+      ) : (
+        <dl className="nw-nested-values">
+          {Object.entries(value).map(([key, item]) => (
+            <div key={key}>
+              <dt>{humanLabel(key)}</dt>
+              <dd>
+                <NetworkValue value={item} />
+              </dd>
+            </div>
+          ))}
+        </dl>
+      )
+    ) : null;
+  if (simpleList) return content;
+  const count = Array.isArray(value) ? value.length : Object.keys(value).length;
+  const unit = Array.isArray(value) ? "item" : "field";
+  return (
+    <Collapsible open={expanded} onOpenChange={setExpanded}>
+      <CollapsibleTrigger asChild>
+        <Button unstyled className="nw-button nw-button-text">
+          {expanded ? "Hide" : "Show"} {count} {unit}
+          {count === 1 ? "" : "s"}
+        </Button>
+      </CollapsibleTrigger>
+      <CollapsibleContent>{content}</CollapsibleContent>
+    </Collapsible>
+  );
+}
+
+function Arrow() {
+  return (
+    <svg
+      viewBox="0 0 20 20"
+      width="20"
+      height="20"
+      aria-hidden="true"
+      fill="none"
+    >
+      <path
+        d="M4 10h12m-5-5 5 5-5 5"
+        stroke="currentColor"
+        strokeWidth="1.5"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
+
+export function NetworkActionForm({
+  action,
+  onSubmit,
+  onClose,
+  busy,
+  error,
+}: {
+  action: NetworkAction;
+  onSubmit: (values: Record<string, NetworkFieldValue>) => void;
+  onClose: () => void;
+  busy: boolean;
+  error: string | null;
+}) {
+  const formId = useId();
+  const [values, setValues] = useState<Record<string, NetworkFieldValue>>(() =>
+    Object.fromEntries(
+      action.fields.map((field) => [
+        field.name,
+        field.value ?? (field.type === "checkbox" ? false : ""),
+      ]),
+    ),
+  );
+  const [confirmed, setConfirmed] = useState(false);
+  const titleRef = useRef<HTMLHeadingElement>(null);
+  useEffect(() => {
+    titleRef.current?.focus();
+  }, []);
+  return (
+    <aside className="nw-action-panel" aria-labelledby={`${formId}-title`}>
+      <div className="nw-panel-head">
+        <h2 tabIndex={-1} ref={titleRef} id={`${formId}-title`}>
+          {action.label}
+        </h2>
+        <Button
+          unstyled
+          className="nw-button nw-button-text"
+          onClick={onClose}
+          disabled={busy}
+        >
+          Close
+        </Button>
+      </div>
+      <form
+        onSubmit={(event) => {
+          event.preventDefault();
+          if (!busy && (!action.confirm || confirmed)) onSubmit(values);
+        }}
+      >
+        <fieldset disabled={busy} className="nw-form-fields">
+          {action.fields.map((field) => {
+            const id = `${formId}-${field.name}`;
+            const common = {
+              id,
+              name: field.name,
+              required: field.required,
+              "aria-describedby": field.help ? `${id}-help` : undefined,
+            };
+            const change = (value: NetworkFieldValue) =>
+              setValues((previous) => ({ ...previous, [field.name]: value }));
+            return (
+              <div
+                className={`nw-field${field.type === "checkbox" ? " nw-field-check" : ""}`}
+                key={field.name}
+              >
+                {field.type === "checkbox" ? (
+                  <>
+                    <input
+                      {...common}
+                      type="checkbox"
+                      checked={values[field.name] === true}
+                      onChange={(event) => change(event.target.checked)}
+                    />
+                    <label htmlFor={id}>
+                      {field.label}
+                      {field.required ? " (required)" : ""}
+                    </label>
+                  </>
+                ) : (
+                  <>
+                    <label htmlFor={id}>
+                      {field.label}
+                      {field.required ? " (required)" : ""}
+                    </label>
+                    {field.type === "textarea" ? (
+                      <textarea
+                        {...common}
+                        rows={4}
+                        value={String(values[field.name] ?? "")}
+                        onChange={(event) => change(event.target.value)}
+                      />
+                    ) : field.type === "select" ? (
+                      <select
+                        {...common}
+                        value={String(values[field.name] ?? "")}
+                        onChange={(event) => change(event.target.value)}
+                      >
+                        <option value="">Choose an option</option>
+                        {field.options?.map((option) => (
+                          <option key={option.value} value={option.value}>
+                            {option.label}
+                          </option>
+                        ))}
+                      </select>
+                    ) : (
+                      <input
+                        {...common}
+                        type={field.type}
+                        step={field.type === "number" ? "any" : undefined}
+                        value={String(values[field.name] ?? "")}
+                        onChange={(event) =>
+                          change(
+                            field.type === "number" && event.target.value !== ""
+                              ? Number(event.target.value)
+                              : event.target.value,
+                          )
+                        }
+                      />
+                    )}
+                  </>
+                )}
+                {field.help && (
+                  <p className="nw-field-help" id={`${id}-help`}>
+                    {field.help}
+                  </p>
+                )}
+              </div>
+            );
+          })}
+          {action.confirm && (
+            <div className="nw-confirm">
+              <input
+                id={`${formId}-confirm`}
+                type="checkbox"
+                required
+                checked={confirmed}
+                onChange={(event) => setConfirmed(event.target.checked)}
+              />
+              <label htmlFor={`${formId}-confirm`}>{action.confirm}</label>
+            </div>
+          )}
+        </fieldset>
+        {error && (
+          <p className="nw-error" role="alert">
+            {error}
+          </p>
+        )}
+        <Button
+          unstyled
+          type="submit"
+          className="nw-button nw-button-primary"
+          disabled={busy || Boolean(action.confirm && !confirmed)}
+        >
+          {busy
+            ? "Working…"
+            : error
+              ? `Retry ${action.label.toLowerCase()}`
+              : action.label}
+          <Arrow />
+        </Button>
+      </form>
+    </aside>
+  );
+}
+
+function RecordList({
+  rows,
+  emptyMessage,
+  onChoose,
+  keyboardNavigation = false,
+}: {
+  rows: NetworkRow[];
+  emptyMessage?: string;
+  onChoose: (action: NetworkAction) => void;
+  keyboardNavigation?: boolean;
+}) {
+  const recordsRef = useRef<HTMLDivElement>(null);
+  const [search, setSearch] = useState("");
+  const [status, setStatus] = useState("");
+  const statuses = [
+    ...new Set(
+      rows
+        .map((row) => row.status)
+        .filter((item): item is string => Boolean(item)),
+    ),
+  ];
+  const matches = rows.filter(
+    (row) =>
+      (!status || row.status === status) &&
+      (!search.trim() ||
+        `${row.title} ${row.subtitle ?? ""} ${JSON.stringify(row.fields)}`
+          .toLowerCase()
+          .includes(search.trim().toLowerCase())),
+  );
+  const searchId = useId();
+  return (
+    <div className="nw-records" ref={recordsRef}>
+      {keyboardNavigation && rows.length > 0 && (
+        <p className="nw-review-help">
+          Review shortcuts: <kbd>J</kbd> next, <kbd>K</kbd> previous,{" "}
+          <kbd>Enter</kbd> opens the first action for your review.
+        </p>
+      )}
+      {rows.length > 1 && (
+        <div className="nw-record-tools">
+          <div className="nw-field">
+            <label htmlFor={searchId}>Find in this view</label>
+            <input
+              id={searchId}
+              type="search"
+              value={search}
+              onChange={(event) => setSearch(event.target.value)}
+              placeholder="Search names, topics or details"
+            />
+          </div>
+          {statuses.length > 1 && (
+            <div className="nw-field">
+              <label htmlFor={`${searchId}-status`}>Status</label>
+              <select
+                id={`${searchId}-status`}
+                value={status}
+                onChange={(event) => setStatus(event.target.value)}
+              >
+                <option value="">All statuses</option>
+                {statuses.map((item) => (
+                  <option value={item} key={item}>
+                    {humanLabel(item)}
+                  </option>
+                ))}
+              </select>
+            </div>
+          )}
+          <span className="nw-result-count" aria-live="polite">
+            {matches.length} of {rows.length} records
+          </span>
+        </div>
+      )}
+      {!matches.length && (
+        <div className="nw-empty">
+          <h3>{rows.length ? "No matching records" : "Nothing here yet"}</h3>
+          <p>
+            {rows.length
+              ? "Try another search or clear the status filter."
+              : (emptyMessage ??
+                "New activity will appear here when it is recorded.")}
+          </p>
+          {rows.length > 0 && (
+            <Button
+              unstyled
+              className="nw-button nw-button-secondary"
+              onClick={() => {
+                setSearch("");
+                setStatus("");
+              }}
+            >
+              Clear filters
+            </Button>
+          )}
+        </div>
+      )}
+      {matches.map((row) => (
+        <article
+          className="nw-record"
+          key={row.id}
+          tabIndex={keyboardNavigation ? 0 : undefined}
+          onKeyDown={(event) => {
+            if (!keyboardNavigation || event.target !== event.currentTarget)
+              return;
+            if (event.key === "Enter" && row.actions?.[0]) {
+              event.preventDefault();
+              onChoose(row.actions[0]);
+              return;
+            }
+            if (
+              event.key.toLowerCase() === "j" ||
+              event.key.toLowerCase() === "k"
+            ) {
+              const records = [
+                ...(recordsRef.current?.querySelectorAll<HTMLElement>(
+                  "article.nw-record",
+                ) ?? []),
+              ];
+              const current = records.indexOf(event.currentTarget);
+              const target =
+                records[current + (event.key.toLowerCase() === "j" ? 1 : -1)];
+              if (target) {
+                event.preventDefault();
+                target.focus();
+              }
+            }
+          }}
+        >
+          <div className="nw-record-heading">
+            <div>
+              <h3>{row.title}</h3>
+              {row.subtitle && <p className="nw-muted">{row.subtitle}</p>}
+            </div>
+            {row.status && (
+              <span className="nw-status">{humanLabel(row.status)}</span>
+            )}
+          </div>
+          <dl className="nw-record-values">
+            {Object.entries(row.fields).map(([label, value]) => (
+              <div key={label}>
+                <dt>{humanLabel(label)}</dt>
+                <dd>
+                  <NetworkValue value={value} />
+                </dd>
+              </div>
+            ))}
+          </dl>
+          <NetworkActionButtons actions={row.actions} onChoose={onChoose} />
+        </article>
+      ))}
+    </div>
+  );
+}
+
+function downloadReceipt(receipt: NetworkCommandReceipt) {
+  const result = receipt.result;
+  let content = JSON.stringify(result ?? receipt, null, 2);
+  let contentType = "application/json";
+  let filename = "network-local-command-result.json";
+  if (
+    result &&
+    typeof result === "object" &&
+    "content" in result &&
+    typeof result.content === "string" &&
+    "filename" in result &&
+    typeof result.filename === "string" &&
+    "contentType" in result &&
+    typeof result.contentType === "string"
+  ) {
+    content = result.content;
+    contentType = result.contentType;
+    filename = result.filename;
+  }
+  const url = URL.createObjectURL(new Blob([content], { type: contentType }));
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = filename;
+  link.click();
+  URL.revokeObjectURL(url);
+}
+
+export function NetworkWorkbench({
+  transport: suppliedTransport,
+  initialMode,
+  initialModule = "health",
+}: {
+  transport?: NetworkWorkbenchTransport;
+  initialMode?: "member" | "admin";
+  initialModule?: string;
+}) {
+  const transport = useMemo(
+    () => suppliedTransport ?? createNetworkWorkbenchTransport(),
+    [suppliedTransport],
+  );
+  const [fixtures, setFixtures] = useState<NetworkFixture[]>([]);
+  const [fixtureId, setFixtureId] = useState("");
+  const [fixtureBusy, setFixtureBusy] = useState(false);
+  const [mode, setMode] = useState<"member" | "admin">(initialMode ?? "member");
+  const [module, setModule] = useState(initialModule);
+  const [query, setQuery] = useState<Record<string, string>>({});
+  const [sectionId, setSectionId] = useState("");
+  const [member, setMember] = useState<NetworkMemberView | null>(null);
+  const [admin, setAdmin] = useState<NetworkAdminView | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [errorStatus, setErrorStatus] = useState<number | undefined>();
+  const [action, setAction] = useState<NetworkAction | null>(null);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [commandBusy, setCommandBusy] = useState(false);
+  const [receipt, setReceipt] = useState<NetworkCommandReceipt | null>(null);
+  const [revision, setRevision] = useState(0);
+  const commandId = useRef<string | null>(null);
+  const sequence = useRef(0);
+  const fixtureFieldId = useId();
+  const mainRef = useRef<HTMLElement>(null);
+  useEffect(() => {
+    const controller = new AbortController();
+    transport
+      .fixtures(controller.signal)
+      .then((items) => {
+        setFixtures(items);
+        const current = items.find((item) => item.selected);
+        if (current) {
+          setFixtureId(current.id);
+          setMode(
+            initialMode ?? (current.type === "staff" ? "admin" : "member"),
+          );
+        }
+      })
+      .catch((issue) => {
+        if (issue?.name !== "AbortError") {
+          setError(messageFrom(issue));
+          setErrorStatus(
+            issue instanceof NetworkTransportError ? issue.status : undefined,
+          );
+        }
+      });
+    return () => controller.abort();
+  }, [transport, initialMode]);
+  // biome-ignore lint/correctness/useExhaustiveDependencies: revision deliberately reloads the authoritative view after a command or explicit refresh.
+  useEffect(() => {
+    const controller = new AbortController();
+    const generation = ++sequence.current;
+    setLoading(true);
+    setError(null);
+    setErrorStatus(undefined);
+    const promise =
+      mode === "member"
+        ? transport.member(controller.signal).then((view) => {
+            if (generation !== sequence.current) return;
+            setMember(view);
+            setSectionId((current) =>
+              view.sections.some((section) => section.id === current)
+                ? current
+                : (view.sections[0]?.id ?? ""),
+            );
+          })
+        : transport.admin(module, controller.signal, query).then((view) => {
+            if (generation === sequence.current) setAdmin(view);
+          });
+    promise
+      .catch((issue) => {
+        if (generation === sequence.current && issue?.name !== "AbortError") {
+          setError(messageFrom(issue));
+          setErrorStatus(
+            issue instanceof NetworkTransportError ? issue.status : undefined,
+          );
+        }
+      })
+      .finally(() => {
+        if (generation === sequence.current) setLoading(false);
+      });
+    return () => controller.abort();
+  }, [transport, mode, module, query, revision]);
+  const navigateAdmin = useCallback(
+    (nextModule: string, values: Record<string, unknown>) => {
+      if (!NETWORK_ADMIN_MODULES.some(([id]) => id === nextModule))
+        throw new NetworkTransportError("Unknown operations view.");
+      const next: Record<string, string> = {};
+      for (const key of [
+        "memberId",
+        "opportunityId",
+        "runId",
+        "city",
+        "cohort",
+        "generator",
+        "exploration",
+        "startAt",
+        "endAt",
+        "keyword",
+        "channel",
+        "edgeType",
+        "neighborhood",
+        "inviterCluster",
+        "blind",
+        "safety",
+        "sentiment",
+      ])
+        if (typeof values[key] === "string" && values[key].trim())
+          next[key] = values[key].trim();
+      sequence.current++;
+      setAdmin(null);
+      setReceipt(null);
+      setAction(null);
+      setMode("admin");
+      setModule(nextModule);
+      setQuery(next);
+    },
+    [],
+  );
+  const chooseAction = useCallback(
+    (next: NetworkAction) => {
+      if (commandBusy) return;
+      if (next.type === "navigate_admin") {
+        try {
+          navigateAdmin(String(next.args?.module ?? ""), next.args ?? {});
+        } catch (issue) {
+          setError(messageFrom(issue));
+        }
+        return;
+      }
+      setAction(next);
+      setActionError(null);
+      setReceipt(null);
+      commandId.current = crypto.randomUUID();
+    },
+    [commandBusy, navigateAdmin],
+  );
+  const applyAction = async (values: Record<string, NetworkFieldValue>) => {
+    if (!action || commandBusy || !commandId.current) return;
+    if (action.type === "filter_admin") {
+      try {
+        navigateAdmin(module, { ...action.args, ...values });
+        commandId.current = null;
+      } catch (issue) {
+        setActionError(messageFrom(issue));
+      }
+      return;
+    }
+    setCommandBusy(true);
+    setActionError(null);
+    try {
+      const result = await transport.command(action, values, commandId.current);
+      setReceipt(result);
+      setAction(null);
+      commandId.current = null;
+      setRevision((current) => current + 1);
+      mainRef.current?.focus({ preventScroll: true });
+    } catch (issue) {
+      setActionError(messageFrom(issue));
+    } finally {
+      setCommandBusy(false);
+    }
+  };
+  const switchFixture = async (nextId: string) => {
+    if (!nextId || fixtureBusy || commandBusy) return;
+    setFixtureBusy(true);
+    setError(null);
+    // Fence old principal responses before awaiting the host's signed session.
+    sequence.current++;
+    setMember(null);
+    setAdmin(null);
+    setQuery({});
+    setAction(null);
+    setReceipt(null);
+    try {
+      await transport.selectFixture(nextId);
+      setFixtureId(nextId);
+      const fixture = fixtures.find((item) => item.id === nextId);
+      setMode(fixture?.type === "staff" ? "admin" : "member");
+      setRevision((current) => current + 1);
+    } catch (issue) {
+      setError(messageFrom(issue));
+    } finally {
+      setFixtureBusy(false);
+    }
+  };
+  const section: NetworkSection | undefined = member?.sections.find(
+    (item) => item.id === sectionId,
+  );
+  const displayedTitle =
+    mode === "member"
+      ? (section?.title ?? "Your Network")
+      : (admin?.title ??
+        NETWORK_ADMIN_MODULES.find(([id]) => id === module)?.[1] ??
+        "Operations");
+  return (
+    <div className="network-workbench">
+      <a className="nw-skip-link" href="#network-main">
+        Skip to content
+      </a>
+      <header className="nw-header">
+        <a className="nw-wordmark" href="#network-main">
+          the network
+          <span className="nw-wordmark-dot" aria-hidden="true" />
+        </a>
+        <fieldset className="nw-mode-switch">
+          <legend className="nw-sr-only">Workbench area</legend>
+          <Button
+            unstyled
+            className="nw-mode-button"
+            aria-pressed={mode === "member"}
+            onClick={() => {
+              setMode("member");
+              setAction(null);
+            }}
+            disabled={commandBusy || fixtureBusy}
+          >
+            Member
+          </Button>
+          <Button
+            unstyled
+            className="nw-mode-button"
+            aria-pressed={mode === "admin"}
+            onClick={() => {
+              setMode("admin");
+              setAction(null);
+            }}
+            disabled={commandBusy || fixtureBusy}
+          >
+            Operations
+          </Button>
+        </fieldset>
+        <div className="nw-fixture">
+          <label htmlFor={fixtureFieldId}>View as</label>
+          <select
+            id={fixtureFieldId}
+            value={fixtureId}
+            onChange={(event) => void switchFixture(event.target.value)}
+            disabled={fixtureBusy || commandBusy}
+          >
+            <option value="">Choose local identity</option>
+            {fixtures.map((fixture) => (
+              <option key={fixture.id} value={fixture.id}>
+                {fixture.name}
+                {fixture.type ? ` · ${fixture.type}` : ""}
+              </option>
+            ))}
+          </select>
+        </div>
+      </header>
+      <div className="nw-environment">
+        <strong>
+          {initialMode === "admin" ? "Local admin QA" : "Local QA workbench"}
+        </strong>
+        <span>
+          Synthetic members and encounters. Actions stay in this local world.
+          {initialMode === "admin" &&
+            " Choose a local staff identity in View as for sample-data operations. This is not Cloud admin authentication."}
+        </span>
+        {fixtureBusy && <span role="status">Switching identity…</span>}
+      </div>
+      <div className={`nw-layout${action ? " nw-layout-action" : ""}`}>
+        <nav
+          className="nw-navigation"
+          aria-label={
+            mode === "member" ? "Member sections" : "Operations modules"
+          }
+        >
+          <p className="nw-navigation-title">
+            {mode === "member"
+              ? (member?.member.displayName ??
+                member?.member.name ??
+                "Your space")
+              : "Operations"}
+          </p>
+          {mode === "member"
+            ? member?.sections.map((item) => (
+                <Button
+                  unstyled
+                  className="nw-nav-button"
