+    clock.advanceTo(clock.now().getTime() + 4 * 3600000);
+    const replay = await jobs.dispatch({
+      taskId: task.taskId,
+      kind: "custom",
+      firedAtIso: committed.state.firedAt,
+      channelKey: "internal",
+      promptInstructions: "",
+      contextRequest: undefined,
+      metadata: task.metadata,
+    });
+    expect(replay.ok).toBe(true);
+    expect(calls).toBe(1); // Recovery reads the immutable run, not a new moving window or new effect.
+  } finally {
+    await host.close();
+  }
+}, 120000);
+
+it("the actual host refires city cadence across days and monthly planning retains its next-month source scope", async () => {
+  const clock = new SimClock(Date.parse("2026-10-31T16:00:00Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "simulation:matching-cadence-recurrence",
+    clock,
+  });
+  try {
+    await seedSimulationMembers(host.domain, 2, 42);
+    const settings = await host.domain.getSettings({ type: "system" });
+    const { revision, ...values } = settings;
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "configure",
+        requestId: "recurrence-config",
+        expectedRevision: revision,
+        settings: values,
+      },
+    );
+    clock.advanceTo("2026-10-31T16:03:00Z");
+    await host.drainDue();
+    for (const instant of [
+      "2026-11-01T16:00:00Z",
+      "2026-11-01T23:00:00Z",
+      "2026-11-02T23:00:00Z",
+      "2026-11-03T23:00:00Z",
+    ]) {
+      clock.advanceTo(instant);
+      await host.drainDue();
+    }
+    const events = (await host.domain.adminView({ type: "system" })).events.filter(
+      (event) => event.kind === "matching_heartbeat",
+    );
+    for (const city of ["SF", "NYC"]) {
+      const nightly = events.filter(
+        (event) => event.details.city === city && event.details.cadence === "nightly",
+      );
+      expect(nightly.length).toBeGreaterThanOrEqual(3);
+      const monthly = events.filter(
+        (event) =>
+          event.details.city === city && event.details.cadence === "monthly_event_planning",
+      );
+      expect(monthly).toHaveLength(1);
+      const runId = monthly[0]?.details.runId;
+      if (typeof runId !== "string") throw new Error("Actual monthly owning run required");
+      const stored = await host.domain.getMatchingRun({ type: "system" }, runId);
+      const run = stored?.log;
+      if (!run || typeof run.replayInput !== "object" || !run.replayInput)
+        throw new Error("Monthly replay input required");
+      expect(run.replayInput).toMatchObject({
+        constraints: { eventAnchorsOnly: true },
+        window: {
+          start: Date.parse(city === "SF" ? "2026-12-01T08:00:00Z" : "2026-12-01T05:00:00Z"),
+          end: Date.parse(city === "SF" ? "2027-01-01T08:00:00Z" : "2027-01-01T05:00:00Z"),
+        },
+      });
+      expect(run.proposals).toEqual([]); // No sourced city events and density below launch gate; never a fabricated programme.
+    }
+    const before = events.length;
+    await host.drainDue();
+    const after = await host.db.execute(
+      `SELECT COUNT(*)::int count FROM network.events WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND payload->>'kind'='matching_heartbeat'`,
+    );
+    expect(Number(after[0]?.count)).toBe(before);
+    const health = await host.matchingJobs.health();
+    expect(
+      health.tasks.filter((task) => task.binding.cadence === "monthly_event_planning"),
+    ).toHaveLength(2);
+  } finally {
+    await host.close();
+  }
+}, 120000);
