+          ) && !record.departedMemberIds.includes(id),
+      ),
+    };
+  }
+  async moderateRelay(
+    actor: NetworkActor,
+    input: {
+      opportunityId: string;
+      revision: number;
+      messageId: string;
+      caseId: string;
+      requestId: string;
+      decision: "released" | "rejected";
+      reason: string;
+    },
+  ): Promise<RelayMessage> {
+    if (
+      actor.type !== "staff" ||
+      !actor.roles.some((role) => role === "safety" || role === "admin")
+    )
+      denied("Authenticated safety reviewer required", "NETWORK_FORBIDDEN");
+    if (!input.requestId.trim() || input.requestId.length > 200)
+      denied("Bounded moderation request identity required", "NETWORK_INVALID");
+    return this.options.db.transaction(async (execute) => {
+      await execute(
+        "SELECT network_id FROM network.domains WHERE network_id=" +
+          sqlQuote(this.options.networkId) +
+          " FOR UPDATE",
+      );
+      const domain = this.domain(execute),
+        value = await domain.getOpportunity(SYSTEM, input.opportunityId);
+      if (!("participantIds" in value) || value.revision !== input.revision)
+        denied("Current opportunity revision required", "NETWORK_CONFLICT");
+      const opportunity = value as NetworkOpportunity,
+        record = await this.load(execute, opportunity);
+      const message = record.messages.find((candidate) => candidate.id === input.messageId);
+      if (!message || message.moderation?.caseId !== input.caseId)
+        denied("Exact held relay/case linkage required", "NETWORK_CONFLICT");
+      const item = await new DomainStore(execute, this.options.networkId).get<SafetyCase>(
+        "safety_cases",
+        input.caseId,
+      );
+      if (
+        item.evidenceRef?.opportunityId !== opportunity.id ||
+        item.evidenceRef.messageId !== message.id
+      )
+        denied("Case differs from relay source", "NETWORK_FORBIDDEN");
+      if (
+        !(
+          await new DomainStore(execute, this.options.networkId).list<
+            import("../domain/types.js").NetworkEvent
+          >("events")
+        ).some(
+          (event) =>
+            event.kind === "restricted_safety_case_reveal" &&
+            event.details.caseId === item.id &&
+            event.actor.type === "staff" &&
+            event.actor.userId === actor.userId,
+        )
+      )
+        denied(
+          "Explicit purpose-bound case evidence access required before moderation",
+          "NETWORK_FORBIDDEN",
+        );
+      const authority =
+        input.decision === "released"
+          ? await this.currentAuthority(domain, opportunity.id, opportunity.revision)
+          : null;
+      if (
+        authority &&
+        (record.departedMemberIds.includes(message.senderId) ||
+          !authority.members.some((member) => member.memberId === message.senderId))
+      )
+        denied("Sender left the current relay", "NETWORK_FORBIDDEN");
+      await domain.command(actor, {
+        type: "resolve_relay_case",
+        requestId: input.requestId,
+        caseId: input.caseId,
+        decision: input.decision,
+        reason: input.reason,
+      });
+      const currentCase = await new DomainStore(execute, this.options.networkId).get<SafetyCase>(
+        "safety_cases",
+        input.caseId,
+      );
+      if (currentCase.moderation?.state !== input.decision || currentCase.state !== "resolved")
+        denied("Current safety decision differs from the requested replay", "NETWORK_CONFLICT");
+      message.moderation = { caseId: input.caseId, state: input.decision };
+      if (input.decision === "released") {
+        const visible = projectVenue(record, hasVenueDisclosure(opportunity)).messages.find(
+          (candidate) => candidate.id === message.id,
+        )!;
+        assertKnownDisclosure(authority!.members, visible.body);
+        message.body = visible.body;
+      }
+      await this.save(execute, record);
+      return message;
+    });
+  }
+  private contactProjection(
+    record: CoordinationRecord,
+    opportunity: NetworkOpportunity,
+    members: NetworkMember[],
+    senderId: string,
+    targetId: string,
+  ): { ready: boolean; contacts: Array<{ memberId: string; channel: string; address: string }> } {
+    const key = networkDigest([opportunity.id, opportunity.revision, [senderId, targetId].sort()]);
+    const pair = members.filter(
+        (member) => member.memberId === senderId || member.memberId === targetId,
+      ),
+      request = record.contactRequests[key];
+    if (
+      pair.length !== 2 ||
+      !request ||
+      record.departedMemberIds.includes(targetId) ||
+      !pair.every((member) =>
+        member.channels.some(
+          (channel) =>
+            !channel.stopped &&
+            channel.verifiedAt <= this.options.clock.now().toISOString() &&
+            channel.channel === request.grants[member.memberId]?.channel &&
+            channel.address === request.grants[member.memberId]?.address,
+        ),
+      )
+    )
+      return { ready: false, contacts: [] };
+    const grant = request.grants[targetId];
+    if (!grant) return { ready: false, contacts: [] };
+    return {
+      ready: true,
+      contacts: [{ memberId: targetId, channel: grant.channel, address: grant.address }],
+    };
+  }
+  async requestContactExchange(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string; targetMemberId?: string },
+  ): Promise<{
+    ready: boolean;
+    contacts: Array<{ memberId: string; channel: string; address: string }>;
+  }> {
+    return this.mutate(
+      actor,
+      input.opportunityId,
+      input.revision,
+      input.requestId,
+      input,
+      async (_domain, record, opportunity, id, members) => {
+        const targetId =
+          input.targetMemberId ??
+          (members.length === 2
+            ? members.find((member) => member.memberId !== id)?.memberId
+            : undefined);
+        if (
+          !targetId ||
+          targetId === id ||
+          !members.some((member) => member.memberId === targetId) ||
+          record.departedMemberIds.includes(targetId)
+        )
+          denied("Choose one currently connected peer for contact exchange", "NETWORK_INVALID");
+        const key = networkDigest([opportunity.id, opportunity.revision, [id, targetId].sort()]);
+        const channel = members
+          .find((member) => member.memberId === id)
+          ?.channels.find(
+            (entry) =>
+              entry.primary &&
+              !entry.stopped &&
+              entry.channel !== "web" &&
+              entry.verifiedAt <= this.options.clock.now().toISOString(),
+          );
+        if (!channel) denied("A verified open contact channel is required", "NETWORK_INELIGIBLE");
+        const requests = record.contactRequests[key] ?? {
+          memberIds: [id, targetId].sort(),
+          grants: {},
+        };
+        requests.grants[id] = { channel: channel.channel, address: channel.address };
+        record.contactRequests[key] = requests;
+        return this.contactProjection(record, opportunity, members, id, targetId);
+      },
+      (_result, record, opportunity, members) => {
+        if (actor.type !== "member")
+          denied("Member contact authority required", "NETWORK_FORBIDDEN");
+        const targetId =
+          input.targetMemberId ??
+          (members.length === 2
+            ? members.find((member) => member.memberId !== actor.memberId)?.memberId
+            : undefined);
+        if (!targetId) return { ready: false, contacts: [] };
+        return this.contactProjection(record, opportunity, members, actor.memberId, targetId);
+      },
+    );
+  }
+  async leaveRelay(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string },
+  ): Promise<CoordinationAcknowledgment> {
+    const prior = await this.cleanupReplay(actor, input, "left");
+    if (prior) return prior;
+    try {
+      return await this.mutate(
+        actor,
+        input.opportunityId,
+        input.revision,
+        input.requestId,
+        input,
+        async (_domain, record, _opportunity, id) => {
+          record.departedMemberIds.push(id);
+          return { opportunityId: input.opportunityId, kind: "left" as const };
+        },
+      );
+    } catch (error) {
+      if (!(error instanceof NetworkDomainError)) throw error;
+      const replay = await this.cleanupReplay(actor, input, "left");
+      if (replay) return replay;
+      throw error;
+    }
+  }
+  async markLate(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string; minutes: number },
+  ): Promise<CoordinationRecord> {
+    if (!Number.isSafeInteger(input.minutes) || input.minutes < 1 || input.minutes > 240)
+      denied("Invalid lateness estimate", "NETWORK_INVALID");
+    await this.mutate(
+      actor,
+      input.opportunityId,
+      input.revision,
+      input.requestId,
+      input,
+      async (_domain, record, _opportunity, id) => {
+        record.late[id] = input.minutes;
+        return record;
+      },
+    );
+    return this.view(actor, input.opportunityId);
+  }
+  async cancel(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string },
+  ): Promise<CoordinationAcknowledgment> {
+    const prior = await this.cleanupReplay(actor, input, "cancelled");
+    let result = prior;
+    if (!result) {
+      try {
+        result = await this.mutate(
+          actor,
+          input.opportunityId,
+          input.revision,
+          input.requestId,
+          input,
+          async (domain, _record, opportunity) => {
+            await domain.command(SYSTEM, {
+              type: "transition_opportunity",
+              requestId: `${input.requestId}:cancel`,
+              opportunityId: opportunity.id,
+              expectedRevision: opportunity.revision,
+              to: "cancelled",
+            });
+            return { opportunityId: input.opportunityId, kind: "cancelled" as const };
+          },
+        );
+      } catch (error) {
+        if (!(error instanceof NetworkDomainError)) throw error;
+        const replay = await this.cleanupReplay(actor, input, "cancelled");
+        if (!replay) throw error;
+        result = replay;
+      }
+    }
+    if (this.options.scheduler)
+      for (const task of await this.options.scheduler.list())
+        if (
+          (task.metadata?.network as { opportunityId?: string } | undefined)?.opportunityId ===
+            input.opportunityId &&
+          task.state.status === "scheduled"
+        )
+          await this.options.scheduler.apply(task.taskId, "dismiss");
+    return result;
+  }
+  async scheduleLifecycle(
+    opportunity: NetworkOpportunity,
+    record: CoordinationRecord,
+  ): Promise<ScheduledTask[]> {
+    if (!this.options.scheduler || !record.slot)
+      denied("Owning scheduler and confirmed slot required", "NETWORK_CONFLICT");
+    const start = Date.parse(record.slot.startAt),
+      end = Date.parse(record.slot.endAt);
+    const schedule = [
+      { purpose: "reminder", at: start - 24 * 3_600_000 },
+      { purpose: "reminder", at: start - 3_600_000 },
+      { purpose: "checkin", at: start },
+      { purpose: "feedback", at: end + 2 * 3_600_000 },
+    ];
+    const tasks: ScheduledTask[] = [];
+    for (const memberId of acceptedParticipantIds(opportunity))
+      for (const item of schedule) {
+        if (item.at < this.options.clock.now().getTime()) continue;
+        const binding = {
+          networkId: this.options.networkId,
+          opportunityId: opportunity.id,
+          opportunityRevision: opportunity.revision,
+          coordinationRevision: record.revision,
+          slotId: record.slot.id,
+          memberId,
+          purpose: item.purpose,
+        };
+        tasks.push(
+          await this.options.scheduler.schedule({
+            kind: "reminder",
+            trigger: { kind: "once", atIso: new Date(item.at).toISOString() },
+            priority: "medium",
+            promptInstructions:
+              "Network logistics: use the typed host binding; do not infer recipients or consent.",
+            respectsGlobalPause: true,
+            source: "user_chat",
+            createdBy: "network",
+            ownerVisible: true,
+            metadata: { network: binding },
+            shouldFire: { compose: "all", gates: [{ kind: "network_authority", params: binding }] },
+            output: { destination: "channel", target: memberId },
+            idempotencyKey: `network:${networkDigest([binding, item.at])}`,
+          }),
+        );
+      }
+    return tasks;
+  }
+}
