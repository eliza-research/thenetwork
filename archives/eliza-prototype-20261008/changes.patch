@@ -0,0 +1,462 @@
+import type { KnowledgeGraphRelationship, LifeOpsEntityAttribute } from "@elizaos/contracts";
+import type { IAgentRuntime } from "@elizaos/core";
+import { EntityStore, RelationshipStore } from "@elizaos/plugin-relationships/graph";
+import {
+  createSchedulingSqlScheduledTaskStore,
+  eraseSchedulingSqlTaskPrivateData,
+} from "@elizaos/plugin-scheduling";
+import type { CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+import { PgApprovalQueue } from "../../../../../../../plugins/plugin-assistant/src/services/approval/store.ts";
+import {
+  type ApprovalRequest,
+  ApprovalStateTransitionError,
+} from "../../../../../../../plugins/plugin-assistant/src/services/approval/types.ts";
+import { networkDigest } from "../digest.ts";
+import { DomainStore } from "../domain/store.ts";
+import {
+  type Feedback,
+  type NetworkClock,
+  type NetworkCommand,
+  type NetworkCommandResult,
+  NetworkDomainError,
+  type NetworkMember,
+  type NetworkOpportunity,
+} from "../domain/types.ts";
+import { runtimeInSqlTransaction } from "../runtime-sql.ts";
+
+const FACT_PREFIX = "network.fact:";
+const MEMBER_PREFIX = "network:member:";
+const GRAPH_TYPES = ["network:reported_met", "network:would_meet_again"];
+
+/** Native owners hold generic knowledge and effects; Network retains consent, provenance and policy. */
+export function createNetworkNativeOwners(options: {
+  runtime: IAgentRuntime;
+  networkId: string;
+  clock: NetworkClock;
+}) {
+  const namespace = `network:${networkDigest(options.networkId)}:`;
+  function effectOwners(execute: CarveOutSqlExecutor) {
+    const taskOptions = {
+      agentId: options.runtime.agentId,
+      executeSql: execute,
+      now: options.clock.now.bind(options.clock),
+    };
+    return {
+      queue: new PgApprovalQueue(runtimeInSqlTransaction(options.runtime, execute), {
+        agentId: options.runtime.agentId,
+        now: options.clock.now.bind(options.clock),
+      }),
+      tasks: createSchedulingSqlScheduledTaskStore(taskOptions),
+      taskOptions,
+    };
+  }
+  function requestScope(request: ApprovalRequest): "owned" | "foreign" | "unqualified" {
+    if (request.requestedBy !== "network-local-host" && request.requestedBy !== "network")
+      return "foreign";
+    const receiptNetwork = request.execution?.providerReceipt?.networkId;
+    const keyNetwork = request.idempotencyKey?.match(/^network:([a-f0-9]{64}):/)?.[1];
+    if (
+      keyNetwork &&
+      typeof receiptNetwork === "string" &&
+      keyNetwork !== networkDigest(receiptNetwork) &&
+      (keyNetwork === networkDigest(options.networkId) || receiptNetwork === options.networkId)
+    )
+      return "unqualified";
+    if (
+      request.idempotencyKey?.startsWith(namespace) ||
+      request.execution?.providerReceipt?.networkId === options.networkId
+    )
+      return "owned";
+    return request.idempotencyKey?.startsWith("network:") &&
+      !request.idempotencyKey.slice(8).match(/^[a-f0-9]{64}:/)
+      ? "unqualified"
+      : "foreign";
+  }
+  async function restrictMemberEffects(execute: CarveOutSqlExecutor, member: NetworkMember) {
+    const { queue, tasks } = effectOwners(execute);
+    for (const request of await queue.list({
+      subjectUserId: member.cloudUserId,
+      state: null,
+      action: null,
+    })) {
+      if (
+        requestScope(request) !== "owned" ||
+        request.execution?.dispatchStartedAt ||
+        request.state === "reconciliation_required"
+      )
+        continue;
+      try {
+        let state: ApprovalRequest["state"] = request.state;
+        if (state === "executing" && request.execution) {
+          const recovered = await queue.recoverUnstartedExecution({
+            requestId: request.id,
+            subjectUserId: member.cloudUserId,
+            attemptId: request.execution.attemptId,
+          });
+          state = recovered.state;
+        }
+        if (["pending", "approved", "retryable"].includes(state))
+          await queue.markExpired(request.id, member.cloudUserId);
+      } catch (error) {
+        if (!(error instanceof ApprovalStateTransitionError)) throw error;
+        // Concurrently started effects keep their original receipt/reconciliation owner.
+        // Current membership restrictions still deny every subsequent Network send.
+      }
+    }
+    for (const task of await tasks.list()) {
+      const binding = task.metadata?.network as
+        | { networkId?: string; memberId?: string }
+        | undefined;
+      if (
+        binding?.networkId !== options.networkId ||
+        binding.memberId !== member.memberId ||
+        task.state.status === "fired"
+      )
+        continue;
+      const { state, metadata, ...definition } = task;
+      await tasks.upsertIfStatus(
+        {
+          ...task,
+          trigger: { kind: "manual" },
+          state: { ...state, status: "dismissed" },
+          metadata: {
+            ...metadata,
+            networkRestriction: {
+              reason: member.age !== "adult" ? "nonadult" : "safety_hold",
+              at: options.clock.now().toISOString(),
+            },
+          },
+        },
+        {
+          expectedStatus: state.status,
+          expectedState: state,
+          expectedMetadata: metadata ?? {},
+          expectedDefinition: definition,
+          nextFireAtIso: null,
+        },
+      );
+    }
+  }
+  function graph(execute: CarveOutSqlExecutor, memberId: string) {
+    const joined = runtimeInSqlTransaction(options.runtime, execute);
+    const partition = `${namespace}member:${networkDigest(memberId)}`;
+    return {
+      entities: new EntityStore(joined, partition),
+      relationships: new RelationshipStore(joined, partition),
+    };
+  }
+
+  async function syncMember(execute: CarveOutSqlExecutor, member: NetworkMember) {
+    if (member.accountState === "removed") return;
+    const { entities } = graph(execute, member.memberId);
+    const existing = await entities.ensureSelf();
+    const attributes: Record<string, LifeOpsEntityAttribute | null> = Object.fromEntries(
+      Object.keys(existing.attributes ?? {})
+        .filter((key) => key.startsWith(FACT_PREFIX))
+        .map((key) => [key, null]),
+    );
+    for (const fact of member.facts) {
+      if (fact.status === "rejected") continue;
+      attributes[`${FACT_PREFIX}${fact.id}`] = {
+        value: { kind: fact.kind, value: fact.value, tags: fact.tags },
+        confidence: fact.confidence,
+        evidence: [`network:fact:${fact.id}:revision:${fact.revision}`],
+        updatedAt: fact.updatedAt,
+      };
+    }
+    await entities.patchAttributes("self", attributes);
+  }
+
+  async function syncEncounter(execute: CarveOutSqlExecutor, feedback: Feedback[]) {
+    const store = new DomainStore(execute, options.networkId);
+    const available = new Set(
+      (await store.list<NetworkMember>("members"))
+        .filter((member) => member.accountState !== "removed")
+        .map((member) => member.memberId),
+    );
+    for (const report of feedback) {
+      if (
+        !available.has(report.memberId) ||
+        !report.happened ||
+        !report.attendedIds.includes(report.memberId)
+      )
+        continue;
+      const opportunity = await store.get<NetworkOpportunity>(
+        "opportunities",
+        report.opportunityId,
+      );
+      if (!["completed", "feedback_collected"].includes(opportunity.state))
+        throw new NetworkDomainError(
+          "NETWORK_INVALID",
+          "Native encounter requires committed completed opportunity",
+        );
+      const committed = new Set(
+        opportunity.participants
+          .filter((participant) => participant.acceptedAt)
+          .map((participant) => participant.memberId),
+      );
+      const { entities, relationships } = graph(execute, report.memberId);
+      await entities.ensureSelf();
+      for (const target of report.attendedIds) {
+        if (target === report.memberId || !available.has(target)) continue;
+        if (!committed.has(target) || !committed.has(report.memberId))
+          throw new NetworkDomainError(
+            "NETWORK_INVALID",
+            "Native encounter target was not committed",
+          );
+        const entityId = `${MEMBER_PREFIX}${target}`;
+        if (!(await entities.get(entityId)))
+          await entities.upsert({
+            entityId,
+            type: "person",
+            preferredName: "Network member",
+            identities: [],
+            tags: [],
+            visibility: "owner_only",
+            state: {},
+          });
+        const confirmed =
+          !opportunity.participants.some(
+            (participant) =>
+              [report.memberId, target].includes(participant.memberId) &&
+              ["no_show", "cancelled_with_notice"].includes(participant.state),
+          ) &&
+          feedback.some(
+            (other) =>
+              other.memberId === target &&
+              other.happened &&
+              other.attendedIds.includes(target) &&
+              other.attendedIds.includes(report.memberId),
+          );
+        for (const type of [
+          "network:reported_met",
+          ...(report.wouldMeetAgainIds.includes(target) ? ["network:would_meet_again"] : []),
+        ]) {
+          await relationships.upsert({
+            relationshipId: `${namespace}edge:${networkDigest([report.id, target, type])}`,
+            fromEntityId: "self",
+            toEntityId: entityId,
+            type,
+            source: "system",
+            confidence: confirmed ? 1 : 0.5,
+            state: { lastInteractionAt: report.createdAt, interactionCount: 1 },
+            evidence: [`network:feedback:${report.id}`],
+            metadata: {
+              networkId: options.networkId,
+              opportunityId: report.opportunityId,
+              confirmed,
+            },
+          });
+        }
+      }
+    }
+  }
+
+  async function nativeEdges(
+    execute: CarveOutSqlExecutor,
+    memberIds: string[],
+    types: string[] = ["network:reported_met"],
+  ) {
+    const projection: Array<{
+      memberId: string;
+      edge: KnowledgeGraphRelationship;
+      targetId: string;
+    }> = [];
+    const scoped = new Set(memberIds);
+    for (const memberId of scoped) {
+      const relationships = graph(execute, memberId).relationships;
+      for (const edge of await relationships.list({ type: types })) {
+        if (
+          edge.fromEntityId !== "self" ||
+          !edge.toEntityId.startsWith(MEMBER_PREFIX) ||
+          edge.metadata?.networkId !== options.networkId
+        )
+          throw new NetworkDomainError("NETWORK_INVALID", "Native Network graph scope invalid");
+        const targetId = edge.toEntityId.slice(MEMBER_PREFIX.length);
+        if (scoped.has(targetId)) projection.push({ memberId, edge, targetId });
+      }
+    }
+    return projection;
+  }
+
+  return {
+    /** Explicit host startup/import reconciliation, never an alternate graph store. */
+    async synchronize(execute: CarveOutSqlExecutor) {
+      const store = new DomainStore(execute, options.networkId);
+      for (const member of await store.list<NetworkMember>("members"))
+        await syncMember(execute, member);
+      const feedback = await store.list<Feedback>("feedback");
+      for (const opportunityId of new Set(feedback.map((report) => report.opportunityId)))
+        await syncEncounter(
+          execute,
+          feedback.filter((report) => report.opportunityId === opportunityId),
+        );
+    },
+    async afterCommand(
+      execute: CarveOutSqlExecutor,
+      command: NetworkCommand,
+      result: NetworkCommandResult,
+    ) {
+      if (command.type === "delete_account") return;
+      if ("memberId" in result && "facts" in result) {
+        await syncMember(execute, result);
+        if (result.age !== "adult" || result.safetyHold)
+          await restrictMemberEffects(execute, result);
+      }
+      const changedMemberId =
+        command.type === "hold_safety_case" || command.type === "resolve_safety"
+          ? command.memberId
+          : command.type === "report_member" && command.placeHold
+            ? command.reportedId
+            : null;
+      if (changedMemberId) {
+        const member = await new DomainStore(execute, options.networkId).get<NetworkMember>(
+          "members",
+          changedMemberId,
+        );
+        await syncMember(execute, member);
+        if (member.age !== "adult" || member.safetyHold)
+          await restrictMemberEffects(execute, member);
+      }
+      if (command.type === "give_feedback") {
+        const store = new DomainStore(execute, options.networkId);
+        await syncEncounter(
+          execute,
+          (await store.list<Feedback>("feedback")).filter(
+            (report) => report.opportunityId === command.feedback.opportunityId,
+          ),
+        );
+      }
+    },
+    async graphEdges(execute: CarveOutSqlExecutor, memberIds: string[]) {
+      return (await nativeEdges(execute, memberIds)).map(({ memberId, edge, targetId }) => ({
+        from: memberId,
+        to: targetId,
+        confirmed: edge.metadata?.confirmed === true,
+      }));
+    },
+    async adminGraph(execute: CarveOutSqlExecutor, memberIds: string[]) {
+      return (await nativeEdges(execute, memberIds, GRAPH_TYPES)).map(
+        ({ memberId, edge, targetId }) => ({
+          id: edge.relationshipId,
+          from: memberId,
+          to: targetId,
+          type: edge.type,
+          confirmed: edge.metadata?.confirmed === true,
+          confidence: edge.confidence,
+          lastInteractionAt: edge.state.lastInteractionAt ?? null,
+          createdAt: edge.createdAt,
+        }),
+      );
+    },
+    async eraseMemberArtifacts(
+      execute: CarveOutSqlExecutor,
+      memberId: string,
+      relayDeliveries: Array<{ messageId: string; recipientId: string }>,
+      identity: { cloudUserId: string },
+    ) {
+      const store = new DomainStore(execute, options.networkId);
+      const members = await store.list<NetworkMember>("members");
+      for (const member of members) {
+        const { entities, relationships } = graph(execute, member.memberId);
+        for (const edge of await relationships.list({ type: GRAPH_TYPES, includeRetired: true })) {
+          if (edge.metadata?.networkId !== options.networkId) continue;
+          if (member.memberId === memberId || edge.toEntityId === `${MEMBER_PREFIX}${memberId}`)
+            await relationships.erase(edge.relationshipId);
+        }
+        if (member.memberId === memberId) {
+          const self = await entities.get("self");
+          if (self)
+            await entities.patchAttributes(
+              "self",
+              Object.fromEntries(
+                Object.keys(self.attributes ?? {})
+                  .filter((key) => key.startsWith(FACT_PREFIX))
+                  .map((key) => [key, null]),
+              ),
+            );
+        }
+      }
+      const { queue, tasks, taskOptions } = effectOwners(execute);
+      for (const delivery of relayDeliveries) {
+        const recipient = members.find((member) => member.memberId === delivery.recipientId);
+        if (!recipient || recipient.accountState === "removed") continue;
+        const key = `${namespace}network:relay:${delivery.messageId}:${delivery.recipientId}`;
+        const request = await queue.byIdempotencyKey(key, recipient.cloudUserId);
+        if (!request) continue;
+        if (requestScope(request) !== "owned")
+          throw new NetworkDomainError(
+            "NETWORK_CONFLICT",
+            "Relay effect ownership requires reconciliation before erasure",
+          );
+        await queue.erasePrivateData({
+          requestId: request.id,
+          subjectUserId: recipient.cloudUserId,
+          requestedBy: request.requestedBy,
+          closedSyntheticProvider: "network-local-mock",
+        });
+      }
+      for (const task of await tasks.list()) {
+        const binding = task.metadata?.network as
+          | { networkId?: string; memberId?: string }
+          | undefined;
+        if (binding?.networkId === options.networkId && binding.memberId === memberId) {
+          const receipt = (
+            task.metadata?.lastDispatchResult as { receipt?: Record<string, unknown> } | undefined
+          )?.receipt;
+          const key = receipt?.idempotencyKey;
+          const request =
+            typeof key === "string"
+              ? await queue.byIdempotencyKey(key, identity.cloudUserId)
+              : null;
+          const settled = request?.execution?.providerReceipt;
+          const closedSyntheticReceipt =
+            request?.state === "done" &&
+            requestScope(request) === "owned" &&
+            request.execution?.provider === "network-local-mock" &&
+            request.execution.providerIdempotencyKey === key &&
+            settled?.synthetic === true &&
+            settled.networkId === options.networkId &&
+            settled.provider === "network-local-mock" &&
+            typeof settled.providerMessageId === "string" &&
+            typeof settled.acceptedAt === "string" &&
+            typeof key === "string"
+              ? {
+                  provider: settled.provider,
+                  providerMessageId: settled.providerMessageId,
+                  acceptedAt: settled.acceptedAt,
+                  idempotencyKey: key,
+                }
+              : undefined;
+          await eraseSchedulingSqlTaskPrivateData(taskOptions, {
+            taskId: task.taskId,
+            createdBy: task.createdBy,
+            closedSyntheticProvider: "network-local-mock",
+            closedSyntheticReceipt,
+          });
+        }
+      }
+      for (const request of await queue.list({
+        subjectUserId: identity.cloudUserId,
+        state: null,
+        action: null,
+      })) {
+        const scope = requestScope(request);
+        if (scope !== "owned") {
+          if (scope === "unqualified")
+            throw new NetworkDomainError(
+              "NETWORK_CONFLICT",
+              "Network effect ownership requires reconciliation before erasure",
+            );
+          continue;
+        }
+        await queue.erasePrivateData({
+          requestId: request.id,
+          subjectUserId: identity.cloudUserId,
+          requestedBy: request.requestedBy,
+          closedSyntheticProvider: "network-local-mock",
+        });
+      }
+    },
+  };
+}
