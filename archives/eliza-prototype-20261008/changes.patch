+      commandField("endsAt", "Until in your local time", "datetime-local"),
+      { ...commandField("tags", "Interests, comma separated"), required: false },
+    ]),
+  );
+  const rows: NetworkRow[] = [];
+  for (const opportunity of domainView.opportunities) {
+    if (
+      opportunity.kind === "monthly_event" ||
+      !["connected", "scheduled", "completed"].includes(opportunity.state)
+    )
+      continue;
+    let record: CoordinationRecord | undefined,
+      historicalIssue: string | null = null;
+    try {
+      record = await host.coordination.view(actor, opportunity.id);
+      await host.coordination.currentAuthority(host.domain, opportunity.id, opportunity.revision);
