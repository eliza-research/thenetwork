@@ -0,0 +1,101 @@
+// @vitest-environment jsdom
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+} from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import type { NetworkConversationView, NetworkWorkbenchTransport } from "./api";
+import { createNetworkWorkbenchTransport } from "./api";
+import { NetworkConversation } from "./NetworkConversation";
+
+afterEach(cleanup);
+const empty: NetworkConversationView = {
+  mode: "scripted_local",
+  messages: [],
+  onboarding: { exchange: 0, total: 8, complete: false },
+};
+function host(
+  overrides: Partial<NetworkWorkbenchTransport> = {},
+): NetworkWorkbenchTransport {
+  return {
+    ...createNetworkWorkbenchTransport(),
+    conversation: vi.fn().mockResolvedValue(empty),
+    ...overrides,
+  };
+}
+
+it("retries the original message identity after a lost response without claiming success", async () => {
+  const message = vi
+    .fn()
+    .mockRejectedValueOnce(new Error("The outcome is unavailable."))
+    .mockResolvedValueOnce({
+      ...empty,
+      messages: [
+        {
+          id: "reply",
+          role: "network",
+          text: "Your proposed fact is recorded.",
+          createdAt: "2026-10-06T16:00:00.000Z",
+        },
+      ],
+    });
+  const onChange = vi.fn();
+  render(
+    <NetworkConversation transport={host({ message })} onChange={onChange} />,
+  );
+  await screen.findByText(/Onboarding:/);
+  fireEvent.change(screen.getByLabelText("Your message"), {
+    target: { value: "I enjoy guitar" },
+  });
+  fireEvent.click(screen.getByRole("button", { name: "Send message" }));
+  await screen.findByRole("alert");
+  expect(onChange).not.toHaveBeenCalled();
+  expect(screen.queryByText("Your proposed fact is recorded.")).toBeNull();
+  fireEvent.click(screen.getByRole("button", { name: "Retry same message" }));
+  await screen.findByText("Your proposed fact is recorded.");
+  expect(message.mock.calls).toHaveLength(2);
+  expect(message.mock.calls[1]).toEqual(message.mock.calls[0]);
+  expect(onChange).toHaveBeenCalledOnce();
+});
+
+it("does not disclose a previous principal's late conversation response after switching", async () => {
+  let resolve: (value: NetworkConversationView) => void = () => {
+    throw new Error("No pending turn");
+  };
+  const pending = new Promise<NetworkConversationView>((complete) => {
+    resolve = complete;
+  });
+  const original = host({ message: vi.fn().mockReturnValue(pending) });
+  const view = render(
+    <NetworkConversation
+      key="original"
+      transport={original}
+      onChange={vi.fn()}
+    />,
+  );
+  await screen.findByText(/Onboarding:/);
+  fireEvent.change(screen.getByLabelText("Your message"), {
+    target: { value: "show my profile" },
+  });
+  fireEvent.click(screen.getByRole("button", { name: "Send message" }));
+  view.rerender(
+    <NetworkConversation key="current" transport={host()} onChange={vi.fn()} />,
+  );
+  await act(async () =>
+    resolve({
+      ...empty,
+      messages: [
+        {
+          id: "private",
+          role: "network",
+          text: "Old member private fact",
+          createdAt: "2026-10-06T16:00:00.000Z",
+        },
+      ],
+    }),
+  );
+  expect(screen.queryByText("Old member private fact")).toBeNull();
+});
