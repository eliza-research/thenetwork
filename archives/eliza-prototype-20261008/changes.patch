+/** Effects are owned by the domain, coordinator and native transport; this translates HTTP fields. */
+async function publishRelay(
+  host: Pick<Awaited<ReturnType<typeof createLocalNetworkHost>>, "coordination" | "transport">,
+  opportunityId: string,
+  revision: number,
+  messageId: string,
+) {
+  return host.coordination.withAuthority(
+    opportunityId,
+    revision,
+    async (domain, record, opportunity, members, execute) => {
+      const message = await host.coordination.relayDelivery(
+        domain,
+        record,
+        opportunity,
+        members,
+        messageId,
+      );
+      for (const memberId of message.recipientIds)
+        await host.transport.send(
+          {
+            memberId,
+            opportunityId,
+            revision,
+            body: message.body,
+            purpose: "relay",
+            idempotencyKey: "network:relay:" + message.id + ":" + memberId,
+          },
+          { domain, execute },
+        );
+      return { messageId: message.id, processedRecipients: message.recipientIds.length };
+    },
+  );
