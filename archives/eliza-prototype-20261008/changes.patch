+/** Resolve an exact canonical relay copy visible to the reporting member; IDs alone grant no access. */
+export async function readRelaySafetyEvidence(
+  execute: CarveOutSqlExecutor,
+  networkId: string,
+  reference: SafetyRelayReference,
+  memberId: string,
+): Promise<RelayMessage> {
+  const rows = await execute(
+    "SELECT payload FROM network.coordination WHERE network_id=" +
+      sqlQuote(networkId) +
+      " AND opportunity_id=" +
+      sqlQuote(reference.opportunityId),
+  );
+  if (!rows[0]) denied("Relay evidence is unavailable", "NETWORK_NOT_FOUND");
+  const record = decode<CoordinationRecord>(rows[0].payload);
+  const message = record.messages.find((candidate) => candidate.id === reference.messageId);
+  if (
+    record.opportunityId !== reference.opportunityId ||
+    !message ||
+    (message.senderId !== memberId && !message.recipientIds.includes(memberId)) ||
+    (message.moderation?.state !== undefined &&
+      message.moderation.state !== "released" &&
+      message.senderId !== memberId)
+  )
+    denied("This private relay source is not available to the reporter", "NETWORK_FORBIDDEN");
+  if (typeof message.body !== "string" || message.body.length > 2400)
+    denied("Stored relay evidence is invalid", "NETWORK_INVALID");
+  return message;
