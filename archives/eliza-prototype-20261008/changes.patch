index 000000000000..3063bfd0acb8
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/evaluation/native-cadence.study.test.ts
@@ -0,0 +1,425 @@
+import { createHash } from "node:crypto";
+import { createReadStream, createWriteStream } from "node:fs";
+import { appendFile, mkdir, readdir, readFile, statfs, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { Readable, Transform } from "node:stream";
+import { pipeline } from "node:stream/promises";
+import { createGzip } from "node:zlib";
+import { sqlQuote } from "@elizaos/plugin-sql";
+import { expect, it, vi } from "vitest";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { createNativeSimulationTransport } from "../workbench/simulation-ingress.ts";
+import { SimClock } from "./fixtures.ts";
+import { runNetworkSimulation } from "./simulator.ts";
+
+const study = process.env.NETWORK_NATIVE_CADENCE_STUDY === "1" ? it : it.skip;
+const studyTimeoutMs =
+  Number(process.env.NETWORK_NATIVE_PERSONAS ?? 100) === 2000
+    ? 10_800_000
+    : Number(process.env.NETWORK_NATIVE_DAYS ?? 1) > 1
+      ? 7_200_000
+      : 120_000;
+study(
+  "executes the bounded native study with Clock as the sole matching producer and complete owner evidence",
+  async () => {
+    const label = process.env.NETWORK_NATIVE_CADENCE_LABEL ?? "final-100-1";
+    if (!/^[a-z0-9-]{1,80}$/.test(label)) throw new Error("Safe label required");
+    const personaCount = Number(process.env.NETWORK_NATIVE_PERSONAS ?? 100),
+      days = Number(process.env.NETWORK_NATIVE_DAYS ?? 1);
+    const evidenceBudgetBytes = (personaCount === 2000 ? 4 : 1) * 1024 ** 3;
+    if (
+      ![
+        [100, 1],
+        [300, 60],
+        [2000, 30],
+      ].some(([people, duration]) => people === personaCount && duration === days)
+    )
+      throw new Error("Only the specified 100/1, 300/60 and 2000/30 studies are admitted");
+    const directory = join(process.cwd(), "test-results/network-native-study", label);
+    await mkdir(directory, { recursive: false });
+    vi.stubEnv("ELIZA_STATE_DIR", join(directory, "state"));
+    const paths: string[] = [];
+    const collect = async (dir: string) => {
+      for (const item of await readdir(dir, { withFileTypes: true })) {
+        const path = join(dir, item.name);
+        if (item.isDirectory()) await collect(path);
+        else if (path.endsWith(".ts") && !path.endsWith(".test.ts")) paths.push(path);
+      }
+    };
+    await collect("packages/cloud/shared/src/lib/network");
+    paths.push(
+      "plugins/plugin-calendar/src/service/availability.ts",
+      "plugins/plugin-scheduling/src/scheduled-task/store.ts",
+      "plugins/plugin-scheduling/src/scheduled-task/runner.ts",
+      "plugins/plugin-sql/src/memory-store.ts",
+      "plugins/plugin-sql/src/stores/memory.store.ts",
+      "plugins/plugin-sql/src/base.ts",
+      "plugins/plugin-assistant/src/services/approval/store.ts",
+      "plugins/plugin-assistant/src/features/trajectories/TrajectoriesService.ts",
+      "plugins/plugin-network/src/index.ts",
+      "packages/core/src/security/pii-pseudonymizer.ts",
+      "packages/core/src/security/entity-recognizer.ts",
+      "packages/core/src/security/pii-detectors.ts",
+      "packages/core/src/security/runtime-abort-signal.ts",
+      "packages/core/src/security/pii-context-pack.ts",
+      "packages/core/src/security/pii-scrub-seam.ts",
+      "plugins/plugin-scheduling/src/scheduled-task/local-time.ts",
+    );
+    const hashes = async () =>
+      Object.fromEntries(
+        await Promise.all(
+          paths.sort().map(async (path) => [
+            path,
+            createHash("sha256")
+              .update(await readFile(path))
+              .digest("hex"),
+          ]),
+        ),
+      );
+    const before = await hashes(),
+      clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+    const host = await createLocalNetworkHost({
+      dataDir: "memory://",
+      networkId: `simulation:native-cadence:${label}`,
+      clock,
+    });
+    const started = performance.now();
+    const userTables = async () =>
+      host.db.execute(`SELECT schemaname,tablename FROM pg_tables
+      WHERE schemaname NOT IN ('pg_catalog','information_schema') AND schemaname NOT LIKE 'pg_%'
+      ORDER BY schemaname,tablename`);
+    const identifier = (value: unknown) => {
+      if (typeof value !== "string") throw new Error("Native SQL table identifier required");
+      return `"${value.replaceAll('"', '""')}"`;
+    };
+    // Cost: two full native row-hash scans per quiescent day; a sorted SHA256 multiset retains every row/field without materializing full trajectory JSON in JS.
+    const tableDigests = async () => {
+      const tables = await userTables();
+      const result: Record<string, { rows: number; sha256: string; bytes: number }> = {};
+      for (const table of tables) {
+        const name = `${identifier(table.schemaname)}.${identifier(table.tablename)}`;
+        const digestStarted = performance.now();
+        await appendFile(
+          join(directory, "table-digest-progress.jsonl"),
+          `${JSON.stringify({ event: "started", table: name, clockAt: clock.now().toISOString() })}\n`,
+        );
+        const rows = await host.db.execute(`SELECT COUNT(*)::int rows,
+          encode(sha256(convert_to(COALESCE(string_agg(digest,'' ORDER BY digest),''),'UTF8')),'hex') sha256,
+          pg_total_relation_size(${sqlQuote(name)})::bigint bytes
+          FROM (SELECT encode(sha256(convert_to(to_jsonb(t)::text,'UTF8')),'hex') digest FROM ${name} t) content`);
+        const row = rows[0];
+        if (!row || typeof row.sha256 !== "string")
+          throw new Error("Native complete table digest required");
+        result[name] = { rows: Number(row.rows), sha256: row.sha256, bytes: Number(row.bytes) };
+        await appendFile(
+          join(directory, "table-digest-progress.jsonl"),
+          `${JSON.stringify({ event: "completed", table: name, clockAt: clock.now().toISOString(), elapsedMs: performance.now() - digestStarted })}\n`,
+        );
+      }
+      return result;
+    };
+    const maintenance: Array<Record<string, unknown>> = [];
+    let evidenceBytes = 0;
+    const exportEvidence = async (name: string, chunks: AsyncIterable<string>) => {
+      const path = join(directory, name);
+      await pipeline(
+        Readable.from(chunks),
+        createGzip(),
+        new Transform({
+          transform(chunk: Buffer, _encoding, callback) {
+            evidenceBytes += chunk.length;
+            if (evidenceBytes > evidenceBudgetBytes)
+              callback(
+                new Error(
+                  `Complete evidence exceeds the declared ${evidenceBudgetBytes / 1024 ** 3}GiB disk budget`,
+                ),
+              );
+            else callback(null, chunk);
+          },
+        }),
+        createWriteStream(path, { flags: "wx" }),
+      );
+      const hash = createHash("sha256");
+      for await (const chunk of createReadStream(path)) hash.update(chunk);
+      return { path: name, sha256: hash.digest("hex") };
+    };
+    try {
+      const report = await runNetworkSimulation({
+        domain: host.domain,
+        coordination: host.coordination,
+        clock,
+        transport: createNativeSimulationTransport(host, clock),
+        seed: 20261006,
+        personaCount,
+        days,
+        drainDue: host.drainDue,
+        graphEdges: (ids) => host.native.graphEdges(host.db.execute, ids),
+        progress: async (progress) => {
+          await host.domain.command(
+            { type: "system" },
+            {
+              type: "record_event",
+              requestId: `progress:${progress.day}`,
+              kind: "native_study_progress",
+              memberIds: [],
+              opportunityId: null,
+              details: { ...progress, clockAt: clock.now().toISOString() },
+            },
+          );
+          const resources: Record<string, unknown> = { rss: process.memoryUsage().rss };
+          if (days > 1) {
+            const beforeVacuum = await tableDigests();
+            await host.db.execute("VACUUM (ANALYZE)");
+            const afterVacuum = await tableDigests();
+            const contents = (tables: Awaited<ReturnType<typeof tableDigests>>) =>
+              Object.fromEntries(
+                Object.entries(tables).map(([name, table]) => [
+                  name,
+                  { rows: table.rows, sha256: table.sha256 },
+                ]),
+              );
+            expect(contents(afterVacuum)).toEqual(contents(beforeVacuum));
+            const maintenanceRecord = { day: progress.day, beforeVacuum, afterVacuum };
+            maintenance.push(maintenanceRecord);
+            await appendFile(
+              join(directory, "maintenance.jsonl"),
+              JSON.stringify(maintenanceRecord) + "\n",
+            );
+            resources.nativeBytesBefore = Object.values(beforeVacuum).reduce(
+              (bytes, table) => bytes + table.bytes,
+              0,
+            );
+            resources.nativeBytesAfter = Object.values(afterVacuum).reduce(
+              (bytes, table) => bytes + table.bytes,
+              0,
+            );
+          }
+          const disk = await statfs(directory);
+          resources.diskAvailableBytes = disk.bavail * disk.bsize;
+          await appendFile(
+            join(directory, "progress.jsonl"),
+            JSON.stringify({
+              ...progress,
+              elapsedMs: performance.now() - started,
+              clockAt: clock.now().toISOString(),
+              ...resources,
+            }) + "\n",
+          );
+          if (process.memoryUsage().rss > 20 * 1024 ** 3)
+            throw new Error("Native study exceeds its 20GiB RSS resource budget");
+          if (disk.bavail * disk.bsize < 512 * 1024 ** 2)
+            throw new Error("Native study preserves at least 512MiB available disk");
+        },
+      });
+      const after = await hashes(),
+        changed = paths.filter((path) => before[path] !== after[path]);
+      const memories = await host.db.execute(
+        `SELECT type,COUNT(*)::int count FROM memories WHERE agent_id=${sqlQuote(host.runtime.agentId)} GROUP BY type ORDER BY type`,
+      );
+      const trajectories = await host.db.execute(
+        `SELECT COUNT(*)::int count FROM trajectories WHERE agent_id=${sqlQuote(host.runtime.agentId)}`,
+      );
+      const normalizedSteps = await host.db.execute(
+        `SELECT COUNT(*)::int count FROM trajectory_steps WHERE trajectory_id IN (SELECT id FROM trajectories WHERE agent_id=${sqlQuote(host.runtime.agentId)})`,
+      );
+      const steps = await host.db.execute(
+        `SELECT COALESCE(SUM(step_count),0)::int stepCount, COALESCE(SUM(jsonb_array_length(steps_json)),0)::int storedEnvelopeSteps FROM trajectories WHERE agent_id=${sqlQuote(host.runtime.agentId)}`,
+      );
+      const clockRuns = await host.db.execute(
+        `SELECT COUNT(*)::int count FROM network.matching_runs WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND id LIKE 'clock:%'`,
+      );
+      const manualRuns = await host.db.execute(
+        `SELECT COUNT(*)::int count FROM network.matching_runs WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND id LIKE 'simulation:%'`,
+      );
+      const cadenceRuns = await host.db.execute(
+        `SELECT payload#>>'{details,cadence}' cadence,payload#>>'{details,city}' city,COUNT(*)::int count
+          FROM network.events WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND payload->>'kind'='matching_heartbeat'
+          GROUP BY payload#>>'{details,cadence}',payload#>>'{details,city}' ORDER BY city,cadence`,
+      );
+      const queue = await host.db.execute(
+        `SELECT state,COUNT(*)::int count FROM approval_requests WHERE agent_id=${sqlQuote(host.runtime.agentId)} GROUP BY state ORDER BY state`,
+      );
+      const finalTableDigests = await tableDigests();
+      const exports: Array<{ path: string; sha256: string }> = [];
+      if (days > 1) {
+        exports.push(
+          await exportEvidence(
+            "complete-report.json.gz",
+            (async function* () {
+              yield "{";
+              let first = true;
+              for (const [key, value] of Object.entries(report)) {
+                if (!first) yield ",";
+                first = false;
+                yield JSON.stringify(key) + ":";
+                if (Array.isArray(value)) {
+                  yield "[";
+                  for (let index = 0; index < value.length; index++) {
+                    if (index) yield ",";
+                    yield JSON.stringify(value[index]);
+                  }
+                  yield "]";
+                } else yield JSON.stringify(value);
+              }
+              yield "}\n";
+            })(),
+          ),
+        );
+        const tables = await userTables();
+        exports.push(
+          await host.db.transaction((execute) =>
+            exportEvidence(
+              "complete-native-tables.jsonl.gz",
+              (async function* () {
+                for (const table of tables) {
+                  const name = `${identifier(table.schemaname)}.${identifier(table.tablename)}`;
+                  // Cost: one native-owner transaction scans each complete table once; each fetch retains one full row, including tables without primary keys.
+                  const rowHashes: string[] = [];
+                  await execute(`DECLARE native_table_export NO SCROLL CURSOR FOR
+                    SELECT t.ctid::text cursor,to_jsonb(t)::text body FROM ${name} t`);
+                  try {
+                    for (;;) {
+                      const rows = await execute("FETCH FORWARD 1 FROM native_table_export");
+                      for (const row of rows) {
+                        if (typeof row.body !== "string" || typeof row.cursor !== "string")
+                          throw new Error("Full native JSON row and owning cursor required");
+                        rowHashes.push(createHash("sha256").update(row.body).digest("hex"));
+                        yield `{"table":${JSON.stringify(name)},"row":${row.body}}\n`;
+                      }
+                      if (rows.length < 1) break;
+                    }
+                  } finally {
+                    await execute("CLOSE native_table_export");
+                  }
+                  expect(rowHashes.length).toBe(finalTableDigests[name]?.rows);
+                  expect(createHash("sha256").update(rowHashes.sort().join("")).digest("hex")).toBe(
+                    finalTableDigests[name]?.sha256,
+                  );
+                }
+              })(),
+            ),
+          ),
+        );
+      }
+      const progress = await host.db.execute(`SELECT id,sequence,payload FROM network.events
+        WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND payload->>'kind'='native_study_progress' ORDER BY sequence`);
+      await writeFile(
+        join(directory, "SUMMARY.json"),
+        JSON.stringify(
+          {
+            label,
+            node: process.version,
+            bunRequired: "1.4.2",
+            memoryOnly: true,
+            personaCount,
+            days,
+            networkId: host.domain.options.networkId,
+            elapsedMs: performance.now() - started,
+            runDigest: report.runDigest,
+            counts: report.counts,
+            qualification: report.qualification,
+            startAt: report.startAt,
+            endAt: report.endAt,
+            clockAt: clock.now().toISOString(),
+            nativeStorage: {
+              memories,
+              trajectories,
+              steps,
+              normalizedSteps,
+              clockRuns,
+              cadenceRuns,
+              manualRuns,
+              queue,
+            },
+            progress,
+            committedOutboundReceipts: report.outbound.length,
+            metrics: report.metrics,
+            scenarios: report.scenarios,
+            maintenanceDays: maintenance.length,
+            finalTableDigests,
+            evidenceBytes,
+            exports,
+            resourceBudget: {
+              rssBytes: 20 * 1024 ** 3,
+              gzipEvidenceBytes: evidenceBudgetBytes,
+              minimumAvailableDiskBytes: 512 * 1024 ** 2,
+              runtimeMs: studyTimeoutMs,
+              currentGraph:
+                "Native HTTP turns update full trajectory envelopes repeatedly; MVCC relation bloat observed333MiB for33MiB live compressed steps_json in101turns.",
+              budgetGraph:
+                "The same native pipeline and Clock producers; one full-row-hash-proven VACUUM at each awaited quiescent day boundary, preserving every owner row and full trace; stream all final evidence once.",
+            },
+            matchingRuns: report.matchingRuns.map((run) => ({
+              runId: run.runId,
+              inputDigest: run.inputDigest,
+              stageEvidence: run.stageEvidence,
+              judgeCalls: run.judgeCalls,
+            })),
+            sourceBefore: before,
+            sourceAfter: after,
+            changedSourcePaths: changed,
+            scope:
+              "scripted local authenticated HTTP and SharedEliza, actual SQL Clock/domain/queue/graph owners; paid/real providers/LLM quality/shadow/productvalue unrun",
+          },
+          null,
+          2,
+        ) + "\n",
