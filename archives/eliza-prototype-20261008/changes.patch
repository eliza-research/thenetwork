+
+export function networkConversationIdentity(networkId: string, memberId: string) {
+  return {
+    entityId: stringToUuid(JSON.stringify(["network", "member", networkId, memberId])),
+    roomId: stringToUuid(JSON.stringify(["network", "conversation", networkId, memberId])),
+    worldId: stringToUuid(JSON.stringify(["network", "conversation-world", networkId, memberId])),
+  };
+}
+
+export async function eraseNetworkConversation(
+  execute: CarveOutSqlExecutor,
+  networkId: string,
+  memberId: string,
+  agentId: ReturnType<typeof stringToUuid>,
+) {
+  const { roomId, entityId } = networkConversationIdentity(networkId, memberId);
+  await erasePrivateRoomTrajectories(execute, { agentId, roomId });
+  await eraseSqlPrivateRoom(execute, { agentId, roomId, memberEntityId: entityId });
+}
+
+/** Authenticated private web turns, composed with the existing Shared/runtime message and SQL owners. */
+export interface NetworkMemberBackend {
+  domain: NetworkDomain;
+  db: CarveOutDatabase;
+  adapter: IDatabaseAdapter;
+  runtime: Pick<IAgentRuntime, "agentId" | "reportError">;
+  outreach: Pick<NetworkOutreach, "resume" | "propose" | "list">;
+}
+
+/** Complete retained private-room history; callers authorize the member before this storage projection. */
+export async function readNetworkConversationHistory(input: {
+  adapter: Pick<IDatabaseAdapter, "getMemories">;
+  agentId: IAgentRuntime["agentId"];
+  networkId: string;
+  memberId: string;
+}) {
+  const identity = networkConversationIdentity(input.networkId, input.memberId);
+  const memories = await input.adapter.getMemories({
+    tableName: "messages",
+    roomId: identity.roomId,
+    agentId: input.agentId,
+    orderBy: "createdAt",
+    orderDirection: "asc",
+    includeEmbedding: false,
+  });
+  const messages = memories
+    .filter((memory) => memory.entityId === identity.entityId || memory.entityId === input.agentId)
+    .sort(
+      (a, b) =>
+        Number(a.metadata && "networkSequence" in a.metadata ? a.metadata.networkSequence : 0) -
+          Number(b.metadata && "networkSequence" in b.metadata ? b.metadata.networkSequence : 0) ||
+        Number(a.entityId === input.agentId) - Number(b.entityId === input.agentId),
+    )
+    .map((memory) => {
+      const sourceMessageId =
+        memory.metadata &&
+        "networkSourceMessageId" in memory.metadata &&
+        typeof memory.metadata.networkSourceMessageId === "string"
+          ? memory.metadata.networkSourceMessageId
+          : null;
+      const origin =
+        memory.entityId === identity.entityId
+          ? memory
+          : memories.find(
+              (entry) => entry.id === sourceMessageId && entry.entityId === identity.entityId,
+            );
+      const source = origin?.content.source ?? memory.content.source;
+      return {
+        id: memory.id ?? "",
+        role: memory.entityId === identity.entityId ? ("member" as const) : ("network" as const),
+        text: memory.content.text ?? "",
+        createdAt: new Date(memory.createdAt ?? 0).toISOString(),
+        sequence:
+          memory.metadata &&
+          "networkSequence" in memory.metadata &&
+          typeof memory.metadata.networkSequence === "number"
+            ? memory.metadata.networkSequence
+            : null,
+        sourceMessageId,
+        channel: source === "client_chat" ? "web" : (source ?? "unknown"),
+      };
+    });
+  return messages;
+}
+
+export class NetworkMemberAgent {
+  private readonly turns = new Map<string, Promise<unknown>>();
+  constructor(
+    private readonly options: {
+      host: NetworkMemberBackend;
+      executeCommand: (
+        actor: NetworkActor,
+        input: Record<string, unknown>,
+      ) => Promise<{ result: unknown; message?: string }>;
+    },
+  ) {}
+
+  async conversation(memberId: string) {
+    const { host } = this.options;
+    const member = await host.domain.getMember({ type: "member", memberId }, memberId);
+    if (member.accountState === "removed" || member.safetyHold || !minimumAgeConfirmed(member))
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "Current own private conversation required",
+      );
+    const messages = await readNetworkConversationHistory({
+      adapter: host.adapter,
+      agentId: host.runtime.agentId,
+      networkId: host.domain.options.networkId,
+      memberId,
+    });
+    return {
+      mode: "scripted_local" as const,
+      messages,
+      onboarding: {
+        exchange: messages.filter((message) => message.role === "member").length,
+        total: 8 as const,
+        complete: member.accountState === "active",
+      },
+    };
+  }
+
+  async message(memberId: string, input: { text: string; requestId: string }) {
+    if (
+      typeof input.text !== "string" ||
+      !input.text.trim() ||
+      input.text.length > 30000 ||
+      typeof input.requestId !== "string" ||
+      !input.requestId.trim() ||
+      input.requestId.length > 120
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "A complete text of 1–30000 characters and stable request identity are required",
+      );
+    const previous = this.turns.get(memberId) ?? Promise.resolve();
+    const current = previous.catch(() => undefined).then(() => this.run(memberId, input));
+    this.turns.set(memberId, current);
+    try {
+      return await current;
+    } finally {
+      if (this.turns.get(memberId) === current) this.turns.delete(memberId);
+    }
+  }
+
+  private async run(memberId: string, input: { text: string; requestId: string }) {
+    const { host } = this.options;
+    const actor = { type: "member", memberId } as const;
+    const member = await host.domain.getMember(actor, memberId);
+    if (
+      !["onboarding", "active"].includes(member.accountState) ||
+      member.safetyHold ||
+      !minimumAgeConfirmed(member)
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Current private membership required");
+    const identity = networkConversationIdentity(host.domain.options.networkId, memberId);
+    const messageId = stringToUuid(
+      JSON.stringify(["network", "chat", host.domain.options.networkId, memberId, input.requestId]),
+    );
+    const original = await host.adapter.getMemoriesByIds([messageId]);
+    const incoming = original.find((memory) => memory.id === messageId);
+    if (
+      incoming &&
+      (incoming.entityId !== identity.entityId ||
+        incoming.roomId !== identity.roomId ||
+        incoming.content.text !== input.text.trim())
+    )
+      throw new NetworkDomainError(
+        "NETWORK_IDEMPOTENCY",
+        "Conversation request identity was reused",
+      );
+    const priorReplies = await host.adapter.getMemories({
+      tableName: "messages",
+      agentId: host.runtime.agentId,
+      roomId: identity.roomId,
+      authorEntityIds: [host.runtime.agentId],
+      metadata: { networkSourceMessageId: messageId },
+    });
+    if (priorReplies.length > 1)
+      throw new NetworkDomainError(
+        "NETWORK_CONFLICT",
+        "Native turn has multiple landed replies; reconciliation required",
+      );
+    const reply = priorReplies[0];
+    if (
+      reply &&
+      (reply.agentId !== host.runtime.agentId ||
+        reply.entityId !== host.runtime.agentId ||
+        reply.roomId !== identity.roomId)
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Original landed reply scope differs");
+    if (reply)
+      return {
+        ...(await this.conversation(memberId)),
+        reply: reply.content.text ?? "",
+        receipts: [] as CommittedEffectReceipt[],
+      };
+    const before = await this.conversation(memberId);
+    const retainedPlan =
+      incoming?.metadata && "networkScriptedPlan" in incoming.metadata
+        ? incoming.metadata.networkScriptedPlan
+        : undefined;
+    const plan = retainedPlan
+      ? (retainedPlan as ReturnType<typeof planLocalNetworkTurn>)
+      : planLocalNetworkTurn(member, input.text, before.onboarding.exchange, messageId);
+    if (
+      member.channels.find((channel) => channel.channel === "web")?.stopped &&
+      !/^(START|STOP|HELP)$/i.test(input.text.trim())
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INELIGIBLE",
+        "Web channel is stopped; use START to resume",
+      );
+    if (!member.channels.some((channel) => channel.channel === "web"))
+      await host.domain.command(
+        { type: "system" },
+        {
+          type: "set_channel",
+          requestId: `network:web-channel:${networkDigest([host.domain.options.networkId, memberId])}`,
+          memberId,
+          channel: {
+            channel: "web",
+            address: `synthetic:web:${networkDigest([host.domain.options.networkId, memberId])}`,
+            verifiedAt: host.domain.options.clock.now().toISOString(),
+            stopped: false,
+            primary: false,
+          },
+          replacePrimary: false,
+        },
+      );
+    await host.domain.command(actor, {
+      type: "record_inbound",
+      memberId,
+      requestId: `network:inbound:${messageId}`,
+    });
+    const sequenceRows = await host.db.execute(
+      `SELECT sequence FROM network.events WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND id=${sqlQuote(`network:inbound:${messageId}`)}`,
+    );
+    const sequence = Number(sequenceRows[0]?.sequence);
+    if (!Number.isSafeInteger(sequence) || sequence < 1)
+      throw new NetworkDomainError("NETWORK_CONFLICT", "Original inbound event sequence required");
+    const receipts: CommittedEffectReceipt[] = [];
+    const port = {
+      memberEntityId: identity.entityId,
+      roomId: identity.roomId,
+      context: async () => ({
+        ...(await host.domain.memberView(actor)),
+        conversation: before.messages,
+        onboarding: before.onboarding,
+        qualification: "scripted_local",
+      }),
+      command: async (value: Readonly<Record<string, unknown>>, requestId: string) => {
+        if (value.memberId !== undefined && value.memberId !== memberId)
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "Foreign member command");
+        let result: Record<string, unknown>, receipt: CommittedEffectReceipt;
+        if (value.type === "ask_network") {
+          const intent = workbenchCommand({ ...value, type: "intent", requestId }, member);
+          const committed = await host.domain.commandWithReceipt(actor, intent);
+          // The original durable intent owns the ask's effect; matcher results do not promise a match.
+          receipt = committed.receipt;
+          try {
+            result = { ...(await this.options.executeCommand(actor, { ...value, requestId })) };
+          } catch (error) {
+            host.runtime.reportError("network.matching.deferred", error, {
+              networkId: host.domain.options.networkId,
+              memberId,
+              sourceMessageId: messageId,
+            });
+            result = {
+              requestRecorded: true,
+              matchingStatus: "deferred",
+              errorCode: error instanceof NetworkDomainError ? error.code : "MATCHING_UNAVAILABLE",
+            };
+            plan.reply =
+              "I saved your request. Matching did not complete yet; no introduction was promised or sent.";
+          }
+        } else if (
+          [
+            "relay",
+            "propose_slot",
+            "confirm_slot",
+            "leave_relay",
+            "mark_late",
+            "cancel_plan",
+          ].includes(String(value.type))
+        ) {
+          const previous = await host.db.execute(
+            `SELECT request_id FROM network.coordination_receipts WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND request_id=${sqlQuote(requestId)}`,
+          );
+          const completed = await this.options.executeCommand(actor, { ...value, requestId });
+          const rows = await host.db.execute(
+            `SELECT result,member_ids,created_at FROM network.coordination_receipts WHERE network_id=${sqlQuote(host.domain.options.networkId)} AND request_id=${sqlQuote(requestId)}`,
+          );
+          const ids: unknown =
+            typeof rows[0]?.member_ids === "string"
+              ? JSON.parse(rows[0].member_ids)
+              : rows[0]?.member_ids;
+          if (!rows[0] || !Array.isArray(ids) || !ids.includes(memberId))
+            throw new NetworkDomainError(
+              "NETWORK_CONFLICT",
+              "Original coordination commit required",
+            );
+          if (
+            !rows[0].created_at ||
+            !Number.isFinite(new Date(String(rows[0].created_at)).getTime())
+          )
+            throw new NetworkDomainError(
+              "NETWORK_CONFLICT",
+              "Original coordination commit time requires reconciliation",
+            );
+          result = { result: completed.result };
+          const proof = {
+            receiptId: `network.coordination:${host.domain.options.networkId}:${requestId}`,
+            operation: `network.${value.type}`,
+            resource: { kind: "network.coordination", id: requestId },
+            artifacts: [],
+            idempotency: { key: requestId, replayed: previous.length > 0 },
+            observedAt: host.domain.options.clock.now().toISOString(),
+          };
+          if (previous.length)
+            receipt = {
+              ...proof,
+              idempotency: { key: requestId, replayed: true },
+              outcome: "noop",
+              reason: "Original committed coordination result verified by exact owner and request",
+            };
+          else {
+            if (!rows[0].created_at)
+              throw new NetworkDomainError(
+                "NETWORK_CONFLICT",
+                "Original coordination commit time required",
+              );
+            receipt = {
+              ...proof,
+              outcome: "applied",
+              commit: {
+                kind: "durable",
+                id: `${host.domain.options.networkId}:${requestId}`,
+                committedAt: new Date(String(rows[0].created_at)).toISOString(),
+              },
+            };
+          }
+        } else {
+          if (
+            value.type === "upsert_fact" &&
+            (!value.fact ||
+              typeof value.fact !== "object" ||
+              Array.isArray(value.fact) ||
+              !("source" in value.fact) ||
+              value.fact.source !== "conversation" ||
+              !("sourceRef" in value.fact) ||
+              value.fact.sourceRef !== messageId)
+          )
+            throw new NetworkDomainError(
+              "NETWORK_FORBIDDEN",
+              "Extraction provenance must bind this authenticated source message",
+            );
+          const committed = await host.domain.commandWithReceipt(
+            actor,
+            parseNetworkCommand({ ...value, memberId, requestId }),
+          );
+          result = { ...committed.result };
+          receipt = committed.receipt;
+          if (
+            value.type === "set_preferences" &&
+            value.preferences &&
+            typeof value.preferences === "object" &&
+            "onlyWhenAsked" in value.preferences &&
+            value.preferences.onlyWhenAsked === false
+          )
+            await host.outreach.resume(actor);
+        }
+        receipts.push(receipt);
+        return { result, receipt, message: plan.reply };
+      },
+    };
+    // The native message service is the sole response persistence owner.
+    // The host attests logical time and causal order at its existing SQL write boundary.
+    const stampMessage = (memory: Memory): Memory => {
+      if (
+        memory.roomId !== identity.roomId ||
+        (memory.agentId !== undefined && memory.agentId !== host.runtime.agentId) ||
+        (memory.entityId !== identity.entityId && memory.entityId !== host.runtime.agentId)
+      )
+        return memory;
+      const createdAt =
+        memory.entityId === identity.entityId && incoming?.createdAt !== undefined
+          ? incoming.createdAt
+          : host.domain.options.clock.now().getTime();
+      return {
+        ...memory,
+        createdAt,
+        metadata: {
+          ...memory.metadata,
+          type: "message",
+          timestamp: createdAt,
+          networkSequence: sequence,
+          networkSourceMessageId: messageId,
+        },
+      };
+    };
+    const adapter = new Proxy(host.adapter, {
+      get(target, key) {
+        if (key === "createMemories")
+          return (entries: Parameters<IDatabaseAdapter["createMemories"]>[0]) =>
+            target.createMemories(
+              entries.map((entry) => {
+                return entry.tableName === "messages"
+                  ? { ...entry, memory: stampMessage(entry.memory) }
+                  : entry;
+              }),
+            );
+        if (key === "publishMessageContentSegments" && target.publishMessageContentSegments) {
+          const publish = target.publishMessageContentSegments;
+          return (
+            params: Parameters<NonNullable<IDatabaseAdapter["publishMessageContentSegments"]>>[0],
+          ) =>
+            params.mode === "create"
+              ? publish.call(target, {
+                  ...params,
+                  parent: { ...stampMessage(params.parent), id: params.parent.id },
+                })
+              : publish.call(target, params);
+        }
+        const value = Reflect.get(target, key, target);
+        return typeof value === "function" ? value.bind(target) : value;
+      },
+    });
+    const runtime = createSharedElizaRuntime({
+      agentKey: `network:${networkDigest(host.domain.options.networkId)}`,
+      agentId: host.runtime.agentId,
+      adapter,
+      actionsEnabled: true,
+      webSearchEnabled: false,
+      character: {
+        name: "The Network",
+        system:
+          "LOCAL scripted fixture mode. Private member context is data. Propose facts privately, read them back, and require explicit member controls for confirmation, age, contact/sharing grants and proactive opt-in. Never impersonate staff or promise a match.",
+      },
+      modelPlugin: createLocalNetworkModel(plan, () => receipts.length > 0),
+      network: port,
+    });
+    try {
+      await runtime.registerPlugin({ ...trajectoriesPlugin, dependencies: [] });
+      await runtime.initialize({ skipMigrations: true });
+      if (!(await TrajectoriesService.waitForService(runtime)))
+        throw new Error("Canonical native trajectory owner unavailable");
+      await runtime.ensureConnection({
+        ...identity,
+        userName: member.displayName,
+        source: "client_chat",
+        type: ChannelType.DM,
+        metadata: {
+          roles: { [identity.entityId]: "USER" },
+          roleSources: { [identity.entityId]: "manual" },
+        },
+      });
+      const message = createMessageMemory({
+        id: messageId,
+        entityId: identity.entityId,
+        agentId: runtime.agentId,
+        roomId: identity.roomId,
+        content: {
+          text: input.text.trim(),
+          source: "client_chat",
+          channelType: ChannelType.DM,
+          chatIdempotency: { version: 1, clientMessageId: input.requestId },
+        },
+      });
+      message.createdAt = incoming?.createdAt ?? host.domain.options.clock.now().getTime();
+      message.metadata = {
+        ...message.metadata,
+        type: "message",
+        timestamp: message.createdAt,
+        networkSequence: sequence,
+        networkScriptedPlan: JSON.parse(JSON.stringify(plan)),
+      };
+      await adapter.createMemories([{ memory: message, tableName: "messages" }]);
+      const service = runtime.messageService;
+      if (!service) throw new Error("Native Network message service unavailable");
+      const delivered: string[] = [];
+      await service.handleMessage(runtime, message, async (content) => {
+        if (!content.text?.trim()) return [];
+        delivered.push(content.text.trim());
+        return [];
+      });
+      if (!delivered.length)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Native local turn produced no landed reply",
+        );
+      const landed = await host.adapter.getMemories({
+        tableName: "messages",
+        agentId: host.runtime.agentId,
+        roomId: identity.roomId,
+        authorEntityIds: [host.runtime.agentId],
+        metadata: { networkSourceMessageId: messageId },
+      });
+      if (landed.length !== 1 || !landed[0].content.text)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "One canonical native reply commit required",
+        );
+      if (receipts.length && ["upsert_fact", "ask_network"].includes(String(plan.command?.type))) {
+        const current = await host.domain.getMember(actor, memberId);
+        const city = current.homeCities[0];
+        const category =
+          current.participation === "receiving"
+            ? "support"
+            : (current.intents.find((intent) => intent.status === "active")?.category ??
+              current.preferences.categories[0] ??
+              "support");
+        const settings = await host.domain.getSettings({ type: "system" });
+        const missingContext =
+          !current.preferences.formats.length ||
+          !current.facts.some(
+            (fact) =>
+              ["stated_availability", "freebusy_fixture"].includes(fact.kind) &&
+              publicFact(fact, host.domain.options.clock.now().toISOString()),
+          );
+        if (
+          current.accountState === "active" &&
+          !current.safetyHold &&
+          current.participation !== "paused" &&
+          current.preferences.proactiveOptIn &&
+          !current.preferences.onlyWhenAsked &&
+          city &&
+          settings.proactiveCities[city] &&
+          missingContext &&
+          (!current.preferences.categories.length ||
+            current.preferences.categories.includes(category))
+        ) {
+          try {
+            await host.outreach.propose(actor, {
+              requestId: `native-profile:${messageId}`,
+              memberId,
+              purpose: "profiling",
+              category,
+              city,
+              body: "Would a public plan during a usual free window be comfortable? You can skip this question.",
+              expiresAt: new Date(
+                host.domain.options.clock.now().getTime() + 72 * 3600000,
+              ).toISOString(),
+              timeliness: { kind: "related_mention", sourceRef: messageId },
+            });
+          } catch (error) {
+            if (
+              !(error instanceof NetworkDomainError) ||
+              ![
+                "NETWORK_CONFLICT",
+                "NETWORK_INELIGIBLE",
+                "NETWORK_EXPIRED",
+                "NETWORK_SAFETY",
+              ].includes(error.code)
+            )
+              throw error;
+            await host.domain.command(
+              { type: "system" },
+              {
+                type: "record_event",
+                requestId: `native-profile-deferred:${messageId}`,
+                kind: "profiling_deferred",
+                memberIds: [memberId],
+                opportunityId: null,
+                details: { reason: error.code, sourceMessageId: messageId },
+              },
+            );
+          }
+        }
+      }
+      return { ...(await this.conversation(memberId)), reply: landed[0].content.text, receipts };
+    } finally {
+      await runtime.stop();
+    }
+  }
+}
