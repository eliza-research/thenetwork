--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/evaluation/native-replay.study.test.ts
@@ -0,0 +1,179 @@
+import { createHash } from "node:crypto";
+import { mkdir, readdir, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, it, vi } from "vitest";
+import { networkDigest } from "../digest.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { createNativeSimulationTransport } from "../workbench/simulation-ingress.ts";
+import { SimClock } from "./fixtures.ts";
+import { type NetworkSimulationReport, runNetworkSimulation } from "./simulator.ts";
+
+const study = process.env.NETWORK_NATIVE_REPLAY_STUDY === "1" ? it : it.skip;
+study(
+  "replays identical native data across two isolated namespaces without changing persona or matching outcomes",
+  async () => {
+    const label = process.env.NETWORK_NATIVE_REPLAY_LABEL ?? "replay-final";
+    if (!/^[a-z0-9-]{1,80}$/.test(label)) throw new Error("Safe label required");
+    const directory = join(process.cwd(), "test-results/network-native-study", label);
+    await mkdir(directory);
+    vi.stubEnv("ELIZA_STATE_DIR", join(directory, "state"));
+    const paths: string[] = [];
+    const collect = async (dir: string) => {
+      for (const item of await readdir(dir, { withFileTypes: true })) {
+        const path = join(dir, item.name);
+        if (item.isDirectory()) await collect(path);
+        else if (path.endsWith(".ts") && !path.endsWith(".test.ts")) paths.push(path);
+      }
+    };
+    await collect("packages/cloud/shared/src/lib/network");
+    paths.push(
+      "plugins/plugin-scheduling/src/scheduled-task/runner.ts",
+      "plugins/plugin-scheduling/src/scheduled-task/store.ts",
+      "plugins/plugin-assistant/src/services/approval/store.ts",
+      "plugins/plugin-network/src/index.ts",
+      "plugins/plugin-sql/src/base.ts",
+    );
+    const hashes = async () =>
+        Object.fromEntries(
+          await Promise.all(
+            paths.sort().map(async (path) => [
+              path,
+              createHash("sha256")
+                .update(await readFile(path))
+                .digest("hex"),
+            ]),
+          ),
+        ),
+      before = await hashes(),
+      started = performance.now();
+    const semantic = (report: NetworkSimulationReport, networkId: string) => {
+      const prefix = `network:${networkDigest(networkId)}:`;
+      return {
+        counts: report.counts,
+        observations: report.observations,
+        qualification: report.qualification,
+        matchingRuns: report.matchingRuns.map((run) => {
+          const { runId: _execution, ...snapshot } = run.replayInput;
+          return {
+            snapshot,
+            config: run.config,
+            stageEvidence: run.stageEvidence,
+            proposals: run.proposals.map(({ runId: _run, ...proposal }) => proposal),
+            rejected: run.rejected,
+            emptyStates: run.emptyStates,
+            fairness: run.fairness,
+          };
+        }),
+        effects: report.outbound.map((message) => {
+          if (!message.idempotencyKey.startsWith(prefix))
+            throw new Error("Effect is outside its actual namespace");
+          return { ...message, idempotencyKey: message.idempotencyKey.slice(prefix.length) };
+        }),
+      };
+    };
+    const results: Array<{
+      namespace: string;
+      report: NetworkSimulationReport;
+      semantic: ReturnType<typeof semantic>;
+    }> = [];
+    try {
+      for (const suffix of ["a", "b"]) {
+        const namespace = `simulation:native-replay:${label}:${suffix}`,
+          clock = new SimClock(Date.parse("2026-10-06T16:00:00Z")),
+          host = await createLocalNetworkHost({
+            dataDir: "memory://",
+            networkId: namespace,
+            clock,
+          });
+        try {
+          const report = await runNetworkSimulation({
+            domain: host.domain,
+            coordination: host.coordination,
+            clock,
+            transport: createNativeSimulationTransport(host, clock),
+            seed: 20261006,
+            personaCount: 100,
+            days: 1,
+            drainDue: host.drainDue,
+            graphEdges: (ids) => host.native.graphEdges(host.db.execute, ids),
+          });
+          results.push({ namespace, report, semantic: semantic(report, namespace) });
+          await writeFile(
+            join(directory, `${suffix}.json`),
+            JSON.stringify(
+              {
+                namespace,
+                rawRunDigest: report.runDigest,
+                semanticDigest: networkDigest(results.at(-1)?.semantic),
+                counts: report.counts,
+                qualification: report.qualification,
+                effects: report.outbound,
+                matchingRuns: report.matchingRuns.map((run) => ({
+                  runId: run.runId,
+                  inputDigest: run.inputDigest,
+                  city: run.replayInput.city,
+                  selected: run.proposals.length,
+                })),
+              },
+              null,
+              2,
+            ) + "\n",
+          );
+        } finally {
+          await host.close();
+        }
+      }
+      const first = results[0],
+        second = results[1];
+      if (!first || !second) throw new Error("Both isolated worlds required");
+      const after = await hashes(),
+        changed = paths.filter((path) => before[path] !== after[path]);
+      await writeFile(
+        join(directory, "SUMMARY.json"),
+        JSON.stringify(
+          {
+            elapsedMs: performance.now() - started,
+            node: process.version,
+            memoryOnly: true,
+            worlds: results.map((result) => ({
+              namespace: result.namespace,
+              rawRunDigest: result.report.runDigest,
+              semanticDigest: networkDigest(result.semantic),
+              counts: result.report.counts,
+            })),
+            sourceBefore: before,
+            sourceAfter: after,
+            changedSourcePaths: changed,
+            normalization:
+              "Only execution runId and independently scoped network idempotency prefix are normalized. Full effects including actual body/member/channel/acceptedAt/causal sequence retained; raw effects/digests preserved per world.",
+            qualification: first.report.qualification,
+          },
+          null,
+          2,
+        ) + "\n",
+      );
+      expect(changed).toEqual([]);
+      expect(second.semantic).toEqual(first.semantic);
+      expect(first.report.qualification.nativeTurnCount).toBeGreaterThan(0);
+      expect(first.report.counts.canaryLeaks).toBe(0);
+      expect(first.report.counts.invariantViolations).toBe(0);
+    } catch (error) {
+      await writeFile(
+        join(directory, "FAILURE.json"),
+        JSON.stringify(
+          {
+            message: error instanceof Error ? error.message : String(error),
+            stack: error instanceof Error ? error.stack : undefined,
+            completedWorlds: results.length,
+          },
+          null,
+          2,
+        ) + "\n",
+      );
+      throw error;
+    } finally {
+      vi.unstubAllEnvs();
+    }
+  },
+  300000,
+);
