+++ b/packages/cloud/shared/src/lib/network/workbench/health-alerts.integration.test.ts
@@ -0,0 +1,203 @@
+import { randomUUID } from "node:crypto";
+import { stringToUuid } from "@elizaos/core";
+import { createSchedulingSqlScheduledTaskStore } from "@elizaos/plugin-scheduling";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { SimClock } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import type { NetworkMatchingJobs } from "./matching-jobs.ts";
+import { composeOperationsView } from "./operations-views.ts";
+
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let jobs: NetworkMatchingJobs;
+let clock: SimClock;
+let store: ReturnType<typeof createSchedulingSqlScheduledTaskStore>;
+beforeEach(async () => {
+  clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: `test:health-alerts:${randomUUID()}`,
+    clock,
+  });
+  store = createSchedulingSqlScheduledTaskStore({
+    agentId: host.runtime.agentId,
+    executeSql: host.db.execute,
+    now: clock.now.bind(clock),
+  });
+  jobs = host.matchingJobs;
+  vi.spyOn(host.domain, "adminView").mockRejectedValue(
+    new Error("Health must not materialize the full admin corpus"),
+  );
+}, 120000);
+afterEach(async () => {
+  await host?.close();
+});
+
+it("does not invent a missing heartbeat before first due or a healthy zero without checker evidence", async () => {
+  const before = await host.runner.list();
+  const health = await jobs.health();
+  expect(health.alerts).toEqual([]);
+  expect(health.recordedInvariants.count).toBeNull();
+  expect(health.recordedInvariants.observations).toEqual([]);
+  expect(health.observationPolicy.graceMs).toBe(300000);
+  expect(await host.runner.list()).toEqual(before);
+});
+
+it("respects the native matching gate and alerts only after debounce plus the declared observation grace", async () => {
+  const task = (await host.runner.list()).find((task) => {
+    const binding = task.metadata?.network as { city?: string; cadence?: string };
+    return binding.city === "SF" && binding.cadence === "events";
+  });
+  if (!task) throw new Error("Actual owned matching task missing");
+  const start = clock.now().getTime();
+  await store.upsert(
+    {
+      ...task,
+      metadata: {
+        ...task.metadata,
+        network: {
+          ...(task.metadata?.network as object),
+          token: "current-change",
+          pendingAt: clock.now().toISOString(),
+        },
+      },
+    },
+    { nextFireAtIso: new Date(start + 180000).toISOString() },
+  );
+  clock.advanceTo(start + 180000 + 300000 - 1);
+  expect((await jobs.health()).alerts).toEqual([]);
+  clock.advanceTo(start + 180000 + 300000 + 1);
+  const health = await jobs.health();
+  expect(health.alerts).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({
+        kind: "overdue_matching_job",
+        taskId: task.taskId,
+        expectedAt: new Date(start + 180000).toISOString(),
+        graceMs: 300000,
+      }),
+      expect.objectContaining({ kind: "missing_matching_heartbeat", taskId: task.taskId }),
+    ]),
+  );
+  expect(health.alerts.some((alert) => alert.cadence === "events" && alert.city === "NYC")).toBe(
+    false,
+  );
+});
+
+it("distinguishes a canonical unsettled claim from an actual settled outcome and records heartbeat evidence separately", async () => {
+  const task = (await host.runner.list()).find((task) => {
+    const binding = task.metadata?.network as { city?: string; cadence?: string };
+    return binding.city === "SF" && binding.cadence === "nightly";
+  });
+  if (!task) throw new Error("Actual owned nightly task missing");
+  const claimed = {
+    ...task,
+    state: { ...task.state, status: "fired" as const, firedAt: clock.now().toISOString() },
+  };
+  await store.upsert(claimed, { nextFireAtIso: null });
+  const foreignAgentId = stringToUuid("foreign-health-agent");
+  await host.adapter.createAgents([
+    { id: foreignAgentId, name: "Foreign owned test fixture", bio: [] },
+  ]);
+  const foreignStore = createSchedulingSqlScheduledTaskStore({
+    agentId: foreignAgentId,
+    executeSql: host.db.execute,
+    now: clock.now.bind(clock),
+  });
+  await foreignStore.upsert(
+    {
+      ...claimed,
+      metadata: {
+        network: { scope: "matching", networkId: "test:foreign", city: "SF", cadence: "nightly" },
+      },
+    },
+    { nextFireAtIso: null },
+  );
+  clock.advanceTo(clock.now().getTime() + 300001);
+  expect((await jobs.health()).alerts).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({ kind: "stuck_matching_claim", taskId: task.taskId }),
+    ]),
+  );
+  await store.upsert(
+    {
+      ...claimed,
+      metadata: {
+        ...claimed.metadata,
+        lastDispatchResult: { ok: true, metadata: { internalComputation: true } },
+      },
+    },
+    { nextFireAtIso: null },
+  );
+  let health = await jobs.health();
+  expect(
+    health.alerts.some(
+      (alert) => alert.kind === "stuck_matching_claim" && alert.taskId === task.taskId,
+    ),
+  ).toBe(false);
+  expect(await foreignStore.get(task.taskId)).toMatchObject({ state: { status: "fired" } });
+  expect(
+    health.alerts.some(
+      (alert) => alert.kind === "missing_matching_heartbeat" && alert.taskId === task.taskId,
+    ),
+  ).toBe(true);
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "record_event",
+      requestId: "actual-heartbeat",
+      kind: "matching_heartbeat",
+      memberIds: [],
+      opportunityId: null,
+      details: { city: "SF", cadence: "nightly", runId: "fixture-run" },
+    },
+  );
+  health = await jobs.health();
+  expect(health.alerts.some((alert) => alert.taskId === task.taskId)).toBe(false);
+});
+
+it("projects recorded historical checker failures through the health view without claiming live invariant monitoring", async () => {
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "record_event",
+      requestId: "recorded-checker",
+      kind: "simulation_completed",
+      memberIds: [],
+      opportunityId: null,
+      details: { runId: "retained-fixture", report: { counts: { invariantViolations: 2 } } },
+    },
+  );
+  const health = await jobs.health();
+  expect(health.recordedInvariants.count).toBe(2);
+  expect(health.alerts).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({
+        kind: "historical_simulation_invariant_failures",
+        count: 2,
+        eventId: "recorded-checker",
+      }),
+    ]),
+  );
+  const view = {
+    module: "health",
+    title: "Health",
+    summary: "",
+    metrics: [],
+    rows: [],
+    actions: [],
+    emptyMessage: "",
+  };
+  await composeOperationsView(
+    host,
+    { type: "staff", userId: "health-observer", roles: ["analyst"] },
+    new URLSearchParams(),
+    view,
+  );
+  expect(view.metrics).toContainEqual({
+    label: "Historical simulation invariant failures",
+    value: 2,
+  });
+  expect(view.rows).toEqual(
+    expect.arrayContaining([expect.objectContaining({ id: "recorded-invariant-evidence" })]),
+  );
+});
diff --git a/packages/cloud/shared/src/lib/network/workbench/host.lifecycle.test.ts b/packages/cloud/shared/src/lib/network/workbench/host.lifecycle.test.ts
new file mode 100644
index 000000000000..d7dd343b14be
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/host.lifecycle.test.ts
@@ -0,0 +1,108 @@
+import { randomUUID } from "node:crypto";
+import { setImmediate } from "node:timers/promises";
+import { expect, it, vi } from "vitest";
+import { SimClock } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "./host.ts";
+
+it("keeps a long lab attempt tracked without starving due work and preserves ordinary operation ordering", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00.000Z"));
+  const networkId = `test:host-lifecycle:${randomUUID()}`;
+  let releaseLab!: () => void;
+  const labGate = new Promise<void>((resolve) => {
+    releaseLab = resolve;
+  });
+  let releaseExport!: () => void;
+  const exportGate = new Promise<void>((resolve) => {
+    releaseExport = resolve;
+  });
+  const calls: string[] = [];
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId,
+    clock,
+    async dispatchOperations(record) {
+      const binding = record.metadata?.network as { scope: string; phase?: string };
+      const phase = binding.phase ?? binding.scope;
+      calls.push(phase);
+      if (binding.scope === "simulation_lab") await labGate;
+      if (phase === "slow-export") await exportGate;
+      return { ok: true, metadata: { phase } };
+    },
+  });
+  let drain: Promise<number> | undefined;
+  let closing: Promise<void> | undefined;
+  try {
+    for (const scope of ["simulation_lab", "data_export"]) {
+      clock.advanceTo(clock.now().getTime() + 1);
+      await host.runner.schedule({
+        kind: "custom",
+        trigger: { kind: "once", atIso: clock.now().toISOString() },
+        priority: "low",
+        source: "plugin",
+        createdBy: "network",
+        ownerVisible: false,
+        respectsGlobalPause: false,
+        promptInstructions: "Exercise the native local operation lifecycle.",
+        output: { destination: "channel", target: "network-local-test" },
+        idempotencyKey: `${networkId}:${scope}`,
+        metadata: { network: { scope, networkId } },
+      });
+    }
+    let firstDrained = false;
+    drain = host.drainDue();
+    const first = drain.then(() => {
+      firstDrained = true;
+    });
+    await vi.waitFor(() => expect(calls).toEqual(["simulation_lab", "data_export"]), {
+      timeout: 5000,
+    });
+    await vi.waitFor(() => expect(firstDrained).toBe(true), { timeout: 5000 });
+    await first;
+    await host.drainDue();
+    expect(calls.filter((phase) => phase === "simulation_lab")).toHaveLength(1);
+
+    for (const phase of ["slow-export", "after-slow-export"]) {
+      clock.advanceTo(clock.now().getTime() + 1);
+      await host.runner.schedule({
+        kind: "custom",
+        trigger: { kind: "once", atIso: clock.now().toISOString() },
+        priority: "low",
+        source: "plugin",
+        createdBy: "network",
+        ownerVisible: false,
+        respectsGlobalPause: false,
+        promptInstructions: "Exercise ordered ordinary operations.",
+        output: { destination: "channel", target: "network-local-test" },
+        idempotencyKey: `${networkId}:${phase}`,
+        metadata: { network: { scope: "data_export", networkId, phase } },
+      });
+    }
+    let orderedDrained = false;
+    drain = host.drainDue();
+    const ordered = drain.then(() => {
+      orderedDrained = true;
+    });
+    await vi.waitFor(() => expect(calls).toContain("slow-export"), { timeout: 5000 });
+    expect(calls).not.toContain("after-slow-export");
+    expect(orderedDrained).toBe(false);
+    releaseExport();
+    await ordered;
+    expect(calls.slice(-2)).toEqual(["slow-export", "after-slow-export"]);
+
+    let closed = false;
+    closing = host.close().then(() => {
+      closed = true;
+    });
+    await setImmediate();
+    expect(closed).toBe(false);
+    await expect(host.drainDue()).resolves.toBe(0);
+    releaseLab();
+    await closing;
+    expect(closed).toBe(true);
+  } finally {
+    releaseLab();
+    releaseExport();
+    await drain;
+    await (closing ?? host.close());
+  }
+}, 120000);
