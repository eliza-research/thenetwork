+import { DEFAULT_PERSONA_MIX, NetworkSimulationLab } from "./simulation-lab.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T16:00:00.000Z"));
+const engineer: NetworkActor = { type: "staff", userId: "fixture-engineer", roles: ["engineer"] };
+const analyst: NetworkActor = { type: "staff", userId: "fixture-analyst", roles: ["analyst"] };
+let directory: string;
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let lab: NetworkSimulationLab;
+let runner: Awaited<ReturnType<typeof createLocalNetworkHost>>["runner"];
+const startedFires: Promise<unknown>[] = [];
+const config = {
+  personaCount: 20,
+  days: 1,
+  seed: "lab-regression",
+  timeMode: "discrete_event" as const,
+  personaMix: DEFAULT_PERSONA_MIX,
+  engineVersion: DEFAULT_MATCHING_CONFIG.version,
+};
+function compose() {
+  runner = host.runner;
+  lab = new NetworkSimulationLab({
+    domain: host.domain,
+    scheduler: runner,
+    clock,
+    wallClock: systemClock,
+    createWorld: ({ runId, attempt, networkId, clock: worldClock }) =>
+      createLocalNetworkHost({
+        dataDir: join(directory, runId, `attempt-${attempt}`),
+        networkId,
+        clock: worldClock,
+      }),
+    transport: createNativeSimulationTransport,
+  });
+}
+beforeAll(async () => {
+  directory = await mkdtemp(join(tmpdir(), "network-lab-test-"));
+  host = await createLocalNetworkHost({
+    dataDir: join(directory, "parent"),
+    networkId: `test:lab:${randomUUID()}`,
+    clock,
+    dispatchOperations: (record) => lab.dispatch(record),
+  });
+  const { revision, ...settings } = await host.domain.getSettings({ type: "system" });
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "configure",
+      requestId: "retained-engine-settings",
+      expectedRevision: revision,
+      settings: { ...settings, matchingThreshold: 0.61 },
+    },
+  );
+  compose();
+}, 120000);
+afterEach(async () => {
+  try {
+    await lab?.shutdown();
+  } finally {
+    await Promise.allSettled(startedFires);
+    startedFires.length = 0;
+    compose();
+  }
+});
+afterAll(async () => {
+  await lab?.shutdown();
+  await host?.close();
+  if (directory) await rm(directory, { recursive: true, force: true });
+});
+
+it("returns a stable queued native job and rejects changed retained input", async () => {
+  await expect(lab.enqueue(analyst, { requestId: "forbidden", ...config })).rejects.toMatchObject({
+    code: "NETWORK_FORBIDDEN",
+  });
+  const run = await lab.enqueue(engineer, { requestId: "first", ...config });
+  expect(run.status).toBe("queued");
+  expect(run.progress).toBeNull();
+  expect(
+    (await runner.list()).find(
+      (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === run.runId,
+    )?.kind,
+  ).toBe("custom");
+  expect((await lab.enqueue(engineer, { requestId: "first", ...config })).runId).toBe(run.runId);
+  expect(
+    (await runner.list()).filter(
+      (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === run.runId,
+    ),
+  ).toHaveLength(1);
+  await expect(
+    lab.enqueue(engineer, { requestId: "first", ...config, days: 3 }),
+  ).rejects.toMatchObject({ code: "NETWORK_IDEMPOTENCY" });
+});
+
+it("runs the existing native world runner and retains progress, reports and real member perspective across restart", async () => {
+  const queued = await lab.enqueue(engineer, { requestId: "first", ...config });
+  expect(queued.engineSettings?.matchingThreshold).toBe(0.61);
+  const { revision, ...settings } = await host.domain.getSettings({ type: "system" });
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "configure",
+      requestId: "changed-parent-settings",
+      expectedRevision: revision,
+      settings: { ...settings, matchingThreshold: 0.9 },
+    },
+  );
+  const task = (await runner.list()).find(
+    (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === queued.runId,
+  );
+  if (!task) throw new Error("Native lab task missing");
+  const firing = runner.fireWithResult(task.taskId);
+  startedFires.push(firing);
+  const fired = await firing;
+  if (fired.kind === "dispatch_failed") throw fired.error;
+  expect(fired.kind).toBe("fired");
+  const completed = await lab.read(engineer, queued.runId);
+  expect(completed.status).toBe("completed");
+  expect(completed.progress).toMatchObject({ day: 1, totalDays: 1 });
+  expect(completed.report).toMatchObject({ personaCount: 20, days: 1 });
+  const retainedWorld = await createLocalNetworkHost({
+    dataDir: join(directory, queued.runId, "attempt-1"),
+    networkId: String(completed.networkId),
+    clock: new SimClock(Date.parse("2026-10-07T16:00:00.000Z")),
+  });
+  try {
+    expect((await retainedWorld.domain.getSettings({ type: "system" })).matchingThreshold).toBe(
+      0.61,
+    );
+  } finally {
+    await retainedWorld.close();
+  }
+  const networkId = host.domain.options.networkId;
+  await host.close();
+  host = await createLocalNetworkHost({
+    dataDir: join(directory, "parent"),
+    networkId,
+    clock,
+    dispatchOperations: (record) => lab.dispatch(record),
+  });
+  compose();
+  expect((await lab.read(engineer, queued.runId)).report).toEqual(completed.report);
+  const perspective = await lab.inspectMember(
+    engineer,
+    queued.runId,
+    "00000000-0000-4000-8000-000000000001",
+  );
+  expect(perspective.environment).toBe("retained_simulation");
+  expect(perspective.perspective.module).toBe("perspective");
+  expect(JSON.stringify(perspective)).not.toContain("CANARY_PRIVATE_");
+  await expect(
+    lab.inspectMember(analyst, queued.runId, "00000000-0000-4000-8000-000000000001"),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  await expect(
+    lab.enqueue(engineer, {
+      requestId: "unknown-version",
+      ...config,
+      engineVersion: "invented-engine",
+    }),
+  ).rejects.toMatchObject({ code: "NETWORK_INVALID" });
+  await expect(
+    lab.enqueue(engineer, {
+      requestId: "empty-mix",
+      ...config,
+      personaMix: Object.fromEntries(
+        Object.keys(DEFAULT_PERSONA_MIX).map((kind) => [kind, 0]),
+      ) as typeof DEFAULT_PERSONA_MIX,
+    }),
+  ).rejects.toMatchObject({ code: "NETWORK_INVALID" });
+  const second = await lab.enqueue(engineer, { requestId: "second", ...config });
+  const secondTask = (await runner.list()).find(
+    (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === second.runId,
+  );
+  if (!secondTask) throw new Error("Second native lab task missing");
+  const secondFiring = runner.fireWithResult(secondTask.taskId);
+  startedFires.push(secondFiring);
+  const secondFired = await secondFiring;
+  if (secondFired.kind === "dispatch_failed") throw secondFired.error;
+  expect(secondFired.kind).toBe("fired");
+  const compared = await lab.compare(engineer, queued.runId, second.runId);
+  expect(compared.sameData).toBe(true);
+  expect(compared.first.engineSettingsDigest).not.toBe(compared.second.engineSettingsDigest);
+  expect(compared.second.engineSettings?.matchingThreshold).toBe(0.9);
+  expect(compared.qualification).toContain("synthetic_assumptions");
+}, 120000);
+
+it("cancels paced attempts and recovers interrupted work by an explicit fresh replay namespace", async () => {
+  const original = await lab.enqueue(engineer, {
+    requestId: "interrupted",
+    ...config,
+    timeMode: "real_time",
+    personaCount: 20,
+    days: 1,
+  });
+  const task = (await runner.list()).find(
+    (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === original.runId,
+  );
+  if (!task) throw new Error("Paced native lab task missing");
+  const pending = runner.fire(task.taskId);
+  startedFires.push(pending);
+  let replaying: ReturnType<typeof runner.fire> | undefined;
+  try {
+    await expect
+      .poll(async () => (await lab.read(engineer, original.runId)).status, { timeout: 30000 })
+      .toBe("running");
+    await expect
+      .poll(
+        async () => {
+          try {
+            await lab.inspectMember(
+              engineer,
+              original.runId,
+              "00000000-0000-4000-8000-000000000020",
+            );
+            return true;
+          } catch (error) {
+            if (
+              error &&
+              typeof error === "object" &&
+              "code" in error &&
+              ["NETWORK_NOT_FOUND", "NETWORK_CONFLICT"].includes(String(error.code))
+            )
+              return false;
+            throw error;
+          }
+        },
+        { timeout: 30000 },
+      )
+      .toBe(true);
+    await new Promise((resolve) => setTimeout(resolve, 500));
+    expect((await lab.read(engineer, original.runId)).progress).toBeNull();
+    expect((await lab.read(engineer, original.runId)).report).toBeNull();
+    await lab.shutdown();
+    await pending;
+    expect((await lab.read(engineer, original.runId)).report).toBeNull();
+    compose();
+    expect(await lab.recover()).toBe(1);
+    const restarted = await lab.read(engineer, original.runId);
+    expect(restarted.status).toBe("restarting_from_seed");
+    expect(restarted.attempts).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          kind: "simulation_restarting_from_seed",
+          previousAttempt: 1,
+          attempt: 2,
+        }),
+      ]),
+    );
+    const nextTask = (await runner.list()).find(
+      (task) =>
+        (task.metadata?.network as { runId?: string; attempt?: number } | undefined)?.runId ===
+          original.runId &&
+        (task.metadata?.network as { attempt?: number } | undefined)?.attempt === 2,
+    );
+    if (!nextTask) throw new Error("Replay native task missing");
+    replaying = runner.fire(nextTask.taskId);
+    startedFires.push(replaying);
+    await expect
+      .poll(async () => (await lab.read(engineer, original.runId)).attempt, { timeout: 30000 })
+      .toBe(2);
+    const replay = await lab.read(engineer, original.runId);
+    expect(replay.networkId).not.toBe(restarted.networkId);
+    await lab.cancel(engineer, original.runId, "cancel-replay");
+    await replaying;
+    expect((await lab.read(engineer, original.runId)).status).toBe("cancelled");
+    expect(await lab.recover()).toBe(0);
+  } finally {
+    try {
+      await lab.shutdown();
+    } finally {
+      await Promise.allSettled([pending, ...(replaying ? [replaying] : [])]);
+      compose();
+    }
+  }
+}, 120000);
+
+it("uses the injected wall Clock to advance one accelerated simulated day in one minute", async () => {
+  let wallInstant = 0;
+  lab.options.wallClock = {
+    now: () => wallInstant,
+    sleep: async (ms) => {
+      wallInstant += ms;
+    },
+  };
+  const run = await lab.enqueue(engineer, {
+    requestId: "accelerated",
+    ...config,
+    timeMode: "accelerated",
+  });
+  const task = (await runner.list()).find(
+    (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === run.runId,
+  );
+  if (!task) throw new Error("Accelerated native lab task missing");
+  const firing = runner.fireWithResult(task.taskId);
+  startedFires.push(firing);
+  const fired = await firing;
+  if (fired.kind === "dispatch_failed") throw fired.error;
+  expect(fired.kind).toBe("fired");
+  expect(wallInstant).toBe(60000);
+  const completed = await lab.read(engineer, run.runId);
+  expect(completed.status).toBe("completed");
+  expect(completed.progress).toMatchObject({ day: 1, totalDays: 1 });
+  expect(completed.report).toMatchObject({
+    qualification: { realAgentTurns: "unrun", nativeTurnCount: 0 },
+  });
+});
+
+it("denies a dispatch that finishes its retained lookup after terminal shutdown", async () => {
+  const run = await lab.enqueue(engineer, {
+    requestId: "shutdown-admission",
+    ...config,
+    timeMode: "real_time",
+    days: 365,
+  });
+  const task = (await runner.list()).find(
+    (task) => (task.metadata?.network as { runId?: string } | undefined)?.runId === run.runId,
+  );
+  if (!task) throw new Error("Shutdown race task missing");
+  let lookupStarted = false;
+  let release!: () => void;
+  const lookupRelease = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  const execute = host.db.execute.bind(host.db);
+  const lookup = vi.spyOn(host.db, "execute").mockImplementation(async (sql) => {
+    if (sql.includes("LIKE 'simulation_%'") && sql.includes(run.runId)) {
+      lookupStarted = true;
+      await lookupRelease;
+    }
+    return execute(sql);
+  });
+  const creator = vi.spyOn(lab.options, "createWorld");
+  const pending = runner.fireWithResult(task.taskId);
+  startedFires.push(pending);
+  try {
+    await expect.poll(() => lookupStarted, { timeout: 30000 }).toBe(true);
+    await lab.shutdown();
+    release();
+    const result = await pending;
+    expect(result.kind).toBe("dispatch_failed");
+    if (result.kind === "dispatch_failed")
+      expect(result.error).toMatchObject({ code: "NETWORK_CONFLICT" });
+    expect(creator).not.toHaveBeenCalled();
+    await expect(lab.enqueue(engineer, { requestId: "late", ...config })).rejects.toMatchObject({
+      code: "NETWORK_CONFLICT",
+    });
+  } finally {
+    release();
+    await pending;
+    lookup.mockRestore();
+    creator.mockRestore();
+  }
+});
