+          city: "SF",
+          participantIds: [a.memberId, b.memberId],
+          backupIds: [],
+          quorum: 2,
+          expiresAt: "2026-10-07T16:00:00.000Z",
+          explanations: Object.fromEntries(
+            [a.memberId, b.memberId].map((id) => [id, { text: "A public coffee", factIds: [] }]),
+          ),
+          safetyClass: "low",
+          requiresHomeEntry: false,
+          acquaintedHelperIds: [],
+          anchorEventId: null,
+        },
+      },
+    );
+    if (!("revision" in proposal)) throw new Error("Canonical opportunity missing");
+    await host.domain.command(reviewer, {
+      type: "start_review",
+      requestId: "start",
+      opportunityId: "actual-plan",
+      expectedRevision: proposal.revision,
+      priority: "standard",
+    });
+    clock.advanceTo(clock.now().getTime() + 5000);
+    await host.domain.command(reviewer, {
+      type: "review_opportunity",
+      requestId: "primary",
+      opportunityId: "actual-plan",
+      expectedRevision: proposal.revision,
+      decision: "approved",
+      reasonCode: "approved",
+      note: "PRIVATE_REVIEW_BODY",
+    });
+    await host.domain.blindReviewView(independent, "actual-plan", proposal.revision);
+    await host.domain.command(independent, {
+      type: "record_blind_review",
+      requestId: "blind",
+      opportunityId: "actual-plan",
+      expectedRevision: proposal.revision,
+      decision: "approved",
+      reasonCode: "approved",
+      note: "PRIVATE_BLIND_BODY",
+      rubric: {
+        tone: "pass",
+        clarity: "pass",
+        explanation: "pass",
+        timing: "pass",
+        privacy: "pass",
+      },
+      durationMs: 1000,
+    });
+    for (const caseId of ["actual-case-1", "actual-case-2"])
+      await host.domain.command(
+        { type: "member", memberId: a.memberId },
