+import { expect, it } from "vitest";
+import { buildMatchingRun, DEFAULT_MATCHING_CONFIG } from "./engine.ts";
+import { testInput } from "./test-fixtures.ts";
+import type { JudgeCache, MatchJudgment } from "./types.ts";
+
+it("retains actual stage counts and leaves unrun judgments empty", async () => {
+  const input = testInput(6),
+    run = await buildMatchingRun(input, {
+      config: { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5, maxProposals: 1 },
+    });
+  const stages = run.stageEvidence;
+  if (!stages) throw new Error("Missing owning stage evidence");
+  expect(stages.generation.generated).toBe(
+    stages.generation.filtered + stages.generation.duplicate + run.candidateCount,
+  );
+  expect(stages.generation.scored).toBeGreaterThanOrEqual(run.candidateCount);
+  expect(stages.ranked).toBe(
+    run.candidateCount - stages.explorationFiltered - stages.deduplicationRemoved,
+  );
+  expect(stages.selectionConsidered).toBe(stages.selectionRejected + stages.selected + 1);
+  expect(stages.selected).toBe(run.proposals.length);
+  expect(stages.unvisitedAfterSelectionCap).toBe(stages.ranked - stages.selectionConsidered);
+  expect(run.judgments).toEqual([]);
+  expect(stages.judged).toBe(0);
+  expect(run.qualification.judge).toBe("unrun");
+});
+
+it("records only authorized validated provider/cache judgments and never caches unauthorized dealbreakers", async () => {
+  const input = testInput(2),
+    entries = new Map<string, { judgment: MatchJudgment; expiresAt: number }>();
+  const cache: JudgeCache = {
+    get: async (key) => entries.get(key) ?? null,
+    put: async (key, entry) => {
+      entries.set(key, entry);
+    },
+  };
+  const judgment: MatchJudgment = {
+    fit: 1,
+    mutualBenefit: 1,
+    timingFit: 1,
+    socialComfort: 1,
+    confidence: 1,
+    dealbreaker: false,
+    evidenceIds: [],
+  };
+  const judge = { version: "authored-judge-fixture", judge: async () => judgment };
+  const first = await buildMatchingRun(input, { judge, cache }),
+    replay = await buildMatchingRun(input, { judge, cache });
+  expect(first.judgments?.length).toBe(first.judgeCalls);
+  expect(first.judgments?.every((record) => record.source === "provider")).toBe(true);
+  expect(replay.judgments?.length).toBe(replay.judgeCacheHits);
+  expect(replay.judgments?.every((record) => record.source === "cache")).toBe(true);
+  expect(replay.judgments?.map((record) => record.cacheKey)).toEqual(
+    first.judgments?.map((record) => record.cacheKey),
+  );
+  entries.clear();
+  await expect(
+    buildMatchingRun(input, {
+      cache,
+      judge: {
+        version: "bad",
+        judge: async () => ({
+          ...judgment,
+          dealbreaker: true,
+          evidenceIds: ["private-unowned-evidence"],
+        }),
+      },
+    }),
+  ).rejects.toThrow("unauthorized evidence");
+  expect(entries.size).toBe(0);
+  await expect(
+    buildMatchingRun(input, {
+      judge: {
+        version: "extra",
+        judge: async () => ({ ...judgment, privateRationale: "untrusted extra model prose" }),
+      },
+    }),
+  ).rejects.toThrow("structured matching judgment");
+});
