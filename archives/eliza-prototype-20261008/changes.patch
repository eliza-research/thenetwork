+  if (command.type === "delete_account") await operations?.data.invalidateDeleted();
+  if (
+    actor.type === "member" &&
+    ((command.type === "set_preferences" && command.preferences.onlyWhenAsked === false) ||
+      (command.type === "channel_keyword" && command.keyword === "START"))
+  )
+    await host.outreach.resume(actor);
+  if (command.type === "respond_opportunity" && command.accept) {
+    const opportunity = await domain.getOpportunity(SYSTEM, command.opportunityId);
+    if ("kind" in opportunity && opportunity.kind === "monthly_event")
+      await scheduleProgrammeParticipant(
+        domain,
+        host.runner,
+        {
+          opportunityId: command.opportunityId,
+          revision: command.expectedRevision,
+          memberId: command.memberId,
+        },
+        clock,
+      );
+  }
+  let processing: { processed: number; pending: boolean } | undefined;
+  if (
+    (command.type === "review_opportunity" && command.decision === "approved") ||
+    (command.type === "respond_opportunity" && command.accept)
+  )
+    processing = await transport.advanceInvitations(command.opportunityId);
+  return {
+    result,
+    processing,
+    message: processing?.pending
+      ? "Your change was recorded. Some invitation delivery work is pending."
+      : "Recorded.",
+  };
+}
