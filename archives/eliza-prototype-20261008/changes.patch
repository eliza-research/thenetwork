+import type { MatchingRun } from "./types.ts";
+
+export function emptyStateText(reason: MatchingRun["emptyStates"][number]["reason"]) {
+  const messages = {
+    local_density: [
+      "There may not yet be enough eligible local members for this request.",
+      "Would you like concierge help or to discuss an optional invitation to someone you know?",
+    ],
+    missing_information: [
+      "This request needs one more concrete detail before useful combinations can be assessed.",
+      "What specific activity or kind of help would feel useful?",
+    ],
+    constraints: [
+      "The current time, travel or format constraints did not produce a qualified combination.",
+      "Is there another time, public area or format you would consider?",
+    ],
+    no_qualified_configuration: [
+      "No combination cleared the current eligibility and quality requirements.",
+      "Would you like to refine this request or ask for concierge help?",
+    ],
+  } as const;
+  return { explanation: messages[reason][0], question: messages[reason][1] };
+}
