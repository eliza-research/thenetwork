+          ) : admin ? (
+            <>
+              <dl className="nw-metrics" aria-label="Current measurements">
+                {admin.metrics.map((metric) => (
+                  <div key={metric.label}>
+                    <dt>{metric.label}</dt>
+                    <dd>{metric.value}</dd>
+                    {metric.detail && <p>{metric.detail}</p>}
+                  </div>
+                ))}
+              </dl>
+              {admin.graph && <NetworkGraph graph={admin.graph} />}
+              {module === "pipeline" && admin.rows.length > 0 && (
+                <NetworkPipeline rows={admin.rows} onChoose={chooseAction} />
+              )}
+              <NetworkActionButtons
+                actions={admin.actions}
+                onChoose={chooseAction}
+              />
+              <RecordList
+                key={module}
+                keyboardNavigation={module === "review"}
+                rows={admin.rows}
+                emptyMessage={admin.emptyMessage}
+                onChoose={chooseAction}
+              />
+            </>
+          ) : null}
+        </main>
+        {action && (
+          <NetworkActionForm
+            key={commandId.current}
+            action={action}
+            busy={commandBusy}
+            error={actionError}
+            onSubmit={(values) => void applyAction(values)}
+            onClose={() => {
+              if (!commandBusy) {
+                setAction(null);
+                mainRef.current?.focus({ preventScroll: true });
+              }
+            }}
+          />
+        )}
+      </div>
+    </div>
+  );
+}
