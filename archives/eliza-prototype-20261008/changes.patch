+import { ElizaError, type UUID } from "@elizaos/core";
+import type { CarveOutSqlExecutor } from "./carve-out-migration.ts";
+import { sqlQuote } from "./raw-sql.ts";
+
+/** Trusted host deletion joins its already-owned transaction and preserves all other rooms. */
+export async function eraseSqlPrivateRoom(
+  execute: CarveOutSqlExecutor,
+  input: { agentId: UUID; roomId: UUID; memberEntityId: UUID }
+): Promise<void> {
+  const rooms = await execute(
+    `SELECT agent_id FROM rooms WHERE id=${sqlQuote(input.roomId)} FOR UPDATE`
+  );
+  if (!rooms.length) return;
+  if (rooms[0].agent_id !== input.agentId)
+    throw new ElizaError("Private room belongs to another agent", {
+      code: "PRIVATE_ROOM_ERASURE_SCOPE",
+    });
+  const others = await execute(
+    `SELECT entity_id FROM participants WHERE room_id=${sqlQuote(input.roomId)} AND entity_id NOT IN (${sqlQuote(input.agentId)},${sqlQuote(input.memberEntityId)})`
+  );
+  if (others.length)
+    throw new ElizaError("Private room contains a foreign participant", {
+      code: "PRIVATE_ROOM_ERASURE_SCOPE",
+    });
+  await execute(
+    `DELETE FROM session_summaries WHERE agent_id=${sqlQuote(input.agentId)} AND room_id=${sqlQuote(input.roomId)}`
+  );
+  // Canonical FK ownership deletes this room's memories, embeddings, logs and participants.
+  await execute(
+    `DELETE FROM rooms WHERE id=${sqlQuote(input.roomId)} AND agent_id=${sqlQuote(input.agentId)}`
+  );
+}
diff --git a/plugins/plugin-sql/src/database-utils/scoped-message-evidence.ts b/plugins/plugin-sql/src/database-utils/scoped-message-evidence.ts
new file mode 100644
index 000000000000..ce9bd27c8569
--- /dev/null
+++ b/plugins/plugin-sql/src/database-utils/scoped-message-evidence.ts
@@ -0,0 +1,24 @@
+import type { UUID } from "@elizaos/core";
+import type { CarveOutSqlExecutor } from "./carve-out-migration.ts";
+import { sqlQuote } from "./raw-sql.ts";
+
+/** Exact authorized source evidence joins the caller's transaction without releasing message text. */
+export async function readSqlScopedMessageEvidence(
+  execute: CarveOutSqlExecutor,
+  input: { agentId: UUID; roomId: UUID; entityId: UUID; messageId: UUID }
+) {
+  const rows = await execute(
+    `SELECT EXTRACT(EPOCH FROM created_at)*1000 AS created_at_ms,content->>'source' AS source,metadata FROM memories WHERE id=${sqlQuote(input.messageId)} AND agent_id=${sqlQuote(input.agentId)} AND room_id=${sqlQuote(input.roomId)} AND entity_id=${sqlQuote(input.entityId)} AND type='messages'`
+  );
+  if (!rows[0]) return null;
+  const metadata =
+    typeof rows[0].metadata === "string" ? JSON.parse(rows[0].metadata) : rows[0].metadata;
+  return {
+    createdAt: Number(rows[0].created_at_ms),
+    source: String(rows[0].source),
+    metadata:
+      metadata && typeof metadata === "object" && !Array.isArray(metadata)
+        ? (metadata as Readonly<Record<string, unknown>>)
+        : null,
+  };
+}
