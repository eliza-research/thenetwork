index 000000000000..495402921e1e
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/agent/local-model.ts
@@ -0,0 +1,230 @@
+import { ModelType, type Plugin } from "@elizaos/core";
+import { networkDigest } from "../digest.ts";
+import { teenContentAllowed } from "../domain/policy.ts";
+import type { NetworkMember } from "../domain/types.ts";
+
+export const NETWORK_ONBOARDING_QUESTIONS = [
+  "I keep proposed facts private until you review them. What would you like more of?",
+  "What is one thing you enjoy doing?",
+  "What do you enjoy offering or helping with?",
+  "Which city and neighborhood are comfortable for you?",
+  "What does a normal week look like, and how far would you travel?",
+  "Do you prefer one-to-one plans or small groups? Any boundaries?",
+  "Would a nearby public activity with an easy no be worth a message?",
+  "Would a practical help offer or an introduction be worth a message? Review the private readback below, then use the explicit onboarding and sharing controls when ready.",
+] as const;
+
+/** Deliberately narrow local fixture grammar, not a natural-language quality claim. */
+export function planLocalNetworkTurn(
+  member: NetworkMember,
+  text: string,
+  exchange: number,
+  messageId: string,
+) {
+  const base = { memberId: member.memberId };
+  const clean = text.trim();
+  const solo = member.age !== "adult";
+  let command: Record<string, unknown> | undefined;
+  let reply = solo
+    ? "You can review your own profile, chat about interests and learning, or find public events and places. The Network does not connect members aged 13–17 to other people."
+    : member.accountState === "onboarding"
+      ? NETWORK_ONBOARDING_QUESTIONS[Math.min(exchange, NETWORK_ONBOARDING_QUESTIONS.length - 1)]
+      : "You can tell me an interest, ask for help, review what I know, or pause outreach. This local model follows a bounded scripted grammar.";
+  const readback = member.facts
+    .filter((fact) => fact.status !== "rejected")
+    .map((fact) => `${fact.kind}: ${fact.value} (${fact.status}, ${fact.scope})`);
+  if (solo && !teenContentAllowed(clean))
+    return {
+      command,
+      reply:
+        "I can help with learning, interests, and suitable public activities. Romance, alcohol, nightlife and sponsored recommendations are unavailable for members aged 13–17.",
+    };
+  if (
+    solo &&
+    /^(?:relay |schedule |confirm slot |cancel plan |accept opportunity |decline opportunity |request contact |i need help|help me|ask:)/i.test(
+      clean,
+    )
+  )
+    return {
+      command,
+      reply:
+        "I can help with information or suitable public events and places. The Network does not arrange introductions, help from members, groups, relay or contact swaps for members aged 13–17.",
+    };
+  if (/^(stop|start|help)$/i.test(clean)) {
+    command = { ...base, type: "channel_keyword", channel: "web", keyword: clean.toUpperCase() };
+    reply = /^stop$/i.test(clean)
+      ? "Web messaging stopped. Use the explicit channel controls to restart it."
+      : "The Network recorded this channel keyword.";
+  } else if (/^(pause|pause outreach|only when i ask|resume outreach)$/i.test(clean)) {
+    const pause = !/^resume/i.test(clean);
+    command = {
+      ...base,
+      type: "set_preferences",
+      preferences: { onlyWhenAsked: pause },
+      participation: /^pause/i.test(clean)
+        ? "paused"
+        : member.participation === "paused"
+          ? "normal"
+          : member.participation,
+    };
+    reply = pause
+      ? "Outreach is paused. You can resume explicitly when ready."
+      : "Your explicit outreach preference is resumed; current consent, channel, budget and quiet-hour guards still apply.";
+  } else if (/^(what do you know|show my profile|readback)/i.test(clean)) {
+    reply = `Your private readback:\n${readback.join("\n") || "No facts recorded yet."}\nConfirm, correct, reject or change scope using your fact controls.`;
+  } else if (/^request contact /i.test(clean)) {
+    reply =
+      "Use the explicit selected-peer contact controls to grant your exact channel. The model cannot grant contact or sharing consent.";
+  } else {
+    const relay = /^relay (\S+) revision (\d+):\s*([\s\S]+)$/i.exec(clean);
+    const slot = /^schedule (\S+) revision (\d+):\s*([^|]+)\|([^|]+)\|([\s\S]+)$/i.exec(clean);
+    const confirm = /^confirm slot (\S+) revision (\d+):\s*(\S+)$/i.exec(clean);
+    const cancel = /^cancel plan (\S+) revision (\d+)$/i.exec(clean);
+    const response = /^(accept|decline) opportunity (\S+) revision (\d+)$/i.exec(clean);
+    if (relay || slot || confirm || cancel || response) {
+      const target = relay ?? slot ?? confirm ?? cancel;
+      if (response)
+        command = {
+          ...base,
+          type: "respond_opportunity",
+          opportunityId: response[2],
+          expectedRevision: Number(response[3]),
+          accept: response[1].toLowerCase() === "accept",
+          disclosure: {
+            revision: Number(response[3]),
+            factIds: [],
+            contact: false,
+            preciseVenue: false,
+          },
+        };
+      else if (target)
+        command = {
+          ...base,
+          opportunityId: target[1],
+          revision: Number(target[2]),
+          ...(relay
+            ? { type: "relay", body: relay[3] }
+            : slot
+              ? {
+                  type: "propose_slot",
+                  startAt: slot[3].trim(),
+                  endAt: slot[4].trim(),
+                  area: slot[5].trim(),
+                }
+              : confirm
+                ? { type: "confirm_slot", slotId: confirm[3] }
+                : { type: "cancel_plan" }),
+        };
+      reply =
+        "Your explicit request was committed under the current opportunity and member consent guards.";
+      return { command, reply };
+    }
+    const fact =
+      /^(?:i enjoy|i like|interest:)\s*(.+)$/i.exec(clean) ??
+      /^(?:i can offer|i enjoy helping with|offer:)\s*(.+)$/i.exec(clean);
+    const labelled = /^(interest|offer|routine|boundary|city|goal):\s*([\s\S]+)$/i.exec(clean);
+    const ask = /^(?:i need help|help me|ask:)\s*(.+)$/i.exec(clean);
+    if (fact || labelled) {
+      const kind = labelled
+        ? labelled[1].toLowerCase()
+        : /^(?:i can offer|i enjoy helping|offer:)/i.test(clean)
+          ? "offer"
+          : "interest";
+      const value = labelled?.[2] ?? fact?.[1] ?? "";
+      command = {
+        ...base,
+        type: "upsert_fact",
+        fact: {
+          id: `conversation:${networkDigest([messageId, kind, value])}`,
+          kind,
+          value,
+          tags: [],
+          scope: "agent_private",
+          source: "conversation",
+          sourceRef: messageId,
+          confidence: 1,
+          status: "proposed",
+        },
+      };
+      reply = `Proposed privately: ${kind}: ${value}. Confirm or correct it with your fact controls. ${reply}`;
+    } else if (ask) {
+      command = {
+        ...base,
+        type: "ask_network",
+        intentId: `conversation:${networkDigest(messageId)}`,
+        objective: ask[1],
+        category: "support",
+        tags: "support",
+        needs: ask[1],
+        offers: "",
+        status: "active",
+      };
+      reply =
+        "Your request was recorded and the local matcher ran. Any human invitation requires review and independent consent; a match is not promised.";
+    } else if (member.accountState === "onboarding" && exchange >= 7) {
+      reply += `\nPrivate readback:\n${readback.join("\n") || "No facts recorded yet."}`;
+    }
+  }
+  if (member.outreachPause && !/^resume outreach$/i.test(clean))
+    reply +=
+      " After unanswered messages, outreach is set to only when you ask. Say 'resume outreach' if you want to resume.";
+  return { command, reply };
+}
+
+/** Exercises the real response handler and action planner without inference or provider access. */
+export function createLocalNetworkModel(
+  plan: ReturnType<typeof planLocalNetworkTurn>,
+  committed: () => boolean,
+): Plugin {
+  let planned = false;
+  const reply = () =>
+    plan.command && !committed()
+      ? "This request did not produce a verified committed effect. Check the current opportunity, membership and explicit consent controls."
+      : plan.reply;
+  const response = async () =>
+    JSON.stringify({
+      shouldRespond: "RESPOND",
+      contexts: ["general"],
+      intents: ["Authenticated local Network conversation"],
+      candidateActionNames: plan.command ? ["NETWORK_COMMAND"] : [],
+      contextRequests: [],
+      replyText: plan.command ? "" : plan.reply,
+      replyEffectStatus: plan.command ? "pending" : "none",
+      facts: [],
+      relationships: [],
+      topics: [],
+      addressedTo: [],
+      emotion: "none",
+    });
+  return {
+    name: "network-scripted-local-model",
+    description:
+      "Deterministic LOCAL fixture model; no paid inference, external fetch or model-quality qualification.",
+    models: {
+      [ModelType.RESPONSE_HANDLER]: response,
+      [ModelType.ACTION_PLANNER]: async () => {
+        if (!planned && plan.command) {
+          planned = true;
+          return JSON.stringify({
+            completed: false,
+            toolCalls: [
+              {
+                name: "NETWORK_COMMAND",
+                params: { command: plan.command, eliza_turn_scope: "final" },
+              },
+            ],
+            messageToUser: "",
+          });
+        }
+        return JSON.stringify({
+          completed: true,
+          toolCalls: [],
+          messageToUser: reply(),
+          replyEffectStatus: plan.command ? (committed() ? "applied" : "non_applied") : "none",
+        });
+      },
+      [ModelType.TEXT_SMALL]: async () => reply(),
+      [ModelType.TEXT_LARGE]: async () => reply(),
+    },
+  };
+}
diff --git a/packages/cloud/shared/src/lib/network/agent/service.test.ts b/packages/cloud/shared/src/lib/network/agent/service.test.ts
