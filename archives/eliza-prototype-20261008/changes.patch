+import {
+  evaluateCalendarAvailability,
+  findCalendarFreeSlots,
+} from "@elizaos/plugin-calendar/availability";
+import type { EngineMember } from "../domain/types.js";
+import { projectLocalAvailability } from "../workbench/availability.js";
+import type { MatchMember, TimeWindow } from "./types.js";
+
+/** Current canonical member statements/fixture free-busy; no calendar/maps/format inference or second store. */
+export function projectSavedMatchingConstraints(
+  member: Pick<EngineMember, "memberId" | "revision" | "facts" | "preferences">,
+  window: TimeWindow,
+  now: number,
+): Pick<
+  MatchMember,
+  "availability" | "availabilityCoverage" | "travelMinutesByArea" | "preferredFormats"
+> {
+  const range = {
+    start: new Date(window.start).toISOString(),
+    end: new Date(window.end).toISOString(),
+  };
+  const projection = projectLocalAvailability(member, range, { now: () => new Date(now) });
+  const evaluation = evaluateCalendarAvailability({
+    range,
+    timeZone: member.preferences.timezone,
+    sources: projection.sources,
+  });
+  const slots = evaluation.definitive
+    ? findCalendarFreeSlots({
+        range,
+        timeZone: member.preferences.timezone,
+        sources: projection.sources,
+        durationMs: Math.min(15 * 60_000, window.end - window.start),
+        maxResults: 200,
+      })
+    : [];
+  const availability: TimeWindow[] = [];
+  for (const slot of slots) {
+    const previous = availability.at(-1),
+      start = Date.parse(slot.start),
+      end = Date.parse(slot.end);
+    if (previous && previous.end === start) previous.end = end;
+    else availability.push({ start, end });
+  }
+  return {
+    availability,
+    availabilityCoverage: !evaluation.definitive
+      ? "unknown"
+      : slots.length >= 200
+        ? "sampled"
+        : "complete",
+    travelMinutesByArea: projection.travelMinutesByArea,
+    preferredFormats: member.preferences.formats,
+  };
+}
