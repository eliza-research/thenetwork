+.network-workbench {
+  --nw-bg: #fdfaf7;
+  --nw-surface: #ffffff;
+  --nw-ink: #151515;
+  --nw-muted: #55534f;
+  --nw-line: #dedbd7;
+  --nw-accent: #ff6a1f;
+  --nw-hover: #c2410c;
+  --nw-soft: #fff0e6;
+  --nw-danger: #a62017;
+  background: var(--nw-bg);
+  color: var(--nw-ink);
+  font:
+    15px / 1.5 -apple-system,
+    BlinkMacSystemFont,
+    "Segoe UI",
+    sans-serif;
+  min-height: 100vh;
+  text-align: left;
+}
+.network-workbench *,
+.network-workbench *::before,
+.network-workbench *::after {
+  box-sizing: border-box;
+}
+.network-workbench h1,
+.network-workbench h2,
+.network-workbench h3,
+.network-workbench p,
+.network-workbench dl,
+.network-workbench dd {
+  margin: 0;
+}
+.network-workbench button,
+.network-workbench input,
+.network-workbench select,
+.network-workbench textarea {
+  font: inherit;
+}
+.network-workbench button,
+.network-workbench select,
+.network-workbench summary {
+  cursor: pointer;
+}
+.network-workbench a {
+  color: inherit;
+}
+.network-workbench :focus-visible {
+  outline: 2px solid var(--nw-hover);
+  outline-offset: 3px;
+}
+.network-workbench .nw-skip-link {
+  position: fixed;
+  top: -80px;
+  left: 20px;
+  z-index: 10;
+  background: var(--nw-ink);
+  color: white;
+  padding: 12px 18px;
+}
+.nw-skip-link:focus {
+  top: 12px;
+}
+.nw-header {
+  display: flex;
+  align-items: center;
+  gap: 24px;
+  min-height: 84px;
+  padding: 18px 32px;
+  background: var(--nw-surface);
+  border-bottom: 1px solid var(--nw-line);
+}
+.nw-wordmark {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 23px;
+  font-weight: 650;
+  letter-spacing: -0.025em;
+  text-decoration: none;
+  white-space: nowrap;
+}
+.nw-wordmark-dot {
+  width: 10px;
+  height: 10px;
+  background: var(--nw-accent);
+  border-radius: 50%;
+}
+.nw-mode-switch {
+  display: flex;
+  margin-left: auto;
+  gap: 2px;
+  background: #f1efec;
+  padding: 4px;
+  border-radius: 8px;
+}
+.nw-mode-button {
+  min-height: 40px;
+  padding: 8px 16px;
+  border: 0;
+  border-radius: 5px;
+  background: transparent;
+  color: var(--nw-muted);
+  font-weight: 600;
+}
+.nw-mode-button[aria-pressed="true"] {
+  background: white;
+  color: var(--nw-ink);
+}
+.nw-mode-button:hover {
+  color: var(--nw-ink);
+  background: #fff8f2;
+}
+.nw-fixture {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.nw-fixture label {
+  color: var(--nw-muted);
+  white-space: nowrap;
+}
+.nw-fixture select {
+  max-width: 280px;
+  min-height: 44px;
+  background: white;
+  color: var(--nw-ink);
+  border: 1px solid var(--nw-line);
+  border-radius: 6px;
+  padding: 8px 30px 8px 12px;
+}
+.nw-environment {
+  display: flex;
+  align-items: center;
