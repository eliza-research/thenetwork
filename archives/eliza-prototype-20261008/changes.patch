+++ b/packages/cloud/shared/src/lib/network/agent/service.test.ts
@@ -0,0 +1,486 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { executeWorkbenchCommand } from "../workbench/application.ts";
+import { localAvailabilityFact } from "../workbench/availability.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import {
+  eraseNetworkConversation,
+  NetworkMemberAgent,
+  networkConversationIdentity,
+} from "./service.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let agent: NetworkMemberAgent;
+let memberId: string, otherId: string;
+let teenId: string;
+beforeAll(async () => {
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:native-conversation",
+    clock,
+  });
+  const members = await seedSimulationMembers(host.domain, 100, 42);
+  memberId = members[0].memberId;
+  otherId = members[2].memberId;
+  teenId = members[37].memberId;
+  agent = new NetworkMemberAgent({
+    host,
+    executeCommand: (actor, input) => executeWorkbenchCommand(host, clock, actor, input),
+  });
+}, 240000);
+afterAll(async () => {
+  await host?.close();
+});
+
+it("binds room, world and entity identities to exact namespace/member tuples without delimiter collisions", () => {
+  const first = networkConversationIdentity("test:a:b", "c");
+  const second = networkConversationIdentity("test:a", "b:c");
+  expect(first.entityId).not.toBe(second.entityId);
+  expect(first.roomId).not.toBe(second.roomId);
+  expect(first.worldId).not.toBe(second.worldId);
+});
+it("keeps teen chat and own proposed profile facts solo and gates legacy ambiguous minors before message persistence", async () => {
+  const actor = { type: "member", memberId: teenId } as const;
+  const own = await agent.message(teenId, {
+    text: "interest: public painting",
+    requestId: "teen-profile",
+  });
+  expect(own.receipts).toHaveLength(1);
+  expect(own.reply).toContain("Proposed privately");
+  for (const [index, text] of [
+    "ask: find someone to help me move",
+    "relay invented revision 1: hello",
+    "dating advice",
+    "find 21+ nightlife",
+  ].entries()) {
+    const turn = await agent.message(teenId, { text, requestId: `teen-denied-${index}` });
+    expect(turn.receipts).toEqual([]);
+    expect(turn.reply).toContain("13–17");
+  }
+  await host.domain.command(actor, {
+    type: "attest_age",
+    requestId: "teen-legacy",
+    memberId: teenId,
+    age: "minor",
+    confirmed: true,
+  });
+  const identity = networkConversationIdentity(host.domain.options.networkId, teenId);
+  const before = await host.adapter.getMemories({
+    tableName: "messages",
+    roomId: identity.roomId,
+    agentId: host.runtime.agentId,
+  });
+  await expect(
+    agent.message(teenId, { text: "hello", requestId: "legacy-no-store" }),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  expect(
+    await host.adapter.getMemories({
+      tableName: "messages",
+      roomId: identity.roomId,
+      agentId: host.runtime.agentId,
+    }),
+  ).toHaveLength(before.length);
+  await host.domain.command(actor, {
+    type: "attest_age",
+    requestId: "teen-confirm",
+    memberId: teenId,
+    age: "minor",
+    ageBand: "13_17",
+    confirmed: true,
+  });
+  await expect(
+    executeWorkbenchCommand(host, clock, actor, {
+      type: "request_world_attendance",
+      requestId: "teen-no-co-attendance",
+      fixtureId: "invented",
