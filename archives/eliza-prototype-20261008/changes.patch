+      const participation = opportunity.participants.find(
+        (participant) => participant.memberId === actor.memberId,
+      );
+      if (
+        member.age !== "adult" ||
+        member.safetyHold ||
+        ["removed", "restricted"].includes(member.accountState) ||
+        !participation?.acceptedAt ||
+        participation.revision !== opportunity.revision ||
+        ["declined", "expired", "replaced"].includes(participation.state)
