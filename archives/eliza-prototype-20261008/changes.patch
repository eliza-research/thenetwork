+    expect(await data.invalidateDeleted()).toBe(1);
+    for (const artifact of [artifacts.parquet, ...Object.values(artifacts.notebooks)])
+      expect(readPrivateMediaBytes(artifact.fileName)).toBeNull();
+  } finally {
