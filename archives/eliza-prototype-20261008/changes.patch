@@ -0,0 +1,278 @@
+import { randomUUID } from "node:crypto";
+import { mkdtemp, readdir, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { readPrivateMediaBytes } from "../../../../../../agent/src/api/media-store.ts";
+import { localNetworkExportWriter } from "../../../../../scripts/network-data-export.ts";
+import { NetworkDomain } from "../domain/service.ts";
+import type { NetworkActor } from "../domain/types.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { NetworkDataExport } from "./data-export.ts";
+import { createLocalNetworkHost } from "./host.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T01:00:00.000Z"));
+const analyst: NetworkActor = { type: "staff", userId: "fixture-analyst", roles: ["analyst"] };
+const engineer: NetworkActor = { type: "staff", userId: "fixture-engineer", roles: ["engineer"] };
+let directory: string;
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let exporter: NetworkDataExport;
+beforeAll(async () => {
+  directory = await mkdtemp(join(tmpdir(), "network-export-test-"));
+  vi.stubEnv("ELIZA_STATE_DIR", directory);
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: `test:export:${randomUUID()}`,
+    clock,
+    dispatchOperations: (record) => exporter.dispatch(record),
+  });
+  await seedSimulationMembers(host.domain, 10, 7);
+  await host.domain.command(
+    { type: "system" },
+    {
+      type: "report_member",
+      requestId: "private-case",
+      caseId: "EXPORT_PRIVATE_CASE_METADATA",
+      memberId: "00000000-0000-4000-8000-000000000001",
+      reportedId: "00000000-0000-4000-8000-000000000002",
+      reason: "EXPORT_PRIVATE_CASE_REASON",
+      evidence: "EXPORT_PRIVATE_CASE_EVIDENCE",
+      placeHold: false,
+    },
+  );
+  exporter = new NetworkDataExport({
+    domain: host.domain,
+    scheduler: host.runner,
+    clock,
+    writer: localNetworkExportWriter,
+    graph: host.native.adminGraph,
+  });
+}, 120000);
+afterAll(async () => {
+  await host?.close();
+  vi.unstubAllEnvs();
+  if (directory) await rm(directory, { recursive: true, force: true });
+});
+
+it("retains genuine scrubbed Parquet and executable saved DuckDB notebook artifacts", async () => {
+  await expect(exporter.export(engineer, "forbidden")).rejects.toMatchObject({
+    code: "NETWORK_FORBIDDEN",
+  });
+  const source = await host.domain.adminView(analyst);
+  const [exported, replayed] = await Promise.all([
+    exporter.export(analyst, "snapshot-1"),
+    exporter.export(analyst, "snapshot-1"),
+  ]);
+  expect(replayed).toEqual(exported);
+  expect(await readdir(join(directory, "media"))).toHaveLength(4);
+  const downloaded = await exporter.artifact(analyst, exported.exportId, "parquet");
+  expect(Buffer.from(downloaded.bytes).subarray(0, 4).toString()).toBe("PAR1");
+  expect(Buffer.from(downloaded.bytes).subarray(-4).toString()).toBe("PAR1");
+  expect(downloaded.filename).toMatch(/\.parquet$/);
+  expect(exported.parquet.fileName).toContain(".private-");
+  const notebook = JSON.parse(
+    Buffer.from((await exporter.artifact(analyst, exported.exportId, "exposure")).bytes).toString(),
+  );
+  expect(notebook.nbformat).toBe(4);
+  expect(notebook.cells[1].source.join("")).toContain(
+    `network-snapshot-${exported.exportId}.parquet`,
+  );
+  const result = await exporter.runNotebook(analyst, "exposure");
+  expect(result.rows).toHaveLength(10);
+  const retained = await exporter.readSnapshot(engineer);
+  expect(retained.snapshot.members).toHaveLength(10);
+  expect(retained.snapshot.safetyCases).toEqual([]);
+  expect(
+    retained.snapshot.events.filter((event) =>
+      JSON.stringify(event).includes("EXPORT_PRIVATE_CASE_"),
+    ),
+  ).toEqual([]);
+  expect(JSON.stringify(retained)).not.toContain("EXPORT_PRIVATE_CASE_");
+  expect(exported.schemaVersion).toBe(3);
+  expect(retained.snapshot).toEqual(source);
+  expect(retained.snapshot.members.map((member) => member.memberId)).toEqual(
+    source.members.map((member) => member.memberId),
+  );
+  expect(retained.edges).toEqual([]);
+  expect(retained.sourceSequence).toBe(exported.sourceSequence);
+  expect(retained.clockAt).toBe(exported.exportedAt);
+  expect(JSON.stringify(retained)).not.toContain("CANARY_PRIVATE_");
+  expect(JSON.stringify(retained)).not.toContain("synthetic-cloud-");
+  expect(result.source).toBe("retained_scrubbed_parquet");
+  expect(JSON.stringify(result)).not.toContain("CANARY_PRIVATE_");
+  expect(JSON.stringify(result)).not.toContain("synthetic-cloud-");
+  expect(await exporter.export(analyst, "snapshot-1")).toEqual(exported);
+  await expect(exporter.runNotebook(analyst, "constructor")).rejects.toBeDefined();
+  await expect(exporter.artifact(engineer, exported.exportId, "parquet")).rejects.toMatchObject({
+    code: "NETWORK_FORBIDDEN",
+  });
+});
+
+it("uses a stable native nightly job and keeps notebook analytics on the retained export", async () => {
+  const [first, second] = await Promise.all([
+    exporter.scheduleNightly(),
+    exporter.scheduleNightly(),
+  ]);
+  expect(first.taskId).toBe(second.taskId);
+  expect(first.kind).toBe("custom");
+  expect(first.trigger).toEqual({ kind: "once", atIso: "2026-10-06T02:00:00.000Z" });
+  clock.advanceTo("2026-10-06T02:00:00.000Z");
+  const completed = await host.runner.fireWithResult(first.taskId);
+  if (completed.kind === "dispatch_failed") throw completed.error;
+  expect(completed.kind).toBe("fired");
+  const current = await exporter.latest(analyst);
+  expect(current?.exportedAt).toBe(clock.now().toISOString());
+  const next = (await host.runner.list()).find(
+    (task) =>
+      task.taskId !== first.taskId &&
+      (task.metadata?.network as { scope?: string } | undefined)?.scope === "data_export",
+  );
+  expect(next?.trigger).toEqual({ kind: "once", atIso: "2026-10-07T02:00:00.000Z" });
+  const primary = vi
