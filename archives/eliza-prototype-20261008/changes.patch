@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import { findCalendarFreeSlots } from "./availability.js";
+
+const range = {
+  start: "2026-10-06T18:00:00.000Z",
+  end: "2026-10-06T20:00:00.000Z",
+};
+const sources = [
+  {
+    id: "authored",
+    status: "fresh" as const,
+    visibility: "busy_only" as const,
+    events: [],
+  },
+];
+describe("bounded native free-slot sampling", () => {
+  it("preserves two default choices and supports explicit bounded matching samples", () => {
+    expect(
+      findCalendarFreeSlots({
+        range,
+        timeZone: "UTC",
+        sources,
+        durationMs: 30 * 60_000,
+      }),
+    ).toHaveLength(2);
+    expect(
+      findCalendarFreeSlots({
+        range,
+        timeZone: "UTC",
+        sources,
+        durationMs: 30 * 60_000,
+        maxResults: 4,
+      }),
+    ).toHaveLength(4);
+  });
+  it("rejects invalid bounds and still refuses unknown coverage", () => {
+    for (const maxResults of [0, -1, 1.5, 201, Infinity])
+      expect(() =>
+        findCalendarFreeSlots({
+          range,
+          timeZone: "UTC",
+          sources,
+          durationMs: 30 * 60_000,
+          maxResults,
+        }),
+      ).toThrow("bound");
+    expect(
+      findCalendarFreeSlots({
+        range,
+        timeZone: "UTC",
+        sources: [{ ...sources[0], status: "stale" }],
+        durationMs: 30 * 60_000,
+        maxResults: 200,
+      }),
+    ).toEqual([]);
+  });
+});
