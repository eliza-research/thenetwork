new file mode 100644
index 000000000000..0a6628987dbc
--- /dev/null
+++ b/packages/ui/src/network/portal-api.ts
@@ -0,0 +1,48 @@
+import type { NetworkMemberView } from "./api";
+import { NetworkTransportError, request } from "./api";
+
+export interface PortalBrand {
+  id: string;
+  name: string;
+  purpose: string;
+  description: string;
+}
+export interface PortalConfig {
+  mode: "local_preview";
+  brands: PortalBrand[];
+  demoPhone: string;
+  agentPhone: string | null;
+}
+export interface PortalChallenge {
+  challengeId: string;
+  maskedPhone: string;
+  expiresAt: string;
+  demoCode?: string;
+}
+export interface PortalSession {
+  member: NetworkMemberView | null;
+  brand: string | null;
+  eligible?: boolean;
+  channel: { status: "local_preview"; number: string | null };
+}
+
+export async function portalRequest<T>(
+  route: "config" | "start" | "verify" | "session" | "signout",
+  options: { body?: Record<string, string>; signal?: AbortSignal } = {},
+): Promise<T> {
+  const body = await request(`/api/network/portal/${route}`, {
+    signal: options.signal,
+    ...(options.body
+      ? {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(options.body),
+        }
+      : {}),
+  });
+  if (typeof body !== "object" || body === null || Array.isArray(body))
+    throw new NetworkTransportError(
+      "The portal returned an invalid response. Reload to try again.",
+    );
+  return body as T;
+}
