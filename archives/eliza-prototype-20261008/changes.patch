+		expect(projected.at(-1)?.value).toBe(projected[0]?.value);
+		expect(session.restoreInValue(projected)).toEqual(corpus);
+	});
+	it("keeps finite node, byte and descriptor guards under expanded limits", () => {
+		for (const maxNodes of [0, -1, Infinity, 1.5])
