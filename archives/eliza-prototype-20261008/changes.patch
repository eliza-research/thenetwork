+  expect(summary.reviewers.find((row) => row.reviewerId === "primary-reviewer")).toMatchObject({
+    primaryLabels: 2,
+    blindLabels: 0,
+    measuredTimeItems: 1,
+    missingTimeItems: 1,
+    meanDurationMs: 0,
+  });
+});
+
+it("keeps legacy attribution unmeasured and does not choose a primary from ambiguous history", () => {
+  const summary = summarizeNetworkReviewOperations([
+    { ...primary, details: { ...primary.details, durationMs: 2000, note: "PRIVATE_REVIEW_NOTE" } },
+    {
+      ...primary,
+      id: "ambiguous-primary",
+      actor: { type: "staff", userId: "other-primary", roles: ["reviewer"] },
+    },
+    {
+      ...primary,
+      id: "blind",
+      kind: "record_blind_review",
+      actor: { type: "staff", userId: "independent", roles: ["reviewer"] },
+    },
+    { ...primary, id: "legacy-revision", details: { decision: "approved" } },
+    { ...primary, id: "system-label", actor: { type: "system" } },
+    {
+      ...primary,
+      id: "non-reviewer",
+      actor: { type: "staff", userId: "analyst", roles: ["analyst"] },
+    },
+  ]);
+  expect(summary.unattributedLabels).toBe(3);
+  expect(summary.agreement).toMatchObject({
+    numerator: 0,
+    denominator: 0,
+    rate: null,
+    unmatchedBlindLabels: 1,
+  });
+  expect(summary.time).toMatchObject({
+    measuredTimeItems: 0,
+    missingTimeItems: 3,
+    meanDurationMs: null,
+  });
+  expect(JSON.stringify(summary)).not.toContain("PRIVATE_REVIEW_NOTE");
+  expect(summarizeNetworkReviewOperations([]).time.meanDurationMs).toBeNull();
+});
+
+it("counts distinct retained reports without turning reopened cases or null targets into allegations", () => {
+  const first: SafetyCase = {
+    id: "case-1",
+    reporterId: "reporter",
+    reportedId: "target",
+    reason: "PRIVATE_REPORT_REASON",
