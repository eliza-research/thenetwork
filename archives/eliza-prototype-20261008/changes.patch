+import { PseudonymSession, RegexEntityRecognizer } from "@elizaos/core";
+import { expect, it } from "vitest";
+import { assertReplayLog, scrubNetworkProjection } from "../domain/policy.ts";
+
+const recognizer = new RegexEntityRecognizer({ email: true, phone: true, address: true });
+const budget = { maxNodes: 2_000_000, maxBytes: 64 * 1024 * 1024 };
+
+it("recognizes a validated native LLM call UUID without admitting human contact text", () => {
+  const callId = "1aada544-2c8a-4772-b154-0978364b0df1";
+  expect(() =>
+    assertReplayLog([], { trajectories: [{ detail: { steps: [{ llmCalls: [{ callId }] }] } }] }),
+  ).not.toThrow();
+  expect(() => assertReplayLog([], { callId: "+1 415 555 0199" })).toThrow("contact data");
+  expect(() => assertReplayLog([], { text: "Call +1 415 555 0199" })).toThrow("contact data");
+});
+
+it("preserves a canonical trajectory step UUID without admitting contact-shaped step metadata", () => {
+  const stepId = "1aada544-2c8a-4772-b154-0978364b0df1";
+  expect(() =>
+    assertReplayLog([], { trajectories: [{ detail: { steps: [{ stepId }] } }] }),
+  ).not.toThrow();
+  expect(() => assertReplayLog([], { stepId: "+1 415 555 0199" })).toThrow("contact data");
+  expect(() => assertReplayLog([], { text: "Call +1 415 555 0199" })).toThrow("contact data");
+});
+
+it("retains every record and consistent aliases when aggregate nested nodes exceed the unchanged2M guard", async () => {
+  const corpus = {
+    metadata: { cursor: "all-records-retained" },
+    records: Array.from({ length: 15 }, (_, record) => ({
+      id: record,
+      values: Array.from({ length: 20000 }, (_, index) => ({
+        index,
+        nested: { label: `record-${record}-${index}`, email: "private.person@example.com" },
+      })),
+    })),
+  };
+  expect(() => new PseudonymSession({ walkBudget: budget }).substituteInValue(corpus)).toThrow(
+    "walk budget",
+  );
+  const projected = await scrubNetworkProjection(corpus, "all-complete-records");
+  expect(projected.metadata).toEqual(corpus.metadata);
+  expect(projected.records.map((record) => record.id)).toEqual(
+    corpus.records.map((record) => record.id),
+  );
+  expect(projected.records.every((record) => record.values.length === 20000)).toBe(true);
+  expect(projected.records[14]?.values[19999]?.nested.label).toBe("record-14-19999");
+  expect(projected.records[14]?.values[19999]?.nested.email).toBe(
+    projected.records[0]?.values[0]?.nested.email,
+  );
+  expect(JSON.stringify(projected)).not.toContain("private.person@example.com");
+  await expect(
+    scrubNetworkProjection({ records: [{ whole: corpus.records }] }, "one-overlarge-record"),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+});
+
+it("reserves later unrecognized literal text before minting any earlier record alias", async () => {
+  const raw = "123 Private Street",
+    salt = "later-literal-collision";
+  const earlier = new PseudonymSession({ salt, recognizer, walkBudget: budget });
+  await earlier.learn(JSON.stringify([{ address: raw }]));
+  const alias = earlier.entries.find((entry) => entry.value === raw)?.surrogate;
+  if (!alias) throw new Error("Canonical address alias fixture unavailable");
+  const literal = `x${alias}y`;
+  expect(await recognizer.recognize(literal)).toEqual([]);
+  const value = { records: [{ address: raw }, { literal }, { address: raw }] };
+  const projected = await scrubNetworkProjection(value, salt);
+  expect(projected.records[0]?.address).not.toBe(alias);
+  expect(projected.records[0]?.address).toBe(projected.records[2]?.address);
+  expect(projected.records[1]?.literal).toBe(literal);
+  expect(JSON.stringify(projected)).not.toContain(raw);
+});
+
+it("uses canonical descriptors rather than benign-looking proxy length getters and changing slot descriptors", async () => {
+  let lengthReads = 0,
+    indexReads = 0;
+  const records = new Proxy(
+    [{ email: "private.person@example.com", sentinel: "first-captured-record" }],
+    {
+      get(target, key, receiver) {
+        if (key === "length") {
+          lengthReads++;
+          return 0;
+        }
+        return Reflect.get(target, key, receiver);
+      },
+      getOwnPropertyDescriptor(target, key) {
+        if (key === "0") {
+          indexReads++;
+          if (indexReads > 1)
+            return {
+              value: { sentinel: "WRONG_SECOND_READ" },
+              enumerable: true,
+              configurable: true,
+              writable: true,
+            };
+        }
+        return Reflect.getOwnPropertyDescriptor(target, key);
+      },
+    },
+  );
+  const projected = await scrubNetworkProjection({ records }, "descriptor-only");
+  expect(projected.records).toHaveLength(1);
+  expect(projected.records[0]?.sentinel).toBe("first-captured-record");
+  expect(lengthReads).toBe(0);
+  expect(indexReads).toBe(1);
+});
+
+it("preserves real root-array and root-object record depth at the existing64-level boundary", async () => {
+  for (const count of [61, 62, 63, 64]) {
+    let record: unknown = { leaf: "kept" };
+    for (let i = 0; i < count; i++) record = { next: record };
+    for (const value of [[record], { records: [record] }]) {
+      let accepted = true;
+      try {
+        new PseudonymSession({ walkBudget: budget }).substituteInValue(value);
+      } catch {
+        accepted = false;
+      }
+      if (accepted) expect(await scrubNetworkProjection(value, "same-depth")).toEqual(value);
+      else
+        await expect(scrubNetworkProjection(value, "same-depth")).rejects.toHaveProperty(
+          "code",
+          "PII_PSEUDONYM_UNBOUNDED",
+        );
+    }
+  }
+});
+
+it("keeps accessor, cross-record cycle, proxy, key-byte, sparse-slot and single-record byte guards", async () => {
+  let getterCalls = 0;
+  const accessor = Object.defineProperty({}, "email", {
+    enumerable: true,
+    get() {
+      getterCalls++;
+      return "private.person@example.com";
+    },
+  });
+  await expect(
+    scrubNetworkProjection({ records: [accessor] }, "accessor-record"),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+  expect(getterCalls).toBe(0);
+  const first: Record<string, unknown> = {},
+    second: Record<string, unknown> = {};
+  first.other = second;
+  second.other = first;
+  await expect(
+    scrubNetworkProjection({ records: [first, second] }, "cross-record-cycle"),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+  await expect(
+    scrubNetworkProjection(
+      new Proxy(
+        { records: [] },
+        {
+          ownKeys() {
+            throw new Error("uninspectable");
+          },
+        },
+      ),
+      "proxy-root",
+    ),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+  await expect(
+    scrubNetworkProjection({ ["k".repeat(1025)]: [] }, "key-root"),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+  let slotReads = 0;
+  const sparse = new Proxy(new Array(2_000_001), {
+    getOwnPropertyDescriptor(target, key) {
+      if (key !== "length") slotReads++;
+      return Reflect.getOwnPropertyDescriptor(target, key);
+    },
+  });
+  await expect(scrubNetworkProjection({ records: sparse }, "sparse-root")).rejects.toHaveProperty(
+    "code",
+    "PII_PSEUDONYM_UNBOUNDED",
+  );
+  expect(slotReads).toBe(0);
+  await expect(
+    scrubNetworkProjection(
+      { records: [{ value: "s".repeat(64 * 1024 * 1024 + 1) }] },
+      "byte-record",
+    ),
+  ).rejects.toHaveProperty("code", "PII_PSEUDONYM_UNBOUNDED");
+});
+
+it("preserves root __proto__ data records and sparse shape without changing the object prototype", async () => {
+  const records = Array<{ email: string }>(3);
+  records[0] = { email: "private.person@example.com" };
+  records[2] = { email: "private.person@example.com" };
+  const value = Object.defineProperty({ metadata: "kept" }, "__proto__", {
+    enumerable: true,
+    value: records,
+  }) as { metadata: string; __proto__: typeof records };
+  const projected = await scrubNetworkProjection(value, "safe-proto-data");
+  expect(Object.getPrototypeOf(projected)).toBe(Object.prototype);
+  expect(Object.hasOwn(projected, "__proto__")).toBe(true);
+  expect(projected.__proto__).toHaveLength(3);
+  expect(1 in projected.__proto__).toBe(false);
+  expect(projected.__proto__[0]?.email).toBe(projected.__proto__[2]?.email);
+  expect(projected.metadata).toBe("kept");
+});
