+import type {
+  DispatchResult,
+  ScheduledTask,
+  ScheduledTaskDispatchRecord,
+  ScheduledTaskRunner,
+  ScheduledTaskStore,
+  TaskGateContribution,
+} from "@elizaos/plugin-scheduling";
+import {
+  type GateDecision,
+  isScheduledTaskDue,
+  listRecoverableScheduledTaskRefs,
+} from "@elizaos/plugin-scheduling";
+import { type CarveOutSqlExecutor, sqlQuote } from "@elizaos/plugin-sql";
+import { networkDigest } from "../digest.ts";
+import type { NetworkDomain } from "../domain/service.ts";
+import {
+  type City,
+  type NetworkClock,
+  type NetworkCommand,
+  type NetworkCommandResult,
+  NetworkDomainError,
+} from "../domain/types.ts";
+import type { MatchingRun } from "../matching/types.ts";
+
+type Cadence = "events" | "nightly" | "wednesday" | "weekly_health" | "monthly_event_planning";
+interface MatchingBinding {
+  scope: "matching";
+  networkId: string;
+  city: City;
+  cadence: Cadence;
+  pendingAt?: string;
+  token?: string;
+}
+const cities: City[] = ["SF", "NYC"];
+const cadences: Cadence[] = [
+  "events",
+  "nightly",
+  "wednesday",
+  "weekly_health",
+  "monthly_event_planning",
+];
+const relevant = new Set<NetworkCommand["type"]>([
+  "complete_onboarding",
+  "upsert_fact",
+  "delete_fact",
+  "manage_intent",
+  "set_presence",
+  "set_preferences",
+  "give_feedback",
+  "block_member",
+  "delete_account",
+  "set_channel",
+  "channel_keyword",
+  "attest_age",
+  "connect_source",
+  "report_member",
+  "hold_safety_case",
+  "resolve_safety",
+  "resolve_safety_appeal",
+  "configure",
+  "record_inbound",
+  "respond_opportunity",
+  "record_attendance",
+]);
+
+/** Native Clock rows own timing, claim leases and recovery; Network owns matching transactions. */
+export class NetworkMatchingJobs {
+  constructor(
+    private readonly options: {
+      domain: NetworkDomain;
+      agentId: string;
+      clock: NetworkClock;
+      taskStore(execute?: CarveOutSqlExecutor): ScheduledTaskStore;
+      /** Prepare external-owner reads before the Network lock; the returned computation must use joined owners only. */
+      prepare(
+        city: City,
+        runId: string,
+        cadence: Cadence,
+      ): Promise<(domain: NetworkDomain) => Promise<MatchingRun>>;
+      afterRun?(run: MatchingRun): Promise<void>;
+    },
+  ) {}
+  private key(city: City, cadence: Cadence) {
+    return `network:matching:${this.options.domain.options.networkId}:${city}:${cadence}`;
+  }
+  private binding(record: Pick<ScheduledTask, "metadata">): MatchingBinding {
+    const value = record.metadata?.network;
+    if (
+      !value ||
+      typeof value !== "object" ||
+      !("scope" in value) ||
+      value.scope !== "matching" ||
+      !("networkId" in value) ||
+      value.networkId !== this.options.domain.options.networkId ||
+      !("city" in value) ||
+      !cities.includes(value.city as City) ||
+      !("cadence" in value) ||
+      !cadences.includes(value.cadence as Cadence)
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "Current scoped matching Clock binding required",
+      );
+    return value as MatchingBinding;
+  }
+  private runId(binding: MatchingBinding, at: string) {
+    return `clock:${networkDigest([binding.networkId, binding.city, binding.cadence, binding.cadence === "events" ? binding.token : at])}`;
+  }
+  async install(runner: ScheduledTaskRunner) {
+    const tasks: ScheduledTask[] = [];
+    for (const city of cities)
+      for (const cadence of cadences)
+        tasks.push(
+          await runner.schedule({
+            kind: "custom",
+            priority: "low",
+            source: "plugin",
+            createdBy: "network-matching",
+            ownerVisible: true,
+            respectsGlobalPause: false,
+            promptInstructions:
+              "Run the scoped Network matching or health computation; never send an unreviewed invitation.",
+            idempotencyKey: this.key(city, cadence),
+            trigger:
+              cadence === "events"
+                ? {
+                    kind: "interval",
+                    everyMinutes: 1,
+                  }
+                : {
+                    kind: "cron",
+                    expression:
+                      cadence === "nightly"
+                        ? "0 2 * * *"
+                        : cadence === "wednesday"
+                          ? "0 12 * * 3"
+                          : cadence === "weekly_health"
+                            ? "0 9 * * 1"
+                            : "0 10 1 * *",
+                    tz: city === "SF" ? "America/Los_Angeles" : "America/New_York",
+                  },
+            metadata: {
+              network: {
+                scope: "matching",
+                networkId: this.options.domain.options.networkId,
+                city,
+                cadence,
+              },
+            },
+            shouldFire: { compose: "all", gates: [{ kind: "network_matching" }] },
+            output: { destination: "channel", target: "network-internal" },
+          }),
+        );
+    return tasks;
+  }
+  async signal(
+    execute: CarveOutSqlExecutor,
+    command: NetworkCommand,
+    result: NetworkCommandResult,
+  ): Promise<void> {
+    if (
+      !relevant.has(command.type) &&
+      !(command.type === "record_event" && command.kind === "local_world_fixture")
+    )
+      return;
+    const store = this.options.taskStore(execute);
+    const affectedCities =
+      command.type !== "set_presence" &&
+      command.type !== "delete_account" &&
+      "homeCities" in result &&
+      "presence" in result
+        ? cities.filter(
+            (city) =>
+              result.homeCities.includes(city) ||
+              result.presence.some((presence) => presence.city === city),
+          )
+        : cities;
+    for (const city of affectedCities) {
+      const task = await store.findByIdempotencyKey(this.key(city, "events"));
+      if (!task) continue; // Initial schema/bootstrap commands precede cadence installation.
+      const current = this.binding(task),
+        pendingAt = this.options.clock.now().toISOString();
+      const token = networkDigest([current.token ?? null, command.requestId]);
+      const next = {
+        ...task,
+        metadata: { ...task.metadata, network: { ...current, pendingAt, token } },
+      };
+      const changed = await store.upsertIfStatus(next, {
+        expectedStatus: task.state.status,
+        expectedState: task.state,
+        expectedMetadata: task.metadata ?? {},
+        nextFireAtIso: new Date(Date.parse(pendingAt) + 3 * 60_000).toISOString(),
+      });
+      if (!changed)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Matching Clock signal raced; domain command must retry atomically",
+        );
+    }
+  }
+  private async eventDecision(target: MatchingBinding, nowIso: string): Promise<GateDecision> {
+    if (target.cadence !== "events") return { kind: "allow" };
+    if (!target.token || !target.pendingAt)
+      return { kind: "deny", reason: "network_no_matching_change" };
+    const due = Date.parse(target.pendingAt) + 3 * 60_000;
+    if (!Number.isFinite(due)) return { kind: "deny", reason: "network_invalid_matching_change" };
+    if (due > Date.parse(nowIso))
+      return {
+        kind: "defer",
+        until: { atIso: new Date(due).toISOString() },
+        reason: "network_matching_debounce",
+      };
+    const completed = await this.options.domain.getMatchingRun(
+      { type: "system" },
+      this.runId(target, nowIso),
+    );
+    return completed
+      ? { kind: "deny", reason: "network_change_already_matched" }
+      : { kind: "allow" };
+  }
+  gate(): TaskGateContribution {
+    return {
+      kind: "network_matching",
+      evaluate: (task, context) => this.eventDecision(this.binding(task), context.nowIso),
+    };
+  }
+  async dispatch(record: ScheduledTaskDispatchRecord): Promise<DispatchResult> {
+    const target = this.binding(record),
+      runId = this.runId(target, record.firedAtIso);
+    const existing = await this.committedRun(this.options.domain, runId, target.city);
+    const compute = existing
+      ? undefined
+      : await this.options.prepare(target.city, runId, target.cadence);
+    const run = await this.options.domain.withAuthority(async (domain) => {
+      const raced = existing ?? (await this.committedRun(domain, runId, target.city));
+      if (raced) return raced;
+      if (!compute)
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "Matching computation unavailable after replay admission",
+        );
+      const result = await compute(domain);
+      await domain.command(
+        { type: "system" },
+        {
+          type: "record_event",
+          requestId: `heartbeat:${runId}`,
+          kind: "matching_heartbeat",
+          memberIds: [],
+          opportunityId: null,
+          details: {
+            city: target.city,
+            cadence: target.cadence,
+            runId,
+            proposals: result.proposals.length,
+          },
+        },
+      );
+      return result;
+    });
+    await this.options.afterRun?.(run);
+    return {
+      ok: true,
+      metadata: { internalComputation: true, runId, proposals: run.proposals.length },
+    };
+  }
+  private async committedRun(
+    domain: NetworkDomain,
+    runId: string,
+    city: City,
+  ): Promise<MatchingRun | null> {
+    const stored = await domain.getMatchingRun({ type: "system" }, runId);
+    if (!stored) return null;
+    const run = stored.log as unknown as MatchingRun;
+    if (
+      stored.fingerprintVersion !== 2 ||
+      stored.city !== city ||
+      run.runId !== runId ||
+      run.replayInput?.city !== city ||
+      !Array.isArray(run.proposals)
+    )
+      throw new NetworkDomainError(
+        "NETWORK_IDEMPOTENCY",
+        "Matching Clock run requires reconciliation before replay",
+      );
+    return run;
+  }
+  async health() {
+    const tasks = (await this.options.taskStore().list({ kind: "custom" })).filter(
+      (task) =>
+        (task.metadata?.network as { scope?: string; networkId?: string } | undefined)?.scope ===
+          "matching" &&
+        (task.metadata?.network as { networkId?: string } | undefined)?.networkId ===
+          this.options.domain.options.networkId,
+    );
+    const evidenceRows =
+      await this.options.domain.options.db.execute(`SELECT id, payload->>'at' AS at, payload->>'kind' AS kind,
+      payload#>>'{details,city}' AS city, payload#>>'{details,cadence}' AS cadence,
+      payload#>>'{details,runId}' AS run_id, payload#>'{details,report,counts,invariantViolations}' AS invariant_count
+      FROM network.events WHERE network_id=${sqlQuote(this.options.domain.options.networkId)}
+      AND payload->>'kind' IN ('matching_heartbeat','simulation_completed') ORDER BY sequence`);
+    const heartbeats = evidenceRows
+      .filter((row) => row.kind === "matching_heartbeat")
+      .map((row) => ({
+        id: String(row.id),
+        kind: "matching_heartbeat" as const,
+        at: String(row.at),
+        details: { city: row.city, cadence: row.cadence, runId: row.run_id },
+      }));
+    // Local diagnostic grace, not a PRD SLA or an authority to mutate a task.
+    const graceMs = 5 * 60_000;
+    const observedAt = this.options.clock.now().toISOString();
+    const cutoff = new Date(Date.parse(observedAt) - graceMs);
+    const recoverable = new Map(
+      (
+        await listRecoverableScheduledTaskRefs(this.options.domain.options.db.execute, {
+          updatedBeforeIso: cutoff.toISOString(),
+          kind: "custom",
+          limit: 500,
+        })
+      )
+        .filter((ref) => ref.agentId === this.options.agentId)
+        .map((ref) => [ref.taskId, ref]),
+    );
+    const alerts: Array<{
+      id: string;
+      kind: string;
+      taskId?: string;
+      city?: City;
+      cadence?: Cadence;
+      expectedAt?: string | null;
+      observedAt: string;
+      graceMs: number | null;
+      evidence: string;
+      eventId?: string;
+      count?: number;
+    }> = [];
+    for (const task of tasks) {
+      const binding = this.binding(task);
+      if (task.state.status === "failed")
+        alerts.push({
+          id: `failed:${task.taskId}`,
+          kind: "failed_matching_job",
+          taskId: task.taskId,
+          city: binding.city,
+          cadence: binding.cadence,
+          observedAt,
+          graceMs: null,
+          evidence: "Actual owned native task state is failed; no failure cause inferred.",
+        });
+      const claim = recoverable.get(task.taskId);
+      if (claim)
+        alerts.push({
+          id: `stuck:${task.taskId}`,
+          kind: "stuck_matching_claim",
+          taskId: task.taskId,
+          city: binding.city,
+          cadence: binding.cadence,
+          expectedAt: claim.firedAtIso,
+          observedAt,
+          graceMs,
+          evidence:
+            "Canonical recoverable native claim is unsettled beyond local observation grace; no cancellation or retry performed.",
+        });
+      const heartbeat = heartbeats
+        .filter(
+          (event) =>
+            event.details.city === binding.city && event.details.cadence === binding.cadence,
+        )
+        .at(-1);
+      const firedAt = task.state.firedAt;
+      if (
+        firedAt &&
+        Date.parse(firedAt) <= cutoff.getTime() &&
+        (task.state.status === "fired" ||
+          (task.metadata?.lastDispatchResult as { ok?: boolean } | undefined)?.ok === true) &&
+        (!heartbeat || Date.parse(heartbeat.at) < Date.parse(firedAt))
+      )
+        alerts.push({
+          id: `claim-heartbeat:${task.taskId}`,
+          kind: heartbeat ? "stale_matching_heartbeat" : "missing_matching_heartbeat",
+          taskId: task.taskId,
+          city: binding.city,
+          cadence: binding.cadence,
+          expectedAt: firedAt,
+          observedAt,
+          graceMs,
+          evidence:
+            "Recorded native firedAt has no owned city/cadence heartbeat at or after the claim beyond local observation grace.",
+        });
+      const due = await isScheduledTaskDue(task, { now: cutoff, ownerFacts: { timezone: "UTC" } });
+      if (due.due && (await this.eventDecision(binding, cutoff.toISOString())).kind === "allow") {
+        const initialGate =
+          binding.cadence === "events" && binding.pendingAt
+            ? await this.eventDecision(binding, binding.pendingAt)
+            : null;
+        const expectedAt =
+          initialGate?.kind === "defer" && "atIso" in initialGate.until
+            ? initialGate.until.atIso
+            : (due.occurrenceAtIso ?? null);
+        alerts.push({
+          id: `due:${task.taskId}`,
+          kind: "overdue_matching_job",
+          taskId: task.taskId,
+          city: binding.city,
+          cadence: binding.cadence,
+          expectedAt,
+          observedAt,
+          graceMs,
+          evidence:
+            "Canonical isScheduledTaskDue and the same Network matching event gate both allow at the grace cutoff.",
+        });
+        if (
+          !heartbeat ||
+          (expectedAt !== null && Date.parse(heartbeat.at) < Date.parse(expectedAt))
+        )
+          alerts.push({
+            id: `heartbeat:${task.taskId}`,
+            kind: heartbeat ? "stale_matching_heartbeat" : "missing_matching_heartbeat",
+            taskId: task.taskId,
+            city: binding.city,
+            cadence: binding.cadence,
+            expectedAt,
+            observedAt,
+            graceMs,
+            evidence:
+              "No recorded owned city/cadence heartbeat at or after this canonical expected occurrence.",
+          });
+      }
+    }
+    const observations = evidenceRows.flatMap((row) => {
+      if (
+        row.kind !== "simulation_completed" ||
+        typeof row.invariant_count !== "number" ||
+        !Number.isSafeInteger(row.invariant_count) ||
+        row.invariant_count < 0
+      )
+        return [];
+      return [
+        {
+          eventId: String(row.id),
+          runId: typeof row.run_id === "string" ? row.run_id : null,
+          at: String(row.at),
+          count: row.invariant_count,
+          source: "historical_simulation_checker" as const,
+        },
+      ];
+    });
+    for (const observation of observations)
+      if (observation.count > 0)
+        alerts.push({
+          id: `invariant:${observation.eventId}`,
+          kind: "historical_simulation_invariant_failures",
+          eventId: observation.eventId,
+          count: observation.count,
+          observedAt,
+          graceMs: null,
+          evidence:
+            "Actual retained simulation_completed checker count; historical synthetic evidence, not live invariant monitoring.",
+        });
+    return {
+      tasks: tasks.map((task) => ({
+        taskId: task.taskId,
+        binding: this.binding(task),
+        state: task.state,
+      })),
+      lastHeartbeat: Object.fromEntries(
+        cities.map((city) => [
+          city,
+          heartbeats.filter((event) => event.details.city === city).at(-1) ?? null,
+        ]),
+      ),
+      alerts,
+      observationPolicy: {
+        graceMs,
+        clock: "NetworkClock",
+        provenance:
+          "native scheduled due decision, matching event gate and native recoverable claim",
+        definition:
+          "Five-minute local diagnostic grace; not a PRD SLA. Read only, with no new job owner or task mutation.",
+      },
+      recordedInvariants: {
+        count: observations.length ? observations.reduce((sum, row) => sum + row.count, 0) : null,
+        observations,
+        qualification:
+          "Historical retained simulation checker results only. Missing evidence is unmeasured; live invariant health is not inferred.",
+      },
+    };
+  }
+}
