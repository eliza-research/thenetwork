+++ b/packages/cloud/shared/src/lib/network/coordination/disclosure.ts
@@ -0,0 +1,55 @@
+import { NetworkDomainError, type NetworkOpportunity } from "../domain/types.js";
+import type { CoordinationRecord } from "./service.js";
+
+/** A precise shared location remains subject to every original consenting seat's current revision-bound grant. */
+export function hasVenueDisclosure(opportunity: NetworkOpportunity): boolean {
+  const participants = opportunity.participants.filter(
+    (participant) =>
+      participant.acceptedAt &&
+      participant.revision === opportunity.revision &&
+      !["declined", "expired", "replaced"].includes(participant.state),
+  );
+  return (
+    participants.length >= opportunity.quorum &&
+    participants.every(
+      (participant) =>
+        participant.disclosure?.revision === opportunity.revision &&
+        participant.disclosure.preciseVenue,
+    )
+  );
+}
+
+/** Historical receipts retain original bytes; current public projections withhold a revoked location and its copied text. */
+export function projectVenue(record: CoordinationRecord, allowed: boolean): CoordinationRecord {
+  const venue = record.slot?.venue;
+  if (!venue || allowed) return record;
+  const literal = venue.trim().toLowerCase();
+  const contains = (value: string) => literal.length > 0 && value.toLowerCase().includes(literal);
+  return {
+    ...record,
+    slot: record.slot
+      ? {
+          ...record.slot,
+          venue: null,
+          area: contains(record.slot.area) ? "Location to be confirmed" : record.slot.area,
+        }
+      : null,
+    messages: record.messages.map((message) =>
+      contains(message.body)
+        ? { ...message, body: "Precise venue withheld after permission changed." }
+        : message,
+    ),
+  };
+}
+
+export function assertVenueDisclosure(
+  record: CoordinationRecord,
+  opportunity: NetworkOpportunity,
+): void {
+  if (record.slot?.venue && !hasVenueDisclosure(opportunity))
+    throw new NetworkDomainError(
+      "NETWORK_CONFLICT",
+      "The stored precise venue no longer has every participant's current permission",
+      { rule: "precise_venue_revoked" },
+    );
+}
diff --git a/packages/cloud/shared/src/lib/network/coordination/erasure.ts b/packages/cloud/shared/src/lib/network/coordination/erasure.ts
new file mode 100644
index 000000000000..d4eaf1b22bcc
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/coordination/erasure.ts
@@ -0,0 +1,55 @@
+import { type CarveOutSqlExecutor, sqlJson, sqlQuote } from "@elizaos/plugin-sql";
+import { payload } from "../domain/store.ts";
+import type { CoordinationRecord } from "./service.ts";
+
+/** Injected into canonical account deletion so logistics and content disappear in the same SQL transaction. */
+export async function purgeMemberArtifacts(
+  execute: CarveOutSqlExecutor,
+  networkId: string,
+  memberId: string,
+  opportunityIds: string[],
+): Promise<Array<{ messageId: string; recipientId: string }>> {
+  const deliveries: Array<{ messageId: string; recipientId: string }> = [];
+  const tables = await execute(
+    "SELECT to_regclass('network.coordination') AS coordination,to_regclass('network.coordination_receipts') AS receipts",
+  );
+  if (tables[0]?.coordination && opportunityIds.length) {
+    const rows = await execute(
+      `SELECT payload FROM network.coordination WHERE network_id=${sqlQuote(networkId)} AND opportunity_id IN (${opportunityIds.map(sqlQuote).join(",")}) FOR UPDATE`,
+    );
+    for (const row of rows) {
+      const record = payload<CoordinationRecord>(row);
+      for (const message of record.messages)
+        if (message.senderId === memberId)
+          for (const recipientId of message.recipientIds)
+            deliveries.push({ messageId: message.id, recipientId });
+      record.messages = record.messages
+        .filter((message) => message.senderId !== memberId)
+        .map((message) => ({
+          ...message,
+          recipientIds: message.recipientIds.filter((id) => id !== memberId),
+        }));
+      record.confirmedMemberIds = record.confirmedMemberIds.filter((id) => id !== memberId);
+      if ("contactRequestedMemberIds" in record && Array.isArray(record.contactRequestedMemberIds))
+        record.contactRequestedMemberIds = record.contactRequestedMemberIds.filter(
+          (id) => id !== memberId,
+        );
+      record.contactRequests = Object.fromEntries(
+        Object.entries(record.contactRequests ?? {}).filter(
+          ([, pair]) => !pair.memberIds.includes(memberId),
+        ),
+      );
+      record.departedMemberIds = record.departedMemberIds.filter((id) => id !== memberId);
+      delete record.late[memberId];
+      if (record.slot) record.slot = { ...record.slot, venue: null };
+      await execute(
+        `UPDATE network.coordination SET payload=${sqlJson(record)}::jsonb WHERE network_id=${sqlQuote(networkId)} AND opportunity_id=${sqlQuote(record.opportunityId)}`,
+      );
+    }
+  }
+  if (tables[0]?.receipts)
+    await execute(
+      `DELETE FROM network.coordination_receipts WHERE network_id=${sqlQuote(networkId)} AND member_ids @> ${sqlQuote(JSON.stringify([memberId]))}::jsonb`,
+    );
+  return deliveries;
+}
diff --git a/packages/cloud/shared/src/lib/network/coordination/programme.ts b/packages/cloud/shared/src/lib/network/coordination/programme.ts
new file mode 100644
index 000000000000..644d797a1dba
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/coordination/programme.ts
@@ -0,0 +1,205 @@
+import type {
+  DispatchResult,
+  GateDecision,
+  ScheduledTask,
+  ScheduledTaskDispatchRecord,
+  ScheduledTaskRunner,
+} from "@elizaos/plugin-scheduling";
+import { networkDigest } from "../digest.js";
+import { assertKnownDisclosure } from "../domain/policy.js";
+import { NetworkDomain } from "../domain/service.js";
+import { type NetworkClock, NetworkDomainError, type NetworkOpportunity } from "../domain/types.js";
+import { networkQuietHours } from "./quiet-hours.js";
+import type { NetworkLogisticsTransport } from "./scheduler.js";
+import type { CoordinationOptions } from "./service.js";
+
+interface ProgrammeTaskBinding {
+  scope: "programme";
+  networkId: string;
+  opportunityId: string;
+  opportunityRevision: number;
+  memberId: string;
+  programmeDigest: string;
+  purpose: "reminder" | "checkin" | "feedback";
+}
+function programmeDigest(opportunity: NetworkOpportunity): string {
+  return networkDigest([
+    opportunity.id,
+    opportunity.revision,
+    opportunity.city,
+    opportunity.objective,
+    opportunity.programme,
+  ]);
+}
+function programmeBinding(
+  record: Pick<ScheduledTask, "metadata"> | ScheduledTaskDispatchRecord,
+  networkId: string,
+): ProgrammeTaskBinding {
+  const input = record.metadata?.network as ProgrammeTaskBinding | undefined;
+  if (
+    !input ||
+    input.scope !== "programme" ||
+    input.networkId !== networkId ||
+    typeof input.opportunityId !== "string" ||
+    !Number.isSafeInteger(input.opportunityRevision) ||
+    typeof input.memberId !== "string" ||
+    typeof input.programmeDigest !== "string" ||
+    !["reminder", "checkin", "feedback"].includes(input.purpose)
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Invalid scoped programme task");
+  return input;
+}
+async function programmeAuthority(domain: NetworkDomain, target: ProgrammeTaskBinding) {
+  const value = await domain.getOpportunity({ type: "system" }, target.opportunityId);
+  if (
+    !("participants" in value) ||
+    value.kind !== "monthly_event" ||
+    !value.programme ||
+    value.revision !== target.opportunityRevision ||
+    programmeDigest(value) !== target.programmeDigest ||
+    value.review?.decision !== "approved" ||
+    value.review.revision !== value.revision ||
+    ["cancelled", "safety_hold", "rejected_in_review", "expired"].includes(value.state)
+  )
+    throw new NetworkDomainError("NETWORK_INELIGIBLE", "Current reviewed programme required");
+  const participation = value.participants.find((member) => member.memberId === target.memberId);
+  if (
+    !participation ||
+    participation.revision !== value.revision ||
+    !participation.acceptedAt ||
+    !(
+      target.purpose === "feedback"
+        ? ["accepted", "confirmed", "attended", "no_show"]
+        : ["accepted", "confirmed", "attended"]
+    ).includes(participation.state)
+  )
+    throw new NetworkDomainError("NETWORK_INELIGIBLE", "Independent current RSVP required");
+  const member = await domain.getMember({ type: "system" }, target.memberId);
+  if (
+    member.age !== "adult" ||
+    member.accountState !== "active" ||
+    member.safetyHold ||
+    !member.channels.some(
+      (channel) =>
+        !channel.stopped && channel.verifiedAt <= domain.options.clock.now().toISOString(),
+    )
+  )
+    throw new NetworkDomainError("NETWORK_INELIGIBLE", "Eligible programme recipient required");
+  return { programme: value, member };
+}
+
+/** RSVP logistics use the canonical scheduler without treating the audience as a mutually connected group. */
+export async function scheduleProgrammeParticipant(
+  domain: NetworkDomain,
+  runner: ScheduledTaskRunner,
+  input: { opportunityId: string; revision: number; memberId: string },
+  clock: NetworkClock,
+): Promise<ScheduledTask[]> {
+  const value = await domain.getOpportunity({ type: "system" }, input.opportunityId);
+  if (!("participants" in value) || !value.programme)
+    throw new NetworkDomainError("NETWORK_INVALID", "Programme descriptor required");
+  const base = {
+    scope: "programme" as const,
+    networkId: domain.options.networkId,
+    opportunityId: input.opportunityId,
+    opportunityRevision: input.revision,
+    memberId: input.memberId,
+    programmeDigest: programmeDigest(value),
+  };
+  await programmeAuthority(domain, { ...base, purpose: "reminder" });
+  const starts = Date.parse(value.programme.startsAt),
+    ends = Date.parse(value.programme.endsAt),
+    tasks: ScheduledTask[] = [];
+  for (const item of [
+    { purpose: "reminder" as const, at: starts - 86_400_000 },
+    { purpose: "reminder" as const, at: starts - 3_600_000 },
+    { purpose: "checkin" as const, at: starts },
+    { purpose: "feedback" as const, at: ends + 2 * 3_600_000 },
+  ]) {
+    if (item.at < clock.now().getTime()) continue;
+    const target = { ...base, purpose: item.purpose };
+    tasks.push(
+      await runner.schedule({
+        kind: "reminder",
+        trigger: { kind: "once", atIso: new Date(item.at).toISOString() },
+        priority: "medium",
+        promptInstructions: "Use the independently consented public programme binding.",
+        respectsGlobalPause: true,
+        source: "user_chat",
+        createdBy: "network",
+        ownerVisible: true,
+        metadata: { network: target },
+        shouldFire: { compose: "all", gates: [{ kind: "network_authority", params: target }] },
+        output: { destination: "channel", target: input.memberId },
+        idempotencyKey: `network:programme:${networkDigest([target, item.at])}`,
+      }),
+    );
+  }
+  return tasks;
+}
+export async function programmeTaskGate(
+  options: CoordinationOptions,
+  task: ScheduledTask,
+): Promise<GateDecision> {
+  try {
+    const target = programmeBinding(task, options.networkId),
+      domain = new NetworkDomain(options),
+      authority = await programmeAuthority(domain, target);
+    return networkQuietHours(authority.member, options.clock.now());
+  } catch (error) {
+    if (error instanceof NetworkDomainError) return { kind: "deny", reason: error.code };
+    throw error;
+  }
+}
+export async function dispatchProgrammeTask(
+  options: CoordinationOptions,
+  record: ScheduledTaskDispatchRecord,
+  transport: NetworkLogisticsTransport,
+): Promise<DispatchResult> {
+  try {
+    const target = programmeBinding(record, options.networkId),
+      domain = new NetworkDomain(options),
+      first = await programmeAuthority(domain, target);
+    const programme = first.programme.programme;
+    if (!programme) throw new NetworkDomainError("NETWORK_INVALID", "Programme descriptor missing");
+    const body =
+      target.purpose === "feedback"
+        ? "How was the city gathering? You can skip this feedback. No attendee roster is shared."
+        : target.purpose === "checkin"
+          ? `The city gathering is starting at ${programme.publicVenue.name}, ${programme.publicVenue.area}.`
+          : `Reminder: your confirmed city gathering is at ${programme.startsAt}, ${programme.publicVenue.name}, ${programme.publicVenue.area}.`;
+    assertKnownDisclosure([first.member], body);
+    const idempotencyKey = `network:programme:${record.taskId}:${target.programmeDigest}:${target.memberId}`;
+    if (record.persistPreparedDelivery) await record.persistPreparedDelivery(body, idempotencyKey);
+    return await domain.withAuthority(async (joined, db) => {
+      const current = await programmeAuthority(joined, target),
+        quiet = networkQuietHours(current.member, options.clock.now());
+      if (quiet.kind !== "allow")
+        throw new NetworkDomainError("NETWORK_INELIGIBLE", "Programme recipient quiet hours");
+      assertKnownDisclosure([current.member], body);
+      const result = await transport.send(
+        {
+          memberId: target.memberId,
+          opportunityId: target.opportunityId,
+          revision: target.opportunityRevision,
+          body,
+          purpose: target.purpose,
+          idempotencyKey,
+        },
+        { domain: joined, execute: db.execute },
+      );
+      return !result.ok && result.acceptance === undefined
+        ? { ...result, acceptance: "unknown" }
+        : result;
+    });
+  } catch (error) {
+    if (!(error instanceof NetworkDomainError)) throw error;
+    return {
+      ok: false,
+      reason: "unknown_recipient",
+      acceptance: "not_accepted",
+      userActionable: false,
+      message: error.code,
+    };
+  }
+}
diff --git a/packages/cloud/shared/src/lib/network/coordination/quiet-hours.ts b/packages/cloud/shared/src/lib/network/coordination/quiet-hours.ts
new file mode 100644
index 000000000000..33a3e92d1f6c
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/coordination/quiet-hours.ts
@@ -0,0 +1,48 @@
+import {
+  type GateDecision,
+  InvalidLocalTimeError,
+  resolveLocalHHMMToIso,
+} from "@elizaos/plugin-scheduling";
+import type { NetworkMember } from "../domain/types.js";
+
+/** Uses the scheduling owner's DST-compatible resolver for every member's own timezone. */
+export function networkQuietHours(member: NetworkMember, now: Date): GateDecision {
+  if (member.preferences.quietHours.start === member.preferences.quietHours.end)
+    return { kind: "deny", reason: "network_all_day_quiet" };
+  let start: string | null, end: string | null;
+  try {
+    start = resolveLocalHHMMToIso(
+      now,
+      member.preferences.quietHours.start,
+      member.preferences.timezone,
+    );
+    end = resolveLocalHHMMToIso(
+      now,
+      member.preferences.quietHours.end,
+      member.preferences.timezone,
+    );
+  } catch (error) {
+    if (error instanceof InvalidLocalTimeError)
+      return { kind: "deny", reason: "network_quiet_hours_invalid" };
+    throw error;
+  }
+  if (!start || !end) return { kind: "deny", reason: "network_quiet_hours_invalid" };
+  const starts = Date.parse(start),
+    ends = Date.parse(end),
+    at = now.getTime();
+  const overnight = member.preferences.quietHours.start > member.preferences.quietHours.end;
+  if (overnight ? at >= starts || at < ends : at >= starts && at < ends) {
+    const until =
+      overnight && at >= starts
+        ? resolveLocalHHMMToIso(
+            now,
+            member.preferences.quietHours.end,
+            member.preferences.timezone,
+            1,
+          )
+        : end;
+    if (!until) return { kind: "deny", reason: "network_quiet_hours_invalid" };
+    return { kind: "defer", until: { atIso: until }, reason: "network_member_quiet_hours" };
+  }
+  return { kind: "allow" };
+}
diff --git a/packages/cloud/shared/src/lib/network/coordination/scheduler.ts b/packages/cloud/shared/src/lib/network/coordination/scheduler.ts
new file mode 100644
index 000000000000..3bdc8c9750dc
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/coordination/scheduler.ts
@@ -0,0 +1,256 @@
+import { hasVenueDisclosure, projectVenue } from "./disclosure.js";
+import { dispatchProgrammeTask, programmeTaskGate } from "./programme.js";
+import { networkQuietHours } from "./quiet-hours.js";
+
+export { networkQuietHours } from "./quiet-hours.js";
+
+import {
+  type DispatchResult,
+  type ScheduledTask,
+  type ScheduledTaskDispatcher,
+  type ScheduledTaskDispatchRecord,
+  type TaskGateContribution,
+} from "@elizaos/plugin-scheduling";
+import type { CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+import { assertKnownDisclosure } from "../domain/policy.js";
+import type { NetworkDomain } from "../domain/service.js";
+import { NetworkDomainError } from "../domain/types.js";
+import { type CoordinationRecord, type NetworkCoordination } from "./service.js";
+
+export interface NetworkTaskBinding {
+  networkId: string;
+  opportunityId: string;
+  opportunityRevision: number;
+  coordinationRevision: number;
+  slotId: string;
+  memberId: string;
+  purpose: "reminder" | "checkin" | "feedback";
+}
+export interface NetworkLogisticsTransport {
+  /** Domain is joined to the already-owned transaction; do not acquire a second Network lock. */
+  send(
+    input: {
+      memberId: string;
+      opportunityId: string;
+      revision: number;
+      body: string;
+      purpose: NetworkTaskBinding["purpose"];
+      idempotencyKey: string;
+    },
+    authority: { domain: NetworkDomain; execute: CarveOutSqlExecutor },
+  ): Promise<DispatchResult>;
+}
+function logisticsMessage(
+  target: NetworkTaskBinding,
+  current: CoordinationRecord,
+  category: string,
+): string {
+  const slot = current.slot;
+  if (!slot) throw new NetworkDomainError("NETWORK_CONFLICT", "Confirmed logistics slot required");
+  return target.purpose === "feedback"
+    ? `How did your ${category} plan go? You can skip this check-in.`
+    : target.purpose === "checkin"
+      ? `Your ${category} plan is starting. Reply if you are running late or need help coordinating.`
+      : `Reminder: your ${category} plan is at ${slot.startAt} (${slot.timezone}), ${slot.area}.`;
+}
+
+function binding(
+  record: Pick<ScheduledTask, "metadata"> | ScheduledTaskDispatchRecord,
+): NetworkTaskBinding {
+  const value = record.metadata?.network as NetworkTaskBinding | undefined;
+  if (
+    !value ||
+    typeof value.networkId !== "string" ||
+    typeof value.opportunityId !== "string" ||
+    typeof value.memberId !== "string" ||
+    !Number.isSafeInteger(value.opportunityRevision) ||
+    !Number.isSafeInteger(value.coordinationRevision) ||
+    typeof value.slotId !== "string" ||
+    !["reminder", "checkin", "feedback"].includes(value.purpose)
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Invalid typed Network scheduler binding");
+  return value;
+}
+
+export function networkAuthorityGate(coordination: NetworkCoordination): TaskGateContribution {
+  return {
+    kind: "network_authority",
+    async evaluate(task) {
+      if ((task.metadata?.network as { scope?: string } | undefined)?.scope === "programme")
+        return programmeTaskGate(coordination.options, task);
+      try {
+        const target = binding(task);
+        if (target.networkId !== coordination.options.networkId)
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "Foreign Network task binding");
+        return await coordination.withAuthority(
+          target.opportunityId,
+          target.opportunityRevision,
+          async (_domain, record, opportunity, members) => {
+            const member = members.find((candidate) => candidate.memberId === target.memberId);
+            if (
+              !member ||
+              !member.channels.some(
+                (channel) =>
+                  !channel.stopped &&
+                  channel.verifiedAt <= coordination.options.clock.now().toISOString(),
+              ) ||
+              record.departedMemberIds.includes(target.memberId) ||
+              record.revision !== target.coordinationRevision ||
+              record.slot?.id !== target.slotId ||
+              !record.confirmedMemberIds.includes(target.memberId)
+            )
+              return { kind: "deny", reason: "network_current_slot_and_member_required" };
+            if (
+              target.purpose === "feedback"
+                ? !["scheduled", "in_progress", "completed", "feedback_collected"].includes(
+                    opportunity.state,
+                  )
+                : !["scheduled", "in_progress"].includes(opportunity.state)
+            )
+              return { kind: "deny", reason: "network_task_state_changed" };
+            return networkQuietHours(member, coordination.options.clock.now());
+          },
+          target.purpose === "feedback" ? "feedback" : "logistics",
+        );
+      } catch (error) {
+        if (error instanceof NetworkDomainError) return { kind: "deny", reason: error.code };
+        throw error;
+      }
+    },
+  };
+}
+
+/** Revalidates under the owner's lock immediately through the send, beyond the earlier runner gate. */
+export function networkReminderDispatcher(
+  coordination: NetworkCoordination,
+  transport: NetworkLogisticsTransport,
+): ScheduledTaskDispatcher {
+  return {
+    async dispatch(record) {
+      if ((record.metadata?.network as { scope?: string } | undefined)?.scope === "programme")
+        return dispatchProgrammeTask(coordination.options, record, transport);
+      try {
+        const target = binding(record);
+        if (target.networkId !== coordination.options.networkId)
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "Foreign Network task binding");
+        const idempotencyKey = `network:logistics:${record.taskId}:${target.slotId}:${target.memberId}`;
+        const preparedBody = await coordination.withAuthority(
+          target.opportunityId,
+          target.opportunityRevision,
+          async (_domain, current, opportunity, members) => {
+            if (
+              current.revision !== target.coordinationRevision ||
+              current.slot?.id !== target.slotId ||
+              !members.some((member) => member.memberId === target.memberId)
+            )
+              throw new NetworkDomainError(
+                "NETWORK_INELIGIBLE",
+                "Prepared logistics binding changed",
+              );
+            const body = logisticsMessage(
+              target,
+              projectVenue(current, hasVenueDisclosure(opportunity)),
+              opportunity.category,
+            );
+            assertKnownDisclosure(members, body);
+            return body;
+          },
+          target.purpose === "feedback" ? "feedback" : "logistics",
+        );
+        // Scheduler CAS preparation is a separate owner write. Finish it before acquiring
+        // the Network effect lock; calling its outer connection inside PGlite's tx deadlocks.
+        if (record.persistPreparedDelivery)
+          await record.persistPreparedDelivery(preparedBody, idempotencyKey);
+        return await coordination.withAuthority(
+          target.opportunityId,
+          target.opportunityRevision,
+          async (domain, current, opportunity, members, execute) => {
+            const member = members.find((candidate) => candidate.memberId === target.memberId);
+            if (
+              !member ||
+              !member.channels.some(
+                (channel) =>
+                  !channel.stopped &&
+                  channel.verifiedAt <= coordination.options.clock.now().toISOString(),
+              ) ||
+              current.departedMemberIds.includes(target.memberId) ||
+              current.revision !== target.coordinationRevision ||
+              current.slot?.id !== target.slotId ||
+              !members.every((candidate) => current.confirmedMemberIds.includes(candidate.memberId))
+            )
+              throw new NetworkDomainError(
+                "NETWORK_INELIGIBLE",
+                "Reminder authority was revoked or rescheduled",
+              );
+            if (
+              target.purpose === "feedback"
+                ? !["scheduled", "in_progress", "completed", "feedback_collected"].includes(
+                    opportunity.state,
+                  )
+                : !["scheduled", "in_progress"].includes(opportunity.state)
+            )
+              throw new NetworkDomainError(
+                "NETWORK_INELIGIBLE",
+                "Logistics state changed before dispatch",
+              );
+            const quiet = networkQuietHours(member, coordination.options.clock.now());
+            if (quiet.kind === "deny")
+              throw new NetworkDomainError("NETWORK_INELIGIBLE", quiet.reason);
+            if (quiet.kind === "defer")
+              return {
+                ok: false,
+                reason: "rate_limited",
+                acceptance: "not_accepted",
+                retryAfterMinutes:
+                  "atIso" in quiet.until
+                    ? Math.max(
+                        1,
+                        (Date.parse(quiet.until.atIso) -
+                          coordination.options.clock.now().getTime()) /
+                          60_000,
+                      )
+                    : quiet.until.offsetMinutes,
+                userActionable: false,
+              };
+            const body = logisticsMessage(
+              target,
+              projectVenue(current, hasVenueDisclosure(opportunity)),
+              opportunity.category,
+            );
+            assertKnownDisclosure(members, body);
+            if (body !== preparedBody)
+              throw new NetworkDomainError(
