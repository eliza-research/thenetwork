+import { expect, it } from "vitest";
+import { compareMatchingRuns } from "./comparison.ts";
+import { buildMatchingRun } from "./engine.ts";
+import { testInput } from "./test-fixtures.ts";
+
+it("compares retained data independently of execution ID, seed, settings revision and configuration", async () => {
+  const input = testInput(6);
+  const first = await buildMatchingRun(input);
+  const second = await buildMatchingRun(
+    { ...input, runId: "different-run", seed: input.seed + 1, settingsRevision: 7 },
+    {
+      config: {
+        ...first.config,
+        version: "comparison-fixture",
+        defaultThreshold: first.config.defaultThreshold + 0.1,
+      },
+    },
+  );
+  expect(compareMatchingRuns(first, second)).toMatchObject({
+    sameSnapshot: true,
+    sameSeed: false,
+    sameConfiguration: false,
+    sameSettingsRevision: false,
+    sameModels: true,
+  });
+  const changed = await buildMatchingRun({ ...input, now: input.now + 1 });
+  expect(compareMatchingRuns(first, changed).sameSnapshot).toBe(false);
+});
+
+it("reports semantic proposal and component changes without fabricating a judge result", async () => {
+  const first = await buildMatchingRun(testInput(6));
+  expect(first.proposals.length).toBeGreaterThan(0);
+  const second = structuredClone(first);
+  second.runId = "second";
+  second.replayInput.runId = "second";
+  for (const proposal of second.proposals) {
+    proposal.id = "second:" + proposal.id;
+    proposal.runId = "second";
+  }
+  expect(compareMatchingRuns(first, second).proposalChanges).toEqual([]);
+  second.proposals[0]!.score += 0.25;
+  second.proposals[0]!.components.fit += 0.1;
+  expect(compareMatchingRuns(first, second).proposalChanges[0]).toMatchObject({
+    change: "score_or_exploration",
+    scoreDelta: expect.closeTo(0.25),
+    componentDelta: { fit: expect.closeTo(0.1) },
+  });
+  expect(compareMatchingRuns(first, second).countsDelta.judgeCalls).toBe(0);
+  second.proposals.shift();
+  expect(compareMatchingRuns(first, second).proposalChanges[0]?.change).toBe("removed");
+});
diff --git a/packages/cloud/shared/src/lib/network/matching/comparison.ts b/packages/cloud/shared/src/lib/network/matching/comparison.ts
new file mode 100644
index 000000000000..d08fee824129
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/comparison.ts
@@ -0,0 +1,75 @@
+import { networkDigest } from "../digest.ts";
+import type { MatchingInput, MatchingRun, MatchProposal } from "./types.ts";
+
+function snapshotDigest(input: MatchingInput) {
+  const {
+    runId: _run,
+    seed: _seed,
+    modelVersions: _models,
+    settingsRevision: _revision,
+    ...data
+  } = input;
+  return networkDigest(data);
+}
+
+function proposalKey(proposal: MatchProposal) {
+  return networkDigest([
+    proposal.generator,
+    proposal.category,
+    [...proposal.participantIds].sort(),
+    proposal.anchorId,
+  ]);
+}
+
+/** Execution identity and configuration are reported separately from the retained matching data. */
+export function compareMatchingRuns(first: MatchingRun, second: MatchingRun) {
+  const before = new Map(first.proposals.map((proposal) => [proposalKey(proposal), proposal]));
+  const after = new Map(second.proposals.map((proposal) => [proposalKey(proposal), proposal]));
+  const sameSnapshot = snapshotDigest(first.replayInput) === snapshotDigest(second.replayInput);
+  return {
+    sameSnapshot,
+    sameConfiguration: networkDigest(first.config) === networkDigest(second.config),
+    sameModels:
+      networkDigest(first.replayInput.modelVersions) ===
+      networkDigest(second.replayInput.modelVersions),
+    sameSeed: first.replayInput.seed === second.replayInput.seed,
+    sameSettingsRevision:
+      first.replayInput.settingsRevision === second.replayInput.settingsRevision,
+    countsDelta: {
+      candidates: second.candidateCount - first.candidateCount,
+      selected: second.proposals.length - first.proposals.length,
+      rejected: second.rejected.length - first.rejected.length,
+      judgeCalls: second.judgeCalls - first.judgeCalls,
+      judgeCacheHits: second.judgeCacheHits - first.judgeCacheHits,
+    },
+    proposalChanges: [...new Set([...before.keys(), ...after.keys()])].sort().flatMap((key) => {
+      const previous = before.get(key),
+        current = after.get(key);
+      if (!previous || !current)
+        return [{ key, change: previous ? "removed" : "added", proposal: previous ?? current }];
+      if (
+        networkDigest([previous.components, previous.score, previous.exploration]) ===
+        networkDigest([current.components, current.score, current.exploration])
+      )
+        return [];
+      return [
+        {
+          key,
+          change: "score_or_exploration",
+          proposal: current,
+          previousScore: previous.score,
+          scoreDelta: current.score - previous.score,
+          componentDelta: Object.fromEntries(
+            Object.entries(current.components).map(([name, value]) => [
+              name,
+              value - previous.components[name as keyof typeof previous.components],
+            ]),
+          ),
+        },
+      ];
+    }),
+    qualification: sameSnapshot
+      ? "The retained matching inputs match. Configuration, model and seed differences are shown separately; synthetic results do not establish product value."
+      : "The retained matching inputs differ. These differences do not establish an engine-version effect.",
+  };
+}
diff --git a/packages/cloud/shared/src/lib/network/matching/config.ts b/packages/cloud/shared/src/lib/network/matching/config.ts
new file mode 100644
index 000000000000..8a6a193b5c7c
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/config.ts
@@ -0,0 +1,138 @@
+import type { MatchingConfig, MatchingInput } from "./types.js";
+
+const DAY = 86_400_000;
+export const DEFAULT_MATCHING_CONFIG: MatchingConfig = {
+  version: "network-v1-local-1",
+  categoryThresholds: {},
+  defaultThreshold: 1.15,
+  fitFloor: 0.35,
+  mutualBenefitFloor: 0.25,
+  confidenceFloor: 0.4,
+  pairFloor: 0.25,
+  pairCooldownMs: 7 * DAY,
+  categoryCooldownMs: 2 * DAY,
+  maxProposals: 30,
+  maxCandidatesPerMember: 50,
+  exposureReserveFraction: 0.25,
+  groupBeamWidth: 8,
+  judgeFinalists: 3,
+  judgeCacheTtlMs: DAY,
+  allowedCategories: [
+    "activity",
+    "music",
+    "sport",
+    "learning",
+    "help",
+    "social",
+    "culture",
+    "romance",
+    "growth",
+    "support",
+    "care",
+    "companionship",
+  ],
+  weights: {
+    fit: 1,
+    mutualBenefit: 0.8,
+    warmPath: 0.3,
+    novelty: 0.2,
+    timingFit: 0.4,
+    activationCost: 0.3,
+    interruptionCost: 0.4,
+    load: 0.5,
+    repetition: 0.3,
+    socialRisk: 0.3,
+  },
+};
+
+export function validateConfig(input: MatchingInput, config: MatchingConfig): void {
+  if (input.constraints) {
+    const ids = new Set(input.members.map((member) => member.memberId));
+    if (
+      (input.constraints.participants !== undefined &&
+        (!Number.isSafeInteger(input.constraints.participants) ||
+          input.constraints.participants < 1 ||
+          input.constraints.participants > 6)) ||
+      [
+        ...(input.constraints.excludeMemberIds ?? []),
+        ...(input.constraints.requireMemberIds ?? []),
+      ].some((id) => !ids.has(id)) ||
+      input.constraints.requireMemberIds?.some((id) =>
+        input.constraints?.excludeMemberIds?.includes(id),
+      )
+    )
+      throw new Error("Invalid deterministic re-roll constraints");
+  }
+  if (
+    !input.runId ||
+    !input.city ||
+    !Number.isFinite(input.now) ||
+    !Number.isSafeInteger(input.seed)
+  )
+    throw new Error("Invalid matching run identity, time or seed");
+  for (const member of input.members) {
+    if (
+      [member.givingLoad, member.recentExposure, member.unansweredProposals].some(
+        (value) => !Number.isFinite(value) || value < 0,
+      ) ||
+      !Number.isFinite(member.joinedAt) ||
+      !Number.isFinite(member.maxTravelMinutes) ||
+      member.maxTravelMinutes < 0 ||
+      !Number.isFinite(member.explorationFraction) ||
+      member.explorationFraction < 0 ||
+      member.explorationFraction > 0.15 ||
+      member.facts.some(
+        (fact) =>
+          !Number.isFinite(fact.confidence) ||
+          fact.confidence < 0 ||
+          fact.confidence > 1 ||
+          !Number.isFinite(fact.confirmedAt),
+      )
+    )
+      throw new Error("Invalid member score, confidence or exploration projection");
+    if (
+      !member.memberId ||
+      !Number.isSafeInteger(member.profileRevision) ||
+      member.profileRevision < 1
+    )
+      throw new Error("Invalid member identity or revision");
+    if (
+      member.budgets.some(
+        (budget) =>
+          !Number.isFinite(budget.windowMs) ||
+          budget.windowMs <= 0 ||
+          !Number.isSafeInteger(budget.max) ||
+          budget.max < 0,
+      )
+    )
+      throw new Error("Invalid member budget");
+  }
+  const bounded = [
+    config.fitFloor,
+    config.mutualBenefitFloor,
+    config.confidenceFloor,
+    config.pairFloor,
+    config.exposureReserveFraction,
+  ];
+  if (
+    bounded.some((value) => !Number.isFinite(value) || value < 0 || value > 1) ||
+    (config.explorationFraction !== undefined &&
+      (!Number.isFinite(config.explorationFraction) ||
+        config.explorationFraction < 0 ||
+        config.explorationFraction > 0.15)) ||
+    (config.disabledCategories !== undefined &&
+      (!Array.isArray(config.disabledCategories) ||
+        config.disabledCategories.some(
+          (category) => typeof category !== "string" || !category.trim(),
+        ))) ||
+    !Number.isSafeInteger(config.maxCandidatesPerMember) ||
+    config.maxCandidatesPerMember < 1 ||
+    !Number.isSafeInteger(config.maxProposals) ||
+    config.maxProposals < 0 ||
+    Object.values(config.weights).some((weight) => !Number.isFinite(weight) || weight < 0) ||
+    [config.defaultThreshold, ...Object.values(config.categoryThresholds)].some(
+      (threshold) => !Number.isFinite(threshold),
+    )
+  )
+    throw new Error("Invalid matching configuration");
+}
diff --git a/packages/cloud/shared/src/lib/network/matching/domain-projection.ts b/packages/cloud/shared/src/lib/network/matching/domain-projection.ts
