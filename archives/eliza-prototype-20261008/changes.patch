new file mode 100644
index 000000000000..255c053a62f2
--- /dev/null
+++ b/packages/cloud/scripts/network-data-export.ts
@@ -0,0 +1,349 @@
+/** Native local host only. DuckDB never enters the portable cloud/Worker graph. */
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type DuckDBConnection, DuckDBInstance } from "@duckdb/node-api";
+import { sqlQuote } from "@elizaos/plugin-sql";
+import {
+  deletePrivateMediaFile,
+  persistPrivateMediaBytes,
+  readPrivateMediaBytes,
+} from "../../agent/src/api/media-store.ts";
+import { NetworkDomainError } from "../shared/src/lib/network/domain/types.ts";
+import {
+  NETWORK_EXPORT_SCHEMA_VERSION,
+  NETWORK_NOTEBOOKS,
+  type NetworkExportArtifact,
+  type NetworkExportSnapshot,
+  type NetworkExportWriter,
+} from "../shared/src/lib/network/workbench/data-export.ts";
+
+const COLUMNS = {
+  record_type: "VARCHAR",
+  network_id: "VARCHAR",
+  source_sequence: "BIGINT",
+  exported_at: "VARCHAR",
+  member_id: "VARCHAR",
+  opportunity_id: "VARCHAR",
+  city: "VARCHAR",
+  kind: "VARCHAR",
+  category: "VARCHAR",
+  state: "VARCHAR",
+  revision: "INTEGER",
+  created_at: "VARCHAR",
+  updated_at: "VARCHAR",
+  invitations: "INTEGER",
+  consecutive_unanswered: "INTEGER",
+  review_label: "VARCHAR",
+  review_at: "VARCHAR",
+  snapshot_section: "VARCHAR",
+  snapshot_index: "INTEGER",
+  snapshot_part: "INTEGER",
+  snapshot_json: "VARCHAR",
+};
+
+async function withParquet<T>(
+  artifact: NetworkExportArtifact,
+  work: (connection: DuckDBConnection) => Promise<T>,
+): Promise<T> {
+  const directory = await mkdtemp(join(tmpdir(), "network-parquet-read-"));
+  const instance = await DuckDBInstance.create(":memory:", {
+    threads: "1",
+    memory_limit: "256MB",
+    preserve_insertion_order: "false",
+    autoload_known_extensions: "false",
+    autoinstall_known_extensions: "false",
+  });
+  const connection = await instance.connect();
+  try {
+    const bytes = readPrivateMediaBytes(artifact.fileName);
+    if (!bytes)
+      throw new NetworkDomainError(
+        "NETWORK_NOT_FOUND",
+        "Retained Parquet artifact is unavailable",
+      );
+    const path = join(directory, "snapshot.parquet");
+    await writeFile(path, bytes, { mode: 0o600 });
+    await connection.run(
+      `CREATE VIEW network_snapshot AS SELECT * FROM read_parquet(${sqlQuote(path)})`,
+    );
+    return await work(connection);
+  } finally {
+    connection.closeSync();
+    instance.closeSync();
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+
+function networkNotebook(
+  exportId: string,
+  definition: (typeof NETWORK_NOTEBOOKS)[keyof typeof NETWORK_NOTEBOOKS],
+) {
+  return {
+    nbformat: 4,
+    nbformat_minor: 5,
+    metadata: {
+      kernelspec: {
+        display_name: "Python 3",
+        language: "python",
+        name: "python3",
+      },
+      network: {
+        exportId,
+        schemaVersion: NETWORK_EXPORT_SCHEMA_VERSION,
+        source: "scrubbed_local_parquet",
+        definitionVersion: 1,
+        sql: definition.sql,
+      },
+    },
+    cells: [
+      {
+        cell_type: "markdown",
+        metadata: {},
+        source: [
+          `# ${definition.title}\n`,
+          "Download this notebook and its corresponding Parquet file into the same directory. Run with Python and the DuckDB package installed. These cells query that retained scrubbed export; no primary database connection is used.\n",
+        ],
+      },
+      {
+        cell_type: "code",
+        metadata: {},
+        execution_count: null,
+        outputs: [],
+        source: [
+          "import duckdb\n",
+          "from pathlib import Path\n",
+          `snapshot = Path(${JSON.stringify(`network-snapshot-${exportId}.parquet`)})\n`,
+          "assert snapshot.is_file(), 'Download the matching scrubbed Parquet export first'\n",
+          "connection = duckdb.connect(':memory:')\n",
+          "connection.read_parquet(str(snapshot)).create_view('network_snapshot')\n",
+          `connection.sql(${JSON.stringify(definition.sql)}).show()\n`,
+        ],
+      },
+    ],
+  };
+}
+
+/** Private capability lifecycle remains owned by the existing media store. */
+export const localNetworkExportWriter: NetworkExportWriter = {
+  async write(rows, exportId) {
+    const directory = await mkdtemp(join(tmpdir(), "network-parquet-"));
+    const instance = await DuckDBInstance.create(":memory:", {
+      threads: "1",
+      memory_limit: "256MB",
+      preserve_insertion_order: "false",
+      autoload_known_extensions: "false",
+      autoinstall_known_extensions: "false",
+    });
+    const connection = await instance.connect();
+    const artifacts: NetworkExportArtifact[] = [];
+    try {
+      const inputPath = join(directory, "scrubbed.json");
+      const parquetPath = join(directory, "snapshot.parquet");
+      await writeFile(inputPath, JSON.stringify(rows), { mode: 0o600 });
+      await connection.run(
+        `COPY (SELECT * FROM read_json(${sqlQuote(inputPath)}, columns={${Object.entries(
+          COLUMNS,
+        )
+          .map(([name, type]) => `${sqlQuote(name)}:${sqlQuote(type)}`)
+          .join(
+            ",",
+          )}}, format='array')) TO ${sqlQuote(parquetPath)} (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE_BYTES '8MB')`,
+      );
+      const bytes = await readFile(parquetPath);
+      if (
+        bytes.subarray(0, 4).toString() !== "PAR1" ||
+        bytes.subarray(-4).toString() !== "PAR1"
+      )
+        throw new NetworkDomainError(
+          "NETWORK_INVALID",
+          "DuckDB did not produce a complete Parquet file",
+        );
+      const parquet = persistPrivateMediaBytes(
+        bytes,
+        "application/vnd.apache.parquet",
+      );
+      artifacts.push(parquet);
+      const notebooks = {} as Record<
+        keyof typeof NETWORK_NOTEBOOKS,
+        NetworkExportArtifact
+      >;
+      for (const [name, definition] of Object.entries(NETWORK_NOTEBOOKS)) {
+        notebooks[name as keyof typeof NETWORK_NOTEBOOKS] =
+          persistPrivateMediaBytes(
+            Buffer.from(
+              JSON.stringify(networkNotebook(exportId, definition), null, 2),
+            ),
+            "application/json",
+          );
+        artifacts.push(notebooks[name as keyof typeof NETWORK_NOTEBOOKS]);
+      }
+      return { parquet, notebooks };
+    } catch (error) {
+      for (const artifact of artifacts)
+        deletePrivateMediaFile(artifact.fileName);
+      throw error;
+    } finally {
+      connection.closeSync();
+      instance.closeSync();
+      await rm(directory, { recursive: true, force: true });
+    }
+  },
+  async query(artifact, notebook) {
+    const definitionBytes = readPrivateMediaBytes(notebook.fileName);
+    if (!definitionBytes)
+      throw new NetworkDomainError(
+        "NETWORK_NOT_FOUND",
+        "Retained notebook definition is unavailable",
+      );
+    const definition = JSON.parse(definitionBytes.toString()) as {
+      metadata?: { network?: { definitionVersion?: number; sql?: string } };
+    };
+    const sql = definition.metadata?.network?.sql;
+    if (
+      typeof sql !== "string" ||
+      definition.metadata?.network?.definitionVersion !== 1 ||
+      !Object.values(NETWORK_NOTEBOOKS).some((notebook) => notebook.sql === sql)
+    )
+      throw new NetworkDomainError(
+        "NETWORK_INVALID",
+        "Retained notebook requires a supported bounded SQL definition",
+      );
+    return withParquet(artifact, async (connection) => ({
+      sql,
+      rows: (await connection.runAndReadAll(sql)).getRowObjectsJson(),
+    }));
+  },
+  async readSnapshot(artifact) {
+    return withParquet(artifact, async (connection) => {
+      const manifests = (
+        await connection.runAndReadAll(
+          "SELECT snapshot_json FROM network_snapshot WHERE record_type='snapshot_manifest'",
+        )
+      ).getRowObjectsJson();
+      if (
+        manifests.length !== 1 ||
+        typeof manifests[0]?.snapshot_json !== "string"
+      )
+        throw new NetworkDomainError(
+          "NETWORK_INVALID",
+          "One complete versioned snapshot manifest is required",
+        );
+      const manifest = JSON.parse(manifests[0].snapshot_json) as {
+        version?: number;
+        sections?: Record<string, { array: boolean; count: number }>;
+      };
+      if (
+        manifest.version !== NETWORK_EXPORT_SCHEMA_VERSION ||
+        !manifest.sections ||
+        typeof manifest.sections !== "object"
+      )
+        throw new NetworkDomainError(
+          "NETWORK_INVALID",
+          "Retained analytics snapshot format is unsupported",
+        );
+      const rows = (
+        await connection.runAndReadAll(
+          "SELECT snapshot_section,snapshot_index,snapshot_part,snapshot_json FROM network_snapshot WHERE record_type='snapshot' ORDER BY snapshot_section,snapshot_index,snapshot_part",
+        )
+      ).getRowObjectsJson();
+      const groups = new Map<string, Map<number, string[]>>();
+      for (const row of rows) {
+        const section = row.snapshot_section,
+          index = row.snapshot_index,
+          part = row.snapshot_part,
+          text = row.snapshot_json;
+        if (
+          typeof section !== "string" ||
+          !Object.hasOwn(manifest.sections, section) ||
+          typeof index !== "number" ||
+          !Number.isSafeInteger(index) ||
+          index < 0 ||
+          typeof part !== "number" ||
+          !Number.isSafeInteger(part) ||
+          part < 0 ||
+          typeof text !== "string"
+        )
+          throw new NetworkDomainError(
+            "NETWORK_INVALID",
+            "Invalid snapshot record part",
+          );
+        const records = groups.get(section) ?? new Map<number, string[]>();
+        groups.set(section, records);
+        const parts = records.get(index) ?? [];
+        if (part !== parts.length)
+          throw new NetworkDomainError(
+            "NETWORK_INVALID",
+            "Snapshot record parts are incomplete or duplicated",
+          );
+        parts.push(text);
+        records.set(index, parts);
+      }
+      const snapshot: Record<string, unknown> = {},
+        content: Record<string, unknown> = {};
+      for (const [section, spec] of Object.entries(manifest.sections)) {
+        const records = groups.get(section) ?? new Map<number, string[]>();
+        if (
+          !spec ||
+          typeof spec.array !== "boolean" ||
+          !Number.isSafeInteger(spec.count) ||
+          spec.count < 0 ||
+          (!spec.array && spec.count !== 1) ||
+          records.size !== spec.count
+        )
+          throw new NetworkDomainError(
+            "NETWORK_INVALID",
+            "Snapshot manifest record count does not match retained parts",
+          );
+        const values = [];
+        for (let index = 0; index < spec.count; index++) {
+          const parts = records.get(index);
+          if (!parts)
+            throw new NetworkDomainError(
+              "NETWORK_INVALID",
+              "Snapshot record indices are incomplete",
+            );
+          values.push(JSON.parse(parts.join("")));
+        }
+        const value = spec.array ? values : values[0];
+        if (section === "edges")
+          Object.defineProperty(content, "edges", { enumerable: true, value });
+        else if (section.startsWith("snapshot.") && section.length > 9)
+          Object.defineProperty(snapshot, section.slice(9), {
+            enumerable: true,
+            value,
+          });
+        else
+          throw new NetworkDomainError(
+            "NETWORK_INVALID",
+            "Unknown snapshot manifest section",
+          );
+      }
+      if (
+        !Array.isArray(snapshot.members) ||
+        !Array.isArray(snapshot.events) ||
+        !Array.isArray(content.edges)
+      )
+        throw new NetworkDomainError(
+          "NETWORK_INVALID",
+          "Retained analytics snapshot is incomplete",
+        );
+      return {
+        snapshot: snapshot as unknown as NetworkExportSnapshot["snapshot"],
+        edges: content.edges as NetworkExportSnapshot["edges"],
+      };
+    });
+  },
+  async read(artifact) {
+    const bytes = readPrivateMediaBytes(artifact.fileName);
+    if (!bytes)
+      throw new NetworkDomainError(
+        "NETWORK_NOT_FOUND",
+        "Private export artifact is unavailable",
+      );
+    return bytes;
+  },
+  async remove(artifact) {
+    deletePrivateMediaFile(artifact.fileName);
+  },
+};
