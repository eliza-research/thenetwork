+          ) : loading ? (
+            <div className="nw-loading" role="status">
+              <span className="nw-loading-line" />
+              Loading the latest records…
+            </div>
+          ) : mode === "member" ? (
+            section ? (
+              <>
+                {member && section.id === "conversation" && (
+                  <NetworkConversation
+                    key={fixtureId}
+                    transport={transport}
+                    onChange={() => setRevision((current) => current + 1)}
+                  />
