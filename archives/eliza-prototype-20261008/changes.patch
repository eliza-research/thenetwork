+import { mkdir, writeFile } from "node:fs/promises";
+import { describe, expect, it } from "vitest";
+import { testOutputPath } from "../../../../../../../packages/scripts/lib/test-output.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { SimClock } from "./fixtures.js";
+import { runNetworkSimulation } from "./simulator.js";
+
+describe("production-path deterministic Network world", () => {
+  it("runs real domain, matching, SQL scheduler and approval queue through mock provider receipts", async () => {
+    const full = process.env.NETWORK_SIM_FULL === "1",
+      load = process.env.NETWORK_SIM_LOAD === "1",
+      count = load ? 2000 : full ? 300 : 100,
+      days = load ? 30 : full ? 60 : process.env.NETWORK_SIM_M2 === "1" ? 14 : 2;
+    const seed = 20261005,
+      networkId = `simulation:${seed}:${count}:${days}`;
+    let firstDigest: string | undefined;
+    for (let replicate = 0; replicate < (full || load ? 1 : 2); replicate++) {
+      const clock = new SimClock(Date.parse("2026-10-05T18:00:00.000Z"));
+      const host = await createLocalNetworkHost({ dataDir: "memory://", networkId, clock });
+      const { domain, coordination, transport: mock, db, native } = host;
+      try {
+        const report = await runNetworkSimulation({
+          domain,
+          coordination,
+          clock,
+          transport: {
+            ingress: domain.command.bind(domain),
+            sendInvitation: mock.sendInvitation.bind(mock),
+            messages: mock.messages.bind(mock),
+          },
+          seed,
+          personaCount: count,
+          days,
+          drainDue: host.drainDue,
+          graphEdges: (memberIds) => native.graphEdges(db.execute, memberIds),
+          progress:
+            full || load
+              ? (progress) => {
+                  if (progress.day % 5 === 0) process.stdout.write(`${JSON.stringify(progress)}\n`);
+                }
+              : undefined,
+        });
+        const directory = testOutputPath("network-engine");
+        await mkdir(directory, { recursive: true });
+        await writeFile(
+          testOutputPath(
+            "network-engine",
+            `world-${count}-${days}${replicate ? "-replay" : ""}.json`,
+          ),
+          JSON.stringify(report, null, 2),
+        );
+        if (firstDigest) expect(report.runDigest).toBe(firstDigest);
+        else firstDigest = report.runDigest;
+        expect(report.counts.proposals).toBeGreaterThan(0);
+        expect(report.counts.sent).toBeGreaterThan(0);
+        expect(report.counts.completed).toBeGreaterThan(0);
+        expect(report.counts.scheduledJobsDrained).toBeGreaterThan(0);
+        expect(report.counts.canaryLeaks).toBe(0);
+        expect(report.counts.invariantViolations).toBe(0);
+        expect(report.qualification.llmJudge).toBe("unrun");
+        expect(report.qualification.productValue).toBe("unverified");
+        expect(report.matchingRuns).toHaveLength(days * 2);
+      } finally {
+        await host.close();
+      }
+    }
+  }, 3_600_000);
+});
diff --git a/packages/cloud/shared/src/lib/network/evaluation/simulator.ts b/packages/cloud/shared/src/lib/network/evaluation/simulator.ts
new file mode 100644
index 000000000000..e9aa77c98263
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/evaluation/simulator.ts
@@ -0,0 +1,626 @@
+import type { DispatchResult } from "@elizaos/plugin-scheduling";
+import { acceptedParticipantIds, type NetworkCoordination } from "../coordination/service.js";
+import { networkDigest } from "../digest.js";
+import type { NetworkDomain } from "../domain/service.js";
+import {
+  type City,
+  type NetworkActor,
+  type NetworkCommand,
+  NetworkDomainError,
+  type NetworkOpportunity,
+} from "../domain/types.js";
+import { matchNetwork } from "../matching/domain-projection.js";
+import { candidateEligibility, DEFAULT_MATCHING_CONFIG } from "../matching/engine.js";
+import type { MatchingConfig, MatchingInput, MatchingRun } from "../matching/types.js";
+import {
+  nativePersonaDraw,
+  SimClock,
+  type SyntheticPersona,
+  seededRandom,
+  seedSimulationMembers,
+} from "./fixtures.js";
+import { type NetworkMetricObservation, summarizeNetworkMetrics } from "./metrics.js";
+
+export interface SimulationTransport {
+  /** Use the host's authenticated mock webhook/action admission, with the real domain command path. */
+  ingress(actor: NetworkActor, command: NetworkCommand): Promise<unknown>;
+  coordination?: Pick<NetworkCoordination, "proposeSlot" | "confirmSlot" | "cancel">;
+  nativeTurns?: () => number;
+  /** Newly committed native Clock runs; present only when Clock is the sole matching producer. */
+  readMatchingRuns?: (all?: boolean) => Promise<MatchingRun[]>;
+  /** Must exercise the host's real reviewed outbound admission; never fabricate an accepted receipt. */
+  sendInvitation(opportunityId: string, memberId: string): Promise<DispatchResult>;
+  messages(): Promise<
+    Array<{
+      direction: "inbound" | "outbound";
+      memberId: string;
+      body: string;
+      idempotencyKey: string;
+      acceptedAt: string;
+    }>
+  >;
+}
+export interface NetworkSimulationOptions {
+  domain: NetworkDomain;
+  coordination: NetworkCoordination;
+  clock: SimClock;
+  transport: SimulationTransport;
+  seed: number;
+  personaCount: number;
+  days: number;
+  personaMix?: Partial<Record<SyntheticPersona["kind"], number>>;
+  advanceTo?: (instant: string | number) => Promise<void>;
+  config?: MatchingConfig;
+  drainDue?: () => Promise<number>;
+  graphEdges: (memberIds: string[]) => Promise<MatchingInput["edges"]>;
+  progress?: (input: {
+    day: number;
+    totalDays: number;
+    proposals: number;
+    completed: number;
+  }) => void | Promise<void>;
+}
+export interface NetworkSimulationReport {
+  seed: number;
+  personaCount: number;
+  days: number;
+  runDigest: string;
+  startAt: string;
+  endAt: string;
+  matchingRuns: MatchingRun[];
+  outbound: Awaited<ReturnType<SimulationTransport["messages"]>>;
+  observations: NetworkMetricObservation[];
+  counts: {
+    proposals: number;
+    sent: number;
+    accepted: number;
+    completed: number;
+    closedWorkflows: number;
+    declines: number;
+    ignored: number;
+    noShows: number;
+    privacyCanariesSeeded: number;
+    canaryLeaks: number;
+    invariantViolations: number;
+    scheduledJobsDrained: number;
+    coordinationConflicts: number;
+    sourceErasedMatchingRuns: number;
+  };
+  metrics: ReturnType<typeof summarizeNetworkMetrics>;
+  scenarios: string[];
+  qualification: {
+    deterministicPersonas: "synthetic_assumptions";
+    nativeGraph: "owning_sql";
+    realAgentTurns: "unrun" | "scripted_native_http";
+    matchingProducer: "mechanical_direct" | "native_clock";
+    nativeTurnCount: number;
+    llmPersonas: "unrun";
+    llmJudge: "unrun";
+    externalSources: "unrun";
+    liveProviders: "unrun";
+    realShadowData: "unrun";
+    productValue: "unverified";
+  };
+}
+
+/** No copied reducer: fixtures, matching, consent, coordination and effects use their production owners. */
+export async function runNetworkSimulation(
+  options: NetworkSimulationOptions,
+): Promise<NetworkSimulationReport> {
+  if (!Number.isSafeInteger(options.days) || options.days < 1 || options.days > 365)
+    throw new Error("Simulation requires 1–365 days");
+  const { domain, clock, transport } = options;
+  const coordination = transport.coordination ?? options.coordination;
+  const seedStart = clock.now().getTime(),
+    startAt = clock.now().toISOString(),
+    random = seededRandom(options.seed);
+  const personas = await seedSimulationMembers(
+    domain,
+    options.personaCount,
+    options.seed,
+    options.personaMix,
+  );
+  const initial = await domain.engineSnapshot({ type: "system" });
+  const settings = await domain.getSettings({ type: "system" });
+  const { revision: settingsRevision, ...settingsValues } = settings;
+  const proactiveCities = Object.fromEntries(
+    (["SF", "NYC"] as City[]).map((city) => [
+      city,
+      initial.members.filter(
+        (member) =>
+          member.age === "adult" &&
+          member.accountState === "active" &&
+          member.homeCities.includes(city),
+      ).length >= 40,
+    ]),
+  ) as Record<City, boolean>;
+  await domain.command(
+    { type: "system" },
+    {
+      type: "configure",
+      requestId: "simulation:city-admission",
+      expectedRevision: settingsRevision,
+      settings: { ...settingsValues, proactiveCities },
+    },
+  );
+  const personaById = new Map(personas.map((persona) => [persona.memberId, persona]));
+  const observations: NetworkMetricObservation[] = personas.map((persona) => ({
+    memberId: persona.memberId,
+    city: persona.city,
+    cohort: persona.kind,
+    at: startAt,
+    event: "activated",
+  }));
+  const matchingRuns: MatchingRun[] = [],
+    scenarios = new Set([
+      "invite_and_onboarding",
+      "private_canaries",
+      "independent_review_and_consent",
+      "quiet_hours",
+      "group_quorum",
+      "all_party_slots",
+      "attendance_and_feedback",
+    ]);
+  const counts: NetworkSimulationReport["counts"] = {
+    proposals: 0,
+    sent: 0,
+    accepted: 0,
+    completed: 0,
+    closedWorkflows: 0,
+    declines: 0,
+    ignored: 0,
+    noShows: 0,
+    privacyCanariesSeeded: personas.length,
+    canaryLeaks: 0,
+    invariantViolations: 0,
+    scheduledJobsDrained: 0,
+    coordinationConflicts: 0,
+    sourceErasedMatchingRuns: 0,
+  };
+  const config = structuredClone(options.config ?? DEFAULT_MATCHING_CONFIG);
+  const admin: NetworkActor = {
+    type: "staff",
+    userId: "synthetic-reviewer",
+    roles: ["admin", "reviewer"],
+  };
+  const observe = (
+    persona: SyntheticPersona,
+    event: NetworkMetricObservation["event"],
+    opportunityId?: string,
+    pairId?: string,
+  ) =>
+    observations.push({
+      memberId: persona.memberId,
+      city: persona.city,
+      cohort: persona.kind,
+      at: clock.now().toISOString(),
+      event,
+      opportunityId,
+      pairId,
+    });
+  const command = (actor: NetworkActor, input: NetworkCommand) => transport.ingress(actor, input);
+  const advanceTo = async (instant: string | number) =>
+    options.advanceTo ? options.advanceTo(instant) : clock.advanceTo(instant);
+  const fetch = async (id: string): Promise<NetworkOpportunity> =>
+    (await domain.getOpportunity({ type: "system" }, id)) as NetworkOpportunity;
+  for (let day = 0; day < options.days; day++) {
+    await advanceTo(seedStart + day * 86_400_000);
+    await domain.command({ type: "system" }, { type: "tick", requestId: `simulation:${day}:tick` });
+    // Specific adversarial/lifecycle changes are actual commands, not hidden simulator-only state.
+    if (day === 3 && personas[1]) {
+      scenarios.add("time_bounded_cross_city_visit");
+      await command(
+        { type: "member", memberId: personas[1].memberId },
+        {
+          type: "set_presence",
+          requestId: "scenario:travel",
+          memberId: personas[1].memberId,
+          presence: {
+            id: "visit:SF",
+            city: "SF",
+            kind: "temporary",
+            area: "Public city area",
+            startsAt: clock.now().toISOString(),
+            endsAt: new Date(clock.now().getTime() + 7 * 86_400_000).toISOString(),
+          },
+        },
+      );
+    }
+    if (day === 5 && personas[0] && personas[2]) {
+      scenarios.add("blocked_pair_id_consistency");
+      await command(
+        { type: "member", memberId: personas[0].memberId },
+        {
+          type: "block_member",
+          requestId: "scenario:block",
+          memberId: personas[0].memberId,
+          blockedMemberId: personas[2].memberId,
+        },
+      );
+    }
+    if (day === 8 && personas[4]) {
+      scenarios.add("stop_with_queued_messages");
+      await command(
+        { type: "member", memberId: personas[4].memberId },
+        {
+          type: "channel_keyword",
+          requestId: "scenario:stop",
+          memberId: personas[4].memberId,
+          channel: "sms",
+          keyword: "STOP",
+        },
+      );
+    }
+    const scheduled: NetworkOpportunity[] = [];
+    const dayBase = clock.now().getTime(),
+      meetingStart = new Date(dayBase + 4 * 3_600_000).toISOString(),
+      meetingEnd = new Date(dayBase + 5 * 3_600_000).toISOString();
+    const dayRuns: MatchingRun[] = [];
+    if (transport.readMatchingRuns) {
+      if (!options.drainDue)
+        throw new Error("Native Clock simulation requires its actual owning scheduler drain");
+      await advanceTo(dayBase + 3 * 60000);
+      counts.scheduledJobsDrained += await options.drainDue();
+      dayRuns.push(...(await transport.readMatchingRuns()));
+    } else
+      for (const city of ["SF", "NYC"] as City[]) {
+        dayRuns.push(
+          await matchNetwork(
+            domain,
+            {
+              runId: `simulation:${options.seed}:${day}:${city}`,
+              city,
+              seed: options.seed + day,
+              startAt: meetingStart,
+              endAt: meetingEnd,
+            },
+            {
+              clock,
+              config,
+              graphEdges: await options.graphEdges(personas.map((persona) => persona.memberId)),
+              memberConstraints: async (memberId) => ({
+                roles:
+                  personaById.get(memberId)?.kind === "connector"
+                    ? ["host", "connector"]
+                    : ["participant"],
+                cluster: `synthetic-cluster:${Number.parseInt(memberId.slice(-2), 16) % 5}`,
+              }),
+            },
+          ),
+        );
+      }
+    for (const run of dayRuns) {
+      const city = run.replayInput.city;
+      if (city !== "SF" && city !== "NYC")
+        throw new Error("Native matching run has an unsupported city");
+      matchingRuns.push(run);
+      counts.proposals += run.proposals.length;
+      for (const proposal of run.proposals) {
+        const members = run.replayInput.members.filter((member) =>
+          proposal.participantIds.includes(member.memberId),
+        );
+        if (
+          candidateEligibility(
+            run.replayInput,
+            members,
+            proposal.category,
+            proposal.window,
+            run.config,
+          ).length
+        )
+          counts.invariantViolations++;
+        if (personas.some((persona) => JSON.stringify(proposal).includes(persona.canary)))
+          counts.canaryLeaks++;
+        const currentReview = await fetch(proposal.id);
+        if (
+          currentReview.state !== "in_review" ||
+          currentReview.reviewDeadline <= clock.now().toISOString()
+        )
+          continue;
+        await command(admin, {
+          type: "review_opportunity",
+          requestId: `review:${proposal.id}`,
+          opportunityId: proposal.id,
+          expectedRevision: currentReview.revision,
+          decision: "approved",
+          reasonCode: "approved",
+          note: "Deterministic synthetic review fixture; human calibration unrun",
+        });
+        for (const memberId of proposal.participantIds) {
+          const persona = personaById.get(memberId);
+          if (!persona) throw new Error("Simulation lost a canonical member identity");
+          const opportunity = await fetch(proposal.id);
+          if (["declined", "expired", "quorum_failed", "cancelled"].includes(opportunity.state))
+            break;
+          // Pair invitations are sequential; group invitations remain independent.
+          try {
+            if (
+              !opportunity.participants.find((participant) => participant.memberId === memberId)
+                ?.invitedAt
+            )
+              await command(admin, {
+                type: "invite_participant",
+                requestId: `invite:${proposal.id}:${memberId}`,
+                opportunityId: proposal.id,
+                expectedRevision: opportunity.revision,
+                memberId,
+              });
+          } catch (error) {
+            if (error instanceof NetworkDomainError && error.code === "NETWORK_TRANSITION") break;
+            throw error;
+          }
+          let result: DispatchResult;
+          try {
+            result = await transport.sendInvitation(proposal.id, memberId);
+          } catch (error) {
+            if (error instanceof NetworkDomainError && error.code === "NETWORK_INELIGIBLE") {
+              counts.ignored++;
+              continue;
+            }
+            throw error;
+          }
+          if (!result.ok) {
+            counts.ignored++;
+            continue;
+          }
+          counts.sent++;
+          observe(persona, "proposal_sent", proposal.id);
+          const response = transport.readMatchingRuns
+            ? nativePersonaDraw(options.seed, day, memberId, opportunity, "response")
+            : random();
+          if (response > persona.responseProbability) {
+            counts.ignored++;
+            continue;
+          }
+          const accepts =
+            (transport.readMatchingRuns
+              ? nativePersonaDraw(options.seed, day, memberId, opportunity, "accept")
+              : random()) < 0.85;
+          await command(
+            { type: "member", memberId },
+            { type: "record_inbound", requestId: `reply:${proposal.id}:${memberId}`, memberId },
+          );
+          const current = await fetch(proposal.id);
+          await command(
+            { type: "member", memberId },
+            {
+              type: "respond_opportunity",
+              requestId: `response:${proposal.id}:${memberId}`,
+              opportunityId: proposal.id,
+              expectedRevision: current.revision,
+              memberId,
+              accept: accepts,
+              disclosure: accepts
+                ? {
+                    revision: current.revision,
+                    factIds: current.explanations[memberId]?.factIds ?? [],
+                    contact: false,
+                    preciseVenue: false,
+                  }
+                : undefined,
+            },
+          );
+          if (accepts) {
+            counts.accepted++;
+            observe(persona, "proposal_accepted", proposal.id);
+          } else counts.declines++;
+          observe(persona, accepts ? "worthwhile_yes" : "worthwhile_no", proposal.id);
+        }
+        const connected = await fetch(proposal.id);
+        if (!["mutually_accepted", "quorum_met"].includes(connected.state)) continue;
+        const connectedIds = acceptedParticipantIds(connected),
+          first = personaById.get(connectedIds[0] ?? "");
+        if (!first) continue;
+        observe(first, "mutually_accepted", proposal.id);
+        try {
+          const slot = await coordination.proposeSlot(
+            { type: "member", memberId: first.memberId },
+            {
+              opportunityId: connected.id,
+              revision: connected.revision,
+              requestId: `slot:${connected.id}`,
+              startAt: meetingStart,
+              endAt: meetingEnd,
+              timezone: city === "SF" ? "America/Los_Angeles" : "America/New_York",
+              area: "Synthetic public meeting area",
+            },
+          );
+          for (const memberId of connectedIds)
+            await coordination.confirmSlot(
+              { type: "member", memberId },
+              {
+                opportunityId: connected.id,
+                revision: connected.revision,
+                requestId: `slot-confirm:${connected.id}:${memberId}`,
+                slotId: slot.slot?.id ?? "",
+              },
+            );
+          scheduled.push(await fetch(connected.id));
+        } catch (error) {
+          if (
+            !(error instanceof NetworkDomainError) ||
+            error.code !== "NETWORK_CONFLICT" ||
+            error.context?.rule !== "confirmed_slot_overlap"
+          )
+            throw error;
+          counts.coordinationConflicts++;
+          await coordination.cancel(
+            { type: "member", memberId: first.memberId },
+            {
+              opportunityId: connected.id,
+              revision: connected.revision,
+              requestId: `slot-conflict-cancel:${connected.id}`,
+            },
+          );
+        }
+      }
+    }
+    // The same owning scheduler drains due jobs when the caller injects it.
+    await advanceTo(dayBase + 3 * 3_600_000);
+    counts.scheduledJobsDrained += (await options.drainDue?.()) ?? 0;
+    await advanceTo(meetingStart);
+    counts.scheduledJobsDrained += (await options.drainDue?.()) ?? 0;
+    await advanceTo(meetingEnd);
+    for (const opportunity of scheduled) {
+      await command(
+        { type: "system" },
+        {
+          type: "transition_opportunity",
+          requestId: `start:${opportunity.id}`,
+          opportunityId: opportunity.id,
+          expectedRevision: opportunity.revision,
+          to: "in_progress",
+        },
+      );
+      const attendeeIds: string[] = [];
+      for (const memberId of acceptedParticipantIds(opportunity)) {
+        const persona = personaById.get(memberId);
+        if (!persona) continue;
+        const attended =
+          (transport.readMatchingRuns
+            ? nativePersonaDraw(options.seed, day, memberId, opportunity, "attendance")
+            : random()) < persona.attendanceProbability;
+        await command(
+          { type: "member", memberId },
+          {
+            type: "record_attendance",
+            requestId: `attendance:${opportunity.id}:${memberId}`,
+            opportunityId: opportunity.id,
+            memberId,
+            state: attended ? "attended" : "no_show",
+          },
+        );
+        if (attended) attendeeIds.push(memberId);
+        else counts.noShows++;
+      }
+      await command(
+        { type: "system" },
+        {
+          type: "transition_opportunity",
+          requestId: `complete:${opportunity.id}`,
+          opportunityId: opportunity.id,
+          expectedRevision: opportunity.revision,
+          to: "completed",
+        },
+      );
+      counts.closedWorkflows++;
+      const completedMeeting = attendeeIds.length >= opportunity.quorum;
+      if (completedMeeting) counts.completed++;
+      const first = personaById.get(opportunity.participantIds[0] ?? "");
+      if (first && completedMeeting) observe(first, "completed", opportunity.id);
+      for (const memberId of acceptedParticipantIds(opportunity)) {
+        const persona = personaById.get(memberId);
+        if (
+          !persona ||
+          (transport.readMatchingRuns
+            ? nativePersonaDraw(options.seed, day, memberId, opportunity, "feedback")
+            : random()) > persona.responseProbability
+        )
+          continue;
+        const present = attendeeIds.includes(memberId),
+          witnessedIds = present ? attendeeIds : [];
+        const others = witnessedIds.filter((id) => id !== memberId),
+          positives = others.filter((id) => personaById.get(id)?.hiddenTag === persona.hiddenTag);
+        await command(
+          { type: "member", memberId },
+          {
+            type: "give_feedback",
+            requestId: `feedback:${opportunity.id}:${memberId}`,
+            feedback: {
+              id: `feedback:${opportunity.id}:${memberId}`,
+              opportunityId: opportunity.id,
+              memberId,
+              happened: present && attendeeIds.length > 1,
+              attendedIds: witnessedIds,
+              wouldMeetAgainIds: positives,
+              negativeIds: [],
+              note: "Synthetic outcome assumption",
+              worthwhile: positives.length > 0,
+            },
+          },
+        );
+        if (positives.length) {
+          observe(persona, "meaningful_value", opportunity.id);
+          for (const otherId of positives) {
+            const pairId = [persona.memberId, otherId].sort().join("/");
+            if (
+              observations.some(
+                (entry) =>
+                  entry.event === "positive_meeting" &&
+                  entry.pairId === pairId &&
+                  entry.opportunityId !== opportunity.id,
+              )
+            )
+              observe(persona, "second_interaction", opportunity.id, pairId);
+            observe(persona, "positive_meeting", opportunity.id, pairId);
+          }
+        }
+      }
+    }
+    await advanceTo(dayBase + 7 * 3_600_000);
+    counts.scheduledJobsDrained += (await options.drainDue?.()) ?? 0;
+    await options.progress?.({
+      day: day + 1,
+      totalDays: options.days,
+      proposals: counts.proposals,
+      completed: counts.completed,
+    });
+  }
+  const endAt = new Date(seedStart + options.days * 86_400_000).toISOString();
+  await advanceTo(endAt);
+  counts.scheduledJobsDrained += (await options.drainDue?.()) ?? 0;
+  if (transport.readMatchingRuns) {
+    const finalRuns = await transport.readMatchingRuns(true);
+    const previouslyObserved = new Set(matchingRuns.map((run) => run.runId)),
+      retained = new Set(finalRuns.map((run) => run.runId));
+    counts.sourceErasedMatchingRuns = [...previouslyObserved].filter(
+      (id) => !retained.has(id),
+    ).length;
+    counts.proposals += finalRuns
+      .filter((run) => !previouslyObserved.has(run.runId))
+      .reduce((count, run) => count + run.proposals.length, 0);
+    matchingRuns.splice(0, matchingRuns.length, ...finalRuns);
+  }
+  const outbound = (await transport.messages()).filter(
+    (message) => message.direction === "outbound",
+  );
+  counts.canaryLeaks = outbound.filter((message) =>
+    personas.some((persona) => message.body.includes(persona.canary)),
+  ).length;
+  if (new Set(outbound.map((message) => message.idempotencyKey)).size !== outbound.length)
+    counts.invariantViolations++;
+  const qualification: NetworkSimulationReport["qualification"] = {
+    deterministicPersonas: "synthetic_assumptions",
+    nativeGraph: "owning_sql",
+    realAgentTurns: (transport.nativeTurns?.() ?? 0) > 0 ? "scripted_native_http" : "unrun",
+    nativeTurnCount: transport.nativeTurns?.() ?? 0,
+    matchingProducer: transport.readMatchingRuns ? "native_clock" : "mechanical_direct",
+    llmPersonas: "unrun",
+    llmJudge: "unrun",
+    externalSources: "unrun",
+    liveProviders: "unrun",
+    realShadowData: "unrun",
+    productValue: "unverified",
+  };
+  return {
+    seed: options.seed,
+    personaCount: options.personaCount,
+    days: options.days,
+    runDigest: networkDigest([
+      options.seed,
+      options.personaCount,
+      options.days,
+      matchingRuns.map((run) => run.inputDigest),
+      outbound,
+    ]),
+    startAt,
+    endAt,
+    matchingRuns,
+    outbound,
+    observations,
+    counts,
+    metrics: summarizeNetworkMetrics(observations, startAt, endAt),
+    scenarios: [...scenarios].sort(),
+    qualification,
+  };
+}
