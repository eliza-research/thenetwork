@@ -0,0 +1,66 @@
+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { NetworkPortal } from "./NetworkPortal";
+
+const config = {
+  mode: "local_preview",
+  brands: [
+    {
+      id: "friend.help",
+      name: "friend.help",
+      purpose: "Find your people",
+      description: "Friendship through your Network agent.",
+    },
+  ],
+  demoPhone: "+12025550101",
+  agentPhone: null,
+};
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+it("never opens a synthetic session and sends phone login back to the authenticated chat", async () => {
+  const fetch = vi.fn<typeof globalThis.fetch>(
+    async () =>
+      new Response(JSON.stringify(config), {
+        status: 200,
+        headers: { "Content-Type": "application/json" },
+      }),
+  );
+  vi.stubGlobal("fetch", fetch);
+  render(<NetworkPortal brandId="friend.help" />);
+  const link = await screen.findByRole("link", {
+    name: "Sign in with Eliza Cloud",
+  });
+  const url = new URL(link.getAttribute("href") ?? "");
+  expect(url.searchParams.get("returnTo")).toBe(
+    "/network/chat?brand=friend.help",
+  );
+  expect(fetch).toHaveBeenCalledTimes(1);
+  expect(String(fetch.mock.calls[0]?.[0])).toContain("/portal/config");
+  expect(screen.queryByRole("textbox")).toBeNull();
+  expect(screen.queryByRole("button", { name: "Preview demo" })).toBeNull();
+  expect(screen.queryByText(/CANARY_PRIVATE|Synthetic member/)).toBeNull();
+});
+it("keeps a failed connection on the entry and retries without a fixture fallback", async () => {
+  let attempt = 0;
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => {
+      attempt++;
+      return new Response(
+        JSON.stringify(attempt === 1 ? { error: "Unavailable" } : config),
+        {
+          status: attempt === 1 ? 503 : 200,
+          headers: { "Content-Type": "application/json" },
+        },
+      );
+    }),
+  );
+  render(<NetworkPortal brandId="friend.help" />);
+  await screen.findByRole("alert");
+  expect(screen.queryByRole("textbox")).toBeNull();
+  fireEvent.click(screen.getByRole("button", { name: "Retry loading" }));
+  await screen.findByRole("link", { name: "Sign in with Eliza Cloud" });
+});
