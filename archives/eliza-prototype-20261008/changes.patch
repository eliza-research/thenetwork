+        if (current()) setError(errorText(issue));
+      } finally {
+        if (current()) setLoading(false);
+      }
+    })();
+    return () => {
+      epoch.current++;
+      void ownedTurns?.reset();
+      if (turnOwner.current === ownedTurns) turnOwner.current = null;
+      controller.abort();
+      abort.current?.abort();
+    };
+  }, [token, revision, selectedRoom]);
+
+  const loadOlder = async () => {
+    if (!binding || inFlight.current) return;
+    inFlight.current = true;
+    setBusy(true);
+    const generation = epoch.current;
+    const controller = new AbortController();
+    abort.current = controller;
+    const owned = () =>
+      generation === epoch.current &&
+      readStoredStewardToken() === binding.token;
+    const current = () => owned() && !controller.signal.aborted;
+    try {
+      const result = await loadOlderConversationMessages({
+        client: binding.client,
+        conversationId: binding.room.id,
+        currentMessages: messages,
+        signal: controller.signal,
+        before: olderCursor.current?.resumeBefore,
+        beforeId: olderCursor.current?.resumeBeforeId,
+        prependMessages: (older) => {
+          if (!current()) return 0;
+          const ids = new Set(messages.map((message) => message.id));
+          const added = older.filter((message) => !ids.has(message.id));
+          setMessages((previous) => [...added, ...previous]);
+          return added.length;
+        },
+      });
+      if (current()) {
+        olderCursor.current = result;
+        setHasMore(result.hasMore);
+      }
+    } catch (issue) {
+      if (owned()) setError(errorText(issue));
+    } finally {
+      if (owned()) {
+        inFlight.current = false;
+        setBusy(false);
+      }
+    }
+  };
+
+  const stop = async () => {
+    if (!binding) return;
+    const generation = epoch.current;
+    abort.current?.abort();
+    setBusy(true);
+    const result = await binding.turns.interrupt();
+    if (
+      generation !== epoch.current ||
+      readStoredStewardToken() !== binding.token
+    )
+      return;
+    setBusy(false);
+    if (result.status === "failed") {
+      setStopFailed(true);
+      setError(
+        `Remote stop could not be confirmed: ${errorText(result.error)}. Sending is disabled for this connection.`,
+      );
+    } else if (result.status === "stopped") {
+      setNotice(
+        "Remote stop request acknowledged. This does not undo earlier actions. Retry the same message to recover its saved outcome.",
+      );
+    }
+  };
+
+  const send = async () => {
+    if (!binding || inFlight.current || binding.turns.pending || stopFailed)
+      return;
+    const request = pending.current ?? {
+      text: draft.trim(),
+      id: crypto.randomUUID(),
+    };
+    if (!request.text) return;
+    pending.current = request;
+    setBusy(true);
+    setError(null);
+    setNotice(null);
+    const generation = epoch.current;
+    const current = () =>
+      generation === epoch.current &&
+      readStoredStewardToken() === binding.token;
+    const completed = await binding.turns.send(request, {
+      reply: () => {
+        if (!current()) return;
+        pending.current = null;
+        setDraft("");
+        setNotice("Response received. Refreshing saved history…");
+      },
+      error: (issue) => {
+        if (current()) setError(errorText(issue));
+      },
+      settled: () => {
+        if (current()) setBusy(false);
+      },
+    });
+    if (!completed || !current()) return;
+    const controller = new AbortController();
+    abort.current = controller;
+    inFlight.current = true;
+    setBusy(true);
+    try {
+      const history = await binding.client.getConversationMessages(
+        binding.room.id,
+        { signal: controller.signal },
+      );
+      if (!current() || controller.signal.aborted) return;
+      // Keep earlier pages while replacing matching rows with server history.
+      setMessages((previous) => {
+        const next = new Map(previous.map((message) => [message.id, message]));
+        for (const message of history.messages) next.set(message.id, message);
+        return [...next.values()].sort((a, b) => a.timestamp - b.timestamp);
+      });
+      setHasMore(
+        (previous) =>
+          previous || (history.hasMore ?? binding.runtime === "dedicated"),
+      );
+      setNotice("Saved conversation refreshed.");
+    } catch (issue) {
+      if (current()) setError(errorText(issue));
+    } finally {
+      if (current()) {
+        inFlight.current = false;
+        setBusy(false);
+      }
+    }
+  };
+
+  return (
+    <main className="theme-cloud mx-auto flex h-dvh min-h-0 max-w-3xl flex-col overflow-hidden bg-bg p-4 text-txt">
+      <header className="mb-4 flex items-center justify-between">
+        <h1 className="text-xl font-semibold">{name}</h1>
+        <button
+          type="button"
+          aria-expanded={settingsOpen}
+          onClick={() => setSettingsOpen((open) => !open)}
+        >
+          {settingsOpen ? "Back to chat" : "Settings"}
+        </button>
+      </header>
+      {settingsOpen ? (
+        <section
+          aria-label="Settings"
+          className="min-h-0 flex-1 space-y-4 overflow-y-auto"
+        >
+          <h2 className="text-lg font-semibold">Settings</h2>
+          <p>
+            Your private conversation uses your Eliza Cloud account. Community
+            membership and app-specific sharing are not enabled here yet.
+          </p>
+          <Link to={login}>Sign in or switch account</Link>
+          {token && (
+            <button
+              type="button"
+              onClick={() => {
+                void clearStoredStewardToken().catch((issue) =>
+                  setError(errorText(issue)),
+                );
+              }}
+            >
+              Sign out of this browser
+            </button>
+          )}
+          {error && <p role="alert">{error}</p>}
+        </section>
+      ) : !token ? (
+        <p>
+          <Link to={login}>Sign in with Eliza Cloud</Link> to open your existing
+          private conversation.
+        </p>
+      ) : (
+        <>
+          <p className="mb-3 text-sm text-muted">
+            Your private account conversation
+            {binding
+              ? ` · ${binding.runtime === "shared" ? "Shared" : "Dedicated"}`
+              : ""}
+            . Community membership and sharing require separate choices.
+          </p>
+          {loading && <p role="status">Opening your conversation…</p>}
+          {error && <p role="alert">{error}</p>}
+          {notice && <p role="status">{notice}</p>}
+          {!binding && !loading && rooms.length === 0 && (
+            <button
+              type="button"
+              onClick={() => setRevision((value) => value + 1)}
+            >
+              Try connection again
+            </button>
+          )}
+          {rooms.length > 0 && (
+            <section aria-label="Existing conversations">
+              <h2>Choose your existing conversation</h2>
+              <ul>
+                {rooms.map((room) => (
+                  <li key={room.id}>
+                    <button
+                      type="button"
+                      onClick={() => setSelectedRoom(room.id)}
+                    >
+                      {room.title}
+                    </button>
+                  </li>
+                ))}
+              </ul>
+            </section>
+          )}
+          {binding && (
+            <ChatThreadLayout
+              className="min-h-0 flex-1"
+              composer={
+                <ChatComposer
+                  layout="inline"
+                  agentVoiceEnabled={false}
+                  chatInput={draft}
+                  chatPendingImagesCount={0}
+                  chatSending={busy}
+                  isAgentStarting={false}
+                  isComposerLocked={
+                    busy || stopFailed || pending.current !== null
+                  }
+                  onAttachImage={() => {}}
+                  onChatInputChange={setDraft}
+                  onSend={() => {
+                    void send();
+                  }}
+                  onStop={() => {
+                    void stop();
+                  }}
+                  onStopSpeaking={() => {}}
+                  onToggleAgentVoice={() => {}}
+                  showAgentVoiceToggle={false}
+                  hideAttachButton
+                  t={t}
+                  textareaRef={textarea}
+                  variant="default"
+                  voice={noVoice}
+                  placeholder="Message your private agent"
+                />
+              }
+            >
+              {hasMore && (
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => {
+                    void loadOlder();
+                  }}
+                >
+                  Load earlier messages
+                </button>
+              )}
+              <ChatTranscript
+                messages={filterRenderableConversationMessages(messages)}
+                agentName={binding.name}
+                userMessagesOnRight
+              />
+            </ChatThreadLayout>
+          )}
+          {binding && pending.current && !busy && !stopFailed && (
+            <button
+              type="button"
+              onClick={() => {
+                void send();
+              }}
+            >
+              Retry same message
+            </button>
+          )}
+          {binding &&
+            !busy &&
+            notice === "Response received. Refreshing saved history…" && (
+              <button
+                type="button"
+                onClick={() => setRevision((value) => value + 1)}
+              >
+                Reload saved history
+              </button>
+            )}
+        </>
+      )}
+      <footer className="mt-4 text-xs text-muted">Powered by Eliza</footer>
+    </main>
+  );
+}
