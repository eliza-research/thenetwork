+import { sqlQuote } from "@elizaos/plugin-sql";
+import type { NetworkMatchingRun } from "../domain/types.ts";
+import { type NetworkActor, NetworkDomainError } from "../domain/types.ts";
+import type { SimClock } from "../evaluation/fixtures.ts";
+import type { SimulationTransport } from "../evaluation/simulator.ts";
+import type { MatchingRun } from "../matching/types.ts";
+import type { createLocalNetworkHost } from "./host.ts";
+
+/** Synthetic principals still authenticate through the actual local HTTP boundary. */
+export function createNativeSimulationTransport(
+  host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  clock: SimClock,
+): SimulationTransport {
+  if (!host.domain.options.networkId.startsWith("simulation:"))
+    throw new Error("Native simulation ingress requires an isolated simulation host");
+  let application: Promise<(request: Request) => Promise<Response>> | undefined;
+  const sessions = new Map<string, string>();
+  let nativeTurns = 0,
+    matchingSequence = 0;
+  const request = async (
+    actor: Exclude<NetworkActor, { type: "system" }>,
+    route: string,
+    input: unknown,
+  ) => {
+    application ??= import("./application.ts").then(({ createLocalNetworkApplication }) =>
+      createLocalNetworkApplication(host, clock),
+    );
+    const handle = await application;
+    const fixtureId = actor.type === "member" ? actor.memberId : "local-operator";
+    let cookie = sessions.get(fixtureId);
+    if (!cookie) {
+      const response = await handle(
+        new Request("http://127.0.0.1/api/network/local/session", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ fixtureId }),
+        }),
+      );
+      if (!response.ok) throw new Error(`Simulation session admission failed: ${response.status}`);
+      cookie = response.headers.get("Set-Cookie")?.split(";")[0];
+      if (!cookie) throw new Error("Simulation session returned no authenticated cookie");
+      sessions.set(fixtureId, cookie);
+    }
+    const response = await handle(
+      new Request(`http://127.0.0.1/api/network/${route}`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json", Cookie: cookie },
+        body: JSON.stringify(input),
+      }),
+    );
+    const result: unknown = await response.json();
+    if (!response.ok) {
+      if (
+        result &&
+        typeof result === "object" &&
+        "code" in result &&
+        typeof result.code === "string"
+      )
+        throw new NetworkDomainError(
+          result.code as NetworkDomainError["code"],
+          "error" in result && typeof result.error === "string"
+            ? result.error
+            : "Simulation request denied",
+          "rule" in result && typeof result.rule === "string" ? { rule: result.rule } : undefined,
+        );
+      throw new Error(`Native simulation HTTP request failed: ${response.status}`);
+    }
+    return result;
+  };
+  return {
+    async ingress(actor, command) {
+      // Trusted clock/setup transitions are fixture machinery, never attributed to a member turn.
+      if (actor.type === "system") return host.domain.command(actor, command);
+      if (actor.type === "member" && command.type === "respond_opportunity") {
+        const result = await request(actor, "message", {
+          requestId: command.requestId,
+          text: `${command.accept ? "accept" : "decline"} opportunity ${command.opportunityId} revision ${command.expectedRevision}`,
+        });
+        if (
+          !result ||
+          typeof result !== "object" ||
+          !("receipts" in result) ||
+          !Array.isArray(result.receipts) ||
+          result.receipts.length === 0
+        )
+          throw new Error("Native persona response produced no owning committed effect receipt");
+        nativeTurns++;
+        if (command.accept && command.disclosure)
+          await request(actor, "command", {
+            type: "set_disclosure",
+            requestId: `${command.requestId}:disclosure`,
+            memberId: actor.memberId,
+            opportunityId: command.opportunityId,
+            expectedRevision: command.expectedRevision,
+            disclosure: command.disclosure,
+          });
+        return result;
+      }
+      return request(actor, "command", command);
+    },
+    coordination: {
+      async proposeSlot(actor, input) {
+        if (actor.type === "system") throw new Error("Simulation slot proposer must authenticate");
+        await request(actor, "command", { ...input, type: "propose_slot" });
+        return host.coordination.view(actor, input.opportunityId);
+      },
+      async confirmSlot(actor, input) {
+        if (actor.type === "system") throw new Error("Simulation confirmer must authenticate");
+        await request(actor, "command", { ...input, type: "confirm_slot" });
+        return host.coordination.view(actor, input.opportunityId);
+      },
+      async cancel(actor, input) {
+        if (actor.type === "system") throw new Error("Simulation cancellation must authenticate");
+        const response = await request(actor, "command", { ...input, type: "cancel_plan" });
+        if (
+          !response ||
+          typeof response !== "object" ||
+          !("result" in response) ||
+          !response.result ||
+          typeof response.result !== "object" ||
+          !("opportunityId" in response.result) ||
+          response.result.opportunityId !== input.opportunityId ||
+          !("kind" in response.result) ||
+          response.result.kind !== "cancelled"
+        )
+          throw new Error("Cancellation returned no matching owning acknowledgment");
+        return { opportunityId: input.opportunityId, kind: "cancelled" };
+      },
+    },
+    sendInvitation: host.transport.sendInvitation.bind(host.transport),
+    messages: host.transport.messages.bind(host.transport),
+    nativeTurns: () => nativeTurns,
+    async readMatchingRuns(all = false) {
+      const rows = await host.db.execute(`SELECT e.sequence,r.id FROM network.events e
+        JOIN network.commands c ON c.network_id=e.network_id AND c.request_id=e.id
+        JOIN network.matching_runs r ON r.network_id=c.network_id AND r.id=c.result->>'id'
+        WHERE e.network_id=${sqlQuote(host.domain.options.networkId)} AND e.payload->>'kind'='commit_matching_run' AND r.payload->'sourceDataErased' IS NULL
+        AND e.sequence>${all ? 0 : matchingSequence} ORDER BY e.sequence`);
+      const runs: MatchingRun[] = [];
+      let previousSequence = all ? 0 : matchingSequence;
+      for (const row of rows) {
+        const sequence = Number(row.sequence);
+        if (
+          !Number.isSafeInteger(sequence) ||
+          sequence <= previousSequence ||
+          typeof row.id !== "string"
+        )
+          throw new Error("Invalid native matching chronology");
+        let stored: NetworkMatchingRun | null;
+        try {
+          stored = await host.domain.getMatchingRun({ type: "system" }, row.id);
+        } catch (error) {
+          if (
+            !(error instanceof NetworkDomainError) ||
+            error.context?.rule !== "matching_source_data_erased"
+          )
+            throw error;
+          previousSequence = sequence;
+          continue;
+        }
+        if (!stored) throw new Error("Native matching event has no owning run record");
+        if (stored.sourceDataErased) {
+          previousSequence = sequence;
+          continue;
+        }
+        const run = stored.log as unknown as MatchingRun;
+        if (
+          stored.fingerprintVersion !== 2 ||
+          run.runId !== stored.id ||
+          !run.replayInput ||
+          !Array.isArray(run.proposals)
+        )
+          throw new Error("Native matching event has no immutable qualified replay");
+        runs.push(run);
+        previousSequence = sequence;
+      }
+      matchingSequence = previousSequence;
+      return runs;
+    },
+  };
+}
