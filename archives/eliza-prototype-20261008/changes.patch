+++ b/packages/cloud/shared/src/lib/network/matching/replay-purpose.test.ts
@@ -0,0 +1,217 @@
+import { detectPii, validateUuid } from "@elizaos/core";
+import { afterAll, beforeAll, expect, it } from "vitest";
+import { assertKnownDisclosure, assertReplayLog } from "../domain/policy.ts";
+import type { NetworkMember } from "../domain/types.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { matchingConfigFromSettings, projectMatchingInput } from "./domain-projection.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  owner: NetworkMember,
+  peer: NetworkMember;
+let log: { replayInput: ReturnType<typeof projectMatchingInput> };
+beforeAll(async () => {
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "simulation:replay-purpose",
+    clock,
+  });
+  const [a, b] = await seedSimulationMembers(host.domain, 2, 42);
+  if (!a || !b) throw new Error("Fixtures");
+  await host.domain.command(
+    { type: "member", memberId: a.memberId },
+    {
+      type: "upsert_fact",
+      requestId: "private-offer",
+      memberId: a.memberId,
+      fact: {
+        id: "private-offer",
+        kind: "offer",
+        value: "guitar practice",
+        tags: [],
+        scope: "agent_private",
+        status: "proposed",
+        source: "conversation",
+        sourceRef: "old-private",
+        confidence: 1,
+      },
+    },
+  );
+  await host.domain.command(
+    { type: "member", memberId: a.memberId },
+    {
+      type: "manage_intent",
+      requestId: "own-intent",
+      memberId: a.memberId,
+      intent: {
+        id: "own-intent",
+        objective: "Find guitar practice",
+        category: "support",
+        tags: ["support"],
+        needs: ["guitar practice"],
+        offers: [],
+        status: "active",
+      },
+    },
+  );
+  await host.domain.command(
+    { type: "member", memberId: a.memberId },
+    {
+      type: "upsert_fact",
+      requestId: "confirmed-purpose",
+      memberId: a.memberId,
+      fact: {
+        id: "confirmed-purpose",
+        kind: "interest",
+        value: "guitar practice",
+        tags: ["guitar"],
+        scope: "matching",
+        status: "confirmed",
+        source: "member",
+        sourceRef: "new-explicit-purpose",
+        confidence: 1,
+      },
+    },
+  );
+  owner = await host.domain.getMember({ type: "system" }, a.memberId);
+  peer = await host.domain.getMember({ type: "system" }, b.memberId);
+  const settings = await host.domain.getSettings({ type: "system" });
+  log = {
+    replayInput: projectMatchingInput(
+      await host.domain.engineSnapshot({ type: "system" }, { memberIds: [owner.memberId] }),
+      {
+        runId: "purpose",
+        city: "SF",
+        seed: 42,
+        startAt: clock.now().toISOString(),
+        endAt: new Date(clock.now().getTime() + 86400000).toISOString(),
+      },
+      clock.now().getTime(),
+      matchingConfigFromSettings(settings),
+      settings,
+    ),
+  };
+}, 120000);
+afterAll(async () => {
+  await host?.close();
+});
+
+it("admits exact current owned matching leaves while preserving private scope and all outbound guards", () => {
+  expect(() => assertReplayLog([owner, peer], log, clock.now().getTime())).not.toThrow();
+  expect(() => assertReplayLog([owner, peer], log)).toThrow("private member data");
+  expect(() => assertKnownDisclosure([owner], "guitar practice")).toThrow("protected member data");
+  expect(() =>
+    assertReplayLog(
+      [owner, peer],
+      { ...log, unrelated: { text: "guitar practice" } },
+      clock.now().getTime(),
+    ),
+  ).toThrow("private member data");
+});
+
+it("rejects forged owners, old revisions, unknown intent IDs and modified canonical fields", () => {
+  for (const mutation of ["owner", "revision", "intent", "needs", "scope", "expiry"]) {
+    const changed = structuredClone(log),
+      profile = changed.replayInput.members[0];
+    if (!profile) throw new Error("Profile");
+    const intent = profile.intents.find((intent) => intent.id === "own-intent"),
+      fact = profile.facts.find((fact) => fact.id === "confirmed-purpose");
+    if (!intent || !fact) throw new Error("Current sources");
+    if (mutation === "owner") profile.memberId = peer.memberId;
+    if (mutation === "revision") profile.profileRevision++;
+    if (mutation === "intent") intent.id = "unknown";
+    if (mutation === "needs") intent.needs.push("changed");
+    if (mutation === "scope") fact.scope = "shareable";
+    if (mutation === "expiry") intent.expiresAt--;
+    expect(() => assertReplayLog([owner, peer], changed, clock.now().getTime()), mutation).toThrow(
+      "private member data",
+    );
+  }
+  const withdrawn = {
+    ...owner,
+    intents: owner.intents.map((intent) =>
+      intent.id === "own-intent" ? { ...intent, status: "closed" as const } : intent,
+    ),
+  };
+  expect(() => assertReplayLog([withdrawn, peer], log, clock.now().getTime())).toThrow(
+    "private member data",
+  );
+});
+
+it("does not whitelist another member's protected words or any contact binding", () => {
+  const fact = owner.facts.find((fact) => fact.id === "private-offer");
+  if (!fact) throw new Error("Protected source");
+  const other = {
+    ...peer,
+    facts: [...peer.facts, { ...fact, id: "peer-secret", value: "guitar" }],
+  };
+  expect(() => assertReplayLog([owner, other], log, clock.now().getTime())).toThrow(
+    "private member data",
+  );
+  const source = owner.intents.find((intent) => intent.id === "own-intent"),
+    profile = log.replayInput.members[0];
+  if (!source || !profile) throw new Error("Current intent");
+  const address = owner.channels[0]?.address;
+  if (!address) throw new Error("Binding");
+  const contactOwner = {
+    ...owner,
+    intents: owner.intents.map((intent) =>
+      intent.id === source.id ? { ...intent, needs: [address] } : intent,
+    ),
+  };
+  const contactLog = structuredClone(log),
+    intent = contactLog.replayInput.members[0]?.intents.find((intent) => intent.id === source.id);
+  if (!intent) throw new Error("Projected intent");
+  intent.needs = [address];
+  expect(() => assertReplayLog([contactOwner, peer], contactLog, clock.now().getTime())).toThrow(
+    "private identity binding",
+  );
+});
+
+it("preserves a canonical provider UUID while rejecting contact-shaped provider metadata", () => {
+  const providerId = "75f56186-0464-4748-b543-6986996e9884";
+  expect(validateUuid(providerId)).toBe(providerId);
+  expect(detectPii(providerId)).toContainEqual(
+    expect.objectContaining({ kind: "phone", value: "543-6986996" }),
+  );
+  expect(() =>
+    assertReplayLog([], {
+      trajectories: [{ detail: { steps: [{ providerAccesses: [{ providerId }] }] } }],
+    }),
+  ).not.toThrow();
+  for (const value of [
+    "+1 415 555 0199",
+    "private@example.test",
+    `${providerId} +1 415 555 0199`,
+    "75f56186-0464-4748-b543-6986996e988x",
+  ]) {
+    expect(validateUuid(value)).toBeNull();
+    expect(() => assertReplayLog([], { providerId: value })).toThrow("contact data");
+  }
+  expect(() => assertReplayLog([], { text: providerId })).toThrow("contact data");
+  const hex = providerId.replaceAll("-", "");
+  expect(validateUuid(hex)).toBeNull();
+  expect(() => assertReplayLog([], { providerId: hex })).not.toThrow();
+});
+
+it("keeps private values and identity bindings ahead of provider UUID classification", () => {
+  const providerId = "75f56186-0464-4748-b543-6986996e9884";
+  const fact = owner.facts[0];
+  if (!fact) throw new Error("Canonical fixture fact is missing");
+  const protectedOwner = {
+    ...owner,
+    facts: [
+      ...owner.facts,
+      { ...fact, id: "provider-secret", scope: "agent_private" as const, value: providerId },
+    ],
+  };
+  expect(() => assertReplayLog([protectedOwner], { providerId })).toThrow("private member data");
+  expect(() => assertReplayLog([{ ...owner, cloudUserId: providerId }], { providerId })).toThrow(
+    "private identity binding",
+  );
+  const hex = providerId.replaceAll("-", "");
+  expect(() => assertReplayLog([{ ...owner, cloudUserId: hex }], { providerId: hex })).toThrow(
+    "private identity binding",
+  );
+});
