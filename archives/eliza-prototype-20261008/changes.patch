index 000000000000..4617c6a15c9a
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/programme-priority.ts
@@ -0,0 +1,60 @@
+import type { MatchingInput } from "../matching/types.ts";
+
+/** Invitation ordering only; the existing review, consent and delivery gates retain authority. */
+export function programmeInvitationPriority(input: MatchingInput, audienceIds: string[]) {
+  const audience = new Set(audienceIds);
+  const order = [
+    "zero_exposure_30d",
+    "isolated",
+    "newcomer",
+    "zero_exposure_14d",
+    "pending_second_encounter",
+  ];
+  const priority = input.members
+    .filter((member) => audience.has(member.memberId))
+    .map((member) => {
+      const delivered = (input.budgetHistory ?? []).filter((receipt) =>
+        receipt.memberIds.includes(member.memberId),
+      );
+      const positive = input.history.filter(
+        (encounter) =>
+          encounter.outcome === "positive" &&
+          encounter.at > input.now - 30 * 86_400_000 &&
+          encounter.memberIds.includes(member.memberId),
+      );
+      const reasons = [
+        ...(!delivered.some((receipt) => receipt.at > input.now - 30 * 86_400_000)
+          ? ["zero_exposure_30d"]
+          : []),
+        ...(!input.edges.some(
+          (edge) =>
+            edge.confirmed && (edge.from === member.memberId || edge.to === member.memberId),
+        )
+          ? ["isolated"]
+          : []),
+        ...(member.joinedAt > input.now - 7 * 86_400_000 ? ["newcomer"] : []),
+        ...(!delivered.some((receipt) => receipt.at > input.now - 14 * 86_400_000)
+          ? ["zero_exposure_14d"]
+          : []),
+        ...(positive.some(
+          (encounter) =>
+            !input.history.some(
+              (later) =>
+                later.outcome === "completed" &&
+                later.at > encounter.at &&
+                encounter.memberIds.every((id) => later.memberIds.includes(id)),
+            ),
+        )
+          ? ["pending_second_encounter"]
+          : []),
+      ];
+      return { memberId: member.memberId, reasons };
+    });
+  return priority.sort((a, b) => {
+    for (const reason of order) {
+      const difference = Number(b.reasons.includes(reason)) - Number(a.reasons.includes(reason));
+      if (difference) return difference;
+    }
+    return a.memberId.localeCompare(b.memberId);
+  });
+}
