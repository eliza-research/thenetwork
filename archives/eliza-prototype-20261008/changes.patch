+import { useEffect, useId, useRef, useState } from "react";
+import { Button } from "../components/ui/button";
+import type { NetworkConversationView, NetworkWorkbenchTransport } from "./api";
+
+export function NetworkConversation({
+  transport,
+  onChange,
+}: {
+  transport: NetworkWorkbenchTransport;
+  onChange(): void;
+}) {
+  const [conversation, setConversation] =
+    useState<NetworkConversationView | null>(null);
+  const [text, setText] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const pending = useRef<{ text: string; requestId: string } | null>(null);
+  const active = useRef(true);
+  const inputId = useId();
+  useEffect(() => {
+    active.current = true;
+    const controller = new AbortController();
+    transport
+      .conversation(controller.signal)
+      .then((value) => {
+        if (active.current) setConversation(value);
+      })
+      .catch((issue) => {
+        if (active.current && issue?.name !== "AbortError")
+          setError(
+            issue instanceof Error
+              ? issue.message
+              : "Your conversation could not load.",
+          );
+      });
+    return () => {
+      active.current = false;
+      controller.abort();
+    };
+  }, [transport]);
+  const send = async () => {
+    const original = pending.current ?? {
+      text: text.trim(),
+      requestId: crypto.randomUUID(),
+    };
+    if (!original.text || busy) return;
+    pending.current = original;
+    setBusy(true);
+    setError(null);
+    try {
+      const value = await transport.message(original.text, original.requestId);
+      if (!active.current) return;
+      setConversation(value);
+      setText("");
+      pending.current = null;
+      onChange();
+    } catch (issue) {
+      if (active.current)
+        setError(
+          issue instanceof Error
+            ? issue.message
+            : "The outcome is unavailable. Retry the same message.",
+        );
+    } finally {
+      if (active.current) setBusy(false);
+    }
+  };
+  return (
+    <section className="nw-conversation" aria-labelledby={`${inputId}-heading`}>
+      <div className="nw-conversation-heading">
+        <h2 id={`${inputId}-heading`}>Talk to the Network</h2>
+        <span className="nw-chip">Local scripted preview</span>
+      </div>
+      <p className="nw-muted">
+        Private conversation with synthetic local messages. Review proposed
+        facts in your profile before confirming or sharing them.
+      </p>
+      {conversation && !conversation.onboarding.complete && (
+        <p className="nw-muted">
+          Onboarding:{" "}
+          {Math.min(
+            conversation.onboarding.exchange,
+            conversation.onboarding.total,
+          )}{" "}
+          of {conversation.onboarding.total} exchanges. Your progress is saved.
+        </p>
+      )}
+      <ol
+        className="nw-conversation-messages"
+        aria-label="Private conversation history"
+        // biome-ignore lint/a11y/noNoninteractiveTabindex: Scrollable history needs keyboard access while preserving list semantics.
+        tabIndex={0}
+      >
+        {conversation?.messages.map((message) => (
+          <li
+            key={message.id}
+            className={`nw-message nw-message-${message.role}`}
+          >
+            <strong>{message.role === "member" ? "You" : "The Network"}</strong>
+            <p className="nw-message-text">{message.text}</p>
+            <time dateTime={message.createdAt}>
+              {new Date(message.createdAt).toLocaleString()}
+            </time>
+          </li>
+        ))}
+      </ol>
+      {error && (
+        <p role="alert" className="nw-error-state">
+          {error}
+        </p>
+      )}
+      <form
+        onSubmit={(event) => {
+          event.preventDefault();
+          void send();
+        }}
+      >
+        <label htmlFor={inputId}>Your message</label>
+        <textarea
+          id={inputId}
+          value={text}
+          onChange={(event) => setText(event.target.value)}
+          maxLength={30000}
+          required
+          disabled={busy || pending.current !== null}
+          rows={3}
+        />
+        <Button
+          unstyled
+          className="nw-button nw-button-primary"
+          type="submit"
+          disabled={busy || !text.trim()}
+        >
+          {busy
+            ? "Sending…"
+            : pending.current
+              ? "Retry same message"
+              : "Send message"}
+        </Button>
+      </form>
+      <details className="nw-conversation-help">
+        <summary>Try the local preview</summary>
+        <p>
+          Try “I enjoy guitar”, “I can offer guitar lessons”, “ask: find a
+          public music activity”, “show my profile”, or “pause outreach”. This
+          scripted preview does not qualify live model understanding.
+        </p>
+      </details>
+    </section>
+  );
+}
