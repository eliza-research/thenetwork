+    for (const artifact of [artifacts.parquet, ...Object.values(artifacts.notebooks)])
+      expect(readPrivateMediaBytes(artifact.fileName)).not.toBeNull();
+    expect(await data.invalidateDeleted()).toBe(0);
+    await host.domain.command(
+      { type: "member", memberId: member.memberId },
+      { type: "delete_account", requestId: "v2-source-deletion", memberId: member.memberId },
