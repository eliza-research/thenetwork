+import type { OpportunityKind } from "../domain/types.js";
+import type { GeneratorKind } from "./types.js";
+
+export function opportunityKind(generator: GeneratorKind, participants: number): OpportunityKind {
+  switch (generator) {
+    case "event_anchor":
+      return "event";
+    case "help":
+      return "help";
+    case "welcome":
+      return "welcome";
+    case "growth":
+      return "growth";
+    case "warm_path":
+      return "member_intro";
+    default:
+      return participants > 2 ? "group" : "intro";
+  }
+}
