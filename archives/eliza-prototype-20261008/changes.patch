+import type { UUID } from "@elizaos/core";
+import { type CarveOutSqlExecutor, sqlQuote } from "@elizaos/plugin-sql";
+
+/** Joins a trusted private-room erasure transaction; trajectory FKs own all child captures. */
+export async function erasePrivateRoomTrajectories(
+  execute: CarveOutSqlExecutor,
+  input: { agentId: UUID; roomId: UUID },
+): Promise<void> {
+  const tables = await execute(
+    "SELECT to_regclass('public.trajectories') AS trajectories",
+  );
+  if (!tables[0]?.trajectories) return;
+  await execute(
+    `DELETE FROM trajectories WHERE agent_id=${sqlQuote(input.agentId)} AND metadata_json->>'roomId'=${sqlQuote(input.roomId)}`,
+  );
+}
