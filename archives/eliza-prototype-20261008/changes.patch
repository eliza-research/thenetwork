+/** Retained authenticated operational labels; agreement is not ground-truth review precision. */
+export function summarizeNetworkReviewOperations(events: NetworkAdminSnapshot["events"]) {
+  const labels: Array<{
+    opportunityId: string;
+    revision: number;
+    reviewerId: string;
+    decision: "approved" | "rejected" | "reroll";
+    source: "primary" | "blind";
+    durationMs: number | null;
+  }> = [];
+  const seen = new Set<string>();
+  let unattributedLabels = 0;
+  for (const event of events) {
+    if (!["review_opportunity", "record_blind_review"].includes(event.kind) || seen.has(event.id))
+      continue;
+    seen.add(event.id);
+    const revision = event.details.opportunityRevision;
+    const decision = event.details.decision;
+    if (
+      event.actor.type !== "staff" ||
+      !event.actor.userId ||
+      !event.actor.roles.some((role) => role === "admin" || role === "reviewer") ||
+      !event.opportunityId ||
+      typeof revision !== "number" ||
+      !Number.isSafeInteger(revision) ||
+      revision < 1 ||
+      !Number.isFinite(Date.parse(event.at)) ||
+      (decision !== "approved" && decision !== "rejected" && decision !== "reroll")
+    ) {
+      unattributedLabels++;
+      continue;
+    }
+    const duration = event.details.durationMs;
+    labels.push({
+      opportunityId: event.opportunityId,
+      revision,
+      reviewerId: event.actor.userId,
+      decision,
+      source: event.kind === "review_opportunity" ? "primary" : "blind",
+      durationMs:
+        typeof duration === "number" &&
+        Number.isSafeInteger(duration) &&
+        duration >= 0 &&
+        duration <= 12 * 3600000 &&
+        (event.details.durationSource === "network_clock" ||
+          event.details.durationSource === "reviewer_entered")
+          ? duration
+          : null,
+    });
+  }
+  const primary = new Map<string, typeof labels>();
+  for (const label of labels.filter((label) => label.source === "primary")) {
+    const key = JSON.stringify([label.opportunityId, label.revision]);
+    primary.set(key, [...(primary.get(key) ?? []), label]);
+  }
+  const qualified = labels.filter((label) => label.source === "primary");
+  const blindSeen = new Set<string>();
+  let pairedBlindLabels = 0,
+    matchingBlindLabels = 0,
+    unmatchedBlindLabels = 0,
+    selfBlindLabelsExcluded = 0,
+    duplicateBlindLabelsExcluded = 0;
+  for (const label of labels.filter((label) => label.source === "blind")) {
+    const key = JSON.stringify([label.opportunityId, label.revision]);
+    const reviewers = primary.get(key) ?? [];
+    if (reviewers.some((primary) => primary.reviewerId === label.reviewerId)) {
+      selfBlindLabelsExcluded++;
+      continue;
+    }
+    const voteKey = JSON.stringify([label.opportunityId, label.revision, label.reviewerId]);
+    if (blindSeen.has(voteKey)) {
+      duplicateBlindLabelsExcluded++;
+      continue;
+    }
+    blindSeen.add(voteKey);
+    qualified.push(label);
+    if (reviewers.length !== 1) {
+      unmatchedBlindLabels++;
+      continue;
+    }
+    pairedBlindLabels++;
+    if (reviewers[0]!.decision === label.decision) matchingBlindLabels++;
+  }
+  const reviewers = new Map<
+    string,
+    {
+      reviewerId: string;
+      primaryLabels: number;
+      blindLabels: number;
+      measuredTimeItems: number;
+      missingTimeItems: number;
+      totalDurationMs: number;
+    }
+  >();
+  for (const label of qualified) {
+    const row = reviewers.get(label.reviewerId) ?? {
+      reviewerId: label.reviewerId,
+      primaryLabels: 0,
+      blindLabels: 0,
+      measuredTimeItems: 0,
+      missingTimeItems: 0,
+      totalDurationMs: 0,
+    };
+    if (label.source === "primary") row.primaryLabels++;
+    else row.blindLabels++;
+    if (label.durationMs === null) row.missingTimeItems++;
+    else {
+      row.measuredTimeItems++;
+      row.totalDurationMs += label.durationMs;
+    }
+    reviewers.set(row.reviewerId, row);
+  }
+  const rows = [...reviewers.values()].sort((a, b) => a.reviewerId.localeCompare(b.reviewerId));
+  const measuredTimeItems = rows.reduce((sum, row) => sum + row.measuredTimeItems, 0);
+  const totalDurationMs = rows.reduce((sum, row) => sum + row.totalDurationMs, 0);
+  return {
+    definition:
+      "All retained authenticated staff opportunity review events; counts are operational throughput. Independent exact-revision decision agreement is not precision or model calibration.",
+    primaryLabels: qualified.filter((label) => label.source === "primary").length,
+    blindLabels: qualified.filter((label) => label.source === "blind").length,
+    unattributedLabels,
+    reviewers: rows.map((row) => ({
+      ...row,
+      meanDurationMs: row.measuredTimeItems ? row.totalDurationMs / row.measuredTimeItems : null,
+    })),
+    time: {
+      measuredTimeItems,
+      missingTimeItems: qualified.length - measuredTimeItems,
+      totalDurationMs,
+      meanDurationMs: measuredTimeItems ? totalDurationMs / measuredTimeItems : null,
+      definition:
+        "Only bounded durationMs with recorded network_clock or reviewer_entered provenance; missing or unqualified legacy values stay missing.",
+    },
+    agreement: {
+      ...metricRate(matchingBlindLabels, pairedBlindLabels),
+      unmatchedBlindLabels,
+      selfBlindLabelsExcluded,
+      duplicateBlindLabelsExcluded,
+      definition:
+        "One independent staff blind label paired with exactly one primary label for the same opportunity and revision. Ambiguous/missing primary revisions are unpaired.",
+    },
+  };
+}
