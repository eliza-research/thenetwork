+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createNetworkWorkbenchTransport,
+  NETWORK_ADMIN_MODULES,
+  NetworkTransportError,
+} from "./api";
+
+afterEach(() => vi.unstubAllGlobals());
+
+function respond(body: unknown, status = 200) {
+  const fetcher = vi.fn().mockResolvedValue(
+    new Response(JSON.stringify(body), {
+      status,
+      headers: { "Content-Type": "application/json" },
+    }),
+  );
+  vi.stubGlobal("fetch", fetcher);
+  return fetcher;
+}
+
+describe("Network workbench authenticated browser transport", () => {
+  it("sends only the fixture identifier when selecting a signed local session", async () => {
+    const fetcher = respond({ ok: true });
+    await createNetworkWorkbenchTransport().selectFixture("member-sf");
+    const [path, init] = fetcher.mock.calls[0];
+    expect(path).toBe("/api/network/local/session");
+    expect(JSON.parse(init.body)).toEqual({ fixtureId: "member-sf" });
+    expect(init.credentials).toBe("same-origin");
+  });
+  it("does not take client member or role authority for member reads", async () => {
+    const fetcher = respond({ member: { id: "member-sf" }, sections: [] });
+    await createNetworkWorkbenchTransport().member();
+    expect(fetcher.mock.calls[0][0]).toBe("/api/network/view");
+  });
+  it("preserves command identity and receipt while preventing args from replacing the command type", async () => {
+    const receipt = { message: "Saved", result: { revision: 2 } };
+    const fetcher = respond(receipt);
+    const result = await createNetworkWorkbenchTransport().command(
+      {
+        type: "set_preferences",
+        label: "Save preferences",
+        fields: [],
+        args: { memberId: "m1", type: "bad-command", requestId: "bad-key" },
+      },
+      { proactiveOptIn: false },
+      "same-request",
+    );
+    expect(result).toEqual(receipt);
+    expect(JSON.parse(fetcher.mock.calls[0][1].body)).toEqual({
+      memberId: "m1",
+      type: "set_preferences",
+      requestId: "same-request",
+      proactiveOptIn: false,
+    });
+  });
+  it("retains an explicit denied response instead of returning an empty view", async () => {
+    respond({ error: "This identity cannot access raw evidence." }, 403);
+    await expect(
+      createNetworkWorkbenchTransport().admin("safety"),
+    ).rejects.toMatchObject({
+      status: 403,
+      message: "This identity cannot access raw evidence.",
+    });
+  });
+  it("encodes server filters while retaining the selected module and signed-session authority", async () => {
+    const fetcher = respond({
+      module: "metrics",
+      title: "Metrics",
+      summary: "",
+      metrics: [],
+      rows: [],
+      actions: [],
+    });
+    await createNetworkWorkbenchTransport().admin("metrics", undefined, {
+      city: "SF",
+      memberId: "member & one",
+      module: "audit",
+    });
+    const [path, init] = fetcher.mock.calls[0];
+    const parameters = new URL(path, "http://127.0.0.1").searchParams;
+    expect(parameters.get("module")).toBe("metrics");
+    expect(parameters.get("city")).toBe("SF");
+    expect(parameters.get("memberId")).toBe("member & one");
+    expect(init.credentials).toBe("same-origin");
+  });
+  it("rejects malformed actions before presenting a broken command form", async () => {
+    respond({
+      member: { id: "m1" },
+      sections: [
+        {
+          id: "profile",
+          title: "Profile",
+          rows: [],
+          actions: [
+            {
+              type: "set_fact",
+              label: "Save",
+              fields: [{ name: "fact", label: "Fact", type: "script" }],
+            },
+          ],
+        },
+      ],
+    });
+    await expect(
+      createNetworkWorkbenchTransport().member(),
+    ).rejects.toBeInstanceOf(NetworkTransportError);
+  });
+  it("reports invalid JSON and connection failures separately", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(new Response("not json", { status: 200 })),
+    );
+    await expect(createNetworkWorkbenchTransport().fixtures()).rejects.toThrow(
+      "unreadable response",
+    );
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockRejectedValue(new Error("connection refused")),
+    );
+    await expect(createNetworkWorkbenchTransport().fixtures()).rejects.toThrow(
+      "could not be reached",
+    );
+  });
+  it("exposes all seventeen PRD operations modules with stable unique identifiers", () => {
+    expect(NETWORK_ADMIN_MODULES).toHaveLength(17);
+    expect(new Set(NETWORK_ADMIN_MODULES.map(([id]) => id)).size).toBe(17);
+  });
+});
diff --git a/packages/ui/src/network/api.ts b/packages/ui/src/network/api.ts
new file mode 100644
index 000000000000..ed4302b5e6c9
--- /dev/null
+++ b/packages/ui/src/network/api.ts
@@ -0,0 +1,341 @@
+/** Browser transport for the local Network workbench. Authority stays with the host. */
+import type {
+  NetworkAction,
+  NetworkAdminView,
+  NetworkCommandReceipt,
+  NetworkConversationView,
+  NetworkFieldValue,
+  NetworkFixture,
+  NetworkGraph,
+  NetworkMemberView,
+  NetworkRow,
+} from "@elizaos/contracts/network-workbench";
+
+export {
+  NETWORK_ADMIN_MODULES,
+  type NetworkAction,
+  type NetworkActionField,
+  type NetworkAdminView,
+  type NetworkCommandReceipt,
+  type NetworkConversationView,
+  type NetworkFieldValue,
+  type NetworkFixture,
+  type NetworkGraph,
+  type NetworkMemberView,
+  type NetworkMetric,
+  type NetworkRow,
+  type NetworkSection,
+} from "@elizaos/contracts/network-workbench";
+
+export interface NetworkWorkbenchTransport {
+  fixtures(signal?: AbortSignal): Promise<NetworkFixture[]>;
+  selectFixture(fixtureId: string): Promise<void>;
+  member(signal?: AbortSignal): Promise<NetworkMemberView>;
+  conversation(signal?: AbortSignal): Promise<NetworkConversationView>;
+  message(text: string, requestId: string): Promise<NetworkConversationView>;
+  admin(
+    module: string,
+    signal?: AbortSignal,
+    query?: Record<string, string>,
+  ): Promise<NetworkAdminView>;
+  command(
+    action: NetworkAction,
+    values: Record<string, NetworkFieldValue>,
+    requestId: string,
+  ): Promise<NetworkCommandReceipt>;
+}
+
+export class NetworkTransportError extends Error {
+  constructor(
+    message: string,
+    readonly status?: number,
+  ) {
+    super(message);
+    this.name = "NetworkTransportError";
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function conversationView(value: unknown): NetworkConversationView {
+  if (
+    !isRecord(value) ||
+    value.mode !== "scripted_local" ||
+    !Array.isArray(value.messages) ||
+    !value.messages.every(
+      (message) =>
+        isRecord(message) &&
+        typeof message.id === "string" &&
+        (message.role === "member" || message.role === "network") &&
+        typeof message.text === "string" &&
+        typeof message.createdAt === "string" &&
+        Number.isFinite(Date.parse(message.createdAt)),
+    ) ||
+    !isRecord(value.onboarding) ||
+    !Number.isSafeInteger(value.onboarding.exchange) ||
+    Number(value.onboarding.exchange) < 0 ||
+    !Number.isSafeInteger(value.onboarding.total) ||
+    Number(value.onboarding.total) < 1 ||
+    typeof value.onboarding.complete !== "boolean"
+  )
+    throw new NetworkTransportError(
+      "The server returned an invalid private conversation.",
+    );
+  return value as unknown as NetworkConversationView;
+}
+
+function validAction(value: unknown): value is NetworkAction {
+  const fieldTypes = [
+    "text",
+    "textarea",
+    "number",
+    "select",
+    "checkbox",
+    "datetime-local",
+  ];
+  return (
+    isRecord(value) &&
+    typeof value.type === "string" &&
+    typeof value.label === "string" &&
+    (value.args === undefined || isRecord(value.args)) &&
+    (value.confirm === undefined || typeof value.confirm === "string") &&
+    Array.isArray(value.fields) &&
+    value.fields.every(
+      (field) =>
+        isRecord(field) &&
+        typeof field.name === "string" &&
+        typeof field.label === "string" &&
+        typeof field.type === "string" &&
+        fieldTypes.includes(field.type) &&
+        (field.required === undefined || typeof field.required === "boolean") &&
+        (field.help === undefined || typeof field.help === "string") &&
+        (field.value === undefined ||
+          field.value === null ||
+          typeof field.value === "string" ||
+          typeof field.value === "boolean" ||
+          (typeof field.value === "number" && Number.isFinite(field.value))) &&
+        (field.options === undefined ||
+          (Array.isArray(field.options) &&
+            field.options.every(
+              (option) =>
+                isRecord(option) &&
+                typeof option.label === "string" &&
+                typeof option.value === "string",
+            ))),
+    )
+  );
+}
+
+function validRows(value: unknown): value is NetworkRow[] {
+  return (
+    Array.isArray(value) &&
+    value.every(
+      (row) =>
+        isRecord(row) &&
+        typeof row.id === "string" &&
+        typeof row.title === "string" &&
+        (row.subtitle === undefined || typeof row.subtitle === "string") &&
+        (row.status === undefined || typeof row.status === "string") &&
+        isRecord(row.fields) &&
+        (row.actions === undefined ||
+          (Array.isArray(row.actions) && row.actions.every(validAction))),
+    )
+  );
+}
+
+function validGraph(value: unknown): value is NetworkGraph {
+  if (
+    !isRecord(value) ||
+    !Array.isArray(value.nodes) ||
+    !Array.isArray(value.edges)
+  )
+    return false;
+  if (
+    !value.nodes.every(
+      (node) =>
+        isRecord(node) &&
+        typeof node.id === "string" &&
+        typeof node.label === "string" &&
+        typeof node.x === "number" &&
+        Number.isFinite(node.x) &&
+        typeof node.y === "number" &&
+        Number.isFinite(node.y),
+    )
+  )
+    return false;
+  const ids = new Set(
+    value.nodes.map((node) => (node as Record<string, unknown>).id),
+  );
+  return (
+    ids.size === value.nodes.length &&
+    value.edges.every(
+      (edge) =>
+        isRecord(edge) &&
+        typeof edge.id === "string" &&
+        typeof edge.source === "string" &&
+        typeof edge.target === "string" &&
+        ids.has(edge.source) &&
+        ids.has(edge.target) &&
+        (edge.label === undefined || typeof edge.label === "string") &&
+        (edge.status === undefined || typeof edge.status === "string"),
+    )
+  );
+}
+
+export async function request(
+  path: string,
+  init?: RequestInit,
+): Promise<unknown> {
+  let response: Response;
+  try {
+    response = await fetch(path, {
+      credentials: "same-origin",
+      cache: "no-store",
+      ...init,
+    });
+  } catch (error) {
+    if (error instanceof Error && error.name === "AbortError") throw error;
+    throw new NetworkTransportError(
+      "The local server could not be reached. Check that it is running, then retry.",
+    );
+  }
+  let body: unknown;
+  try {
+    body = await response.json();
+  } catch {
+    throw new NetworkTransportError(
+      "The server returned an unreadable response. Reload or inspect the server log.",
+      response.status,
+    );
+  }
+  if (!response.ok) {
+    const message =
+      isRecord(body) && typeof body.error === "string"
+        ? body.error
+        : `The request failed (${response.status}).`;
+    throw new NetworkTransportError(message, response.status);
+  }
+  return body;
+}
+
+export function createNetworkWorkbenchTransport(): NetworkWorkbenchTransport {
+  return {
+    async conversation(signal) {
+      return conversationView(
+        await request("/api/network/conversation", { signal }),
+      );
+    },
+    async message(text, requestId) {
+      return conversationView(
+        await request("/api/network/message", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ text, requestId }),
+        }),
+      );
+    },
+    async fixtures(signal) {
+      const body = await request("/api/network/local/sessions", { signal });
+      const fixtures = Array.isArray(body)
+        ? body
+        : isRecord(body)
+          ? body.fixtures
+          : undefined;
+      if (
+        !Array.isArray(fixtures) ||
+        !fixtures.every(
+          (fixture) =>
+            isRecord(fixture) &&
+            typeof fixture.id === "string" &&
+            typeof fixture.name === "string",
+        )
+      ) {
+        throw new NetworkTransportError(
+          "The server returned an invalid fixture list.",
+        );
+      }
+      return fixtures as NetworkFixture[];
+    },
+    async selectFixture(fixtureId) {
+      await request("/api/network/local/session", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ fixtureId }),
+      });
+    },
+    async member(signal) {
+      const body = await request("/api/network/view", { signal });
+      if (
+        !isRecord(body) ||
+        !isRecord(body.member) ||
+        typeof body.member.id !== "string" ||
+        !Array.isArray(body.sections) ||
+        !body.sections.every(
+          (section) =>
+            isRecord(section) &&
+            typeof section.id === "string" &&
+            typeof section.title === "string" &&
+            validRows(section.rows) &&
+            (section.actions === undefined ||
+              (Array.isArray(section.actions) &&
+                section.actions.every(validAction))),
+        ) ||
+        (body.actions !== undefined &&
+          (!Array.isArray(body.actions) || !body.actions.every(validAction)))
+      ) {
+        throw new NetworkTransportError(
+          "The server returned an invalid member view.",
+        );
+      }
+      return body as unknown as NetworkMemberView;
+    },
+    async admin(module, signal, query) {
+      const parameters = new URLSearchParams({ ...query, module });
+      const body = await request(
+        `/api/network/admin?${parameters.toString()}`,
+        { signal },
+      );
+      if (
+        !isRecord(body) ||
+        body.module !== module ||
+        (body.graph !== undefined && !validGraph(body.graph)) ||
+        typeof body.title !== "string" ||
+        !validRows(body.rows) ||
+        !Array.isArray(body.metrics) ||
+        !body.metrics.every(
+          (metric) =>
+            isRecord(metric) &&
+            typeof metric.label === "string" &&
+            (typeof metric.value === "string" ||
+              typeof metric.value === "number"),
+        ) ||
+        !Array.isArray(body.actions) ||
+        !body.actions.every(validAction)
+      ) {
+        throw new NetworkTransportError(
+          "The server returned an invalid operations view.",
+        );
+      }
+      return body as unknown as NetworkAdminView;
+    },
+    async command(action, values, requestId) {
+      const body = await request("/api/network/command", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          ...action.args,
+          ...values,
+          type: action.type,
+          requestId,
+        }),
+      });
+      if (!isRecord(body))
+        throw new NetworkTransportError(
+          "The server returned an invalid command receipt.",
+        );
+      return body;
+    },
+  };
+}
