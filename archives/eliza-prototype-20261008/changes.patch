@@ -0,0 +1,544 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, expect, it } from "vitest";
+import type { NetworkActor, OpportunityDraft, StaffRole } from "../domain/types.ts";
+import { parseNetworkCommand } from "../domain/validation.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { executeWorkbenchCommand } from "./application.ts";
+import { createLocalNetworkHost } from "./host.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T19:00:00.000Z"));
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let alice: string, bob: string, outsider: string;
+const staff = (userId: string, role: StaffRole): NetworkActor => ({
+  type: "staff",
+  userId,
+  roles: [role],
+});
+const own = (memberId: string): NetworkActor => ({ type: "member", memberId });
+const admin = staff("administrator", "admin");
+const primary = staff("primary-reviewer", "reviewer");
+const secondary = staff("independent-reviewer", "reviewer");
+const safety = staff("safety-reviewer", "safety");
+const rubric = {
+  tone: "pass",
+  clarity: "pass",
+  explanation: "pass",
+  timing: "pass",
+  privacy: "pass",
+};
+
+beforeAll(async () => {
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:review-safety:" + randomUUID(),
+    clock,
+  });
+  const personas = await seedSimulationMembers(host.domain, 6, 17);
+  const local = personas.filter((persona) => persona.city === "SF");
+  [alice, bob, outsider] = local.map((persona) => persona.memberId);
+}, 120_000);
+afterAll(async () => {
+  await host?.close();
+});
+
+async function proposal(id: string) {
+  const draft: OpportunityDraft = {
+    id,
+    kind: "intro",
+    objective: "A public music conversation " + id,
+    category: "music",
+    city: "SF",
+    participantIds: [alice, bob],
+    backupIds: [],
+    quorum: 2,
+    expiresAt: new Date(clock.now().getTime() + 48 * 3_600_000).toISOString(),
+    explanations: {
+      [alice]: { text: "A public music chat", factIds: [] },
+      [bob]: { text: "A public music chat", factIds: [] },
+    },
+    safetyClass: "low",
+    requiresHomeEntry: false,
+    acquaintedHelperIds: [],
+    anchorEventId: null,
+  };
+  await host.domain.command(admin, {
+    type: "create_opportunity",
+    requestId: id + ":create",
+    draft,
+  });
+  return host.domain.getOpportunity(admin, id);
+}
+async function connect(id: string) {
+  await proposal(id);
+  await host.domain.command(
+    primary,
+    parseNetworkCommand({
+      type: "review_opportunity",
+      requestId: id + ":approve",
+      opportunityId: id,
+      expectedRevision: 1,
+      decision: "approved",
+      reasonCode: "approved",
+      note: "",
+      rubric,
+    }),
+  );
+  for (const memberId of [alice, bob]) {
+    await host.domain.command(admin, {
+      type: "invite_participant",
+      requestId: id + ":invite:" + memberId,
+      opportunityId: id,
+      expectedRevision: 1,
+      memberId,
+    });
+    await host.domain.command(own(memberId), {
+      type: "respond_opportunity",
+      requestId: id + ":accept:" + memberId,
+      opportunityId: id,
+      expectedRevision: 1,
+      memberId,
+      accept: true,
+      disclosure: { revision: 1, factIds: [], contact: false, preciseVenue: false },
+    });
+  }
+}
+const execute = (actor: NetworkActor, input: Record<string, unknown>) =>
+  executeWorkbenchCommand(host, clock, actor, { requestId: randomUUID(), ...input });
+
+it("self-assigns the actual reviewer, tightens SLA without extending it, and records real Clock review duration", async () => {
+  const id = "clock-review";
+  await proposal(id);
+  await host.domain.command(
+    primary,
+    parseNetworkCommand({
+      type: "start_review",
+      requestId: id + ":start",
+      opportunityId: id,
+      expectedRevision: 1,
+      priority: "same_day",
+    }),
+  );
+  const started = await host.domain.getOpportunity(admin, id);
+  expect(started).toHaveProperty("reviewWork.assigneeId", "primary-reviewer");
+  expect(started).toHaveProperty(
+    "reviewDeadline",
+    new Date(clock.now().getTime() + 3_600_000).toISOString(),
+  );
+  await expect(
+    host.domain.command(
+      secondary,
+      parseNetworkCommand({
+        type: "start_review",
+        requestId: id + ":steal",
+        opportunityId: id,
+        expectedRevision: 1,
+        priority: "standard",
+      }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+  await expect(
+    host.domain.command(
+      primary,
+      parseNetworkCommand({
+        type: "start_review",
+        requestId: id + ":downgrade",
+        opportunityId: id,
+        expectedRevision: 1,
+        priority: "standard",
+      }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+  clock.advanceTo(clock.now().getTime() + 2500);
+  await host.domain.command(
+    primary,
+    parseNetworkCommand({
+      type: "review_opportunity",
+      requestId: id + ":submit",
+      opportunityId: id,
+      expectedRevision: 1,
+      decision: "approved",
+      reasonCode: "approved",
+      note: "",
+      rubric,
+    }),
+  );
+  const reviewed = await host.domain.getOpportunity(admin, id);
+  expect(reviewed).toHaveProperty("review.durationMs", 2500);
+  expect(reviewed).toHaveProperty("review.durationSource", "network_clock");
+  const snapshot = await host.domain.adminView(admin);
+  expect(snapshot.events.find((event) => event.id === id + ":submit")?.details).toMatchObject({
+    durationMs: 2500,
+    durationSource: "network_clock",
+  });
+});
+
+it("requires independent exact-revision blind labels and exposes no primary state, vote or participant outcome", async () => {
+  const id = "blind-review";
+  await proposal(id);
+  await host.domain.command(
+    primary,
+    parseNetworkCommand({
+      type: "review_opportunity",
+      requestId: id + ":primary",
+      opportunityId: id,
+      expectedRevision: 1,
+      decision: "approved",
+      reasonCode: "approved",
+      note: "Primary assessment",
+      rubric,
+    }),
+  );
+  await expect(
+    execute(primary, { type: "blind_review_view", opportunityId: id, expectedRevision: 1 }),
+  ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+  const view = await execute(secondary, {
+    type: "blind_review_view",
+    opportunityId: id,
+    expectedRevision: 1,
+  });
+  expect(view.result).not.toHaveProperty("review");
+  expect(view.result).not.toHaveProperty("state");
+  expect(view.result).not.toHaveProperty("participants");
+  await host.domain.command(
+    secondary,
+    parseNetworkCommand({
+      type: "record_blind_review",
+      requestId: id + ":vote",
+      opportunityId: id,
+      expectedRevision: 1,
+      decision: "rejected",
+      reasonCode: "wrong_timing",
+      note: "Calibration only",
+      rubric,
+      durationMs: 1200,
+    }),
+  );
+  const record = await host.domain.getOpportunity(admin, id);
+  expect(record).toHaveProperty("state", "approved");
+  expect(record).toHaveProperty("review.decision", "approved");
+  expect(record).toHaveProperty("blindReviews.0.reviewerId", "independent-reviewer");
+  await expect(
+    host.domain.command(
+      secondary,
+      parseNetworkCommand({
+        type: "record_blind_review",
+        requestId: id + ":duplicate",
+        opportunityId: id,
+        expectedRevision: 1,
+        decision: "approved",
+        reasonCode: "approved",
+        note: "",
+        rubric,
+      }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+  await expect(
+    execute(staff("other-reviewer", "reviewer"), {
+      type: "blind_review_view",
+      opportunityId: id,
+      expectedRevision: 2,
+    }),
+  ).rejects.toMatchObject({ code: "NETWORK_CONFLICT" });
+});
+
+it("keeps explicitly flagged relay content off recipient views/native delivery until purpose-bound safety release", async () => {
+  const id = "held-relay";
+  await connect(id);
+  const messageId = "held-message";
+  const result = await execute(own(alice), {
+    type: "relay",
+    requestId: messageId,
+    opportunityId: id,
+    revision: 1,
+    body: "HELD_ONLY_THIS_TEST",
+    holdForSafety: true,
+  });
+  const caseId = (result.result as { moderation?: { caseId: string } }).moderation!.caseId;
+  expect((await host.coordination.view(own(bob), id)).messages).toHaveLength(0);
+  expect(
+    (await host.transport.messages()).filter((message) =>
+      message.idempotencyKey.includes("network:relay:" + messageId + ":"),
+    ),
+  ).toHaveLength(0);
+  const masked = await host.domain.adminView(safety);
+  expect(masked.safetyCases.find((item) => item.id === caseId)?.evidence).toBe("");
+  await expect(
+    execute(safety, {
+      type: "moderate_relay",
+      opportunityId: id,
+      revision: 1,
+      messageId,
+      caseId,
+      decision: "released",
+      reason: "Reviewed for forwarding",
+    }),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  await expect(
+    execute(staff("analyst", "analyst"), {
+      type: "reveal_safety_case",
+      caseId,
+      purpose: "Investigate exact held relay",
+    }),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  const reveal = await execute(safety, {
+    type: "reveal_safety_case",
+    caseId,
+    purpose: "Investigate exact held relay",
+  });
+  expect(reveal.result).toHaveProperty("evidence", expect.stringContaining("HELD_ONLY_THIS_TEST"));
+  const request = {
+    type: "moderate_relay",
+    requestId: "release-once",
+    opportunityId: id,
+    revision: 1,
+    messageId,
+    caseId,
+    decision: "released",
+    reason: "Human reviewed",
+  };
+  await execute(safety, request);
+  await execute(safety, request);
+  const deliveries = (await host.transport.messages()).filter((message) =>
+    message.idempotencyKey.includes("network:relay:" + messageId + ":"),
+  );
+  expect(deliveries).toHaveLength(1);
+  expect(deliveries[0]?.body).toContain("HELD_ONLY_THIS_TEST");
+  expect((await host.coordination.view(own(bob), id)).messages).toHaveLength(1);
+  expect(
+    (await host.domain.adminView(safety)).events.some(
+      (event) => event.kind === "restricted_safety_case_reveal" && event.details.caseId === caseId,
+    ),
+  ).toBe(true);
+});
+
+it("fences private source references and own appeals, and identifies appeal generations independently of an unchanged Clock", async () => {
+  const id = "appeal-case";
+  await connect(id);
+  const held = await execute(own(alice), {
+    type: "relay",
+    requestId: "appeal-message",
+    opportunityId: id,
+    revision: 1,
+    body: "APPEAL_PRIVATE_SOURCE",
+    holdForSafety: true,
+  });
+  const caseId = (held.result as { moderation?: { caseId: string } }).moderation!.caseId;
+  await expect(
+    host.domain.command(
+      own(outsider),
+      parseNetworkCommand({
+        type: "report_member",
+        requestId: "foreign-source",
+        memberId: outsider,
+        caseId: "foreign-case",
+        reportedId: null,
+        reason: "Report",
+        evidence: "Attached",
+        evidenceRef: { opportunityId: id, messageId: "appeal-message" },
+        placeHold: false,
+      }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  await expect(
+    host.domain.command(
+      own(bob),
+      parseNetworkCommand({
+        type: "appeal_safety",
+        requestId: "not-party",
+        memberId: bob,
+        caseId,
+        reason: "Not a case party",
+      }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_FORBIDDEN" });
+  await host.domain.command(
+    own(alice),
+    parseNetworkCommand({
+      type: "appeal_safety",
+      requestId: "appeal-one",
+      memberId: alice,
+      caseId,
+      reason: "Please reconsider",
+    }),
+  );
+  await expect(
+    host.domain.command(
+      primary,
+      parseNetworkCommand({
