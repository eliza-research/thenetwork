+import { describe, expect, it } from "vitest";
+import { defaults } from "../domain/policy.js";
+import type { ProfileFact } from "../domain/types.js";
+import { candidateEligibility, DEFAULT_MATCHING_CONFIG } from "./engine.js";
+import { projectSavedMatchingConstraints } from "./local-constraints.js";
+import { DAY, NOW, testInput } from "./test-fixtures.js";
+
+const fact = (startAt: string, endAt: string): ProfileFact => ({
+  id: "availability",
+  kind: "stated_availability",
+  value: JSON.stringify({
+    version: 1,
+    startAt,
+    endAt,
+    validUntil: new Date(NOW + 10 * DAY).toISOString(),
+  }),
+  tags: [],
+  scope: "matching",
+  source: "member",
+  sourceRef: "authored",
+  confidence: 1,
+  status: "confirmed",
+  revision: 1,
+  updatedAt: new Date(NOW).toISOString(),
+});
+describe("current saved constraints in every matcher projection", () => {
+  it("excludes a current disjoint statement without pretending unknown sources are busy", () => {
+    const input = testInput(2),
+      member = input.members[0]!;
+    Object.assign(
+      member,
+      projectSavedMatchingConstraints(
+        {
+          memberId: member.memberId,
+          revision: 1,
+          preferences: defaults("SF"),
+          facts: [
+            fact(new Date(NOW + 3 * DAY).toISOString(), new Date(NOW + 4 * DAY).toISOString()),
+          ],
+        },
+        input.window,
+        NOW,
+      ),
+    );
+    expect(member.availabilityCoverage).toBe("complete");
+    expect(
+      candidateEligibility(input, input.members, "music", input.window, DEFAULT_MATCHING_CONFIG),
+    ).toContain("unavailable");
+    Object.assign(
+      member,
+      projectSavedMatchingConstraints(
+        { memberId: member.memberId, revision: 1, preferences: defaults("SF"), facts: [] },
+        input.window,
+        NOW,
+      ),
+    );
+    expect(member.availabilityCoverage).toBe("unknown");
+    expect(
+      candidateEligibility(input, input.members, "music", input.window, DEFAULT_MATCHING_CONFIG),
+    ).not.toContain("unavailable");
+  });
+  it("uses native anonymous sources for compatible windows and labels capped sampling explicitly", () => {
+    const input = testInput(2),
+      member = input.members[0]!;
+    const prepared = projectSavedMatchingConstraints(
+      {
+        memberId: member.memberId,
+        revision: 1,
+        preferences: defaults("SF"),
+        facts: [fact(new Date(NOW).toISOString(), new Date(NOW + 10 * DAY).toISOString())],
+      },
+      input.window,
+      NOW,
+    );
+    expect(prepared.availabilityCoverage).toBe("complete");
+    expect(prepared.availability).toEqual([input.window]);
+    const sampled = projectSavedMatchingConstraints(
+      {
+        memberId: member.memberId,
+        revision: 1,
+        preferences: defaults("SF"),
+        facts: [fact(new Date(NOW).toISOString(), new Date(NOW + 10 * DAY).toISOString())],
+      },
+      { start: NOW + DAY, end: NOW + 8 * DAY },
+      NOW,
+    );
+    expect(sampled.availabilityCoverage).toBe("sampled");
+    expect(sampled.availability.at(-1)!.end).toBeLessThan(NOW + 8 * DAY);
+  });
+});
