new file mode 100644
index 000000000000..4d405293d029
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/policy/introduction.ts
@@ -0,0 +1,139 @@
+/** Builds pending execution requests from a trusted, current Network projection; never sends. */
+import { createHash } from "node:crypto";
+import { ElizaError } from "@elizaos/core";
+import type { ApprovalEnqueueInput } from "@elizaos/plugin-assistant";
+
+export interface IntroductionMember {
+  memberId: string;
+  subjectUserId: string;
+  channel: "imessage" | "sms";
+  recipient: string;
+  channelVerified: boolean;
+  age: "adult" | "minor" | "unknown";
+  active: boolean;
+  blocked: boolean;
+  acceptedRevision: number | null;
+  disclosureRevision: number | null;
+  /** Exact member-specific text cleared by review and outbound leak checking. */
+  body: string;
+}
+
+/** Host obtains this projection from authoritative records under its transaction. */
+export interface IntroductionProjection {
+  opportunityId: string;
+  revision: number;
+  expiresAt: Date;
+  state: "inviting" | "confirmed" | "cancelled";
+  members: readonly [IntroductionMember, IntroductionMember];
+  review: {
+    decision: "approved" | "rejected" | "pending";
+    revision: number;
+    briefDigest: string;
+  };
+  leakCheck: { revision: number; briefDigest: string; passed: boolean };
+}
+
+/** Binds reviewed text to exact recipients, member subjects, channels and opportunity revision. */
+export function introductionBriefDigest(
+  projection: Pick<IntroductionProjection, "opportunityId" | "revision" | "expiresAt" | "members">,
+): string {
+  return createHash("sha256")
+    .update(
+      JSON.stringify([
+        projection.opportunityId,
+        projection.revision,
+        projection.expiresAt.toISOString(),
+        [...projection.members]
+          .sort((a, b) => (a.memberId < b.memberId ? -1 : a.memberId > b.memberId ? 1 : 0))
+          .map((m) => [m.memberId, m.subjectUserId, m.channel, m.recipient, m.body]),
+      ]),
+    )
+    .digest("hex");
+}
+
+/**
+ * Execution preparation only: reviewer approval never supplies either member's consent.
+ * Call inside the host transaction with current identity, block, consent and disclosure
+ * data, then enqueue via PgApprovalQueue.enqueueTransactional. The eventual dispatcher
+ * must revalidate that authority; this helper does not close the post-commit revoke race.
+ */
+export function prepareIntroductionRequests(
+  projection: IntroductionProjection,
+  now: Date,
+): readonly [ApprovalEnqueueInput, ApprovalEnqueueInput] {
+  const deny = (reason: string): never => {
+    throw new ElizaError(`Network introduction unavailable: ${reason}`, {
+      code: "NETWORK_INTRODUCTION_DENIED",
+    });
+  };
+  if (
+    !projection.opportunityId.trim() ||
+    !Number.isSafeInteger(projection.revision) ||
+    projection.revision < 1
+  )
+    deny("invalid identity or revision");
+  if (
+    !Number.isFinite(now.getTime()) ||
+    !Number.isFinite(projection.expiresAt.getTime()) ||
+    now >= projection.expiresAt
+  )
+    deny("expired or invalid time");
+  if (projection.state !== "confirmed") deny("opportunity is not confirmed");
+  if (
+    projection.members.length !== 2 ||
+    projection.members[0].memberId === projection.members[1].memberId ||
+    projection.members[0].subjectUserId === projection.members[1].subjectUserId ||
+    projection.members[0].recipient === projection.members[1].recipient
+  )
+    deny("two independent members are required");
+  const digest = introductionBriefDigest(projection);
+  if (
+    projection.review.decision !== "approved" ||
+    projection.review.revision !== projection.revision ||
+    projection.review.briefDigest !== digest
+  )
+    deny("review does not bind the current brief");
+  if (
+    !projection.leakCheck.passed ||
+    projection.leakCheck.revision !== projection.revision ||
+    projection.leakCheck.briefDigest !== digest
+  )
+    deny("current outbound leak check is required");
+  const request = (member: IntroductionMember): ApprovalEnqueueInput => {
+    if (
+      !member.memberId.trim() ||
+      !member.subjectUserId.trim() ||
+      !member.recipient.trim() ||
+      !member.body.trim()
+    )
+      deny("invalid member or draft");
+    if (!["imessage", "sms"].includes(member.channel)) deny("unsupported channel");
+    if (!member.channelVerified || member.age !== "adult" || !member.active || member.blocked)
+      deny("member is ineligible");
+    if (
+      member.acceptedRevision !== projection.revision ||
+      member.disclosureRevision !== projection.revision
+    )
+      deny("both current participation and disclosure grants are required");
+    return {
+      requestedBy: "network",
+      subjectUserId: member.subjectUserId,
+      action: "send_message",
+      channel: member.channel,
+      payload: {
+        action: "send_message",
+        recipient: member.recipient,
+        body: member.body,
+        replyToMessageId: null,
+      },
+      reason: `Network introduction ${projection.opportunityId} revision ${projection.revision} brief ${digest}`,
+      idempotencyKey: `network:introduction:${createHash("sha256")
+        .update(
+          JSON.stringify([projection.opportunityId, projection.revision, member.memberId, digest]),
+        )
+        .digest("hex")}`,
+      expiresAt: new Date(projection.expiresAt),
+    };
+  };
+  return [request(projection.members[0]), request(projection.members[1])];
+}
diff --git a/packages/cloud/shared/src/lib/network/runtime-sql.ts b/packages/cloud/shared/src/lib/network/runtime-sql.ts
new file mode 100644
index 000000000000..dc70e68ccb0f
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/runtime-sql.ts
@@ -0,0 +1,36 @@
+import { type IAgentRuntime, ServiceType } from "@elizaos/core";
+import type { CarveOutSqlExecutor, RawSqlQuery } from "@elizaos/plugin-sql";
+import { PgDialect } from "drizzle-orm/pg-core";
+/** Joins native owning stores to the host transaction without a nested BEGIN or alternate persistence owner. */
+export function runtimeInSqlTransaction(
+  runtime: IAgentRuntime,
+  execute: CarveOutSqlExecutor,
+): IAgentRuntime {
+  const dialect = new PgDialect();
+  const db = {
+    execute: async (query: RawSqlQuery) => {
+      const rendered = dialect.sqlToQuery(query);
+      if (rendered.params.length)
+        throw new Error("Transaction adapter requires owner-rendered SQL literals");
+      return { rows: await execute(rendered.sql) };
+    },
+  };
+  const adapter = new Proxy(runtime.adapter, {
+    get(target, key) {
+      if (key === "db") return db;
+      if (key === "recordStore") return undefined;
+      const value = Reflect.get(target, key, target);
+      return typeof value === "function" ? value.bind(target) : value;
+    },
+  });
+  return new Proxy(runtime, {
+    get(target, key) {
+      if (key === "adapter") return adapter;
+      if (key === "getService")
+        return (type: string) =>
+          type === ServiceType.NOTIFICATION ? null : runtime.getService(type);
+      const value = Reflect.get(target, key, target);
+      return typeof value === "function" ? value.bind(target) : value;
+    },
+  });
+}
