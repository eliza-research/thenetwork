+import type { NetworkAdminView, NetworkRow } from "@elizaos/contracts";
+import { staff } from "../domain/policy.ts";
+import { type NetworkActor, NetworkDomainError } from "../domain/types.ts";
+import { DEFAULT_MATCHING_CONFIG } from "../matching/config.ts";
+import { NETWORK_NOTEBOOKS } from "./data-export.ts";
+import { readNetworkExperience } from "./experience.ts";
+import type { createLocalNetworkHost } from "./host.ts";
+import type { NetworkWorkbenchOperations } from "./operations.ts";
+import { DEFAULT_PERSONA_MIX } from "./simulation-lab.ts";
+import { commandAction, commandField, compareTimelineRows, reviewFields } from "./views.ts";
+
+/** Compose operational projections from canonical owners; no new state or analytics queries. */
+export async function composeOperationsView(
+  host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  actor: NetworkActor,
+  params: URLSearchParams,
+  view: NetworkAdminView,
+  operations?: {
+    simulation: Pick<NetworkWorkbenchOperations["simulation"], "list" | "read">;
+    data: Pick<NetworkWorkbenchOperations["data"], "latest">;
+  },
+) {
+  if (view.module === "review" && params.get("blind") === "1") {
+    staff(actor, ["reviewer"]);
+    const snapshot = await host.domain.adminView(actor);
+    const selected = params.get("opportunityId");
+    view.rows = [];
+    view.metrics = [];
+    view.actions = [];
+    delete view.graph;
+    view.title = "Independent review calibration";
+    view.summary =
+      "Primary decisions and participant outcomes are hidden. Your label does not approve or dispatch the proposal.";
+    if (!selected) {
+      view.rows = snapshot.opportunities
+        .filter(
+          (proposal) =>
+            actor.type === "staff" &&
+            proposal.review?.reviewerId !== actor.userId &&
+            !proposal.blindReviews?.some(
+              (review) =>
+                review.revision === proposal.revision && review.reviewerId === actor.userId,
+            ),
+        )
+        .map((proposal) => ({
+          id: proposal.id,
+          title: proposal.objective,
+          fields: { city: proposal.city, category: proposal.category, revision: proposal.revision },
+          actions: [
+            commandAction("navigate_admin", "Open blinded proposal", {
+              module: "review",
+              blind: "1",
+              opportunityId: proposal.id,
+            }),
+          ],
+        }));
+      view.emptyMessage = "No unsubmitted independent proposals are available for this reviewer.";
+    } else {
+      const current = snapshot.opportunities.find((proposal) => proposal.id === selected);
+      if (!current) throw new NetworkDomainError("NETWORK_NOT_FOUND", "Proposal unavailable");
+      const proposal = await host.domain.blindReviewView(actor, selected, current.revision);
+      view.rows = [
+        {
+          id: selected,
+          title: proposal.objective,
+          fields: proposal,
+          actions: [
+            commandAction(
+              "record_blind_review",
+              "Record independent label",
+              { opportunityId: selected, expectedRevision: current.revision },
+              [
+                commandField("decision", "Your decision", "select", undefined, [
+                  "approved",
+                  "rejected",
+                  "reroll",
+                ]),
+                ...reviewFields("other"),
+              ],
+              "Record this exact-revision independent assessment? It does not change publication authority.",
+            ),
+          ],
+        },
+      ];
+      view.actions.push(
+        commandAction("navigate_admin", "Independent proposal directory", {
+          module: "review",
+          blind: "1",
+        }),
+      );
+    }
+  }
+
+  if (view.module === "perspective" || view.module === "conversations") {
+    staff(actor, ["reviewer", "analyst", "safety", "engineer"]);
+    const memberId = params.get("memberId");
+    const window = {
+      startAt: params.get("startAt"),
+      endAt: params.get("endAt"),
+      keyword: params.get("keyword"),
+      channel: params.get("channel"),
+    };
+    view.actions = [
+      commandAction("filter_admin", "Choose member and replay window", {}, [
+        commandField("memberId", "Member reference", "text", memberId ?? ""),
+        {
+          ...commandField("startAt", "From UTC (inclusive)", "text", window.startAt ?? ""),
+          required: false,
+        },
+        {
+          ...commandField("endAt", "Until UTC (exclusive)", "text", window.endAt ?? ""),
+          required: false,
+        },
+        {
+          ...commandField("channel", "Channel", "select", window.channel ?? "", [
+            "web",
+            "sms",
+            "imessage",
+          ]),
+          required: false,
+        },
+        {
+          ...commandField("keyword", "Search words", "text", window.keyword ?? ""),
+          required: false,
+        },
+      ]),
+    ];
+    if (!memberId) {
+      const snapshot = await host.domain.adminView(actor);
+      view.rows = snapshot.members
+        .filter((member) => member.accountState !== "removed")
+        .map((member) => ({
+          id: member.memberId,
+          title: member.displayName,
+          fields: {
+            memberId: member.memberId,
+            cities: member.homeCities,
+            state: member.accountState,
+          },
+          actions: [
+            commandAction("navigate_admin", "Open member experience", {
+              module: view.module,
+              memberId: member.memberId,
+            }),
+          ],
+        }));
+      view.summary =
+        "Choose a member to inspect their retained experience. Default projections protect private identifiers and facts.";
+      view.emptyMessage = "No retained members are available.";
+    } else {
+      const experience = await readNetworkExperience(host, actor, {
+        memberId,
+        purpose: null,
+        ...window,
+      });
+      const constrained = Object.values(window).some(Boolean);
+      const visibleMessageIds = new Set(
+        experience.rows.flatMap((row) =>
+          typeof row.fields.messageId === "string" ? [row.fields.messageId] : [],
+        ),
+      );
+      const trajectoryRows: NetworkRow[] = experience.trajectories
+        .filter(
+          (trajectory) =>
+            !constrained ||
+            (trajectory.sourceMessageId !== null &&
+              visibleMessageIds.has(trajectory.sourceMessageId)),
+        )
+        .map((trajectory) => ({
+          id: "trajectory:" + trajectory.id,
+          title: "Native turn trajectory",
+          fields: {
+            source: "native_trajectory",
+            at: trajectory.logicalAt,
+            sequence: experience.rows.find(
+              (row) => row.fields.messageId === trajectory.sourceMessageId,
+            )?.fields.sequence,
+            clockQualification: trajectory.logicalAt
+              ? "joined_native_member_clock"
+              : "unjoined_clock_unavailable",
+            trajectory,
+          },
+        }));
+      const consideredRows = experience.matchingRuns
+        .filter(
+          (run) =>
+            (!window.startAt ||
+              (typeof run.createdAt === "string" && run.createdAt >= window.startAt)) &&
+            (!window.endAt ||
+              (typeof run.createdAt === "string" && run.createdAt < window.endAt)) &&
+            (!window.keyword ||
+              JSON.stringify(run).toLowerCase().includes(window.keyword.toLowerCase())),
+        )
+        .map((run) => {
+          if (typeof run.id !== "string")
+            throw new NetworkDomainError(
+              "NETWORK_INVALID",
+              "Retained matching identity unavailable",
+            );
+          return {
+            id: "considered:" + run.id,
+            title: "Matching consideration",
+            fields: { source: "retained_matching_run", run },
+            actions: [
+              commandAction("navigate_admin", "Open matching run", {
+                module: "runs",
+                runId: run.id,
+              }),
+            ],
+          };
+        });
+      const chronology = [...experience.rows, ...trajectoryRows];
+      view.rows = [
+        ...chronology.filter((row) => typeof row.fields.at === "string").sort(compareTimelineRows),
+        ...chronology.filter((row) => typeof row.fields.at !== "string"),
+        ...consideredRows,
+      ];
+      view.metrics = [
+        { label: "Selected member", value: memberId },
+        { label: "Observable experience rows", value: experience.rows.length },
+        { label: "Linked native trajectories", value: trajectoryRows.length },
+        { label: "Retained matching considerations", value: consideredRows.length },
+      ];
+      view.summary = experience.qualification;
+      view.actions.push(
+        commandAction("navigate_admin", "Member profile", { module: "members", memberId }),
+        commandAction(
+          "navigate_admin",
+          view.module === "perspective" ? "Conversation explorer" : "Member perspective",
+          {
+            module: view.module === "perspective" ? "conversations" : "perspective",
+            memberId,
+            ...Object.fromEntries(Object.entries(window).filter(([, value]) => value)),
+          },
+        ),
+        commandAction(
+          "inspect_member_experience",
+          "Open restricted member experience",
+          { memberId, ...window },
+          [commandField("purpose", "Access purpose", "textarea")],
+          "This restricted read is authorized separately and logged.",
+        ),
+      );
+      view.emptyMessage = "No observable rows fit the selected member/window/channel/words.";
+    }
+  }
+
+  if (view.module === "health") {
+    staff(actor, ["reviewer", "analyst", "engineer", "safety"]);
+    const health = await host.matchingJobs.health();
+    view.rows.push(
+      ...health.alerts.map((alert) => ({
+        id: "health-alert:" + alert.id,
+        title: alert.kind.replaceAll("_", " "),
+        status: "needs attention",
+        fields: alert,
+      })),
+      {
+        id: "health-observation-policy",
+        title: "Local health observation policy",
+        fields: health.observationPolicy,
+      },
+      {
+        id: "recorded-invariant-evidence",
+        title: "Historical recorded invariant evidence",
+        fields: health.recordedInvariants,
+      },
+    );
+    view.metrics.push(
+      { label: "Recorded local health alerts", value: health.alerts.length },
+      {
+        label: "Historical simulation invariant failures",
+        value: health.recordedInvariants.count ?? "Unmeasured",
+      },
+    );
+    view.rows.push(
+      ...health.tasks.map((task) => ({
+        id: "matcher-job:" + task.taskId,
+        title: "Native matcher job",
+        status: task.state.status,
+        fields: { taskId: task.taskId, binding: task.binding, state: task.state },
+      })),
+      ...Object.entries(health.lastHeartbeat).map(([city, event]) => ({
+        id: "matcher-heartbeat:" + city,
+        title: city + " matcher heartbeat",
+        fields: {
+          city,
+          event,
+          qualification: event ? "recorded_owner_event" : "no_heartbeat_recorded",
+        },
+      })),
+    );
+    view.metrics.push(
+      { label: "Native matcher jobs", value: health.tasks.length },
+      {
+        label: "Matcher job lifecycle",
+        value: JSON.stringify(
+          Object.fromEntries(
+            [...new Set(health.tasks.map((task) => task.state.status))].map((state) => [
+              state,
+              health.tasks.filter((task) => task.state.status === state).length,
+            ]),
+          ),
+        ),
+      },
+      {
+        label: "Live provider send-failure rate",
+        value: "Unqualified; local receipts use a closed provider",
+      },
+    );
+  }
+
+  if (view.module === "simulation") {
+    staff(actor, ["engineer"]);
+    view.rows = [];
+    view.actions = [];
+    if (!operations) {
+      view.summary = "Persistent simulation services are unavailable in this host.";
+      view.emptyMessage = "Use the fully composed local workbench for retained world operations.";
+    } else {
+      const selectedRun = params.get("runId");
+      const runs = selectedRun
+        ? [await operations.simulation.read(actor, selectedRun)]
+        : await operations.simulation.list(actor);
+      view.rows = runs.map((run) => ({
+        id: run.runId,
+        title: "Retained local world",
+        status: run.status,
+        fields: {
+          runId: run.runId,
+          config: run.config,
+          configDigest: run.configDigest,
+          dataDigest: run.dataDigest,
+          progress: run.progress,
+          attempt: run.attempt,
+          attempts: run.attempts,
+          reportSummary:
+            run.report && typeof run.report === "object"
+              ? Object.fromEntries(
+                  Object.entries(run.report).filter(([key]) =>
+                    ["runDigest", "counts", "metrics", "qualification"].includes(key),
+                  ),
+                )
+              : null,
+          fullReport: "Available through Inspect retained world",
+          environment: "retained_simulation",
+        },
+        actions: [
+          commandAction("inspect_lab", "Inspect retained world", { runId: run.runId }),
+          commandAction(
+            "inspect_simulated_member",
+            "Open simulated member experience",
+            { runId: run.runId },
+            [commandField("memberId", "Simulated member reference")],
+          ),
+          ...(run.status !== "completed" && run.status !== "cancelled"
+            ? [
+                commandAction(
+                  "cancel_simulation",
+                  "Cancel this local run",
+                  { runId: run.runId },
+                  [],
+                  "Cancel this run? Its existing attempt and evidence remain retained.",
+                ),
+              ]
+            : []),
+        ],
+      }));
+      view.actions = [
+        commandAction(
+          "simulate",
+          "Launch retained local world",
+          {},
+          [
+            commandField("personaCount", "People", "number", 100),
+            commandField("days", "Simulated days", "number", 14),
+            commandField("seed", "Replay seed", "text", "20261005"),
+            commandField("timeMode", "Time mode", "select", "discrete_event", [
+              "discrete_event",
+              "accelerated",
+              "real_time",
+            ]),
+            {
+              ...commandField(
+                "personaMix",
+                "Persona mix",
+                "textarea",
+                JSON.stringify(DEFAULT_PERSONA_MIX, null, 2),
+              ),
+              help: "Nonnegative relative weights for the listed persona types; scripted assumptions remain labelled.",
+            },
+            commandField(
+              "engineVersion",
+              "Engine version",
+              "select",
+              DEFAULT_MATCHING_CONFIG.version,
+              [DEFAULT_MATCHING_CONFIG.version],
+            ),
+          ],
+          "Queue this isolated local world? It uses retained synthetic identities and a closed delivery provider.",
+        ),
+        commandAction("compare_simulations", "Compare completed worlds", {}, [
+          commandField("runId", "First retained run"),
+          commandField("secondRunId", "Second retained run"),
+        ]),
+      ];
+      view.summary =
+        "Actual retained run configuration, progress, attempts and reports. Model quality and real product value require separate qualification.";
+      view.emptyMessage = "No retained local worlds yet.";
+    }
+  }
+
+  if (view.module === "data") {
+    staff(actor, ["analyst"]);
+    view.rows = [];
+    view.actions = [];
+    if (!operations) {
+      view.summary = "Retained export services are unavailable in this host.";
+      view.emptyMessage =
+        "The complete local host supplies scrubbed export and notebook capabilities.";
+    } else {
+      const exported = await operations.data.latest(actor);
+      view.actions = [commandAction("export_parquet", "Create current scrubbed export")];
+      if (exported) {
+        view.rows.push({
+          id: exported.exportId,
+          title: "Latest scrubbed export",
+          fields: {
+            exportId: exported.exportId,
+            exportedAt: exported.exportedAt,
+            sourceSequence: exported.sourceSequence,
+            rowCount: exported.rowCount,
+            schemaVersion: exported.schemaVersion,
+            qualification: exported.qualification,
+          },
+          actions: [
+            commandAction("download_artifact", "Download Parquet", {
+              exportId: exported.exportId,
+              kind: "parquet",
+            }),
+          ],
+        });
+        for (const [key, notebook] of Object.entries(NETWORK_NOTEBOOKS))
+          view.rows.push({
+            id: "notebook:" + key,
+            title: notebook.title,
+            fields: {
+              exportId: exported.exportId,
+              savedSql: notebook.sql,
+              artifact: exported.notebooks[key as keyof typeof NETWORK_NOTEBOOKS],
+            },
+            actions: [
+              commandAction("run_notebook", "Run saved notebook", { notebook: key }),
+              commandAction("download_artifact", "Download notebook", {
+                exportId: exported.exportId,
+                kind: key,
+              }),
+            ],
+          });
+      }
+      view.summary =
+        "Saved bounded DuckDB analyses read the retained scrubbed Parquet export. External R2 and production replica qualification are separate.";
+      view.emptyMessage =
+        "No current export exists. Create one to enable downloads and saved notebooks.";
+    }
+  }
+}
