+
+it("delivers fresh source-backed local recommendations, rejects private review text/foreign mention evidence, and resumes only original approved unsent tasks after START", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00.000Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "test:outreach-sources",
+    clock,
+  });
