@@ -0,0 +1,9 @@
+import { createHash } from "node:crypto";
+import { stableStringify } from "@elizaos/core";
+/** One content identity for Network JSON wire records; object undefined keys are omitted by JSON semantics. */
+export function networkDigest(value: unknown): string {
+  const wire = stableStringify(value);
+  if (typeof wire !== "string")
+    throw new TypeError("Network content identity requires a JSON value");
+  return createHash("sha256").update(wire).digest("hex");
+}
