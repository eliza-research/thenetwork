+import { randomUUID } from "node:crypto";
+import { PGlite } from "@electric-sql/pglite";
+import type { CarveOutDatabase, CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { NetworkDomain } from "./service";
+import { DomainStore } from "./store";
+import type { NetworkCommand } from "./types";
+
+const system = { type: "system" } as const;
+const at = "2026-10-06T19:00:00.000Z";
+const clock = { now: () => new Date(at) };
+let client: PGlite;
+let db: CarveOutDatabase;
+let domain: NetworkDomain;
+let networkId: string;
+let originalHistoryDigest: unknown;
+const reads: Array<{ sql: string; ids: unknown[] }> = [];
+const observe =
+  (execute: CarveOutSqlExecutor): CarveOutSqlExecutor =>
+  async (sql) => {
+    const rows = await execute(sql);
+    if (/^SELECT payload.* FROM network\.matching_runs /.test(sql))
+      reads.push({
+        sql,
+        ids: rows.map((row) => {
+          const value = typeof row.payload === "string" ? JSON.parse(row.payload) : row.payload;
+          return value.id;
+        }),
+      });
+    return rows;
+  };
+const command = (requestId: string): Extract<NetworkCommand, { type: "commit_matching_run" }> => ({
+  type: "commit_matching_run",
+  requestId,
+  runId: "requested-run",
+  city: "SF",
+  inputDigest: "input-v1",
+  inputRevisions: {},
+  log: { seed: 7 },
+  drafts: [],
+});
+const historyDigest = async () =>
+  (
+    await db.execute(`SELECT md5(payload::text) AS digest FROM network.matching_runs
+    WHERE network_id='${networkId}' AND id='unrelated-history'`)
+  )[0]?.digest;
+const expectOnlyRequestedRun = (ids: string[]) => {
+  expect(reads).toHaveLength(1);
+  expect(reads[0]?.ids).toEqual(ids);
+  expect(reads[0]?.sql).toContain(`network_id='${networkId}'`);
+  expect(reads[0]?.sql).toContain("AND id IN ('requested-run')");
+};
+
+beforeAll(async () => {
+  client = new PGlite();
+  db = {
+    execute: observe(
+      async (statement) => (await client.query<Record<string, unknown>>(statement)).rows,
+    ),
+    transaction: (operation) =>
+      client.transaction((transaction) =>
+        operation(
+          observe(
+            async (statement) => (await transaction.query<Record<string, unknown>>(statement)).rows,
+          ),
+        ),
+      ),
+  };
+}, 120_000);
+beforeEach(async () => {
+  networkId = `test:run-lookup:${randomUUID()}`;
+  domain = new NetworkDomain({ db, clock, networkId });
+  await domain.initializeLocalSchema();
+  const retained = "COMPLETE_UNRELATED_HISTORY ".repeat(42_000);
+  expect(Buffer.byteLength(retained)).toBeGreaterThanOrEqual(1024 * 1024);
+  await new DomainStore(db.execute, networkId).save(
+    "matching_runs",
+    "unrelated-history",
+    {
+      id: "unrelated-history",
+      fingerprintVersion: 2,
+      log: { retained },
+      createdAt: at,
+    },
+    at,
+  );
+  originalHistoryDigest = await historyDigest();
+  reads.length = 0;
+});
+afterAll(async () => {
+  await client.close();
+});
+
+describe("matching run lookup", () => {
+  it("does not materialize unrelated complete history when committing a new run", async () => {
+    expect(await domain.command(system, command("new-run"))).toMatchObject({
+      ok: true,
+      kind: "matching_run",
+      id: "requested-run",
+      changed: 0,
+    });
+    expectOnlyRequestedRun([]);
+    expect(await historyDigest()).toBe(originalHistoryDigest);
+  });
+  it("preserves command replay, same-run idempotency and conflicting content denial", async () => {
+    const original = await domain.commandWithReceipt(system, command("original"));
+    reads.length = 0;
+    const replay = await domain.commandWithReceipt(system, command("original"));
+    expect(replay.result).toEqual(original.result);
+    expect(replay.receipt.idempotency.replayed).toBe(true);
+    expect(reads).toHaveLength(0);
+    expect(await domain.command(system, command("same-run-new-request"))).toEqual(original.result);
+    expectOnlyRequestedRun(["requested-run"]);
+    reads.length = 0;
+    await expect(
+      domain.command(system, { ...command("conflicting-run"), log: { seed: 8 } }),
+    ).rejects.toMatchObject({ code: "NETWORK_IDEMPOTENCY" });
+    expectOnlyRequestedRun(["requested-run"]);
+    expect(await historyDigest()).toBe(originalHistoryDigest);
+  });
+  it.each([
+    { name: "legacy", update: "'{fingerprintVersion}', '1'::jsonb", context: undefined },
+    {
+      name: "erased",
+      update: `'{sourceDataErased}', '{"at":"${at}","reason":"account_deleted"}'::jsonb`,
+      context: { rule: "matching_source_data_erased" },
+    },
+  ])(
+    "retains $name same-ID denial without materializing unrelated history",
+    async ({ update, context }) => {
+      await domain.command(system, command("original"));
+      await db.execute(`UPDATE network.matching_runs SET payload=jsonb_set(payload,${update})
+      WHERE network_id='${networkId}' AND id='requested-run'`);
+      reads.length = 0;
+      await expect(domain.command(system, command("fresh-request"))).rejects.toMatchObject({
+        code: "NETWORK_IDEMPOTENCY",
+        ...(context ? { context } : {}),
+      });
+      expectOnlyRequestedRun(["requested-run"]);
+      expect(await historyDigest()).toBe(originalHistoryDigest);
+    },
+  );
+});
