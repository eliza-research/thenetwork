+          opportunityId,
+          revision,
+          purpose,
+        );
+      return body(domain, await this.load(execute, opportunity), opportunity, members, execute);
+    });
+  }
+  private async mutate<T>(
+    actor: NetworkActor,
+    opportunityId: string,
+    revision: number,
+    requestId: string,
+    input: unknown,
+    body: (
+      domain: NetworkDomain,
+      record: CoordinationRecord,
+      opportunity: NetworkOpportunity,
+      memberId: string,
+      members: NetworkMember[],
+    ) => Promise<T>,
+    replay?: (
+      result: T,
+      record: CoordinationRecord,
+      opportunity: NetworkOpportunity,
+      members: NetworkMember[],
+    ) => T,
+  ): Promise<T> {
+    if (!requestId.trim() || requestId.length > 200)
+      denied("Valid command request identity required", "NETWORK_INVALID");
+    const digest = networkDigest([actor, opportunityId, revision, input]);
+    return this.withAuthority(
+      opportunityId,
+      revision,
+      async (domain, record, opportunity, members, execute) => {
+        const id = memberActor(
+          actor,
+          members.map((member) => member.memberId),
+        );
+        if (record.departedMemberIds.includes(id)) denied("Member left this relay");
+        const rows = await execute(
+          `SELECT digest,result FROM network.coordination_receipts WHERE network_id=${sqlQuote(this.options.networkId)} AND request_id=${sqlQuote(requestId)}`,
+        );
+        if (rows[0]) {
+          if (rows[0].digest !== digest)
+            denied("Coordination request identity reused", "NETWORK_IDEMPOTENCY");
+          const result = decode<T>(rows[0].result);
+          return replay ? replay(result, record, opportunity, members) : result;
+        }
+        const result = await body(domain, record, opportunity, id, members);
+        await this.save(execute, record);
+        await execute(
+          `INSERT INTO network.coordination_receipts(network_id,request_id,digest,result,member_ids,created_at) VALUES(${sqlQuote(this.options.networkId)},${sqlQuote(requestId)},${sqlQuote(digest)},${sqlQuote(JSON.stringify(result))}::jsonb,${sqlQuote(JSON.stringify(members.map((member) => member.memberId)))}::jsonb,${sqlQuote(this.options.clock.now().toISOString())})`,
+        );
+        return result;
+      },
+    );
+  }
+  private async cleanupReplay(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string },
+    kind: CoordinationAcknowledgment["kind"],
+  ): Promise<CoordinationAcknowledgment | null> {
+    if (actor.type !== "member") denied("Authenticated member required", "NETWORK_FORBIDDEN");
+    return this.options.db.transaction(async (execute) => {
+      await execute(
+        `SELECT network_id FROM network.domains WHERE network_id=${sqlQuote(this.options.networkId)} FOR UPDATE`,
+      );
+      const member = await this.domain(execute).getMember(actor, actor.memberId);
+      if (member.accountState === "removed")
+        denied("Removed member cannot replay coordination", "NETWORK_FORBIDDEN");
+      const rows = await execute(
+        `SELECT digest,result,member_ids FROM network.coordination_receipts WHERE network_id=${sqlQuote(this.options.networkId)} AND request_id=${sqlQuote(input.requestId)}`,
+      );
+      if (!rows[0]) return null;
+      if (
+        rows[0].digest !== networkDigest([actor, input.opportunityId, input.revision, input]) ||
+        !decode<string[]>(rows[0].member_ids).includes(actor.memberId)
+      )
+        denied("Cleanup request identity reused", "NETWORK_IDEMPOTENCY");
+      const result = decode<CoordinationAcknowledgment>(rows[0].result);
+      if (
+        result.kind !== kind ||
+        result.opportunityId !== input.opportunityId ||
+        Object.keys(result).sort().join(",") !== "kind,opportunityId"
+      )
+        denied("Legacy cleanup receipt requires reconciliation", "NETWORK_CONFLICT");
+      return result;
+    });
+  }
+  async view(actor: NetworkActor, opportunityId: string): Promise<CoordinationRecord> {
+    const domain = this.domain(),
+      opportunity = await domain.getOpportunity(SYSTEM, opportunityId);
+    if (!("participantIds" in opportunity)) denied("Invalid opportunity");
+    const stored = await this.load(this.options.db.execute, opportunity as NetworkOpportunity);
+    const record =
+      actor.type === "system"
+        ? stored
