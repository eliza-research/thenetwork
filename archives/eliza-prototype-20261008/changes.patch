+        ? ["engineer"]
+        : module === "review"
+          ? ["reviewer"]
+          : ["reviewer", "analyst", "engineer", "safety"];
+  staff(actor, permissions);
+  const retained =
+    operations && ["graph", "pipeline", "intents", "metrics", "fairness"].includes(module)
+      ? await operations.data.readSnapshot(actor)
+      : undefined;
+  const snapshot = retained?.snapshot ?? (await host.domain.adminView(actor));
+  const result = await adminWorkbench(host.domain, actor, module, snapshot);
+  const memberId = parameters.get("memberId");
+  if (memberId && !snapshot.members.some((member) => member.memberId === memberId))
+    throw new NetworkDomainError("NETWORK_NOT_FOUND", "Member unavailable");
+  const messages = await scrubNetworkProjection(
+    retained ? [] : await host.transport.messages(),
+    `${host.domain.options.networkId}:staff-messages`,
+  );
+  const edges =
+    retained?.edges ??
+    (await host.native.adminGraph(
+      host.db.execute,
+      snapshot.members.map((member) => member.memberId),
+    ));
+  const opportunities = memberId
+    ? snapshot.opportunities.filter((o) => o.participantIds.includes(memberId))
+    : snapshot.opportunities;
+  const now = host.domain.options.clock.now().getTime();
+  if (actor.type === "staff")
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "record_event",
+        requestId: `staff-read:${randomUUID()}`,
+        kind: "staff_projection_read",
+        memberIds: memberId ? [memberId] : [],
+        opportunityId: null,
+        details: {
+          module,
+          staffUserId: actor.userId,
+          roles: actor.roles,
+          ...(memberId ? { memberId } : {}),
+        },
+      },
+    );
+  if (module === "health") {
+    const jobs = (await host.runner.list()).filter((task) => {
