+import { expect, it } from "vitest";
+import { DAY, testInput } from "../matching/test-fixtures.ts";
+import { programmeInvitationPriority } from "./programme-priority.ts";
+
+it("orders the same eligible audience with factual, newcomer, exposure and repeat reasons", () => {
+  const input = testInput(4);
+  const [newcomer, connected, repeat, excluded] = input.members;
+  newcomer!.joinedAt = input.now - DAY;
+  connected!.joinedAt = repeat!.joinedAt = input.now - 40 * DAY;
+  input.edges = [{ from: connected!.memberId, to: repeat!.memberId, confirmed: true }];
+  input.budgetHistory = [
+    {
+      opportunityId: "delivered",
+      memberIds: [connected!.memberId, repeat!.memberId],
+      category: "social",
+      at: input.now - DAY,
+      outcome: "proposed",
+    },
+  ];
+  input.history = [
+    {
+      opportunityId: "positive",
+      memberIds: [connected!.memberId, repeat!.memberId],
+      category: "social",
+      at: input.now - 5 * DAY,
+      outcome: "positive",
+    },
+  ];
+  const audience = [connected!.memberId, newcomer!.memberId, repeat!.memberId];
+  const rows = programmeInvitationPriority(input, audience);
+  expect(rows[0]).toEqual({
+    memberId: newcomer!.memberId,
+    reasons: ["zero_exposure_30d", "isolated", "newcomer", "zero_exposure_14d"],
+  });
+  expect(rows.find((row) => row.memberId === repeat!.memberId)?.reasons).toEqual([
+    "pending_second_encounter",
+  ]);
+  expect(rows.some((row) => row.memberId === excluded!.memberId)).toBe(false);
+  input.history.push({
+    ...input.history[0]!,
+    opportunityId: "later",
+    at: input.now - DAY,
+    outcome: "completed",
+  });
+  expect(
+    programmeInvitationPriority(input, audience).find((row) => row.memberId === repeat!.memberId)
+      ?.reasons,
+  ).toEqual([]);
+});
diff --git a/packages/cloud/shared/src/lib/network/workbench/programme-priority.ts b/packages/cloud/shared/src/lib/network/workbench/programme-priority.ts
