+import { detectPii, PseudonymSession, RegexEntityRecognizer, validateUuid } from "@elizaos/core";
+import { networkDigest } from "../digest";
+import { terminalStates } from "./store";
+import {
+  type MemberOpportunityView,
+  type NetworkActor,
+  NetworkDomainError,
+  type NetworkMember,
+  type NetworkOpportunity,
+  type NetworkSettings,
+  type OpportunityDraft,
+  type OpportunityState,
+  type Preferences,
+  type StaffRole,
+} from "./types";
+import { invalid } from "./validation";
+
+export const DAY = 86_400_000;
+/** Historical 'minor' never establishes the minimum age. No birth date is retained. */
+export function minimumAgeConfirmed(member: NetworkMember): boolean {
+  return (
+    member.age === "adult" ||
+    (member.age === "minor" &&
+      member.ageAttestation?.age === "minor" &&
+      member.ageAttestation.ageBand === "13_17")
+  );
+}
+/** Bounded local content rule, not a production language or external-source classifier. */
+export function teenContentAllowed(content: string): boolean {
+  return !/(?:\b(?:romance|dating|alcohol|beer|wine|cocktails?|pubs?|brewer(?:y|ies)|bars?|nightclubs?|nightlife|adult\s+only|sponsor(?:ed|ship)?|paid\s+promotion)\b|\b(?:18|21)\s*(?:\+|plus\b))/i.test(
+    content.replace(/[_-]/g, " "),
+  );
+}
+const structuredPii = new RegexEntityRecognizer({ address: true, email: true, phone: true });
+/** Iterates only Core-normalized JSON records; one text per record retains the complete corpus. */
+export function* networkProjectionTexts(value: unknown): Generator<string> {
+  if (Array.isArray(value)) {
+    yield "[]";
+    for (const record of value) yield JSON.stringify([record]);
+  } else if (value !== null && typeof value === "object") {
+    const fields = Object.entries(value);
+    yield JSON.stringify(
+      Object.fromEntries(fields.map(([key, field]) => [key, Array.isArray(field) ? [] : field])),
+    );
+    for (const [key, field] of fields)
+      if (Array.isArray(field))
+        for (const record of field) yield JSON.stringify(Object.fromEntries([[key, [record]]]));
+  } else {
+    const text = JSON.stringify(value);
+    if (text !== undefined) yield text;
+  }
+}
+/** One Core session covers the complete corpus; arbitrary names/inference still need qualified NER. */
+export async function scrubNetworkProjection<T>(value: T, scope: string): Promise<T> {
+  const session = new PseudonymSession({
+    salt: scope,
+    recognizer: structuredPii,
+    walkBudget: { maxNodes: 2_000_000, maxBytes: 64 * 1024 * 1024 },
+  });
+  const normalized = session.substituteRecordsInValue(value);
+  const texts = [...networkProjectionTexts(normalized)];
+  // Reserve every literal before minting, including text the recognizer does not classify.
+  for (const text of texts) session.learnSpans(text, []);
+  for (const text of texts) session.learnSpans("", await structuredPii.recognize(text));
+  return session.substituteRecordsInValue(normalized);
+}
+/** Deterministic launch exclusions; inference/classifier qualification remains a host concern. */
+export function networkSafetyClass(
+  objective: string,
+  category: string,
+  tags: string[] = [],
+): "low" | "medium" | "high" {
+  const purpose = [objective, category, ...tags].join(" ").toLowerCase().replace(/[_-]/g, " ");
+  if (
+    /child\s?care|baby\s?sit|day\s?care|unsupervised\s+minor|controlled\s+substance|money\s+custody|custody\s+of\s+(?:money|funds)|hold\s+(?:my|their)\s+money|clinical\s+service|home\s+medical|medical\s+treatment|prescri(?:be|ption)/i.test(
+      purpose,
+    )
+  )
+    return "high";
+  if (
+    /home\s+entry|enter(?:ing)?\s+(?:my|their|a)\s+(?:home|house)|inside\s+(?:my|their)\s+(?:home|house)|at\s+my\s+(?:home|house|place)|home\s+hosted/i.test(
+      purpose,
+    )
+  )
+    return "medium";
+  return "low";
+}
+export function assertKnownDisclosure(
+  members: NetworkMember[],
+  value: string,
+  options: { allowContact?: boolean; recipientMemberId?: string } = {},
+): void {
+  const protectedValues = members
+    .flatMap((member) => [
+      ...(member.memberId === options.recipientMemberId
+        ? []
+        : member.facts.filter((fact) => fact.scope !== "shareable").map((fact) => fact.value)),
+      ...(!options.allowContact ? member.channels.map((channel) => channel.address) : []),
+      member.cloudUserId,
+    ])
+    .map((item) => item.trim())
+    .filter(Boolean);
+  if (protectedValueMatcher(protectedValues)(value))
+    throw new NetworkDomainError(
+      "NETWORK_SAFETY",
+      "Network disclosure contains protected member data",
+      { rule: "known_protected_value" },
+    );
+  if (
+    !options.allowContact &&
+    detectPii(value).some((match) => match.kind === "phone" || match.kind === "email")
+  )
+    throw new NetworkDomainError(
+      "NETWORK_SAFETY",
+      "Contact disclosure requires independent typed grants",
+      { rule: "structured_contact" },
+    );
+}
+function protectedValueMatcher(values: string[]): (text: string) => boolean {
+  const short: string[] = [],
+    long: string[] = [];
+  for (const value of new Set(values)) {
+    if (!value.trim()) continue;
+    const token = /^\p{L}{1,4}$/u.test(value);
+    const literal = (token ? value : value.toLowerCase()).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+    (token ? short : long).push(literal);
+  }
+  const shortPattern = short.length
+    ? new RegExp(`(?<![\\p{L}\\p{N}])(?:${short.join("|")})(?![\\p{L}\\p{N}])`, "iu")
+    : null;
+  const longPattern = long.length ? new RegExp(long.join("|"), "u") : null;
+  return (text) => !!shortPattern?.test(text) || !!longPattern?.test(text.toLowerCase());
+}
+/** Internal replay contains opaque references and clocks; only human text is a contact-disclosure surface. */
+export function assertReplayLog(
+  members: NetworkMember[],
+  data: unknown,
+  matchingAt?: number,
+): void {
+  const privateEntries = members.flatMap((member) =>
+    member.facts
+      .filter((fact) => fact.scope === "agent_private")
+      .map((fact) => ({ memberId: member.memberId, value: fact.value })),
+  );
+  const privateValues = privateEntries.map((entry) => entry.value);
+  // Only exact current source leaves within their owner's matching profile have matching purpose.
+  const matchingLeaves = new Map<string, string>();
+  const record = (value: unknown): Record<string, unknown> | null =>
+    value && typeof value === "object" && !Array.isArray(value)
+      ? (value as Record<string, unknown>)
+      : null;
+  const replay = record(record(data)?.replayInput);
+  if (matchingAt !== undefined && Number.isFinite(matchingAt) && Array.isArray(replay?.members)) {
+    const at = new Date(matchingAt).toISOString(),
+      byId = new Map(members.map((member) => [member.memberId, member]));
+    const permitField = (
+      source: Record<string, unknown>,
+      field: string,
+      canonical: unknown,
+      path: string,
+      memberId: string,
+    ) => {
+      if (networkDigest(source[field]) !== networkDigest(canonical)) return;
+      if (typeof canonical === "string") matchingLeaves.set(`${path}.${field}`, memberId);
+      else if (Array.isArray(canonical))
+        canonical.forEach((value, index) => {
+          if (typeof value === "string") matchingLeaves.set(`${path}.${field}[${index}]`, memberId);
+        });
+    };
+    replay.members.forEach((value, index) => {
+      const profile = record(value),
+        member = typeof profile?.memberId === "string" ? byId.get(profile.memberId) : undefined;
+      if (!profile || !member || profile.profileRevision !== member.revision) return;
+      const base = `matching.log.replayInput.members[${index}]`;
+      if (Array.isArray(profile.intents))
+        profile.intents.forEach((value, intentIndex) => {
+          const projected = record(value),
+            intent = member.intents.find((intent) => intent.id === projected?.id);
+          if (
+            !projected ||
+            !intent ||
+            intent.status !== "active" ||
+            intent.expiresAt <= at ||
+            networkSafetyClass(intent.objective, intent.category, intent.tags) === "high" ||
+            projected.createdAt !== Date.parse(intent.createdAt) ||
+            projected.expiresAt !== Date.parse(intent.expiresAt)
+          )
+            return;
+          for (const field of ["category", "tags", "needs", "offers"] as const)
+            permitField(
+              projected,
+              field,
+              field === "offers" && member.participation === "receiving" ? [] : intent[field],
+              `${base}.intents[${intentIndex}]`,
+              member.memberId,
+            );
+        });
+      if (Array.isArray(profile.facts))
+        profile.facts.forEach((value, factIndex) => {
+          const projected = record(value),
+            fact = member.facts.find((fact) => fact.id === projected?.id);
+          if (
+            !projected ||
+            !fact ||
+            !publicFact(fact, at) ||
+            projected.kind !== fact.kind ||
+            projected.scope !== (fact.scope === "matching" ? "network" : "shareable") ||
+            projected.confidence !== fact.confidence ||
+            projected.confirmedAt !== Date.parse(fact.updatedAt)
+          )
+            return;
+          permitField(
+            projected,
+            "text",
+            fact.value,
+            `${base}.facts[${factIndex}]`,
+            member.memberId,
+          );
+          permitField(projected, "tags", fact.tags, `${base}.facts[${factIndex}]`, member.memberId);
+        });
+    });
+  }
+  const privatePredicates = new Map<string, (text: string) => boolean>();
+  const otherPrivateMatches = (text: string, memberId: string) =>
+    privateEntries.some((entry) => {
+      if (entry.memberId === memberId) return false;
+      let predicate = privatePredicates.get(entry.value);
+      if (!predicate) {
+        predicate = protectedValueMatcher([entry.value]);
+        privatePredicates.set(entry.value, predicate);
+      }
+      return predicate(text);
+    });
+  const bindings = members
+    .flatMap((member) => [member.cloudUserId, ...member.channels.map((channel) => channel.address)])
+    .filter(Boolean);
+  const memberIds = new Set(members.map((member) => member.memberId));
+  const privateValueMatches = protectedValueMatcher(privateValues);
+  const bindingMatches = protectedValueMatcher(bindings);
+  const walk = (value: unknown, path: string, field: string): void => {
+    if (typeof value === "string") {
+      const matchingOwner = matchingLeaves.get(path);
+      if (
+        privateValueMatches(value) &&
+        (!matchingOwner || otherPrivateMatches(value, matchingOwner))
+      )
+        throw new NetworkDomainError("NETWORK_SAFETY", "Replay log contains private member data", {
+          rule: "private_replay_value",
+          path,
+        });
+      const referenceField = [
+        "id",
+        "memberId",
+        "entityId",
+        "ownerId",
+        "participantIds",
+        "backupIds",
+        "factIds",
+        "intentIds",
+        "evidenceIds",
+        "sourceId",
+        "targetId",
+      ].includes(field);
+      let declaredReference = referenceField && memberIds.has(value);
+      if (referenceField)
+        for (
+          let cut = value.indexOf(":");
+          !declaredReference && cut !== -1;
+          cut = value.indexOf(":", cut + 1)
+        )
+          declaredReference = memberIds.has(value.slice(cut + 1));
+      const opaqueMetadata =
+        [
+          "nativeRequestId",
+          "callId",
+          "stepId",
+          "providerId",
+          "requestId",
+          "id",
+          "candidateId",
+          "inputDigest",
+          "contentDigest",
+        ].includes(field) &&
+        (validateUuid(value) !== null ||
+          (field !== "stepId" && field !== "providerId" && /^[0-9a-f]{32,64}$/i.test(value)));
+      const scopedKey =
+        field === "idempotencyKey" && /^network:[0-9a-f]{64}:[a-z0-9:_-]+$/i.test(value);
+      if (!declaredReference && bindingMatches(value))
+        throw new NetworkDomainError(
+          "NETWORK_SAFETY",
+          "Replay log contains private identity binding",
+          { rule: "private_replay_binding", path },
+        );
+      if (
+        !declaredReference &&
+        !opaqueMetadata &&
+        !scopedKey &&
+        detectPii(value).some((match) => match.kind === "phone" || match.kind === "email")
+      )
+        throw new NetworkDomainError("NETWORK_SAFETY", "Replay human text contains contact data", {
+          rule: "replay_contact_text",
+          path,
+        });
+    } else if (Array.isArray(value))
+      value.forEach((item, index) => walk(item, `${path}[${index}]`, field));
+    else if (value && typeof value === "object")
+      for (const [key, item] of Object.entries(value)) walk(item, `${path}.${key}`, key);
+  };
+  walk(data, "matching.log", "");
+}
+export const transitions: Partial<Record<OpportunityState, OpportunityState[]>> = {
+  draft: ["in_review", "cancelled"],
+  in_review: ["cancelled"],
+  approved: ["inviting", "cancelled"],
+  inviting: ["cancelled", "expired", "quorum_failed"],
+  partially_accepted: ["cancelled", "expired", "quorum_failed"],
+  mutually_accepted: ["scheduling", "completed", "cancelled"],
+  quorum_met: ["scheduling", "completed", "cancelled"],
+  scheduling: ["scheduled", "cancelled", "abandoned"],
+  scheduled: ["reschedule_requested", "in_progress", "completed", "needs_replacement", "cancelled"],
+  reschedule_requested: ["scheduling", "scheduled", "cancelled"],
+  needs_replacement: ["scheduling", "cancelled"],
+  in_progress: ["completed", "disputed", "cancelled"],
+  completed: ["feedback_collected", "disputed"],
+  safety_hold: ["cancelled"],
+  disputed: ["cancelled", "completed"],
+};
+/** A requested outcome cannot continue without its requester; ordinary peer quorum stays independent. */
+export function hasRequiredOpportunityMembers(
+  opportunity: Pick<OpportunityDraft, "kind" | "requester" | "roles" | "participantIds">,
+  memberIds: readonly string[],
+): boolean {
+  if (opportunity.kind === "monthly_event") return true;
+  const requesters = Object.entries(opportunity.roles ?? {})
+    .filter(([, role]) => role === "requester")
+    .map(([id]) => id);
+  if (opportunity.requester) requesters.push(opportunity.requester.memberId);
+  if (opportunity.kind === "help" && !Object.values(opportunity.roles ?? {}).includes("requester"))
+    requesters.push(opportunity.participantIds[0] ?? "");
+  return requesters.every(
+    (id) => opportunity.participantIds.includes(id) && memberIds.includes(id),
+  );
+}
+export function availableOpportunityMemberIds(
+  opportunity: NetworkOpportunity,
+  at: string,
+): string[] {
+  return opportunity.participants
+    .filter(
+      (part) =>
+        part.revision === opportunity.revision &&
+        !["declined", "expired", "replaced", "cancelled_with_notice"].includes(part.state) &&
+        (part.state !== "invited" || part.expiresAt > at),
+    )
+    .map((part) => part.memberId);
+}
+/** Original consent remains available for outcome feedback after a no-show or noticed cancellation. */
+export function consentedOpportunityMemberIds(opportunity: NetworkOpportunity): string[] {
+  return opportunity.participants
+    .filter(
+      (part) =>
+        part.revision === opportunity.revision &&
+        part.acceptedAt &&
+        ["accepted", "confirmed", "attended", "no_show", "cancelled_with_notice"].includes(
+          part.state,
+        ),
+    )
+    .map((part) => part.memberId);
+}
+export function readyInvitationMemberIds(opportunity: NetworkOpportunity, now: Date): string[] {
+  if (!Number.isFinite(now.getTime())) invalid("Invalid invitation Clock time");
+  const at = now.toISOString();
+  if (
+    ![
+      "approved",
+      "inviting",
+      "partially_accepted",
+      "quorum_met",
+      ...(opportunity.kind === "monthly_event" ? ["scheduled"] : []),
+    ].includes(opportunity.state) ||
+    opportunity.review?.decision !== "approved" ||
+    opportunity.review.revision !== opportunity.revision ||
+    opportunity.expiresAt <= at ||
+    !hasRequiredOpportunityMembers(opportunity, availableOpportunityMemberIds(opportunity, at))
+  )
+    return [];
+  const sequential =
+    ["intro", "member_intro"].includes(opportunity.kind) ||
+    (opportunity.kind === "welcome" && opportunity.participantIds.length === 2);
+  return opportunity.participants
+    .filter(
+      (part, index) =>
+        part.revision === opportunity.revision &&
+        !part.invitedAt &&
+        part.state === "invited" &&
+        part.expiresAt > at &&
+        (!sequential ||
+          opportunity.participants
+            .slice(0, index)
+            .every((previous) => previous.state === "accepted")),
+    )
+    .map((part) => part.memberId);
+}
+export function receivingParticipantAllowed(
+  draft: Pick<OpportunityDraft, "kind" | "category" | "participantIds" | "roles">,
+  memberId: string,
+): boolean {
+  if (!draft.participantIds.includes(memberId)) return false;
+  if (draft.category === "romance") return false;
+  const role =
+    draft.roles?.[memberId] ??
+    (draft.kind === "help"
+      ? draft.participantIds[0] === memberId
+        ? "requester"
+        : "helper"
+      : "guest");
+  if (role === "host" || role === "helper") return false;
+  if (draft.kind === "help") return role === "requester";
+  return (
+    ["intro", "welcome", "event", "monthly_event"].includes(draft.kind) ||
+    (draft.kind === "group" && ["support", "care", "companionship"].includes(draft.category))
+  );
+}
+export const reasonCodes = new Set([
+  "approved",
+  "weak_reason",
+  "privacy_risk",
+  "capacity_concern",
+  "wrong_timing",
+  "safety",
+  "tone",
+  "duplicate",
+  "edited",
+  "other",
+]);
+
+export const defaultSettings: NetworkSettings = {
+  revision: 1,
+  matchingThreshold: 0.7,
+  weights: { fit: 0.5, capacity: 0.2, reliability: 0.15, exploration: 0.15 },
+  budgets: { normalWeek: 2, openWeek: 4, quietMonth: 1 },
+  proactiveCities: { SF: false, NYC: false },
+  reviewRequired: true,
+};
+export function denied(
+  message: string,
+  code: NetworkDomainError["code"] = "NETWORK_FORBIDDEN",
+): never {
+  throw new NetworkDomainError(code, message);
+}
+export function staff(actor: NetworkActor, roles: StaffRole[]): void {
+  if (actor.type === "system") return;
+  if (
+    actor.type !== "staff" ||
+    !actor.roles.some((role) => role === "admin" || roles.includes(role))
+  )
+    denied("Staff permission required");
+}
+export function owner(actor: NetworkActor, memberId: string): void {
+  if (actor.type === "system" || (actor.type === "staff" && actor.roles.includes("admin"))) return;
+  if (actor.type !== "member" || actor.memberId !== memberId) denied("Member ownership required");
+}
+export function dateAfter(at: string, duration: number): string {
+  return new Date(new Date(at).getTime() + duration).toISOString();
+}
+export function active(member: NetworkMember): void {
+  if (
+    member.accountState === "removed" ||
+    member.accountState === "restricted" ||
+    member.safetyHold
+  )
+    denied("Member unavailable", "NETWORK_INELIGIBLE");
+}
+export function bump(member: NetworkMember, at: string): void {
+  member.revision += 1;
+  member.updatedAt = at;
+}
+export function publicFact(fact: NetworkMember["facts"][number], at: string): boolean {
+  return (
+    fact.status === "confirmed" &&
+    (fact.scope === "matching" || fact.scope === "shareable") &&
+    (!fact.validFrom || fact.validFrom <= at) &&
+    (!fact.validTo || fact.validTo > at)
+  );
+}
+export function defaults(city: "SF" | "NYC"): Preferences {
+  return {
+    categories: [],
+    quietHours: { start: "21:00", end: "09:00" },
+    timezone: city === "SF" ? "America/Los_Angeles" : "America/New_York",
+    formats: [],
+    travelMinutes: 45,
+    romanceOptIn: false,
+    boundaries: [],
+    proactiveOptIn: false,
+    onlyWhenAsked: false,
+  };
+}
+export function staffMemberView(member: NetworkMember, includeContact = false): NetworkMember {
+  return {
+    ...member,
+    cloudUserId: includeContact ? member.cloudUserId : "",
+    displayName: includeContact
+      ? member.displayName
+      : `Member ${networkDigest(member.memberId).slice(0, 8)}`,
+    channels: includeContact ? member.channels : [],
+    sources: [],
+    facts: member.facts
+      .filter((fact) => fact.scope === "matching" || fact.scope === "shareable")
+      .map((fact) => ({ ...fact, sourceRef: "" })),
+    presence: member.presence.map((presence) => ({ ...presence, area: presence.city })),
+  };
+}
+export function validatePreferences(preferences: Preferences): void {
+  if (
+    preferences.explorationFraction !== undefined &&
+    (!Number.isFinite(preferences.explorationFraction) ||
+      preferences.explorationFraction < 0 ||
+      preferences.explorationFraction > 0.15)
+  )
+    invalid("Exploration must be between zero and fifteen percent");
+  for (const list of [preferences.categories, preferences.formats, preferences.boundaries]) {
+    if (!Array.isArray(list) || list.some((item) => typeof item !== "string" || !item.trim()))
+      invalid("Invalid preferences list");
+  }
+  if (
+    !preferences.quietHours ||
+    !/^([01]\d|2[0-3]):[0-5]\d$/.test(preferences.quietHours.start) ||
+    !/^([01]\d|2[0-3]):[0-5]\d$/.test(preferences.quietHours.end)
+  )
+    invalid("Invalid quiet hours");
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: preferences.timezone });
+  } catch {
+    invalid("Invalid timezone");
+  }
+  if (
+    !Number.isFinite(preferences.travelMinutes) ||
+    preferences.travelMinutes < 0 ||
+    preferences.travelMinutes > 240
+  )
+    invalid("Invalid travel tolerance");
+  for (const value of [
+    preferences.romanceOptIn,
+    preferences.proactiveOptIn,
+    preferences.onlyWhenAsked,
+  ])
+    if (typeof value !== "boolean") invalid("Invalid preference flag");
+}
+export function localWindowStart(at: string, timezone: string, monthly: boolean): string {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: timezone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    weekday: "short",
+  }).formatToParts(new Date(at));
+  const get = (kind: string) => parts.find((part) => part.type === kind)?.value ?? "";
+  let target = Date.UTC(
+    Number(get("year")),
+    Number(get("month")) - 1,
+    monthly ? 1 : Number(get("day")),
+  );
+  if (!monthly)
+    target -=
+      (({ Mon: 0, Tue: 1, Wed: 2, Thu: 3, Fri: 4, Sat: 5, Sun: 6 } as Record<string, number>)[
+        get("weekday")
+      ] ?? 0) * DAY;
+  let candidate = target;
+  for (let iteration = 0; iteration < 4; iteration++) {
+    const local = new Intl.DateTimeFormat("en-US", {
+      timeZone: timezone,
+      hourCycle: "h23",
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+      hour: "2-digit",
+      minute: "2-digit",
+      second: "2-digit",
+    }).formatToParts(new Date(candidate));
+    const value = (kind: string) => Number(local.find((part) => part.type === kind)?.value);
+    const wall = Date.UTC(
+      value("year"),
+      value("month") - 1,
+      value("day"),
+      value("hour"),
+      value("minute"),
+      value("second"),
+    );
+    const difference = target - wall;
+    if (difference === 0) break;
+    candidate += difference;
+  }
+  return new Date(candidate).toISOString();
+}
+
+export function projectMemberOpportunity(
+  item: NetworkOpportunity,
+  memberId: string,
+): MemberOpportunityView {
+  const participation = item.participants.find((part) => part.memberId === memberId);
+  if (!participation || !participation.invitedAt)
+    denied("Opportunity is not privately invited to member");
+  const ownAccepted = ["accepted", "confirmed", "attended", "no_show"].includes(
+    participation.state,
+  );
+  const connectedState = [
+    "mutually_accepted",
+    "quorum_met",
+    "scheduling",
+    "scheduled",
+    "reschedule_requested",
+    "needs_replacement",
+    "in_progress",
+    "completed",
+    "feedback_collected",
+  ].includes(item.state);
+  const requiredConsent = hasRequiredOpportunityMembers(
+    item,
+    ["completed", "feedback_collected"].includes(item.state)
+      ? consentedOpportunityMemberIds(item)
+      : item.participants
+          .filter(
+            (part) =>
+              part.revision === item.revision &&
+              part.acceptedAt &&
+              ["accepted", "confirmed", "attended", "no_show"].includes(part.state),
+          )
+          .map((part) => part.memberId),
+  );
+  const connected = ownAccepted && connectedState && requiredConsent;
+  const state: MemberOpportunityView["state"] =
+    connectedState && !requiredConsent
+      ? "closed"
+      : !ownAccepted &&
+          ["declined", "expired", "cancelled_with_notice", "replaced"].includes(participation.state)
+        ? "closed"
+        : terminalStates.has(item.state) &&
+            !["completed", "feedback_collected"].includes(item.state)
+          ? "closed"
+          : ["completed", "feedback_collected"].includes(item.state)
+            ? ownAccepted
+              ? "completed"
+              : "closed"
+            : item.state === "scheduled"
+              ? ownAccepted
+                ? "scheduled"
+                : "closed"
+              : connected
+                ? "connected"
+                : participation.state === "accepted"
+                  ? "accepted"
+                  : "pending";
+  return {
+    id: item.id,
+    revision: item.revision,
+    kind: item.kind,
+    objective: item.objective,
+    category: item.category,
+    city: item.city,
+    state,
+    ownParticipation: participation,
+    explanation: item.explanations[memberId]?.text ?? "",
+    connectedMemberIds:
+      connected && item.kind !== "monthly_event"
+        ? item.participants
+            .filter(
+              (part) =>
+                ["accepted", "confirmed", "attended", "no_show"].includes(part.state) &&
+                part.memberId !== memberId,
+            )
+            .map((part) => part.memberId)
+        : [],
+    expiresAt: item.expiresAt,
+    ...(item.kind === "monthly_event" ? { programme: item.programme } : {}),
+  };
+}
