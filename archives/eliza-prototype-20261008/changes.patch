+        "resolve_relay_case",
+        "restricted_safety_case_reveal",
+      ]);
+      const events = (await store.list<NetworkEvent>("events")).map((event) =>
+        safetyAccess || !safetyEventKinds.has(event.kind)
+          ? event
+          : {
+              ...event,
+              id: `restricted:${networkDigest([this.options.networkId, event.id])}`,
+              actor:
+                event.actor.type === "member"
+                  ? { ...event.actor, memberId: "[restricted]" }
+                  : event.actor.type === "staff"
+                    ? { ...event.actor, userId: "[restricted]" }
+                    : event.actor,
+              memberIds: [],
+              opportunityId: null,
+              details: { restricted: true },
+            },
+      );
+      const opportunities = (await store.list<NetworkOpportunity>("opportunities")).map((item) => ({
+        ...item,
+        review: item.review ? { ...item.review, note: "" } : null,
+        ...(item.blindReviews
+          ? { blindReviews: item.blindReviews.map((review) => ({ ...review, note: "" })) }
+          : {}),
+      }));
+      const matchingRuns = await store.list<Record<string, unknown>>("matching_runs");
+      const settings =
+        (await store.list<NetworkSettings>("settings"))[0] ?? structuredClone(defaultSettings);
+      return scrubNetworkProjection(
+        {
+          members,
+          opportunities,
+          invites,
+          safetyCases,
+          feedback,
+          events,
+          matchingRuns,
+          settings,
+          attendanceEvidence: await store.list<AttendanceEvidence>("attendance_evidence"),
+        },
+        `${this.options.networkId}:staff`,
+      );
+    });
+  }
+  async revealSafetyCase(actor: NetworkActor, caseId: string, purpose: string) {
+    this.validateActor(actor);
+    staff(actor, ["safety"]);
+    if (actor.type !== "staff")
+      denied("Authenticated safety reviewer required", "NETWORK_FORBIDDEN");
+    text(caseId, "case identity", 160);
+    text(purpose, "restricted evidence purpose", 500);
+    const at = this.now();
+    return this.options.db.transaction(async (execute) => {
+      const store = new DomainStore(execute, this.options.networkId);
+      const item = await store.get<SafetyCase>("safety_cases", caseId);
+      const members = (await store.list<NetworkMember>("members")).filter(
+        (member) =>
+          member.memberId === item.reporterId ||
+          member.memberId === item.reportedId ||
+          member.memberId === item.sourceSenderId,
+      );
+      assertKnownDisclosure(members, purpose);
+      const eventId = "safety-reveal:" + randomUUID();
+      await store.save(
+        "events",
+        eventId,
+        {
+          id: eventId,
+          at,
+          actor,
+          kind: "restricted_safety_case_reveal",
+          memberIds: [],
+          opportunityId: item.evidenceRef?.opportunityId ?? null,
+          details: { caseId, purpose },
+        },
+        at,
+      );
+      return item;
+    });
+  }
+  async blindReviewView(actor: NetworkActor, opportunityId: string, expectedRevision: number) {
+    this.validateActor(actor);
+    staff(actor, ["reviewer"]);
+    if (actor.type !== "staff") denied("Authenticated reviewer required", "NETWORK_FORBIDDEN");
+    text(opportunityId, "opportunity identity", 160);
+    if (!Number.isSafeInteger(expectedRevision) || expectedRevision < 1)
+      invalid("Invalid opportunity revision");
+    const at = this.now();
+    return this.options.db.transaction(async (execute) => {
+      const store = new DomainStore(execute, this.options.networkId);
+      const item = await this.opportunity(store, opportunityId, expectedRevision);
+      if (
+        item.review?.reviewerId === actor.userId ||
+        item.blindReviews?.some(
+          (review) => review.revision === item.revision && review.reviewerId === actor.userId,
+        )
+      )
+        denied("Independent unsubmitted reviewer required", "NETWORK_CONFLICT");
+      const {
+        review: _review,
+        state: _state,
+        blindReviews: _blind,
+        reviewWork: _work,
+        participants: _participants,
+        updatedAt: _updated,
+        ...proposal
+      } = item;
+      const eventId = "blind-read:" + randomUUID();
+      await store.save(
+        "events",
+        eventId,
+        {
+          id: eventId,
+          at,
+          actor,
+          kind: "blind_review_opened",
+          memberIds: item.participantIds,
+          opportunityId: item.id,
+          details: { opportunityRevision: item.revision },
+        },
+        at,
+      );
+      return scrubNetworkProjection(proposal, this.options.networkId + ":blind-review");
+    });
+  }
+  async revealMember(
+    actor: NetworkActor,
+    memberId: string,
+    purpose: string,
+  ): Promise<NetworkMember> {
+    this.validateActor(actor);
+    staff(actor, ["safety"]);
+    text(purpose, "restricted access purpose", 500);
+    const at = this.now();
+    return this.options.db.transaction(async (execute) => {
+      const store = new DomainStore(execute, this.options.networkId);
+      const member = await store.get<NetworkMember>("members", memberId);
+      assertKnownDisclosure([member], purpose);
+      const event: NetworkEvent = {
+        id: `reveal:${randomUUID()}`,
+        at,
+        actor,
+        kind: "restricted_member_reveal",
+        memberIds: [memberId],
+        opportunityId: null,
+        details: { purpose },
+      };
+      await store.save("events", event.id, event, at);
+      return staffMemberView(member, true);
+    });
+  }
+  private async matchingRequester(
+    store: DomainStore,
+    proof: NetworkRequestProof,
+    at: string,
+  ): Promise<NetworkMember> {
+    for (const value of [proof.memberId, proof.intentId, proof.requestId])
+      text(value, "request proof", 160);
+    const event = await store.get<NetworkEvent>("events", proof.requestId);
+    if (
+      event.kind !== "manage_intent" ||
+      event.actor.type !== "member" ||
+      event.actor.memberId !== proof.memberId ||
+      event.details.intentId !== proof.intentId
+    )
+      denied("Matching request has no authenticated own-intent proof");
+    const age = Date.parse(at) - Date.parse(event.at);
+    if (!Number.isFinite(age) || age < 0 || age > 72 * 3_600_000)
+      denied("Matching request proof expired", "NETWORK_EXPIRED");
+    const rows = await store.execute(
+      `SELECT result AS payload FROM network.commands WHERE network_id=${sqlQuote(this.options.networkId)} AND request_id=${sqlQuote(proof.requestId)} AND digest_version=2`,
+    );
+    if (!rows.length) denied("Matching request receipt unavailable");
+    const original = payload<NetworkMember>(rows[0]);
+    const member = await store.get<NetworkMember>("members", proof.memberId);
+    const intent = member.intents.find((entry) => entry.id === proof.intentId);
+    if (
+      member.accountState !== "active" ||
+      member.safetyHold ||
+      member.participation === "paused" ||
+      !intent ||
+      intent.status !== "active" ||
+      intent.expiresAt <= at ||
+      event.details.intentDigest !== networkDigest(intent) ||
+      original.memberId !== member.memberId ||
+      networkDigest(original.preferences) !== networkDigest(member.preferences) ||
+      original.participation !== member.participation
+    )
+      denied("Matching request changed or was withdrawn", "NETWORK_CONFLICT");
+    return member;
+  }
+  async assertMatchingRequester(actor: NetworkActor, proof: NetworkRequestProof): Promise<void> {
+    this.validateActor(actor);
+    if (actor.type === "member") owner(actor, proof.memberId);
+    else staff(actor, ["engineer"]);
+    await this.options.db.transaction(async (execute) => {
+      await this.matchingRequester(
+        new DomainStore(execute, this.options.networkId),
+        proof,
+        this.now(),
+      );
+    });
+  }
+  async getSettings(actor: NetworkActor): Promise<NetworkSettings> {
+    staff(actor, ["engineer", "analyst"]);
+    const values = await new DomainStore(
+      this.options.db.execute,
+      this.options.networkId,
+    ).list<NetworkSettings>("settings");
+    return values[0] ?? structuredClone(defaultSettings);
+  }
+  async getMatchingRun(actor: NetworkActor, runId: string): Promise<NetworkMatchingRun | null> {
+    this.validateActor(actor);
+    staff(actor, ["engineer"]);
+    text(runId, "runId", 160);
+    try {
+      const run = await new DomainStore(
+        this.options.db.execute,
+        this.options.networkId,
+      ).get<NetworkMatchingRun>("matching_runs", runId);
+      if (run.sourceDataErased)
+        throw new NetworkDomainError(
+          "NETWORK_IDEMPOTENCY",
+          "Matching source data was erased; the original run cannot be replayed",
+          { rule: "matching_source_data_erased" },
+        );
+      return run;
+    } catch (error) {
+      if (error instanceof NetworkDomainError && error.code === "NETWORK_NOT_FOUND") return null;
+      throw error;
+    }
+  }
+  async exportMember(actor: NetworkActor, memberId: string): Promise<Record<string, unknown>> {
+    owner(actor, memberId);
+    const view = await this.memberView({ type: "member", memberId });
+    const store = new DomainStore(this.options.db.execute, this.options.networkId);
+    const cases = (await store.list<SafetyCase>("safety_cases"))
+      .filter((item) => item.reporterId === memberId)
+      .map((item) => ({
+        ...item,
+        reportedId: null,
+        ...(item.appeal && item.appeal.memberId !== memberId
+          ? {
+              appeal: { ...item.appeal, reason: "", decisionReason: "" },
+            }
+          : {}),
+        ...(item.moderation ? { moderation: { ...item.moderation, reason: "" } } : {}),
+      }));
+    const events = (await store.list<NetworkEvent>("events"))
+      .filter((item) => item.actor.type === "member" && item.actor.memberId === memberId)
+      .map((item) => ({ ...item, memberIds: [memberId] }));
+    return {
+      format: "network-member-export-v1",
+      exportedAt: this.now(),
+      ...view,
+      reports: cases,
+      events,
+      retentionNotice:
+        "Safety cases and minimal audit identities require the host's approved retention policy. External channel history and graph/media erasure must be composed by their existing owners.",
+    };
+  }
+}
diff --git a/packages/cloud/shared/src/lib/network/domain/store.ts b/packages/cloud/shared/src/lib/network/domain/store.ts
new file mode 100644
index 000000000000..75d862be1a01
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/domain/store.ts
@@ -0,0 +1,96 @@
+import { type CarveOutSqlExecutor, sqlJson, sqlQuote } from "@elizaos/plugin-sql";
+import { networkDigest } from "../digest";
+import {
+  NetworkDomainError,
+  type NetworkOpportunity,
+  type OpportunityDraft,
+  type OpportunityState,
+} from "./types";
+
+export type NetworkTable =
+  | "members"
+  | "invites"
+  | "opportunities"
+  | "safety_cases"
+  | "feedback"
+  | "events"
+  | "matching_runs"
+  | "settings"
+  | "attendance_evidence";
+// settings are versioned product policy records, not a general configuration store.
+export const terminalStates = new Set([
+  "rejected_in_review",
+  "declined",
+  "expired",
+  "quorum_failed",
+  "cancelled",
+  "abandoned",
+  "feedback_collected",
+  "completed",
+]);
+export function activeOpportunityKey(
+  value: Pick<OpportunityDraft, "kind" | "category" | "objective" | "participantIds"> & {
+    state?: OpportunityState;
+  },
+): string | null {
+  if (value.state && terminalStates.has(value.state)) return null;
+  return networkDigest([
+    value.kind,
+    value.category,
+    value.objective.toLowerCase().replace(/\s+/g, " ").trim(),
+    [...value.participantIds].sort(),
+  ]);
+}
+export function payload<T>(row: Record<string, unknown>): T {
+  const value = row.payload;
+  if (typeof value === "string") return JSON.parse(value) as T;
+  if (value && typeof value === "object" && !Array.isArray(value)) return value as T;
+  throw new NetworkDomainError("NETWORK_INVALID", "Stored Network record is invalid");
+}
+export class DomainStore {
+  constructor(
+    readonly execute: CarveOutSqlExecutor,
+    readonly networkId: string,
+  ) {}
+  async get<T>(table: NetworkTable, id: string): Promise<T> {
+    const rows = await this.execute(
+      `SELECT payload FROM network.${table} WHERE network_id=${sqlQuote(this.networkId)} AND id=${sqlQuote(id)}`,
+    );
+    if (!rows[0]) throw new NetworkDomainError("NETWORK_NOT_FOUND", "Network record not found");
+    return payload<T>(rows[0]);
+  }
+  async list<T>(table: NetworkTable, ids?: readonly string[]): Promise<T[]> {
+    if (ids?.length === 0) return [];
+    const sequenced = table === "events" || table === "attendance_evidence";
+    const rows = await this.execute(
+      `SELECT payload${sequenced ? ",sequence" : ""} FROM network.${table} WHERE network_id=${sqlQuote(this.networkId)}${ids ? ` AND id IN (${ids.map(sqlQuote).join(",")})` : ""} ORDER BY ${table === "events" ? "occurred_at,sequence" : table === "attendance_evidence" ? "updated_at,sequence" : "id"}`,
+    );
+    return rows.map((row) => {
+      if (!sequenced) return payload<T>(row);
+      const sequence = Number(row.sequence);
+      if (!Number.isSafeInteger(sequence) || sequence < 1)
+        throw new NetworkDomainError("NETWORK_INVALID", "Stored event chronology is invalid");
+      return { ...payload<Record<string, unknown>>(row), sequence } as T;
+    });
+  }
+  async save(table: NetworkTable, id: string, value: unknown, at: string): Promise<void> {
+    const key =
+      table === "opportunities" ? activeOpportunityKey(value as NetworkOpportunity) : null;
+    const columns = table === "opportunities" ? ",active_key" : "";
+    const keyValue = table === "opportunities" ? `,${key === null ? "NULL" : sqlQuote(key)}` : "";
+    const update = table === "opportunities" ? ",active_key=EXCLUDED.active_key" : "";
+    const timestamp = table === "events" ? "occurred_at" : "updated_at";
+    const conflict =
+      table === "events"
+        ? "DO NOTHING"
+        : `DO UPDATE SET payload=EXCLUDED.payload,${timestamp}=EXCLUDED.${timestamp}${update}`;
+    await this.execute(
+      `INSERT INTO network.${table}(network_id,id,payload,${timestamp}${columns}) VALUES (${sqlQuote(this.networkId)},${sqlQuote(id)},${sqlJson(value)}::jsonb,${sqlQuote(at)}${keyValue}) ON CONFLICT(network_id,id) ${conflict}`,
+    );
+    if (table === "invites" && (value as { vouch: unknown }).vouch === null) {
+      await this.execute(
+        `UPDATE network.commands SET result=${sqlJson({ ok: true, kind: "invite_data_removed", id })}::jsonb WHERE network_id=${sqlQuote(this.networkId)} AND result->>'id'=${sqlQuote(id)} AND result ? 'tokenHash'`,
+      );
+    }
+  }
+}
diff --git a/packages/cloud/shared/src/lib/network/domain/types.ts b/packages/cloud/shared/src/lib/network/domain/types.ts
