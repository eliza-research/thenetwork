+} from "../domain/types.ts";
+import { SimClock } from "../evaluation/fixtures.ts";
+import { createNetworkNativeOwners } from "../native-owners/service.ts";
+import { runtimeInSqlTransaction } from "../runtime-sql.ts";
+import { summarizeNetworkOperations } from "./analytics.ts";
+
+const JULY = "2026-07-01T00:00:00.000Z";
+const AUGUST = "2026-08-01T00:00:00.000Z";
+const OCTOBER = "2026-10-01T00:00:00.000Z";
+function member(memberId: string, overrides: Partial<NetworkMember> = {}): NetworkMember {
+  return {
+    memberId,
+    cloudUserId: memberId,
+    displayName: "Scrubbed member",
+    age: "adult",
+    homeCities: ["SF"],
+    accountState: "active",
+    participation: "normal",
+    safetyHold: false,
+    revision: 1,
+    createdAt: JULY,
+    updatedAt: JULY,
+    inviteId: null,
+    termsVersion: "fixture",
+    channels: [],
+    facts: [],
+    intents: [],
+    presence: [],
+    sources: [],
+    blockedMemberIds: [],
+    consecutiveUnanswered: 0,
+    preferences: {
