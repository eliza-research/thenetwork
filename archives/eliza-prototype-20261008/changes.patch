+import { sqlQuote } from "@elizaos/plugin-sql";
+import { networkDigest } from "../digest.ts";
+import { teenContentAllowed } from "../domain/policy.ts";
+import type { NetworkDomain } from "../domain/service.ts";
+import { DomainStore } from "../domain/store.ts";
+import {
+  type NetworkActor,
+  NetworkDomainError,
+  type NetworkEvent,
+  type NetworkMember,
+} from "../domain/types.ts";
+import { iso, record, text } from "../domain/validation.ts";
+import { DEFAULT_MATCHING_CONFIG } from "../matching/config.ts";
+import type { WorldSourceProvider } from "../matching/providers.ts";
+import type { WorldAnchor } from "../matching/types.ts";
+
+export interface LocalWorldFixture {
+  id: string;
+  title: string;
+  kind: "event" | "place";
+  anchor: WorldAnchor;
+  sequence: number;
+}
+/** Conservative authored-fixture filter; this is not a qualified external content classifier. */
+export function localWorldAllowed(member: NetworkMember, fixture: LocalWorldFixture): boolean {
+  return (
+    member.age === "adult" ||
+    teenContentAllowed(
+      [fixture.title, fixture.anchor.area, fixture.anchor.category, ...fixture.anchor.tags].join(
+        " ",
+      ),
+    )
+  );
+}
+
+/** The domain event owner retains authored source revisions; the fixture host does not invent another cache. */
+export async function readLocalWorldFixtures(domain: NetworkDomain): Promise<LocalWorldFixture[]> {
+  const records = new Map<string, LocalWorldFixture>();
+  const rows = await domain.options.db.execute(
+    `SELECT payload,sequence FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)} AND payload->>'kind'='local_world_fixture' ORDER BY sequence`,
+  );
+  for (const row of rows) {
+    const event: unknown = typeof row.payload === "string" ? JSON.parse(row.payload) : row.payload;
+    record(event);
+    record(event.details);
+    iso(event.at, "retained source observation");
+    const sequence = Number(row.sequence);
+    if (!Number.isSafeInteger(sequence) || sequence < 1)
+      throw new Error("Retained public source sequence unavailable");
+    const value = event.details;
+    if (
+      typeof value.id !== "string" ||
+      typeof value.title !== "string" ||
+      (value.kind !== "event" && value.kind !== "place") ||
+      typeof value.city !== "string" ||
+      typeof value.area !== "string" ||
+      !Array.isArray(value.tags) ||
+      !value.tags.every((tag): tag is string => typeof tag === "string") ||
+      typeof value.sourceUrl !== "string" ||
+      typeof value.startsAt !== "string" ||
+      typeof value.endsAt !== "string" ||
+      typeof value.expiresAt !== "string"
+    )
+      throw new Error("Persisted local world fixture is invalid");
+    iso(value.startsAt, "fixture start");
+    iso(value.endsAt, "fixture end");
+    iso(value.expiresAt, "fixture expiry");
+    const source = new URL(value.sourceUrl);
+    if (
+      source.hostname !== "network-fixtures.invalid" ||
+      source.protocol !== "https:" ||
+      source.username ||
+      source.password ||
+      source.pathname !==
+        `/world/${networkDigest(domain.options.networkId)}/${networkDigest(value.id)}`
+    )
+      throw new Error("Persisted fixture source does not belong to this local world");
+    records.set(value.id, {
+      id: value.id,
+      title: value.title,
+      kind: value.kind,
+      sequence,
+      anchor: {
+        id: value.id,
+        category: typeof value.category === "string" ? value.category : "culture",
+        city: value.city,
+        tags: value.tags,
+        window: { start: Date.parse(value.startsAt), end: Date.parse(value.endsAt) },
+        area: value.area,
+        sourceUrl: value.sourceUrl,
+        observedAt: Date.parse(event.at),
+        expiresAt: Date.parse(value.expiresAt),
+        verified: true,
+      },
+    });
+  }
+  return [...records.values()].sort((a, b) => a.id.localeCompare(b.id));
+}
+
+/** Qualified here means operator-authored fixture provenance, never independently verified real-world knowledge. */
+export function localWorldProvider(domain: NetworkDomain): WorldSourceProvider {
+  return {
+    sourceId: "network-local-authored-fixtures-v1",
+    async read({ city, from, until }) {
+      const now = domain.options.clock.now().getTime();
+      return (await readLocalWorldFixtures(domain))
+        .map((fixture) => fixture.anchor)
+        .filter(
+          (anchor) =>
+            anchor.city === city &&
+            anchor.observedAt <= now &&
+            anchor.expiresAt > now &&
+            anchor.window.start < until &&
+            anchor.window.end > from,
+        );
+    },
+  };
+}
+
+export async function publishLocalWorldFixture(
+  domain: NetworkDomain,
+  actor: NetworkActor,
+  input: Record<string, unknown>,
+) {
+  if (!["test:", "simulation:"].some((prefix) => domain.options.networkId.startsWith(prefix)))
+    throw new NetworkDomainError(
+      "NETWORK_FORBIDDEN",
+      "Authored fixtures require an isolated local domain",
+    );
+  text(input.requestId, "fixture request", 120);
+  text(input.title, "fixture title", 500);
+  text(input.area, "public area", 500);
+  const digest = networkDigest([actor, input]);
+  const [previous] = await new DomainStore(
+    domain.options.db.execute,
+    domain.options.networkId,
+  ).list<NetworkEvent>("events", [input.requestId]);
+  if (previous) {
+    if (previous.kind !== "local_world_fixture" || previous.details.inputDigest !== digest)
+      throw new NetworkDomainError("NETWORK_IDEMPOTENCY", "Fixture request identity was reused");
+    return domain.command(actor, {
+      type: "record_event",
+      requestId: input.requestId,
+      kind: "local_world_fixture",
+      memberIds: [],
+      opportunityId: null,
+      details: previous.details,
+    });
+  }
+  if (input.city !== "SF" && input.city !== "NYC")
+    throw new NetworkDomainError("NETWORK_INVALID", "Fixture city required");
+  if (input.kind !== "event" && input.kind !== "place")
+    throw new NetworkDomainError("NETWORK_INVALID", "Fixture kind required");
+  if (
+    input.category !== undefined &&
+    (typeof input.category !== "string" ||
+      !DEFAULT_MATCHING_CONFIG.allowedCategories.includes(input.category))
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Choose a supported source category");
+  if (
+    typeof input.freshHours !== "number" ||
+    !Number.isFinite(input.freshHours) ||
+    input.freshHours < 1 ||
+    input.freshHours > 168
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Fixture freshness must be 1–168 hours");
+  iso(input.startsAt, "fixture start");
+  iso(input.endsAt, "fixture end");
+  if (
+    Date.parse(input.startsAt) <= domain.options.clock.now().getTime() ||
+    input.endsAt <= input.startsAt
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "A future fixture window is required");
+  if (typeof input.tags !== "string")
+    throw new NetworkDomainError("NETWORK_INVALID", "Fixture tags must be text");
+  const id =
+    typeof input.fixtureId === "string"
+      ? input.fixtureId
+      : `fixture:${networkDigest(input.requestId).slice(0, 24)}`;
+  text(id, "fixture identity", 160);
+  return domain.command(actor, {
+    type: "record_event",
+    requestId: input.requestId,
+    kind: "local_world_fixture",
+    memberIds: [],
+    opportunityId: null,
+    details: {
+      id,
+      inputDigest: digest,
+      title: input.title,
+      kind: input.kind,
+      category: input.category ?? "culture",
+      city: input.city,
+      area: input.area,
+      tags: [
+        ...new Set(
+          input.tags
+            .split(",")
+            .map((tag) => tag.trim())
+            .filter(Boolean),
+        ),
+      ],
+      startsAt: input.startsAt,
+      endsAt: input.endsAt,
+      sourceUrl: `https://network-fixtures.invalid/world/${networkDigest(domain.options.networkId)}/${networkDigest(id)}`,
+      expiresAt: new Date(
+        domain.options.clock.now().getTime() + input.freshHours * 3600000,
+      ).toISOString(),
+      qualification: "operator_authored_synthetic_fixture",
+    },
+  });
+}
