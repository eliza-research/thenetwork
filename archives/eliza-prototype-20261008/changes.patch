+import { NetworkDataExport } from "../shared/src/lib/network/workbench/data-export.ts";
+import { createLocalNetworkHost } from "../shared/src/lib/network/workbench/host.ts";
+import type { NetworkWorkbenchOperations } from "../shared/src/lib/network/workbench/operations.ts";
+import { createNativeSimulationTransport } from "../shared/src/lib/network/workbench/simulation-ingress.ts";
+import { NetworkSimulationLab } from "../shared/src/lib/network/workbench/simulation-lab.ts";
+import { systemClock } from "../shared/src/lib/services/containers/compute-rate-governor.ts";
+import { localNetworkExportWriter } from "./network-data-export.ts";
+
+const repo = fileURLToPath(new URL("../../../", import.meta.url));
+const directory = join(repo, "test-results/network-app");
+await mkdir(directory, { recursive: true });
+const clock = new SimClock(Date.parse("2026-10-06T16:00:00.000Z"));
+process.env.ELIZA_STATE_DIR = join(directory, "media-state");
+let operations: NetworkWorkbenchOperations | undefined;
+const host = await createLocalNetworkHost({
+  dataDir: join(directory, "db"),
+  networkId: "test:local-network-review",
+  clock,
+  async dispatchOperations(record) {
+    const binding = record.metadata?.network;
+    if (
+      !operations ||
+      !binding ||
+      typeof binding !== "object" ||
+      !("networkId" in binding) ||
+      binding.networkId !== "test:local-network-review" ||
+      !("scope" in binding)
+    )
+      throw new NetworkDomainError(
+        "NETWORK_FORBIDDEN",
+        "Current local operations binding required",
+      );
+    if (binding.scope === "simulation_lab")
+      return operations.simulation.dispatch(record);
+    if (binding.scope === "data_export")
+      return operations.data.dispatch(record);
+    throw new NetworkDomainError("NETWORK_INVALID", "Unknown operations scope");
+  },
+});
+const { native, domain } = host;
+const SYSTEM = { type: "system" } as const;
+let initial = await domain.adminView(SYSTEM);
+const latest = initial.events.reduce(
+  (latest, event) =>
+    Math.max(
+      latest,
+      Date.parse(event.at),
+      event.kind === "clock_advanced" &&
+        typeof event.details.targetAt === "string"
+        ? Date.parse(event.details.targetAt)
+        : latest,
+    ),
+  clock.now().getTime(),
+);
+clock.advanceTo(latest);
+await domain.withAuthority(async (_joined, sql) =>
+  native.synchronize(sql.execute),
+);
+if (!initial.members.length) {
+  await seedSimulationMembers(domain, 160, 7);
+  const settings = await domain.getSettings(SYSTEM);
+  const { revision, ...values } = settings;
+  await domain.command(SYSTEM, {
+    type: "configure",
+    requestId: "local:activate-cities",
+    expectedRevision: revision,
+    settings: { ...values, proactiveCities: { SF: true, NYC: true } },
+  });
+}
+initial = await domain.adminView(SYSTEM);
+
+operations = {
+  simulation: new NetworkSimulationLab({
+    domain,
+    scheduler: host.runner,
+    clock,
+    wallClock: systemClock,
+    createWorld: ({ runId, attempt, networkId, clock: worldClock }) =>
+      createLocalNetworkHost({
+        dataDir: join(
+          directory,
+          "simulation-worlds",
+          runId.replaceAll(":", "-"),
+          `attempt-${attempt}`,
+        ),
+        networkId,
+        clock: worldClock,
+      }),
+    transport: createNativeSimulationTransport,
+  }),
+  data: new NetworkDataExport({
+    domain,
+    scheduler: host.runner,
+    clock,
+    writer: localNetworkExportWriter,
+    graph: native.adminGraph,
+  }),
+};
+await operations.simulation.recover();
+await operations.data.scheduleNightly();
+await operations.data.invalidateDeleted();
+if (!(await operations.data.latest(SYSTEM)))
+  await operations.data.export(SYSTEM, `startup:${clock.now().toISOString()}`);
+const api = await createLocalNetworkApplication(host, clock, operations);
+let draining: Promise<unknown> | undefined;
+const drainTimer = setInterval(() => {
+  if (draining) return;
+  draining = host
+    .drainDue()
+    .catch((error) => host.runtime.reportError("network.local.drain", error))
+    .finally(() => {
+      draining = undefined;
+    });
+}, 1000);
+const port = 54732;
+const server = Bun.serve({
+  hostname: "127.0.0.1",
+  port,
+  maxRequestBodySize: 1_048_576,
+  async fetch(request) {
+    const url = new URL(request.url);
+    if (url.host !== `127.0.0.1:${port}` && url.host !== `localhost:${port}`)
+      return Response.json({ error: "Local host required" }, { status: 403 });
+    if (url.pathname.startsWith("/api/network/")) return api(request);
+    if (
+      url.pathname === "/assets/network.js" ||
+      url.pathname === "/assets/network.css"
+    )
+      return new Response(
+        Bun.file(
+          join(
+            repo,
+            "test-results/network-ui/build",
+            url.pathname.endsWith(".js") ? "network.js" : "network.css",
+          ),
+        ),
+      );
+    if (
+      [
+        "/",
+        "/workbench",
+        "/admin",
+        "/portal",
+        "/friend-help",
+        "/slop-love",
+      ].includes(url.pathname)
+    )
+      return new Response(
+        Bun.file(join(repo, "packages/ui/src/network/index.html")),
+        {
+          headers: { "Content-Type": "text/html; charset=utf-8" },
+        },
+      );
+    return Response.json({ error: "Not found" }, { status: 404 });
+  },
+});
+console.log(`Network local review: ${server.url}`);
+const shutdown = async () => {
+  clearInterval(drainTimer);
+  server.stop(true);
+  await operations?.simulation.shutdown();
+  await draining;
+  await host.close();
+  process.exit(0);
+};
+process.once("SIGINT", shutdown);
+process.once("SIGTERM", shutdown);
