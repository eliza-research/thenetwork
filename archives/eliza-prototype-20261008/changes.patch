+import { expect, it } from "vitest";
+import { buildMatchingRun, DEFAULT_MATCHING_CONFIG } from "./engine.ts";
+import { DAY, NOW, testInput } from "./test-fixtures.ts";
+
+it("monthly planning uses fresh sourced event anchors and cannot invent an unanchored activity", async () => {
+  const input = testInput(6);
+  input.constraints = { eventAnchorsOnly: true };
+  const config = { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 0.5 };
+  expect((await buildMatchingRun(input, { config })).proposals).toEqual([]);
+  const event = {
+    id: "public-event:next-month",
+    category: "music",
+    city: "SF",
+    tags: ["jazz"],
+    window: input.window,
+    area: "public square",
+    sourceUrl: "https://network-fixtures.invalid/public-event",
+    observedAt: NOW,
+    expiresAt: NOW + DAY,
+    verified: true,
+  };
+  input.events = [event];
+  const sourced = await buildMatchingRun(input, { config });
+  expect(sourced.proposals.length).toBeGreaterThan(0);
+  expect(sourced.proposals.every((proposal) => proposal.anchorId === event.id)).toBe(true);
+  expect(
+    sourced.proposals.every((proposal) => ["event_anchor", "group"].includes(proposal.generator)),
+  ).toBe(true);
+  event.expiresAt = NOW;
+  expect((await buildMatchingRun(input, { config })).proposals).toEqual([]);
+});
