+  expect(JSON.stringify(summary)).not.toContain("PRIVATE_REPORT");
+  expect(JSON.stringify(summary)).not.toContain("not-an-accused-target");
+  expect(summarizeNetworkSafetyReports([])).toMatchObject({
+    reports: 0,
+    byReporter: {},
+    byTarget: {},
+    repeatedReporters: 0,
+    repeatedTargets: 0,
