+  private async refreshReliability(
+    store: DomainStore,
+    evidence: AttendanceEvidence,
+    recovered = false,
+  ): Promise<void> {
+    const member = await store.get<NetworkMember>("members", evidence.memberId);
+    if (member.accountState === "removed") return;
+    const observations = (await store.list<AttendanceEvidence>("attendance_evidence")).filter(
+      (item) => item.memberId === member.memberId,
+    );
+    const missed = new Map<string, boolean>();
+    for (const observation of observations) {
+      if (observation.observation === "no_show") missed.set(observation.opportunityId, true);
+      else if (observation.source !== "self") missed.set(observation.opportunityId, false);
+    }
+    const noShows = [...missed.values()].filter(Boolean).length;
+    if (recovered || (evidence.source !== "self" && noShows < 2 && member.reliabilityHold))
+      member.reliabilityHold = null;
+    else if (evidence.observation === "no_show" && noShows >= 2)
+      member.reliabilityHold = {
+        group: true,
+        timeSensitive: true,
+        since: member.reliabilityHold?.since ?? evidence.createdAt,
+        reason: "repeated_unexplained_misses",
+      };
+    else return;
+    bump(member, evidence.createdAt);
+    await store.save("members", member.memberId, member, evidence.createdAt);
+  }
