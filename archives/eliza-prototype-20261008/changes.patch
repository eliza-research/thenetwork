+import { PseudonymSession, RegexEntityRecognizer } from "@elizaos/core";
+import { describe, expect, it } from "vitest";
+import { scrubNetworkProjection } from "../domain/policy.js";
+
+describe("complete privacy projection at Network world scale", () => {
+  it("scrubs a corpus beyond one prompt walk budget without losing records or alias consistency", async () => {
+    const corpus = {
+      members: Array.from({ length: 2000 }, (_, index) => ({
+        id: `member:${index}`,
+        nested: {
+          email: "private.person@example.com",
+          values: Array.from({ length: 20 }, (_, slot) => ({
+            index,
+            slot,
+            text: `record-${index}-${slot}`,
+          })),
+        },
+      })),
+    };
+    const baseline = new PseudonymSession({
+      salt: "world",
+      recognizer: new RegexEntityRecognizer({ email: true }),
+    });
+    expect(() => baseline.substituteInValue(corpus)).toThrow("walk budget");
+    const projected = await scrubNetworkProjection(corpus, "world");
+    expect(projected.members).toHaveLength(2000);
+    expect(projected.members[1999]?.nested.values[19]?.text).toBe("record-1999-19");
+    expect(JSON.stringify(projected)).not.toContain("private.person@example.com");
+    expect(projected.members[0]?.nested.email).toBe(projected.members[1999]?.nested.email);
+  });
+  it("retains Core cycle, deep-graph and accessor guards without invoking getters", async () => {
+    const cyclic: Record<string, unknown> = {};
+    cyclic.self = cyclic;
+    await expect(scrubNetworkProjection(cyclic, "cycle")).rejects.toHaveProperty(
+      "code",
+      "PII_PSEUDONYM_UNBOUNDED",
+    );
+    let deep: unknown = {};
+    for (let index = 0; index < 100; index++) deep = { next: deep };
+    await expect(scrubNetworkProjection(deep, "deep")).rejects.toHaveProperty(
+      "code",
+      "PII_PSEUDONYM_UNBOUNDED",
+    );
+    let calls = 0;
+    const accessor = Object.defineProperty({}, "email", {
+      enumerable: true,
+      get: () => {
+        calls++;
+        return "private@example.com";
+      },
+    });
+    await expect(scrubNetworkProjection(accessor, "accessor")).rejects.toHaveProperty(
+      "code",
+      "PII_PSEUDONYM_UNBOUNDED",
+    );
+    expect(calls).toBe(0);
+  });
+});
