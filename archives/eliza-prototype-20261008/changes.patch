+import { type NetworkCommand, NetworkDomainError } from "./types";
+
+export function invalid(message: string): never {
+  throw new NetworkDomainError("NETWORK_INVALID", message);
+}
+export function text(value: unknown, name: string, max = 10_000): asserts value is string {
+  if (typeof value !== "string" || !value.trim() || value.length > max || value.includes("\0"))
+    invalid(`Invalid ${name}`);
+}
+export function iso(value: unknown, name: string): asserts value is string {
+  if (
+    typeof value !== "string" ||
+    !Number.isFinite(new Date(value).getTime()) ||
+    new Date(value).toISOString() !== value
+  )
+    invalid(`Invalid ${name}`);
+}
+export function record(value: unknown): asserts value is Record<string, unknown> {
+  if (
+    !value ||
+    typeof value !== "object" ||
+    Array.isArray(value) ||
+    Object.getPrototypeOf(value) !== Object.prototype
+  )
+    invalid("Expected plain command object");
+}
+export function strings(value: unknown, name: string): asserts value is string[] {
+  if (
+    !Array.isArray(value) ||
+    value.some((item) => typeof item !== "string" || !item.trim() || item.includes("\0")) ||
+    new Set(value).size !== value.length
+  )
+    invalid(`Invalid ${name}`);
+}
+function boolean(value: unknown, name: string): void {
+  if (typeof value !== "boolean") invalid(`Invalid ${name}`);
+}
+function oneOf(value: unknown, choices: string[], name: string): void {
+  if (typeof value !== "string" || !choices.includes(value)) invalid(`Invalid ${name}`);
+}
+function validateAgeBand(value: Record<string, unknown>): void {
+  if (value.ageBand === undefined) return;
+  oneOf(value.ageBand, ["under13", "13_17", "18_plus"], "age band");
+  if (value.age !== (value.ageBand === "18_plus" ? "adult" : "minor"))
+    invalid("Age classification and explicit age band must agree");
+}
+export function onlyKeys(value: Record<string, unknown>, keys: string[]): void {
+  if (Object.keys(value).some((key) => !keys.includes(key))) invalid("Unexpected command field");
+}
+const commandKeys: Record<NetworkCommand["type"], string[]> = {
+  create_invite: ["id", "token", "city", "inviteeName", "address", "vouch", "seed"],
+  review_invite: ["inviteId", "approve"],
+  mark_invite_sent: ["inviteId"],
+  close_invite: ["inviteId", "reason"],
+  accept_invite: [
+    "inviteId",
+    "token",
+    "memberId",
+    "cloudUserId",
+    "displayName",
+    "age",
+    "ageBand",
+    "invitedIdentityVerified",
+    "channel",
+    "address",
+    "verifiedAt",
+    "termsVersion",
+    "messagingConsent",
+    "seedVouch",
+  ],
+  complete_onboarding: ["memberId", "proactiveOptIn"],
+  attest_age: ["memberId", "age", "ageBand", "confirmed"],
+  upsert_fact: ["memberId", "fact"],
+  delete_fact: ["memberId", "factId"],
+  manage_intent: ["memberId", "intent"],
+  set_presence: ["memberId", "presence"],
+  set_preferences: ["memberId", "preferences", "participation"],
+  set_channel: ["memberId", "channel", "replacePrimary"],
+  channel_keyword: ["memberId", "channel", "keyword"],
+  connect_source: ["memberId", "source"],
+  create_opportunity: ["draft"],
+  commit_matching_run: [
+    "runId",
+    "city",
+    "inputDigest",
+    "inputRevisions",
+    "settingsRevision",
+    "log",
+    "drafts",
+  ],
+  revise_opportunity: ["opportunityId", "expectedRevision", "draft"],
+  replace_participant: ["opportunityId", "expectedRevision", "memberId", "replacementId"],
+  review_opportunity: [
+    "opportunityId",
+    "expectedRevision",
+    "decision",
+    "reasonCode",
+    "note",
+    "rubric",
+    "durationMs",
+  ],
+  start_review: ["opportunityId", "expectedRevision", "priority"],
+  record_blind_review: [
+    "opportunityId",
+    "expectedRevision",
+    "decision",
+    "reasonCode",
+    "note",
+    "rubric",
+    "durationMs",
+  ],
+  invite_participant: ["opportunityId", "expectedRevision", "memberId"],
+  respond_opportunity: ["opportunityId", "expectedRevision", "memberId", "accept", "disclosure"],
+  set_disclosure: ["opportunityId", "expectedRevision", "memberId", "disclosure"],
+  transition_opportunity: ["opportunityId", "expectedRevision", "to"],
+  record_attendance: ["opportunityId", "memberId", "state"],
+  give_feedback: ["feedback"],
+  report_value: ["memberId", "opportunityId", "meaningful"],
+  block_member: ["memberId", "blockedMemberId"],
+  report_member: [
+    "memberId",
+    "caseId",
+    "reportedId",
+    "reason",
+    "evidence",
+    "placeHold",
+    "evidenceRef",
+  ],
+  appeal_safety: ["caseId", "memberId", "reason"],
+  resolve_safety_appeal: ["caseId", "expectedAppealId", "decision", "reason"],
+  resolve_relay_case: ["caseId", "decision", "reason"],
+  resolve_safety: ["caseId", "memberId", "releaseHold"],
+  hold_safety_case: ["caseId", "memberId"],
+  record_proactive: ["memberId", "messageId", "expiresAt", "category", "city", "opportunityId"],
+  record_inbound: ["memberId"],
+  tick: [],
+  record_event: ["kind", "memberIds", "opportunityId", "details"],
+  configure: ["expectedRevision", "settings"],
+  delete_account: ["memberId"],
+};
+
+/** Boundary validation is repeated by the domain before any authenticated mutation. */
+export function parseNetworkCommand(value: unknown): NetworkCommand {
+  record(value);
+  text(value.requestId, "requestId", 160);
+  text(value.type, "command type", 80);
+  const keys = commandKeys[value.type as NetworkCommand["type"]];
+  if (!keys) invalid("Unknown Network command");
+  onlyKeys(value, ["type", "requestId", ...keys]);
+  const basicMember = () => text(value.memberId, "memberId", 160);
+  const opportunity = () => {
+    text(value.opportunityId, "opportunityId", 160);
+    if (!Number.isSafeInteger(value.expectedRevision) || Number(value.expectedRevision) < 1)
+      invalid("Invalid expectedRevision");
+  };
+  switch (value.type) {
+    case "create_invite":
+      text(value.id, "invite id", 160);
+      text(value.token, "invite token", 500);
+      text(value.inviteeName, "invitee name", 160);
+      oneOf(value.city, ["SF", "NYC"], "city");
+      record(value.vouch);
+      onlyKeys(value.vouch, ["relationship", "knownMonths", "strength", "note", "expectsMessage"]);
+      text(value.vouch.relationship, "vouch relationship", 500);
+      text(value.vouch.note, "vouch note", 10_000);
+      oneOf(value.vouch.strength, ["weak", "normal", "strong"], "vouch strength");
+      boolean(value.vouch.expectsMessage, "expectsMessage");
+      if (!Number.isFinite(value.vouch.knownMonths) || Number(value.vouch.knownMonths) < 0)
+        invalid("Invalid knownMonths");
+      if (value.address !== null) text(value.address, "invite address", 500);
+      if (value.seed !== undefined) boolean(value.seed, "seed");
+      break;
+    case "review_invite":
+      text(value.inviteId, "invite id", 160);
+      boolean(value.approve, "approve");
+      break;
+    case "mark_invite_sent":
+      text(value.inviteId, "invite id", 160);
+      break;
+    case "close_invite":
+      text(value.inviteId, "invite id", 160);
+      oneOf(value.reason, ["declined", "revoked"], "invite state");
+      break;
+    case "accept_invite":
+      basicMember();
+      text(value.inviteId, "invite id", 160);
+      text(value.token, "invite token", 500);
+      text(value.cloudUserId, "cloud user", 160);
+      text(value.displayName, "display name", 160);
+      oneOf(value.age, ["adult", "minor", "unknown"], "age");
+      validateAgeBand(value);
+      if (value.invitedIdentityVerified !== undefined && value.invitedIdentityVerified !== true)
+        invalid("Invited identity ownership must be explicitly verified by the host");
+      oneOf(value.channel, ["sms", "imessage", "web"], "channel");
+      text(value.address, "channel address", 500);
+      iso(value.verifiedAt, "verification time");
+      text(value.termsVersion, "terms version", 160);
+      boolean(value.messagingConsent, "messagingConsent");
+      boolean(value.seedVouch, "seedVouch");
+      break;
+    case "complete_onboarding":
+      basicMember();
+      boolean(value.proactiveOptIn, "proactiveOptIn");
+      break;
+    case "attest_age":
+      basicMember();
+      oneOf(value.age, ["adult", "minor", "unknown"], "age attestation");
+      validateAgeBand(value);
+      if (value.confirmed !== true) invalid("Explicit age confirmation required");
+      break;
+    case "upsert_fact":
+      basicMember();
+      record(value.fact);
+      onlyKeys(value.fact, [
+        "id",
+        "kind",
+        "value",
+        "tags",
+        "scope",
+        "source",
+        "sourceRef",
+        "confidence",
+        "status",
+        "validFrom",
+        "validTo",
+        "sourceRevision",
+      ]);
+      text(value.fact.id, "fact id", 160);
+      text(value.fact.kind, "fact kind", 160);
+      text(value.fact.value, "fact value");
+      strings(value.fact.tags, "fact tags");
+      oneOf(value.fact.scope, ["agent_private", "matching", "shareable"], "fact scope");
+      oneOf(
+        value.fact.source,
+        ["member", "conversation", "vouch", "calendar", "public_profile", "memory_paste", "engine"],
+        "fact source",
+      );
+      text(value.fact.sourceRef, "fact source reference", 1_000);
+      oneOf(value.fact.status, ["proposed", "confirmed", "rejected"], "fact status");
+      if (
+        typeof value.fact.confidence !== "number" ||
+        !Number.isFinite(value.fact.confidence) ||
+        value.fact.confidence < 0 ||
