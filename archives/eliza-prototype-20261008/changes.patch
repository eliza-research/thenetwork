+import {
+  createAnchorRegistry,
+  createCompletionCheckRegistry,
+  createConsolidationRegistry,
+  createEscalationLadderRegistry,
+  createScheduledTaskRunner,
+  createSchedulingSqlScheduledTaskLogStore,
+  createSchedulingSqlScheduledTaskStore,
+  createTaskGateRegistry,
+  listDueScheduledTaskRefs,
+} from "@elizaos/plugin-scheduling";
+import { sqlQuote } from "@elizaos/plugin-sql";
+import { expect, it } from "vitest";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { matchNetwork } from "../matching/domain-projection.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import { NetworkMatchingJobs } from "./matching-jobs.ts";
+
+it("debounces actual committed changes on durable custom Clock tasks and claims an occurrence only once", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "simulation:matching-jobs",
+    clock,
+  });
+  try {
+    await seedSimulationMembers(host.domain, 2, 42);
+    const store = (execute = host.db.execute) =>
+      createSchedulingSqlScheduledTaskStore({
+        agentId: host.runtime.agentId,
+        executeSql: execute,
+        now: clock.now.bind(clock),
+      });
+    let calls = 0;
+    const jobs = new NetworkMatchingJobs({
+      domain: host.domain,
+      agentId: host.runtime.agentId,
+      clock,
+      taskStore: store,
+      prepare: async (city, runId) => async (domain) => {
+        calls++;
+        return matchNetwork(
+          domain,
+          {
+            runId,
+            city,
+            seed: 42,
+            startAt: clock.now().toISOString(),
+            endAt: new Date(clock.now().getTime() + 86400000).toISOString(),
+          },
+          { clock },
+        );
+      },
+    });
+    const gates = createTaskGateRegistry();
+    gates.register(jobs.gate());
+    const runner = createScheduledTaskRunner({
+      agentId: host.runtime.agentId,
+      store: store(),
+      logStore: createSchedulingSqlScheduledTaskLogStore({
+        agentId: host.runtime.agentId,
+        executeSql: host.db.execute,
+        now: clock.now.bind(clock),
+      }),
+      gates,
+      completionChecks: createCompletionCheckRegistry(),
+      ladders: createEscalationLadderRegistry(),
+      anchors: createAnchorRegistry(),
+      consolidation: createConsolidationRegistry(),
+      ownerFacts: () => ({ timezone: "UTC" }),
+      globalPause: { current: async () => ({ active: false }) },
+      activity: { hasSignalSince: () => false },
+      subjectStore: { wasUpdatedSince: () => false },
+      dispatcher: { dispatch: (record) => jobs.dispatch(record) },
+      now: clock.now.bind(clock),
+    });
+    const installed = await jobs.install(runner);
+    expect(installed).toHaveLength(10);
+    expect((await jobs.install(runner)).map((task) => task.taskId)).toEqual(
+      installed.map((task) => task.taskId),
+    );
+    const member = (await host.domain.engineSnapshot({ type: "system" })).members[0];
+    if (!member) throw new Error("Missing own fixture");
+    const input = {
+      type: "set_preferences" as const,
+      requestId: "committed-signal",
+      memberId: member.memberId,
+      preferences: { travelMinutes: 20 },
+    };
+    await host.domain.withAuthority(async (domain, db) => {
+      const result = await domain.command({ type: "member", memberId: member.memberId }, input);
+      await jobs.signal(db.execute, input, result);
+    });
+    const task = (await runner.list({ kind: "custom" })).find((task) => {
+      const binding = task.metadata?.network as { city?: string; cadence?: string } | undefined;
+      return binding?.city === "SF" && binding.cadence === "events";
+    });
+    if (!task) throw new Error("Durable city task missing");
+    expect(
+      await listDueScheduledTaskRefs(host.db.execute, {
+        dueAtIso: clock.now().toISOString(),
+        kind: "custom",
+      }),
+    ).toEqual([]);
+    const before = await store().get(task.taskId);
+    await expect(
+      host.domain.withAuthority(async (domain, db) => {
+        const command = {
+          ...input,
+          requestId: "rollback-signal",
+          preferences: { travelMinutes: 25 },
+        };
+        const result = await domain.command({ type: "member", memberId: member.memberId }, command);
+        await jobs.signal(db.execute, command, result);
+        throw new Error("deliberate rollback");
+      }),
+    ).rejects.toThrow("deliberate rollback");
+    expect((await store().get(task.taskId))?.metadata).toEqual(before?.metadata);
+    clock.advanceTo(clock.now().getTime() + 3 * 60000);
+    const due = await listDueScheduledTaskRefs(host.db.execute, {
+      dueAtIso: clock.now().toISOString(),
+      kind: "custom",
+    });
+    expect(due.some((ref) => ref.taskId === task.taskId)).toBe(true);
+    const results = await Promise.all([
+      runner.fireWithResult(task.taskId),
+      runner.fireWithResult(task.taskId),
+    ]);
+    expect(results.filter((result) => result.kind === "fired")).toHaveLength(1);
+    expect(calls).toBe(1);
+    const health = await jobs.health();
+    expect(health.lastHeartbeat.SF?.kind).toBe("matching_heartbeat");
+    clock.advanceTo(clock.now().getTime() + 60000);
+    await runner.fireWithResult(task.taskId);
