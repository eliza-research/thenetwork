+import { AgentRuntime, stringToUuid } from "@elizaos/core";
+import { knowledgeGraphSchema } from "@elizaos/plugin-relationships/graph";
+import {
+  createAnchorRegistry,
+  createCompletionCheckRegistry,
+  createConsolidationRegistry,
+  createEscalationLadderRegistry,
+  createScheduledTaskRunner,
+  createSchedulingSqlScheduledTaskLogStore,
+  createSchedulingSqlScheduledTaskStore,
+  createTaskGateRegistry,
+  type DispatchResult,
+  listDueScheduledTaskRefs,
+  listRecoverableScheduledTaskRefs,
+  migrateSchedulingTables,
+  resolveLocalHHMMToIso,
+  type ScheduledTaskDispatchRecord,
+} from "@elizaos/plugin-scheduling";
+import type { CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+import {
+  createDatabaseAdapter,
+  createDrizzleCarveOutDatabase,
+  type RuntimeDb,
+  schema,
+} from "@elizaos/plugin-sql";
+import { eraseNetworkConversation } from "../agent/service.ts";
+import { purgeMemberArtifacts } from "../coordination/erasure.ts";
+import { networkAuthorityGate, networkReminderDispatcher } from "../coordination/scheduler.ts";
+import { NetworkCoordination } from "../coordination/service.ts";
+import { type NetworkClock, NetworkDomain } from "../domain/index.ts";
+import { NetworkDomainError } from "../domain/types.ts";
+import { matchNetwork, type NetworkMatchingRequest } from "../matching/domain-projection.ts";
+import {
+  createNetworkCandidateRetrieval,
+  invalidateMatchingPointers,
+} from "../matching/native-retrieval.ts";
+import { createNetworkNativeOwners } from "../native-owners/service.ts";
+import { NetworkOutreach } from "../outreach/service.ts";
+import { projectLocalAvailability } from "./availability.ts";
+import { NetworkMatchingJobs } from "./matching-jobs.ts";
+import { NetworkMockTransport } from "./mock-transport.ts";
+import { readLocalWorldFixtures } from "./world.ts";
+
+/** Composition root for the closed local fixture app, reusing native owners throughout. */
+export async function createLocalNetworkHost(input: {
+  dataDir: string;
+  networkId: string;
+  clock: NetworkClock;
+  dispatchOperations?: (record: ScheduledTaskDispatchRecord) => Promise<DispatchResult>;
+}) {
+  const agentId = stringToUuid(
+    input.networkId === "test:local-network-review"
+      ? "network-local-workbench"
+      : `network:local:${input.networkId}`,
+  );
+  const adapter = createDatabaseAdapter({ dataDir: input.dataDir }, agentId);
+  await adapter.initialize();
+  if (!adapter.runPluginMigrations) throw new Error("Canonical SQL migrations unavailable");
+  await adapter.runPluginMigrations([
+    { name: "@elizaos/plugin-sql", schema },
+    { name: "@elizaos/plugin-relationships", schema: knowledgeGraphSchema },
+  ]);
+  const existing = (await adapter.getAgents()).find((agent) => agent.id === agentId);
+  if (!existing) await adapter.createAgents([{ id: agentId, name: "Network local host", bio: [] }]);
+  const db = await createDrizzleCarveOutDatabase(adapter.db as RuntimeDb);
+  const runtime = new AgentRuntime({
+    agentId,
+    character: { name: "Network local authority" },
+    adapter,
+  });
+  const native = createNetworkNativeOwners({
+    runtime,
+    networkId: input.networkId,
+    clock: input.clock,
+  });
+  let matchingJobs: NetworkMatchingJobs | undefined;
+  const domain = new NetworkDomain({
+    db,
+    clock: input.clock,
+    networkId: input.networkId,
+    afterCommand: async (execute, command, result) => {
+      await native.afterCommand(execute, command, result);
+      if ("memberId" in result && "facts" in result)
+        await invalidateMatchingPointers(
+          execute,
+          input.networkId,
+          agentId,
+          result,
+          input.clock.now().getTime(),
+        );
+      await matchingJobs?.signal(execute, command, result);
+    },
+    eraseMemberArtifacts: async (execute, memberId, opportunityIds, identity) => {
+      const relayDeliveries = await purgeMemberArtifacts(
+        execute,
+        input.networkId,
+        memberId,
+        opportunityIds,
+      );
+      await native.eraseMemberArtifacts(execute, memberId, relayDeliveries, identity);
+      await eraseNetworkConversation(execute, input.networkId, memberId, agentId);
+    },
+  });
+  await domain.initializeLocalSchema();
+  const coordination = new NetworkCoordination({
+    db,
+    clock: input.clock,
+    networkId: input.networkId,
+    availability: (member, range) => projectLocalAvailability(member, range, input.clock),
+    venues: async (city, range, authority) =>
+      (await readLocalWorldFixtures(authority))
+        .filter(
+          (fixture) =>
+            fixture.anchor.city === city &&
+            fixture.anchor.expiresAt > input.clock.now().getTime() &&
+            fixture.anchor.window.start <= Date.parse(range.end) &&
+            fixture.anchor.window.end >= Date.parse(range.start),
+        )
+        .map((fixture) => ({
+          id: fixture.id,
+          title: fixture.title,
+          area: fixture.anchor.area,
+          sourceUrl: fixture.anchor.sourceUrl,
+        })),
+  });
+  await coordination.initializeLocalSchema();
+  const transport = new NetworkMockTransport(runtime, domain, input.clock);
+  const outreach = new NetworkOutreach({ runtime, domain, transport });
+  await migrateSchedulingTables(db);
+  const taskStore = (execute: CarveOutSqlExecutor = db.execute) =>
+    createSchedulingSqlScheduledTaskStore({
+      agentId,
+      executeSql: execute,
+      now: input.clock.now.bind(input.clock),
+    });
+  const prepareMatching = async (request: NetworkMatchingRequest) => {
+    const retrieval = await createNetworkCandidateRetrieval(
+      { domain, adapter, db, runtime, native },
+      request,
+    );
+    const config = retrieval.config;
+    const events = (await readLocalWorldFixtures(domain))
+      .filter(
+        (source) =>
+          source.anchor.expiresAt > input.clock.now().getTime() &&
+          (!request.anchorId || source.anchor.id === request.anchorId) &&
+          (!request.eventAnchorsOnly || source.kind === "event"),
+      )
+      .map((source) => source.anchor);
+    return async (joined: NetworkDomain) =>
+      matchNetwork(joined, request, {
+        clock: input.clock,
+        config,
+        events,
+        retrievalProvider: retrieval,
+        eligibleMemberIds: retrieval.eligibleMemberIds,
+        retrievalInputRevisions: retrieval.inputRevisions,
+        expectedSettingsRevision: retrieval.settingsRevision,
+        graphEdges: await native.graphEdges(joined.options.db.execute, retrieval.eligibleMemberIds),
+      });
+  };
+  matchingJobs = new NetworkMatchingJobs({
+    domain,
+    agentId: runtime.agentId,
+    clock: input.clock,
+    taskStore,
+    prepare: async (city, runId, cadence) => {
+      const start = input.clock.now().getTime();
+      const request: NetworkMatchingRequest = {
+        city,
+        runId,
+        seed: 7,
+        startAt: new Date(start + (cadence === "wednesday" ? 2 : 1) * 86_400_000).toISOString(),
+        endAt: new Date(start + 7 * 86_400_000).toISOString(),
+      };
+      if (cadence === "monthly_event_planning") {
+        const timeZone = city === "SF" ? "America/Los_Angeles" : "America/New_York";
+        const parts = new Intl.DateTimeFormat("en-US", {
+          timeZone,
+          year: "numeric",
+          month: "numeric",
+        }).formatToParts(input.clock.now());
+        const year = Number(parts.find((part) => part.type === "year")?.value);
+        const month = Number(parts.find((part) => part.type === "month")?.value);
+        const from = resolveLocalHHMMToIso(
+          new Date(Date.UTC(year, month, 1, 12)),
+          "00:00",
+          timeZone,
+        );
+        const until = resolveLocalHHMMToIso(
+          new Date(Date.UTC(year, month + 1, 1, 12)),
+          "00:00",
+          timeZone,
+        );
+        if (!from || !until) throw new Error("Native local next-month planning window unavailable");
+        request.startAt = from;
+        request.endAt = until;
+        request.eventAnchorsOnly = true;
+      }
+      return prepareMatching(request);
+    },
+    afterRun: (run) => outreach.consumeEmptyStates(run).then(() => undefined),
+  });
+  const gates = createTaskGateRegistry();
+  gates.register(matchingJobs.gate());
+  gates.register(networkAuthorityGate(coordination));
+  gates.register(outreach.gate);
+  const logistics = networkReminderDispatcher(coordination, transport);
+  let simulationTaskOrdinal = input.networkId.startsWith("simulation:")
+    ? (await taskStore().list()).length
+    : 0;
+  const runner = createScheduledTaskRunner({
+    agentId,
+    store: createSchedulingSqlScheduledTaskStore({
+      agentId,
+      executeSql: db.execute,
+      now: input.clock.now.bind(input.clock),
+    }),
+    logStore: createSchedulingSqlScheduledTaskLogStore({
+      agentId,
+      executeSql: db.execute,
+      now: input.clock.now.bind(input.clock),
+    }),
+    gates,
+    completionChecks: createCompletionCheckRegistry(),
+    ladders: createEscalationLadderRegistry(),
+    anchors: createAnchorRegistry(),
+    consolidation: createConsolidationRegistry(),
+    ownerFacts: () => ({ timezone: "UTC" }),
+    globalPause: { current: async () => ({ active: false }) },
+    activity: { hasSignalSince: () => false },
+    subjectStore: { wasUpdatedSince: () => false },
+    dispatcher: {
+      async dispatch(record) {
+        const binding = record.metadata?.network;
+        if (record.kind === "custom") {
+          if (
+            binding &&
+            typeof binding === "object" &&
+            "scope" in binding &&
+            binding.scope === "matching"
+          )
+            return matchingJobs!.dispatch(record);
+          if (input.dispatchOperations) return input.dispatchOperations(record);
+          throw new NetworkDomainError("NETWORK_INVALID", "Unknown local operations task");
+        }
+        return binding &&
+          typeof binding === "object" &&
+          "scope" in binding &&
+          binding.scope === "outreach"
+          ? outreach.dispatch(record)
+          : logistics.dispatch(record);
+      },
+    },
+    now: input.clock.now.bind(input.clock),
+    ...(input.networkId.startsWith("simulation:")
+      ? {
+          newTaskId: () => stringToUuid(`network-simulation-task:${++simulationTaskOrdinal}`),
+        }
+      : {}),
+  });
+  coordination.options.scheduler = runner;
+  outreach.scheduler = runner;
+  await matchingJobs.install(runner);
+  const activeFires = new Map<string, Promise<void>>();
+  let closing = false;
+  return {
+    adapter,
+    db,
+    runtime,
+    native,
+    domain,
+    coordination,
+    transport,
+    outreach,
+    runner,
+    matchingJobs,
+    async runMatching(request: NetworkMatchingRequest) {
+      const compute = await prepareMatching(request);
+      const run = await domain.withAuthority((joined) => compute(joined));
+      await outreach.consumeEmptyStates(run);
+      return run;
+    },
+    async close() {
+      closing = true;
+      await Promise.allSettled([...activeFires.values()]);
+      await adapter.close();
+    },
+    async drainDue() {
+      if (closing) return 0;
+      let drained = 0;
+      const refs = (
+        await Promise.all(
+          (["reminder", "custom"] as const).flatMap((kind) => [
+            listRecoverableScheduledTaskRefs(db.execute, {
+              updatedBeforeIso: input.clock.now().toISOString(),
+              kind,
+            }),
+            listDueScheduledTaskRefs(db.execute, {
+              dueAtIso: input.clock.now().toISOString(),
+              kind,
+            }),
+          ]),
+        )
+      ).flat();
+      for (const ref of refs.filter(
+        (ref, index) =>
+          refs.findIndex(
+            (other) => other.taskId === ref.taskId && other.agentId === ref.agentId,
+          ) === index,
+      )) {
+        if (ref.agentId === agentId) {
+          const task = await taskStore().get(ref.taskId);
+          const binding = task?.metadata?.network;
+          const background =
+            task?.kind === "custom" &&
+            binding &&
+            typeof binding === "object" &&
+            "scope" in binding &&
+            binding.scope === "simulation_lab" &&
+            "networkId" in binding &&
+            binding.networkId === input.networkId;
+          let fire = activeFires.get(ref.taskId);
+          if (!fire) {
+            if ("firedAtIso" in ref && (typeof ref.firedAtIso !== "string" || !ref.firedAtIso))
+              throw new NetworkDomainError(
+                "NETWORK_INVALID",
+                "Current unfinished fire identity required",
+              );
+            fire = runner
+              .fire(
+                ref.taskId,
+                "firedAtIso" in ref && typeof ref.firedAtIso === "string"
+                  ? { cause: "automatic", recoverFiredAtIso: ref.firedAtIso }
+                  : { cause: "automatic", allowTerminalRefire: true },
+              )
+              .then(
+                () => undefined,
+                (error) => {
+                  if (!background) throw error;
+                  runtime.reportError("network.local.simulation_task", error);
+                },
+              );
+            activeFires.set(ref.taskId, fire);
+            const clear = () => {
+              if (activeFires.get(ref.taskId) === fire) activeFires.delete(ref.taskId);
+            };
+            void fire.then(clear, clear);
+          }
+          if (!background) await fire;
+          drained++;
+        }
+      }
+      return drained;
+    },
+  };
+}
