+  }
+  async confirmSlot(
+    actor: NetworkActor,
+    input: { opportunityId: string; revision: number; requestId: string; slotId: string },
+  ): Promise<CoordinationRecord> {
+    const record = await this.mutate(
+      actor,
+      input.opportunityId,
+      input.revision,
+      input.requestId,
+      input,
+      async (domain, record, opportunity, id, members) => {
+        assertVenueDisclosure(record, opportunity);
