+import { describe, expect, it } from "vitest";
+import {
+	collectPiiPromptText,
+	MAX_PII_PSEUDONYM_WALK_NODES,
+	PseudonymSession,
+} from "../src/security/pii-pseudonymizer.js";
+
+describe("bounded PII data corpus budget", () => {
+	it("preserves prompt defaults while allowing an explicitly bounded full data corpus", () => {
+		const corpus = Array.from(
+			{ length: MAX_PII_PSEUDONYM_WALK_NODES },
+			(_, id) => ({ id, value: "private" }),
+		);
+		expect(() => collectPiiPromptText(corpus)).toThrow("walk budget");
+		expect(() =>
+			new PseudonymSession({ salt: "default" }).substituteInValue(corpus),
+		).toThrow("walk budget");
+		const session = new PseudonymSession({
+			salt: "corpus",
+			walkBudget: { maxNodes: 600_000, maxBytes: 4_000_000 },
+		});
+		session.learnSpans("private", [
+			{ start: 0, end: 7, kind: "person", value: "private" },
+		]);
+		const projected = session.substituteInValue(corpus);
+		expect(projected).toHaveLength(corpus.length);
+		expect(projected.at(-1)?.id).toBe(corpus.length - 1);
