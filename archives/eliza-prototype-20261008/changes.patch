+import { expect, it } from "vitest";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { DEFAULT_MATCHING_CONFIG } from "../matching/config.ts";
+import { matchNetwork } from "../matching/domain-projection.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+
+it("queues one exact own ten-day question behind review and retires it when that intent closes", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z")),
+    host = await createLocalNetworkHost({
+      dataDir: "memory://",
+      networkId: "simulation:empty-state",
+      clock,
+    });
+  try {
+    await seedSimulationMembers(host.domain, 100, 42);
+    const { revision, ...settings } = await host.domain.getSettings({ type: "system" });
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "configure",
+        requestId: "city-qualification",
+        expectedRevision: revision,
+        settings: { ...settings, proactiveCities: { SF: true, NYC: true } },
+      },
+    );
+    const run = async (id: string) =>
+      matchNetwork(
+        host.domain,
+        {
+          runId: id,
+          city: "SF",
+          seed: 42,
+          startAt: clock.now().toISOString(),
+          endAt: new Date(clock.now().getTime() + 86400000).toISOString(),
+        },
+        { clock, config: { ...DEFAULT_MATCHING_CONFIG, defaultThreshold: 100 } },
+      );
+    const early = await run("early");
+    expect(early.emptyStates).toEqual([]);
+    expect(await host.outreach.consumeEmptyStates(early)).toEqual([]);
+    clock.advanceTo(clock.now().getTime() + 10 * 86400000);
+    const due = await run("ten-days");
+    const queued = await host.outreach.consumeEmptyStates(due);
+    expect(queued.length).toBeGreaterThan(0);
+    const first = queued[0];
+    if (!first) throw new Error("Expected actual queued question");
+    const actor = { type: "member" as const, memberId: first.memberId };
+    const own = await host.outreach.list(actor);
+    expect(own).toHaveLength(1);
+    expect(own[0]?.state).toBe("pending");
+    expect(own[0]?.binding.timeliness.kind).toBe("empty_state");
+    expect(own[0]?.body.match(/\?/g)).toHaveLength(1);
+    expect(own[0]?.body).not.toContain("declined");
+    expect(
+      (await host.transport.messages()).filter((message) => message.direction === "outbound"),
+    ).toHaveLength(0);
+    expect(await host.outreach.consumeEmptyStates(due)).toEqual([]);
+    const member = await host.domain.getMember({ type: "system" }, first.memberId),
+      intent = member.intents.find((intent) => intent.id === own[0]?.binding.emptyState?.intentId);
+    if (!intent) throw new Error("Question lost own intent binding");
+    await host.domain.command(actor, {
+      type: "manage_intent",
+      requestId: "close-intent",
+      memberId: first.memberId,
+      intent: {
+        id: intent.id,
+        objective: intent.objective,
+        category: intent.category,
+        tags: intent.tags,
+        needs: intent.needs,
+        offers: intent.offers,
+        status: "closed",
+      },
+    });
+    await host.outreach.consumeEmptyStates(due);
+    expect((await host.outreach.list(actor))[0]?.state).toBe("expired");
+    await expect(
+      host.outreach.review(
+        { type: "staff", userId: "reviewer", roles: ["reviewer"] },
+        {
+          memberId: first.memberId,
+          requestId: first.requestId,
+          decision: "approved",
+          note: "Approve after close",
+        },
+      ),
+    ).rejects.toMatchObject({ code: "NETWORK_EXPIRED" });
+  } finally {
+    await host.close();
+  }
+}, 120000);
