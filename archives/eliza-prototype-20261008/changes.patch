+  kind: "review_opportunity",
+  memberIds: [],
+  opportunityId: "plan",
+  details: { opportunityRevision: 1, decision: "approved" },
+};
+
+it("pairs only independent exact-revision decisions and preserves missing review time", () => {
+  const blind: NetworkEvent = {
+    ...primary,
+    id: "blind-1",
+    kind: "record_blind_review",
+    actor: { type: "staff", userId: "blind-reviewer", roles: ["reviewer"] },
