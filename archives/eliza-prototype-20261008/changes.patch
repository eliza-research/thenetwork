+                  {item.title}
+                  <Arrow />
+                </Button>
+              ))
+            : NETWORK_ADMIN_MODULES.map(([id, label]) => (
+                <Button
+                  unstyled
+                  className="nw-nav-button"
+                  key={id}
+                  aria-current={id === module ? "page" : undefined}
+                  onClick={() => {
+                    navigateAdmin(id, {});
+                    mainRef.current?.focus({ preventScroll: true });
+                  }}
+                  disabled={commandBusy}
+                >
+                  {label}
+                  <Arrow />
+                </Button>
