+const cookies = new Map<string, string>();
+async function cookieFor(id: string) {
+  const previous = cookies.get(id);
+  if (previous) return previous;
+  const response = await fetchLocal(
+    new Request("http://127.0.0.1:54732/api/network/local/session", {
+      method: "POST",
+      headers: { "content-type": "application/json", origin: "http://127.0.0.1:54732" },
+      body: JSON.stringify({ fixtureId: id }),
+    }),
+  );
+  expect(response.status).toBe(200);
+  const cookie = response.headers.get("set-cookie")?.split(";")[0];
+  if (!cookie) throw new Error("Signed fixture cookie missing");
+  cookies.set(id, cookie);
+  return cookie;
+}
+async function command(id: string, input: Record<string, unknown>) {
+  return fetchLocal(
+    new Request("http://127.0.0.1:54732/api/network/command", {
+      method: "POST",
+      headers: {
+        cookie: await cookieFor(id),
+        "content-type": "application/json",
+        origin: "http://127.0.0.1:54732",
+      },
+      body: JSON.stringify({ requestId: randomUUID(), ...input }),
+    }),
+  );
+}
