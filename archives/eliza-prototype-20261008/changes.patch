+import { createLocalNetworkModel } from "../../../packages/cloud/shared/src/lib/network/agent/local-model.ts";
+import {
+  NetworkDomain,
+  parseNetworkCommand,
+} from "../../../packages/cloud/shared/src/lib/network/domain/index.ts";
+import {
+  createSharedElizaRuntime,
+  runSharedElizaRuntimeTurn,
+} from "../../../packages/cloud/shared/src/lib/services/shared-runtime/shared-eliza-runtime.ts";
+import { createNetworkPlugin, type NetworkRuntimePort } from "./index.ts";
+
+const agentId = randomUUID() as UUID,
+  adapter = createDatabaseAdapter({ dataDir: "memory://" }, agentId);
+const entityId = randomUUID() as UUID,
+  roomId = randomUUID() as UUID;
+let domain: NetworkDomain;
+let port: NetworkRuntimePort;
+const at = new Date("2026-10-06T16:00:00.000Z");
+beforeAll(async () => {
+  await adapter.initialize();
+  if (!adapter.runPluginMigrations)
+    throw new Error("Canonical SQL owner required");
+  await adapter.runPluginMigrations([{ name: "@elizaos/plugin-sql", schema }]);
+  await adapter.createAgents([
+    { id: agentId, name: "Network plugin fixture", bio: [] },
+  ]);
+  const db = await createDrizzleCarveOutDatabase(adapter.db as RuntimeDb);
+  domain = new NetworkDomain({
+    db,
+    clock: { now: () => new Date(at) },
+    networkId: "test:network-plugin",
+  });
+  await domain.initializeLocalSchema();
+  await domain.command(
+    { type: "system" },
+    {
+      type: "create_invite",
+      requestId: "invite",
+      id: "invite",
+      token: "local-token",
+      city: "SF",
+      inviteeName: "Local member",
+      address: null,
+      vouch: {
+        relationship: "synthetic",
+        knownMonths: 12,
+        strength: "strong",
+        note: "Local fixture",
+        expectsMessage: false,
+      },
+      seed: true,
+    },
+  );
+  await domain.command(
+    { type: "system" },
+    {
+      type: "accept_invite",
+      requestId: "accept",
+      inviteId: "invite",
+      token: "local-token",
+      memberId: "member",
+      cloudUserId: "local-cloud",
+      displayName: "Local member",
+      age: "adult",
+      channel: "web",
+      address: "synthetic:member",
+      verifiedAt: at.toISOString(),
+      termsVersion: "local",
+      messagingConsent: true,
+      seedVouch: false,
+    },
