+import { networkDigest } from "../digest.js";
+import { DEFAULT_MATCHING_CONFIG, validateConfig } from "./config.js";
+import {
+  candidateEligibility,
+  explorationAllowed,
+  overlaps,
+  pairKey,
+  usableIntents,
+} from "./eligibility.js";
+import { emptyStateText } from "./empty-states.ts";
+import { generateCandidates } from "./generators.js";
+import { totalScore } from "./scoring.js";
+import type {
+  JudgeCache,
+  MatchingConfig,
+  MatchingGenerationStats,
+  MatchingInput,
+  MatchingJudge,
+  MatchingRun,
+  MatchJudgment,
+  MatchMember,
+  MatchProposal,
+} from "./types.js";
+
+export { DEFAULT_MATCHING_CONFIG } from "./config.js";
+export { candidateEligibility, commonOpportunityWindows } from "./eligibility.js";
+
+const DAY = 86_400_000;
+
+function validJudgment(judgment: MatchJudgment): boolean {
+  return (
+    [
+      judgment.fit,
+      judgment.mutualBenefit,
+      judgment.timingFit,
+      judgment.socialComfort,
+      judgment.confidence,
+    ].every((value) => Number.isFinite(value) && value >= 0 && value <= 1) &&
+    typeof judgment.dealbreaker === "boolean" &&
+    Array.isArray(judgment.evidenceIds) &&
+    judgment.evidenceIds.every((id) => typeof id === "string" && id.length > 0) &&
+    Object.keys(judgment).sort().join(",") ===
+      [
+        "fit",
+        "mutualBenefit",
+        "timingFit",
+        "socialComfort",
+        "confidence",
+        "dealbreaker",
+        "evidenceIds",
+      ]
+        .sort()
+        .join(",")
+  );
+}
+
+export async function buildMatchingRun(
+  input: MatchingInput,
+  options: { config?: MatchingConfig; judge?: MatchingJudge; cache?: JudgeCache } = {},
+): Promise<MatchingRun> {
+  const config = structuredClone(options.config ?? DEFAULT_MATCHING_CONFIG);
+  validateConfig(input, config);
+  // Private facts are removed even from trusted input snapshots. A model never sees matching-only facts.
+  const replayInput = structuredClone(input);
+  for (const member of replayInput.members)
+    member.facts = member.facts.filter((fact) => fact.scope !== "agent_private");
+  replayInput.members.sort((a, b) => a.memberId.localeCompare(b.memberId));
+  const digest = networkDigest([replayInput, config]);
+  const generation: MatchingGenerationStats = {
+    generated: 0,
+    filtered: 0,
+    duplicate: 0,
+    scored: 0,
+    filterReasons: {},
+  };
+  const candidates = generateCandidates(replayInput, config, generation);
+  const judgments: NonNullable<MatchingRun["judgments"]> = [];
+  let explorationFiltered = 0,
+    deduplicationRemoved = 0,
+    selectionConsidered = 0,
+    selectionRejected = 0;
+  const rejected: MatchingRun["rejected"] = [];
+  const memberMap = new Map(replayInput.members.map((member) => [member.memberId, member]));
+  let judgeCalls = 0,
+    judgeCacheHits = 0;
+  const configurations = new Set<string>();
+  const ranked = candidates
+    .filter((candidate) => {
+      if (
+        candidate.exploration &&
+        candidate.participantIds.some((id) => {
+          const member = memberMap.get(id);
+          return !member || !explorationAllowed(member, replayInput);
+        })
+      ) {
+        explorationFiltered++;
+        rejected.push({
+          candidateId: candidate.id,
+          participantIds: candidate.participantIds,
+          generator: candidate.generator,
+          category: candidate.category,
+          reasons: ["exploration_quota"],
+        });
+        return false;
+      }
+      return true;
+    })
+    .sort(
+      (a, b) =>
+        b.score - a.score ||
+        networkDigest([input.seed, a.id]).localeCompare(networkDigest([input.seed, b.id])),
+    )
+    .filter((candidate) => {
+      const key = pairKey(candidate.participantIds);
+      if (configurations.has(key)) {
+        deduplicationRemoved++;
+        rejected.push({
+          candidateId: candidate.id,
+          participantIds: candidate.participantIds,
+          generator: candidate.generator,
+          category: candidate.category,
+          reasons: ["duplicate_configuration"],
+        });
+        return false;
+      }
+      configurations.add(key);
+      return true;
+    });
+  for (const candidate of ranked.slice(0, config.judgeFinalists)) {
+    if (!options.judge) break;
+    const profiles = candidate.participantIds
+      .map((id) => memberMap.get(id))
+      .filter((member): member is MatchMember => !!member)
+      .map((member) => ({
+        memberId: member.memberId,
+        revision: member.profileRevision,
+        facts: member.facts.filter((fact) => fact.scope === "shareable"),
+        intents: member.intents,
+      }));
+    const key = networkDigest([candidate, profiles, config, options.judge.version]);
+    const cached = await options.cache?.get(key);
+    let judgment: MatchJudgment, source: "provider" | "cache", cacheExpiresAt: number;
+    if (cached && cached.expiresAt > input.now) {
+      judgment = cached.judgment;
+      source = "cache";
+      cacheExpiresAt = cached.expiresAt;
+      judgeCacheHits++;
+    } else {
+      judgment = await options.judge.judge({ proposal: candidate, profiles });
+      source = "provider";
+      cacheExpiresAt = input.now + config.judgeCacheTtlMs;
+      judgeCalls++;
+      if (!validJudgment(judgment)) throw new Error("Invalid structured matching judgment");
+    }
+    if (!validJudgment(judgment)) throw new Error("Invalid cached matching judgment");
+    if (
+      judgment.evidenceIds.some(
+        (id) => !profiles.some((profile) => profile.facts.some((fact) => fact.id === id)),
+      )
+    )
+      throw new Error("Judge referenced unauthorized evidence");
+    if (source === "provider")
+      await options.cache?.put(key, { judgment, expiresAt: cacheExpiresAt });
+    judgments.push({
+      candidateId: candidate.id,
+      cacheKey: key,
+      judgeVersion: options.judge.version,
+      source,
+      cacheExpiresAt,
+      judgment: structuredClone(judgment),
+    });
+    if (judgment.dealbreaker) {
+      rejected.push({
+        candidateId: candidate.id,
+        participantIds: candidate.participantIds,
+        generator: candidate.generator,
+        category: candidate.category,
+        reasons: ["judge_dealbreaker"],
+      });
+      candidate.score = -Infinity;
+      continue;
+    }
+    // Judge cannot override operational cost, reliability, blocks, budgets or safety.
+    candidate.components.fit = Math.min(candidate.components.fit, judgment.fit);
+    candidate.components.mutualBenefit = Math.min(
+      candidate.components.mutualBenefit,
+      judgment.mutualBenefit,
+    );
+    candidate.components.timingFit = Math.min(candidate.components.timingFit, judgment.timingFit);
+    candidate.components.socialRisk = Math.max(
+      candidate.components.socialRisk,
+      1 - judgment.socialComfort,
+    );
+    candidate.components.confidence = Math.min(
+      candidate.components.confidence,
+      judgment.confidence,
+    );
+    candidate.score = totalScore(candidate.components, config);
+  }
+  const proposals: MatchProposal[] = [];
+  const seen = new Set<string>();
+  for (const proposal of ranked.sort(
+    (a, b) =>
+      b.score - a.score ||
+      networkDigest([input.seed, a.id]).localeCompare(networkDigest([input.seed, b.id])),
+  )) {
+    selectionConsidered++;
+    const members = proposal.participantIds
+      .map((id) => memberMap.get(id))
+      .filter((member): member is MatchMember => !!member);
+    const reasons = candidateEligibility(
+      replayInput,
+      members,
+      proposal.category,
+      proposal.window,
+      config,
+      proposals,
+      { timeSensitive: proposal.timeSensitive },
+    );
+    if (proposal.components.fit < config.fitFloor) reasons.push("fit_floor");
+    if (proposal.components.mutualBenefit < config.mutualBenefitFloor)
+      reasons.push("mutual_benefit_floor");
+    if (proposal.components.confidence < config.confidenceFloor) reasons.push("confidence_floor");
+    if (proposal.score < (config.categoryThresholds[proposal.category] ?? config.defaultThreshold))
+      reasons.push("category_threshold");
+    const configuration = pairKey(proposal.participantIds);
+    if (seen.has(configuration)) reasons.push("duplicate_configuration");
+    if (
+      proposal.exploration &&
+      members.some((member) => !explorationAllowed(member, replayInput, proposals))
+    )
+      reasons.push("exploration_quota");
+    if (reasons.length) {
+      selectionRejected++;
+      rejected.push({
+        candidateId: proposal.id,
+        participantIds: proposal.participantIds,
+        generator: proposal.generator,
+        category: proposal.category,
+        reasons: [...new Set(reasons)].sort(),
+      });
+      continue;
+    }
+    if (proposals.length >= config.maxProposals) break;
+    seen.add(configuration);
+    proposals.push(proposal);
+  }
+  const exposures = replayInput.members
+    .filter((member) =>
+      member.presence.some(
+        (presence) => presence.city === input.city && overlaps(presence, input.window),
+      ),
+    )
+    .map((member) => ({
+      member,
+      count:
+        member.recentExposure +
+        proposals.filter((proposal) => proposal.participantIds.includes(member.memberId)).length,
+    }))
+    .sort((a, b) => b.count - a.count || a.member.memberId.localeCompare(b.member.memberId));
+  const total = exposures.reduce((sum, entry) => sum + entry.count, 0);
+  const cohorts: MatchingRun["fairness"]["cohorts"] = {};
+  for (const entry of exposures)
+    for (const key of [
+      `city:${input.city}`,
+      `cluster:${entry.member.cluster}`,
+      `newcomer:${input.now - entry.member.joinedAt <= 7 * DAY}`,
+    ]) {
+      const cohort = cohorts[key] ?? { members: 0, exposures: 0 };
+      cohort.members++;
+      cohort.exposures += entry.count;
+      cohorts[key] = cohort;
+    }
+  return {
+    runId: input.runId,
+    inputDigest: digest,
+    config,
+    replayInput,
+    proposals,
+    rejected,
+    emptyStates: replayInput.members
+      .filter(
+        (member) =>
+          member.age === "adult" &&
+          member.state === "active" &&
+          !member.safetyHold &&
+          member.presence.some(
+            (presence) =>
+              presence.city === input.city &&
+              presence.start < input.window.end &&
+              presence.end > input.window.start,
+          ),
+      )
+      .flatMap((member) =>
+        usableIntents(member, input.now)
+          .filter(
+            (intent) =>
+              input.now - intent.createdAt >= 10 * DAY &&
+              config.allowedCategories.includes(intent.category) &&
+              !config.disabledCategories?.includes(intent.category) &&
+              !member.categoryOptOuts.includes(intent.category) &&
+              !proposals.some(
+                (proposal) =>
+                  proposal.participantIds.includes(member.memberId) &&
+                  proposal.category === intent.category,
+              ),
+          )
+          .map((intent): MatchingRun["emptyStates"][number] => {
+            const peers = replayInput.members.filter(
+              (peer) =>
+                peer.memberId !== member.memberId &&
+                peer.age === "adult" &&
+                peer.state === "active" &&
+                !peer.safetyHold &&
+                peer.presence.some(
+                  (presence) =>
+                    presence.city === input.city &&
+                    presence.start < input.window.end &&
+                    presence.end > input.window.start,
+                ),
+            );
+            const missing = !intent.tags.length && !intent.needs.length && !intent.offers.length;
+            const constrained =
+              (member.availabilityCoverage === "complete" && !member.availability.length) ||
+              rejected.some(
+                (candidate) =>
+                  candidate.category === intent.category &&
+                  candidate.participantIds.includes(member.memberId) &&
+                  candidate.reasons.some((reason) =>
+                    [
+                      "unavailable",
+                      "availability_not_qualified",
+                      "travel_tolerance",
+                      "format_preference",
+                    ].includes(reason),
+                  ),
+              );
+            const reason =
+              peers.length === 0
+                ? "local_density"
+                : missing
+                  ? "missing_information"
+                  : constrained
+                    ? "constraints"
+                    : "no_qualified_configuration";
+            return {
+              memberId: member.memberId,
+              intentId: intent.id,
+              reason,
+              ...emptyStateText(reason),
+              conciergeAvailable: true,
+            };
+          }),
+      ),
+    fairness: {
+      topDecileShare: total
+        ? exposures
+            .slice(0, Math.ceil(exposures.length / 10))
+            .reduce((sum, entry) => sum + entry.count, 0) / total
+        : 0,
+      unexposed: exposures.filter((entry) => entry.count === 0).length,
+      cohorts,
+    },
+    stageEvidence: {
+      generation,
+      explorationFiltered,
+      deduplicationRemoved,
+      ranked: ranked.length,
+      judged: judgments.length,
+      selectionConsidered,
+      selectionRejected,
+      selected: proposals.length,
+      unvisitedAfterSelectionCap: ranked.length - selectionConsidered,
+    },
+    judgments,
+    candidateCount: candidates.length,
+    judgeCalls,
+    judgeCacheHits,
+    qualification: {
+      externalSources: "host_fixture_or_qualified",
+      judge: judgeCalls || judgeCacheHits ? "provider_called" : "unrun",
+      productValue: "unverified",
+    },
+  };
+}
diff --git a/packages/cloud/shared/src/lib/network/matching/generators.ts b/packages/cloud/shared/src/lib/network/matching/generators.ts
new file mode 100644
index 000000000000..575d3f78d8f4
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/generators.ts
@@ -0,0 +1,522 @@
+import { networkDigest } from "../digest.js";
+import { receivingParticipantAllowed } from "../domain/policy.js";
+import { activeOpportunityKey } from "../domain/store.js";
+import {
+  candidateEligibility,
+  capabilityTags,
+  overlaps,
+  pairKey,
+  shared,
+  tags,
+  usableIntents,
+} from "./eligibility.js";
+import { createMatchingGraph, warmPath } from "./graph.js";
+import { opportunityKind } from "./opportunity.js";
+import { evidenceFor, pairFit, scoreCandidate, totalScore } from "./scoring.js";
+import type {
+  GeneratorKind,
+  MatchingConfig,
+  MatchingGenerationStats,
+  MatchingInput,
+  MatchMember,
+  MatchProposal,
+  TimeWindow,
+} from "./types.js";
+
+const DAY = 86_400_000;
+
+export function generateCandidates(
+  input: MatchingInput,
+  config: MatchingConfig,
+  stages?: MatchingGenerationStats,
+): MatchProposal[] {
+  const candidates = new Map<string, MatchProposal>();
+  const graph = createMatchingGraph(input);
+  const occupiedKeys = new Set(input.activeOpportunityKeys ?? []);
+  const members = input.members
+    .filter(
+      (member) =>
+        member.age === "adult" &&
+        member.state === "active" &&
+        !member.safetyHold &&
+        (member.unansweredProposals < 2 || member.onDemand) &&
+        member.presence.some(
+          (presence) => presence.city === input.city && overlaps(presence, input.window),
+        ),
+    )
+    .sort((a, b) => a.memberId.localeCompare(b.memberId));
+  const filtered = (reason: string) => {
+    if (!stages) return;
+    stages.filtered++;
+    stages.filterReasons[reason] = (stages.filterReasons[reason] ?? 0) + 1;
+  };
+  const add = (
+    participants: MatchMember[],
+    generator: GeneratorKind,
+    category: string,
+    relevantTags: string[],
+    anchorId: string | null = null,
+    window: TimeWindow = input.window,
+    area: string | null = null,
+    roles: string[] = [],
+    alternates: string[] = [],
+  ) => {
+    if (stages) stages.generated++;
+    const timeSensitive =
+      generator === "event_anchor" ||
+      generator === "help" ||
+      (generator === "group" && anchorId !== null);
+    const eligibility = candidateEligibility(input, participants, category, window, config, [], {
+      timeSensitive,
+    });
+    if (eligibility.length) {
+      filtered("hard_eligibility");
+      if (stages)
+        for (const reason of eligibility)
+          stages.filterReasons[reason] = (stages.filterReasons[reason] ?? 0) + 1;
+      return;
+    }
+    const homeEntry = participants.some((member) =>
+      usableIntents(member, input.now).some(
+        (intent) =>
+          intent.category === category &&
+          intent.safetyClass === "medium" &&
+          shared(intent.tags, relevantTags).length,
+      ),
+    );
+    const requester =
+      (generator === "help" || generator === "intent_capability"
+        ? participants.find((member) => member.receiving)
+        : undefined) ??
+      participants.find((member) =>
+        usableIntents(member, input.now).some(
+          (intent) =>
+            intent.category === category &&
+            intent.safetyClass === "medium" &&
+            shared(intent.tags, relevantTags).length,
+        ),
+      ) ??
+      participants[0];
+    const acquaintedHelpers = requester
+      ? participants
+          .filter(
+            (member) => member !== requester && graph.get(requester.memberId)?.has(member.memberId),
+          )
+          .map((member) => member.memberId)
+      : [];
+    const ids = participants.map((member) => member.memberId).sort();
+    const constraints = input.constraints;
+    if (
+      constraints?.eventAnchorsOnly &&
+      ((generator !== "event_anchor" && generator !== "group") ||
+        !anchorId ||
+        !input.events.some((event) => event.id === anchorId))
+    ) {
+      filtered("event_planning_scope");
+      return;
+    }
+    if (
+      constraints &&
+      ((constraints.category && constraints.category !== category) ||
+        (constraints.participants && constraints.participants !== ids.length) ||
+        (constraints.anchorId !== undefined && constraints.anchorId !== anchorId) ||
+        constraints.excludeMemberIds?.some((id) => ids.includes(id)) ||
+        constraints.requireMemberIds?.some((id) => !ids.includes(id)))
+    ) {
+      filtered("review_constraints");
+      return;
+    }
+    if ((generator === "help" || generator === "intent_capability") && requester)
+      ids.splice(
+        0,
+        ids.length,
+        requester.memberId,
+        ...ids.filter((id) => id !== requester.memberId),
+      );
+    if (
+      homeEntry &&
+      (generator !== "help" ||
+        (participants.length < 3 && acquaintedHelpers.length !== participants.length - 1))
+    ) {
+      filtered("home_entry_configuration");
+      return;
+    }
+    const assignedRoles: MatchProposal["roles"] = Object.fromEntries(
+      participants.map((member, index) => [
+        member.memberId,
+        generator === "help" || generator === "intent_capability"
+          ? member === requester
+            ? "requester"
+            : "helper"
+          : roles[index] === "host"
+            ? "host"
+            : roles[index] === "helper"
+              ? "helper"
+              : "guest",
+      ]),
+    );
+    const kind = opportunityKind(generator, ids.length);
+    if (
+      participants.some(
+        (member) =>
+          member.receiving &&
+          !receivingParticipantAllowed(
+            { kind, category, participantIds: ids, roles: assignedRoles },
+            member.memberId,
+          ),
+      )
+    ) {
+      filtered("receiving_role");
+      return;
+    }
+    const id = networkDigest([
+      input.city,
+      generator,
+      category,
+      [...ids].sort(),
+      anchorId,
+      window,
+    ]).slice(0, 32);
+    if (candidates.has(id)) {
+      if (stages) stages.duplicate++;
+      return;
+    }
+    const evidence = evidenceFor(participants, relevantTags);
+    if (stages) stages.scored++;
+    const components = scoreCandidate(input, participants, generator, relevantTags, window, graph);
+    const travelKnown =
+      area !== null &&
+      participants.every((member) => typeof member.travelMinutesByArea?.[area] === "number");
+    if (
+      travelKnown &&
+      participants.some(
+        (member) =>
+          (member.travelMinutesByArea?.[area as string] ?? Infinity) > member.maxTravelMinutes,
+      )
+    ) {
+      filtered("travel_tolerance");
+      return;
+    }
+    const availabilityKnown = participants.every((member) => member.availability.length > 0);
+    if (!travelKnown) components.confidence *= 0.9;
+    if (!availabilityKnown) components.confidence *= 0.9;
+    if (travelKnown)
+      components.activationCost +=
+        (participants.reduce(
+          (sum, member) =>
+            sum +
+            (member.travelMinutesByArea?.[area as string] ?? 0) /
+              Math.max(1, member.maxTravelMinutes),
+          0,
+        ) /
+          participants.length) *
+        0.2;
+    const objective =
+      generator === "growth"
+        ? `Help the Network find a ${input.growthGaps.find((gap) => gap.id === anchorId)?.requiredRole ?? category}`
+        : generator === "help"
+          ? `A bounded ${category} help opportunity`
+          : generator === "welcome"
+            ? `A low-stakes ${category} welcome`
+            : `A ${category} opportunity together`;
+    const activeKey = activeOpportunityKey({
+      kind: opportunityKind(generator, participants.length),
+      category,
+      objective,
+      participantIds: ids,
+    });
+    if (activeKey !== null && occupiedKeys.has(activeKey)) {
+      if (stages) stages.duplicate++;
+      return;
+    }
+    const explanation = Object.fromEntries(
+      participants.map((member) => {
+        const ownEvidence = evidence.filter((item) =>
+          member.facts.some((fact) => fact.id === item.id),
+        );
+        return [
+          member.memberId,
+          ownEvidence.length
+            ? `Based on what you agreed to share: ${ownEvidence.map((item) => item.text).join("; ")}. ${objective}.`
+            : `${objective}. You can decide whether this fits.`,
+        ];
+      }),
+    );
+    candidates.set(id, {
+      id,
+      runId: input.runId,
+      generator,
+      category,
+      participantIds: ids,
+      roles: assignedRoles,
+      alternates,
+      quorum: participants.length <= 2 ? participants.length : Math.max(3, participants.length - 1),
+      objective,
+      window,
+      area,
+      anchorId,
+      explanation,
+      evidenceIds: evidence.map((item) => item.id),
+      components,
+      score: totalScore(components, config),
+      exploration: generator === "expansion",
+      expiresAt: Math.min(window.end, input.now + 10 * DAY),
+      reviewRequired: true,
+      safetyClass: homeEntry ? "medium" : "low",
+      requiresHomeEntry: homeEntry,
+      acquaintedHelperIds: acquaintedHelpers,
+      constraintQualification: {
+        travel: travelKnown ? "supplied" : "unknown",
+        availability: availabilityKnown ? "supplied" : "unknown",
+      },
+      timeSensitive,
+    });
+  };
+  for (let index = 0; index < members.length; index++) {
+    const a = members[index];
+    if (!a) continue;
+    // Recall union: tags, complementary intent/capability, graph and positive-feedback channels.
+    const partners = members
+      .filter(
+        (b) =>
+          b.memberId !== a.memberId &&
+          (!input.retrievedIds || input.retrievedIds[a.memberId]?.includes(b.memberId)),
+      )
+      .map((b) => ({
+        member: b,
+        fit: pairFit(a, b, input.now),
+        warm: warmPath(graph, a.memberId, b.memberId),
+      }))
+      .filter((entry) => entry.fit > 0 || entry.warm)
+      .sort(
+        (x, y) =>
+          y.fit - x.fit ||
+          x.member.recentExposure - y.member.recentExposure ||
+          x.member.memberId.localeCompare(y.member.memberId),
+      );
+    const reserve = Math.ceil(config.maxCandidatesPerMember * config.exposureReserveFraction);
+    const leastExposed = [...partners]
+      .sort((x, y) => x.member.recentExposure - y.member.recentExposure || y.fit - x.fit)
+      .slice(0, reserve);
+    const retrieved = [
+      ...new Map(
+        [...partners.slice(0, config.maxCandidatesPerMember - reserve), ...leastExposed].map(
+          (entry) => [entry.member.memberId, entry],
+        ),
+      ).values(),
+    ];
+    for (const { member: b, warm } of retrieved) {
+      if (a.memberId >= b.memberId) continue;
+      const common = shared(tags(a, input.now), tags(b, input.now));
+      for (const intent of usableIntents(a, input.now)) {
+        const fulfilled = shared(intent.needs, capabilityTags(b, input.now));
+        if (fulfilled.length)
+          add(
+            [a, b],
+            intent.kind === "help" ? "help" : "intent_capability",
+            intent.category,
+            fulfilled,
+          );
+      }
+      for (const intent of usableIntents(b, input.now)) {
+        const fulfilled = shared(intent.needs, capabilityTags(a, input.now));
+        if (fulfilled.length)
+          add(
+            [b, a],
+            intent.kind === "help" ? "help" : "intent_capability",
+            intent.category,
+            fulfilled,
+          );
+      }
+      for (const ai of usableIntents(a, input.now))
+        for (const bi of usableIntents(b, input.now)) {
+          const fulfilled = shared(ai.needs, b.receiving ? [] : bi.offers),
+            reverse = shared(bi.needs, a.receiving ? [] : ai.offers);
+          if (fulfilled.length || reverse.length)
+            add([a, b], "intent_capability", ai.category, [...fulfilled, ...reverse]);
+          if (fulfilled.length && reverse.length)
+            add([a, b], "complementary", ai.category, [...fulfilled, ...reverse]);
+          if (ai.category === bi.category && shared(ai.tags, bi.tags).length)
+            add(
+              [a, b],
+              ai.kind === "help" || bi.kind === "help" ? "help" : "shared_intent",
+              ai.category,
+              common,
+            );
+          if (warm && common.length) add([a, b], "warm_path", ai.category, common);
+        }
+      const positive = input.history.some(
+        (history) =>
+          history.outcome === "positive" &&
+          history.memberIds.includes(a.memberId) &&
+          history.memberIds.includes(b.memberId),
+      );
+      if (positive && common.length)
+        add(
+          [a, b],
+          "second_encounter",
+          usableIntents(a, input.now)[0]?.category ?? "social",
+          common,
+        );
+      if (
+        a.cluster !== b.cluster &&
+        common.length &&
+        a.explorationFraction > 0 &&
+        b.explorationFraction > 0
+      )
+        add([a, b], "expansion", usableIntents(a, input.now)[0]?.category ?? "social", common);
+    }
+  }
+  const compose = (
+    pool: MatchMember[],
+    generator: GeneratorKind,
+    category: string,
+    relevantTags: string[],
+    size: number,
+    roles: string[],
+    anchorId: string | null = null,
+    window = input.window,
+    area: string | null = null,
+  ) => {
+    const eligible = pool.filter(
+      (member) =>
+        !input.constraints?.excludeMemberIds?.includes(member.memberId) &&
+        !(size > 2 && member.reliabilityHold?.group) &&
+        !(member.reliabilityHold?.timeSensitive && (generator === "help" || anchorId !== null)) &&
+        candidateEligibility(input, [member], category, window, config).length === 0,
+    );
+    let beam: MatchMember[][] = [[]];
+    for (let position = 0; position < size; position++) {
+      const next = beam.flatMap((group) =>
+        eligible
+          .filter(
+            (member) =>
+              !group.includes(member) &&
+              (!input.constraints?.requireMemberIds?.length ||
+                size - group.length >
+                  input.constraints.requireMemberIds.filter(
+                    (id) => !group.some((entry) => entry.memberId === id),
+                  ).length ||
+                input.constraints.requireMemberIds.includes(member.memberId)) &&
+              (!roles[position] || member.roles.includes(roles[position] ?? "")),
+          )
+          .map((member) => [...group, member]),
+      );
+      const ranked = next
+        .filter((group) =>
+          group.every((a, i) =>
+            group.slice(i + 1).every((b) => pairFit(a, b, input.now) >= config.pairFloor),
+          ),
+        )
+        .map((group) => ({
+          group,
+          score:
+            scoreCandidate(input, group, generator, relevantTags, window, graph).fit +
+            new Set(group.map((member) => member.cluster)).size * 0.05 -
+            group.reduce((sum, member) => sum + member.recentExposure, 0) * 0.01,
+        }))
+        .sort(
+          (a, b) =>
+            b.score - a.score ||
+            pairKey(a.group.map((member) => member.memberId)).localeCompare(
+              pairKey(b.group.map((member) => member.memberId)),
+            ),
+        );
+      beam = [
+        ...new Map(
+          ranked.map((entry) => [
+            pairKey(entry.group.map((member) => member.memberId)),
+            entry.group,
+          ]),
+        ).values(),
+      ].slice(0, config.groupBeamWidth);
+      if (!beam.length) break;
+    }
+    for (const group of beam.filter((group) => group.length === size).slice(0, 3)) {
+      if (roles.some((role) => !group.some((member) => member.roles.includes(role)))) continue;
+      const alternates = eligible
+        .filter(
+          (member) =>
+            !group.includes(member) &&
+            group.every((other) => pairFit(member, other, input.now) >= config.pairFloor),
+        )
+        .sort((a, b) => a.givingLoad - b.givingLoad || a.memberId.localeCompare(b.memberId))
+        .map((member) => member.memberId);
+      add(group, generator, category, relevantTags, anchorId, window, area, roles, alternates);
+    }
+  };
+  for (const event of input.events.filter(
+    (event) =>
+      event.verified &&
+      event.city === input.city &&
+      event.expiresAt > input.now &&
+      event.observedAt <= input.now &&
+      overlaps(event.window, input.window),
+  )) {
+    const pool = members.filter((member) => shared(tags(member, input.now), event.tags).length);
+    for (let index = 0; index < pool.length; index++)
+      for (const other of pool.slice(index + 1))
+        if (pool[index])
+          add(
+            [pool[index], other],
+            "event_anchor",
+            event.category ?? "culture",
+            event.tags,
+            event.id,
+            event.window,
+            event.area,
+          );
+    compose(
+      pool,
+      "group",
+      event.category ?? "culture",
+      event.tags,
+      input.constraints?.participants ?? Math.min(6, pool.length),
+      [],
+      event.id,
+      event.window,
+      event.area,
+    );
+  }
+  const intents = [
+    ...new Map(
+      members
+        .flatMap((member) => usableIntents(member, input.now))
+        .map((intent) => [
+          JSON.stringify([
+            intent.category,
+            [...intent.tags].sort(),
+            intent.kind,
+            intent.groupSize,
+            intent.roles,
+          ]),
+          intent,
+        ]),
+    ).values(),
+  ];
+  for (const intent of intents)
+    if ((intent.groupSize ?? 3) >= 3) {
+      const pool = members.filter((member) => shared(tags(member, input.now), intent.tags).length);
+      compose(
+        pool,
+        intent.kind === "help" ? "help" : "group",
+        intent.category,
+        intent.tags,
+        Math.min(6, input.constraints?.participants ?? intent.groupSize ?? 3),
+        intent.roles ?? [],
+      );
+      if (pool.some((member) => input.now - member.joinedAt <= 7 * DAY))
+        compose(pool, "welcome", intent.category, intent.tags, 3, ["host"]);
+    }
+  for (const gap of input.growthGaps) {
+    const connectors = members
+      .filter(
+        (member) =>
+          member.roles.includes("connector") && shared(tags(member, input.now), gap.tags).length,
+      )
+      .sort((a, b) => a.givingLoad - b.givingLoad || a.memberId.localeCompare(b.memberId))
+      .slice(0, 2);
+    if (connectors.length) add(connectors, "growth", gap.category, gap.tags, gap.id);
+  }
+  return [...candidates.values()];
+}
