+/** Counts existing case reports only; no guilt, member quality score or automatic consequence. */
+export function summarizeNetworkSafetyReports(cases: NetworkAdminSnapshot["safetyCases"]) {
+  const unique = new Map(cases.map((item) => [item.id, item]));
+  const byReporter: Record<string, number> = Object.create(null);
+  const byTarget: Record<string, number> = Object.create(null);
+  for (const item of unique.values()) {
+    byReporter[item.reporterId] = (byReporter[item.reporterId] ?? 0) + 1;
+    if (item.reportedId !== null) byTarget[item.reportedId] = (byTarget[item.reportedId] ?? 0) + 1;
+  }
+  return {
+    reports: unique.size,
+    byReporter,
+    byTarget,
+    repeatedReporters: Object.values(byReporter).filter((count) => count > 1).length,
+    repeatedTargets: Object.values(byTarget).filter((count) => count > 1).length,
+    definition:
+      "Distinct retained reported-case records. Reopened/appealed cases remain one report; a null target is not an allegation about a member. These counts do not establish wrongdoing.",
+  };
+}
