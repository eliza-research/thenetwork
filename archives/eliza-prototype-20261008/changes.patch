+          (await this.options.venues?.(opportunity.city, input.range, domain)) ?? []
+        ).filter((venue) => {
+          assertKnownDisclosure(members, `${venue.title} ${venue.area} ${venue.sourceUrl}`);
+          return (
+            networkSafetyClass(`${venue.title} ${venue.area}`, opportunity.category) === "low" &&
+            members.every((member, index) => {
+              const estimate = resolved[index]?.travelMinutesByArea[venue.area];
