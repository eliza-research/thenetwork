+    ...overrides,
+  };
+}
+function opportunity(
+  id: string,
+  participantIds: string[],
+  overrides: Partial<NetworkOpportunity> = {},
+): NetworkOpportunity {
+  return {
+    id,
+    kind: "intro",
+    objective: "A scrubbed possibility",
+    category: "music",
+    city: "SF",
+    participantIds,
+    backupIds: [],
+    quorum: participantIds.length,
+    expiresAt: OCTOBER,
+    explanations: {},
+    safetyClass: "low",
+    requiresHomeEntry: false,
+    acquaintedHelperIds: [],
+    anchorEventId: null,
+    revision: 1,
+    state: "inviting",
+    review: {
+      revision: 1,
+      decision: "approved",
+      reviewerId: "reviewer",
+      reasonCode: "fit",
+      note: "",
+      at: JULY,
+    },
+    reviewDeadline: OCTOBER,
+    createdAt: JULY,
+    updatedAt: JULY,
+    participants: participantIds.map((memberId) => ({
+      memberId,
+      revision: 1,
+      state: "invited",
+      invitedAt: JULY,
+      acceptedAt: null,
+      expiresAt: OCTOBER,
+      disclosure: null,
+    })),
+    ...overrides,
+  };
+}
+function snapshot(overrides: Partial<NetworkAdminSnapshot> = {}): NetworkAdminSnapshot {
+  return {
+    members: [],
+    opportunities: [],
+    invites: [],
+    safetyCases: [],
+    feedback: [],
+    events: [],
+    matchingRuns: [],
+    attendanceEvidence: [],
+    settings: {
+      revision: 1,
+      matchingThreshold: 1,
+      weights: {},
+      budgets: { normalWeek: 2, openWeek: 4, quietMonth: 1 },
+      proactiveCities: { SF: true, NYC: true },
+      reviewRequired: true,
+    },
+    ...overrides,
+  };
+}
+function completed(id: string, ids: string[], at: string) {
+  const plan = opportunity(id, ids, { state: "feedback_collected", createdAt: at, updatedAt: at });
+  plan.participants = plan.participants.map((p) => ({
+    ...p,
+    invitedAt: at,
+    acceptedAt: at,
+    state: "accepted",
+  }));
+  const attendance: AttendanceEvidence[] = ids.map((memberId) => ({
+    id: id + memberId,
+    memberId,
+    opportunityId: id,
+    observation: "attended",
+    source: "corroborated",
+    observerIds: ids,
+    context: { kind: plan.kind, groupSize: ids.length, leadTimeHours: 24, timeSensitive: false },
+    createdAt: at,
+  }));
+  const feedback: Feedback[] = ids.map((memberId) => ({
+    id: id + memberId,
+    memberId,
+    opportunityId: id,
+    happened: true,
+    attendedIds: ids,
+    wouldMeetAgainIds: ids.filter((other) => other !== memberId),
+    negativeIds: [],
+    worthwhile: null,
+    note: "",
+    createdAt: at,
+  }));
+  return { plan, attendance, feedback };
+}
+function analyze(
+  data: NetworkAdminSnapshot,
+  extra: Partial<Parameters<typeof summarizeNetworkOperations>[0]> = {},
+) {
+  return summarizeNetworkOperations({
+    snapshot: data,
+    edges: [],
+    clock: new SimClock(Date.parse(OCTOBER)),
+    window: { startAt: JULY, endAt: OCTOBER },
+    ...extra,
+  });
+}
+
+describe("canonical local operations analytics", () => {
+  it("uses accepted native delivery receipts, keeps unanswered contacts, and exposes missing historical receipts", () => {
+    const plans = ["one", "two", "three", "legacy"].map((id) => opportunity(id, ["a"]));
+    const data = snapshot({
+      members: [member("a")],
+      opportunities: plans,
+      events: plans.slice(0, 3).map((plan) => ({
+        id: plan.id,
+        at: JULY,
+        actor: { type: "system" },
+        kind: "outbound_accepted",
+        memberIds: ["a"],
+        opportunityId: plan.id,
+        details: { purpose: "invitation", nativeRequestId: plan.id },
+      })),
+      feedback: [
+        {
+          id: "answer",
+          memberId: "a",
+          opportunityId: "one",
+          happened: false,
+          attendedIds: [],
+          wouldMeetAgainIds: [],
+          negativeIds: [],
+          worthwhile: true,
+          note: "",
+          createdAt: AUGUST,
+        },
+      ],
+    });
+    const result = analyze(data);
+    expect(result.scorecard.metrics.worthwhileAllSent).toMatchObject({
+      numerator: 1,
+      denominator: 3,
+      rate: 1 / 3,
+    });
+    expect(result.scorecard.metrics.worthwhileRespondents.rate).toBe(1);
+    expect(result.scorecard.metrics.missingWorthwhile).toBe(2);
+    expect(result.scorecard.unreceiptedInvitationAdmissions).toBe(1);
+    expect(result.scorecard.attentionBurden.contacts).toBe(3);
+  });
+
+  it("segments real origin metadata and distinguishes unattributed proposals from exploitation", () => {
+    const data = snapshot({
+      members: [
+        member("old"),
+        member("new", { createdAt: "2026-09-25T00:00:00.000Z" }),
+        member("ny", { homeCities: ["NYC"] }),
+      ],
+      opportunities: [
+        opportunity("a", ["old", "new"], {
+          origin: { runId: "r", generator: "group", exploration: true },
+        }),
+        opportunity("b", ["old"], {
+          origin: { runId: "r", generator: "help", exploration: false },
+        }),
+        opportunity("c", ["ny"], { city: "NYC" }),
+        opportunity("manual", ["old"]),
+      ],
+    });
+    const result = analyze(data, {
+      filters: { city: "SF", cohort: "established", generator: "group", exploration: true },
+    });
+    expect(result.pipeline.opportunities.map((row) => row.opportunityId)).toEqual(["a"]);
+    expect(result.fairness.members.map((row) => row.memberId)).toEqual(["old"]);
+    expect(result.pipeline.segments.find((row) => row.dimension === "exploration")?.key).toBe(
+      "exploration",
+    );
+    const all = analyze(data);
+    expect(
+      all.pipeline.segments
+        .filter((row) => row.dimension === "exploration")
+        .map((row) => row.key)
+        .sort(),
+    ).toEqual(["exploitation", "exploration", "unattributed"]);
+  });
+
+  it("does not fabricate the scheduled stage from a terminal completion", () => {
+    const done = completed("done", ["a", "b"], AUGUST);
+    const data = snapshot({
+      members: [member("a"), member("b")],
+      opportunities: [done.plan],
+      attendanceEvidence: done.attendance,
+      feedback: done.feedback,
+    });
+    const result = analyze(data);
+    expect(result.pipeline.opportunities[0]?.stages).toMatchObject({
+      accepted: true,
+      scheduled: false,
+      completed: true,
+      positive: true,
+    });
+    expect(result.pipeline.opportunities[0]?.missingScheduledHistory).toBe(true);
+    expect(result.pipeline.funnel.find((row) => row.stage === "completed")).toMatchObject({
+      count: 1,
+      missingPriorEvidence: 1,
+      fromPrevious: null,
+    });
+    data.events.push({
+      id: "scheduled",
+      at: AUGUST,
+      actor: { type: "system" },
+      kind: "transition_opportunity",
+      memberIds: ["a", "b"],
+      opportunityId: "done",
+      details: { to: "scheduled" },
+    });
+    expect(analyze(data).pipeline.opportunities[0]?.stages.scheduled).toBe(true);
+  });
+
+  it("finds the true bridge between two dense native encounter components without counting blocks or duplicate directions", () => {
+    const ids = ["a", "b", "c", "d", "e", "f", "isolated"];
+    const pairs = [
+      ["a", "b"],
+      ["b", "c"],
+      ["a", "c"],
+      ["c", "d"],
+      ["d", "e"],
+      ["e", "f"],
+      ["d", "f"],
+    ];
+    const edges = pairs.flatMap(([from, to], index) => [
+      {
+        id: "edge" + index,
+        from: from!,
+        to: to!,
+        type: "network:reported_met",
+        confidence: 1,
+        confirmed: true,
+        lastInteractionAt: null,
+        createdAt: JULY,
+      },
+      {
+        id: "reverse" + index,
+        from: to!,
+        to: from!,
+        type: "network:reported_met",
+        confidence: 1,
+        confirmed: true,
+        lastInteractionAt: null,
+        createdAt: JULY,
+      },
+    ]);
+    edges.push({
+      id: "unconfirmed",
+      from: "isolated",
+      to: "a",
+      type: "network:reported_met",
+      confidence: 0.5,
+      confirmed: false,
+      lastInteractionAt: null,
+      createdAt: JULY,
+    });
+    const data = snapshot({ members: ids.map((id) => member(id)), opportunities: [] });
+    data.members[6]!.blockedMemberIds = ["a"];
+    const result = analyze(data, { edges });
+    expect(result.graph.bridges).toEqual([
+      { memberIds: ["c", "d"], nativeEdgeIds: ["edge3", "reverse3"] },
+    ]);
+    expect(result.graph.denseClusters.map((group) => group.memberIds)).toEqual([
+      ["a", "b", "c"],
+      ["d", "e", "f"],
+    ]);
