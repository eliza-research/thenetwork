index 000000000000..23f87cd4befb
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/workbench/data-export.ts
@@ -0,0 +1,505 @@
+import type {
+  DispatchResult,
+  ScheduledTaskDispatchRecord,
+  ScheduledTaskRunner,
+} from "@elizaos/plugin-scheduling";
+import { type CarveOutSqlExecutor, sqlQuote } from "@elizaos/plugin-sql";
+import { networkDigest } from "../digest.ts";
+import { staff } from "../domain/policy.ts";
+import type { NetworkDomain } from "../domain/service.ts";
+import { payload } from "../domain/store.ts";
+import {
+  type NetworkActor,
+  type NetworkAdminSnapshot,
+  type NetworkClock,
+  NetworkDomainError,
+  type NetworkEvent,
+} from "../domain/types.ts";
+import type { createNetworkNativeOwners } from "../native-owners/service.ts";
+
+export const NETWORK_NOTEBOOKS = {
+  opportunity_funnel: {
+    title: "Opportunity funnel",
+    sql: "SELECT city, kind, state, count(*)::INTEGER AS count FROM network_snapshot WHERE record_type='opportunity' GROUP BY city, kind, state ORDER BY city, kind, state",
+  },
+  exposure: {
+    title: "Member exposure",
+    sql: "SELECT member_id, city, invitations, consecutive_unanswered FROM network_snapshot WHERE record_type='member' ORDER BY member_id, city",
+  },
+  review_labels: {
+    title: "Retained review labels",
+    sql: "SELECT opportunity_id, review_at, review_label FROM network_snapshot WHERE record_type='review' ORDER BY review_at, opportunity_id",
+  },
+} as const;
+export const NETWORK_EXPORT_SCHEMA_VERSION = 3;
+
+export interface NetworkExportArtifact {
+  fileName: string;
+  hash: string;
+}
+export interface NetworkExportSnapshot {
+  snapshot: NetworkAdminSnapshot;
+  edges: Awaited<ReturnType<ReturnType<typeof createNetworkNativeOwners>["adminGraph"]>>;
+}
+export interface NetworkExportWriter {
+  write(
+    rows: Record<string, string | number | null>[],
+    exportId: string,
+  ): Promise<{
+    parquet: NetworkExportArtifact;
+    notebooks: Record<keyof typeof NETWORK_NOTEBOOKS, NetworkExportArtifact>;
+  }>;
+  query(
+    artifact: NetworkExportArtifact,
+    notebook: NetworkExportArtifact,
+  ): Promise<{ sql: string; rows: unknown[] }>;
+  read(artifact: NetworkExportArtifact): Promise<Uint8Array>;
+  readSnapshot(artifact: NetworkExportArtifact): Promise<NetworkExportSnapshot>;
+  remove(artifact: NetworkExportArtifact): Promise<void>;
+}
+export interface NetworkExportRecord {
+  exportId: string;
+  networkId: string;
+  exportedAt: string;
+  sourceSequence: number;
+  schemaVersion: typeof NETWORK_EXPORT_SCHEMA_VERSION;
+  rowCount: number;
+  parquet: NetworkExportArtifact;
+  notebooks: Record<keyof typeof NETWORK_NOTEBOOKS, NetworkExportArtifact>;
+  qualification: "scrubbed_analyst_local_export_external_R2_unrun";
+}
+const SYSTEM = { type: "system" } as const;
+const SNAPSHOT_ACTOR: NetworkActor = {
+  type: "staff",
+  userId: "network-data-export",
+  roles: ["analyst"],
+};
+
+/** The existing event and SQL scheduler owners retain export identity and lifecycle. */
+export class NetworkDataExport {
+  constructor(
+    readonly options: {
+      domain: NetworkDomain;
+      scheduler: ScheduledTaskRunner;
+      clock: NetworkClock;
+      writer: NetworkExportWriter;
+      graph: (
+        execute: CarveOutSqlExecutor,
+        memberIds: string[],
+      ) => Promise<NetworkExportSnapshot["edges"]>;
+    },
+  ) {}
+
+  private async events(kinds: string[]) {
+    return (
+      await this.options.domain.options.db.execute(
+        `SELECT payload,sequence FROM network.events WHERE network_id=${sqlQuote(this.options.domain.options.networkId)} AND payload->>'kind'=ANY(ARRAY[${kinds.map(sqlQuote).join(",")}]::text[]) ORDER BY sequence`,
+      )
+    ).map((row) => ({ ...payload<NetworkEvent>(row), sequence: Number(row.sequence) }));
+  }
+
+  async scheduleNightly() {
+    const at = this.options.clock.now();
+    const due = new Date(Date.UTC(at.getUTCFullYear(), at.getUTCMonth(), at.getUTCDate(), 2));
+    if (due.getTime() <= at.getTime()) due.setUTCDate(due.getUTCDate() + 1);
+    return this.options.scheduler.schedule({
+      kind: "custom",
+      trigger: { kind: "once", atIso: due.toISOString() },
+      priority: "low",
+      promptInstructions: "Write the scrubbed local Network nightly Parquet snapshot.",
+      respectsGlobalPause: false,
+      source: "plugin",
+      createdBy: "network",
+      ownerVisible: false,
+      metadata: {
+        network: {
+          scope: "data_export",
+          networkId: this.options.domain.options.networkId,
+          requestId: `nightly:${due.toISOString().slice(0, 10)}`,
+        },
+      },
+      output: { destination: "channel", target: "network-local-data" },
+      idempotencyKey: `network:${networkDigest(this.options.domain.options.networkId)}:export:${due.toISOString().slice(0, 10)}`,
+    });
+  }
+
+  async dispatch(record: ScheduledTaskDispatchRecord): Promise<DispatchResult> {
+    const binding = record.metadata?.network as
+      | { scope?: string; networkId?: string; requestId?: string }
+      | undefined;
+    if (
+      binding?.scope !== "data_export" ||
+      binding.networkId !== this.options.domain.options.networkId ||
+      !binding.requestId
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Own nightly export binding required");
+    const result = await this.export(SYSTEM, binding.requestId);
+    await this.scheduleNightly();
+    return { ok: true, metadata: { exportId: result.exportId, artifactHash: result.parquet.hash } };
+  }
+
+  async export(actor: NetworkActor, requestId: string): Promise<NetworkExportRecord> {
+    staff(actor, ["analyst"]);
+    if (!requestId || requestId.length > 160)
+      throw new NetworkDomainError("NETWORK_INVALID", "Bounded export request identity required");
+    await this.invalidateDeleted();
+    const exportId = networkDigest([
+      this.options.domain.options.networkId,
+      requestId,
+      NETWORK_EXPORT_SCHEMA_VERSION,
+    ]);
+    const existing = (await this.events(["data_export_completed"])).find(
+      (event) => event.details.exportId === exportId,
+    );
+    if (existing) {
+      await this.assertCurrent(existing.details as unknown as NetworkExportRecord);
+      return existing.details as unknown as NetworkExportRecord;
+    }
+    // Snapshot and its deletion watermark are captured together under canonical authority.
+    const source = await this.options.domain.withAuthority(async (domain, db) => {
+      const snapshot = await domain.adminView(SNAPSHOT_ACTOR);
+      const edges = await this.options.graph(
+        db.execute,
+        snapshot.members.map((member) => member.memberId),
+      );
+      const sequence = Number(
+        (
+          await db.execute(
+            `SELECT coalesce(max(sequence),0) AS sequence FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)}`,
+          )
+        )[0]?.sequence,
+      );
+      const activeIds = new Set(
+        snapshot.members
+          .filter((member) => member.accountState !== "removed")
+          .map((member) => member.memberId),
+      );
+      const opportunities = snapshot.opportunities.filter((opportunity) =>
+        opportunity.participantIds.every((id) => activeIds.has(id)),
+      );
+      const rows: Record<string, string | number | null>[] = opportunities.map((opportunity) => ({
+        record_type: "opportunity",
+        opportunity_id: opportunity.id,
+        city: opportunity.city,
+        kind: opportunity.kind,
+        category: opportunity.category,
+        state: opportunity.state,
+        revision: opportunity.revision,
+        created_at: opportunity.createdAt,
+        updated_at: opportunity.updatedAt,
+      }));
+      for (const member of snapshot.members.filter((member) => activeIds.has(member.memberId)))
+        for (const city of member.homeCities)
+          rows.push({
+            record_type: "member",
+            member_id: member.memberId,
+            city,
+            invitations: opportunities.filter(
+              (opportunity) =>
+                opportunity.city === city &&
+                opportunity.participants.some(
+                  (participant) =>
+                    participant.memberId === member.memberId && participant.invitedAt,
+                ),
+            ).length,
+            consecutive_unanswered: member.consecutiveUnanswered,
+          });
+      for (const event of snapshot.events.filter(
+        (event) =>
+          event.kind === "review_opportunity" &&
+          event.opportunityId &&
+          opportunities.some((opportunity) => opportunity.id === event.opportunityId),
+      ))
+        rows.push({
+          record_type: "review",
+          opportunity_id: event.opportunityId,
+          review_at: event.at,
+          review_label:
+            typeof event.details.decision === "string" ? event.details.decision : "recorded",
+        });
+      const sections: Record<string, { array: boolean; count: number }> = {};
+      for (const [section, value] of [
+        ...Object.entries(snapshot).map(([key, value]) => ["snapshot." + key, value] as const),
+        ["edges", edges] as const,
+      ]) {
+        const records = Array.isArray(value) ? value : [value];
+        sections[section] = { array: Array.isArray(value), count: records.length };
+        for (let index = 0; index < records.length; index++) {
+          const text = JSON.stringify(records[index]) ?? "null";
+          let offset = 0,
+            part = 0;
+          do {
+            let end = Math.min(text.length, offset + 1024 * 1024);
+            // Each JSON row stays below the native reader limit; never split a UTF-16 pair.
+            if (
+              end < text.length &&
+              text.charCodeAt(end - 1) >= 0xd800 &&
+              text.charCodeAt(end - 1) <= 0xdbff &&
+              text.charCodeAt(end) >= 0xdc00 &&
+              text.charCodeAt(end) <= 0xdfff
+            )
+              end--;
+            rows.push({
+              record_type: "snapshot",
+              snapshot_section: section,
+              snapshot_index: index,
+              snapshot_part: part++,
+              snapshot_json: text.slice(offset, end),
+            });
+            offset = end;
+          } while (offset < text.length);
+        }
+      }
+      rows.push({
+        record_type: "snapshot_manifest",
+        snapshot_json: JSON.stringify({ version: NETWORK_EXPORT_SCHEMA_VERSION, sections }),
+      });
+      return { rows, sourceSequence: sequence, exportedAt: this.options.clock.now().toISOString() };
+    });
+    const exportedAt = source.exportedAt;
+    const artifacts = await this.options.writer.write(
+      source.rows.map((row) => ({
+        ...row,
+        network_id: this.options.domain.options.networkId,
+        source_sequence: source.sourceSequence,
+        exported_at: exportedAt,
+      })),
+      exportId,
+    );
+    const result: NetworkExportRecord = {
+      exportId,
+      networkId: this.options.domain.options.networkId,
+      exportedAt,
+      sourceSequence: source.sourceSequence,
+      schemaVersion: NETWORK_EXPORT_SCHEMA_VERSION,
+      rowCount: source.rows.length,
+      ...artifacts,
+      qualification: "scrubbed_analyst_local_export_external_R2_unrun",
+    };
+    try {
+      await this.options.domain.withAuthority(async (domain) => {
+        await this.assertCurrent(result, domain);
+        const previous = (
+          await domain.options.db.execute(
+            `SELECT payload FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)} AND id=${sqlQuote(`export:${exportId}`)}`,
+          )
+        )[0];
+        if (previous) {
+          const retained = payload<NetworkEvent>(previous)
+            .details as unknown as NetworkExportRecord;
+          await this.assertCurrent(retained, domain);
+          await Promise.all(
+            [result.parquet, ...Object.values(result.notebooks)].map((artifact) =>
+              this.options.writer.remove(artifact),
+            ),
+          );
+          Object.assign(result, retained);
+          return;
+        }
+        await domain.command(SYSTEM, {
+          type: "record_event",
+          requestId: `export:${exportId}`,
+          kind: "data_export_completed",
+          memberIds: [],
+          opportunityId: null,
+          details: { ...result },
+        });
+      });
+    } catch (error) {
+      await Promise.all(
+        [result.parquet, ...Object.values(result.notebooks)].map((artifact) =>
+          this.options.writer.remove(artifact),
+        ),
+      );
+      throw error;
+    }
+    return result;
+  }
+
+  private async assertCurrent(record: NetworkExportRecord, domain = this.options.domain) {
+    const deletion = await domain.options.db.execute(
+      `SELECT sequence FROM network.events WHERE network_id=${sqlQuote(domain.options.networkId)} AND payload->>'kind' IN ('delete_account','invite_data_removed') AND sequence>${record.sourceSequence} LIMIT 1`,
+    );
+    if (deletion.length || record.networkId !== domain.options.networkId)
+      throw new NetworkDomainError(
+        "NETWORK_EXPIRED",
+        "Source deletion invalidated this retained export; create a current export",
+        { rule: "source_account_deleted" },
+      );
+    if (
+      record.qualification !== "scrubbed_analyst_local_export_external_R2_unrun" ||
+      Number(record.schemaVersion) < 2
+    )
+      throw new NetworkDomainError(
+        "NETWORK_EXPIRED",
+        "Retained export privacy format is obsolete; create a current export",
+        { rule: "obsolete_privacy_format" },
+      );
+    if (record.schemaVersion !== NETWORK_EXPORT_SCHEMA_VERSION)
+      throw new NetworkDomainError(
+        "NETWORK_EXPIRED",
+        "Historical snapshot encoding is unsupported; private evidence is retained until source deletion",
+        { rule: "unsupported_snapshot_encoding" },
+      );
+  }
+
+  async invalidateDeleted() {
+    const invalidations = await this.events(["data_export_invalidated"]);
+    const erased = new Set(
+      invalidations
+        .filter((event) => event.details.reason !== "unsupported_snapshot_encoding")
+        .map((event) => event.details.exportId),
+    );
+    let removed = 0;
+    for (const event of await this.events(["data_export_completed"])) {
+      const record = event.details as unknown as NetworkExportRecord;
+      if (erased.has(record.exportId)) continue;
+      try {
+        await this.assertCurrent(record);
+      } catch (error) {
+        if (!(error instanceof NetworkDomainError) || error.code !== "NETWORK_EXPIRED") throw error;
+        const reason = String(error.context?.rule);
+        if (
+          reason === "unsupported_snapshot_encoding" &&
+          invalidations.some(
+            (event) =>
+              event.details.exportId === record.exportId && event.details.reason === reason,
+          )
+        )
+          continue;
+        if (reason !== "unsupported_snapshot_encoding") {
+          await Promise.all(
+            [record.parquet, ...Object.values(record.notebooks)].map((artifact) =>
+              this.options.writer.remove(artifact),
+            ),
+          );
+          removed++;
+        }
+        await this.options.domain.command(SYSTEM, {
+          type: "record_event",
+          requestId: `export-invalidated:${record.exportId}:${reason}`,
+          kind: "data_export_invalidated",
+          memberIds: [],
+          opportunityId: null,
+          details: { exportId: record.exportId, reason },
+        });
+      }
+    }
+    return removed;
+  }
+
+  async latest(actor: NetworkActor): Promise<NetworkExportRecord | null> {
+    staff(actor, ["analyst"]);
+    await this.invalidateDeleted();
+    const invalidated = new Set(
+      (await this.events(["data_export_invalidated"])).map((event) => event.details.exportId),
+    );
+    return (
+      ((await this.events(["data_export_completed"]))
+        .filter((event) => !invalidated.has(event.details.exportId))
+        .at(-1)?.details as unknown as NetworkExportRecord) ?? null
+    );
+  }
+
+  async runNotebook(actor: NetworkActor, notebook: string) {
+    staff(actor, ["analyst"]);
+    if (!Object.hasOwn(NETWORK_NOTEBOOKS, notebook))
+      throw new NetworkDomainError("NETWORK_INVALID", "Choose a saved bounded DuckDB notebook");
+    const exported = await this.latest(actor);
+    if (!exported)
+      throw new NetworkDomainError(
+        "NETWORK_NOT_FOUND",
+        "A current nightly or requested export is required",
+      );
+    return this.options.domain.withAuthority(async (domain) => {
+      await this.assertCurrent(exported, domain);
+      const analysis = await this.options.writer.query(
+        exported.parquet,
+        exported.notebooks[notebook as keyof typeof NETWORK_NOTEBOOKS],
+      );
+      await domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `notebook-read:${crypto.randomUUID()}`,
+        kind: "data_notebook_read",
+        memberIds: [],
+        opportunityId: null,
+        details: { exportId: exported.exportId, notebook, actor },
+      });
+      return {
+        exportId: exported.exportId,
+        notebook,
+        ...analysis,
+        source: "retained_scrubbed_parquet",
+      };
+    });
+  }
+
+  async readSnapshot(actor: NetworkActor) {
+    staff(actor, ["reviewer", "analyst", "engineer", "safety"]);
+    const exported = await this.latest(SYSTEM);
+    if (!exported)
+      throw new NetworkDomainError(
+        "NETWORK_NOT_FOUND",
+        "A current scrubbed export is required for analytics",
+      );
+    return this.options.domain.withAuthority(async (domain) => {
+      await this.assertCurrent(exported, domain);
+      const snapshot = await this.options.writer.readSnapshot(exported.parquet);
+      await domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `snapshot-read:${crypto.randomUUID()}`,
+        kind: "data_snapshot_read",
+        memberIds: [],
+        opportunityId: null,
+        details: { exportId: exported.exportId, sourceSequence: exported.sourceSequence, actor },
+      });
+      return {
+        ...snapshot,
+        exportId: exported.exportId,
+        exportedAt: exported.exportedAt,
+        sourceSequence: exported.sourceSequence,
+        clockAt: exported.exportedAt,
+      };
+    });
+  }
+
+  async artifact(
+    actor: NetworkActor,
+    exportId: string,
+    kind: "parquet" | keyof typeof NETWORK_NOTEBOOKS,
+  ) {
+    staff(actor, ["analyst"]);
+    const event = (await this.events(["data_export_completed"])).find(
+      (event) => event.details.exportId === exportId,
+    );
+    if (!event) throw new NetworkDomainError("NETWORK_NOT_FOUND", "Retained export unavailable");
+    const record = event.details as unknown as NetworkExportRecord;
+    return this.options.domain.withAuthority(async (domain) => {
+      await this.assertCurrent(record, domain);
+      const artifact =
+        kind === "parquet"
+          ? record.parquet
+          : Object.hasOwn(record.notebooks, kind)
+            ? record.notebooks[kind]
+            : null;
+      if (!artifact) throw new NetworkDomainError("NETWORK_INVALID", "Unknown export artifact");
+      await domain.command(SYSTEM, {
+        type: "record_event",
+        requestId: `artifact-read:${crypto.randomUUID()}`,
+        kind: "data_artifact_read",
+        memberIds: [],
+        opportunityId: null,
+        details: { exportId, kind, actor },
+      });
+      return {
+        bytes: await this.options.writer.read(artifact),
+        filename:
+          kind === "parquet"
+            ? `network-snapshot-${exportId}.parquet`
+            : `network-${kind}-${exportId}.ipynb`,
+        contentType:
+          kind === "parquet" ? "application/vnd.apache.parquet" : "application/x-ipynb+json",
+      };
+    });
+  }
+}
