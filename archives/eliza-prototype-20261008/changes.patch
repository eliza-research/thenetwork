diff --git a/packages/core/test/pii-record-corpus.test.ts b/packages/core/test/pii-record-corpus.test.ts
new file mode 100644
index 000000000000..cf3a4c97d819
--- /dev/null
+++ b/packages/core/test/pii-record-corpus.test.ts
@@ -0,0 +1,184 @@
+import { describe, expect, it } from "vitest";
+import {
+	MAX_PII_PSEUDONYM_WALK_DEPTH,
+	PseudonymSession,
+} from "../src/security/pii-pseudonymizer.ts";
+
+const secret = "PRIVATE_SAMPLE_KEEP_SAFE";
+const nested = (depth: number): Record<string, unknown> => {
+	let value: Record<string, unknown> = {};
+	for (let index = 0; index < depth; index++) value = { nested: value };
+	return value;
+};
+
+describe("explicit owned record corpus traversal", () => {
+	it("retains every bounded record beyond the aggregate data cap while model traversal keeps its original cap", () => {
+		const fields = Object.fromEntries(
+			Array.from({ length: 101 }, (_, index) => [`field${index}`, secret]),
+		);
+		const value: {
+			rows: Array<Record<string, string | number> & { id: number }>;
+			note: string;
+		} = {
+			rows: Array.from({ length: 20000 }, (_, id) => ({ ...fields, id })),
+			note: secret,
+		};
+		const session = new PseudonymSession({
+			salt: "owned-corpus",
+			walkBudget: { maxNodes: 2000000, maxBytes: 64 * 1024 * 1024 },
+		});
+		session.learnSpans(secret, [
+			{ start: 0, end: secret.length, kind: "private", value: secret },
+		]);
+		expect(() => session.substituteInValue(value)).toThrow("walk budget");
+		const projected = session.substituteRecordsInValue(value);
+		expect(projected.rows).toHaveLength(value.rows.length);
+		expect(projected.rows[0]?.id).toBe(0);
+		expect(projected.rows.at(-1)?.id).toBe(value.rows.length - 1);
+		expect(projected.note).not.toBe(secret);
+		for (const row of projected.rows) {
+			expect(Object.keys(row)).toHaveLength(102);
+			expect(row.field0).toBe(projected.note);
+			expect(row.field100).toBe(projected.note);
+		}
+		expect(() =>
+			new PseudonymSession({ salt: "model-default" }).substituteInValue(value),
+		).toThrow("walk budget");
+	});
+
+	it("keeps each row and every root key/logical slot bounded before allocating output", () => {
+		const session = new PseudonymSession({
+			salt: "small",
+			walkBudget: { maxNodes: 32, maxBytes: 64 },
+		});
+		expect(() =>
+			session.substituteRecordsInValue({ rows: [{ slots: Array(40) }] }),
+		).toThrow("walk budget");
+		expect(() =>
+			session.substituteRecordsInValue({ rows: [{ text: "x".repeat(65) }] }),
+		).toThrow("walk budget");
+		expect(() => session.substituteRecordsInValue(Array(33))).toThrow(
+			"walk budget",
+		);
+		expect(() => session.substituteRecordsInValue({ rows: Array(33) })).toThrow(
+			"walk budget",
+		);
+		expect(() =>
+			session.substituteRecordsInValue(
+				Object.fromEntries(
+					Array.from({ length: 33 }, (_, index) => [`k${index}`, []]),
+				),
+			),
+		).toThrow("walk budget");
+		expect(() =>
+			session.substituteRecordsInValue({ ["k".repeat(1025)]: [] }),
+		).toThrow("walk budget");
+	});
+
+	it("uses canonical descriptor snapshots without invoking proxy length or any getter", () => {
+		let getCalls = 0;
+		const value = new Proxy([{ text: secret }], {
+			get() {
+				getCalls++;
+				throw new Error("Property getters must never be invoked");
+			},
+		});
+		const session = new PseudonymSession({ salt: "descriptors" });
+		expect(session.substituteRecordsInValue(value)).toEqual(
+			session.substituteInValue(value),
+		);
+		expect(getCalls).toBe(0);
+		let slotReads = 0;
+		const changing = new Proxy([{ text: "first descriptor" }], {
+			getOwnPropertyDescriptor(target, key) {
+				if (key === "0") {
+					slotReads++;
+					return {
+						enumerable: true,
+						configurable: true,
+						writable: true,
+						value: { text: `descriptor ${slotReads}` },
+					};
+				}
+				return Reflect.getOwnPropertyDescriptor(target, key);
+			},
+		});
+		expect(session.substituteRecordsInValue(changing)).toEqual([
+			{ text: "descriptor 1" },
+		]);
+		expect(slotReads).toBe(1);
+		const accessor = Object.defineProperty({}, "secret", {
+			enumerable: true,
+			get() {
+				getCalls++;
+				return secret;
+			},
+		});
+		expect(() =>
+			session.substituteRecordsInValue({ rows: [accessor] }),
+		).toThrow("walk budget");
+		expect(() =>
+			session.substituteRecordsInValue(
+				Object.defineProperty({}, "rows", {
+					enumerable: true,
+					get() {
+						getCalls++;
+						return [];
+					},
+				}),
+			),
+		).toThrow("walk budget");
+		expect(() =>
+			session.substituteRecordsInValue(
+				Object.defineProperty([], "0", {
+					enumerable: true,
+					get() {
+						getCalls++;
+						return secret;
+					},
+				}),
+			),
+		).toThrow("walk budget");
+		expect(getCalls).toBe(0);
+	});
+
+	it("retains actual envelope depth and ancestor cycle guards across record boundaries", () => {
+		const session = new PseudonymSession({ salt: "depth" });
+		const allowed = { rows: [nested(MAX_PII_PSEUDONYM_WALK_DEPTH - 2)] };
+		expect(session.substituteRecordsInValue(allowed)).toEqual(
+			session.substituteInValue(allowed),
+		);
+		const tooDeep = { rows: [nested(MAX_PII_PSEUDONYM_WALK_DEPTH - 1)] };
+		expect(() => session.substituteRecordsInValue(tooDeep)).toThrow(
+			"walk budget",
+		);
+		expect(() => session.substituteInValue(tooDeep)).toThrow("walk budget");
+		const root: { rows: unknown[] } = { rows: [] };
+		root.rows.push(root);
+		expect(() => session.substituteRecordsInValue(root)).toThrow("walk budget");
+		const row: { parent?: unknown } = {};
+		const collection = [row];
+		row.parent = collection;
+		expect(() => session.substituteRecordsInValue(collection)).toThrow(
+			"walk budget",
+		);
+	});
+
+	it("normalizes custom/null prototypes and own proto data while preserving sparse shape and clean abort signals", () => {
+		const session = new PseudonymSession({ salt: "shapes" });
+		const row = Object.defineProperty(Object.create(null), "__proto__", {
+			enumerable: true,
+			value: { secret },
+		});
+		const sparse = Array(3);
+		sparse[2] = row;
+		const value = { rows: sparse, signal: new AbortController().signal };
+		const projected = session.substituteRecordsInValue(value);
+		expect(projected).toEqual(session.substituteInValue(value));
+		expect(0 in projected.rows).toBe(false);
+		expect(1 in projected.rows).toBe(false);
+		expect(Object.hasOwn(projected.rows[2], "__proto__")).toBe(true);
+		expect(Object.getPrototypeOf(projected.rows[2])).toBe(Object.prototype);
+		expect(projected.signal).toBe(value.signal);
+	});
+});
