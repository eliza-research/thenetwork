+            <span>Private by default.</span>
+            <p>Your facts, choices and consent remain yours to change.</p>
+          </div>
+        </nav>
+        <main
+          id="network-main"
+          ref={mainRef}
+          tabIndex={-1}
+          className="nw-main"
+          aria-busy={loading}
+        >
+          <div className="nw-page-heading">
+            <div>
+              <h1>{displayedTitle}</h1>
+              <p>
+                {mode === "member"
+                  ? (section?.summary ??
+                    member?.summary ??
+                    "Choose a local identity to explore the Network.")
