+/** Derived, scrubbed operations evidence only. This does not authorize a read or persist another graph. */
+export function summarizeNetworkOperations(input: {
+  snapshot: NetworkAdminSnapshot;
+  edges: Awaited<ReturnType<ReturnType<typeof createNetworkNativeOwners>["adminGraph"]>>;
+  clock: NetworkClock;
+  window: { startAt: string; endAt: string };
+  filters?: {
+    city?: NetworkMember["homeCities"][number];
+    cohort?: "newcomer" | "established" | "receiving";
+    generator?: string;
+    exploration?: boolean;
+    neighborhood?: string;
+    inviterCluster?: string;
+    edgeType?: string;
+  };
+}) {
+  const now = input.clock.now().getTime();
+  const start = Date.parse(input.window.startAt),
+    end = Date.parse(input.window.endAt);
+  if (
+    !Number.isFinite(now) ||
+    !Number.isFinite(start) ||
+    !Number.isFinite(end) ||
+    start >= end ||
+    start > now
+  )
+    throw new NetworkDomainError("NETWORK_INVALID", "Invalid analytics observation window");
+  const snapshot = input.snapshot,
+    filters = input.filters ?? {};
+  const opportunityScoped = filters.generator !== undefined || filters.exploration !== undefined;
+  const inWindow = (at: string | number) => {
+    const value = typeof at === "number" ? at : Date.parse(at);
+    return value >= start && value < end && value <= now;
+  };
+  const beforeEnd = (at: string | number) => {
+    const value = typeof at === "number" ? at : Date.parse(at);
+    return Number.isFinite(value) && value < end && value <= now;
+  };
+  const asOf = Math.min(now, end - 1);
+  const cohort = (member: NetworkMember): "newcomer" | "established" =>
+    asOf - Date.parse(member.createdAt) < 14 * DAY ? "newcomer" : "established";
+  const inviteById = new Map(snapshot.invites.map((invite) => [invite.id, invite]));
+  const inviterCluster = (member: NetworkMember) =>
