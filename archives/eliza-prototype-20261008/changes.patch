+    const members = await seedSimulationMembers(host.domain, 100, 42);
+    const memberId = members[0].memberId,
+      otherId = members[2].memberId;
+    const actor = { type: "member", memberId } as const;
+    const reviewer: NetworkActor = { type: "staff", userId: "reviewer", roles: ["reviewer"] };
+    const { revision, ...settings } = await host.domain.getSettings({ type: "system" });
