+import { describe, expect, it } from "vitest";
+import {
+  type CandidateRetrievalProvider,
+  readWorldAnchors,
+  retrieveCandidateIds,
+  type WorldSourceProvider,
+} from "./providers.js";
+import { NOW, testInput } from "./test-fixtures.js";
+
+describe("Network source and retrieval provider admission", () => {
+  it("retains complete fresh source anchors and deduplicates exact records", async () => {
+    const input = testInput();
+    const event = {
+      id: "event-1",
+      city: "SF",
+      tags: ["jazz"],
+      window: input.window,
+      area: "Public venue area",
+      sourceUrl: "https://example.com/fixture",
+      observedAt: NOW,
+      expiresAt: NOW + 86_400_000,
+      verified: true,
+    };
+    const provider: WorldSourceProvider = { sourceId: "fixture", read: async () => [event, event] };
+    expect(await readWorldAnchors(provider, input)).toEqual([event]);
+  });
+  it("rejects unqualified, conflicting or stale source records instead of silently emptying failures", async () => {
+    const input = testInput(),
+      event = {
+        id: "event-1",
+        city: "SF",
+        tags: ["jazz"],
+        window: input.window,
+        area: "Public area",
+        sourceUrl: "https://example.com/fixture",
+        observedAt: NOW,
+        expiresAt: NOW - 1,
+        verified: true,
+      };
+    const provider: WorldSourceProvider = { sourceId: "fixture", read: async () => [event] };
+    await expect(readWorldAnchors(provider, input)).rejects.toThrow("stale");
+    provider.read = async () => {
+      throw new Error("Source unavailable");
+    };
+    await expect(readWorldAnchors(provider, input)).rejects.toThrow("unavailable");
+  });
+  it("scrubs private facts before retrieval and rejects foreign or unbounded IDs", async () => {
+    const input = testInput(3),
+      ids = input.members.map((member) => member.memberId);
+    const provider: CandidateRetrievalProvider = {
+      version: "fixture-v1",
+      retrieve: async (query) => {
+        expect(JSON.stringify(query.member)).not.toContain("CANARY");
+        return {
+          vectorIntentFacet: ids.filter((id) => id !== query.member.memberId),
+          vectorIntentIntent: [],
+          graphTwoHop: [],
+          tags: [],
+          availability: [],
+        };
+      },
+    };
+    const result = await retrieveCandidateIds(provider, input);
+    expect(Object.values(result)).toHaveLength(3);
+    provider.retrieve = async () => ({
+      vectorIntentFacet: ["foreign-member"],
+      vectorIntentIntent: [],
+      graphTwoHop: [],
+      tags: [],
+      availability: [],
+    });
+    await expect(retrieveCandidateIds(provider, input)).rejects.toThrow("canonical-ID");
+  });
+});
diff --git a/packages/cloud/shared/src/lib/network/matching/providers.ts b/packages/cloud/shared/src/lib/network/matching/providers.ts
new file mode 100644
index 000000000000..d498ff8fb6d4
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/matching/providers.ts
@@ -0,0 +1,115 @@
+import type { MatchingInput, MatchMember, WorldAnchor } from "./types.js";
+
+export interface WorldSourceProvider {
+  sourceId: string;
+  /** Host owns network access, bounded fetch and SSRF protections. */
+  read(input: { city: string; from: number; until: number }): Promise<WorldAnchor[]>;
+}
+export interface CandidateRetrievalProvider {
+  version: string;
+  retrieve(input: {
+    member: MatchMember;
+    city: string;
+    window: MatchingInput["window"];
+    eligibleMemberIds: string[];
+    limitPerChannel: number;
+  }): Promise<{
+    vectorIntentFacet: string[];
+    vectorIntentIntent: string[];
+    graphTwoHop: string[];
+    tags: string[];
+    availability: string[];
+  }>;
+}
+
+/** Source provenance/freshness admission; absence and failure never become a fabricated event. */
+export async function readWorldAnchors(
+  provider: WorldSourceProvider,
+  input: Pick<MatchingInput, "city" | "window" | "now">,
+): Promise<WorldAnchor[]> {
+  const records = await provider.read({
+    city: input.city,
+    from: input.window.start,
+    until: input.window.end,
+  });
+  const byId = new Map<string, WorldAnchor>();
+  for (const record of records) {
+    let url: URL;
+    try {
+      url = new URL(record.sourceUrl);
+    } catch {
+      throw new Error("World source returned invalid provenance URL");
+    }
+    if (
+      !["https:", "http:"].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      !record.id ||
+      record.city !== input.city ||
+      !Number.isFinite(record.observedAt) ||
+      record.observedAt > input.now ||
+      !Number.isFinite(record.expiresAt) ||
+      record.expiresAt <= input.now ||
+      !record.verified ||
+      !Number.isFinite(record.window.start) ||
+      !Number.isFinite(record.window.end) ||
+      record.window.start >= record.window.end
+    )
+      throw new Error("World source returned unqualified or stale anchor");
+    const previous = byId.get(record.id);
+    if (previous && JSON.stringify(previous) !== JSON.stringify(record))
+      throw new Error("World source returned conflicting anchor identity");
+    byId.set(record.id, record);
+  }
+  return [...byId.values()].sort((a, b) => a.id.localeCompare(b.id));
+}
+
+export async function retrieveCandidateIds(
+  provider: CandidateRetrievalProvider,
+  input: MatchingInput,
+  limitPerChannel = 50,
+): Promise<Record<string, string[]>> {
+  if (!Number.isSafeInteger(limitPerChannel) || limitPerChannel < 1 || limitPerChannel > 200)
+    throw new Error("Invalid candidate retrieval bound");
+  const eligible = input.members.filter(
+    (member) =>
+      member.age === "adult" &&
+      member.state === "active" &&
+      !member.safetyHold &&
+      member.presence.some(
+        (presence) =>
+          presence.city === input.city &&
+          presence.start < input.window.end &&
+          presence.end > input.window.start,
+      ),
+  );
+  const eligibleIds = eligible.map((member) => member.memberId),
+    ids = new Set(eligibleIds),
+    result: Record<string, string[]> = {};
+  for (const member of eligible) {
+    const channels = await provider.retrieve({
+      member: { ...member, facts: member.facts.filter((fact) => fact.scope !== "agent_private") },
+      city: input.city,
+      window: input.window,
+      eligibleMemberIds: eligibleIds,
+      limitPerChannel,
+    });
+    if (
+      !channels ||
+      Object.keys(channels).sort().join(",") !==
+        ["availability", "graphTwoHop", "tags", "vectorIntentFacet", "vectorIntentIntent"]
+          .sort()
+          .join(",")
+    )
+      throw new Error("Candidate provider omitted a required retrieval channel");
+    for (const records of Object.values(channels))
+      if (
+        !Array.isArray(records) ||
+        records.length > limitPerChannel ||
+        records.some((id) => !ids.has(id) || id === member.memberId)
+      )
+        throw new Error("Candidate provider violated bounded canonical-ID retrieval");
+    result[member.memberId] = [...new Set(Object.values(channels).flat())].sort();
+  }
+  return result;
+}
diff --git a/packages/cloud/shared/src/lib/network/matching/replay-purpose.test.ts b/packages/cloud/shared/src/lib/network/matching/replay-purpose.test.ts
