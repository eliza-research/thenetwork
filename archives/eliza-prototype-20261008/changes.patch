+        "checkbox",
+        true,
+      ),
+      { ...commandField("opportunityId", "Related plan ID, if any"), required: false },
+    ]),
+  );
+  if (domainView.member.age === "adult")
+    result.actions?.push(
+      commandAction(
+        "request_introduction",
+        "Request an introduction",
+        {},
+        [
+          commandField("peerId", "Known member ID"),
+          commandField("objective", "Shareable reason for this introduction", "textarea"),
+          commandField(
