+export async function createLocalNetworkApplication(
+  host: Awaited<ReturnType<typeof createLocalNetworkHost>>,
+  clock: SimClock,
+  operations?: NetworkWorkbenchOperations,
+) {
+  if (!["test:", "simulation:"].some((prefix) => host.domain.options.networkId.startsWith(prefix)))
+    throw new NetworkDomainError(
+      "NETWORK_INVALID",
+      "Local fixture HTTP sessions require an isolated test domain",
+    );
+  const memberAgent = new NetworkMemberAgent({
+    host,
+    executeCommand: (actor, input) =>
+      executeWorkbenchCommand(host, clock, actor, input, operations),
+  });
+  const fixtures: NetworkFixture[] = (await host.domain.adminView(SYSTEM)).members
+    .filter((m) => m.accountState !== "removed")
+    .map((m) => ({
+      id: m.memberId,
+      name: m.displayName,
+      type: "member",
+      description: `${m.homeCities.join(" + ")} synthetic member`,
+    }));
+  fixtures.push({
+    id: "local-operator",
+    name: "Local operator",
+    type: "staff",
+    description: "Review, safety and configuration",
+  });
+  for (const role of ["reviewer", "safety", "analyst", "engineer"] as const)
+    fixtures.push({
+      id: `local-${role}`,
+      name: `Local ${role}`,
+      type: "staff",
+      description: `Only the ${role} role; server-authorized fixture`,
+    });
+  const invitees = new Map(
+    ["SF", "NYC"].map((city) => {
+      const id = stringToUuid(`network-fixture-invitee:${host.domain.options.networkId}:${city}`);
+      return [id, { city, name: `Synthetic ${city} invitee` }];
+    }),
+  );
+  for (const [id, candidate] of invitees)
+    if (!fixtures.some((fixture) => fixture.id === id))
+      fixtures.push({
+        id,
+        name: candidate.name,
+        type: "candidate",
+        description: "Host-verified synthetic invitee; no real phone verification",
+      });
+  const principals = new Map<string, NetworkActor>();
+  for (const fixture of fixtures)
+    if (fixture.type !== "staff")
+      principals.set(fixture.id, { type: "member", memberId: fixture.id });
+  principals.set("local-operator", {
+    type: "staff",
+    userId: "local-operator",
+    roles: ["admin", "reviewer", "safety", "analyst", "engineer"],
+  });
+  for (const role of ["reviewer", "safety", "analyst", "engineer"] as const)
+    principals.set(`local-${role}`, { type: "staff", userId: `local-${role}`, roles: [role] });
+  const secret = randomBytes(32);
+  const phoneLogin = new LocalNetworkPhoneLogin();
+  const demoPrincipal = fixtures.find((fixture) => fixture.type === "member");
+  const portalSessions = new Map<string, { memberId: string; brand: string; expiresAt: number }>();
+  const sign = (id: string) => createHmac("sha256", secret).update(id).digest("hex");
+  function session(request: Request): NetworkActor {
+    const value = request.headers
+      .get("cookie")
+      ?.split(";")
+      .map((v) => v.trim())
+      .find((v) => v.startsWith("network_local="))
+      ?.slice(14);
+    if (!value) throw new NetworkDomainError("NETWORK_FORBIDDEN", "Choose a local fixture first");
+    const cut = value.lastIndexOf("."),
+      id = value.slice(0, cut),
+      digest = value.slice(cut + 1);
+    if (id.startsWith("portal:")) {
+      const current = portalSessions.get(id.slice(7));
+      if (!current || current.expiresAt <= Date.now())
+        throw new NetworkDomainError("NETWORK_FORBIDDEN", "Your session expired. Sign in again.");
+    }
+    if (
+      !/^[a-f0-9]{64}$/.test(digest) ||
+      !timingSafeEqual(Buffer.from(digest), Buffer.from(sign(id))) ||
+      !principals.has(id)
+    )
+      throw new NetworkDomainError("NETWORK_FORBIDDEN", "Invalid local session");
+    return principals.get(id)!;
+  }
+  return async (request: Request): Promise<Response> => {
+    const json = (value: unknown, status = 200, headers: Record<string, string> = {}) =>
+      Response.json(value, { status, headers: { "Cache-Control": "no-store", ...headers } });
+    try {
+      const url = new URL(request.url);
+      if (!["127.0.0.1", "localhost"].includes(url.hostname) || url.protocol !== "http:")
+        return json({ error: "Local HTTP host required" }, 403);
+      if (request.headers.get("origin") && request.headers.get("origin") !== url.origin)
+        return json({ error: "Same-origin request required" }, 403);
+      if (
+        request.method !== "GET" &&
+        !request.headers.get("content-type")?.startsWith("application/json")
+      )
+        return json({ error: "JSON request required" }, 415);
+      if (url.pathname === "/api/network/portal/config" && request.method === "GET")
+        return json({
+          mode: "local_preview",
+          brands: NETWORK_PORTAL_BRANDS,
+          demoPhone: NETWORK_PORTAL_DEMO_PHONE,
+          agentPhone: null,
+        });
+      if (url.pathname === "/api/network/portal/start" && request.method === "POST") {
+        const input = await readCommandObject(request);
+        onlyKeys(input, ["phone", "brand"]);
+        return json(await phoneLogin.start(input.phone, input.brand));
+      }
+      if (url.pathname === "/api/network/portal/verify" && request.method === "POST") {
+        const input = await readCommandObject(request);
+        onlyKeys(input, ["challengeId", "code", "brand"]);
+        await phoneLogin.verify(input.challengeId, input.code, input.brand);
+        if (!demoPrincipal)
+          throw new NetworkDomainError(
+            "NETWORK_INELIGIBLE",
+            "No local member is available. An invitation is required before joining.",
+          );
+        const member = await host.domain.getMember(SYSTEM, demoPrincipal.id);
+        if (member.accountState === "removed" || member.safetyHold)
+          throw new NetworkDomainError("NETWORK_INELIGIBLE", "This member is unavailable.");
+        if (!minimumAgeConfirmed(member))
+          throw new NetworkDomainError(
+            "NETWORK_INELIGIBLE",
+            "Confirm your minimum age in the local member controls before signing in.",
+          );
+        for (const [key, value] of portalSessions)
+          if (value.expiresAt <= Date.now()) {
+            portalSessions.delete(key);
+            principals.delete(`portal:${key}`);
+          }
+        if (portalSessions.size >= 256)
+          throw new NetworkDomainError(
+            "NETWORK_INELIGIBLE",
+            "Local session capacity reached. Try again later.",
+          );
+        const key = randomBytes(32).toString("hex");
+        portalSessions.set(key, {
+          memberId: demoPrincipal.id,
+          brand: String(input.brand),
+          expiresAt: Date.now() + 86_400_000,
+        });
+        principals.set(`portal:${key}`, { type: "member", memberId: demoPrincipal.id });
+        const response = json({ ok: true });
+        response.headers.append(
+          "Set-Cookie",
+          `network_portal=${key}; HttpOnly; SameSite=Strict; Path=/; Max-Age=86400`,
+        );
+        response.headers.append(
+          "Set-Cookie",
+          `network_local=portal:${key}.${sign(`portal:${key}`)}; HttpOnly; SameSite=Strict; Path=/; Max-Age=86400`,
+        );
+        return response;
+      }
+      if (url.pathname === "/api/network/portal/signout" && request.method === "POST") {
+        const key = request.headers
+          .get("cookie")
+          ?.split(";")
+          .map((value) => value.trim())
+          .find((value) => value.startsWith("network_portal="))
+          ?.slice(15);
+        if (key) {
+          portalSessions.delete(key);
+          principals.delete(`portal:${key}`);
+        }
+        const response = json({ ok: true });
+        response.headers.append(
+          "Set-Cookie",
+          "network_portal=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0",
+        );
+        response.headers.append(
+          "Set-Cookie",
+          "network_local=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0",
+        );
+        return response;
+      }
+      if (url.pathname === "/api/network/portal/session" && request.method === "GET") {
+        const key = request.headers
+          .get("cookie")
+          ?.split(";")
+          .map((value) => value.trim())
+          .find((value) => value.startsWith("network_portal="))
+          ?.slice(15);
+        const current = key ? portalSessions.get(key) : undefined;
+        if (!current || current.expiresAt <= Date.now())
+          return json({
+            member: null,
+            brand: null,
+            channel: { status: "local_preview", number: null },
+          });
+        const actor = session(request);
+        if (actor.type !== "member" || actor.memberId !== current.memberId)
+          throw new NetworkDomainError(
+            "NETWORK_FORBIDDEN",
+            "Sign in again to open your own account.",
+          );
+        const member = await host.domain.getMember(actor, actor.memberId);
+        if (member.accountState === "removed" || member.safetyHold)
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "This member is unavailable.");
+        return json({
+          member: await localMemberView(host, actor),
+          brand: current.brand,
+          eligible: member.age === "adult",
+          channel: { status: "local_preview", number: null },
+        });
+      }
+      if (url.pathname === "/api/network/local/sessions" && request.method === "GET") {
+        const members = (await host.domain.adminView(SYSTEM)).members;
+        return json(
+          fixtures.filter(
+            (fixture) =>
+              fixture.type === "staff" ||
+              members.some(
+                (member) => member.memberId === fixture.id && member.accountState !== "removed",
+              ) ||
+              (fixture.type === "candidate" &&
+                !members.some((member) => member.memberId === fixture.id)),
+          ),
+        );
+      }
+      if (url.pathname === "/api/network/local/session" && request.method === "POST") {
+        const input = await readCommandObject(request);
+        text(input.fixtureId, "fixture identity", 160);
+        if (!principals.has(input.fixtureId)) return json({ error: "Unknown fixture" }, 400);
+        return json({ ok: true }, 200, {
+          "Set-Cookie": `network_local=${input.fixtureId}.${sign(input.fixtureId)}; HttpOnly; SameSite=Strict; Path=/`,
+        });
+      }
+      const actor = session(request);
+      if (url.pathname === "/api/network/admin/artifact" && request.method === "GET") {
+        if (!operations)
+          throw new NetworkDomainError("NETWORK_CONFLICT", "Export services unavailable");
+        const exportId = url.searchParams.get("exportId"),
+          kind = url.searchParams.get("kind");
+        text(exportId, "retained export", 160);
+        if (
+          kind !== "parquet" &&
+          kind !== "opportunity_funnel" &&
+          kind !== "exposure" &&
+          kind !== "review_labels"
+        )
+          throw new NetworkDomainError("NETWORK_INVALID", "Unknown retained artifact");
+        const artifact = await operations.data.artifact(actor, exportId, kind);
+        return new Response(new Uint8Array(artifact.bytes), {
+          headers: {
+            "Content-Type": artifact.contentType,
+            "Content-Disposition": `attachment; filename="${artifact.filename}"`,
+            "Cache-Control": "no-store",
+          },
+        });
+      }
+      if (url.pathname === "/api/network/conversation" && request.method === "GET") {
+        if (actor.type !== "member")
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "Private member conversation required");
+        return json(await memberAgent.conversation(actor.memberId));
+      }
+      if (url.pathname === "/api/network/message" && request.method === "POST") {
+        if (actor.type !== "member")
+          throw new NetworkDomainError("NETWORK_FORBIDDEN", "Private member conversation required");
+        const input = await readCommandObject(request);
+        if (Object.keys(input).some((key) => key !== "text" && key !== "requestId"))
+          throw new NetworkDomainError(
+            "NETWORK_FORBIDDEN",
+            "Conversation identity and authority are host-owned",
+          );
+        text(input.text, "complete member message", 30000);
+        text(input.requestId, "message request", 120);
+        return json(
+          await memberAgent.message(actor.memberId, {
+            text: input.text,
+            requestId: input.requestId,
+          }),
+        );
+      }
+      if (url.pathname === "/api/network/view" && request.method === "GET") {
+        if (actor.type === "member" && invitees.has(actor.memberId)) {
+          try {
+            await host.domain.getMember(actor, actor.memberId);
+          } catch (error) {
+            if (!(error instanceof NetworkDomainError) || error.code !== "NETWORK_NOT_FOUND")
+              throw error;
+            return json({
+              environment: "Local synthetic invitee · host-owned fixture verification",
+              member: {
+                id: actor.memberId,
+                displayName: invitees.get(actor.memberId)?.name,
+                status: "invitee",
+              },
+              summary:
+                "Test invitation acceptance with a forwarding token. This fixture does not perform real phone verification.",
+              actions: [
+                commandAction(
+                  "accept_fixture_invite",
+                  "Accept a forwarded invitation",
+                  {},
+                  [
+                    commandField("inviteId", "Invitation ID"),
+                    commandField("token", "Forwarding token"),
+                    {
+                      ...commandField("ageBand", "Confirmed age band", "select", ""),
+                      options: NETWORK_AGE_BAND_OPTIONS,
+                    },
+                    commandField(
+                      "messagingConsent",
+                      "I agree to local messaging and the synthetic terms",
+                      "checkbox",
+                      false,
+                    ),
+                    commandField(
+                      "ageConfirmed",
+                      "I confirm this age classification",
+                      "checkbox",
+                      false,
+                    ),
+                  ],
+                  "Activate only this selected synthetic identity?",
+                ),
+              ],
+              sections: [
+                {
+                  id: "onboarding",
+                  title: "Invitation acceptance",
+                  rows: [],
+                  emptyMessage:
+                    "Ask a member or the local operator to create an invitation, then use its local forwarding token.",
+                },
+              ],
+            });
+          }
+        }
+        return json(await localMemberView(host, actor));
+      }
+      if (url.pathname === "/api/network/admin" && request.method === "GET")
+        return json(await localAdminView(host, actor, url.searchParams, operations));
+      if (url.pathname === "/api/network/command" && request.method === "POST") {
+        const input = await readCommandObject(request);
+        if (input.type === "accept_fixture_invite") {
+          if (actor.type !== "member" || !invitees.has(actor.memberId))
+            throw new NetworkDomainError(
+              "NETWORK_FORBIDDEN",
+              "A selected synthetic invitee is required",
+            );
+          if (
+            [
+              "actor",
+              "roles",
+              "cloudUserId",
+              "verifiedAt",
+              "memberId",
+              "address",
+              "invitedIdentityVerified",
+            ].some((key) => key in input)
+          )
+            throw new NetworkDomainError("NETWORK_FORBIDDEN", "Invitee identity is host-owned");
+          if (
+            input.ageConfirmed !== true ||
+            (input.ageBand !== "under13" && input.messagingConsent !== true)
+          )
+            throw new NetworkDomainError(
+              "NETWORK_INVALID",
+              "Explicit age and messaging consent are required",
+            );
+          const result = await host.domain.withAuthority(async (domain) => {
+            text(input.inviteId, "invitation identity", 160);
+            text(input.requestId, "acceptance request identity", 120);
+            const store = new DomainStore(domain.options.db.execute, domain.options.networkId);
+            const [invite] = await store.list<NetworkInvite>("invites", [input.inviteId]);
+            const [original] = await store.list<NetworkEvent>("events", [input.requestId]);
+            return domain.command(
+              SYSTEM,
+              parseNetworkCommand({
+                type: "accept_invite",
+                requestId: input.requestId,
+                inviteId: input.inviteId,
+                token: input.token,
+                memberId: actor.memberId,
+                cloudUserId: `synthetic-fixture:${host.domain.options.networkId}:${actor.memberId}`,
+                displayName: invitees.get(actor.memberId)?.name,
+                age: input.ageBand ? (input.ageBand === "18_plus" ? "adult" : "minor") : input.age,
+                ...(input.ageBand ? { ageBand: input.ageBand } : {}),
+                // The closed fixture principal must match the authored recipient; token possession alone is insufficient.
+                // An absent invitation can only replay an exact original receipt; it cannot authorize a new admission.
+                ...(!invite || invite.inviteeName === invitees.get(actor.memberId)?.name
+                  ? { invitedIdentityVerified: true }
+                  : {}),
+                channel: "sms",
+                address: `synthetic-fixture:${actor.memberId}`,
+                verifiedAt: original?.at ?? clock.now().toISOString(),
+                termsVersion: "local-fixture-1",
+                messagingConsent: input.messagingConsent === true,
+                seedVouch: false,
+              }),
+            );
+          });
+          return json({
+            result,
+            message:
+              "kind" in result && result.kind === "age_declined"
+                ? "Thanks for your interest. The Network is for ages 13 and older. Your invitation details were removed."
+                : "Only the selected host-owned synthetic identity was accepted. Complete onboarding next.",
+          });
+        }
+        return json(await executeWorkbenchCommand(host, clock, actor, input, operations));
+      }
+      return json({ error: "Unknown route" }, 404);
+    } catch (error) {
+      if (error instanceof NetworkDomainError) {
+        const status =
+          error.code === "NETWORK_FORBIDDEN"
+            ? 403
+            : error.code === "NETWORK_NOT_FOUND"
+              ? 404
+              : error.code === "NETWORK_INVALID"
+                ? 400
+                : 409;
+        return json(
+          {
+            error: error.message,
+            code: error.code,
+            ...(typeof error.context?.rule === "string" ? { rule: error.context.rule } : {}),
+          },
+          status,
+        );
+      }
+      host.runtime.reportError("network.workbench.http", error, {
+        path: new URL(request.url).pathname,
+        networkId: host.domain.options.networkId,
+      });
+      return json(
+        { error: "Local request did not complete. Check the host diagnostics before retrying." },
+        500,
+      );
+    }
+  };
+}
