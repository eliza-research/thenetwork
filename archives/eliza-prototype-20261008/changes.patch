@@ -0,0 +1,149 @@
+import { randomUUID } from "node:crypto";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { EntityStore, RelationshipStore } from "@elizaos/plugin-relationships/graph";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { localNetworkExportWriter } from "../../../../../scripts/network-data-export.ts";
+import { systemClock } from "../../services/containers/compute-rate-governor.ts";
+import { networkDigest } from "../digest.ts";
+import type { NetworkActor } from "../domain/types.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { localAdminView } from "./application-views.ts";
+import { NetworkDataExport } from "./data-export.ts";
+import { createLocalNetworkHost } from "./host.ts";
+import { createNativeSimulationTransport } from "./simulation-ingress.ts";
+import { NetworkSimulationLab } from "./simulation-lab.ts";
+
+const clock = new SimClock(Date.parse("2026-10-06T19:00:00.000Z"));
+const actor: NetworkActor = { type: "staff", userId: "graph-reviewer", roles: ["admin"] };
+let host: Awaited<ReturnType<typeof createLocalNetworkHost>>;
+let directory: string;
+let members: string[];
+beforeAll(async () => {
+  directory = await mkdtemp(join(tmpdir(), "network-member-graph-"));
+  vi.stubEnv("ELIZA_STATE_DIR", directory);
+  host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: `test:member-graph:${randomUUID()}`,
+    clock,
+  });
+  members = (await seedSimulationMembers(host.domain, 3, 47)).map((member) => member.memberId);
+}, 120000);
+afterAll(async () => {
+  await host?.close();
+  vi.unstubAllEnvs();
+  if (directory) await rm(directory, { recursive: true, force: true });
+});
+
+it("follows the exact related Member360 action to one authorized member row", async () => {
+  const all = await localAdminView(host, actor, new URLSearchParams({ module: "members" }));
+  expect(all.rows.map((row) => row.id)).toEqual(members);
+  const link = all.rows
+    .find((row) => row.id === members[1])
+    ?.actions?.find((action) => action.label === "Member 360");
+  expect(link?.type).toBe("navigate_admin");
+  if (!link?.args) throw new Error("Existing related Member360 link arguments missing");
+  const parameters = new URLSearchParams(
+    Object.entries(link.args).map(([key, value]) => [key, String(value)]),
+  );
+  const selected = await localAdminView(host, actor, parameters);
+  expect(selected.rows.map((row) => row.id)).toEqual([members[1]]);
+  expect(
+    selected.rows[0]?.actions?.find((action) => action.label === "Member timeline")?.args,
+  ).toEqual({ module: "perspective", memberId: members[1] });
+  expect(JSON.stringify(selected)).not.toContain("CANARY_PRIVATE_");
+  const read = (await host.domain.adminView(actor)).events
+    .filter((event) => event.kind === "staff_projection_read")
+    .at(-1);
+  expect(read?.memberIds).toEqual([members[1]]);
+  await expect(
+    localAdminView(
+      host,
+      actor,
+      new URLSearchParams({ module: "members", memberId: "missing-member" }),
+    ),
+  ).rejects.toMatchObject({ code: "NETWORK_NOT_FOUND" });
+});
+
+it("forwards exact retained native relationship metadata into the graph DTO without primary graph reads", async () => {
+  const partition = `network:${networkDigest(host.domain.options.networkId)}:member:${networkDigest(members[0])}`;
+  const entities = new EntityStore(host.runtime, partition);
+  const target = `network:member:${members[1]}`;
+  await entities.upsert({
+    entityId: target,
+    type: "person",
+    preferredName: "Network member",
+    identities: [],
+    tags: [],
+    visibility: "owner_only",
+    state: {},
+  });
+  const relationships = new RelationshipStore(host.runtime, partition);
+  await relationships.upsert({
+    relationshipId: "retained-graph-edge",
+    fromEntityId: "self",
+    toEntityId: target,
+    type: "network:reported_met",
+    source: "system",
+    confidence: 0,
+    state: { lastInteractionAt: "2026-10-06T18:00:00.000Z", interactionCount: 1 },
+    evidence: ["PRIVATE_GRAPH_EVIDENCE"],
+    metadata: {
+      networkId: host.domain.options.networkId,
+      confirmed: true,
+      privateNote: "PRIVATE_GRAPH_NOTE",
+    },
+  });
+  const source = (await host.native.adminGraph(host.db.execute, members)).find(
+    (edge) => edge.id === "retained-graph-edge",
+  );
+  if (!source) throw new Error("Canonical graph source missing");
+  const data = new NetworkDataExport({
+    domain: host.domain,
+    scheduler: host.runner,
+    clock,
+    writer: localNetworkExportWriter,
+    graph: host.native.adminGraph,
+  });
+  await data.export(actor, "retained-graph-source");
+  const simulation = new NetworkSimulationLab({
+    domain: host.domain,
+    scheduler: host.runner,
+    clock,
+    wallClock: systemClock,
+    createWorld: (input) =>
+      createLocalNetworkHost({
+        dataDir: "memory://",
+        networkId: input.networkId,
+        clock: input.clock,
+      }),
+    transport: createNativeSimulationTransport,
+  });
+  const primary = vi
+    .spyOn(host.native, "adminGraph")
+    .mockRejectedValue(new Error("Primary graph read forbidden"));
+  const snapshot = vi
+    .spyOn(host.domain, "adminView")
+    .mockRejectedValue(new Error("Primary analytics snapshot read forbidden"));
+  try {
+    const view = await localAdminView(host, actor, new URLSearchParams({ module: "graph" }), {
+      data,
+      simulation,
+    });
+    expect(view.graph?.edges.find((edge) => edge.id === source.id)).toMatchObject({
+      source: source.from,
+      target: source.to,
+      label: source.type,
+      createdAt: source.createdAt,
+      lastInteractionAt: source.lastInteractionAt,
+      confidence: source.confidence,
+    });
+    expect(JSON.stringify(view)).not.toContain("PRIVATE_GRAPH_");
+    expect(JSON.stringify(view)).not.toContain("CANARY_PRIVATE_");
+  } finally {
+    primary.mockRestore();
+    snapshot.mockRestore();
+    await simulation.shutdown();
+  }
+});
