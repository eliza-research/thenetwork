+    title: "Meet by mutual choice",
+  },
+  network: {
+    name: "The Network",
+    title: "Your Network starts here",
+  },
+} as const;
+
+export default function NetworkPhoneLoginPage() {
+  const [params] = useSearchParams();
+  const key = params.get("brand");
+  const brand =
+    key === "slop.love" || key === "network"
+      ? BRAND_COPY[key]
+      : BRAND_COPY["friend.help"];
+  useDocumentTitle(`${brand.name} · Sign in`);
+  if (!params.has("returnTo")) {
+    const next = new URLSearchParams(params);
+    const brandId =
+      key === "slop.love" || key === "network" ? key : "friend.help";
+    next.set("returnTo", `/network/chat?brand=${encodeURIComponent(brandId)}`);
+    return <Navigate to={`/network/login?${next.toString()}`} replace />;
+  }
+  const hostedStaging = isLoopbackStagingStewardDevelopment();
+  return (
+    <main
+      className="theme-cloud min-h-dvh bg-bg px-4 py-12 text-txt"
+      style={{ paddingTop: "max(env(safe-area-inset-top), 3rem)" }}
+    >
+      <section
+        className="mx-auto w-full max-w-md rounded-2xl border border-border bg-card p-6 sm:p-8"
+        aria-labelledby="network-phone-title"
+      >
+        <p className="mb-8 font-semibold text-accent">{brand.name}</p>
+        <h1
+          id="network-phone-title"
+          className="text-2xl font-semibold text-txt-strong"
+        >
+          {brand.title}
+        </h1>
+        <p className="mb-6 mt-3 text-sm text-muted">
+          {hostedStaging
+            ? "Continue through the hosted Eliza Cloud sign-in page."
+            : "Use your phone number to sign in or create your account."}
+        </p>
+        <Suspense fallback={<p role="status">Loading phone sign-in…</p>}>
+          {hostedStaging ? (
+            <HostedStagingSignIn
+              returnTo={
+                sanitizeLoginReturnTo(params.get("returnTo")) ??
+                `/network/chat?brand=${encodeURIComponent(key === "slop.love" || key === "network" ? key : "friend.help")}`
+              }
+            />
+          ) : (
+            <StewardLoginSection phoneOnly />
+          )}
+        </Suspense>
+        <p className="mt-6 text-xs leading-relaxed text-muted">
+          Account sign-in does not enroll you in a community or enable dating.
+          Invitations, eligibility and sharing choices remain separate.
+        </p>
+        <LoginTerms />
+        <p className="mt-4 text-xs text-muted">Powered by Eliza</p>
+      </section>
+    </main>
+  );
+}
+
+function HostedStagingSignIn({ returnTo }: { returnTo: string }) {
+  const navigate = useNavigate();
+  const t = useCloudT();
+  const [notice, setNotice] = useState<string | null>(null);
+  const [configurationError, setConfigurationError] = useState<string | null>(
+    null,
+  );
+  const auth = useCloudState({
+    setActionNotice: setNotice,
+    t,
+  });
+  useEffect(() => {
+    if (auth.elizaCloudConnected && readStoredStewardToken()) {
+      navigate(returnTo, { replace: true });
+    }
+  }, [auth.elizaCloudConnected, navigate, returnTo]);
+  const signIn = () => {
+    const config = getBootConfig();
+    const staging = ELIZA_DOMAIN_CONTRACTS.staging.cloudApiOrigin;
+    if (
+      config.cloudApiBase &&
+      resolveDirectCloudAuthApiBase(config.cloudApiBase) !== staging
+    ) {
+      setConfigurationError(
+        "This sign-in page requires the staging Cloud environment. Restart with the staging configuration.",
+      );
+      return;
+    }
+    if (!config.cloudApiBase)
+      setBootConfig({ ...config, cloudApiBase: staging });
+    setConfigurationError(null);
+    claimCloudLoginWindow();
+    void auth
+      .handleInteractiveCloudLogin({ requireClientAuth: true })
+      .catch((error: unknown) => {
+        setNotice(
+          error instanceof Error
+            ? error.message
+            : "Could not start Eliza Cloud sign-in.",
+        );
+      });
+  };
+  return (
+    <>
+      <button
+        type="button"
+        className="w-full rounded-lg bg-accent px-4 py-3 font-semibold text-accent-foreground"
+        disabled={auth.elizaCloudLoginBusy}
+        onClick={signIn}
+      >
+        {auth.elizaCloudLoginBusy
+          ? "Waiting for Eliza Cloud…"
+          : "Sign in with Eliza Cloud"}
+      </button>
+      <p className="mt-3 text-sm text-muted">
+        The hosted page offers its available sign-in methods. Completing its
+        browser authorization creates an account API key for this browser.
+      </p>
+      {(configurationError || auth.elizaCloudLoginError) && (
+        <p role="alert">{configurationError || auth.elizaCloudLoginError}</p>
+      )}
+      {notice && <p role="status">{notice}</p>}
+      {auth.elizaCloudLoginFallbackUrl && (
+        <a
+          href={auth.elizaCloudLoginFallbackUrl}
+          target="_blank"
+          rel="noopener noreferrer"
+        >
+          Open Eliza Cloud sign-in
+        </a>
+      )}
+      {auth.elizaCloudLoginBusy && (
+        <button type="button" onClick={auth.cancelCloudLogin}>
+          Cancel sign-in
+        </button>
+      )}
+    </>
+  );
+}
