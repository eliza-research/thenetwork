+// @vitest-environment jsdom
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const state = vi.hoisted(() => ({
+  staging: false,
+  connected: false,
+  busy: false,
+  token: null as string | null,
+  base: "https://api-staging.eliza.app" as string | undefined,
+  login: vi.fn(),
+  claim: vi.fn(),
+  cancel: vi.fn(),
+  setBoot: vi.fn(),
+}));
+vi.mock("../../../../state/loopback-steward-development", () => ({
+  isLoopbackStagingStewardDevelopment: () => state.staging,
+}));
+vi.mock("../../../../state/cloud-login-launch", () => ({
+  claimCloudLoginWindow: state.claim,
+}));
+vi.mock("../../../../config/boot-config-store", () => ({
+  getBootConfig: () => ({ cloudApiBase: state.base }),
+  setBootConfig: state.setBoot,
+}));
+vi.mock("../../../../api/client-cloud", () => ({
+  resolveDirectCloudAuthApiBase: (base: string) => base,
+}));
+vi.mock("@elizaos/plugin-elizacloud/steward-session-client", () => ({
+  readStoredStewardToken: () => state.token,
+}));
+vi.mock("../../../../state/useCloudState", () => ({
+  useCloudState: () => ({
+    elizaCloudConnected: state.connected,
+    elizaCloudLoginBusy: state.busy,
+    elizaCloudLoginError: null,
+    elizaCloudLoginFallbackUrl: null,
+    handleInteractiveCloudLogin: state.login,
+    cancelCloudLogin: state.cancel,
+  }),
+}));
+vi.mock("./steward-login-section", () => ({
+  default: ({ phoneOnly }: { phoneOnly: boolean }) => (
+    <p>{phoneOnly ? "Inline phone sign-in" : "Inline sign-in"}</p>
+  ),
+}));
+vi.mock("./login-terms", () => ({ LoginTerms: () => null }));
+vi.mock("../../../lib/use-document-title", () => ({
+  useDocumentTitle: vi.fn(),
+}));
+
+vi.mock("../../../shell/CloudI18nProvider", () => ({
+  useCloudT: () => (key: string) => key,
+}));
+
+import NetworkPhoneLoginPage from "./network-phone-login-page";
+
+function mount(returnTo = "/network/chat?brand=slop.love") {
+  return render(
+    <MemoryRouter
+      initialEntries={[
+        `/network/login?brand=slop.love&returnTo=${encodeURIComponent(returnTo)}`,
+      ]}
+    >
+      <Routes>
+        <Route path="/network/login" element={<NetworkPhoneLoginPage />} />
+        <Route path="/network/chat" element={<p>Branded conversation</p>} />
+      </Routes>
+    </MemoryRouter>,
+  );
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  state.staging = false;
+  state.connected = false;
+  state.busy = false;
+  state.token = null;
+  state.base = "https://api-staging.eliza.app";
+  state.login.mockResolvedValue(undefined);
+});
+afterEach(cleanup);
+describe("Network hosted staging login", () => {
+  it("preserves inline phone-only sign-in outside the exact loopback staging branch", async () => {
+    mount();
+    expect(await screen.findByText("Inline phone sign-in")).toBeTruthy();
+    expect(state.login).not.toHaveBeenCalled();
+  });
+  it("requires a deliberate click and delegates to the existing interactive login owner", () => {
+    state.staging = true;
+    mount();
+    expect(state.login).not.toHaveBeenCalled();
+    expect(screen.getByText(/creates an account API key/)).toBeTruthy();
+    fireEvent.click(
+      screen.getByRole("button", { name: "Sign in with Eliza Cloud" }),
+    );
+    expect(state.claim).toHaveBeenCalledOnce();
+    expect(state.login).toHaveBeenCalledWith({ requireClientAuth: true });
+    expect(state.claim.mock.invocationCallOrder[0]).toBeLessThan(
+      state.login.mock.invocationCallOrder[0],
+    );
+  });
+  it("rejects a conflicting production Cloud base before opening or authorizing", () => {
+    state.staging = true;
+    state.base = "https://api.eliza.app";
+    mount();
+    fireEvent.click(
+      screen.getByRole("button", { name: "Sign in with Eliza Cloud" }),
+    );
+    expect(screen.getByRole("alert").textContent).toContain(
+      "staging Cloud environment",
+    );
+    expect(state.claim).not.toHaveBeenCalled();
+    expect(state.login).not.toHaveBeenCalled();
+  });
+  it("returns to the requested branded conversation only after the owner confirms authority", async () => {
+    state.staging = true;
+    state.connected = true;
+    state.token = "eliza_account_key";
+    mount();
+    expect(await screen.findByText("Branded conversation")).toBeTruthy();
+  });
+  it("does not redirect on connected state without a namespaced current credential", () => {
+    state.staging = true;
+    state.connected = true;
+    mount();
+    expect(
+      screen.getByRole("button", { name: "Sign in with Eliza Cloud" }),
+    ).toBeTruthy();
+  });
+  it("delegates cancellation while the shared owner is waiting", () => {
+    state.staging = true;
+    state.busy = true;
+    mount();
+    fireEvent.click(screen.getByRole("button", { name: "Cancel sign-in" }));
+    expect(state.cancel).toHaveBeenCalledOnce();
+  });
+  it("sanitizes an external return destination to the branded conversation", async () => {
+    state.staging = true;
+    state.connected = true;
+    state.token = "eliza_account_key";
+    mount("//evil.example/path");
+    await waitFor(() =>
+      expect(screen.getByText("Branded conversation")).toBeTruthy(),
+    );
+  });
+});
