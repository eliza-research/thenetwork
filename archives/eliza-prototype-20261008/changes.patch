+  }
+  /** Cost: one selective local SQL read, then current Domain reads for same-window confirmed plans; no external calendar claims. */
+  private async assertSlotAvailable(
+    domain: NetworkDomain,
+    opportunityId: string,
+    memberIds: string[],
+    startAt: string,
+    endAt: string,
+  ): Promise<void> {
+    const rows = await domain.options.db.execute(
+      `SELECT payload FROM network.coordination WHERE network_id=${sqlQuote(this.options.networkId)} AND opportunity_id<>${sqlQuote(opportunityId)} AND payload->'slot' IS NOT NULL AND payload->'slot'<>'null'::jsonb AND payload->'slot'->>'startAt'<${sqlQuote(endAt)} AND payload->'slot'->>'endAt'>${sqlQuote(startAt)} AND payload->'confirmedMemberIds' ?| ARRAY[${memberIds.map(sqlQuote).join(",")}]`,
+    );
+    for (const row of rows) {
+      const record = decode<CoordinationRecord>(row.payload);
+      const other = await domain.getOpportunity(SYSTEM, record.opportunityId);
+      if (
+        !("participantIds" in other) ||
+        record.opportunityRevision !== other.revision ||
+        !["scheduling", "scheduled", "in_progress", "reschedule_requested"].includes(other.state)
+      )
+        continue;
+      if (
+        acceptedParticipantIds(other).some(
+          (id) => memberIds.includes(id) && record.confirmedMemberIds.includes(id),
+        )
+      )
+        throw new NetworkDomainError(
+          "NETWORK_CONFLICT",
+          "A participant has already confirmed an overlapping Network plan",
+          { rule: "confirmed_slot_overlap" },
+        );
+    }
+  }
+  async suggestSlots(
+    actor: NetworkActor,
+    input: {
+      opportunityId: string;
+      revision: number;
+      range: CalendarAvailabilityRange;
+      durationMs: number;
+    },
+  ) {
+    const start = Date.parse(input.range.start),
+      end = Date.parse(input.range.end);
+    if (
+      !/(?:Z|[+-]\d{2}:\d{2})$/i.test(input.range.start) ||
+      !/(?:Z|[+-]\d{2}:\d{2})$/i.test(input.range.end) ||
+      !Number.isFinite(start) ||
+      !Number.isFinite(end) ||
+      start <= this.options.clock.now().getTime() ||
+      end <= start ||
+      end - start > 14 * 86_400_000 ||
+      !Number.isSafeInteger(input.durationMs) ||
+      input.durationMs < 15 * 60_000 ||
+      input.durationMs > 24 * 3_600_000
+    )
+      denied("Explicit future range and bounded duration required", "NETWORK_INVALID");
+    return this.withAuthority(
+      input.opportunityId,
+      input.revision,
+      async (domain, _record, opportunity, members) => {
+        memberActor(
+          actor,
+          members.map((member) => member.memberId),
+        );
+        const resolved = await readAvailability(
+          members,
+          input.range,
+          this.options.clock,
+          this.options.availability,
+        );
+        const known = resolved.every(
+          (value) =>
+            (value.qualification.stated === "known" ||
+              value.qualification.freeBusy === "authored_fixture") &&
+            value.sources.length > 0 &&
+            value.sources.every((source) => source.status === "fresh"),
+        );
+        const sources = resolved.flatMap((value) => [...value.sources]);
+        const timeZone = members[0]?.preferences.timezone ?? "UTC";
+        const qualified =
+          known &&
+          evaluateCalendarAvailability({ range: input.range, timeZone, sources }).definitive;
+        const slots = qualified
+          ? findCalendarFreeSlots({
+              range: input.range,
+              timeZone,
+              sources,
+              durationMs: input.durationMs,
+            }).filter((slot) =>
+              members.every((member) =>
+                member.presence.some(
+                  (presence) =>
+                    presence.city === opportunity.city &&
+                    presence.startsAt <= slot.start &&
+                    (!presence.endsAt || presence.endsAt >= slot.end),
+                ),
+              ),
+            )
+          : [];
