+    const [a, b] = (await host.domain.adminView({ type: "system" })).members;
+    if (!a || !b) throw new Error("Owned fixtures missing");
+    const proposal = await host.domain.command(
+      { type: "system" },
+      {
+        type: "create_opportunity",
