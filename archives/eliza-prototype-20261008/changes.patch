index 000000000000..851c88157f03
--- /dev/null
+++ b/packages/ui/src/network/NetworkGraph.tsx
@@ -0,0 +1,236 @@
+import { useId, useMemo, useState } from "react";
+import { Button } from "../components/ui/button";
+import type { NetworkGraph as NetworkGraphData } from "./api";
+
+/** Uses host-supplied scrubbed nodes, typed edges and precomputed coordinates. */
+export function NetworkGraph({ graph }: { graph: NetworkGraphData }) {
+  const [selectedId, setSelectedId] = useState("");
+  const [selectedEdgeId, setSelectedEdgeId] = useState("");
+  const [edgeType, setEdgeType] = useState("");
+  const [query, setQuery] = useState("");
+  const labelId = useId();
+  const selected = graph.nodes.find((node) => node.id === selectedId);
+  const types = [
+    ...new Set(
+      graph.edges
+        .map((edge) => edge.label)
+        .filter((value): value is string => Boolean(value)),
+    ),
+  ];
+  const searchMatches = graph.nodes.filter(
+    (node) => !query || node.label.toLowerCase().includes(query.toLowerCase()),
+  );
+  const visibleEdges = graph.edges.filter(
+    (edge) => !edgeType || edge.label === edgeType,
+  );
+  const selectedEdge = visibleEdges.find((edge) => edge.id === selectedEdgeId);
+  const byId = useMemo(
+    () => new Map(graph.nodes.map((node) => [node.id, node])),
+    [graph.nodes],
+  );
+  const bounds = useMemo(() => {
+    if (!graph.nodes.length) return "0 0 600 350";
+    const xs = graph.nodes.map((node) => node.x);
+    const ys = graph.nodes.map((node) => node.y);
+    const minX = Math.min(...xs) - 45;
+    const minY = Math.min(...ys) - 45;
+    return `${minX} ${minY} ${Math.max(150, Math.max(...xs) - minX + 45)} ${Math.max(150, Math.max(...ys) - minY + 45)}`;
+  }, [graph.nodes]);
+  const connected = selected
+    ? visibleEdges.filter(
+        (edge) => edge.source === selected.id || edge.target === selected.id,
+      )
+    : [];
+  return (
+    <section className="nw-graph" aria-labelledby={labelId}>
+      <h2 id={labelId}>Connections in this world</h2>
+      <p className="nw-muted">
+        Select or find a member to inspect their recorded connections. Names
+        appear for the selected member and small search results.
+        {graph.nodes.some((node) => node.cohort) &&
+          " Green: newcomers. Purple: Receiving. Gray: established. Size shows delivered proactive contacts in the selected window."}
+      </p>
+      <div className="nw-record-tools">
+        <div className="nw-field">
+          <label htmlFor={`${labelId}-find`}>Find a member</label>
+          <input
+            id={`${labelId}-find`}
+            type="search"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+          />
+        </div>
+        <div className="nw-field">
+          <label htmlFor={`${labelId}-type`}>Connection type</label>
+          <select
+            id={`${labelId}-type`}
+            value={edgeType}
+            onChange={(event) => setEdgeType(event.target.value)}
+          >
+            <option value="">All connections</option>
+            {types.map((type) => (
+              <option key={type} value={type}>
+                {type}
+              </option>
+            ))}
+          </select>
+        </div>
+      </div>
+      <svg
+        className="nw-graph-canvas"
+        viewBox={bounds}
+        role="img"
+        aria-label={`${graph.nodes.length} members and ${visibleEdges.length} recorded connections`}
+      >
+        {visibleEdges.map((edge) => {
+          const source = byId.get(edge.source);
+          const target = byId.get(edge.target);
+          return source && target ? (
+            <a
+              key={edge.id}
+              href={`#network-graph-edge-${edge.id}`}
+              aria-label={`Inspect ${edge.label ?? "connection"} between ${source.label} and ${target.label}`}
+              onClick={(event) => {
+                event.preventDefault();
+                setSelectedEdgeId(edge.id);
+              }}
+            >
+              <line
+                x1={source.x}
+                y1={source.y}
+                x2={target.x}
+                y2={target.y}
+                className={
+                  selectedEdgeId === edge.id ||
+                  (selectedId &&
+                    (edge.source === selectedId || edge.target === selectedId))
+                    ? "nw-graph-edge nw-graph-edge-selected"
+                    : "nw-graph-edge"
+                }
+              >
+                <title>
+                  {source.label} — {edge.label ?? "connection"} — {target.label}
+                </title>
+              </line>
+            </a>
+          ) : null;
+        })}
+        {graph.nodes.map((node) => {
+          const match =
+            !query || node.label.toLowerCase().includes(query.toLowerCase());
+          return (
+            <a
+              key={node.id}
+              href={`#network-graph-${node.id}`}
+              aria-label={`Inspect ${node.label}`}
+              onClick={(event) => {
+                event.preventDefault();
+                setSelectedId(selectedId === node.id ? "" : node.id);
+                setSelectedEdgeId("");
+              }}
+            >
+              <g
+                data-cohort={node.cohort}
+                className={`nw-graph-node${selectedId === node.id ? " nw-graph-node-selected" : ""}${match ? "" : " nw-graph-node-muted"}`}
+              >
+                <circle
+                  cx={node.x}
+                  cy={node.y}
+                  r={
+                    Math.min(
+                      12,
+                      (graph.nodes.length > 30 ? 3 : 6) +
+                        Math.sqrt(Math.max(0, node.activity ?? 0)),
+                    ) + (selectedId === node.id ? 2 : 0)
+                  }
+                />
+                {(selectedId === node.id ||
+                  graph.nodes.length <= 24 ||
+                  (query && match && searchMatches.length <= 12)) && (
+                  <text x={node.x + 14} y={node.y + 5}>
+                    {node.label}
+                  </text>
+                )}
+              </g>
+            </a>
+          );
+        })}
+      </svg>
+      <fieldset className="nw-graph-members">
+        <legend className="nw-sr-only">Select a graph member</legend>
+        {graph.nodes
+          .filter(
+            (node) =>
+              !query || node.label.toLowerCase().includes(query.toLowerCase()),
+          )
+          .map((node) => (
+            <Button
+              unstyled
+              className="nw-button nw-button-secondary"
+              key={node.id}
+              aria-pressed={selectedId === node.id}
+              onClick={() => {
+                setSelectedId(selectedId === node.id ? "" : node.id);
+                setSelectedEdgeId("");
+              }}
+            >
+              {node.label}
+              {node.status ? ` · ${node.status}` : ""}
+            </Button>
+          ))}
+      </fieldset>
+      {selected && (
+        <div
+          className="nw-graph-inspection"
+          id={`network-graph-${selected.id}`}
+        >
+          <h3>{selected.label}</h3>
+          {connected.length ? (
+            <ul>
+              {connected.map((edge) => (
+                <li key={edge.id}>
+                  <Button
+                    unstyled
+                    className="nw-button nw-button-secondary"
+                    onClick={() => setSelectedEdgeId(edge.id)}
+                  >
+                    {edge.label ?? "Connection"}:{" "}
+                    {byId.get(
+                      edge.source === selected.id ? edge.target : edge.source,
+                    )?.label ?? "Unavailable member"}
+                    {edge.status ? ` · ${edge.status}` : ""}
+                  </Button>
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <p>No recorded connections match this filter.</p>
+          )}
+        </div>
+      )}
+      {selectedEdge && (
+        <section
+          className="nw-graph-inspection"
+          id={`network-graph-edge-${selectedEdge.id}`}
+          aria-label="Connection details"
+        >
+          <h3>{selectedEdge.label ?? "Unknown connection type"}</h3>
+          <p>
+            {byId.get(selectedEdge.source)?.label ?? "Unavailable member"} →{" "}
+            {byId.get(selectedEdge.target)?.label ?? "Unavailable member"}
+          </p>
+          <dl>
+            <dt>Connection type</dt>
+            <dd>{selectedEdge.label ?? "Unknown"}</dd>
+            <dt>Recorded at</dt>
+            <dd>{selectedEdge.createdAt ?? "Unknown"}</dd>
+            <dt>Last interaction</dt>
+            <dd>{selectedEdge.lastInteractionAt ?? "Unknown"}</dd>
+            <dt>Confidence</dt>
+            <dd>{selectedEdge.confidence ?? "Unknown"}</dd>
+          </dl>
+        </section>
+      )}
+    </section>
+  );
+}
