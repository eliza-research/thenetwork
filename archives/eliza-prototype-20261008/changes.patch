+					walkBudget: { maxNodes, maxBytes: 100 },
+				}).substituteInValue({}),
+			).toThrow("walk budget");
+		for (const maxBytes of [0, -1, Infinity, 1.5])
+			expect(() =>
+				new PseudonymSession({
+					salt: "invalid",
+					walkBudget: { maxNodes: 100, maxBytes },
