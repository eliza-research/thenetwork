+      { type: "staff", userId: "framework-safety", roles: ["safety"] },
+      { ...input, purpose: "Investigate the synthetic framework history" },
+    );
+    expect(raw.rows.filter((row) => row.fields.source === "native_shared_chat")).toHaveLength(2);
+    expect(
+      raw.rows.some(
+        (row) =>
+          row.fields.source === "native_shared_chat" &&
+          row.fields.direction === "inbound" &&
+          row.title === "OpenAI",
+      ),
+    ).toBe(true);
+    expect(raw.trajectories.length).toBeGreaterThan(0);
+    const audit = await historyHost.domain.adminView({
+      type: "staff",
+      userId: "framework-safety",
+      roles: ["safety"],
+    });
+    expect(
+      audit.events.some(
+        (event) =>
+          event.kind === "restricted_member_reveal" && event.memberIds.includes(owned.memberId),
