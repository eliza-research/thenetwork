@@ -0,0 +1,282 @@
+import type { NetworkRequestProof } from "../domain/types.ts";
+/** Trusted projections supplied by the Network domain, never arbitrary model input. */
+export type GeneratorKind =
+  | "intent_capability"
+  | "complementary"
+  | "shared_intent"
+  | "event_anchor"
+  | "warm_path"
+  | "help"
+  | "group"
+  | "second_encounter"
+  | "welcome"
+  | "growth"
