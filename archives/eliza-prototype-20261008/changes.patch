+import { expect, it } from "vitest";
+import { NetworkMemberAgent } from "../agent/service.ts";
+import { SimClock, seedSimulationMembers } from "../evaluation/fixtures.ts";
+import { createLocalNetworkHost } from "../workbench/host.ts";
+import { matchingConfigFromSettings, projectMatchingInput } from "./domain-projection.ts";
+import {
+  createNetworkCandidateRetrieval,
+  indexAuthoredMatchingVector,
+  invalidateMatchingPointers,
+} from "./native-retrieval.ts";
+
+it("uses real scoped SQL/vector owners and atomically invalidates a revoked source without exposing private facets", async () => {
+  const clock = new SimClock(Date.parse("2026-10-06T16:00:00Z"));
+  const host = await createLocalNetworkHost({
+    dataDir: "memory://",
+    networkId: "simulation:native-retrieval",
+    clock,
+  });
+  try {
+    await seedSimulationMembers(host.domain, 100, 42);
+    const { revision, ...values } = await host.domain.getSettings({ type: "system" });
+    await host.domain.command(
+      { type: "system" },
+      {
+        type: "configure",
+        requestId: "qualify-cities",
+        expectedRevision: revision,
+        settings: { ...values, proactiveCities: { SF: true, NYC: true } },
+      },
+    );
+    const members = (await host.domain.engineSnapshot({ type: "system" })).members.filter(
+      (member) =>
+        member.age === "adult" &&
+        member.homeCities.includes("SF") &&
+        member.accountState === "active" &&
+        member.participation === "normal" &&
+        member.outreachAvailable,
+    );
+    const [a, b] = members;
+    if (!a || !b) throw new Error("Expected two qualified fixture members");
+    const agent = new NetworkMemberAgent({
+      host,
+      executeCommand: async () => {
+        throw new Error("Readback must not mutate fixture consent");
+      },
+    });
+    for (const member of [a, b])
+      await agent.message(member.memberId, {
+        text: "what do you know",
+        requestId: `room:${member.memberId}`,
+      });
+    const currentA = await host.domain.getMember({ type: "system" }, a.memberId),
+      currentB = await host.domain.getMember({ type: "system" }, b.memberId);
+    const aIntent = currentA.intents.find((intent) => intent.status === "active"),
+      bIntent = currentB.intents.find((intent) => intent.status === "active"),
+      bFact = currentB.facts.find(
+        (fact) => fact.scope === "shareable" && fact.status === "confirmed",
+      );
+    if (!aIntent || !bIntent || !bFact) throw new Error("Fixture lacks current source objects");
+    const vector = [1, ...Array<number>(383).fill(0)];
+    await indexAuthoredMatchingVector(host, {
+      memberId: a.memberId,
+      sourceId: aIntent.id,
+      kind: "intent",
+      vector,
+    });
+    await indexAuthoredMatchingVector(host, {
+      memberId: b.memberId,
+      sourceId: bIntent.id,
+      kind: "intent",
+      vector,
+    });
+    await indexAuthoredMatchingVector(host, {
+      memberId: b.memberId,
+      sourceId: bFact.id,
+      kind: "facet",
+      vector,
+    });
+    const privateFact = currentB.facts.find((fact) => fact.scope === "agent_private");
+    if (!privateFact) throw new Error("Missing privacy canary source");
+    await expect(
+      indexAuthoredMatchingVector(host, {
+        memberId: b.memberId,
+        sourceId: privateFact.id,
+        kind: "facet",
+        vector,
+      }),
+    ).rejects.toThrow("purpose-limited");
+    const request = {
+      runId: "retrieval:one",
+      city: "SF" as const,
+      seed: 42,
+      startAt: clock.now().toISOString(),
+      endAt: new Date(clock.now().getTime() + 86400000).toISOString(),
+    };
+    const provider = await createNetworkCandidateRetrieval(host, request),
+      settings = await host.domain.getSettings({ type: "system" });
+    const input = projectMatchingInput(
+      await host.domain.engineSnapshot(
+        { type: "system" },
+        { memberIds: provider.eligibleMemberIds },
+      ),
+      request,
+      clock.now().getTime(),
+      matchingConfigFromSettings(settings),
+      settings,
+    );
+    const member = input.members.find((member) => member.memberId === a.memberId);
+    if (!member) throw new Error("SQL-first selector excluded current member");
+    const channels = await provider.retrieve({
+      member,
+      city: "SF",
+      window: input.window,
+      eligibleMemberIds: provider.eligibleMemberIds,
+      limitPerChannel: 50,
+    });
+    expect(channels.vectorIntentFacet).toContain(b.memberId);
+    expect(channels.vectorIntentIntent).toContain(b.memberId);
+    await host.domain.withAuthority(async (domain, db) => {
+      const { revision: _revision, updatedAt: _updatedAt, ...fact } = bFact;
+      await domain.command(
+        { type: "member", memberId: b.memberId },
+        {
+          type: "upsert_fact",
+          requestId: "revoke",
+          memberId: b.memberId,
+          fact: { ...fact, scope: "agent_private" },
+        },
+      );
+      const changed = await domain.getMember({ type: "system" }, b.memberId);
+      await invalidateMatchingPointers(
+        db.execute,
+        host.domain.options.networkId,
+        host.runtime.agentId,
+        changed,
+        clock.now().getTime(),
+      );
+    });
+    const after = await createNetworkCandidateRetrieval(host, {
+      ...request,
+      runId: "retrieval:two",
+    });
+    const revoked = await after.retrieve({
+      member,
+      city: "SF",
+      window: input.window,
+      eligibleMemberIds: after.eligibleMemberIds,
+      limitPerChannel: 50,
+    });
+    expect(revoked.vectorIntentFacet).not.toContain(b.memberId);
+    expect(revoked.vectorIntentIntent).toContain(b.memberId);
+    await expect(
+      indexAuthoredMatchingVector(host, {
+        memberId: b.memberId,
+        sourceId: bFact.id,
+        kind: "facet",
+        vector,
+      }),
+    ).rejects.toThrow("purpose-limited");
+  } finally {
+    await host.close();
+  }
+}, 120000);
