index 000000000000..2ca24bf43cff
--- /dev/null
+++ b/packages/cloud/shared/src/lib/network/domain/types.ts
@@ -0,0 +1,645 @@
+import type { CarveOutDatabase, CarveOutSqlExecutor } from "@elizaos/plugin-sql";
+
+export interface NetworkClock {
+  now(): Date;
+}
+export type City = "SF" | "NYC";
+export type StaffRole = "admin" | "reviewer" | "safety" | "analyst" | "engineer";
+/** Trusted host constructs this after authentication; never accept an actor from model output. */
+export type NetworkActor =
+  | { type: "member"; memberId: string }
+  | { type: "staff"; userId: string; roles: StaffRole[] }
+  | { type: "system" };
+export interface NetworkDomainOptions {
+  db: CarveOutDatabase;
+  clock: NetworkClock;
+  networkId: string;
+  /** Host composes native SQL owners here; never perform provider effects inside this transaction. */
+  afterCommand?: (
+    execute: CarveOutSqlExecutor,
+    command: NetworkCommand,
+    result: NetworkCommandResult,
+  ) => Promise<void>;
+  eraseMemberArtifacts?: (
+    execute: CarveOutSqlExecutor,
+    memberId: string,
+    opportunityIds: string[],
+    identity: { cloudUserId: string; channels: ChannelIdentity[]; sources: ConnectedSource[] },
+  ) => Promise<void>;
+}
+export type PrivacyScope = "agent_private" | "matching" | "shareable";
+export type ParticipationState = "normal" | "open" | "quiet" | "receiving" | "paused";
+export interface ChannelIdentity {
+  channel: "imessage" | "sms" | "web";
+  address: string;
+  verifiedAt: string;
+  stopped: boolean;
+  primary: boolean;
+}
+export interface ProfileFact {
+  id: string;
+  kind: string;
+  value: string;
+  tags: string[];
+  scope: PrivacyScope;
+  source:
+    | "member"
+    | "conversation"
+    | "vouch"
+    | "calendar"
+    | "public_profile"
+    | "memory_paste"
+    | "engine";
+  sourceRef: string;
+  confidence: number;
+  status: "proposed" | "confirmed" | "rejected";
+  revision: number;
+  updatedAt: string;
+  validFrom?: string;
+  validTo?: string | null;
+  sourceRevision?: number;
+}
+export interface NetworkIntent {
+  id: string;
+  objective: string;
+  category: string;
+  tags: string[];
+  needs: string[];
+  offers: string[];
+  status: "active" | "paused" | "closed" | "expired";
+  createdAt: string;
+  lastConfirmedAt: string;
+  expiresAt: string;
+}
+export interface Presence {
+  id: string;
+  city: City;
+  kind: "home" | "routine" | "temporary";
+  area: string;
+  startsAt: string;
+  endsAt: string | null;
+}
+export interface Preferences {
+  explorationFraction?: number;
+  categories: string[];
+  quietHours: { start: string; end: string };
+  timezone: string;
+  formats: string[];
+  travelMinutes: number;
+  romanceOptIn: boolean;
+  boundaries: string[];
+  proactiveOptIn: boolean;
+  onlyWhenAsked: boolean;
+}
+export interface ConnectedSource {
+  id: string;
+  kind: "calendar" | "public_profile" | "memory_paste";
+  sourceRef: string;
+  status: "connected" | "revoked";
+}
+export type NetworkAgeBand = "under13" | "13_17" | "18_plus";
+export interface NetworkMember {
+  memberId: string;
+  cloudUserId: string;
+  displayName: string;
+  age: "adult" | "minor" | "unknown";
+  ageAttestation?: {
+    age: "adult" | "minor" | "unknown";
+    confirmedAt: string;
+    source: "member" | "host";
+    ageBand?: Exclude<NetworkAgeBand, "under13">;
+  };
+  homeCities: City[];
+  accountState: "onboarding" | "active" | "paused" | "restricted" | "removed";
+  participation: ParticipationState;
+  safetyHold: boolean;
+  revision: number;
+  createdAt: string;
+  updatedAt: string;
+  inviteId: string | null;
+  termsVersion: string;
+  channels: ChannelIdentity[];
+  preferences: Preferences;
+  facts: ProfileFact[];
+  intents: NetworkIntent[];
+  presence: Presence[];
+  sources: ConnectedSource[];
+  blockedMemberIds: string[];
+  consecutiveUnanswered: number;
+  reliabilityHold?: {
+    group: boolean;
+    timeSensitive: boolean;
+    since: string;
+    reason: string;
+  } | null;
+  outreachPause?: { automatic: true; since: string; previousOnlyWhenAsked: boolean } | null;
+}
+export interface AttendanceEvidence {
+  sequence?: number;
+  id: string;
+  memberId: string;
+  opportunityId: string;
+  observation: "attended" | "no_show" | "cancelled_with_notice";
+  source: "self" | "operator" | "corroborated";
+  observerIds: string[];
+  context: {
+    kind: OpportunityKind;
+    groupSize: number;
+    leadTimeHours: number;
+    timeSensitive: boolean;
+  };
+  createdAt: string;
+}
+export interface Vouch {
+  relationship: string;
+  knownMonths: number;
+  strength: "weak" | "normal" | "strong";
+  note: string;
+  expectsMessage: boolean;
+}
+export interface NetworkInvite {
+  id: string;
+  inviterId: string | null;
+  teamUserId: string | null;
+  tokenHash: string;
+  city: City;
+  inviteeName: string;
+  address: string | null;
+  vouch: Vouch | null;
+  state: "pending_review" | "ready" | "accepted" | "declined" | "expired" | "revoked";
+  expiresAt: string;
+  createdAt: string;
+  acceptedMemberId: string | null;
+  sentAt: string | null;
+}
+export type OpportunityKind =
+  | "intro"
+  | "group"
+  | "event"
+  | "help"
+  | "member_intro"
+  | "welcome"
+  | "growth"
+  | "monthly_event";
+export type OpportunityState =
+  | "draft"
+  | "in_review"
+  | "approved"
+  | "inviting"
+  | "partially_accepted"
+  | "mutually_accepted"
+  | "quorum_met"
+  | "scheduling"
+  | "scheduled"
+  | "reschedule_requested"
+  | "needs_replacement"
+  | "in_progress"
+  | "completed"
+  | "feedback_collected"
+  | "rejected_in_review"
+  | "declined"
+  | "expired"
+  | "quorum_failed"
+  | "cancelled"
+  | "safety_hold"
+  | "disputed"
+  | "abandoned";
+export interface Participation {
+  memberId: string;
+  revision: number;
+  state:
+    | "invited"
+    | "accepted"
+    | "declined"
+    | "expired"
+    | "confirmed"
+    | "attended"
+    | "cancelled_with_notice"
+    | "no_show"
+    | "replaced";
+  invitedAt: string | null;
+  expiresAt: string;
+  acceptedAt: string | null;
+  disclosure: {
+    revision: number;
+    factIds: string[];
+    contact: boolean;
+    preciseVenue: boolean;
+  } | null;
+}
+export interface OpportunityReviewRubric {
+  tone: "pass" | "uncertain" | "fail";
+  clarity: "pass" | "uncertain" | "fail";
+  explanation: "pass" | "uncertain" | "fail";
+  timing: "pass" | "uncertain" | "fail";
+  privacy: "pass" | "uncertain" | "fail";
+}
+export interface OpportunityReview {
+  revision: number;
+  decision: "approved" | "rejected" | "reroll";
+  reviewerId: string;
+  reasonCode: string;
+  note: string;
+  at: string;
+  rubric?: OpportunityReviewRubric;
+  durationMs?: number;
+  durationSource?: "network_clock" | "reviewer_entered";
+  blind?: true;
+}
+export interface NetworkRequestProof {
+  memberId: string;
+  intentId: string;
+  requestId: string;
+}
+export interface OpportunityDraft {
+  requester?: NetworkRequestProof;
+  id: string;
+  kind: OpportunityKind;
+  objective: string;
+  category: string;
+  city: City;
+  participantIds: string[];
+  backupIds: string[];
+  quorum: number;
+  expiresAt: string;
+  explanations: Record<string, { text: string; factIds: string[] }>;
+  safetyClass: "low" | "medium" | "high";
+  requiresHomeEntry: boolean;
+  acquaintedHelperIds: string[];
+  anchorEventId: string | null;
+  origin?: { runId: string; generator: string; exploration: boolean };
+  roles?: Record<string, "requester" | "helper" | "host" | "guest">;
+  programme?: {
+    startsAt: string;
+    endsAt: string;
+    publicVenue: { name: string; area: string; sourceRef: string };
+  };
+}
+export interface NetworkOpportunity extends OpportunityDraft {
+  revision: number;
+  state: OpportunityState;
+  review: OpportunityReview | null;
+  reviewDeadline: string;
+  reviewAdmittedAt?: string;
+  reviewWork?: { assigneeId: string; priority: "standard" | "same_day"; startedAt: string };
+  blindReviews?: OpportunityReview[];
+  participants: Participation[];
+  createdAt: string;
+  updatedAt: string;
+}
