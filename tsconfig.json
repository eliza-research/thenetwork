{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["bun"], "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "prototypes/**/*.ts"],
  "exclude": ["**/node_modules", "reference/**", "eliza/**", "packages/plugin-network/**"]
}
