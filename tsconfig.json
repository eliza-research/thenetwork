{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "types": ["bun"], "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "deploy/**/*.ts", "scripts/platform-dev.ts", "scripts/sim.ts", "scripts/sim/**/*.ts", "scripts/clef-fit.ts", "scripts/monitor.ts", "scripts/replay-run.ts", "scripts/restore-drill.ts", "scripts/export-nightly.ts"],
  "exclude": ["**/node_modules", "eliza/**", "packages/plugin-network/**"]
}
